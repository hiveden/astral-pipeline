{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期最后我们留了一句话：",
      "start": 0.0,
      "end": 1.99
    },
    {
      "id": "shot01-1",
      "text": "分类切到回归，",
      "start": 1.99,
      "end": 3.34
    },
    {
      "id": "shot01-2",
      "text": "3 行代码里只换一个名字。",
      "start": 3.34,
      "end": 5.92
    },
    {
      "id": "shot01-3",
      "text": "这一期我们就把这句话兑现给你看。",
      "start": 5.92,
      "end": 8.56
    },
    {
      "id": "shot01-4",
      "text": "同样的 9 部电影，",
      "start": 8.56,
      "end": 10.18
    },
    {
      "id": "shot01-5",
      "text": "同样的 sklearn 工具库，",
      "start": 10.18,
      "end": 12.28
    },
    {
      "id": "shot01-6",
      "text": "但这次我们不再问会不会喜欢，",
      "start": 12.28,
      "end": 14.88
    },
    {
      "id": "shot01-7",
      "text": "而是直接预测一个具体的数字——你会给流浪",
      "start": 14.88,
      "end": 18.22
    },
    {
      "id": "shot01-8",
      "text": "地球 3 打几分。",
      "start": 18.22,
      "end": 20.0
    },
    {
      "id": "shot01-9",
      "text": "整期就是一场找不同游戏：",
      "start": 20.0,
      "end": 22.26
    },
    {
      "id": "shot01-10",
      "text": "上一期的代码摆在左边，",
      "start": 22.26,
      "end": 24.22
    },
    {
      "id": "shot01-11",
      "text": "这一期摆在右边，",
      "start": 24.22,
      "end": 25.56
    },
    {
      "id": "shot01-12",
      "text": "只有两处变化。",
      "start": 25.56,
      "end": 26.82
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先准备数据。",
      "start": 0.0,
      "end": 1.26
    },
    {
      "id": "shot02-1",
      "text": "X 跟上一期完全相同——9 部电影、",
      "start": 1.26,
      "end": 4.18
    },
    {
      "id": "shot02-2",
      "text": "每部 2 个数字，",
      "start": 4.18,
      "end": 5.5
    },
    {
      "id": "shot02-3",
      "text": "评分和主演吸引度。",
      "start": 5.5,
      "end": 7.16
    },
    {
      "id": "shot02-4",
      "text": "变化在 y 上。",
      "start": 7.16,
      "end": 8.62
    },
    {
      "id": "shot02-5",
      "text": "上一期 y 是 9 个标签，",
      "start": 8.62,
      "end": 10.64
    },
    {
      "id": "shot02-6",
      "text": "喜欢或者不喜欢，",
      "start": 10.64,
      "end": 12.32
    },
    {
      "id": "shot02-7",
      "text": "是几个固定选项里挑一个。",
      "start": 12.32,
      "end": 14.26
    },
    {
      "id": "shot02-8",
      "text": "这一期 y 换成具体的星数：",
      "start": 14.596,
      "end": 16.776
    },
    {
      "id": "shot02-9",
      "text": "流浪地球 2 我打 4.5 分、",
      "start": 16.776,
      "end": 19.342
    },
    {
      "id": "shot02-10",
      "text": "阿凡达 4.0 分、",
      "start": 19.342,
      "end": 20.946
    },
    {
      "id": "shot02-11",
      "text": "泰坦尼克 4.3 分；",
      "start": 20.946,
      "end": 22.71
    },
    {
      "id": "shot02-12",
      "text": "哥斯拉 3.0 分、",
      "start": 22.71,
      "end": 24.314
    },
    {
      "id": "shot02-13",
      "text": "上海堡垒 1.5 分；",
      "start": 24.314,
      "end": 26.078
    },
    {
      "id": "shot02-14",
      "text": "沙丘 2 是 4.5 分、",
      "start": 26.078,
      "end": 28.163
    },
    {
      "id": "shot02-15",
      "text": "复联 4 也是 4.5 分；",
      "start": 28.163,
      "end": 30.409
    },
    {
      "id": "shot02-16",
      "text": "寒战 3.0 分、",
      "start": 30.409,
      "end": 31.852
    },
    {
      "id": "shot02-17",
      "text": "长津湖 2.5 分。",
      "start": 31.852,
      "end": 33.456
    },
    {
      "id": "shot02-18",
      "text": "这些不再是几个固定选项，",
      "start": 33.456,
      "end": 35.656
    },
    {
      "id": "shot02-19",
      "text": "而是连续数值——任何一个 1 到 5 之",
      "start": 35.656,
      "end": 38.436
    },
    {
      "id": "shot02-20",
      "text": "间的小数都合法。",
      "start": 38.436,
      "end": 39.776
    },
    {
      "id": "shot02-21",
      "text": "这就是上一期讲过的两类任务的区别：",
      "start": 39.776,
      "end": 42.576
    },
    {
      "id": "shot02-22",
      "text": "分类预测离散类别，",
      "start": 42.576,
      "end": 44.836
    },
    {
      "id": "shot02-23",
      "text": "回归预测连续数字。",
      "start": 44.836,
      "end": 46.596
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "打开 Jupyter，",
      "start": 0.0,
      "end": 1.16
    },
    {
      "id": "shot03-1",
      "text": "把上一期的代码原样粘过来，",
      "start": 1.16,
      "end": 3.42
    },
    {
      "id": "shot03-2",
      "text": "开始找不同。",
      "start": 3.42,
      "end": 4.48
    },
    {
      "id": "shot03-3",
      "text": "第一个 Cell 是数据，",
      "start": 4.48,
      "end": 6.3
    },
    {
      "id": "shot03-4",
      "text": "X 不变，",
      "start": 6.3,
      "end": 7.42
    },
    {
      "id": "shot03-5",
      "text": "y 改完了刚才说的 9 个数字。",
      "start": 7.42,
      "end": 9.58
    },
    {
      "id": "shot03-6",
      "text": "然后是关键的第二个 Cell，",
      "start": 9.58,
      "end": 11.94
    },
    {
      "id": "shot03-7",
      "text": "三件套那段。",
      "start": 11.94,
      "end": 12.84
    },
    {
      "id": "shot03-8",
      "text": "我们把上一期的代码放在屏幕左边，",
      "start": 12.84,
      "end": 16.2
    },
    {
      "id": "shot03-9",
      "text": "这一期放在右边，逐行扫。",
      "start": 16.2,
      "end": 18.64
    },
    {
      "id": "shot03-10",
      "text": "第一行 import，",
      "start": 18.64,
      "end": 20.06
    },
    {
      "id": "shot03-11",
      "text": "左边是",
      "start": 20.06,
      "end": 20.64
    },
    {
      "id": "shot03-12",
      "text": "KNeighborsClassifier，",
      "start": 20.64,
      "end": 21.88
    },
    {
      "id": "shot03-13",
      "text": "右边是",
      "start": 21.88,
      "end": 22.7
    },
    {
      "id": "shot03-14",
      "text": "KNeighborsRegressor—",
      "start": 22.7,
      "end": 24.157
    },
    {
      "id": "shot03-15",
      "text": "—名字结尾从分类器换成回归器。",
      "start": 24.157,
      "end": 26.84
    },
    {
      "id": "shot03-16",
      "text": "第二行构造对象，",
      "start": 27.244,
      "end": 28.844
    },
    {
      "id": "shot03-17",
      "text": "类名跟着 import 一起换，",
      "start": 28.844,
      "end": 30.974
    },
    {
      "id": "shot03-18",
      "text": "n_neighbors 还是 5。",
      "start": 30.974,
      "end": 32.564
    },
    {
      "id": "shot03-19",
      "text": "第三行 fit、",
      "start": 32.564,
      "end": 33.904
    },
    {
      "id": "shot03-20",
      "text": "第四行 predict，",
      "start": 33.904,
      "end": 35.324
    },
    {
      "id": "shot03-21",
      "text": "全部一字不动。",
      "start": 35.324,
      "end": 36.524
    },
    {
      "id": "shot03-22",
      "text": "整段代码两处变化都集中在同一个名字上：",
      "start": 36.524,
      "end": 40.184
    },
    {
      "id": "shot03-23",
      "text": "导入和构造时，",
      "start": 40.184,
      "end": 41.384
    },
    {
      "id": "shot03-24",
      "text": "分类器换成回归器。",
      "start": 41.384,
      "end": 43.604
    },
    {
      "id": "shot03-25",
      "text": "运行——输出 4.36。意思是：",
      "start": 43.604,
      "end": 46.524
    },
    {
      "id": "shot03-26",
      "text": "根据你历史 9 部电影的打分模式，",
      "start": 46.524,
      "end": 49.444
    },
    {
      "id": "shot03-27",
      "text": "KNN 预测你会给流浪地球 3 打 4.36 分。",
      "start": 49.444,
      "end": 53.31
    },
    {
      "id": "shot03-28",
      "text": "注意输出的形式：",
      "start": 53.533,
      "end": 55.293
    },
    {
      "id": "shot03-29",
      "text": "上一期 predict 给我们的是一个字",
      "start": 55.293,
      "end": 57.713
    },
    {
      "id": "shot03-30",
      "text": "符串数组——喜欢；",
      "start": 57.713,
      "end": 59.233
    },
    {
      "id": "shot03-31",
      "text": "这一期是一个浮点数。",
      "start": 59.233,
      "end": 61.713
    },
    {
      "id": "shot03-32",
      "text": "这就是分类和回归在代码层面最直接的区别：",
      "start": 61.713,
      "end": 65.713
    },
    {
      "id": "shot03-33",
      "text": "构造时换一个零件，",
      "start": 65.713,
      "end": 67.453
    },
    {
      "id": "shot03-34",
      "text": "输出类型自动跟着变。",
      "start": 67.453,
      "end": 69.213
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "4.36 这个数字怎么来的，",
      "start": 0.0,
      "end": 2.16
    },
    {
      "id": "shot04-1",
      "text": "我们手验一遍闭环。",
      "start": 2.16,
      "end": 4.16
    },
    {
      "id": "shot04-2",
      "text": "还记得上一期算的 5 个最近邻吗——离流",
      "start": 4.16,
      "end": 7.4
    },
    {
      "id": "shot04-3",
      "text": "浪地球 3 最近的 5 部依次是：",
      "start": 7.4,
      "end": 9.78
    },
    {
      "id": "shot04-4",
      "text": "复联 4 距离 0.30、",
      "start": 9.78,
      "end": 11.62
    },
    {
      "id": "shot04-5",
      "text": "流浪地球 2 距离 0.51、",
      "start": 11.62,
      "end": 13.62
    },
    {
      "id": "shot04-6",
      "text": "泰坦尼克 1.00。",
      "start": 13.62,
      "end": 15.1
    },
    {
      "id": "shot04-7",
      "text": "然后是阿凡达 1.02、",
      "start": 15.1,
      "end": 16.88
    },
    {
      "id": "shot04-8",
      "text": "沙丘 2 1.58。",
      "start": 16.88,
      "end": 18.84
    },
    {
      "id": "shot04-9",
      "text": "这 5 部我们打过的分依次是：4.5、4.5、4.3、4.0、4.5。",
      "start": 18.84,
      "end": 25.02
    },
    {
      "id": "shot04-10",
      "text": "回想一下上一期讲的：",
      "start": 25.02,
      "end": 26.78
    },
    {
      "id": "shot04-11",
      "text": "分类的第 4 步是多数表决，",
      "start": 26.78,
      "end": 29.0
    },
    {
      "id": "shot04-12",
      "text": "回归的第 4 步是求平均。",
      "start": 29.0,
      "end": 30.92
    },
    {
      "id": "shot04-13",
      "text": "把这 5 个分数加起来除以 5：",
      "start": 31.364,
      "end": 33.424
    },
    {
      "id": "shot04-14",
      "text": "4.5 加 4.5 加 4.3 加 4.",
      "start": 33.424,
      "end": 36.664
    },
    {
      "id": "shot04-15",
      "text": "0 加 4.5，",
      "start": 36.664,
      "end": 37.724
    },
    {
      "id": "shot04-16",
      "text": "等于 21.8。",
      "start": 37.724,
      "end": 39.304
    },
    {
      "id": "shot04-17",
      "text": "21.8 除以 5，",
      "start": 39.304,
      "end": 40.824
    },
    {
      "id": "shot04-18",
      "text": "等于 4.36——和 sklearn 输",
      "start": 40.824,
      "end": 43.904
    },
    {
      "id": "shot04-19",
      "text": "出完全一致。",
      "start": 43.904,
      "end": 45.184
    },
    {
      "id": "shot04-20",
      "text": "这就是回归内部做的全部事情：",
      "start": 45.184,
      "end": 47.524
    },
    {
      "id": "shot04-21",
      "text": "找到 K 个最近邻，",
      "start": 47.524,
      "end": 49.364
    },
    {
      "id": "shot04-22",
      "text": "把它们的目标值取算术平均，",
      "start": 49.364,
      "end": 51.644
    },
    {
      "id": "shot04-23",
      "text": "作为新样本的预测。",
      "start": 51.644,
      "end": 53.584
    },
    {
      "id": "shot04-24",
      "text": "第 1 期手算闭环、",
      "start": 53.584,
      "end": 54.904
    },
    {
      "id": "shot04-25",
      "text": "第 4 期 sklearn 闭环、",
      "start": 54.904,
      "end": 56.504
    },
    {
      "id": "shot04-26",
      "text": "这一期回归闭环——三次同一题目跑出三套结果，",
      "start": 56.504,
      "end": 60.504
    },
    {
      "id": "shot04-27",
      "text": "三次答案都对得上。",
      "start": 60.504,
      "end": 61.884
    },
    {
      "id": "shot04-28",
      "text": "这是 ML 工程师培养的基本素养：会调工具，",
      "start": 62.271,
      "end": 65.891
    },
    {
      "id": "shot04-29",
      "text": "也能手验工具的输出。",
      "start": 65.891,
      "end": 68.151
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "把这一期和上一期摆一起看。改了什么：",
      "start": 0.0,
      "end": 2.88
    },
    {
      "id": "shot05-1",
      "text": "API 类的名字、",
      "start": 2.88,
      "end": 4.62
    },
    {
      "id": "shot05-2",
      "text": "y 的内容、",
      "start": 4.62,
      "end": 5.48
    },
    {
      "id": "shot05-3",
      "text": "输出的类型。没改什么：",
      "start": 5.48,
      "end": 7.8
    },
    {
      "id": "shot05-4",
      "text": "fit 和 predict 这两步本身、",
      "start": 7.8,
      "end": 10.64
    },
    {
      "id": "shot05-5",
      "text": "X 的二维结构、",
      "start": 10.64,
      "end": 11.64
    },
    {
      "id": "shot05-6",
      "text": "K 的填法。换句话说，",
      "start": 11.64,
      "end": 14.24
    },
    {
      "id": "shot05-7",
      "text": "三件套的骨架完全一致，",
      "start": 14.24,
      "end": 16.46
    },
    {
      "id": "shot05-8",
      "text": "只是把骨架里的一个零件换了型号。",
      "start": 16.46,
      "end": 19.86
    },
    {
      "id": "shot05-9",
      "text": "这意味着什么？",
      "start": 19.86,
      "end": 21.04
    },
    {
      "id": "shot05-10",
      "text": "sklearn 的核心不是某一个具体算法，",
      "start": 21.04,
      "end": 24.28
    },
    {
      "id": "shot05-11",
      "text": "而是这套统一的三件套接口。",
      "start": 24.28,
      "end": 26.5
    },
    {
      "id": "shot05-12",
      "text": "一旦你掌握了这套接口，",
      "start": 26.873,
      "end": 28.713
    },
    {
      "id": "shot05-13",
      "text": "把分类切到回归只是一行 import 的事，",
      "start": 28.713,
      "end": 31.573
    },
    {
      "id": "shot05-14",
      "text": "把 KNN 切到决策树或 SVM 也只是",
      "start": 31.573,
      "end": 34.833
    },
    {
      "id": "shot05-15",
      "text": "一行 import 的事。",
      "start": 34.833,
      "end": 35.913
    },
    {
      "id": "shot05-16",
      "text": "这是一个 ML 工程师工具箱里非常划算的投资。",
      "start": 35.913,
      "end": 39.733
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.34
    },
    {
      "id": "shot06-1",
      "text": "02-api 这两期一起讲清楚了三件事。第一，",
      "start": 1.34,
      "end": 5.54
    },
    {
      "id": "shot06-2",
      "text": "sklearn 三件套——构造、fit、",
      "start": 5.54,
      "end": 8.16
    },
    {
      "id": "shot06-3",
      "text": "predict——是 sklearn 全",
      "start": 8.16,
      "end": 10.36
    },
    {
      "id": "shot06-4",
      "text": "家桶的通用接口，",
      "start": 10.36,
      "end": 12.18
    },
    {
      "id": "shot06-5",
      "text": "KNN 只是第一个具体例子。",
      "start": 12.18,
      "end": 14.18
    },
    {
      "id": "shot06-6",
      "text": "第二，",
      "start": 14.18,
      "end": 15.3
    },
    {
      "id": "shot06-7",
      "text": "KNN 是懒学习算法，",
      "start": 15.3,
      "end": 17.8
    },
    {
      "id": "shot06-8",
      "text": "整个训练集本身就是模型，",
      "start": 17.8,
      "end": 19.84
    },
    {
      "id": "shot06-9",
      "text": "所有计算推迟到 predict。",
      "start": 19.84,
      "end": 22.18
    },
    {
      "id": "shot06-10",
      "text": "第三，",
      "start": 22.18,
      "end": 23.32
    },
    {
      "id": "shot06-11",
      "text": "分类和回归在 sklearn 里 API",
      "start": 23.32,
      "end": 26.3
    },
    {
      "id": "shot06-12",
      "text": "完全对称，",
      "start": 26.3,
      "end": 27.6
    },
    {
      "id": "shot06-13",
      "text": "只换 API 类的名字。",
      "start": 27.6,
      "end": 29.36
    },
    {
      "id": "shot06-14",
      "text": "这两期点到没展开的有几个。",
      "start": 29.36,
      "end": 31.5
    },
    {
      "id": "shot06-15",
      "text": "第一，",
      "start": 31.99,
      "end": 32.59
    },
    {
      "id": "shot06-16",
      "text": "回归任务怎么打分——MAE、RMSE、",
      "start": 32.59,
      "end": 36.07
    },
    {
      "id": "shot06-17",
      "text": "R² 这几个指标，",
      "start": 36.07,
      "end": 37.51
    },
    {
      "id": "shot06-18",
      "text": "全部留给本章 05 节超参数搜索专章。第二，",
      "start": 37.51,
      "end": 42.15
    },
    {
      "id": "shot06-19",
      "text": "回归也能用距离加权，",
      "start": 42.15,
      "end": 44.23
    },
    {
      "id": "shot06-20",
      "text": "逻辑和分类的加权一样，",
      "start": 44.23,
      "end": 46.29
    },
    {
      "id": "shot06-21",
      "text": "按需开关。第三，",
      "start": 46.29,
      "end": 48.21
    },
    {
      "id": "shot06-22",
      "text": "sklearn 默认的距离公式是欧氏距离，",
      "start": 48.21,
      "end": 51.33
    },
    {
      "id": "shot06-23",
      "text": "但有时候欧氏不够好用——比如特征量纲差异",
      "start": 51.33,
      "end": 55.01
    },
    {
      "id": "shot06-24",
      "text": "很大时它会失灵。",
      "start": 55.01,
      "end": 56.55
    },
    {
      "id": "shot06-25",
      "text": "这就是下一期的主题：距离族。",
      "start": 56.55,
      "end": 58.79
    },
    {
      "id": "shot06-26",
      "text": "我们把曼哈顿、切比雪夫、",
      "start": 58.79,
      "end": 61.475
    },
    {
      "id": "shot06-27",
      "text": "闵可夫斯基这几种常用的距离公式一次讲清楚，",
      "start": 61.475,
      "end": 64.81
    },
    {
      "id": "shot06-28",
      "text": "看看每种的适用场景。",
      "start": 64.81,
      "end": 66.77
    },
    {
      "id": "shot06-29",
      "text": "如果讲得有不对的地方，",
      "start": 67.1,
      "end": 68.8
    },
    {
      "id": "shot06-30",
      "text": "欢迎在评论区指正。下期见。",
