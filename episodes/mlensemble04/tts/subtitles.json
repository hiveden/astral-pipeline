{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们讲随机森林的两层随机：",
      "start": 0.0,
      "end": 2.722
    },
    {
      "id": "shot01-1",
      "text": "每棵树看不同样本，",
      "start": 2.722,
      "end": 4.344
    },
    {
      "id": "shot01-2",
      "text": "每个节点看部分特征。",
      "start": 4.344,
      "end": 6.145
    },
    {
      "id": "shot01-3",
      "text": "这一期把思想落到代码。",
      "start": 6.145,
      "end": 8.007
    },
    {
      "id": "shot01-4",
      "text": "sklearn 里对应的类叫",
      "start": 8.007,
      "end": 9.809
    },
    {
      "id": "shot01-5",
      "text": "RandomForestClassifier。",
      "start": 9.809,
      "end": 11.65
    },
    {
      "id": "shot01-6",
      "text": "它看起来参数很多，",
      "start": 11.65,
      "end": 13.352
    },
    {
      "id": "shot01-7",
      "text": "但不用被吓到。",
      "start": 13.352,
      "end": 14.933
    },
    {
      "id": "shot01-8",
      "text": "真正需要先抓住的只有几类：",
      "start": 14.933,
      "end": 17.235
    },
    {
      "id": "shot01-9",
      "text": "森林里有多少棵树，",
      "start": 17.235,
      "end": 18.776
    },
    {
      "id": "shot01-10",
      "text": "分裂时看多少特征，",
      "start": 18.776,
      "end": 20.438
    },
    {
      "id": "shot01-11",
      "text": "单棵树要不要设深度刹车，",
      "start": 20.438,
      "end": 22.7
    },
    {
      "id": "shot01-12",
      "text": "是否开启 bootstrap，",
      "start": 22.7,
      "end": 24.461
    },
    {
      "id": "shot01-13",
      "text": "以及随机种子怎么固定。",
      "start": 24.461,
      "end": 26.063
    },
    {
      "id": "shot01-14",
      "text": "然后我们用泰坦尼克生存预测把流程跑通：",
      "start": 26.698,
      "end": 30.065
    },
    {
      "id": "shot01-15",
      "text": "处理缺失值和类别特征，",
      "start": 30.065,
      "end": 32.169
    },
    {
      "id": "shot01-16",
      "text": "训练随机森林，",
      "start": 32.169,
      "end": 33.432
    },
    {
      "id": "shot01-17",
      "text": "做网格搜索，",
      "start": 33.432,
      "end": 34.654
    },
    {
      "id": "shot01-18",
      "text": "再看特征重要性。注意，",
      "start": 34.654,
      "end": 36.598
    },
    {
      "id": "shot01-19",
      "text": "所有准确率都要以同一环境的真实结果为准；",
      "start": 36.598,
      "end": 40.105
    },
    {
      "id": "shot01-20",
      "text": "这里不写固定成绩。",
      "start": 40.105,
      "end": 41.328
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "RandomForestClassifier",
      "start": 0.0,
      "end": 1.643
    },
    {
      "id": "shot02-1",
      "text": "可以按 4 组理解。",
      "start": 1.643,
      "end": 3.207
    },
    {
      "id": "shot02-2",
      "text": "第一组是规模，",
      "start": 3.207,
      "end": 4.79
    },
    {
      "id": "shot02-3",
      "text": "n_estimators 决定森林里有多",
      "start": 4.79,
      "end": 6.955
    },
    {
      "id": "shot02-4",
      "text": "少棵树。树越多，投票越稳，",
      "start": 6.955,
      "end": 9.52
    },
    {
      "id": "shot02-5",
      "text": "但训练越慢，",
      "start": 9.52,
      "end": 10.843
    },
    {
      "id": "shot02-6",
      "text": "收益也会逐渐变小。",
      "start": 10.843,
      "end": 12.907
    },
    {
      "id": "shot02-7",
      "text": "第二组是随机性，",
      "start": 12.907,
      "end": 14.33
    },
    {
      "id": "shot02-8",
      "text": "bootstrap 控制是否有放回抽样，",
      "start": 14.33,
      "end": 17.256
    },
    {
      "id": "shot02-9",
      "text": "max_features 控制每个节点最",
      "start": 17.256,
      "end": 19.38
    },
    {
      "id": "shot02-10",
      "text": "多看多少候选特征。",
      "start": 19.38,
      "end": 21.104
    },
    {
      "id": "shot02-11",
      "text": "第三组是单棵树的刹车，",
      "start": 21.351,
      "end": 23.298
    },
    {
      "id": "shot02-12",
      "text": "比如 max_depth、",
      "start": 23.298,
      "end": 24.381
    },
    {
      "id": "shot02-13",
      "text": "min_samples_split、",
      "start": 24.381,
      "end": 25.626
    },
    {
      "id": "shot02-14",
      "text": "min_samples_leaf，",
      "start": 25.626,
      "end": 26.79
    },
    {
      "id": "shot02-15",
      "text": "它们和决策树里的含义一样，",
      "start": 26.79,
      "end": 28.816
    },
    {
      "id": "shot02-16",
      "text": "用来防止树长得过细。",
      "start": 28.816,
      "end": 30.884
    },
    {
      "id": "shot02-17",
      "text": "第四组是复现，",
      "start": 30.884,
      "end": 32.268
    },
    {
      "id": "shot02-18",
      "text": "random_state 固定随机过程，",
      "start": 32.268,
      "end": 34.516
    },
    {
      "id": "shot02-19",
      "text": "方便我们比较实验结果。",
      "start": 34.516,
      "end": 36.121
    },
    {
      "id": "shot02-20",
      "text": "起手配置可以很朴素：",
      "start": 36.505,
      "end": 38.252
    },
    {
      "id": "shot02-21",
      "text": "n_estimators 先用 100，",
      "start": 38.252,
      "end": 40.239
    },
    {
      "id": "shot02-22",
      "text": "分类任务 max_features 用",
      "start": 40.239,
      "end": 42.167
    },
    {
      "id": "shot02-23",
      "text": "sqrt，",
      "start": 42.167,
      "end": 43.03
    },
    {
      "id": "shot02-24",
      "text": "bootstrap 保持 True，",
      "start": 43.03,
      "end": 44.556
    },
    {
      "id": "shot02-25",
      "text": "random_state 写固定值。",
      "start": 44.556,
      "end": 46.041
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "调随机森林，",
      "start": 0.0,
      "end": 0.981
    },
    {
      "id": "shot03-1",
      "text": "不要一上来把所有参数塞进搜索表。",
      "start": 0.981,
      "end": 3.525
    },
    {
      "id": "shot03-2",
      "text": "先按优先级来。",
      "start": 3.525,
      "end": 4.786
    },
    {
      "id": "shot03-3",
      "text": "第一优先是 n_estimators，",
      "start": 4.786,
      "end": 7.149
    },
    {
      "id": "shot03-4",
      "text": "树太少时投票不稳，",
      "start": 7.149,
      "end": 8.752
    },
    {
      "id": "shot03-5",
      "text": "先拉到计算能接受的数量。",
      "start": 8.752,
      "end": 10.914
    },
    {
      "id": "shot03-6",
      "text": "第二优先是 max_features，",
      "start": 10.914,
      "end": 12.837
    },
    {
      "id": "shot03-7",
      "text": "它直接控制树之间差异。",
      "start": 12.837,
      "end": 15.44
    },
    {
      "id": "shot03-8",
      "text": "分类任务常用 sqrt，",
      "start": 15.44,
      "end": 17.663
    },
    {
      "id": "shot03-9",
      "text": "如果模型过拟合，",
      "start": 17.663,
      "end": 19.045
    },
    {
      "id": "shot03-10",
      "text": "可以适当减少候选特征，",
      "start": 19.045,
      "end": 21.068
    },
    {
      "id": "shot03-11",
      "text": "让树更不一样。",
      "start": 21.068,
      "end": 22.489
    },
    {
      "id": "shot03-12",
      "text": "第三优先才是 max_depth。",
      "start": 22.489,
      "end": 24.272
    },
    {
      "id": "shot03-13",
      "text": "随机森林本身靠集成降低方差，",
      "start": 24.668,
      "end": 27.591
    },
    {
      "id": "shot03-14",
      "text": "所以单棵树可以比普通决策树放得更开；",
      "start": 27.591,
      "end": 30.813
    },
    {
      "id": "shot03-15",
      "text": "但样本量大、特征多、",
      "start": 30.813,
      "end": 32.495
    },
    {
      "id": "shot03-16",
      "text": "训练很慢时，",
      "start": 32.495,
      "end": 33.596
    },
    {
      "id": "shot03-17",
      "text": "限制深度仍然有价值。",
      "start": 33.596,
      "end": 35.437
    },
    {
      "id": "shot03-18",
      "text": "最后才看",
      "start": 35.437,
      "end": 36.218
    },
    {
      "id": "shot03-19",
      "text": "min_samples_split 和",
      "start": 36.218,
      "end": 37.599
    },
    {
      "id": "shot03-20",
      "text": "min_samples_leaf 这种细",
      "start": 37.599,
      "end": 39.18
    },
    {
      "id": "shot03-21",
      "text": "刹车。",
      "start": 39.18,
      "end": 40.181
    },
    {
      "id": "shot03-22",
      "text": "还有一个版本坑：",
      "start": 40.181,
      "end": 41.662
    },
    {
      "id": "shot03-23",
      "text": "旧资料里常见 max_features",
      "start": 41.662,
      "end": 43.844
    },
    {
      "id": "shot03-24",
      "text": "等于 auto，",
      "start": 43.844,
      "end": 44.825
    },
    {
      "id": "shot03-25",
      "text": "新版本 sklearn 已经不推荐，",
      "start": 44.825,
      "end": 47.187
    },
    {
      "id": "shot03-26",
      "text": "分类任务直接写 sqrt 更稳。",
      "start": 47.187,
      "end": 49.469
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "接着看泰坦尼克生存预测。",
      "start": 0.0,
      "end": 2.181
    },
    {
      "id": "shot04-1",
      "text": "这个案例的任务是根据乘客信息预测是否生还。",
      "start": 2.181,
      "end": 5.943
    },
    {
      "id": "shot04-2",
      "text": "数据里既有数值特征，",
      "start": 5.943,
      "end": 7.543
    },
    {
      "id": "shot04-3",
      "text": "也有类别特征，",
      "start": 7.543,
      "end": 8.604
    },
    {
      "id": "shot04-4",
      "text": "还有缺失值。",
      "start": 8.604,
      "end": 10.044
    },
    {
      "id": "shot04-5",
      "text": "流程可以拆成 6 步：读入数据，",
      "start": 10.044,
      "end": 12.505
    },
    {
      "id": "shot04-6",
      "text": "删除明显无用或泄漏风险高的列，",
      "start": 12.505,
      "end": 15.467
    },
    {
      "id": "shot04-7",
      "text": "填补年龄和登船港口的缺失值，",
      "start": 15.467,
      "end": 18.188
    },
    {
      "id": "shot04-8",
      "text": "把性别和登船港口做编码，",
      "start": 18.188,
      "end": 20.769
    },
    {
      "id": "shot04-9",
      "text": "划分训练集和测试集，",
      "start": 20.769,
      "end": 22.85
    },
    {
      "id": "shot04-10",
      "text": "然后训练",
      "start": 22.85,
      "end": 23.71
    },
    {
      "id": "shot04-11",
      "text": "RandomForestClassifier。",
      "start": 23.71,
      "end": 26.072
    },
    {
      "id": "shot04-12",
      "text": "这里随机森林的好处是，",
      "start": 26.072,
      "end": 27.944
    },
    {
      "id": "shot04-13",
      "text": "不需要像线性模型那样强依赖特征缩放，",
      "start": 27.944,
      "end": 31.386
    },
    {
      "id": "shot04-14",
      "text": "也能处理非线性特征组合。",
      "start": 31.386,
      "end": 33.378
    },
    {
      "id": "shot04-15",
      "text": "比如性别、船舱等级、票价、",
      "start": 34.006,
      "end": 36.552
    },
    {
      "id": "shot04-16",
      "text": "年龄之间可能有复杂交互，",
      "start": 36.552,
      "end": 38.847
    },
    {
      "id": "shot04-17",
      "text": "树模型能自然切出这些规则。",
      "start": 38.847,
      "end": 41.062
    },
    {
      "id": "shot04-18",
      "text": "这里先讲流程，",
      "start": 41.062,
      "end": 42.305
    },
    {
      "id": "shot04-19",
      "text": "不承诺具体准确率；",
      "start": 42.305,
      "end": 43.788
    },
    {
      "id": "shot04-20",
      "text": "真正运行时再用 score 和报告里的数",
      "start": 43.788,
      "end": 46.615
    },
    {
      "id": "shot04-21",
      "text": "字做评估。",
      "start": 46.615,
      "end": 47.216
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "基础模型跑通后，",
      "start": 0.0,
      "end": 1.32
    },
    {
      "id": "shot05-1",
      "text": "再做两件事。",
      "start": 1.32,
      "end": 2.341
    },
    {
      "id": "shot05-2",
      "text": "第一件是 GridSearchCV。",
      "start": 2.341,
      "end": 4.381
    },
    {
      "id": "shot05-3",
      "text": "它会把我们给出的参数组合逐个试一遍，",
      "start": 4.381,
      "end": 7.502
    },
    {
      "id": "shot05-4",
      "text": "再用交叉验证比较表现。",
      "start": 7.502,
      "end": 9.783
    },
    {
      "id": "shot05-5",
      "text": "随机森林里最适合先搜的，",
      "start": 9.783,
      "end": 12.084
    },
    {
      "id": "shot05-6",
      "text": "是树的数量和最大深度，",
      "start": 12.084,
      "end": 14.204
    },
    {
      "id": "shot05-7",
      "text": "再加上 max_features。",
      "start": 14.204,
      "end": 16.105
    },
    {
      "id": "shot05-8",
      "text": "搜索空间不要太大，",
      "start": 16.105,
      "end": 17.725
    },
    {
      "id": "shot05-9",
      "text": "否则训练时间会膨胀。",
      "start": 17.725,
      "end": 19.486
    },
    {
      "id": "shot05-10",
      "text": "第二件是看特征重要性。",
      "start": 19.486,
      "end": 21.468
    },
    {
      "id": "shot05-11",
      "text": "随机森林训练完以后，",
      "start": 21.468,
      "end": 23.15
    },
    {
      "id": "shot05-12",
      "text": "会给出每个特征在分裂中贡献了多少不纯度下",
      "start": 23.15,
      "end": 26.654
    },
    {
      "id": "shot05-13",
      "text": "降。",
      "start": 26.654,
      "end": 27.095
    },
    {
      "id": "shot05-14",
      "text": "泰坦尼克里常见的强信号是性别、船舱等级、",
      "start": 27.095,
      "end": 30.819
    },
    {
      "id": "shot05-15",
      "text": "票价、",
      "start": 30.819,
      "end": 31.3
    },
    {
      "id": "shot05-16",
      "text": "年龄这类特征。",
      "start": 31.3,
      "end": 32.221
    },
    {
      "id": "shot05-17",
      "text": "注意，",
      "start": 32.731,
      "end": 33.192
    },
    {
      "id": "shot05-18",
      "text": "特征重要性不是因果解释。",
      "start": 33.192,
      "end": 35.438
    },
    {
      "id": "shot05-19",
      "text": "它只能说模型在这份数据和这组特征下，",
      "start": 35.438,
      "end": 38.947
    },
    {
      "id": "shot05-20",
      "text": "经常借助哪些列做切分。",
      "start": 38.947,
      "end": 41.293
    },
    {
      "id": "shot05-21",
      "text": "真正下业务结论时，",
      "start": 41.293,
      "end": 42.977
    },
    {
      "id": "shot05-22",
      "text": "还要结合数据采集过程和领域知识。",
      "start": 42.977,
      "end": 45.885
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期把随机森林从思想落到了代码。",
      "start": 0.0,
      "end": 3.223
    },
    {
      "id": "shot06-1",
      "text": "我们先把",
      "start": 3.223,
      "end": 3.824
    },
    {
      "id": "shot06-2",
      "text": "RandomForestClassifier",
      "start": 3.824,
      "end": 5.685
    },
    {
      "id": "shot06-3",
      "text": "拆成几组参数：树的数量，",
      "start": 5.685,
      "end": 8.288
    },
    {
      "id": "shot06-4",
      "text": "候选特征数，",
      "start": 8.288,
      "end": 9.649
    },
    {
      "id": "shot06-5",
      "text": "bootstrap 开关，",
      "start": 9.649,
      "end": 10.73
    },
    {
      "id": "shot06-6",
      "text": "单树刹车，",
      "start": 10.73,
      "end": 11.831
    },
    {
      "id": "shot06-7",
      "text": "以及随机种子。",
      "start": 11.831,
      "end": 13.432
    },
    {
      "id": "shot06-8",
      "text": "然后用泰坦尼克案例串起数据清洗、",
      "start": 13.432,
      "end": 16.575
    },
    {
      "id": "shot06-9",
      "text": "类别编码、训练评估、",
      "start": 16.575,
      "end": 18.178
    },
    {
      "id": "shot06-10",
      "text": "网格搜索和特征重要性。",
      "start": 18.178,
      "end": 20.283
    },
    {
      "id": "shot06-11",
      "text": "随机森林这条线到这里基本完整了：",
      "start": 20.283,
      "end": 23.089
    },
    {
      "id": "shot06-12",
      "text": "它用并行的树、",
      "start": 23.089,
      "end": 24.332
    },
    {
      "id": "shot06-13",
      "text": "两层随机和平权投票，",
      "start": 24.332,
      "end": 26.457
    },
    {
      "id": "shot06-14",
      "text": "把高方差的决策树变成稳健基线。",
      "start": 26.457,
      "end": 29.704
    },
    {
      "id": "shot06-15",
      "text": "下一期开始，",
      "start": 29.704,
      "end": 30.546
    },
    {
      "id": "shot06-16",
      "text": "我们换到 boosting 路线。",
      "start": 30.546,
      "end": 31.93
    },
    {
      "id": "shot06-17",
      "text": "和随机森林的平权投票不同，",
      "start": 32.34,
      "end": 34.505
    },
    {
      "id": "shot06-18",
      "text": "AdaBoost 会让错样本变得更重要，",
      "start": 34.505,
      "end": 37.03
    },
    {
      "id": "shot06-19",
      "text": "也会让表现好的弱学习器话语权更大。",
      "start": 37.03,
      "end": 40.136
    },
    {
      "id": "shot06-20",
      "text": "也就是说，",
      "start": 40.136,
      "end": 40.738
    },
    {
      "id": "shot06-21",
      "text": "下一期开始，",
      "start": 40.738,
      "end": 41.68
    },
    {
      "id": "shot06-22",
      "text": "模型之间不再并行投票，",
      "start": 41.68,
      "end": 43.604
    },
    {
      "id": "shot06-23",
      "text": "而是串行接力。",
      "start": 43.604,
      "end": 44.506
    }
  ],
