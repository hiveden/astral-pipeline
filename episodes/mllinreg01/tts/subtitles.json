{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "想象一下，",
      "start": 0.0,
      "end": 0.781
    },
    {
      "id": "shot01-1",
      "text": "已知 5 个人的身高和体重数据：",
      "start": 0.781,
      "end": 3.603
    },
    {
      "id": "shot01-2",
      "text": "160 厘米对应 56.3 公斤，",
      "start": 3.603,
      "end": 6.766
    },
    {
      "id": "shot01-3",
      "text": "166 对应 60.6，",
      "start": 6.766,
      "end": 8.768
    },
    {
      "id": "shot01-4",
      "text": "一直到 180 对应 75。",
      "start": 8.768,
      "end": 10.95
    },
    {
      "id": "shot01-5",
      "text": "现在小明告诉你他身高 176 厘米，",
      "start": 10.95,
      "end": 14.073
    },
    {
      "id": "shot01-6",
      "text": "你能猜他体重多少吗？",
      "start": 14.073,
      "end": 16.095
    },
    {
      "id": "shot01-7",
      "text": "这一期我们讲机器学习的第二站，",
      "start": 16.095,
      "end": 18.517
    },
    {
      "id": "shot01-8",
      "text": "线性回归，",
      "start": 18.517,
      "end": 19.598
    },
    {
      "id": "shot01-9",
      "text": "英文 Linear Regression，",
      "start": 19.598,
      "end": 21.3
    },
    {
      "id": "shot01-10",
      "text": "简写 LR。",
      "start": 21.3,
      "end": 22.541
    },
    {
      "id": "shot01-11",
      "text": "一句话定位它的思想：",
      "start": 22.541,
      "end": 24.283
    },
    {
      "id": "shot01-12",
      "text": "用一根直线把已知数据点串起来，",
      "start": 24.283,
      "end": 27.065
    },
    {
      "id": "shot01-13",
      "text": "再用这根线预测新数据。",
      "start": 27.065,
      "end": 28.847
    },
    {
      "id": "shot01-14",
      "text": "这一期我们解决三件事：",
      "start": 29.118,
      "end": 30.941
    },
    {
      "id": "shot01-15",
      "text": "什么是回归问题；",
      "start": 30.941,
      "end": 32.284
    },
    {
      "id": "shot01-16",
      "text": "从初中的 y = kx + b，",
      "start": 32.284,
      "end": 35.369
    },
    {
      "id": "shot01-17",
      "text": "怎么升级到 ML 里的多元线性回归；",
      "start": 35.369,
      "end": 38.255
    },
    {
      "id": "shot01-18",
      "text": "以及 LR 适合什么场景。",
      "start": 38.255,
      "end": 40.319
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "小明的体重是个连续的数，56、60、",
      "start": 0.0,
      "end": 3.065
    },
    {
      "id": "shot02-1",
      "text": "70 都行——这种预测连续值的问题叫回归。",
      "start": 3.065,
      "end": 6.57
    },
    {
      "id": "shot02-2",
      "text": "和分类对应：",
      "start": 6.57,
      "end": 7.732
    },
    {
      "id": "shot02-3",
      "text": "分类预测离散类别，比如猫狗、",
      "start": 7.732,
      "end": 10.236
    },
    {
      "id": "shot02-4",
      "text": "喜欢不喜欢；",
      "start": 10.236,
      "end": 11.358
    },
    {
      "id": "shot02-5",
      "text": "回归预测连续数字，比如体重、房价、",
      "start": 11.358,
      "end": 14.362
    },
    {
      "id": "shot02-6",
      "text": "销售额。",
      "start": 14.362,
      "end": 15.705
    },
    {
      "id": "shot02-7",
      "text": "LR 解决回归问题的思路非常清晰，",
      "start": 15.705,
      "end": 18.591
    },
    {
      "id": "shot02-8",
      "text": "就两步：先定模型、再求参数。",
      "start": 18.591,
      "end": 21.338
    },
    {
      "id": "shot02-9",
      "text": "第一步定模型——假设身高 x 和体重 y",
      "start": 21.338,
      "end": 24.766
    },
    {
      "id": "shot02-10",
      "text": "之间的关系可以用一条直线描述：",
      "start": 24.766,
      "end": 27.231
    },
    {
      "id": "shot02-11",
      "text": "y = kx + b。",
      "start": 27.231,
      "end": 29.356
    },
    {
      "id": "shot02-12",
      "text": "这是初中的一次函数，",
      "start": 29.356,
      "end": 30.9
    },
    {
      "id": "shot02-13",
      "text": "k 是斜率，",
      "start": 30.9,
      "end": 31.862
    },
    {
      "id": "shot02-14",
      "text": "b 是截距。",
      "start": 31.862,
      "end": 32.444
    },
    {
      "id": "shot02-15",
      "text": "第二步求参数——根据已知 5 个点，",
      "start": 32.904,
      "end": 35.708
    },
    {
      "id": "shot02-16",
      "text": "找出最合适的 k 和 b。",
      "start": 35.708,
      "end": 37.67
    },
    {
      "id": "shot02-17",
      "text": "直觉上肉眼就能比划一根线，",
      "start": 37.67,
      "end": 39.873
    },
    {
      "id": "shot02-18",
      "text": "但等数据涨到 1000 个点、",
      "start": 39.873,
      "end": 41.856
    },
    {
      "id": "shot02-19",
      "text": "特征涨到 10 维，",
      "start": 41.856,
      "end": 43.478
    },
    {
      "id": "shot02-20",
      "text": "人脑画不动了，",
      "start": 43.478,
      "end": 44.72
    },
    {
      "id": "shot02-21",
      "text": "需要算法自动求最优解。",
      "start": 44.72,
      "end": 47.384
    },
    {
      "id": "shot02-22",
      "text": "算法版求解的具体方法，",
      "start": 47.384,
      "end": 49.547
    },
    {
      "id": "shot02-23",
      "text": "是后面三期的核心：",
      "start": 49.547,
      "end": 51.289
    },
    {
      "id": "shot02-24",
      "text": "怎么衡量哪条线最好叫损失函数；",
      "start": 51.289,
      "end": 54.333
    },
    {
      "id": "shot02-25",
      "text": "一步求出闭式解叫正规方程；",
      "start": 54.333,
      "end": 56.957
    },
    {
      "id": "shot02-26",
      "text": "迭代逼近叫梯度下降。",
      "start": 56.957,
      "end": 58.959
    },
    {
      "id": "shot02-27",
      "text": "这一期我们先把模型这一边讲清楚。",
      "start": 58.959,
      "end": 61.463
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "我们打开互动 demo 把这套思路跑一遍。",
      "start": 0.0,
      "end": 2.924
    },
    {
      "id": "shot03-1",
      "text": "屏幕左侧是一张二维散点图，",
      "start": 2.924,
      "end": 5.427
    },
    {
      "id": "shot03-2",
      "text": "横轴写的是身高减 160 厘米。",
      "start": 5.427,
      "end": 7.99
    },
    {
      "id": "shot03-3",
      "text": "这里有个小细节：",
      "start": 7.99,
      "end": 9.231
    },
    {
      "id": "shot03-4",
      "text": "demo 为了让 b 落在直观范围，",
      "start": 9.231,
      "end": 11.554
    },
    {
      "id": "shot03-5",
      "text": "把横轴零点移到了 160——本质上是同一条直线，",
      "start": 11.554,
      "end": 15.479
    },
    {
      "id": "shot03-7",
      "text": "只是把刻度尺平移了一下。",
      "start": 15.479,
      "end": 17.822
    },
    {
      "id": "shot03-8",
      "text": "纵轴是体重，单位公斤。",
      "start": 17.822,
      "end": 20.025
    },
    {
      "id": "shot03-9",
      "text": "5 个蓝点是已知数据，",
      "start": 20.025,
      "end": 21.767
    },
    {
      "id": "shot03-10",
      "text": "中间那条红线就是 LR 拟合的直线。",
      "start": 21.767,
      "end": 24.811
    },
    {
      "id": "shot03-11",
      "text": "左边两个一元滑块控制 k 和 b。",
      "start": 24.811,
      "end": 27.254
    },
    {
      "id": "shot03-12",
      "text": "每个数据点旁有一个红色方块，",
      "start": 27.777,
      "end": 30.321
    },
    {
      "id": "shot03-13",
      "text": "方块面积代表这个点离直线的偏差平方。",
      "start": 30.321,
      "end": 33.546
    },
    {
      "id": "shot03-14",
      "text": "右侧是残差表，",
      "start": 33.546,
      "end": 34.848
    },
    {
      "id": "shot03-15",
      "text": "列出每个点的真实值、",
      "start": 34.848,
      "end": 36.491
    },
    {
      "id": "shot03-16",
      "text": "预测值和误差平方；",
      "start": 36.491,
      "end": 38.193
    },
    {
      "id": "shot03-17",
      "text": "表格底部的合计 MSE，",
      "start": 38.193,
      "end": 40.657
    },
    {
      "id": "shot03-18",
      "text": "就是这些红方块面积的平均，",
      "start": 40.657,
      "end": 42.981
    },
    {
      "id": "shot03-19",
      "text": "越小拟合越好。",
      "start": 42.981,
      "end": 44.824
    },
    {
      "id": "shot03-20",
      "text": "我们先把 k 调到 0.5、",
      "start": 44.824,
      "end": 47.107
    },
    {
      "id": "shot03-21",
      "text": "b 调到 50，看：",
      "start": 47.107,
      "end": 48.83
    },
    {
      "id": "shot03-22",
      "text": "5 个红方块缩到很小，",
      "start": 48.83,
      "end": 50.813
    },
    {
      "id": "shot03-23",
      "text": "右侧合计 MSE 也降到很低。",
      "start": 50.813,
      "end": 53.618
    },
    {
      "id": "shot03-24",
      "text": "MSE 是均方误差 Mean Squared Error，",
      "start": 54.007,
      "end": 56.73
    },
    {
      "id": "shot03-26",
      "text": "具体公式留给下一期损失函数那一期展开，",
      "start": 56.73,
      "end": 59.892
    },
    {
      "id": "shot03-27",
      "text": "本期只用它当拟合分数读。",
      "start": 59.892,
      "end": 62.155
    },
    {
      "id": "shot03-28",
      "text": "如果把 k 拉到 1.5，直线变陡，",
      "start": 62.155,
      "end": 64.617
    },
    {
      "id": "shot03-29",
      "text": "红方块全部胀大，",
      "start": 64.617,
      "end": 66.098
    },
    {
      "id": "shot03-30",
      "text": "右侧合计 MSE 会飙起来——直线明显偏离了数据。",
      "start": 66.098,
      "end": 70.422
    },
    {
      "id": "shot03-32",
      "text": "如果把 b 调到 30，",
      "start": 70.422,
      "end": 72.104
    },
    {
      "id": "shot03-33",
      "text": "整条线下移，",
      "start": 72.104,
      "end": 73.265
    },
    {
      "id": "shot03-34",
      "text": "所有点都跑到线上方，",
      "start": 73.265,
      "end": 75.146
    },
    {
      "id": "shot03-35",
      "text": "红方块也全部变大。",
      "start": 75.146,
      "end": 76.588
    },
    {
      "id": "shot03-36",
      "text": "这就是 LR 在一元情况下的核心动作：",
      "start": 76.588,
      "end": 79.611
    },
    {
      "id": "shot03-37",
      "text": "调动 k 和 b 这两个旋钮，",
      "start": 79.611,
      "end": 81.492
    },
    {
      "id": "shot03-38",
      "text": "让所有红方块缩到最小。",
      "start": 81.492,
      "end": 83.234
    },
    {
      "id": "shot03-39",
      "text": "怎么自动算出这组最优 k 和 b，",
      "start": 83.675,
      "end": 86.349
    },
    {
      "id": "shot03-40",
      "text": "留给后面章节，",
      "start": 86.349,
      "end": 87.695
    },
    {
      "id": "shot03-41",
      "text": "这一期先建立直觉：",
      "start": 87.695,
      "end": 89.263
    },
    {
      "id": "shot03-42",
      "text": "模型只有 2 个参数，",
      "start": 89.263,
      "end": 91.032
    },
    {
      "id": "shot03-43",
      "text": "调对了就贴合数据。",
      "start": 91.032,
      "end": 92.761
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "一元讲完，",
      "start": 0.0,
      "end": 0.901
    },
    {
      "id": "shot04-1",
      "text": "看真实业务场景。",
      "start": 0.901,
      "end": 2.304
    },
    {
      "id": "shot04-2",
      "text": "打个工资的比方：",
      "start": 2.304,
      "end": 3.646
    },
    {
      "id": "shot04-3",
      "text": "月薪 = 50×加班 + 200×签单 + 100×工龄 + 5000——",
      "start": 3.646,
      "end": 9.394
    },
    {
      "id": "shot04-5",
      "text": "—加班一小时加 50 元、",
      "start": 9.394,
      "end": 10.937
    },
    {
      "id": "shot04-6",
      "text": "签单一单加 200 元、",
      "start": 10.937,
      "end": 12.339
    },
    {
      "id": "shot04-7",
      "text": "工龄一年加 100 元，",
      "start": 12.339,
      "end": 13.701
    },
    {
      "id": "shot04-8",
      "text": "每件事都有自己的'汇率'对应一个权重 w；",
      "start": 13.701,
      "end": 17.447
    },
    {
      "id": "shot04-9",
      "text": "底薪 5000 是所有人共享的偏置 b。",
      "start": 17.447,
      "end": 20.571
    },
    {
      "id": "shot04-10",
      "text": "三个特征三个权重旋钮，",
      "start": 20.571,
      "end": 22.574
    },
    {
      "id": "shot04-11",
      "text": "但偏置永远只有一个。",
      "start": 22.574,
      "end": 23.997
    },
    {
      "id": "shot04-12",
      "text": "同理预测房价不会只用面积一个特征——还有",
      "start": 24.53,
      "end": 27.672
    },
    {
      "id": "shot04-13",
      "text": "位置、楼层、朝向，",
      "start": 27.672,
      "end": 29.333
    },
    {
      "id": "shot04-14",
      "text": "4 个特征都影响最终价格。",
      "start": 29.333,
      "end": 31.394
    },
    {
      "id": "shot04-15",
      "text": "每多一个特征，",
      "start": 31.394,
      "end": 32.195
    },
    {
      "id": "shot04-16",
      "text": "LR 公式就多一项：",
      "start": 32.195,
      "end": 34.196
    },
    {
      "id": "shot04-17",
      "text": "一元是 y = kx + b；",
      "start": 34.196,
      "end": 37.077
    },
    {
      "id": "shot04-18",
      "text": "二元是 y = w1x1 + w2x2 + b；",
      "start": 37.077,
      "end": 42.06
    },
    {
      "id": "shot04-20",
      "text": "n 元就是 n 个权重项加偏置 b。",
      "start": 42.06,
      "end": 44.682
    },
    {
      "id": "shot04-21",
      "text": "这里把斜率 k 改名叫权重 weight，",
      "start": 45.256,
      "end": 48.101
    },
    {
      "id": "shot04-22",
      "text": "写成 w；",
      "start": 48.101,
      "end": 48.922
    },
    {
      "id": "shot04-23",
      "text": "把截距 b 改名叫偏置 bias——含义完全没变，",
      "start": 48.922,
      "end": 52.648
    },
    {
      "id": "shot04-25",
      "text": "只是高维下“斜率”几何上画不出来，",
      "start": 52.648,
      "end": 55.633
    },
    {
      "id": "shot04-26",
      "text": "借了“加权求和”里的“权”字更直观。",
      "start": 55.633,
      "end": 58.758
    },
    {
      "id": "shot04-27",
      "text": "同一对参数有三种叫法：",
      "start": 58.758,
      "end": 60.881
    },
    {
      "id": "shot04-28",
      "text": "数学课叫斜率截距，",
      "start": 60.881,
      "end": 62.864
    },
    {
      "id": "shot04-29",
      "text": "sklearn 工程实现叫 coef 和 intercept，",
      "start": 62.864,
      "end": 66.49
    },
    {
      "id": "shot04-31",
      "text": "神经网络叫 weight 和 bias，",
      "start": 66.49,
      "end": 68.573
    },
    {
      "id": "shot04-32",
      "text": "看到这三套词都是指 (w, b) 那一对。",
      "start": 68.573,
      "end": 71.578
    },
    {
      "id": "shot04-34",
      "text": "几何上一元拟合的是一条直线，",
      "start": 71.802,
      "end": 74.372
    },
    {
      "id": "shot04-35",
      "text": "二元拟合的是一个平面，",
      "start": 74.372,
      "end": 76.44
    },
    {
      "id": "shot04-36",
      "text": "三元以上人脑画不出来但代数完全一样。",
      "start": 76.44,
      "end": 80.014
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "回到 demo，",
      "start": 0.0,
      "end": 0.941
    },
    {
      "id": "shot05-1",
      "text": "切换到二元视角。",
      "start": 0.941,
      "end": 2.262
    },
    {
      "id": "shot05-2",
      "text": "屏幕左侧现在是二元散点图，",
      "start": 2.262,
      "end": 4.463
    },
    {
      "id": "shot05-3",
      "text": "横轴还是身高减 160，",
      "start": 4.463,
      "end": 6.445
    },
    {
      "id": "shot05-4",
      "text": "纵轴变成工龄年数；",
      "start": 6.445,
      "end": 8.286
    },
    {
      "id": "shot05-5",
      "text": "右侧是公式代入说明，",
      "start": 8.286,
      "end": 9.967
    },
    {
      "id": "shot05-6",
      "text": "展示当前参数怎么算出预测值。",
      "start": 9.967,
      "end": 12.95
    },
    {
      "id": "shot05-7",
      "text": "背景色阶代表 LR 模型预测的体重——偏紫表示预测较轻，",
      "start": 12.95,
      "end": 17.693
    },
    {
      "id": "shot05-9",
      "text": "偏黄表示预测较重。",
      "start": 17.693,
      "end": 19.315
    },
    {
      "id": "shot05-10",
      "text": "15 个散点是已知样本，",
      "start": 19.315,
      "end": 21.196
    },
    {
      "id": "shot05-11",
      "text": "每个点的颜色是真实体重，",
      "start": 21.196,
      "end": 23.338
    },
    {
      "id": "shot05-12",
      "text": "背景色是模型预测。",
      "start": 23.338,
      "end": 24.959
    },
    {
      "id": "shot05-13",
      "text": "背景色和散点色融合到肉眼分不出，",
      "start": 24.959,
      "end": 28.041
    },
    {
      "id": "shot05-14",
      "text": "就是拟合得好。",
      "start": 28.041,
      "end": 29.197
    },
    {
      "id": "shot05-15",
      "text": "控件多了一个滑块 w2，",
      "start": 29.197,
      "end": 31.699
    },
    {
      "id": "shot05-16",
      "text": "控制工龄对体重的影响。",
      "start": 31.699,
      "end": 33.411
    },
    {
      "id": "shot05-17",
      "text": "当前 w1 是 0.5、",
      "start": 33.949,
      "end": 35.709
    },
    {
      "id": "shot05-18",
      "text": "w2 是 0.3、",
      "start": 35.709,
      "end": 37.35
    },
    {
      "id": "shot05-19",
      "text": "b 是 50，",
      "start": 37.35,
      "end": 38.25
    },
    {
      "id": "shot05-20",
      "text": "背景和散点融合在一起，",
      "start": 38.25,
      "end": 40.371
    },
    {
      "id": "shot05-21",
      "text": "这是这组数据的真实参数。",
      "start": 40.371,
      "end": 42.491
    },
    {
      "id": "shot05-22",
      "text": "如果把 w2 拉到负 1，",
      "start": 42.491,
      "end": 44.492
    },
    {
      "id": "shot05-23",
      "text": "模型就会认为工龄越长体重越轻，",
      "start": 44.492,
      "end": 47.433
    },
    {
      "id": "shot05-24",
      "text": "沿工龄方向的色阶反过来了；",
      "start": 47.433,
      "end": 50.054
    },
    {
      "id": "shot05-25",
      "text": "这时散点和背景明显错配，",
      "start": 50.054,
      "end": 52.614
    },
    {
      "id": "shot05-26",
      "text": "预测和事实就矛盾了。",
      "start": 52.614,
      "end": 54.755
    },
    {
      "id": "shot05-27",
      "text": "再切到 3D 视角：",
      "start": 54.755,
      "end": 56.455
    },
    {
      "id": "shot05-28",
      "text": "左侧的 LR 模型变成一个倾斜的平面，",
      "start": 56.455,
      "end": 59.856
    },
    {
      "id": "shot05-29",
      "text": "右侧保留同一个模型的俯视图。",
      "start": 59.856,
      "end": 62.518
    },
    {
      "id": "shot05-30",
      "text": "沿身高方向的坡度是 w1，",
      "start": 62.518,
      "end": 65.032
    },
    {
      "id": "shot05-31",
      "text": "沿工龄方向的坡度是 w2，",
      "start": 65.032,
      "end": 67.425
    },
    {
      "id": "shot05-32",
      "text": "平面整体上下平移是 b。",
      "start": 67.425,
      "end": 69.456
    },
    {
      "id": "shot05-33",
      "text": "每个数据点用红色虚线垂直连到平面上，",
      "start": 69.971,
      "end": 73.275
    },
    {
      "id": "shot05-34",
      "text": "虚线越短拟合越好。",
      "start": 73.275,
      "end": 74.938
    },
    {
      "id": "shot05-35",
      "text": "最后勾选“锁 w2 等于 0”。",
      "start": 74.938,
      "end": 77.221
    },
    {
      "id": "shot05-36",
      "text": "右侧二元图只剩下随身高变化的一列列竖条纹，",
      "start": 77.221,
      "end": 81.099
    },
    {
      "id": "shot05-37",
      "text": "工龄方向上颜色不再变化。注意，",
      "start": 81.099,
      "end": 83.629
    },
    {
      "id": "shot05-38",
      "text": "这里演示的是模型形式退化：",
      "start": 83.629,
      "end": 85.832
    },
    {
      "id": "shot05-39",
      "text": "如果把工龄权重清零，",
      "start": 85.832,
      "end": 87.494
    },
    {
      "id": "shot05-40",
      "text": "二元公式就退回只看身高的一元形式；",
      "start": 87.494,
      "end": 90.398
    },
    {
      "id": "shot05-41",
      "text": "但这批数据本来包含工龄影响，",
      "start": 90.398,
      "end": 92.761
    },
    {
      "id": "shot05-42",
      "text": "所以 MSE 会变大。",
      "start": 92.761,
      "end": 94.243
    },
    {
      "id": "shot05-43",
      "text": "这样看，",
      "start": 94.638,
      "end": 95.219
    },
    {
      "id": "shot05-44",
      "text": "w 其实就是一组数字打包到一起（数学课叫",
      "start": 95.219,
      "end": 98.664
    },
    {
      "id": "shot05-45",
      "text": "向量 vector，",
      "start": 98.664,
      "end": 99.805
    },
    {
      "id": "shot05-46",
      "text": "下一章 04b 矩阵化正式讲）：",
      "start": 99.805,
      "end": 102.188
    },
    {
      "id": "shot05-47",
      "text": "多一个特征多一维；",
      "start": 102.188,
      "end": 103.71
    },
    {
      "id": "shot05-48",
      "text": "如果某个特征不用，",
      "start": 103.71,
      "end": 105.192
    },
    {
      "id": "shot05-49",
      "text": "就把对应权重设成 0。",
      "start": 105.192,
      "end": 106.755
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "什么时候用 LR？",
      "start": 0.0,
      "end": 1.562
    },
    {
      "id": "shot06-1",
      "text": "只要因变量和自变量有近似线性关系都能用—",
      "start": 1.562,
      "end": 5.427
    },
    {
      "id": "shot06-2",
      "text": "—房价预测、销售预测、",
      "start": 5.427,
      "end": 7.51
    },
    {
      "id": "shot06-3",
      "text": "GDP 与经济指标、剂量反应、设备能耗，",
      "start": 7.51,
      "end": 10.854
    },
    {
      "id": "shot06-4",
      "text": "这些都是经典场景。",
      "start": 10.854,
      "end": 13.057
    },
    {
      "id": "shot06-5",
      "text": "LR 在工业界还有一个特殊地位：",
      "start": 13.057,
      "end": 15.881
    },
    {
      "id": "shot06-6",
      "text": "任何回归任务，",
      "start": 15.881,
      "end": 17.362
    },
    {
      "id": "shot06-7",
      "text": "先用 LR 跑一遍做 baseline，",
      "start": 17.362,
      "end": 20.026
    },
    {
      "id": "shot06-8",
      "text": "记下评分，",
      "start": 20.026,
      "end": 21.087
    },
    {
      "id": "shot06-9",
      "text": "再上更复杂的树模型或神经网络，",
      "start": 21.087,
      "end": 24.411
    },
    {
      "id": "shot06-10",
      "text": "复杂模型必须显著优于 LR 才值得用。",
      "start": 24.411,
      "end": 27.896
    },
    {
      "id": "shot06-11",
      "text": "原因有三个——LR 训练快，毫秒级；",
      "start": 28.208,
      "end": 31.47
    },
    {
      "id": "shot06-12",
      "text": "可解释，",
      "start": 31.47,
      "end": 32.271
    },
    {
      "id": "shot06-13",
      "text": "权重大小和正负号直接告诉你哪个特征影响大、",
      "start": 32.271,
      "end": 36.094
    },
    {
      "id": "shot06-14",
      "text": "是正相关还是负相关；",
      "start": 36.094,
      "end": 38.025
    },
    {
      "id": "shot06-15",
      "text": "凸优化没有局部最优陷阱，结果稳定。",
      "start": 38.025,
      "end": 41.118
    },
    {
      "id": "shot06-16",
      "text": "反过来什么时候别用？",
      "start": 41.118,
      "end": 42.939
    },
    {
      "id": "shot06-17",
      "text": "如果因变量是离散类别，比如猫狗、",
      "start": 42.939,
      "end": 46.161
    },
    {
      "id": "shot06-18",
      "text": "喜欢不喜欢，",
      "start": 46.161,
      "end": 47.162
    },
    {
      "id": "shot06-19",
      "text": "要用逻辑回归或决策树；",
      "start": 47.162,
      "end": 49.387
    },
    {
      "id": "shot06-20",
      "text": "明显非线性又没法用多项式特征矫正的，",
      "start": 49.387,
      "end": 52.876
    },
    {
      "id": "shot06-21",
      "text": "用树模型或神经网络；",
      "start": 52.876,
      "end": 55.081
    },
    {
      "id": "shot06-22",
      "text": "特征之间强相关导致权重不稳的，",
      "start": 55.081,
      "end": 58.249
    },
    {
      "id": "shot06-23",
      "text": "用岭回归 Ridge 或 Lasso，",
      "start": 58.249,
      "end": 60.434
    },
    {
      "id": "shot06-24",
      "text": "这是后面正则化那一期的内容。",
      "start": 60.434,
      "end": 62.318
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.982
    },
    {
      "id": "shot07-1",
      "text": "我们解决了 LR 的入门三件事：第一，",
      "start": 0.982,
      "end": 4.088
    },
    {
      "id": "shot07-2",
      "text": "回归预测连续值，",
      "start": 4.088,
      "end": 5.631
    },
    {
      "id": "shot07-3",
      "text": "分类预测离散类别；第二，",
      "start": 5.631,
      "end": 7.835
    },
    {
      "id": "shot07-4",
      "text": "模型公式从一元的 y = kx + b，",
      "start": 7.835,
      "end": 11.943
    },
    {
      "id": "shot07-6",
      "text": "升级到多元：y = wᵀx + b——每个特征对应一个权重，",
      "start": 11.943,
      "end": 17.634
    },
    {
      "id": "shot07-8",
      "text": "偏置永远共享一个；第三，",
      "start": 17.634,
      "end": 20.399
    },
    {
      "id": "shot07-9",
      "text": "LR 适合任何近似线性的回归任务，",
      "start": 20.399,
      "end": 23.685
    },
    {
      "id": "shot07-10",
      "text": "工业界用作 baseline。",
      "start": 23.685,
      "end": 25.148
    },
    {
      "id": "shot07-11",
      "text": "这一期点到但没展开的：",
      "start": 25.434,
      "end": 27.238
    },
    {
      "id": "shot07-12",
      "text": "怎么衡量“哪条线最好”留给损失函数那一期；",
      "start": 27.238,
      "end": 30.604
    },
    {
      "id": "shot07-13",
      "text": "怎么自动求出最优 w 和 b，",
      "start": 30.604,
      "end": 33.831
    },
    {
      "id": "shot07-14",
      "text": "留给正规方程和梯度下降那两期；",
      "start": 33.831,
      "end": 35.594
    },
    {
      "id": "shot07-15",
      "text": "多项式 LR 怎么拟合弯曲数据，",
      "start": 35.594,
      "end": 39.221
    },
    {
      "id": "shot07-16",
      "text": "留给过拟合那一期。",
      "start": 39.221,
      "end": 40.223
    },
    {
      "id": "shot07-17",
      "text": "下一期我们换个角度，",
      "start": 40.223,
      "end": 41.806
    },
    {
      "id": "shot07-18",
      "text": "不再手算 k 和 b，",
      "start": 41.806,
      "end": 43.33
    },
    {
      "id": "shot07-19",
      "text": "而是用 sklearn 4 行代码",
      "start": 43.33,
      "end": 45.975
    },
    {
      "id": "shot07-20",
      "text": "调用线性回归——看一眼工业界的标准用法。",
      "start": 45.975,
      "end": 48.4
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.753
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.753,
      "end": 2.097
    }
  ],
  "shot09": [
    {
      "id": "shot09-0",
      "text": "打开 demo 前，",
      "start": 0.0,
      "end": 1.021
    },
    {
      "id": "shot09-1",
      "text": "先补一个看画面的提示。",
      "start": 1.021,
      "end": 3.063
    },
    {
      "id": "shot09-2",
      "text": "接下来的一元 demo 里，",
      "start": 3.063,
      "end": 4.564
    },
    {
      "id": "shot09-3",
      "text": "先不要纠结公式推导，",
      "start": 4.564,
      "end": 6.465
    },
    {
      "id": "shot09-4",
      "text": "只抓住三件事。第一，",
      "start": 6.465,
      "end": 8.347
    },
    {
      "id": "shot09-5",
      "text": "k 控制直线的斜率，",
      "start": 8.347,
      "end": 10.128
    },
    {
      "id": "shot09-6",
      "text": "也就是这条线有多陡；",
      "start": 10.128,
      "end": 11.73
    },
    {
      "id": "shot09-7",
      "text": "b 控制整条线整体上移还是下移。第二，",
      "start": 11.73,
      "end": 15.433
    },
    {
      "id": "shot09-8",
      "text": "蓝点是真实数据，",
      "start": 15.433,
      "end": 16.894
    },
    {
      "id": "shot09-9",
      "text": "红线是当前模型，",
      "start": 16.894,
      "end": 18.495
    },
    {
      "id": "shot09-10",
      "text": "红方块表示每个点离红线有多远；",
      "start": 18.495,
      "end": 21.277
    },
    {
      "id": "shot09-11",
      "text": "红方块越小，",
      "start": 21.277,
      "end": 22.398
    },
    {
      "id": "shot09-12",
      "text": "说明这条线越贴近数据。第三，",
      "start": 22.398,
      "end": 24.82
    },
    {
      "id": "shot09-13",
      "text": "MSE 先当成一个偏差总分读就行——分数",
      "start": 24.82,
      "end": 28.567
    },
    {
      "id": "shot09-14",
      "text": "越小拟合越好，",
      "start": 28.567,
      "end": 29.916
    },
    {
      "id": "shot09-15",
      "text": "具体公式下一期损失函数再展开。",
      "start": 29.916,
      "end": 32.293
    },
    {
      "id": "shot09-16",
      "text": "还有一个容易混的地方：",
      "start": 32.741,
      "end": 34.242
    },
    {
      "id": "shot09-17",
      "text": "demo 为了让 b 的数字更直观，",
      "start": 34.242,
      "end": 36.984
    },
    {
      "id": "shot09-18",
      "text": "把横轴写成了“身高减 160”，",
      "start": 36.984,
      "end": 39.745
    },
    {
      "id": "shot09-19",
      "text": "所以 b 的数值会和真实身高坐标下不同，",
      "start": 39.745,
      "end": 42.927
    },
    {
      "id": "shot09-20",
      "text": "但直线思想完全一样。",
      "start": 42.927,
      "end": 44.608
    }
  ],
  "shot10": [
    {
      "id": "shot10-0",
      "text": "切到二元 demo 前，",
      "start": 0.0,
      "end": 1.222
    },
    {
      "id": "shot10-1",
      "text": "先打个补丁：",
      "start": 1.222,
      "end": 2.243
    },
    {
      "id": "shot10-2",
      "text": "这里的“工龄”不是在认真说工龄决定体重，",
      "start": 2.243,
      "end": 5.387
    },
    {
      "id": "shot10-3",
      "text": "也不是现实业务建议。",
      "start": 5.387,
      "end": 7.01
    },
    {
      "id": "shot10-4",
      "text": "它只是一个临时造出来的第二个数字，",
      "start": 7.01,
      "end": 9.553
    },
    {
      "id": "shot10-5",
      "text": "用来让屏幕上多一根轴，",
      "start": 9.553,
      "end": 11.396
    },
    {
      "id": "shot10-6",
      "text": "好看清“多一个特征，",
      "start": 11.396,
      "end": 12.918
    },
    {
      "id": "shot10-7",
      "text": "就多一个权重旋钮”这件事。",
      "start": 12.918,
      "end": 15.181
    },
    {
      "id": "shot10-8",
      "text": "你可以把它想成任何第二特征：年龄、",
      "start": 15.181,
      "end": 17.805
    },
    {
      "id": "shot10-9",
      "text": "运动量、",
      "start": 17.805,
      "end": 18.505
    },
    {
      "id": "shot10-10",
      "text": "睡眠时长都行。",
      "start": 18.505,
      "end": 19.447
    },
    {
      "id": "shot10-11",
      "text": "demo 继续沿用体重，",
      "start": 19.447,
      "end": 21.209
    },
    {
      "id": "shot10-12",
      "text": "是为了和前面身高体重那条线接上；",
      "start": 21.209,
      "end": 23.873
    },
    {
      "id": "shot10-13",
      "text": "加上工龄，",
      "start": 23.873,
      "end": 24.754
    },
    {
      "id": "shot10-14",
      "text": "只是为了把一元直线升级成二元平面。",
      "start": 24.754,
      "end": 27.298
    },
    {
      "id": "shot10-15",
      "text": "接下来重点别放在工龄和体重有没有真实因果，",
      "start": 27.868,
      "end": 31.524
    },
    {
      "id": "shot10-16",
      "text": "而是看 w2 这个旋钮：",
      "start": 31.524,
      "end": 33.292
    },
    {
      "id": "shot10-17",
      "text": "w2 变正、变负、",
      "start": 33.292,
      "end": 35.02
    },
    {
      "id": "shot10-18",
      "text": "或者锁成 0，",
      "start": 35.02,
      "end": 36.105
    },
    {
      "id": "shot10-19",
      "text": "模型画面会怎么变。",
      "start": 36.105,
      "end": 37.27
    }
  ],
  "shot11": [
    {
      "id": "shot11-0",
      "text": "收尾里如果你看到 wᵀx，",
      "start": 0.0,
      "end": 2.584
    },
    {
      "id": "shot11-1",
      "text": "先不用被右上角那个 T 卡住。",
      "start": 2.584,
      "end": 4.767
    },
    {
      "id": "shot11-2",
      "text": "它只是数学里把“很多项加权求和”",
      "start": 4.767,
      "end": 8.172
    },
    {
      "id": "shot11-3",
      "text": "写短的一种记号。",
      "start": 8.172,
      "end": 8.833
    },
    {
      "id": "shot11-4",
      "text": "展开看就是：",
      "start": 8.833,
      "end": 9.774
    },
    {
      "id": "shot11-5",
      "text": "w1 乘 x1，",
      "start": 9.774,
      "end": 11.056
    },
    {
      "id": "shot11-6",
      "text": "加 w2 乘 x2，",
      "start": 11.056,
      "end": 12.678
    },
    {
      "id": "shot11-7",
      "text": "一直加到 wn 乘 xn。",
      "start": 12.678,
      "end": 15.022
    },
    {
      "id": "shot11-8",
      "text": "w 是每个特征的权重，",
      "start": 15.022,
      "end": 17.085
    },
    {
      "id": "shot11-9",
      "text": "x 是这一条样本的特征值；",
      "start": 17.085,
      "end": 19.448
    },
    {
      "id": "shot11-10",
      "text": "对应位置相乘，",
      "start": 19.448,
      "end": 20.65
    },
    {
      "id": "shot11-11",
      "text": "再全部加起来。",
      "start": 20.65,
      "end": 21.992
    },
    {
      "id": "shot11-12",
      "text": "右上角的 T 叫转置 transpose，",
      "start": 21.992,
      "end": 24.595
    },
    {
      "id": "shot11-13",
      "text": "完整含义留到后面矩阵那一期讲。",
      "start": 24.595,
      "end": 26.919
    },
    {
      "id": "shot11-14",
      "text": "本期你只需要把 wᵀx 读成一句话：",
      "start": 27.425,
      "end": 31.372
    },
    {
      "id": "shot11-15",
      "text": "所有特征各乘自己的权重，再加总。",
      "start": 31.372,
      "end": 34.453
    }
  ],
  "shot12": [
    {
      "id": "shot12-0",
      "text": "讲应用场景时会冒出几个以后才正式展开的词，",
      "start": 0.0,
      "end": 3.983
    },
    {
      "id": "shot12-1",
      "text": "先别被它们打断。",
      "start": 3.983,
      "end": 5.324
    },
    {
      "id": "shot12-2",
      "text": "baseline 就是参照分数：",
      "start": 5.324,
      "end": 7.125
    },
    {
      "id": "shot12-3",
      "text": "先拿 LR 跑一版，",
      "start": 7.125,
      "end": 8.926
    },
    {
      "id": "shot12-4",
      "text": "看最简单模型能做到多少分，",
      "start": 8.926,
      "end": 11.248
    },
    {
      "id": "shot12-5",
      "text": "后面复杂模型必须明显超过它才值得用。",
      "start": 11.248,
      "end": 14.991
    },
    {
      "id": "shot12-6",
      "text": "凸优化这里先理解成：",
      "start": 14.991,
      "end": 16.692
    },
    {
      "id": "shot12-7",
      "text": "这类损失通常像一个碗，",
      "start": 16.692,
      "end": 18.633
    },
    {
      "id": "shot12-8",
      "text": "最低点稳定，",
      "start": 18.633,
      "end": 19.854
    },
    {
      "id": "shot12-9",
      "text": "不太会陷进奇怪的小坑。",
      "start": 19.854,
      "end": 21.616
    },
    {
      "id": "shot12-10",
      "text": "Ridge 和 Lasso 是线性回归的",
      "start": 21.616,
      "end": 23.957
    },
    {
      "id": "shot12-11",
      "text": "两个改造版，",
      "start": 23.957,
      "end": 25.039
    },
    {
      "id": "shot12-12",
      "text": "专门处理特征互相打架、",
      "start": 25.039,
      "end": 27.072
    },
    {
      "id": "shot12-13",
      "text": "权重不稳定的问题，",
      "start": 27.072,
      "end": 28.583
    },
    {
      "id": "shot12-14",
      "text": "后面正则化那一期再讲。",
      "start": 28.583,
      "end": 30.073
    },
    {
      "id": "shot12-15",
      "text": "本期只记住一句话：",
      "start": 30.581,
      "end": 32.073
    },
    {
      "id": "shot12-16",
      "text": "LR 快、稳、可解释，",
      "start": 32.073,
      "end": 34.391
    },
    {
      "id": "shot12-17",
      "text": "所以常拿来做回归任务的第一版模型。",
      "start": 34.391,
      "end": 37.052
    }
  ],
  "shot13": [
    {
      "id": "shot13-0",
      "text": "二元 demo 这张图和前面一元图不一样，",
      "start": 0.0,
      "end": 2.985
    },
    {
      "id": "shot13-1",
      "text": "关键弯在这里：",
      "start": 2.985,
      "end": 4.086
    },
    {
      "id": "shot13-2",
      "text": "一张平面图只有横轴和纵轴，",
      "start": 4.086,
      "end": 6.67
    },
    {
      "id": "shot13-3",
      "text": "最多直接摆两个量。",
      "start": 6.67,
      "end": 8.153
    },
    {
      "id": "shot13-4",
      "text": "前面一元图把横轴给身高、",
      "start": 8.153,
      "end": 10.536
    },
    {
      "id": "shot13-5",
      "text": "纵轴给体重；",
      "start": 10.536,
      "end": 12.039
    },
    {
      "id": "shot13-6",
      "text": "现在升级成二元以后，",
      "start": 12.039,
      "end": 13.701
    },
    {
      "id": "shot13-7",
      "text": "横轴和纵轴都要让给输入特征：",
      "start": 13.701,
      "end": 16.285
    },
    {
      "id": "shot13-8",
      "text": "横轴还是身高减 160，",
      "start": 16.285,
      "end": 18.469
    },
    {
      "id": "shot13-9",
      "text": "纵轴是临时第二特征。",
      "start": 18.469,
      "end": 20.171
    },
    {
      "id": "shot13-10",
      "text": "那第三个量，",
      "start": 20.171,
      "end": 21.053
    },
    {
      "id": "shot13-11",
      "text": "也就是模型预测的体重放哪？",
      "start": 21.053,
      "end": 23.236
    },
    {
      "id": "shot13-12",
      "text": "放到背景颜色里。颜色越浅，",
      "start": 23.236,
      "end": 25.379
    },
    {
      "id": "shot13-13",
      "text": "表示模型预测体重越重。",
      "start": 25.379,
      "end": 26.882
    },
    {
      "id": "shot13-14",
      "text": "每个圆点的位置由两个输入特征决定，",
      "start": 27.406,
      "end": 30.371
    },
    {
      "id": "shot13-15",
      "text": "圆点自己的颜色是真实体重；",
      "start": 30.371,
      "end": 32.676
    },
    {
      "id": "shot13-16",
      "text": "如果圆点颜色和周围背景颜色接近，",
      "start": 32.676,
      "end": 35.701
    },
    {
      "id": "shot13-17",
      "text": "说明模型在这个样本附近预测得准。",
      "start": 35.701,
      "end": 38.927
    },
    {
      "id": "shot13-18",
      "text": "所以这张图是在用“横轴 + 纵轴 + 颜色”",
      "start": 38.927,
      "end": 42.153
    },
    {
      "id": "shot13-19",
      "text": "表达三个量：",
      "start": 42.153,
      "end": 43.716
    },
    {
      "id": "shot13-20",
      "text": "两个输入特征，",
      "start": 43.716,
      "end": 44.938
    },
    {
      "id": "shot13-21",
      "text": "加一个输出体重。",
      "start": 44.938,
      "end": 46.1
    }
  ]
}
