{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们看到，",
      "start": 0.0,
      "end": 1.182
    },
    {
      "id": "shot01-1",
      "text": "precision、",
      "start": 1.182,
      "end": 1.882
    },
    {
      "id": "shot01-2",
      "text": "recall 和 F1 都会随着阈值改变。",
      "start": 1.882,
      "end": 4.546
    },
    {
      "id": "shot01-3",
      "text": "那问题来了：",
      "start": 4.546,
      "end": 5.487
    },
    {
      "id": "shot01-4",
      "text": "如果只选 τ 等于 0.5，",
      "start": 5.487,
      "end": 7.669
    },
    {
      "id": "shot01-5",
      "text": "我们看到的只是模型在一个切点上的表现。",
      "start": 7.669,
      "end": 10.944
    },
    {
      "id": "shot01-6",
      "text": "阈值换一下，",
      "start": 10.944,
      "end": 11.975
    },
    {
      "id": "shot01-7",
      "text": "结论可能就变了。",
      "start": 11.975,
      "end": 13.617
    },
    {
      "id": "shot01-8",
      "text": "ROC 的想法很直接：",
      "start": 13.617,
      "end": 15.739
    },
    {
      "id": "shot01-9",
      "text": "别只看一个阈值，",
      "start": 15.739,
      "end": 17.201
    },
    {
      "id": "shot01-10",
      "text": "把阈值从高到低全部扫一遍。",
      "start": 17.201,
      "end": 20.004
    },
    {
      "id": "shot01-11",
      "text": "每个阈值都算一个点，",
      "start": 20.004,
      "end": 21.767
    },
    {
      "id": "shot01-12",
      "text": "所有点连起来，",
      "start": 21.767,
      "end": 23.108
    },
    {
      "id": "shot01-13",
      "text": "就是 ROC 曲线。",
      "start": 23.108,
      "end": 24.67
    },
    {
      "id": "shot01-14",
      "text": "AUC 再把这条曲线压成一个整体分数。",
      "start": 24.67,
      "end": 27.554
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "ROC 曲线的坐标轴不是",
      "start": 0.0,
      "end": 1.922
    },
    {
      "id": "shot02-1",
      "text": "precision 和 recall，",
      "start": 1.922,
      "end": 3.264
    },
    {
      "id": "shot02-2",
      "text": "而是 TPR 和 FPR。",
      "start": 3.264,
      "end": 5.827
    },
    {
      "id": "shot02-3",
      "text": "TPR 是真正例率，",
      "start": 5.827,
      "end": 7.488
    },
    {
      "id": "shot02-4",
      "text": "公式是 TP 除以 TP 加 FN。",
      "start": 7.488,
      "end": 10.452
    },
    {
      "id": "shot02-5",
      "text": "它其实就是上一期的 recall，",
      "start": 10.452,
      "end": 12.754
    },
    {
      "id": "shot02-6",
      "text": "表示真实正例里抓回来多少。",
      "start": 12.754,
      "end": 15.938
    },
    {
      "id": "shot02-7",
      "text": "FPR 是假正例率，",
      "start": 15.938,
      "end": 17.76
    },
    {
      "id": "shot02-8",
      "text": "公式是 FP 除以 FP 加 TN，",
      "start": 17.76,
      "end": 20.983
    },
    {
      "id": "shot02-9",
      "text": "表示真实负例里有多少被误报成正例。",
      "start": 20.983,
      "end": 24.047
    },
    {
      "id": "shot02-10",
      "text": "画 ROC 时，",
      "start": 24.581,
      "end": 25.944
    },
    {
      "id": "shot02-11",
      "text": "横轴是 FPR，",
      "start": 25.944,
      "end": 27.568
    },
    {
      "id": "shot02-12",
      "text": "越小越好；",
      "start": 27.568,
      "end": 28.71
    },
    {
      "id": "shot02-13",
      "text": "纵轴是 TPR，越大越好。",
      "start": 28.71,
      "end": 30.855
    },
    {
      "id": "shot02-14",
      "text": "所以理想模型会贴近左上角：",
      "start": 30.855,
      "end": 33.22
    },
    {
      "id": "shot02-15",
      "text": "横轴接近 0，",
      "start": 33.22,
      "end": 34.483
    },
    {
      "id": "shot02-16",
      "text": "说明几乎不误报负例；",
      "start": 34.483,
      "end": 36.207
    },
    {
      "id": "shot02-17",
      "text": "纵轴接近 1，",
      "start": 36.207,
      "end": 37.37
    },
    {
      "id": "shot02-18",
      "text": "说明几乎抓全正例。",
      "start": 37.37,
      "end": 39.495
    },
    {
      "id": "shot02-19",
      "text": "随机模型通常在对角线附近，",
      "start": 39.495,
      "end": 41.84
    },
    {
      "id": "shot02-20",
      "text": "因为它提高 TPR 的同时，",
      "start": 41.84,
      "end": 43.925
    },
    {
      "id": "shot02-21",
      "text": "也差不多同比例提高 FPR。",
      "start": 43.925,
      "end": 45.869
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "ROC 可以用一个排序动作理解。",
      "start": 0.0,
      "end": 2.741
    },
    {
      "id": "shot03-1",
      "text": "先让模型给每个样本一个正类概率，",
      "start": 2.741,
      "end": 5.663
    },
    {
      "id": "shot03-2",
      "text": "然后从高到低排序。",
      "start": 5.663,
      "end": 7.624
    },
    {
      "id": "shot03-3",
      "text": "阈值一开始比所有概率都高，",
      "start": 7.624,
      "end": 9.885
    },
    {
      "id": "shot03-4",
      "text": "没有样本被判正，",
      "start": 9.885,
      "end": 11.466
    },
    {
      "id": "shot03-5",
      "text": "所以点在左下角。",
      "start": 11.466,
      "end": 12.967
    },
    {
      "id": "shot03-6",
      "text": "接着把阈值一点点放低，",
      "start": 12.967,
      "end": 14.948
    },
    {
      "id": "shot03-7",
      "text": "样本会按分数顺序进入预测正类。",
      "start": 14.948,
      "end": 18.41
    },
    {
      "id": "shot03-8",
      "text": "如果下一个进入的是正例，",
      "start": 18.41,
      "end": 20.571
    },
    {
      "id": "shot03-9",
      "text": "TP 增加，",
      "start": 20.571,
      "end": 21.512
    },
    {
      "id": "shot03-10",
      "text": "TPR 往上走；",
      "start": 21.512,
      "end": 22.972
    },
    {
      "id": "shot03-11",
      "text": "如果下一个进入的是负例，",
      "start": 22.972,
      "end": 25.254
    },
    {
      "id": "shot03-12",
      "text": "FP 增加，",
      "start": 25.254,
      "end": 26.414
    },
    {
      "id": "shot03-13",
      "text": "FPR 往右走。",
      "start": 26.414,
      "end": 27.715
    },
    {
      "id": "shot03-14",
      "text": "于是 ROC 曲线可以想成一条阶梯路：",
      "start": 27.715,
      "end": 30.871
    },
    {
      "id": "shot03-15",
      "text": "遇到正例就向上，",
      "start": 30.871,
      "end": 32.458
    },
    {
      "id": "shot03-16",
      "text": "遇到负例就向右。",
      "start": 32.458,
      "end": 33.724
    },
    {
      "id": "shot03-17",
      "text": "好模型会把正例排在前面，",
      "start": 34.093,
      "end": 36.24
    },
    {
      "id": "shot03-18",
      "text": "所以前半段更多向上，",
      "start": 36.24,
      "end": 38.206
    },
    {
      "id": "shot03-19",
      "text": "曲线靠近左上角；",
      "start": 38.206,
      "end": 39.792
    },
    {
      "id": "shot03-20",
      "text": "差模型把负例排在前面，",
      "start": 39.792,
      "end": 41.778
    },
    {
      "id": "shot03-21",
      "text": "就会先往右走，",
      "start": 41.778,
      "end": 42.982
    },
    {
      "id": "shot03-22",
      "text": "曲线贴近甚至低于对角线。",
      "start": 42.982,
      "end": 44.808
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开 ROC/AUC demo。",
      "start": 0.0,
      "end": 2.383
    },
    {
      "id": "shot04-1",
      "text": "先切镜头 A，",
      "start": 2.383,
      "end": 3.665
    },
    {
      "id": "shot04-2",
      "text": "完美模型的正负分布几乎完全分开，",
      "start": 3.665,
      "end": 6.628
    },
    {
      "id": "shot04-3",
      "text": "ROC 贴着左边和上边走，",
      "start": 6.628,
      "end": 8.791
    },
    {
      "id": "shot04-4",
      "text": "AUC 等于 1。",
      "start": 8.791,
      "end": 10.153
    },
    {
      "id": "shot04-5",
      "text": "镜头 B 是强模型，",
      "start": 10.153,
      "end": 11.775
    },
    {
      "id": "shot04-6",
      "text": "正负分布有少量重叠，",
      "start": 11.775,
      "end": 13.757
    },
    {
      "id": "shot04-7",
      "text": "当前实跑 AUC 约 0.992，",
      "start": 13.757,
      "end": 16.701
    },
    {
      "id": "shot04-8",
      "text": "曲线依然很靠左上。",
      "start": 16.701,
      "end": 18.783
    },
    {
      "id": "shot04-9",
      "text": "镜头 C 是弱模型，",
      "start": 18.783,
      "end": 20.385
    },
    {
      "id": "shot04-10",
      "text": "AUC 约 0.714，",
      "start": 20.385,
      "end": 22.548
    },
    {
      "id": "shot04-11",
      "text": "曲线只比对角线好一截。",
      "start": 22.548,
      "end": 24.591
    },
    {
      "id": "shot04-12",
      "text": "镜头 D 是随机模型，",
      "start": 24.591,
      "end": 26.333
    },
    {
      "id": "shot04-13",
      "text": "AUC 约 0.505，",
      "start": 26.333,
      "end": 28.275
    },
    {
      "id": "shot04-14",
      "text": "基本等于随机猜。",
      "start": 28.275,
      "end": 29.337
    },
    {
      "id": "shot04-15",
      "text": "镜头 E 是反转模型，",
      "start": 29.92,
      "end": 32.024
    },
    {
      "id": "shot04-16",
      "text": "AUC 约 0.011，",
      "start": 32.024,
      "end": 34.208
    },
    {
      "id": "shot04-17",
      "text": "曲线落在对角线下方。",
      "start": 34.208,
      "end": 36.212
    },
    {
      "id": "shot04-18",
      "text": "这不一定代表模型完全没信息，",
      "start": 36.212,
      "end": 38.776
    },
    {
      "id": "shot04-19",
      "text": "也可能是正负类方向装反了。",
      "start": 38.776,
      "end": 41.221
    },
    {
      "id": "shot04-20",
      "text": "再拖阈值 τ，",
      "start": 41.221,
      "end": 42.443
    },
    {
      "id": "shot04-21",
      "text": "你会看到当前点沿 ROC 移动：",
      "start": 42.443,
      "end": 45.338
    },
    {
      "id": "shot04-22",
      "text": "阈值降低，",
      "start": 45.338,
      "end": 46.25
    },
    {
      "id": "shot04-23",
      "text": "更多样本被判正，",
      "start": 46.25,
      "end": 47.993
    },
    {
      "id": "shot04-24",
      "text": "TPR 和 FPR 通常一起上升；",
      "start": 47.993,
      "end": 51.479
    },
    {
      "id": "shot04-25",
      "text": "阈值升高，",
      "start": 51.479,
      "end": 52.341
    },
    {
      "id": "shot04-26",
      "text": "两者通常一起下降。",
      "start": 52.341,
      "end": 53.824
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "AUC 的第一层含义，",
      "start": 0.0,
      "end": 1.643
    },
    {
      "id": "shot05-1",
      "text": "是 ROC 曲线下面积。面积越大，",
      "start": 1.643,
      "end": 4.889
    },
    {
      "id": "shot05-2",
      "text": "曲线越靠近左上角，",
      "start": 4.889,
      "end": 6.733
    },
    {
      "id": "shot05-3",
      "text": "模型越能在低误报的同时抓住正例。",
      "start": 6.733,
      "end": 9.859
    },
    {
      "id": "shot05-4",
      "text": "AUC 等于 1 是完美排序，",
      "start": 9.859,
      "end": 12.403
    },
    {
      "id": "shot05-5",
      "text": "AUC 约 0.5 接近随机。",
      "start": 12.403,
      "end": 14.968
    },
    {
      "id": "shot05-6",
      "text": "AUC 的第二层含义更重要：",
      "start": 14.968,
      "end": 17.453
    },
    {
      "id": "shot05-7",
      "text": "任取一个正例和一个负例，",
      "start": 17.453,
      "end": 19.357
    },
    {
      "id": "shot05-8",
      "text": "模型给正例打分更高的概率。",
      "start": 19.357,
      "end": 21.541
    },
    {
      "id": "shot05-9",
      "text": "比如 AUC 等于 0.86，",
      "start": 21.914,
      "end": 24.337
    },
    {
      "id": "shot05-10",
      "text": "可以理解成随机抽一对正负样本，",
      "start": 24.337,
      "end": 26.94
    },
    {
      "id": "shot05-11",
      "text": "大约百分之八十六的情况下，",
      "start": 26.94,
      "end": 29.043
    },
    {
      "id": "shot05-12",
      "text": "正例分数高于负例；",
      "start": 29.043,
      "end": 30.805
    },
    {
      "id": "shot05-13",
      "text": "如果两个分数打平，",
      "start": 30.805,
      "end": 32.387
    },
    {
      "id": "shot05-14",
      "text": "通常按半次胜利来计。",
      "start": 32.387,
      "end": 34.35
    },
    {
      "id": "shot05-15",
      "text": "这个解释说明 AUC 衡量的是排序能力，",
      "start": 34.35,
      "end": 37.534
    },
    {
      "id": "shot05-16",
      "text": "而不是某个固定阈值下的分类能力。",
      "start": 37.534,
      "end": 40.618
    },
    {
      "id": "shot05-17",
      "text": "所以 AUC 不会告诉你最终阈值该选多少，",
      "start": 40.618,
      "end": 43.742
    },
    {
      "id": "shot05-18",
      "text": "但会告诉你模型有没有把正例排到负例前面。",
      "start": 43.742,
      "end": 47.206
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "在 sklearn 里，",
      "start": 0.0,
      "end": 1.323
    },
    {
      "id": "shot06-1",
      "text": "固定阈值指标可以先用",
      "start": 1.323,
      "end": 2.946
    },
    {
      "id": "shot06-2",
      "text": "classification_report",
      "start": 2.946,
      "end": 4.349
    },
    {
      "id": "shot06-3",
      "text": "快速看。",
      "start": 4.349,
      "end": 5.11
    },
    {
      "id": "shot06-4",
      "text": "它会按类别输出 precision、",
      "start": 5.11,
      "end": 6.974
    },
    {
      "id": "shot06-5",
      "text": "recall、",
      "start": 6.974,
      "end": 7.755
    },
    {
      "id": "shot06-6",
      "text": "F1 和 support，",
      "start": 7.755,
      "end": 8.817
    },
    {
      "id": "shot06-7",
      "text": "还会给 macro average 和",
      "start": 8.817,
      "end": 10.661
    },
    {
      "id": "shot06-8",
      "text": "weighted average。",
      "start": 10.661,
      "end": 11.843
    },
    {
      "id": "shot06-9",
      "text": "二分类入门阶段，",
      "start": 11.843,
      "end": 13.206
    },
    {
      "id": "shot06-10",
      "text": "先重点看正类那一行。",
      "start": 13.206,
      "end": 15.009
    },
    {
      "id": "shot06-11",
      "text": "ROC 相关有两个常用函数。",
      "start": 15.009,
      "end": 17.154
    },
    {
      "id": "shot06-12",
      "text": "roc_curve 接收真实标签和正类得",
      "start": 17.522,
      "end": 20.205
    },
    {
      "id": "shot06-13",
      "text": "分，",
      "start": 20.205,
      "end": 20.626
    },
    {
      "id": "shot06-14",
      "text": "返回一组 FPR、",
      "start": 20.626,
      "end": 22.408
    },
    {
      "id": "shot06-15",
      "text": "TPR 和 thresholds，",
      "start": 22.408,
      "end": 24.31
    },
    {
      "id": "shot06-16",
      "text": "用来画曲线。",
      "start": 24.31,
      "end": 25.472
    },
    {
      "id": "shot06-17",
      "text": "roc_auc_score 接收真实标签",
      "start": 25.472,
      "end": 28.075
    },
    {
      "id": "shot06-18",
      "text": "和正类得分，",
      "start": 28.075,
      "end": 29.116
    },
    {
      "id": "shot06-19",
      "text": "直接返回 AUC。",
      "start": 29.116,
      "end": 31.159
    },
    {
      "id": "shot06-20",
      "text": "常见写法是先训练",
      "start": 31.159,
      "end": 32.861
    },
    {
      "id": "shot06-21",
      "text": "LogisticRegression，",
      "start": 32.861,
      "end": 34.243
    },
    {
      "id": "shot06-22",
      "text": "再取 predict_proba 的第二",
      "start": 34.243,
      "end": 36.205
    },
    {
      "id": "shot06-23",
      "text": "列作为正类概率，",
      "start": 36.205,
      "end": 37.707
    },
    {
      "id": "shot06-24",
      "text": "然后把这个概率传给 roc_curve",
      "start": 37.707,
      "end": 40.591
    },
    {
      "id": "shot06-25",
      "text": "和 roc_auc_score。",
      "start": 40.591,
      "end": 41.512
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这里有一个非常常见的坑：",
      "start": 0.0,
      "end": 2.161
    },
    {
      "id": "shot07-1",
      "text": "算 AUC 时，",
      "start": 2.161,
      "end": 3.602
    },
    {
      "id": "shot07-2",
      "text": "不要把 predict 得到的 0/1",
      "start": 3.602,
      "end": 5.863
    },
    {
      "id": "shot07-3",
      "text": "标签传进去，",
      "start": 5.863,
      "end": 7.204
    },
    {
      "id": "shot07-4",
      "text": "而要传概率或连续得分。",
      "start": 7.204,
      "end": 9.565
    },
    {
      "id": "shot07-5",
      "text": "原因是 ROC 要扫所有阈值。",
      "start": 9.565,
      "end": 12.467
    },
    {
      "id": "shot07-6",
      "text": "如果你只传 0 和 1，",
      "start": 12.467,
      "end": 14.308
    },
    {
      "id": "shot07-7",
      "text": "模型分数已经被硬切成两个值，",
      "start": 14.308,
      "end": 17.229
    },
    {
      "id": "shot07-8",
      "text": "曲线只剩很少几个点，",
      "start": 17.229,
      "end": 19.17
    },
    {
      "id": "shot07-9",
      "text": "排序信息丢掉了。",
      "start": 19.17,
      "end": 21.032
    },
    {
      "id": "shot07-10",
      "text": "正确做法是传 predict_proba",
      "start": 21.032,
      "end": 23.443
    },
    {
      "id": "shot07-11",
      "text": "里正类那一列，",
      "start": 23.443,
      "end": 24.83
    },
    {
      "id": "shot07-12",
      "text": "或者传",
      "start": 24.83,
      "end": 25.312
    },
    {
      "id": "shot07-13",
      "text": "decision_function 这样",
      "start": 25.312,
      "end": 26.819
    },
    {
      "id": "shot07-14",
      "text": "的连续分数。",
      "start": 26.819,
      "end": 28.165
    },
    {
      "id": "shot07-15",
      "text": "还有一个坑是正类方向。",
      "start": 28.165,
      "end": 29.793
    },
    {
      "id": "shot07-16",
      "text": "对 LogisticRegression",
      "start": 30.262,
      "end": 31.746
    },
    {
      "id": "shot07-17",
      "text": "来说，",
      "start": 31.746,
      "end": 32.308
    },
    {
      "id": "shot07-18",
      "text": "predict_proba 的列顺序由",
      "start": 32.308,
      "end": 34.173
    },
    {
      "id": "shot07-19",
      "text": "classes_ 决定。",
      "start": 34.173,
      "end": 36.019
    },
    {
      "id": "shot07-20",
      "text": "你要确认取到的是正类概率，",
      "start": 36.019,
      "end": 38.065
    },
    {
      "id": "shot07-21",
      "text": "而不是负类概率。取反了，",
      "start": 38.065,
      "end": 40.131
    },
    {
      "id": "shot07-22",
      "text": "AUC 就可能低于 0.5。",
      "start": 40.131,
      "end": 42.016
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.982
    },
    {
      "id": "shot08-1",
      "text": "我们把固定阈值扩展成了整条 ROC 曲线：",
      "start": 0.982,
      "end": 4.669
    },
    {
      "id": "shot08-2",
      "text": "横轴 FPR 看负例误报比例，",
      "start": 4.669,
      "end": 7.675
    },
    {
      "id": "shot08-3",
      "text": "纵轴 TPR 看正例抓回比例。",
      "start": 7.675,
      "end": 10.36
    },
    {
      "id": "shot08-4",
      "text": "AUC 则把整条曲线压成一个排序能力分数，",
      "start": 10.36,
      "end": 14.047
    },
    {
      "id": "shot08-5",
      "text": "它不依赖单一阈值，",
      "start": 14.047,
      "end": 15.47
    },
    {
      "id": "shot08-6",
      "text": "但也不负责替你选最终阈值。到这里，",
      "start": 15.47,
      "end": 18.495
    },
    {
      "id": "shot08-7",
      "text": "逻辑回归的建模、损失、",
      "start": 18.495,
      "end": 20.339
    },
    {
      "id": "shot08-8",
      "text": "API 和评估指标都齐了。",
      "start": 20.339,
      "end": 22.463
    },
    {
      "id": "shot08-9",
      "text": "下一期我们进入章末实战，",
      "start": 22.463,
      "end": 24.347
    },
    {
      "id": "shot08-10",
      "text": "用电信客户流失预测，",
      "start": 24.347,
      "end": 26.17
    },
    {
      "id": "shot08-11",
      "text": "把这些工具串成一个完整业务",
      "start": 26.17,
      "end": 28.094
    },
    {
      "id": "shot08-12",
      "text": "pipeline。",
      "start": 28.094,
      "end": 28.454
    }
  ],
  "shot09": [
    {
      "id": "shot09-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.652
    },
    {
      "id": "shot09-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.652,
      "end": 1.956
    }
  ]
}
