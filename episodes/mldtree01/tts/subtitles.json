{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "中午饿了打开外卖软件，",
      "start": 0.0,
      "end": 1.902
    },
    {
      "id": "shot01-1",
      "text": "附近 30 家店混在一起。",
      "start": 1.902,
      "end": 3.783
    },
    {
      "id": "shot01-2",
      "text": "你大概率不是闭眼点一家，",
      "start": 3.783,
      "end": 5.785
    },
    {
      "id": "shot01-3",
      "text": "而是先问几个问题：",
      "start": 5.785,
      "end": 7.267
    },
    {
      "id": "shot01-4",
      "text": "评分到 4.5 了吗？",
      "start": 7.267,
      "end": 8.848
    },
    {
      "id": "shot01-5",
      "text": "距离在 3 公里以内吗？",
      "start": 8.848,
      "end": 10.589
    },
    {
      "id": "shot01-6",
      "text": "人均价格超过 60 吗？",
      "start": 10.589,
      "end": 12.491
    },
    {
      "id": "shot01-7",
      "text": "每问一个问题，",
      "start": 12.491,
      "end": 13.572
    },
    {
      "id": "shot01-8",
      "text": "就砍掉一批不合适的店。问到最后，",
      "start": 13.572,
      "end": 16.615
    },
    {
      "id": "shot01-9",
      "text": "剩下的选择就清楚多了。决策树，",
      "start": 16.615,
      "end": 19.257
    },
    {
      "id": "shot01-10",
      "text": "英文 decision tree，",
      "start": 19.257,
      "end": 20.598
    },
    {
      "id": "shot01-11",
      "text": "做的就是这件事：",
      "start": 20.598,
      "end": 21.8
    },
    {
      "id": "shot01-12",
      "text": "把一堆混在一起的样本，",
      "start": 21.8,
      "end": 23.681
    },
    {
      "id": "shot01-13",
      "text": "放进一连串判断题里，",
      "start": 23.681,
      "end": 25.503
    },
    {
      "id": "shot01-14",
      "text": "一路分下去，",
      "start": 25.503,
      "end": 26.444
    },
    {
      "id": "shot01-15",
      "text": "最后落到某个结果。",
      "start": 26.444,
      "end": 27.685
    },
    {
      "id": "shot01-16",
      "text": "它不像 KNN 那样找最近邻，",
      "start": 28.166,
      "end": 30.632
    },
    {
      "id": "shot01-17",
      "text": "也不像逻辑回归那样算一个线性分数。",
      "start": 30.632,
      "end": 33.439
    },
    {
      "id": "shot01-18",
      "text": "它更像一套从数据里学出来的",
      "start": 33.439,
      "end": 35.625
    },
    {
      "id": "shot01-19",
      "text": "if-else 规则。",
      "start": 35.625,
      "end": 37.108
    },
    {
      "id": "shot01-20",
      "text": "这一期我们先不进公式，",
      "start": 37.108,
      "end": 38.933
    },
    {
      "id": "shot01-21",
      "text": "只解决三个直觉问题：",
      "start": 38.933,
      "end": 40.817
    },
    {
      "id": "shot01-22",
      "text": "树长什么样，",
      "start": 40.817,
      "end": 41.78
    },
    {
      "id": "shot01-23",
      "text": "一刀怎么切，",
      "start": 41.78,
      "end": 42.782
    },
    {
      "id": "shot01-24",
      "text": "多维空间里这一刀又长什么样。",
      "start": 42.782,
      "end": 45.088
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先把树拆开看。",
      "start": 0.0,
      "end": 1.422
    },
    {
      "id": "shot02-1",
      "text": "每个判断题，",
      "start": 1.422,
      "end": 2.404
    },
    {
      "id": "shot02-2",
      "text": "比如“评分是不是大于等于 4.5”，",
      "start": 2.404,
      "end": 4.988
    },
    {
      "id": "shot02-3",
      "text": "叫内部节点，",
      "start": 4.988,
      "end": 6.15
    },
    {
      "id": "shot02-4",
      "text": "英文 internal node。",
      "start": 6.15,
      "end": 7.592
    },
    {
      "id": "shot02-5",
      "text": "判断题的两个出口，",
      "start": 7.592,
      "end": 9.054
    },
    {
      "id": "shot02-6",
      "text": "比如“是”和“否”，叫分支，",
      "start": 9.054,
      "end": 11.278
    },
    {
      "id": "shot02-7",
      "text": "英文 branch。",
      "start": 11.278,
      "end": 12.7
    },
    {
      "id": "shot02-8",
      "text": "一路走到最后，",
      "start": 12.7,
      "end": 13.962
    },
    {
      "id": "shot02-9",
      "text": "给出“点”或者“不点”的位置，",
      "start": 13.962,
      "end": 16.105
    },
    {
      "id": "shot02-10",
      "text": "叫叶子节点，",
      "start": 16.105,
      "end": 17.267
    },
    {
      "id": "shot02-11",
      "text": "英文 leaf node。",
      "start": 17.267,
      "end": 18.709
    },
    {
      "id": "shot02-12",
      "text": "最顶上的那个判断题还有一个特殊名字：",
      "start": 18.709,
      "end": 21.794
    },
    {
      "id": "shot02-13",
      "text": "根节点，",
      "start": 21.794,
      "end": 22.615
    },
    {
      "id": "shot02-14",
      "text": "英文 root node，",
      "start": 22.615,
      "end": 23.937
    },
    {
      "id": "shot02-15",
      "text": "因为所有样本都从这里开始往下走。",
      "start": 23.937,
      "end": 26.622
    },
    {
      "id": "shot02-16",
      "text": "这里还有两个基础词也要对齐：",
      "start": 27.091,
      "end": 29.234
    },
    {
      "id": "shot02-17",
      "text": "每一家店是一条样本，",
      "start": 29.234,
      "end": 31.077
    },
    {
      "id": "shot02-18",
      "text": "英文 sample；评分、距离、",
      "start": 31.077,
      "end": 33.18
    },
    {
      "id": "shot02-19",
      "text": "价格这些描述样本的信息，叫特征，",
      "start": 33.18,
      "end": 36.104
    },
    {
      "id": "shot02-20",
      "text": "英文 feature。",
      "start": 36.104,
      "end": 37.286
    },
    {
      "id": "shot02-21",
      "text": "决策树训练完成以后，",
      "start": 37.286,
      "end": 39.088
    },
    {
      "id": "shot02-22",
      "text": "本质上就是一棵由特征判断组成的规则树。",
      "start": 39.088,
      "end": 42.693
    },
    {
      "id": "shot02-23",
      "text": "新样本进来，",
      "start": 42.693,
      "end": 43.755
    },
    {
      "id": "shot02-24",
      "text": "只要从根节点出发，",
      "start": 43.755,
      "end": 45.377
    },
    {
      "id": "shot02-25",
      "text": "按每个判断题的答案往下走，",
      "start": 45.377,
      "end": 47.7
    },
    {
      "id": "shot02-26",
      "text": "最后落到哪片叶子，",
      "start": 47.7,
      "end": 49.143
    },
    {
      "id": "shot02-27",
      "text": "就输出哪片叶子的标签。",
      "start": 49.143,
      "end": 50.725
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "现在打开第一个互动演示，",
      "start": 0.0,
      "end": 1.801
    },
    {
      "id": "shot03-1",
      "text": "看决策树的一刀到底怎么切。",
      "start": 1.801,
      "end": 3.983
    },
    {
      "id": "shot03-2",
      "text": "画面左侧是控制区，",
      "start": 3.983,
      "end": 5.544
    },
    {
      "id": "shot03-3",
      "text": "右侧主图是一张二维散点图：",
      "start": 5.544,
      "end": 7.926
    },
    {
      "id": "shot03-4",
      "text": "横轴是评分，",
      "start": 7.926,
      "end": 9.047
    },
    {
      "id": "shot03-5",
      "text": "纵轴是距离；",
      "start": 9.047,
      "end": 10.007
    },
    {
      "id": "shot03-6",
      "text": "每个点是一家店，",
      "start": 10.007,
      "end": 11.308
    },
    {
      "id": "shot03-7",
      "text": "绿色表示点，",
      "start": 11.308,
      "end": 12.349
    },
    {
      "id": "shot03-8",
      "text": "红色表示不点。",
      "start": 12.349,
      "end": 13.45
    },
    {
      "id": "shot03-9",
      "text": "图里的竖线或者横线，",
      "start": 13.45,
      "end": 15.271
    },
    {
      "id": "shot03-10",
      "text": "就是当前这一刀。",
      "start": 15.271,
      "end": 16.832
    },
    {
      "id": "shot03-11",
      "text": "右边的小柱状图显示切完以后，",
      "start": 16.832,
      "end": 19.334
    },
    {
      "id": "shot03-12",
      "text": "左右两个子集各自有多少点和不点。",
      "start": 19.334,
      "end": 22.096
    },
    {
      "id": "shot03-13",
      "text": "底部数字面板给出一个纯度提升分数。",
      "start": 22.096,
      "end": 25.192
    },
    {
      "id": "shot03-14",
      "text": "这里先把它理解成：",
      "start": 25.192,
      "end": 26.458
    },
    {
      "id": "shot03-15",
      "text": "这一刀让样本变干净了多少。先看 A，",
      "start": 26.458,
      "end": 29.574
    },
    {
      "id": "shot03-16",
      "text": "切评分 4.5。",
      "start": 29.574,
      "end": 30.619
    },
    {
      "id": "shot03-17",
      "text": "左边 48 家里，点 12、",
      "start": 30.985,
      "end": 33.428
    },
    {
      "id": "shot03-18",
      "text": "不点 36；",
      "start": 33.428,
      "end": 34.49
    },
    {
      "id": "shot03-19",
      "text": "右边 12 家全是点。",
      "start": 34.49,
      "end": 36.212
    },
    {
      "id": "shot03-20",
      "text": "纯度提升分数是 0.180，",
      "start": 36.212,
      "end": 38.696
    },
    {
      "id": "shot03-21",
      "text": "所以标题写着切得干净。再切 B，",
      "start": 38.696,
      "end": 41.68
    },
    {
      "id": "shot03-22",
      "text": "距离 3.5，",
      "start": 41.68,
      "end": 42.781
    },
    {
      "id": "shot03-23",
      "text": "纯度提升分数只有 0.065，",
      "start": 42.781,
      "end": 45.245
    },
    {
      "id": "shot03-24",
      "text": "说明也有用，",
      "start": 45.245,
      "end": 46.386
    },
    {
      "id": "shot03-25",
      "text": "但不如评分。",
      "start": 46.386,
      "end": 47.968
    },
    {
      "id": "shot03-26",
      "text": "最后切 C，头像色，",
      "start": 47.968,
      "end": 49.971
    },
    {
      "id": "shot03-27",
      "text": "左右各 30 家，",
      "start": 49.971,
      "end": 51.513
    },
    {
      "id": "shot03-28",
      "text": "但比例几乎没变，",
      "start": 51.513,
      "end": 53.116
    },
    {
      "id": "shot03-29",
      "text": "纯度提升分数只有 0.009。",
      "start": 53.116,
      "end": 55.639
    },
    {
      "id": "shot03-30",
      "text": "这就是白切：问题问了，",
      "start": 55.639,
      "end": 57.602
    },
    {
      "id": "shot03-31",
      "text": "但样本没有更纯。",
      "start": 57.602,
      "end": 58.883
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "二维图里，",
      "start": 0.0,
      "end": 0.701
    },
    {
      "id": "shot04-1",
      "text": "一刀看起来是一条线。",
      "start": 0.701,
      "end": 2.343
    },
    {
      "id": "shot04-2",
      "text": "但真实任务往往不止两个特征。",
      "start": 2.343,
      "end": 5.107
    },
    {
      "id": "shot04-3",
      "text": "切到第二个互动演示：",
      "start": 5.107,
      "end": 6.91
    },
    {
      "id": "shot04-4",
      "text": "横轴是评分，",
      "start": 6.91,
      "end": 8.112
    },
    {
      "id": "shot04-5",
      "text": "纵轴是距离，",
      "start": 8.112,
      "end": 9.153
    },
    {
      "id": "shot04-6",
      "text": "第三个轴是价格。",
      "start": 9.153,
      "end": 10.555
    },
    {
      "id": "shot04-7",
      "text": "每个点仍然是一家店，绿色是点，",
      "start": 10.555,
      "end": 13.339
    },
    {
      "id": "shot04-8",
      "text": "红色是不点。",
      "start": 13.339,
      "end": 14.821
    },
    {
      "id": "shot04-9",
      "text": "现在“评分小于等于 4.5”不再是一条线，",
      "start": 14.821,
      "end": 18.287
    },
    {
      "id": "shot04-10",
      "text": "而是一张垂直的平面，",
      "start": 18.287,
      "end": 20.049
    },
    {
      "id": "shot04-11",
      "text": "把三维空间切成两半。",
      "start": 20.049,
      "end": 21.752
    },
    {
      "id": "shot04-12",
      "text": "A 镜头切评分，",
      "start": 22.282,
      "end": 23.684
    },
    {
      "id": "shot04-13",
      "text": "纯度提升分数是 0.125；",
      "start": 23.684,
      "end": 26.466
    },
    {
      "id": "shot04-14",
      "text": "B 镜头切距离，",
      "start": 26.466,
      "end": 27.868
    },
    {
      "id": "shot04-15",
      "text": "纯度提升分数是 0.106；",
      "start": 27.868,
      "end": 30.631
    },
    {
      "id": "shot04-16",
      "text": "C 镜头切价格，",
      "start": 30.631,
      "end": 32.132
    },
    {
      "id": "shot04-17",
      "text": "纯度提升分数只有 0.019，",
      "start": 32.132,
      "end": 34.975
    },
    {
      "id": "shot04-18",
      "text": "说明价格在这批样本里单独切不太干净。",
      "start": 34.975,
      "end": 38.539
    },
    {
      "id": "shot04-19",
      "text": "再看 D，两刀连切：",
      "start": 38.539,
      "end": 40.444
    },
    {
      "id": "shot04-20",
      "text": "先按评分切，",
      "start": 40.444,
      "end": 41.647
    },
    {
      "id": "shot04-21",
      "text": "再按距离切，",
      "start": 41.647,
      "end": 42.79
    },
    {
      "id": "shot04-22",
      "text": "空间被分成 4 块，",
      "start": 42.79,
      "end": 44.475
    },
    {
      "id": "shot04-23",
      "text": "累计纯度提升分数升到 0.216。",
      "start": 44.475,
      "end": 47.864
    },
    {
      "id": "shot04-24",
      "text": "树就是这样长起来的：一刀不够，",
      "start": 47.864,
      "end": 50.31
    },
    {
      "id": "shot04-25",
      "text": "就在子集里继续切下一刀。",
      "start": 50.31,
      "end": 52.356
    },
    {
      "id": "shot04-26",
      "text": "到了 4 维、",
      "start": 52.762,
      "end": 53.605
    },
    {
      "id": "shot04-27",
      "text": "10 维甚至更多维，",
      "start": 53.605,
      "end": 55.071
    },
    {
      "id": "shot04-28",
      "text": "我们画不出来，",
      "start": 55.071,
      "end": 56.216
    },
    {
      "id": "shot04-29",
      "text": "但规则没变：",
      "start": 56.216,
      "end": 57.441
    },
    {
      "id": "shot04-30",
      "text": "每一刀都只沿着某一个特征轴切开。",
      "start": 57.441,
      "end": 60.152
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "到这里要分清两件事：",
      "start": 0.0,
      "end": 1.501
    },
    {
      "id": "shot05-1",
      "text": "训练和推理。训练，",
      "start": 1.501,
      "end": 3.322
    },
    {
      "id": "shot05-2",
      "text": "英文 training，",
      "start": 3.322,
      "end": 4.422
    },
    {
      "id": "shot05-3",
      "text": "是从历史数据里长出这棵树。",
      "start": 4.422,
      "end": 6.823
    },
    {
      "id": "shot05-4",
      "text": "算法要决定三件事：第一，",
      "start": 6.823,
      "end": 8.964
    },
    {
      "id": "shot05-5",
      "text": "根节点先问哪个特征，是评分、距离，",
      "start": 8.964,
      "end": 12.125
    },
    {
      "id": "shot05-6",
      "text": "还是价格；第二，",
      "start": 12.125,
      "end": 13.553
    },
    {
      "id": "shot05-7",
      "text": "阈值切在哪里，",
      "start": 13.553,
      "end": 14.607
    },
    {
      "id": "shot05-8",
      "text": "比如评分切 4.5 还是 4.0；第三，",
      "start": 14.607,
      "end": 18.028
    },
    {
      "id": "shot05-9",
      "text": "切到什么时候停止，",
      "start": 18.028,
      "end": 19.349
    },
    {
      "id": "shot05-10",
      "text": "避免每片叶子只剩一个样本。推理，",
      "start": 19.349,
      "end": 22.35
    },
    {
      "id": "shot05-11",
      "text": "英文 inference，",
      "start": 22.35,
      "end": 23.731
    },
    {
      "id": "shot05-12",
      "text": "就简单得多：",
      "start": 23.731,
      "end": 24.812
    },
    {
      "id": "shot05-13",
      "text": "树已经训练好了，新店进来，",
      "start": 24.812,
      "end": 27.127
    },
    {
      "id": "shot05-14",
      "text": "只要从根节点开始走。",
      "start": 27.127,
      "end": 29.04
    },
    {
      "id": "shot05-15",
      "text": "评分大于等于 4.5 吗？",
      "start": 29.04,
      "end": 30.873
    },
    {
      "id": "shot05-16",
      "text": "是，就走右边；",
      "start": 31.246,
      "end": 32.628
    },
    {
      "id": "shot05-17",
      "text": "距离小于等于 3 公里吗？是，再往下；",
      "start": 32.628,
      "end": 35.611
    },
    {
      "id": "shot05-18",
      "text": "价格小于等于 60 吗？是，",
      "start": 35.611,
      "end": 37.713
    },
    {
      "id": "shot05-19",
      "text": "最后落到“点”这个叶子。",
      "start": 37.713,
      "end": 39.455
    },
    {
      "id": "shot05-20",
      "text": "推理只走一条从根到叶的路径，",
      "start": 39.455,
      "end": 42.017
    },
    {
      "id": "shot05-21",
      "text": "所以非常快。",
      "start": 42.017,
      "end": 43.138
    },
    {
      "id": "shot05-22",
      "text": "训练负责长树，",
      "start": 43.138,
      "end": 44.6
    },
    {
      "id": "shot05-23",
      "text": "推理负责走树。",
      "start": 44.6,
      "end": 46.442
    },
    {
      "id": "shot05-24",
      "text": "这两个阶段分开，",
      "start": 46.442,
      "end": 47.823
    },
    {
      "id": "shot05-25",
      "text": "后面看 sklearn 代码才不会混。",
      "start": 47.823,
      "end": 50.326
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "把决策树放到前面几个算法旁边看，",
      "start": 0.0,
      "end": 2.984
    },
    {
      "id": "shot06-1",
      "text": "差异就更清楚。",
      "start": 2.984,
      "end": 4.326
    },
    {
      "id": "shot06-2",
      "text": "KNN 的问题是：",
      "start": 4.326,
      "end": 5.408
    },
    {
      "id": "shot06-3",
      "text": "这个样本离谁最近？",
      "start": 5.408,
      "end": 7.09
    },
    {
      "id": "shot06-4",
      "text": "所以它拼的是距离。",
      "start": 7.09,
      "end": 8.712
    },
    {
      "id": "shot06-5",
      "text": "逻辑回归的问题是：",
      "start": 8.712,
      "end": 10.074
    },
    {
      "id": "shot06-6",
      "text": "一组特征加权以后，",
      "start": 10.074,
      "end": 11.616
    },
    {
      "id": "shot06-7",
      "text": "分数落在哪边？",
      "start": 11.616,
      "end": 12.998
    },
    {
      "id": "shot06-8",
      "text": "所以它拼的是一条线性边界。",
      "start": 12.998,
      "end": 15.337
    },
    {
      "id": "shot06-9",
      "text": "决策树的问题是：",
      "start": 15.337,
      "end": 17.046
    },
    {
      "id": "shot06-10",
      "text": "先问哪个判断题，",
      "start": 17.046,
      "end": 18.429
    },
    {
      "id": "shot06-11",
      "text": "才能把样本切得更纯？",
      "start": 18.429,
      "end": 20.454
    },
    {
      "id": "shot06-12",
      "text": "所以它拼的是规则纯度。",
      "start": 20.454,
      "end": 22.66
    },
    {
      "id": "shot06-13",
      "text": "也因为每个问题只看一个特征，",
      "start": 22.66,
      "end": 25.367
    },
    {
      "id": "shot06-14",
      "text": "决策树的边界通常是横平竖直的矩形区域，",
      "start": 25.367,
      "end": 29.116
    },
    {
      "id": "shot06-15",
      "text": "这叫轴对齐，",
      "start": 29.116,
      "end": 30.46
    },
    {
      "id": "shot06-16",
      "text": "英文 axis-aligned。",
      "start": 30.46,
      "end": 32.064
    },
    {
      "id": "shot06-17",
      "text": "它的好处是规则清楚，",
      "start": 32.375,
      "end": 34.059
    },
    {
      "id": "shot06-18",
      "text": "业务方能直接读；",
      "start": 34.059,
      "end": 35.481
    },
    {
      "id": "shot06-19",
      "text": "坏处是斜线、",
      "start": 35.481,
      "end": 36.504
    },
    {
      "id": "shot06-20",
      "text": "圆形这类边界要用很多小矩形拼。",
      "start": 36.504,
      "end": 39.39
    },
    {
      "id": "shot06-21",
      "text": "接下来这一章会出现三个名字：ID3、",
      "start": 39.39,
      "end": 42.336
    },
    {
      "id": "shot06-22",
      "text": "C4.5 和 CART。",
      "start": 42.336,
      "end": 43.959
    },
    {
      "id": "shot06-23",
      "text": "它们都在做同一件事：",
      "start": 43.959,
      "end": 45.502
    },
    {
      "id": "shot06-24",
      "text": "递归切分样本。",
      "start": 45.502,
      "end": 47.146
    },
    {
      "id": "shot06-25",
      "text": "区别只是用什么分数判断哪一刀更好，",
      "start": 47.146,
      "end": 50.072
    },
    {
      "id": "shot06-26",
      "text": "以及树允许长成什么形状。",
      "start": 50.072,
      "end": 52.116
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.86
    },
    {
      "id": "shot07-1",
      "text": "我们先把决策树的直觉搭起来：第一，",
      "start": 0.86,
      "end": 3.681
    },
    {
      "id": "shot07-2",
      "text": "它是一串从数据里学出来的判断题；第二，",
      "start": 3.681,
      "end": 7.042
    },
    {
      "id": "shot07-3",
      "text": "内部节点负责提问，",
      "start": 7.042,
      "end": 8.743
    },
    {
      "id": "shot07-4",
      "text": "分支负责分流，",
      "start": 8.743,
      "end": 10.023
    },
    {
      "id": "shot07-5",
      "text": "叶子节点负责输出标签；第三，",
      "start": 10.023,
      "end": 12.644
    },
    {
      "id": "shot07-6",
      "text": "一刀切的目标不是看起来好看，",
      "start": 12.644,
      "end": 15.044
    },
    {
      "id": "shot07-7",
      "text": "而是让切完的子集更纯；第四，",
      "start": 15.044,
      "end": 18.005
    },
    {
      "id": "shot07-8",
      "text": "二维里是一条线，",
      "start": 18.005,
      "end": 19.366
    },
    {
      "id": "shot07-9",
      "text": "三维里是一张面，",
      "start": 19.366,
      "end": 20.766
    },
    {
      "id": "shot07-10",
      "text": "更多维里也是沿某个特征轴切开。",
      "start": 20.766,
      "end": 23.587
    },
    {
      "id": "shot07-11",
      "text": "这一期点到但没展开的，",
      "start": 23.587,
      "end": 25.495
    },
    {
      "id": "shot07-12",
      "text": "是“纯”到底怎么量化。",
      "start": 25.495,
      "end": 27.181
    },
    {
      "id": "shot07-13",
      "text": "互动演示里我们先把分数口播成纯度提升分数，",
      "start": 27.181,
      "end": 31.156
    },
    {
      "id": "shot07-14",
      "text": "还没有展开具体公式。",
      "start": 31.156,
      "end": 32.762
    },
    {
      "id": "shot07-15",
      "text": "下一期就补上另一把正式尺子：",
      "start": 33.138,
      "end": 35.563
    },
    {
      "id": "shot07-16",
      "text": "信息熵和信息增益。",
      "start": 35.563,
      "end": 37.507
    },
    {
      "id": "shot07-17",
      "text": "只有先把“混杂程度”变成数字，",
      "start": 37.507,
      "end": 39.831
    },
    {
      "id": "shot07-18",
      "text": "后面 ID3 才知道该选哪一个特征做根节",
      "start": 39.831,
      "end": 42.877
    },
    {
      "id": "shot07-19",
      "text": "点。",
      "start": 42.877,
      "end": 43.458
    },
    {
      "id": "shot07-20",
      "text": "这里故意不急着进入新公式，",
      "start": 43.458,
      "end": 45.603
    },
    {
      "id": "shot07-21",
      "text": "因为观众已经见过一刀和多维切面，",
      "start": 45.603,
      "end": 48.368
    },
    {
      "id": "shot07-22",
      "text": "下一步只需要把“哪一刀更好”变成可计算的",
      "start": 48.368,
      "end": 51.394
    },
    {
      "id": "shot07-23",
      "text": "问题。",
      "start": 51.394,
      "end": 51.615
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.731
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.731,
      "end": 2.213
    }
  ]
}
