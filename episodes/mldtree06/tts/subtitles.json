{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们知道，",
      "start": 0.0,
      "end": 0.921
    },
    {
      "id": "shot01-1",
      "text": "CART 要选基尼指数最小的那一刀。",
      "start": 0.921,
      "end": 3.685
    },
    {
      "id": "shot01-2",
      "text": "但真正落到数据表上，",
      "start": 3.685,
      "end": 5.287
    },
    {
      "id": "shot01-3",
      "text": "难点不是公式，",
      "start": 5.287,
      "end": 6.569
    },
    {
      "id": "shot01-4",
      "text": "而是候选切分从哪里来。",
      "start": 6.569,
      "end": 8.612
    },
    {
      "id": "shot01-5",
      "text": "二值特征天然能切。",
      "start": 8.612,
      "end": 10.254
    },
    {
      "id": "shot01-6",
      "text": "多值特征不能一次开很多叉，",
      "start": 10.254,
      "end": 12.477
    },
    {
      "id": "shot01-7",
      "text": "因为 CART 必须二叉。",
      "start": 12.477,
      "end": 14.54
    },
    {
      "id": "shot01-8",
      "text": "连续特征更麻烦，",
      "start": 14.54,
      "end": 16.112
    },
    {
      "id": "shot01-9",
      "text": "阈值理论上有无穷多个。",
      "start": 16.112,
      "end": 17.944
    },
    {
      "id": "shot01-10",
      "text": "这一期我们用贷款审批数据，",
      "start": 17.944,
      "end": 20.287
    },
    {
      "id": "shot01-11",
      "text": "把三种特征的切法都手算一遍，",
      "start": 20.287,
      "end": 22.811
    },
    {
      "id": "shot01-12",
      "text": "再把 ID3、",
      "start": 22.811,
      "end": 23.752
    },
    {
      "id": "shot01-13",
      "text": "C4.5 和 CART 放到一张表里对齐。",
      "start": 23.752,
      "end": 26.356
    },
    {
      "id": "shot01-14",
      "text": "这也是 CART 比前面两种树更像工程算",
      "start": 26.909,
      "end": 30.122
    },
    {
      "id": "shot01-15",
      "text": "法的地方：",
      "start": 30.122,
      "end": 30.865
    },
    {
      "id": "shot01-16",
      "text": "先把各种特征都改写成二分候选，",
      "start": 30.865,
      "end": 33.696
    },
    {
      "id": "shot01-17",
      "text": "再用同一把尺子公平比较。",
      "start": 33.696,
      "end": 35.623
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "第一招，",
      "start": 0.0,
      "end": 0.681
    },
    {
      "id": "shot02-1",
      "text": "二值特征天然二分。",
      "start": 0.681,
      "end": 2.442
    },
    {
      "id": "shot02-2",
      "text": "比如“是否有房”，",
      "start": 2.442,
      "end": 3.903
    },
    {
      "id": "shot02-3",
      "text": "取值只有 yes 和 no。",
      "start": 3.903,
      "end": 5.765
    },
    {
      "id": "shot02-4",
      "text": "CART 只需要一刀：",
      "start": 5.765,
      "end": 7.606
    },
    {
      "id": "shot02-5",
      "text": "有房走左边，",
      "start": 7.606,
      "end": 8.867
    },
    {
      "id": "shot02-6",
      "text": "没房走右边。",
      "start": 8.867,
      "end": 10.108
    },
    {
      "id": "shot02-7",
      "text": "然后分别算左右子集的基尼值，",
      "start": 10.108,
      "end": 12.81
    },
    {
      "id": "shot02-8",
      "text": "再按样本数加权，",
      "start": 12.81,
      "end": 14.051
    },
    {
      "id": "shot02-9",
      "text": "得到这一刀的基尼指数。",
      "start": 14.051,
      "end": 16.273
    },
    {
      "id": "shot02-10",
      "text": "贷款案例里，",
      "start": 16.273,
      "end": 17.314
    },
    {
      "id": "shot02-11",
      "text": "是否有房这一刀切完以后，",
      "start": 17.314,
      "end": 19.515
    },
    {
      "id": "shot02-12",
      "text": "左支和右支的标签分布会明显变化，",
      "start": 19.515,
      "end": 22.558
    },
    {
      "id": "shot02-13",
      "text": "所以它是一个有用候选。",
      "start": 22.558,
      "end": 24.299
    },
    {
      "id": "shot02-14",
      "text": "二值特征的好处是简单，",
      "start": 24.299,
      "end": 26.265
    },
    {
      "id": "shot02-15",
      "text": "没有枚举歧义，",
      "start": 26.265,
      "end": 27.689
    },
    {
      "id": "shot02-16",
      "text": "切法只有一种。",
      "start": 27.689,
      "end": 28.812
    },
    {
      "id": "shot02-17",
      "text": "讲这类特征时，",
      "start": 28.812,
      "end": 30.156
    },
    {
      "id": "shot02-18",
      "text": "画面可以只放一条竖线。",
      "start": 30.156,
      "end": 31.801
    },
    {
      "id": "shot02-19",
      "text": "左边是 yes，",
      "start": 32.321,
      "end": 33.284
    },
    {
      "id": "shot02-20",
      "text": "右边是 no，",
      "start": 33.284,
      "end": 34.086
    },
    {
      "id": "shot02-21",
      "text": "下面各自接类别比例，",
      "start": 34.086,
      "end": 36.133
    },
    {
      "id": "shot02-22",
      "text": "让观众看到二分天然成立。",
      "start": 36.133,
      "end": 38.58
    },
    {
      "id": "shot02-23",
      "text": "这一点能把三类特征统一起来：",
      "start": 38.58,
      "end": 41.288
    },
    {
      "id": "shot02-24",
      "text": "无论原始取值长什么样，",
      "start": 41.288,
      "end": 43.394
    },
    {
      "id": "shot02-25",
      "text": "最后都变成左支和右支的比较。",
      "start": 43.394,
      "end": 45.862
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "第二招，",
      "start": 0.0,
      "end": 0.721
    },
    {
      "id": "shot03-1",
      "text": "多值离散特征要枚举二分。",
      "start": 0.721,
      "end": 3.163
    },
    {
      "id": "shot03-2",
      "text": "比如婚姻状况有 3 个取值：未婚、已婚、",
      "start": 3.163,
      "end": 6.346
    },
    {
      "id": "shot03-3",
      "text": "离异。",
      "start": 6.346,
      "end": 6.906
    },
    {
      "id": "shot03-4",
      "text": "ID3 和 C4.5 可能一次开 3 个",
      "start": 6.906,
      "end": 9.649
    },
    {
      "id": "shot03-5",
      "text": "分支，",
      "start": 9.649,
      "end": 10.189
    },
    {
      "id": "shot03-6",
      "text": "但 CART 不行，",
      "start": 10.189,
      "end": 11.39
    },
    {
      "id": "shot03-7",
      "text": "它必须二叉。",
      "start": 11.39,
      "end": 12.551
    },
    {
      "id": "shot03-8",
      "text": "所以 CART 会枚举三种切法：",
      "start": 12.551,
      "end": 14.773
    },
    {
      "id": "shot03-9",
      "text": "已婚对其余，",
      "start": 14.773,
      "end": 15.814
    },
    {
      "id": "shot03-10",
      "text": "未婚对其余，",
      "start": 15.814,
      "end": 16.855
    },
    {
      "id": "shot03-11",
      "text": "离异对其余。",
      "start": 16.855,
      "end": 18.156
    },
    {
      "id": "shot03-12",
      "text": "每种切法都算一个基尼指数，",
      "start": 18.156,
      "end": 20.418
    },
    {
      "id": "shot03-13",
      "text": "谁最小就选谁。",
      "start": 20.418,
      "end": 21.74
    },
    {
      "id": "shot03-14",
      "text": "这里要注意，",
      "start": 21.74,
      "end": 22.46
    },
    {
      "id": "shot03-15",
      "text": "不是 3 个取值就只看 3 个分支，",
      "start": 22.46,
      "end": 24.902
    },
    {
      "id": "shot03-16",
      "text": "而是要看所有有意义的二分组合。",
      "start": 24.902,
      "end": 27.705
    },
    {
      "id": "shot03-17",
      "text": "4 个取值时，",
      "start": 27.705,
      "end": 28.606
    },
    {
      "id": "shot03-18",
      "text": "候选组合会更多。",
      "start": 28.606,
      "end": 29.667
    },
    {
      "id": "shot03-19",
      "text": "如果取值更多，",
      "start": 30.215,
      "end": 31.559
    },
    {
      "id": "shot03-20",
      "text": "原则也一样：",
      "start": 31.559,
      "end": 32.682
    },
    {
      "id": "shot03-21",
      "text": "左边放一组取值，",
      "start": 32.682,
      "end": 34.246
    },
    {
      "id": "shot03-22",
      "text": "右边放剩下取值。",
      "start": 34.246,
      "end": 35.871
    },
    {
      "id": "shot03-23",
      "text": "只是组合数会增加，",
      "start": 35.871,
      "end": 37.435
    },
    {
      "id": "shot03-24",
      "text": "所以实现时要高效枚举。",
      "start": 37.435,
      "end": 39.661
    },
    {
      "id": "shot03-25",
      "text": "这一点能把三类特征统一起来：",
      "start": 39.661,
      "end": 42.309
    },
    {
      "id": "shot03-26",
      "text": "无论原始取值长什么样，",
      "start": 42.309,
      "end": 44.294
    },
    {
      "id": "shot03-27",
      "text": "最后都变成左支和右支的比较。",
      "start": 44.294,
      "end": 46.982
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "第三招，",
      "start": 0.0,
      "end": 0.64
    },
    {
      "id": "shot04-1",
      "text": "连续特征先排序，",
      "start": 0.64,
      "end": 2.181
    },
    {
      "id": "shot04-2",
      "text": "再取相邻中点做候选阈值。",
      "start": 2.181,
      "end": 4.543
    },
    {
      "id": "shot04-3",
      "text": "比如贷款数据里的年收入排序是 60、",
      "start": 4.543,
      "end": 7.524
    },
    {
      "id": "shot04-4",
      "text": "70、75、85、90、95、100、",
      "start": 7.524,
      "end": 10.726
    },
    {
      "id": "shot04-5",
      "text": "120、125、",
      "start": 10.726,
      "end": 11.887
    },
    {
      "id": "shot04-6",
      "text": "220。",
      "start": 11.887,
      "end": 12.954
    },
    {
      "id": "shot04-7",
      "text": "CART 不会在所有实数里乱试，",
      "start": 12.954,
      "end": 15.349
    },
    {
      "id": "shot04-8",
      "text": "而是在相邻收入之间取中点：65、",
      "start": 15.349,
      "end": 17.91
    },
    {
      "id": "shot04-9",
      "text": "72.5、80、87.5、92.5、",
      "start": 17.91,
      "end": 20.592
    },
    {
      "id": "shot04-10",
      "text": "97.5、110、",
      "start": 20.592,
      "end": 22.093
    },
    {
      "id": "shot04-11",
      "text": "122.5、",
      "start": 22.093,
      "end": 22.933
    },
    {
      "id": "shot04-12",
      "text": "172.5。",
      "start": 22.933,
      "end": 24.754
    },
    {
      "id": "shot04-13",
      "text": "每个中点都代表一刀，",
      "start": 24.754,
      "end": 26.44
    },
    {
      "id": "shot04-14",
      "text": "年收入小于等于这个阈值走左边，",
      "start": 26.44,
      "end": 29.029
    },
    {
      "id": "shot04-15",
      "text": "大于阈值走右边。",
      "start": 29.029,
      "end": 30.535
    },
    {
      "id": "shot04-16",
      "text": "所有候选阈值都算完以后，",
      "start": 30.535,
      "end": 32.461
    },
    {
      "id": "shot04-17",
      "text": "选基尼指数最小的。",
      "start": 32.461,
      "end": 33.826
    },
    {
      "id": "shot04-18",
      "text": "这样连续问题就变成了有限个候选点的比较。",
      "start": 34.293,
      "end": 37.859
    },
    {
      "id": "shot04-19",
      "text": "相邻中点还有一个好处：",
      "start": 37.859,
      "end": 39.913
    },
    {
      "id": "shot04-20",
      "text": "阈值落在两个真实样本之间，",
      "start": 39.913,
      "end": 42.387
    },
    {
      "id": "shot04-21",
      "text": "不会改变样本排序。",
      "start": 42.387,
      "end": 44.07
    },
    {
      "id": "shot04-22",
      "text": "只要排序不变，",
      "start": 44.07,
      "end": 45.433
    },
    {
      "id": "shot04-23",
      "text": "区间里的任意阈值效果都一样。",
      "start": 45.433,
      "end": 48.037
    },
    {
      "id": "shot04-24",
      "text": "这一点能把三类特征统一起来：",
      "start": 48.037,
      "end": 50.822
    },
    {
      "id": "shot04-25",
      "text": "无论原始取值长什么样，",
      "start": 50.822,
      "end": 52.886
    },
    {
      "id": "shot04-26",
      "text": "最后都变成左支和右支的比较。",
      "start": 52.886,
      "end": 55.35
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "三类候选都准备好以后，",
      "start": 0.0,
      "end": 1.923
    },
    {
      "id": "shot05-1",
      "text": "CART 把它们放在一起比较。",
      "start": 1.923,
      "end": 4.146
    },
    {
      "id": "shot05-2",
      "text": "是否有房有一个候选，",
      "start": 4.146,
      "end": 6.008
    },
    {
      "id": "shot05-3",
      "text": "婚姻状况有多个二分候选，",
      "start": 6.008,
      "end": 8.191
    },
    {
      "id": "shot05-4",
      "text": "年收入有多个中点候选。",
      "start": 8.191,
      "end": 10.254
    },
    {
      "id": "shot05-5",
      "text": "每个候选都对应一个基尼指数，",
      "start": 10.254,
      "end": 12.717
    },
    {
      "id": "shot05-6",
      "text": "选最小的那一个做当前节点。切完以后，",
      "start": 12.717,
      "end": 16.263
    },
    {
      "id": "shot05-7",
      "text": "某些子集可能已经很纯，",
      "start": 16.263,
      "end": 18.209
    },
    {
      "id": "shot05-8",
      "text": "直接变成叶子；",
      "start": 18.209,
      "end": 19.432
    },
    {
      "id": "shot05-9",
      "text": "不纯的子集继续递归，",
      "start": 19.432,
      "end": 21.397
    },
    {
      "id": "shot05-10",
      "text": "再从所有特征里找下一刀。",
      "start": 21.397,
      "end": 23.724
    },
    {
      "id": "shot05-11",
      "text": "连续特征尤其常见：",
      "start": 23.724,
      "end": 25.599
    },
    {
      "id": "shot05-12",
      "text": "同一列年收入可以在不同深度反复出现，",
      "start": 25.599,
      "end": 28.718
    },
    {
      "id": "shot05-13",
      "text": "只是每一层的阈值不一样。",
      "start": 28.718,
      "end": 30.362
    },
    {
      "id": "shot05-14",
      "text": "这一步也解释了为什么树会越来越细：",
      "start": 30.968,
      "end": 33.755
    },
    {
      "id": "shot05-15",
      "text": "每个节点都只关心自己手里的子集，",
      "start": 33.755,
      "end": 36.701
    },
    {
      "id": "shot05-16",
      "text": "局部选最优，",
      "start": 36.701,
      "end": 37.804
    },
    {
      "id": "shot05-17",
      "text": "子集再继续做局部最优。",
      "start": 37.804,
      "end": 39.628
    },
    {
      "id": "shot05-18",
      "text": "这一点能把三类特征统一起来：",
      "start": 39.628,
      "end": 42.134
    },
    {
      "id": "shot05-19",
      "text": "无论原始取值长什么样，",
      "start": 42.134,
      "end": 44.079
    },
    {
      "id": "shot05-20",
      "text": "最后都变成左支和右支的比较。",
      "start": 44.079,
      "end": 46.063
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "到这里，",
      "start": 0.0,
      "end": 0.54
    },
    {
      "id": "shot06-1",
      "text": "三代分类树可以排成一张地图。",
      "start": 0.54,
      "end": 3.102
    },
    {
      "id": "shot06-2",
      "text": "ID3 用信息增益，多叉，",
      "start": 3.102,
      "end": 5.184
    },
    {
      "id": "shot06-3",
      "text": "只适合离散特征，",
      "start": 5.184,
      "end": 6.805
    },
    {
      "id": "shot06-4",
      "text": "教学很清楚，",
      "start": 6.805,
      "end": 7.685
    },
    {
      "id": "shot06-5",
      "text": "但偏好多值特征。",
      "start": 7.685,
      "end": 9.446
    },
    {
      "id": "shot06-6",
      "text": "C4.5 用信息增益率，仍然多叉，",
      "start": 9.446,
      "end": 12.268
    },
    {
      "id": "shot06-7",
      "text": "修正了多值偏好，",
      "start": 12.268,
      "end": 13.709
    },
    {
      "id": "shot06-8",
      "text": "也支持连续和缺失值。",
      "start": 13.709,
      "end": 15.931
    },
    {
      "id": "shot06-9",
      "text": "CART 用基尼指数，严格二叉，",
      "start": 15.931,
      "end": 18.613
    },
    {
      "id": "shot06-10",
      "text": "能分类也能回归，",
      "start": 18.613,
      "end": 20.134
    },
    {
      "id": "shot06-11",
      "text": "工程上最常见。",
      "start": 20.134,
      "end": 21.395
    },
    {
      "id": "shot06-12",
      "text": "不要把它们理解成简单替换。",
      "start": 21.395,
      "end": 23.536
    },
    {
      "id": "shot06-13",
      "text": "ID3 让我们学会信息熵，",
      "start": 23.536,
      "end": 25.648
    },
    {
      "id": "shot06-14",
      "text": "C4.5 让我们看到复杂度惩罚，",
      "start": 25.648,
      "end": 28.263
    },
    {
      "id": "shot06-15",
      "text": "CART 则成为 sklearn 和很多",
      "start": 28.263,
      "end": 30.757
    },
    {
      "id": "shot06-16",
      "text": "树模型的工程主线。",
      "start": 30.757,
      "end": 32.004
    },
    {
      "id": "shot06-17",
      "text": "这张对比表不要背成历史演进表，",
      "start": 32.568,
      "end": 35.039
    },
    {
      "id": "shot06-18",
      "text": "而要当成工具箱索引。",
      "start": 35.039,
      "end": 36.867
    },
    {
      "id": "shot06-19",
      "text": "看公式直觉选 ID3，",
      "start": 36.867,
      "end": 38.836
    },
    {
      "id": "shot06-20",
      "text": "看多值修正看 C4.5，",
      "start": 38.836,
      "end": 40.844
    },
    {
      "id": "shot06-21",
      "text": "看工程落地看 CART。",
      "start": 40.844,
      "end": 42.371
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期我们把 CART 的切分机制补齐了。",
      "start": 0.0,
      "end": 2.703
    },
    {
      "id": "shot07-1",
      "text": "二值特征直接二分，",
      "start": 2.703,
      "end": 4.365
    },
    {
      "id": "shot07-2",
      "text": "多值特征枚举二分组合，",
      "start": 4.365,
      "end": 6.387
    },
    {
      "id": "shot07-3",
      "text": "连续特征排序取相邻中点。",
      "start": 6.387,
      "end": 8.769
    },
    {
      "id": "shot07-4",
      "text": "所有候选切分都用同一把尺子比较：",
      "start": 8.769,
      "end": 11.472
    },
    {
      "id": "shot07-5",
      "text": "基尼指数越小越好。到这里，ID3、",
      "start": 11.472,
      "end": 14.215
    },
    {
      "id": "shot07-6",
      "text": "C4.5、",
      "start": 14.215,
      "end": 15.036
    },
    {
      "id": "shot07-7",
      "text": "CART 的主线也连起来了。",
      "start": 15.036,
      "end": 17.478
    },
    {
      "id": "shot07-8",
      "text": "下一期我们不再手算小表，",
      "start": 17.478,
      "end": 19.741
    },
    {
      "id": "shot07-9",
      "text": "而是进入工程项目：",
      "start": 19.741,
      "end": 21.222
    },
    {
      "id": "shot07-10",
      "text": "用 sklearn 的",
      "start": 21.222,
      "end": 21.582
    },
    {
      "id": "shot07-11",
      "text": "DecisionTreeClassifier",
      "start": 21.582,
      "end": 24.145
    },
    {
      "id": "shot07-12",
      "text": "做 Titanic 生存预测。",
      "start": 24.145,
      "end": 26.007
    },
    {
      "id": "shot07-13",
      "text": "从下一期开始，",
      "start": 26.007,
      "end": 27.268
    },
    {
      "id": "shot07-14",
      "text": "重点从手算转向完整项目。",
      "start": 27.268,
      "end": 29.591
    },
    {
      "id": "shot07-15",
      "text": "前面学到的基尼指数、",
      "start": 29.957,
      "end": 31.882
    },
    {
      "id": "shot07-16",
      "text": "二叉切分和刹车参数，",
      "start": 31.882,
      "end": 33.908
    },
    {
      "id": "shot07-17",
      "text": "都会在代码里重新出现。",
      "start": 33.908,
      "end": 36.234
    },
    {
      "id": "shot07-18",
      "text": "这一点能把三类特征统一起来：",
      "start": 36.234,
      "end": 38.841
    },
    {
      "id": "shot07-19",
      "text": "无论原始取值长什么样，",
      "start": 38.841,
      "end": 40.866
    },
    {
      "id": "shot07-20",
      "text": "最后都变成左支和右支的比较。",
