{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期 sklearn 4 行跑通了线性",
      "start": 0.0,
      "end": 2.484
    },
    {
      "id": "shot01-1",
      "text": "回归——但 fit 内部到底在做什么？",
      "start": 2.484,
      "end": 5.009
    },
    {
      "id": "shot01-2",
      "text": "什么是'好'直线？",
      "start": 5.009,
      "end": 6.311
    },
    {
      "id": "shot01-3",
      "text": "这一期我们打开黑盒：",
      "start": 6.311,
      "end": 8.034
    },
    {
      "id": "shot01-4",
      "text": "'好' 等于'损失最小'。",
      "start": 8.034,
      "end": 9.577
    },
    {
      "id": "shot01-5",
      "text": "这一期解决三件事：",
      "start": 9.577,
      "end": 10.899
    },
    {
      "id": "shot01-6",
      "text": "什么是误差、",
      "start": 10.899,
      "end": 11.841
    },
    {
      "id": "shot01-7",
      "text": "什么是损失、",
      "start": 11.841,
      "end": 12.742
    },
    {
      "id": "shot01-8",
      "text": "两者区别；",
      "start": 12.742,
      "end": 14.085
    },
    {
      "id": "shot01-9",
      "text": "MSE 公式怎么写、",
      "start": 14.085,
      "end": 15.707
    },
    {
      "id": "shot01-10",
      "text": "为什么用平方而不是绝对值；",
      "start": 15.707,
      "end": 18.072
    },
    {
      "id": "shot01-11",
      "text": "以及用 5 个身高体重数据点手算一遍最优",
      "start": 18.072,
      "end": 21.598
    },
    {
      "id": "shot01-12",
      "text": "k，",
      "start": 21.598,
      "end": 22.078
    },
    {
      "id": "shot01-13",
      "text": "得到约 0.97。",
      "start": 22.078,
      "end": 23.321
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先分清两个容易混的概念：",
      "start": 0.0,
      "end": 2.442
    },
    {
      "id": "shot02-1",
      "text": "误差 error 和损失 loss。",
      "start": 2.442,
      "end": 5.123
    },
    {
      "id": "shot02-2",
      "text": "打个比方：",
      "start": 5.123,
      "end": 5.924
    },
    {
      "id": "shot02-3",
      "text": "街头猜 5 个陌生人体重，",
      "start": 5.924,
      "end": 8.105
    },
    {
      "id": "shot02-4",
      "text": "主持人定规矩——每猜偏 1 公斤罚 1",
      "start": 8.105,
      "end": 11.147
    },
    {
      "id": "shot02-5",
      "text": "块钱。",
      "start": 11.147,
      "end": 11.828
    },
    {
      "id": "shot02-6",
      "text": "每次猜偏多少是误差，",
      "start": 11.828,
      "end": 13.849
    },
    {
      "id": "shot02-7",
      "text": "单点偏差；",
      "start": 13.849,
      "end": 15.143
    },
    {
      "id": "shot02-8",
      "text": "5 次罚款加起来是损失，整场总分，",
      "start": 15.143,
      "end": 18.232
    },
    {
      "id": "shot02-9",
      "text": "总分最少的赢。",
      "start": 18.232,
      "end": 19.934
    },
    {
      "id": "shot02-10",
      "text": "形式化看：",
      "start": 19.934,
      "end": 21.037
    },
    {
      "id": "shot02-11",
      "text": "误差等于预测值 ŷ 减真实值 y，",
      "start": 21.037,
      "end": 24.546
    },
    {
      "id": "shot02-12",
      "text": "每个样本各一个；",
      "start": 24.546,
      "end": 26.23
    },
    {
      "id": "shot02-13",
      "text": "损失把所有误差汇总成一个总分，",
      "start": 26.23,
      "end": 29.198
    },
    {
      "id": "shot02-14",
      "text": "描述整条线的好坏。",
      "start": 29.198,
      "end": 31.324
    },
    {
      "id": "shot02-15",
      "text": "LR 训练就是给候选直线打罚款分，",
      "start": 31.324,
      "end": 34.472
    },
    {
      "id": "shot02-16",
      "text": "找总分最低的那条。",
      "start": 34.472,
      "end": 36.056
    },
    {
      "id": "shot02-17",
      "text": "把损失写成函数形式叫损失函数 loss",
      "start": 36.304,
      "end": 39.768
    },
    {
      "id": "shot02-18",
      "text": "function。",
      "start": 39.768,
      "end": 40.349
    },
    {
      "id": "shot02-19",
      "text": "这里一物多名要警告：",
      "start": 40.349,
      "end": 42.112
    },
    {
      "id": "shot02-20",
      "text": "损失函数也叫代价函数 cost",
      "start": 42.112,
      "end": 44.875
    },
    {
      "id": "shot02-21",
      "text": "function、",
      "start": 44.875,
      "end": 45.456
    },
    {
      "id": "shot02-22",
      "text": "目标函数 objective",
      "start": 45.456,
      "end": 47.038
    },
    {
      "id": "shot02-23",
      "text": "function——不同领域叫法不同，",
      "start": 47.038,
      "end": 49.041
    },
    {
      "id": "shot02-24",
      "text": "核心含义完全相同：",
      "start": 49.041,
      "end": 50.843
    },
    {
      "id": "shot02-25",
      "text": "衡量模型拟合好坏的一个总分。",
      "start": 50.843,
      "end": 53.086
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "现在看公式。",
      "start": 0.0,
      "end": 1.141
    },
    {
      "id": "shot03-1",
      "text": "最常用的损失函数叫均方误差 MSE，",
      "start": 1.141,
      "end": 4.684
    },
    {
      "id": "shot03-2",
      "text": "全称 Mean Squared",
      "start": 4.684,
      "end": 6.066
    },
    {
      "id": "shot03-3",
      "text": "Error。",
      "start": 6.066,
      "end": 6.646
    },
    {
      "id": "shot03-4",
      "text": "把每个点的误差平方，",
      "start": 6.646,
      "end": 8.708
    },
    {
      "id": "shot03-5",
      "text": "5 个加起来除以样本数 m 求平均。",
      "start": 8.708,
      "end": 11.911
    },
    {
      "id": "shot03-6",
      "text": "还有一种叫平均绝对误差 MAE，",
      "start": 11.911,
      "end": 14.974
    },
    {
      "id": "shot03-7",
      "text": "全称 Mean Absolute",
      "start": 14.974,
      "end": 16.456
    },
    {
      "id": "shot03-8",
      "text": "Error，不平方，",
      "start": 16.456,
      "end": 17.677
    },
    {
      "id": "shot03-9",
      "text": "取绝对值。",
      "start": 17.677,
      "end": 18.998
    },
    {
      "id": "shot03-10",
      "text": "两种方案 LR 通常选 MSE，",
      "start": 18.998,
      "end": 22.161
    },
    {
      "id": "shot03-11",
      "text": "三个原因。",
      "start": 22.161,
      "end": 22.762
    },
    {
      "id": "shot03-12",
      "text": "第一，",
      "start": 23.329,
      "end": 24.15
    },
    {
      "id": "shot03-13",
      "text": "MSE 平方处处可导；",
      "start": 24.15,
      "end": 26.213
    },
    {
      "id": "shot03-14",
      "text": "MAE 在 0 这一点是个尖角不可导——",
      "start": 26.213,
      "end": 29.018
    },
    {
      "id": "shot03-15",
      "text": "后面要用导数等于零求最优解，",
      "start": 29.018,
      "end": 31.682
    },
    {
      "id": "shot03-16",
      "text": "MSE 才能往下走。第二，",
      "start": 31.682,
      "end": 34.086
    },
    {
      "id": "shot03-17",
      "text": "MSE 平方放大大误差。",
      "start": 34.086,
      "end": 36.469
    },
    {
      "id": "shot03-18",
      "text": "误差 1 算 1，",
      "start": 36.469,
      "end": 37.591
    },
    {
      "id": "shot03-19",
      "text": "误差 4 算 16——模型为降损失会优先",
      "start": 37.591,
      "end": 40.976
    },
    {
      "id": "shot03-20",
      "text": "对付偏得最多的点；",
      "start": 40.976,
      "end": 43.08
    },
    {
      "id": "shot03-21",
      "text": "MAE 误差 1 算 1，",
      "start": 43.08,
      "end": 44.562
    },
    {
      "id": "shot03-22",
      "text": "误差 4 算 4，",
      "start": 44.562,
      "end": 45.904
    },
    {
      "id": "shot03-23",
      "text": "对大误差不敏感。",
      "start": 45.904,
      "end": 47.106
    },
    {
      "id": "shot03-24",
      "text": "第三，",
      "start": 47.312,
      "end": 47.833
    },
    {
      "id": "shot03-25",
      "text": "MSE 损失是二次函数，",
      "start": 47.833,
      "end": 50.235
    },
    {
      "id": "shot03-26",
      "text": "最优解有闭式代数公式（后面叫正规方程），",
      "start": 50.235,
      "end": 53.698
    },
    {
      "id": "shot03-27",
      "text": "一步解出；",
      "start": 53.698,
      "end": 54.82
    },
    {
      "id": "shot03-28",
      "text": "MAE 损失分段线性，",
      "start": 54.82,
      "end": 56.902
    },
    {
      "id": "shot03-29",
      "text": "没有简单公式只能迭代逼近。",
      "start": 56.902,
      "end": 59.144
    },
    {
      "id": "shot03-30",
      "text": "代价是 MSE 怕异常值 outlier",
      "start": 59.144,
      "end": 62.167
    },
    {
      "id": "shot03-31",
      "text": "——一个偏离主流很远的点会被平方放得超大",
      "start": 62.167,
      "end": 65.51
    },
    {
      "id": "shot03-32",
      "text": "把模型拽歪。",
      "start": 65.51,
      "end": 66.992
    },
    {
      "id": "shot03-33",
      "text": "LR 选 MSE 就是这套权衡。",
      "start": 66.992,
      "end": 69.955
    },
    {
      "id": "shot03-34",
      "text": "数据有异常值多的话改用 MAE 或",
      "start": 69.955,
      "end": 73.098
    },
    {
      "id": "shot03-35",
      "text": "Huber loss，",
      "start": 73.098,
      "end": 74.139
    },
    {
      "id": "shot03-36",
      "text": "不在本期展开。",
      "start": 74.139,
      "end": 75.04
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开 demo 看可视化。",
      "start": 0.0,
      "end": 1.642
    },
    {
      "id": "shot04-1",
      "text": "屏幕上 5 个蓝点是样本。",
      "start": 1.642,
      "end": 3.704
    },
    {
      "id": "shot04-2",
      "text": "注意一个语境切换：",
      "start": 3.704,
      "end": 5.305
    },
    {
      "id": "shot04-3",
      "text": "demo 用合成数据，",
      "start": 5.305,
      "end": 6.934
    },
    {
      "id": "shot04-4",
      "text": "5 个点在负 3 到 3 范围内，",
      "start": 6.934,
      "end": 9.209
    },
    {
      "id": "shot04-5",
      "text": "真值 k 约 0.97、",
      "start": 9.209,
      "end": 10.991
    },
    {
      "id": "shot04-6",
      "text": "b 约 1 加了点噪声——跟上期身高体重",
      "start": 10.991,
      "end": 14.174
    },
    {
      "id": "shot04-7",
      "text": "不同尺度，",
      "start": 14.174,
      "end": 15.115
    },
    {
      "id": "shot04-8",
      "text": "但概念完全一样，",
      "start": 15.115,
      "end": 16.516
    },
    {
      "id": "shot04-9",
      "text": "重点看红方块大小。",
      "start": 16.516,
      "end": 18.638
    },
    {
      "id": "shot04-10",
      "text": "中间一条红线是当前模型 y = kx + b。",
      "start": 18.638,
      "end": 22.602
    },
    {
      "id": "shot04-12",
      "text": "每个数据点旁有一个红方块，",
      "start": 22.602,
      "end": 24.944
    },
    {
      "id": "shot04-13",
      "text": "方块面积代表这一点的误差平方值。",
      "start": 24.944,
      "end": 27.527
    },
    {
      "id": "shot04-14",
      "text": "所有方块面积加起来除以样本数 m 就是",
      "start": 28.04,
      "end": 31.526
    },
    {
      "id": "shot04-15",
      "text": "MSE，",
      "start": 31.526,
      "end": 32.368
    },
    {
      "id": "shot04-16",
      "text": "显示在底部数字面板。",
      "start": 32.368,
      "end": 34.271
    },
    {
      "id": "shot04-17",
      "text": "还有一条绿色虚线是闭式解最优拟合——目标",
      "start": 34.271,
      "end": 37.778
    },
    {
      "id": "shot04-18",
      "text": "是把红线拖到跟绿虚线重合。先看默认：",
      "start": 37.778,
      "end": 41.384
    },
    {
      "id": "shot04-19",
      "text": "k 等于 0.5、",
      "start": 41.384,
      "end": 42.626
    },
    {
      "id": "shot04-20",
      "text": "b 等于负 2，",
      "start": 42.626,
      "end": 43.802
    },
    {
      "id": "shot04-21",
      "text": "5 个红方块都很大，",
      "start": 43.802,
      "end": 45.351
    },
    {
      "id": "shot04-22",
      "text": "MSE 显示 9.37。",
      "start": 45.351,
      "end": 47.996
    },
    {
      "id": "shot04-23",
      "text": "把 k 拖到 0.8、",
      "start": 47.996,
      "end": 49.539
    },
    {
      "id": "shot04-24",
      "text": "b 拖到 0.8——红线逼近绿虚线，",
      "start": 49.539,
      "end": 52.571
    },
    {
      "id": "shot04-25",
      "text": "5 个方块全部缩小，",
      "start": 52.571,
      "end": 54.067
    },
    {
      "id": "shot04-26",
      "text": "MSE 跌到 1.12，这是最优。",
      "start": 54.067,
      "end": 56.572
    },
    {
      "id": "shot04-27",
      "text": "再把 k 拉到 3，",
      "start": 57.015,
      "end": 58.497
    },
    {
      "id": "shot04-28",
      "text": "红线变得过陡，",
      "start": 58.497,
      "end": 59.939
    },
    {
      "id": "shot04-29",
      "text": "最右那个红方块爆炸增大，",
      "start": 59.939,
      "end": 62.102
    },
    {
      "id": "shot04-30",
      "text": "MSE 飙到 22.9——损失约 20",
      "start": 62.102,
      "end": 65.126
    },
    {
      "id": "shot04-31",
      "text": "倍。",
      "start": 65.126,
      "end": 65.507
    },
    {
      "id": "shot04-32",
      "text": "这就是 MSE 衡量'好不好'的样子：",
      "start": 65.507,
      "end": 68.451
    },
    {
      "id": "shot04-33",
      "text": "方块大就是损失大就是拟合差。",
      "start": 68.451,
      "end": 70.794
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "切到镜头 B 看 L(k) 切片：",
      "start": 0.0,
      "end": 2.261
    },
    {
      "id": "shot05-1",
      "text": "这是固定 b 等于当前值时 loss 随",
      "start": 2.261,
      "end": 5.262
    },
    {
      "id": "shot05-2",
      "text": "k 变化的曲线——一条蓝色抛物线。",
      "start": 5.262,
      "end": 8.244
    },
    {
      "id": "shot05-3",
      "text": "红点是当前 k 在抛物线上的位置，",
      "start": 8.244,
      "end": 11.405
    },
    {
      "id": "shot05-4",
      "text": "绿钻是抛物线最低点，",
      "start": 11.405,
      "end": 13.566
    },
    {
      "id": "shot05-5",
      "text": "也就是这个 b 下的最优 k。",
      "start": 13.566,
      "end": 15.627
    },
    {
      "id": "shot05-6",
      "text": "把 k 拖动，",
      "start": 15.627,
      "end": 16.767
    },
    {
      "id": "shot05-7",
      "text": "红点沿抛物线滑动；",
      "start": 16.767,
      "end": 18.989
    },
    {
      "id": "shot05-8",
      "text": "红点越靠近绿钻，",
      "start": 18.989,
      "end": 20.755
    },
    {
      "id": "shot05-9",
      "text": "红线在数据图上越贴合，",
      "start": 20.755,
      "end": 22.882
    },
    {
      "id": "shot05-10",
      "text": "MSE 越小。",
      "start": 22.882,
      "end": 24.307
    },
    {
      "id": "shot05-11",
      "text": "这就是 LR 的核心几何：",
      "start": 24.307,
      "end": 26.595
    },
    {
      "id": "shot05-12",
      "text": "损失函数是关于参数的二次曲面，",
      "start": 26.595,
      "end": 29.665
    },
    {
      "id": "shot05-13",
      "text": "找最优等于找抛物线底。",
      "start": 29.665,
      "end": 31.531
    },
    {
      "id": "shot05-14",
      "text": "再切镜头 C 看 L(b) 切片：",
      "start": 31.998,
      "end": 34.241
    },
    {
      "id": "shot05-15",
      "text": "固定 k 后 b 也是抛物线，结构对称。",
      "start": 34.241,
      "end": 36.864
    },
    {
      "id": "shot05-16",
      "text": "最后镜头 D 双抛物线并排——k 方向有",
      "start": 36.864,
      "end": 39.688
    },
    {
      "id": "shot05-17",
      "text": "底、",
      "start": 39.688,
      "end": 39.908
    },
    {
      "id": "shot05-18",
      "text": "b 方向也有底，",
      "start": 39.908,
      "end": 41.23
    },
    {
      "id": "shot05-19",
      "text": "碗底就是同时让两条抛物线都到底，",
      "start": 41.23,
      "end": 44.273
    },
    {
      "id": "shot05-20",
      "text": "对应数据图上红线跟绿虚线完全重合。",
      "start": 44.273,
      "end": 47.918
    },
    {
      "id": "shot05-21",
      "text": "这就是损失函数最小化的全部画面：找碗底。",
      "start": 47.918,
      "end": 51.543
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "看完直观再回到 e01 那个例子——小明",
      "start": 0.0,
      "end": 2.765
    },
    {
      "id": "shot06-1",
      "text": "176 厘米猜体重，",
      "start": 2.765,
      "end": 4.389
    },
    {
      "id": "shot06-2",
      "text": "5 个身高体重点：",
      "start": 4.389,
      "end": 5.952
    },
    {
      "id": "shot06-3",
      "text": "160 / 166 / 172 / 174 / 180 厘米，对应 56.3 / 60.6 / 65.1 / 68.5 / 75 公斤。",
      "start": 5.952,
      "end": 13.787
    },
    {
      "id": "shot06-7",
      "text": "这一段把那个例子的数字钉死，",
      "start": 13.787,
      "end": 16.232
    },
    {
      "id": "shot06-8",
      "text": "手算最优 k。",
      "start": 16.232,
      "end": 17.534
    },
    {
      "id": "shot06-9",
      "text": "用一个小技巧简化推导：",
      "start": 17.534,
      "end": 19.498
    },
    {
      "id": "shot06-10",
      "text": "固定 b 等于负 100，",
      "start": 19.498,
      "end": 21.061
    },
    {
      "id": "shot06-11",
      "text": "让损失只剩 k 一个变量。",
      "start": 21.061,
      "end": 22.925
    },
    {
      "id": "shot06-12",
      "text": "代入 5 个点的平方和展开合并——k 平",
      "start": 23.289,
      "end": 26.471
    },
    {
      "id": "shot06-13",
      "text": "方系数是 5 个 x 的平方相加",
      "start": 26.471,
      "end": 29.133
    },
    {
      "id": "shot06-14",
      "text": "145416；",
      "start": 29.353,
      "end": 30.554
    },
    {
      "id": "shot06-15",
      "text": "k 一次项系数 281767.6；",
      "start": 30.554,
      "end": 33.476
    },
    {
      "id": "shot06-16",
      "text": "常数项 136497.31。",
      "start": 33.476,
      "end": 36.298
    },
    {
      "id": "shot06-17",
      "text": "整个 L(k) 等于 145416 k",
      "start": 36.298,
      "end": 39.521
    },
    {
      "id": "shot06-18",
      "text": "平方 减 281767.6 k 加",
      "start": 39.521,
      "end": 42.383
    },
    {
      "id": "shot06-19",
      "text": "136497.31——抛物线方程。",
      "start": 42.503,
      "end": 45.655
    },
    {
      "id": "shot06-20",
      "text": "一元二次顶点公式 k* = -b / 2a，",
      "start": 45.655,
      "end": 49.613
    },
    {
      "id": "shot06-22",
      "text": "代入 281767.6 除以 2 乘",
      "start": 49.613,
      "end": 52.888
    },
    {
      "id": "shot06-23",
      "text": "145416，",
      "start": 52.888,
      "end": 54.194
    },
    {
      "id": "shot06-24",
      "text": "约等于 0.9688。",
      "start": 54.194,
      "end": 55.66
    },
    {
      "id": "shot06-25",
      "text": "这就是固定 b 等于负 100 时损失最",
      "start": 56.045,
      "end": 58.712
    },
    {
      "id": "shot06-26",
      "text": "小的 k。代回预测：",
      "start": 58.712,
      "end": 60.476
    },
    {
      "id": "shot06-27",
      "text": "0.9688 × 176 − 100 = 70.515 公斤。",
      "start": 60.476,
      "end": 64.987
    },
    {
      "id": "shot06-29",
      "text": "对比上期 sklearn 不固定 b 自",
      "start": 64.987,
      "end": 67.052
    },
    {
      "id": "shot06-30",
      "text": "动算出的 70.30——约束不同，",
      "start": 67.052,
      "end": 69.318
    },
    {
      "id": "shot06-31",
      "text": "结论一致：",
      "start": 69.318,
      "end": 70.26
    },
    {
      "id": "shot06-32",
      "text": "损失最小化下都指向约 70 公斤。",
      "start": 70.26,
      "end": 72.646
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.842
    },
    {
      "id": "shot07-1",
      "text": "我们解决了 LR 黑盒的三件事：第一，",
      "start": 0.842,
      "end": 3.889
    },
    {
      "id": "shot07-2",
      "text": "误差是单点偏差，",
      "start": 3.889,
      "end": 5.432
    },
    {
      "id": "shot07-3",
      "text": "损失是整条线打分；第二，",
      "start": 5.432,
      "end": 7.397
    },
    {
      "id": "shot07-4",
      "text": "MSE 是均方误差，",
      "start": 7.397,
      "end": 9.281
    },
    {
      "id": "shot07-5",
      "text": "平方而非绝对值是为了可导加重罚大误差；",
      "start": 9.281,
      "end": 12.869
    },
    {
      "id": "shot07-6",
      "text": "第三，",
      "start": 12.869,
      "end": 13.33
    },
    {
      "id": "shot07-7",
      "text": "损失最小化就是找抛物线底，",
      "start": 13.33,
      "end": 15.623
    },
    {
      "id": "shot07-8",
      "text": "5 点案例算出 k 约 0.97。",
      "start": 15.623,
      "end": 17.741
    },
    {
      "id": "shot07-9",
      "text": "点到没展开的：",
      "start": 18.126,
      "end": 19.187
    },
    {
      "id": "shot07-10",
      "text": "MAE 抗异常值更好但没闭式解，",
      "start": 19.187,
      "end": 22.09
    },
    {
      "id": "shot07-11",
      "text": "留给后面评估那一期；",
      "start": 22.09,
      "end": 23.691
    },
    {
      "id": "shot07-12",
      "text": "MSE / RMSE / SSE 三者区别也留给评估那一期；",
      "start": 23.691,
      "end": 28.716
    },
    {
      "id": "shot07-14",
      "text": "3D 碗形等高线在偏导那一期具象化；",
      "start": 28.716,
      "end": 32.139
    },
    {
      "id": "shot07-15",
      "text": "过拟合 / Loss=0 不等于好模型留",
      "start": 32.139,
      "end": 35.081
    },
    {
      "id": "shot07-16",
      "text": "给过拟合那一期。",
      "start": 35.081,
      "end": 36.863
    },
    {
      "id": "shot07-17",
      "text": "下一期我们补齐数学家伙事：导数、偏导、",
      "start": 36.863,
      "end": 40.386
    },
    {
      "id": "shot07-18",
      "text": "向量、",
      "start": 40.386,
      "end": 40.887
    },
    {
      "id": "shot07-19",
      "text": "矩阵——抛物线底的数学翻译是导数等于零，",
      "start": 40.887,
      "end": 44.15
    },
    {
      "id": "shot07-20",
      "text": "这把钥匙握上才能打开正规方程。",
      "start": 44.15,
      "end": 46.392
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.766
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.766,
      "end": 2.257
    }
  ],
  "shot09": [
    {
      "id": "shot09-0",
      "text": "进 demo 前，",
      "start": 0.0,
      "end": 0.841
    },
    {
      "id": "shot09-1",
      "text": "先把刚才的 MSE 压成一个看图任务。",
      "start": 0.841,
      "end": 3.826
    },
    {
      "id": "shot09-2",
      "text": "你不用先记公式，",
      "start": 3.826,
      "end": 5.087
    },
    {
      "id": "shot09-3",
      "text": "也不用先管什么可导、闭式解，",
      "start": 5.087,
      "end": 7.371
    },
    {
      "id": "shot09-4",
      "text": "只看三样东西。第一，",
      "start": 7.371,
      "end": 9.234
    },
    {
      "id": "shot09-5",
      "text": "蓝点是真实样本，",
      "start": 9.234,
      "end": 10.736
    },
    {
      "id": "shot09-6",
      "text": "红线是当前候选直线。第二，",
      "start": 10.736,
      "end": 13.48
    },
    {
      "id": "shot09-7",
      "text": "每个红方块就是这一点的误差平方，",
      "start": 13.48,
      "end": 16.424
    },
    {
      "id": "shot09-8",
      "text": "方块越大，",
      "start": 16.424,
      "end": 17.227
    },
    {
      "id": "shot09-9",
      "text": "说明这个点被猜得越离谱。第三，",
      "start": 17.227,
      "end": 19.855
    },
    {
      "id": "shot09-10",
      "text": "底部 MSE 就是这些红方块的平均分，",
      "start": 19.855,
      "end": 23.086
    },
    {
      "id": "shot09-11",
      "text": "分数越低，",
      "start": 23.086,
      "end": 24.009
    },
    {
      "id": "shot09-12",
      "text": "直线越好。",
      "start": 24.009,
      "end": 25.253
    },
    {
      "id": "shot09-13",
      "text": "等会儿看到绿色虚线，",
      "start": 25.253,
      "end": 26.898
    },
    {
      "id": "shot09-14",
      "text": "先把它理解成算法算出来的最低分直线，",
      "start": 26.898,
      "end": 29.988
    },
    {
      "id": "shot09-15",
      "text": "不用急着管它怎么求出来。",
      "start": 29.988,
      "end": 31.593
    },
    {
      "id": "shot09-16",
      "text": "接下来拖 k 和 b，",
      "start": 32.099,
      "end": 33.628
    },
    {
      "id": "shot09-17",
      "text": "本质上就是在试不同红线，",
      "start": 33.628,
      "end": 35.781
    },
    {
      "id": "shot09-18",
      "text": "看红方块总面积怎么变。",
      "start": 35.781,
      "end": 37.712
    }
  ],
  "shot10": [
    {
      "id": "shot10-0",
      "text": "刚才镜头 A 看的是数据图：",
      "start": 0.0,
      "end": 2.302
    },
    {
      "id": "shot10-1",
      "text": "线贴不贴点，",
      "start": 2.302,
      "end": 3.323
    },
    {
      "id": "shot10-2",
      "text": "方块大不大。",
      "start": 3.323,
      "end": 4.384
    },
    {
      "id": "shot10-3",
      "text": "接下来切到抛物线镜头，",
      "start": 4.384,
      "end": 6.366
    },
    {
      "id": "shot10-4",
      "text": "视角换一下：",
      "start": 6.366,
      "end": 7.347
    },
    {
      "id": "shot10-5",
      "text": "不看 x 和 y 的散点了，",
      "start": 7.347,
      "end": 9.289
    },
    {
      "id": "shot10-6",
      "text": "改看参数和损失分数的关系。",
      "start": 9.289,
      "end": 11.732
    },
    {
      "id": "shot10-7",
      "text": "横轴是 k 的候选值，",
      "start": 11.732,
      "end": 13.473
    },
    {
      "id": "shot10-8",
      "text": "纵轴是这个 k 对应的 MSE 分数。",
      "start": 13.473,
      "end": 16.757
    },
    {
      "id": "shot10-9",
      "text": "固定 b 的意思也很简单：",
      "start": 16.757,
      "end": 18.498
    },
    {
      "id": "shot10-10",
      "text": "先把 b 暂时按住不动，",
      "start": 18.498,
      "end": 20.4
    },
    {
      "id": "shot10-11",
      "text": "只转 k 这一个旋钮，",
      "start": 20.4,
      "end": 22.002
    },
    {
      "id": "shot10-12",
      "text": "看看分数怎么变。",
      "start": 22.002,
      "end": 23.263
    },
    {
      "id": "shot10-13",
      "text": "于是每一个 k 都会对应一个分数，",
      "start": 23.263,
      "end": 25.725
    },
    {
      "id": "shot10-14",
      "text": "连起来就是一条曲线。",
      "start": 25.725,
      "end": 27.067
    },
    {
      "id": "shot10-15",
      "text": "曲线最低的地方，",
      "start": 27.497,
      "end": 28.842
    },
    {
      "id": "shot10-16",
      "text": "就是在当前 b 不动的前提下，",
      "start": 28.842,
      "end": 31.049
    },
    {
      "id": "shot10-17",
      "text": "最好的 k。",
      "start": 31.049,
      "end": 32.012
    },
    {
      "id": "shot10-18",
      "text": "你只需要抓住这句话：参数变，",
      "start": 32.012,
      "end": 34.4
    },
    {
      "id": "shot10-19",
      "text": "损失分数也变；",
      "start": 34.4,
      "end": 35.825
    },
    {
      "id": "shot10-20",
      "text": "找最优参数，",
      "start": 35.825,
      "end": 37.009
    },
    {
      "id": "shot10-21",
      "text": "就是找分数最低点。",
      "start": 37.009,
      "end": 38.413
    }
  ],
  "shot11": [
    {
      "id": "shot11-0",
      "text": "进入手算前，",
      "start": 0.0,
      "end": 1.121
    },
    {
      "id": "shot11-1",
      "text": "先说清楚：",
      "start": 1.121,
      "end": 2.241
    },
    {
      "id": "shot11-2",
      "text": "下面那串大数字不是要背的，",
      "start": 2.241,
      "end": 4.403
    },
    {
      "id": "shot11-3",
      "text": "重点只有三步。第一步，",
      "start": 4.403,
      "end": 6.344
    },
    {
      "id": "shot11-4",
      "text": "为了把问题变简单，",
      "start": 6.344,
      "end": 7.945
    },
    {
      "id": "shot11-5",
      "text": "先把截距 b 固定成负 100，",
      "start": 7.945,
      "end": 10.386
    },
    {
      "id": "shot11-6",
      "text": "只剩 k 一个未知数。第二步，",
      "start": 10.386,
      "end": 12.947
    },
    {
      "id": "shot11-7",
      "text": "把 5 个点的误差平方加起来，",
      "start": 12.947,
      "end": 15.489
    },
    {
      "id": "shot11-8",
      "text": "整理后会变成一个关于 k 的二次函数，",
      "start": 15.489,
      "end": 18.711
    },
    {
      "id": "shot11-9",
      "text": "也就是刚才看到的抛物线。第三步，",
      "start": 18.711,
      "end": 21.692
    },
    {
      "id": "shot11-10",
      "text": "用抛物线最低点公式找到最小分数对应的 k。",
      "start": 21.692,
      "end": 25.735
    },
    {
      "id": "shot11-11",
      "text": "这里公式里的 A、B、",
      "start": 25.735,
      "end": 27.196
    },
    {
      "id": "shot11-12",
      "text": "C 只是二次函数的三个系数，",
      "start": 27.196,
      "end": 29.798
    },
    {
      "id": "shot11-13",
      "text": "别和线性回归里的截距 b 混在一起。",
      "start": 29.798,
      "end": 32.819
    },
    {
      "id": "shot11-14",
      "text": "你看动画时只要盯住主线：固定 b，",
      "start": 33.04,
      "end": 36.041
    },
    {
      "id": "shot11-15",
      "text": "展开成抛物线，找最低点，",
      "start": 36.041,
      "end": 38.378
    },
    {
      "id": "shot11-16",
      "text": "代回预测小明体重。",
      "start": 38.378,
      "end": 39.606
    }
  ]
}
