{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们用 sklearn 三件套把",
      "start": 0.0,
      "end": 2.44
    },
    {
      "id": "shot01-1",
      "text": "KNN 回归跑通了。",
      "start": 2.44,
      "end": 4.2
    },
    {
      "id": "shot01-2",
      "text": "这一期我们回到 KNN 最核心的那个零件：距离。",
      "start": 4.2,
      "end": 7.72
    },
    {
      "id": "shot01-3",
      "text": "前面一直在用欧氏距离，",
      "start": 7.72,
      "end": 9.98
    },
    {
      "id": "shot01-4",
      "text": "也就是直线距离。",
      "start": 9.98,
      "end": 11.62
    },
    {
      "id": "shot01-5",
      "text": "我们注意到，",
      "start": 11.62,
      "end": 13.08
    },
    {
      "id": "shot01-6",
      "text": "sklearn 写的不是欧氏，",
      "start": 13.08,
      "end": 15.56
    },
    {
      "id": "shot01-7",
      "text": "而是一个叫闵可夫斯基的参数。",
      "start": 15.56,
      "end": 17.82
    },
    {
      "id": "shot01-8",
      "text": "这一期我们把 KNN 里能用的 4 种距",
      "start": 17.82,
      "end": 20.88
    },
    {
      "id": "shot01-9",
      "text": "离同台展示：欧氏、曼哈顿、切比雪夫、",
      "start": 20.88,
      "end": 24.865
    },
    {
      "id": "shot01-10",
      "text": "闵可夫斯基。",
      "start": 24.865,
      "end": 26.4
    },
    {
      "id": "shot01-11",
      "text": "看清它们的几何形状，",
      "start": 26.4,
      "end": 28.46
    },
    {
      "id": "shot01-12",
      "text": "搞懂为什么 sklearn 用的其实是同",
      "start": 28.46,
      "end": 31.02
    },
    {
      "id": "shot01-13",
      "text": "一个公式族。",
      "start": 31.02,
      "end": 31.88
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先把欧氏距离 Euclidean",
      "start": 0.0,
      "end": 2.06
    },
    {
      "id": "shot02-1",
      "text": "distance 拎回来，",
      "start": 2.06,
      "end": 3.6
    },
    {
      "id": "shot02-2",
      "text": "第 1 期讲过——勾股定理的 N 维推广，",
      "start": 3.6,
      "end": 6.86
    },
    {
      "id": "shot02-3",
      "text": "每个维度差平方求和再开方。",
      "start": 6.86,
      "end": 10.04
    },
    {
      "id": "shot02-4",
      "text": "几何上就是两点之间拉一根直线。",
      "start": 10.04,
      "end": 12.8
    },
    {
      "id": "shot02-5",
      "text": "延续第 1 期的豆瓣两点，",
      "start": 12.8,
      "end": 15.16
    },
    {
      "id": "shot02-6",
      "text": "流浪地球 3 是 8.5 和 9.5，",
      "start": 15.16,
      "end": 17.94
    },
    {
      "id": "shot02-7",
      "text": "流浪地球 2 是 8.4 和 9.0，",
      "start": 17.94,
      "end": 20.84
    },
    {
      "id": "shot02-8",
      "text": "欧氏距离约等于 0.51。",
      "start": 20.84,
      "end": 23.38
    },
    {
      "id": "shot02-9",
      "text": "这把尺子是 KNN 的默认选项——",
      "start": 23.38,
      "end": 25.56
    },
    {
      "id": "shot02-10",
      "text": "sklearn 不指定的话用的就是它，",
      "start": 25.56,
      "end": 28.3
    },
    {
      "id": "shot02-11",
      "text": "绝大多数场景用它就够。",
      "start": 28.3,
      "end": 30.14
    },
    {
      "id": "shot02-12",
      "text": "它的适用条件是两个：",
      "start": 30.544,
      "end": 31.984
    },
    {
      "id": "shot02-13",
      "text": "所有特征量纲对齐，",
      "start": 31.984,
      "end": 33.864
    },
    {
      "id": "shot02-14",
      "text": "每个维度同等重要。",
      "start": 33.864,
      "end": 35.624
    },
    {
      "id": "shot02-15",
      "text": "这两个条件下两期会回到。",
      "start": 35.624,
      "end": 37.784
    },
    {
      "id": "shot02-16",
      "text": "我们把欧氏当作起点，",
      "start": 37.784,
      "end": 39.784
    },
    {
      "id": "shot02-17",
      "text": "看它的三个兄弟分别在哪些方面跟它不一样。",
      "start": 39.784,
      "end": 43.064
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "第二个登场，",
      "start": 0.0,
      "end": 1.08
    },
    {
      "id": "shot03-1",
      "text": "曼哈顿距离 Manhattan",
      "start": 1.08,
      "end": 2.706
    },
    {
      "id": "shot03-2",
      "text": "distance。",
      "start": 2.706,
      "end": 3.36
    },
    {
      "id": "shot03-3",
      "text": "想象你在曼哈顿打车，",
      "start": 3.36,
      "end": 5.6
    },
    {
      "id": "shot03-4",
      "text": "城市是网格街区，",
      "start": 5.6,
      "end": 7.32
    },
    {
      "id": "shot03-5",
      "text": "司机不能斜着穿楼房——他只能横走 N 米",
      "start": 7.32,
      "end": 10.6
    },
    {
      "id": "shot03-6",
      "text": "再竖走 M 米。",
      "start": 10.6,
      "end": 12.46
    },
    {
      "id": "shot03-7",
      "text": "所以曼哈顿距离的公式就是各维度差的绝对值",
      "start": 12.46,
      "end": 16.04
    },
    {
      "id": "shot03-8",
      "text": "直接相加，",
      "start": 16.04,
      "end": 17.18
    },
    {
      "id": "shot03-9",
      "text": "没有平方，没有开方。",
      "start": 17.18,
      "end": 19.1
    },
    {
      "id": "shot03-10",
      "text": "还是豆瓣那两点，",
      "start": 19.1,
      "end": 20.78
    },
    {
      "id": "shot03-11",
      "text": "8.5 和 8.4 差 0.1，",
      "start": 20.78,
      "end": 23.08
    },
    {
      "id": "shot03-12",
      "text": "9.5 和 9.0 差 0.5，",
      "start": 23.08,
      "end": 25.78
    },
    {
      "id": "shot03-13",
      "text": "曼哈顿距离 0.6——比欧氏的 0.51长一点，",
      "start": 25.78,
      "end": 29.36
    },
    {
      "id": "shot03-14",
      "text": "因为按网格走比直线远。",
      "start": 29.36,
      "end": 31.64
    },
    {
      "id": "shot03-15",
      "text": "这把尺子有个别名，",
      "start": 32.019,
      "end": 33.459
    },
    {
      "id": "shot03-16",
      "text": "叫 L1 距离。",
      "start": 33.459,
      "end": 35.259
    },
    {
      "id": "shot03-17",
      "text": "它有一个直接的好处：",
      "start": 35.259,
      "end": 36.839
    },
    {
      "id": "shot03-18",
      "text": "因为不平方，",
      "start": 36.839,
      "end": 38.179
    },
    {
      "id": "shot03-19",
      "text": "单个维度的大差距不会被放大。换句话说，",
      "start": 38.179,
      "end": 41.659
    },
    {
      "id": "shot03-20",
      "text": "它对异常值更稳。",
      "start": 41.659,
      "end": 43.619
    },
    {
      "id": "shot03-21",
      "text": "在两类场景下它比欧氏好用：",
      "start": 43.619,
      "end": 46.259
    },
    {
      "id": "shot03-22",
      "text": "一是特征独立、",
      "start": 46.259,
      "end": 47.719
    },
    {
      "id": "shot03-23",
      "text": "各自表达不同物理量的时候，",
      "start": 47.719,
      "end": 49.959
    },
    {
      "id": "shot03-24",
      "text": "比如年龄加上收入；",
      "start": 49.959,
      "end": 52.179
    },
    {
      "id": "shot03-25",
      "text": "二是稀疏数据——比如统计每个词出现次数的向量，",
      "start": 52.179,
      "end": 56.619
    },
    {
      "id": "shot03-26",
      "text": "绝大多数位置是 0，",
      "start": 56.619,
      "end": 58.079
    },
    {
      "id": "shot03-27",
      "text": "这种文本词频向量上，",
      "start": 58.079,
      "end": 60.239
    },
    {
      "id": "shot03-28",
      "text": "曼哈顿对那些非 0 一边的微小差异更敏感。",
      "start": 60.239,
      "end": 63.699
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "第三个，",
      "start": 0.0,
      "end": 0.58
    },
    {
      "id": "shot04-1",
      "text": "切比雪夫距离 Chebyshev",
      "start": 0.58,
      "end": 2.5
    },
    {
      "id": "shot04-2",
      "text": "distance。",
      "start": 2.5,
      "end": 3.3
    },
    {
      "id": "shot04-3",
      "text": "这个比较少见，",
      "start": 3.3,
      "end": 4.34
    },
    {
      "id": "shot04-4",
      "text": "但形态最有意思。",
      "start": 4.34,
      "end": 6.0
    },
    {
      "id": "shot04-5",
      "text": "想象国际象棋的国王，",
      "start": 6.0,
      "end": 7.76
    },
    {
      "id": "shot04-6",
      "text": "每步可以走 8 个方向——横、竖、斜都行。",
      "start": 7.76,
      "end": 11.1
    },
    {
      "id": "shot04-7",
      "text": "从一个格子走到另一个格子，",
      "start": 11.1,
      "end": 13.34
    },
    {
      "id": "shot04-8",
      "text": "国王最少需要几步？",
      "start": 13.34,
      "end": 15.26
    },
    {
      "id": "shot04-9",
      "text": "答案是横向距离和纵向距离两个里面取最大的那个。",
      "start": 15.26,
      "end": 19.14
    },
    {
      "id": "shot04-10",
      "text": "因为对角走的时候，",
      "start": 19.14,
      "end": 20.58
    },
    {
      "id": "shot04-11",
      "text": "横和竖同时缩，",
      "start": 20.58,
      "end": 22.0
    },
    {
      "id": "shot04-12",
      "text": "所以瓶颈在最长的那一边。",
      "start": 22.0,
      "end": 24.44
    },
    {
      "id": "shot04-13",
      "text": "切比雪夫的公式就是这个直觉：",
      "start": 24.44,
      "end": 26.8
    },
    {
      "id": "shot04-14",
      "text": "所有维度差里面，取最大值。",
      "start": 26.8,
      "end": 29.14
    },
    {
      "id": "shot04-15",
      "text": "豆瓣两点的横差 0.1、",
      "start": 29.546,
      "end": 31.626
    },
    {
      "id": "shot04-16",
      "text": "竖差 0.5，",
      "start": 31.626,
      "end": 32.586
    },
    {
      "id": "shot04-17",
      "text": "切比雪夫距离就是 0.5——比欧氏和曼哈顿都短。",
      "start": 32.586,
      "end": 36.446
    },
    {
      "id": "shot04-18",
      "text": "它有个别名叫 L 无穷。",
      "start": 36.446,
      "end": 38.406
    },
    {
      "id": "shot04-19",
      "text": "它的判断逻辑很直接：",
      "start": 38.406,
      "end": 40.166
    },
    {
      "id": "shot04-20",
      "text": "两个点像不像，",
      "start": 40.166,
      "end": 41.246
    },
    {
      "id": "shot04-21",
      "text": "只看差距最大的那个维度，",
      "start": 41.246,
      "end": 43.426
    },
    {
      "id": "shot04-22",
      "text": "其他维度根本不算。",
      "start": 43.426,
      "end": 45.086
    },
    {
      "id": "shot04-23",
      "text": "少数应用场景，",
      "start": 45.086,
      "end": 46.546
    },
    {
      "id": "shot04-24",
      "text": "比如颜色相似度看 RGB 三通道里差最大",
      "start": 46.546,
      "end": 49.426
    },
    {
      "id": "shot04-25",
      "text": "的那一通道，",
      "start": 49.426,
      "end": 50.126
    },
    {
      "id": "shot04-26",
      "text": "或者仓储货架坐标。",
      "start": 50.126,
      "end": 51.706
    },
    {
      "id": "shot04-27",
      "text": "日常 KNN 工业用得很少，",
      "start": 51.706,
      "end": 53.986
    },
    {
      "id": "shot04-28",
      "text": "知道它存在就行。",
      "start": 53.986,
      "end": 55.146
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "第四个，",
      "start": 0.0,
      "end": 0.775
    },
    {
      "id": "shot05-1",
      "text": "闵可夫斯基距离 Minkowski",
      "start": 0.775,
      "end": 2.82
    },
    {
      "id": "shot05-2",
      "text": "distance。",
      "start": 2.82,
      "end": 3.7
    },
    {
      "id": "shot05-3",
      "text": "它不是新的第四种距离，",
      "start": 3.7,
      "end": 5.9
    },
    {
      "id": "shot05-4",
      "text": "它是前面三种的统一版本。公式形态：",
      "start": 5.9,
      "end": 9.34
    },
    {
      "id": "shot05-5",
      "text": "每个维度差的绝对值取 p 次方，求和，",
      "start": 9.34,
      "end": 12.84
    },
    {
      "id": "shot05-6",
      "text": "再开 p 次方根。",
      "start": 12.84,
      "end": 14.18
    },
    {
      "id": "shot05-7",
      "text": "一个参数 p，",
      "start": 14.18,
      "end": 15.5
    },
    {
      "id": "shot05-8",
      "text": "控制公式形态。",
      "start": 15.5,
      "end": 17.12
    },
    {
      "id": "shot05-9",
      "text": "p 等于 1 的时候，",
      "start": 17.12,
      "end": 18.34
    },
    {
      "id": "shot05-10",
      "text": "没有平方也没开方，",
      "start": 18.34,
      "end": 20.5
    },
    {
      "id": "shot05-11",
      "text": "退化成曼哈顿。",
      "start": 20.5,
      "end": 21.8
    },
    {
      "id": "shot05-12",
      "text": "p 等于 2 的时候，",
      "start": 21.8,
      "end": 23.06
    },
    {
      "id": "shot05-13",
      "text": "就是平方求和再开根号，",
      "start": 23.06,
      "end": 25.32
    },
    {
      "id": "shot05-14",
      "text": "退化成欧氏。",
      "start": 25.32,
      "end": 26.6
    },
    {
      "id": "shot05-15",
      "text": "p 趋于无穷大的时候，",
      "start": 27.058,
      "end": 29.058
    },
    {
      "id": "shot05-16",
      "text": "求和会被最大那一项主导，",
      "start": 29.058,
      "end": 31.078
    },
    {
      "id": "shot05-17",
      "text": "开极大次根号又把其他项压平，",
      "start": 31.078,
      "end": 34.298
    },
    {
      "id": "shot05-18",
      "text": "退化成切比雪夫。一个公式，",
      "start": 34.298,
      "end": 36.358
    },
    {
      "id": "shot05-19",
      "text": "三种距离。",
      "start": 36.358,
      "end": 38.018
    },
    {
      "id": "shot05-20",
      "text": "这就是为什么 sklearn 的 KNN",
      "start": 38.018,
      "end": 40.318
    },
    {
      "id": "shot05-21",
      "text": "默认参数写的是闵可夫斯基 p 等于 2",
      "start": 40.318,
      "end": 42.998
    },
    {
      "id": "shot05-22",
      "text": "——sklearn 接口名是闵可夫斯基，",
      "start": 42.998,
      "end": 45.298
    },
    {
      "id": "shot05-23",
      "text": "p 等于 2 退化成欧氏。",
      "start": 45.298,
      "end": 47.498
    },
    {
      "id": "shot05-24",
      "text": "改 p 等于 1 就变曼哈顿，",
      "start": 47.498,
      "end": 49.398
    },
    {
      "id": "shot05-25",
      "text": "改 p 等于无穷大就变切比雪夫。",
      "start": 49.398,
      "end": 52.158
    },
    {
      "id": "shot05-26",
      "text": "所以工程上不用记 4 个名字，",
      "start": 52.158,
      "end": 54.358
    },
    {
      "id": "shot05-27",
      "text": "记一个公式族 + 一个 p 参数就够。",
      "start": 54.358,
      "end": 56.686
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "光看公式不直观，",
      "start": 0.0,
      "end": 1.72
    },
    {
      "id": "shot06-1",
      "text": "打开一个 marimo 互动 demo。",
      "start": 1.72,
      "end": 3.88
    },
    {
      "id": "shot06-2",
      "text": "屏幕分上下两块。",
      "start": 3.88,
      "end": 5.58
    },
    {
      "id": "shot06-3",
      "text": "上半左边是距离路径图：A 红圆、B 蓝圆，",
      "start": 5.58,
      "end": 9.927
    },
    {
      "id": "shot06-4",
      "text": "3 条彩色路径——紫色 L 形是曼哈顿、",
      "start": 9.927,
      "end": 13.66
    },
    {
      "id": "shot06-5",
      "text": "绿色直线是欧氏、",
      "start": 13.66,
      "end": 15.52
    },
    {
      "id": "shot06-6",
      "text": "红虚带对角是切比雪夫。",
      "start": 15.52,
      "end": 17.58
    },
    {
      "id": "shot06-7",
      "text": "上半右边是等距线图：",
      "start": 17.58,
      "end": 20.72
    },
    {
      "id": "shot06-8",
      "text": "以 A 为圆心、",
      "start": 20.72,
      "end": 21.82
    },
    {
      "id": "shot06-9",
      "text": "距离等于当前 p 的所有点连成的轨迹。",
      "start": 21.82,
      "end": 24.82
    },
    {
      "id": "shot06-10",
      "text": "中间一张实时数字卡片，",
      "start": 24.82,
      "end": 27.473
    },
    {
      "id": "shot06-11",
      "text": "4 个距离同时算出来。",
      "start": 27.473,
      "end": 29.32
    },
    {
      "id": "shot06-12",
      "text": "把 A 和 B 拖到豆瓣那两个点，",
      "start": 29.32,
      "end": 31.74
    },
    {
      "id": "shot06-13",
      "text": "A 是 8.5 和 9.5，",
      "start": 31.74,
      "end": 34.32
    },
    {
      "id": "shot06-14",
      "text": "B 是 8.4 和 9.0。",
      "start": 34.32,
      "end": 36.04
    },
    {
      "id": "shot06-15",
      "text": "看实时卡：",
      "start": 36.665,
      "end": 37.665
    },
    {
      "id": "shot06-16",
      "text": "曼哈顿 0.60、",
      "start": 37.665,
      "end": 38.885
    },
    {
      "id": "shot06-17",
      "text": "欧氏 0.51、",
      "start": 38.885,
      "end": 40.145
    },
    {
      "id": "shot06-18",
      "text": "切比雪夫 0.50。",
      "start": 40.145,
      "end": 42.105
    },
    {
      "id": "shot06-19",
      "text": "闵可夫斯基这时 p 默认 2，",
      "start": 42.105,
      "end": 44.845
    },
    {
      "id": "shot06-20",
      "text": "等于欧氏 0.51。",
      "start": 44.845,
      "end": 46.825
    },
    {
      "id": "shot06-21",
      "text": "现在拖 p 滑块。",
      "start": 46.825,
      "end": 48.085
    },
    {
      "id": "shot06-22",
      "text": "p 拖到 1，",
      "start": 48.085,
      "end": 49.045
    },
    {
      "id": "shot06-23",
      "text": "等距线从圆变成菱形，",
      "start": 49.045,
      "end": 51.7
    },
    {
      "id": "shot06-24",
      "text": "闵可夫斯基跳到 0.60，",
      "start": 51.7,
      "end": 54.065
    },
    {
      "id": "shot06-25",
      "text": "标注约等于曼哈顿。",
      "start": 54.065,
      "end": 56.145
    },
    {
      "id": "shot06-26",
      "text": "p 拖到 10，",
      "start": 56.145,
      "end": 57.325
    },
    {
      "id": "shot06-27",
      "text": "等距线变成接近正方形，",
      "start": 57.325,
      "end": 59.655
    },
    {
      "id": "shot06-28",
      "text": "闵可夫斯基稳定在 0.50，",
      "start": 59.655,
      "end": 62.305
    },
    {
      "id": "shot06-29",
      "text": "标注变成趋于切比雪夫。",
      "start": 62.305,
      "end": 64.365
    },
    {
      "id": "shot06-30",
      "text": "最后看屏幕底部演化全谱图，",
      "start": 64.814,
      "end": 67.574
    },
    {
      "id": "shot06-31",
      "text": "p 从 0.5 到 20 共 7 条曲线一字排开：星形、菱形、圆、圆角方、",
      "start": 67.574,
      "end": 73.354
    },
    {
      "id": "shot06-32",
      "text": "标准方——同一个公式，",
      "start": 73.354,
      "end": 75.054
    },
    {
      "id": "shot06-33",
      "text": "p 一变形态就变。",
      "start": 75.054,
      "end": 76.554
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "回到工程实战。",
      "start": 0.0,
      "end": 1.34
    },
    {
      "id": "shot07-1",
      "text": "sklearn 里改距离公式不用换函数名，",
      "start": 1.34,
      "end": 4.7
    },
    {
      "id": "shot07-2",
      "text": "只调一个 p 参数。",
      "start": 4.7,
      "end": 6.12
    },
    {
      "id": "shot07-3",
      "text": "KNeighborsClassifier",
      "start": 6.12,
      "end": 7.48
    },
    {
      "id": "shot07-4",
      "text": "构造时传 metric 等于",
      "start": 7.48,
      "end": 9.42
    },
    {
      "id": "shot07-5",
      "text": "minkowski，",
      "start": 9.42,
      "end": 10.38
    },
    {
      "id": "shot07-6",
      "text": "p 等于 2 是欧氏（也是默认值），",
      "start": 10.38,
      "end": 12.3
    },
    {
      "id": "shot07-7",
      "text": "p 等于 1 是曼哈顿。",
      "start": 12.3,
      "end": 14.02
    },
    {
      "id": "shot07-8",
      "text": "实际场景里 99% 用 p 等于 2。",
      "start": 14.02,
      "end": 17.32
    },
    {
      "id": "shot07-9",
      "text": "什么时候考虑改？三种情况。第一，",
      "start": 17.32,
      "end": 20.54
    },
    {
      "id": "shot07-10",
      "text": "特征明显独立、",
      "start": 20.54,
      "end": 21.86
    },
    {
      "id": "shot07-11",
      "text": "量纲不齐又没法标准化的时候，",
      "start": 21.86,
      "end": 24.24
    },
    {
      "id": "shot07-12",
      "text": "可以试 p 等于 1，",
      "start": 24.24,
      "end": 25.82
    },
    {
      "id": "shot07-13",
      "text": "不让大维度主导。",
      "start": 25.82,
      "end": 27.02
    },
    {
      "id": "shot07-14",
      "text": "第二，",
      "start": 27.389,
      "end": 28.029
    },
    {
      "id": "shot07-15",
      "text": "数据稀疏比如文本词频向量，",
      "start": 28.029,
      "end": 30.729
    },
    {
      "id": "shot07-16",
      "text": "p 等于 1 经验上更合身。第三，",
      "start": 30.729,
      "end": 33.729
    },
    {
      "id": "shot07-17",
      "text": "遇到不确定就把 p 当超参数交给后面的网",
      "start": 33.729,
      "end": 37.369
    },
    {
      "id": "shot07-18",
      "text": "格搜索 GridSearchCV——让它在 1、2、",
      "start": 37.369,
      "end": 40.435
    },
    {
      "id": "shot07-19",
      "text": "3 几个值里自己挑准确率最高的。",
      "start": 40.435,
      "end": 42.669
    },
    {
      "id": "shot07-20",
      "text": "这是后面第 5 节超参数搜索专章会展开的工具。",
      "start": 42.669,
      "end": 47.309
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.18
    },
    {
      "id": "shot08-1",
      "text": "我们讲清楚了三件事：",
      "start": 1.18,
      "end": 3.087
    },
    {
      "id": "shot08-2",
      "text": "4 种距离的几何直觉——欧氏直线、",
      "start": 3.087,
      "end": 6.34
    },
    {
      "id": "shot08-3",
      "text": "曼哈顿走街区、",
      "start": 6.34,
      "end": 7.7
    },
    {
      "id": "shot08-4",
      "text": "切比雪夫取最大、",
      "start": 7.7,
      "end": 8.992
    },
    {
      "id": "shot08-5",
      "text": "闵可夫斯基参数化大一统；",
      "start": 8.992,
      "end": 11.067
    },
    {
      "id": "shot08-6",
      "text": "闵可夫斯基怎么通过 p 参数把前三种统一起来；",
      "start": 11.067,
      "end": 15.12
    },
    {
      "id": "shot08-7",
      "text": "sklearn 工程上怎么用一个",
      "start": 15.12,
      "end": 17.3
    },
    {
      "id": "shot08-8",
      "text": "metric 加一个 p 来切换。",
      "start": 17.3,
      "end": 19.393
    },
    {
      "id": "shot08-9",
      "text": "点到没展开的：",
      "start": 19.593,
      "end": 20.863
    },
    {
      "id": "shot08-10",
      "text": "闵可夫斯基 p 小于 1 的伪距离形态—",
      "start": 20.863,
      "end": 23.573
    },
    {
      "id": "shot08-11",
      "text": "—不满足三角不等式，",
      "start": 23.573,
      "end": 25.093
    },
    {
      "id": "shot08-12",
      "text": "工业上不用，",
      "start": 25.093,
      "end": 26.193
    },
    {
      "id": "shot08-13",
      "text": "是数学拓展不进 KNN；",
      "start": 26.193,
      "end": 28.593
    },
    {
      "id": "shot08-14",
      "text": "网格搜索这种自动挑参数的工具，",
      "start": 28.593,
      "end": 31.373
    },
    {
      "id": "shot08-15",
      "text": "留给第 5 节超参数搜索专章。",
      "start": 31.373,
      "end": 34.513
    },
    {
      "id": "shot08-16",
      "text": "但其实这一期还有一个 4 种距离共有的问",
      "start": 34.513,
      "end": 37.623
    },
    {
      "id": "shot08-17",
      "text": "题没讲——任何一个距离公式，",
      "start": 37.623,
      "end": 39.693
    },
    {
      "id": "shot08-18",
      "text": "本质上都是把维度差直接加起来。",
      "start": 39.693,
      "end": 42.433
    },
    {
      "id": "shot08-19",
      "text": "如果一个特征数值范围 0 到 200，",
      "start": 42.433,
      "end": 45.293
    },
    {
      "id": "shot08-20",
      "text": "另一个 0 到 1，",
      "start": 45.293,
      "end": 46.713
    },
    {
      "id": "shot08-21",
      "text": "加起来谁会赢？",
      "start": 46.713,
      "end": 48.413
    },
    {
      "id": "shot08-22",
      "text": "数值大的那个主导——不管你换哪种距离，",
      "start": 48.413,
      "end": 51.533
    },
    {
      "id": "shot08-23",
      "text": "结果几乎只取决于它。",
      "start": 51.533,
      "end": 53.653
    },
    {
      "id": "shot08-24",
      "text": "下一期我们就来解决这个量纲问题。",
      "start": 54.011,
      "end": 56.631
    },
    {
      "id": "shot08-25",
      "text": "如果讲得有不对的地方，",
      "start": 56.631,
      "end": 58.631
    },
    {
      "id": "shot08-26",
      "text": "欢迎在评论区指正。下期见。",
      "start": 58.631,
      "end": 61.551
    }
  ]
}
