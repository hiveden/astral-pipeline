{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们有了 AdaBoost 的两条",
      "start": 0.0,
      "end": 2.525
    },
    {
      "id": "shot01-1",
      "text": "规则：",
      "start": 2.525,
      "end": 3.106
    },
    {
      "id": "shot01-2",
      "text": "错样本下一轮更重要，",
      "start": 3.106,
      "end": 5.25
    },
    {
      "id": "shot01-3",
      "text": "准学习器最终话语权更大。光看公式，",
      "start": 5.25,
      "end": 8.496
    },
    {
      "id": "shot01-4",
      "text": "可能还觉得抽象。",
      "start": 8.496,
      "end": 9.699
    },
    {
      "id": "shot01-5",
      "text": "这一期我们把它套进一组 10 个样本，",
      "start": 9.699,
      "end": 12.514
    },
    {
      "id": "shot01-6",
      "text": "手算 3 轮。",
      "start": 12.514,
      "end": 13.466
    },
    {
      "id": "shot01-7",
      "text": "数据很简单：",
      "start": 13.466,
      "end": 14.508
    },
    {
      "id": "shot01-8",
      "text": "特征 x 从 1 到 10，",
      "start": 14.508,
      "end": 16.552
    },
    {
      "id": "shot01-9",
      "text": "标签只有正类和负类。",
      "start": 16.552,
      "end": 18.836
    },
    {
      "id": "shot01-10",
      "text": "弱学习器也很简单：决策桩，",
      "start": 18.836,
      "end": 21.221
    },
    {
      "id": "shot01-11",
      "text": "只用一个切分点把数轴分成左右两边。",
      "start": 21.221,
      "end": 24.026
    },
    {
      "id": "shot01-12",
      "text": "我们会反复做 4 步：",
      "start": 24.571,
      "end": 26.294
    },
    {
      "id": "shot01-13",
      "text": "用当前样本权重找错误率最低的分裂点，",
      "start": 26.294,
      "end": 29.719
    },
    {
      "id": "shot01-14",
      "text": "算学习器权重 α，",
      "start": 29.719,
      "end": 31.502
    },
    {
      "id": "shot01-15",
      "text": "把分错样本权重调大，",
      "start": 31.502,
      "end": 33.506
    },
    {
      "id": "shot01-16",
      "text": "把分对样本权重调小，",
      "start": 33.506,
      "end": 35.449
    },
    {
      "id": "shot01-17",
      "text": "最后归一化。看完这期，",
      "start": 35.449,
      "end": 37.432
    },
    {
      "id": "shot01-18",
      "text": "你应该能把 AdaBoost 想成一张会",
      "start": 37.432,
      "end": 40.056
    },
    {
      "id": "shot01-19",
      "text": "移动注意力的错题表。",
      "start": 40.056,
      "end": 41.379
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先摆数据。",
      "start": 0.0,
      "end": 1.26
    },
    {
      "id": "shot02-1",
      "text": "10 个样本按编号 0 到 9 排开，",
      "start": 1.26,
      "end": 4.281
    },
    {
      "id": "shot02-2",
      "text": "特征值是 1 到 10。标签里，",
      "start": 4.281,
      "end": 6.682
    },
    {
      "id": "shot02-3",
      "text": "样本 0、1、2、6、7、",
      "start": 6.682,
      "end": 8.522
    },
    {
      "id": "shot02-4",
      "text": "8 是正类，样本 3、4、5、",
      "start": 8.522,
      "end": 10.903
    },
    {
      "id": "shot02-5",
      "text": "9 是负类。",
      "start": 10.903,
      "end": 11.943
    },
    {
      "id": "shot02-6",
      "text": "第一轮开始时，",
      "start": 11.943,
      "end": 13.063
    },
    {
      "id": "shot02-7",
      "text": "我们还不知道谁难谁简单，",
      "start": 13.063,
      "end": 15.384
    },
    {
      "id": "shot02-8",
      "text": "所以每个样本权重一样，",
      "start": 15.384,
      "end": 17.504
    },
    {
      "id": "shot02-9",
      "text": "都是 0.1。",
      "start": 17.504,
      "end": 19.044
    },
    {
      "id": "shot02-10",
      "text": "决策桩的候选切分点，",
      "start": 19.044,
      "end": 20.945
    },
    {
      "id": "shot02-11",
      "text": "是相邻 x 的中点，",
      "start": 20.945,
      "end": 22.885
    },
    {
      "id": "shot02-12",
      "text": "比如 1.5、2.5，",
      "start": 22.885,
      "end": 24.606
    },
    {
      "id": "shot02-13",
      "text": "一直到 9.5。",
      "start": 24.606,
      "end": 25.846
    },
    {
      "id": "shot02-14",
      "text": "每个切分点还要试两个方向：",
      "start": 25.846,
      "end": 28.227
    },
    {
      "id": "shot02-15",
      "text": "左边判正右边判负，",
      "start": 28.227,
      "end": 30.268
    },
    {
      "id": "shot02-16",
      "text": "或者左边判负右边判正。",
      "start": 30.268,
      "end": 31.192
    },
    {
      "id": "shot02-17",
      "text": "当前样本权重全相等，",
      "start": 32.839,
      "end": 35.129
    },
    {
      "id": "shot02-18",
      "text": "所以第 1 轮的加权错误率，",
      "start": 35.129,
      "end": 36.997
    },
    {
      "id": "shot02-19",
      "text": "就是分错样本数乘以 0.1。",
      "start": 36.997,
      "end": 39.528
    },
    {
      "id": "shot02-20",
      "text": "找出错误率最低的切法，",
      "start": 39.528,
      "end": 41.477
    },
    {
      "id": "shot02-21",
      "text": "就得到第 1 个弱学习器。",
      "start": 41.477,
      "end": 43.004
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "第 1 轮示例给出的最优弱学习器，",
      "start": 0.0,
      "end": 2.681
    },
    {
      "id": "shot03-1",
      "text": "错误率是 0.3，",
      "start": 2.681,
      "end": 3.981
    },
    {
      "id": "shot03-2",
      "text": "也就是按当前权重算，",
      "start": 3.981,
      "end": 5.802
    },
    {
      "id": "shot03-3",
      "text": "错样本合计占 30%。",
      "start": 5.802,
      "end": 7.942
    },
    {
      "id": "shot03-4",
      "text": "把 ε_1 = 0.3 代入公式，",
      "start": 7.942,
      "end": 11.423
    },
    {
      "id": "shot03-5",
      "text": "α_1 = 1/2 ln((1-0.3)",
      "start": 11.423,
      "end": 16.224
    },
    {
      "id": "shot03-6",
      "text": "/0.3)，",
      "start": 16.224,
      "end": 17.225
    },
    {
      "id": "shot03-7",
      "text": "约等于 0.4236。",
      "start": 17.225,
      "end": 19.625
    },
    {
      "id": "shot03-8",
      "text": "这个 α_1 就是第 1 个弱学习器的最",
      "start": 19.625,
      "end": 22.286
    },
    {
      "id": "shot03-9",
      "text": "终话语权。",
      "start": 22.286,
      "end": 23.346
    },
    {
      "id": "shot03-10",
      "text": "接下来更新样本权重。",
      "start": 23.346,
      "end": 25.367
    },
    {
      "id": "shot03-11",
      "text": "分对的样本乘 e^{-0.4236}，",
      "start": 25.367,
      "end": 28.848
    },
    {
      "id": "shot03-12",
      "text": "会变小；",
      "start": 28.848,
      "end": 29.649
    },
    {
      "id": "shot03-13",
      "text": "分错的样本乘 e^{0.4236}，",
      "start": 29.649,
      "end": 32.704
    },
    {
      "id": "shot03-14",
      "text": "会变大。",
      "start": 32.704,
      "end": 33.048
    },
    {
      "id": "shot03-15",
      "text": "归一化以后，",
      "start": 33.512,
      "end": 34.575
    },
    {
      "id": "shot03-16",
      "text": "分对样本大约变成 0.0714，",
      "start": 34.575,
      "end": 37.684
    },
    {
      "id": "shot03-17",
      "text": "分错样本大约变成 0.1667。",
      "start": 37.684,
      "end": 40.673
    },
    {
      "id": "shot03-18",
      "text": "也就是说，",
      "start": 40.673,
      "end": 41.415
    },
    {
      "id": "shot03-19",
      "text": "第 1 轮错掉的样本，",
      "start": 41.415,
      "end": 42.979
    },
    {
      "id": "shot03-20",
      "text": "下一轮的注意力已经变成普通样本的 2 倍",
      "start": 42.979,
      "end": 46.289
    },
    {
      "id": "shot03-21",
      "text": "多。",
      "start": 46.289,
      "end": 46.61
    },
    {
      "id": "shot03-22",
      "text": "表格上要把这些错样本的圆点放大，",
      "start": 46.61,
      "end": 49.298
    },
    {
      "id": "shot03-23",
      "text": "一眼就能看到 AdaBoost 的注意力",
      "start": 49.298,
      "end": 51.584
    },
    {
      "id": "shot03-24",
      "text": "转移了。",
      "start": 51.584,
      "end": 52.005
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "第 2 轮不再从均匀权重开始，",
      "start": 0.0,
      "end": 2.402
    },
    {
      "id": "shot04-1",
      "text": "而是从刚才的新权重开始。也就是说，",
      "start": 2.402,
      "end": 5.185
    },
    {
      "id": "shot04-2",
      "text": "第 1 轮错掉的样本现在更贵，",
      "start": 5.185,
      "end": 7.387
    },
    {
      "id": "shot04-3",
      "text": "新的决策桩为了降低加权错误率，",
      "start": 7.387,
      "end": 9.89
    },
    {
      "id": "shot04-4",
      "text": "会更愿意照顾它们。",
      "start": 9.89,
      "end": 11.575
    },
    {
      "id": "shot04-5",
      "text": "示例计算结果里，",
      "start": 11.575,
      "end": 12.925
    },
    {
      "id": "shot04-6",
      "text": "第 2 个弱学习器的话语权约为 0.",
      "start": 12.925,
      "end": 15.41
    },
    {
      "id": "shot04-7",
      "text": "6496，",
      "start": 15.41,
      "end": 16.211
    },
    {
      "id": "shot04-8",
      "text": "第 3 个弱学习器的话语权约为 0.",
      "start": 16.211,
      "end": 18.736
    },
    {
      "id": "shot04-9",
      "text": "7515。",
      "start": 18.736,
      "end": 19.939
    },
    {
      "id": "shot04-10",
      "text": "你不需要把每个小数都背下来，",
      "start": 19.939,
      "end": 22.123
    },
    {
      "id": "shot04-11",
      "text": "真正要看的是趋势：",
      "start": 22.123,
      "end": 23.746
    },
    {
      "id": "shot04-12",
      "text": "每一轮的分裂点会因为权重变化而改变，",
      "start": 23.746,
      "end": 26.852
    },
    {
      "id": "shot04-13",
      "text": "样本权重会在不同错题之间流动，",
      "start": 26.852,
      "end": 29.578
    },
    {
      "id": "shot04-14",
      "text": "后面的学习器会补前面的缺口。",
      "start": 29.578,
      "end": 31.622
    },
    {
      "id": "shot04-15",
      "text": "动画上可以这样呈现：",
      "start": 31.95,
      "end": 33.714
    },
    {
      "id": "shot04-16",
      "text": "第 1 轮后，样本 6、7、8 变大；",
      "start": 33.714,
      "end": 36.541
    },
    {
      "id": "shot04-17",
      "text": "第 2 轮后，",
      "start": 36.541,
      "end": 37.483
    },
    {
      "id": "shot04-18",
      "text": "另一组难样本被放大；",
      "start": 37.483,
      "end": 39.387
    },
    {
      "id": "shot04-19",
      "text": "第 3 轮再换一组。",
      "start": 39.387,
      "end": 41.051
    },
    {
      "id": "shot04-20",
      "text": "AdaBoost 像一个老师，",
      "start": 41.051,
      "end": 42.835
    },
    {
      "id": "shot04-21",
      "text": "哪里错得多，",
      "start": 42.835,
      "end": 43.937
    },
    {
      "id": "shot04-22",
      "text": "就把红笔圈到哪里。",
      "start": 43.937,
      "end": 45.28
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "3 轮结束后，",
      "start": 0.0,
      "end": 1.062
    },
    {
      "id": "shot05-1",
      "text": "我们不是只保留最后一棵树，",
      "start": 1.062,
      "end": 3.425
    },
    {
      "id": "shot05-2",
      "text": "而是把 3 棵弱学习器都留下来。",
      "start": 3.425,
      "end": 6.128
    },
    {
      "id": "shot05-3",
      "text": "最终强分类器长这样：",
      "start": 6.128,
      "end": 7.951
    },
    {
      "id": "shot05-4",
      "text": "H(x) 等于 sign，",
      "start": 7.951,
      "end": 9.588
    },
    {
      "id": "shot05-5",
      "text": "括号里是 0.4236 h_1(x) +",
      "start": 9.588,
      "end": 13.091
    },
    {
      "id": "shot05-6",
      "text": "0.6496 h_2(x) + 0.",
      "start": 13.091,
      "end": 16.243
    },
    {
      "id": "shot05-7",
      "text": "7515 h_3(x)。",
      "start": 16.243,
      "end": 18.345
    },
    {
      "id": "shot05-8",
      "text": "这句话翻成白话，",
      "start": 18.345,
      "end": 19.768
    },
    {
      "id": "shot05-9",
      "text": "就是第 1 棵树的票乘 0.4236，",
      "start": 19.768,
      "end": 23.035
    },
    {
      "id": "shot05-10",
      "text": "第 2 棵树的票乘 0.6496，",
      "start": 23.035,
      "end": 25.701
    },
    {
      "id": "shot05-11",
      "text": "第 3 棵树的票乘 0.7515，",
      "start": 25.701,
      "end": 28.428
    },
    {
      "id": "shot05-12",
      "text": "然后加总。",
      "start": 28.428,
      "end": 29.37
    },
    {
      "id": "shot05-13",
      "text": "总分大于 0，判正类；",
      "start": 29.37,
      "end": 31.154
    },
    {
      "id": "shot05-14",
      "text": "总分小于 0，判负类。",
      "start": 31.154,
      "end": 32.737
    },
    {
      "id": "shot05-15",
      "text": "如果要验证某个新 x，",
      "start": 33.274,
      "end": 35.157
    },
    {
      "id": "shot05-16",
      "text": "必须先让它依次通过三棵弱学习器，",
      "start": 35.157,
      "end": 38.063
    },
    {
      "id": "shot05-17",
      "text": "拿到三个正负票，",
      "start": 38.063,
      "end": 39.666
    },
    {
      "id": "shot05-18",
      "text": "再按这三个 α 加权求和。",
      "start": 39.666,
      "end": 42.33
    },
    {
      "id": "shot05-19",
      "text": "这个结尾很重要：",
      "start": 42.33,
      "end": 43.813
    },
    {
      "id": "shot05-20",
      "text": "AdaBoost 的每一棵树都很弱，",
      "start": 43.813,
      "end": 46.077
    },
    {
      "id": "shot05-21",
      "text": "但弱树不是一次性消耗品。",
      "start": 46.077,
      "end": 48.782
    },
    {
      "id": "shot05-22",
      "text": "它们被按话语权保存下来，",
      "start": 48.782,
      "end": 51.066
    },
    {
      "id": "shot05-23",
      "text": "共同形成最后的强分类器。",
      "start": 51.066,
      "end": 53.15
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期我们把 AdaBoost 的循环跑",
      "start": 0.0,
      "end": 2.664
    },
    {
      "id": "shot06-1",
      "text": "起来了。",
      "start": 2.664,
      "end": 3.305
    },
    {
      "id": "shot06-2",
      "text": "每一轮都做 4 件事：",
      "start": 3.305,
      "end": 5.108
    },
    {
      "id": "shot06-3",
      "text": "找当前权重下错误率最低的决策桩，",
      "start": 5.108,
      "end": 8.433
    },
    {
      "id": "shot06-4",
      "text": "按错误率算学习器权重，",
      "start": 8.433,
      "end": 10.616
    },
    {
      "id": "shot06-5",
      "text": "放大分错样本，",
      "start": 10.616,
      "end": 11.938
    },
    {
      "id": "shot06-6",
      "text": "缩小分对样本，再归一化。",
      "start": 11.938,
      "end": 14.282
    },
    {
      "id": "shot06-7",
      "text": "3 轮之后，",
      "start": 14.282,
      "end": 15.203
    },
    {
      "id": "shot06-8",
      "text": "强分类器不是最后一棵树，",
      "start": 15.203,
      "end": 17.367
    },
    {
      "id": "shot06-9",
      "text": "而是所有弱学习器的加权组合。",
      "start": 17.367,
      "end": 20.462
    },
    {
      "id": "shot06-10",
      "text": "手算的价值，",
      "start": 20.462,
      "end": 21.493
    },
    {
      "id": "shot06-11",
      "text": "是让我们看见注意力怎样从一组错题移动到另",
      "start": 21.493,
      "end": 24.778
    },
    {
      "id": "shot06-12",
      "text": "一组错题。",
      "start": 24.778,
      "end": 25.84
    },
    {
      "id": "shot06-13",
      "text": "真实数据当然不会只算 10 个样本，",
      "start": 25.84,
      "end": 28.524
    },
    {
      "id": "shot06-14",
      "text": "也不会只跑 3 轮。",
      "start": 28.524,
      "end": 29.566
    },
    {
      "id": "shot06-15",
      "text": "下一期我们把这套流程交给 sklearn，",
      "start": 30.091,
      "end": 33.101
    },
    {
      "id": "shot06-16",
      "text": "用 AdaBoostClassifier",
      "start": 33.101,
      "end": 34.967
    },
    {
      "id": "shot06-17",
      "text": "跑葡萄酒二分类，",
      "start": 34.967,
      "end": 36.452
    },
    {
      "id": "shot06-18",
      "text": "重点看三个工程旋钮：基学习器、",
      "start": 36.452,
      "end": 39.161
    },
    {
      "id": "shot06-19",
