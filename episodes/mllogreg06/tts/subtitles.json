{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "前面我们已经把逻辑回归的预测流程和损失函",
      "start": 0.0,
      "end": 3.362
    },
    {
      "id": "shot01-1",
      "text": "数讲清楚了。",
      "start": 3.362,
      "end": 4.403
    },
    {
      "id": "shot01-2",
      "text": "现在进入代码落地：",
      "start": 4.403,
      "end": 5.944
    },
    {
      "id": "shot01-3",
      "text": "sklearn 里真正调用的类叫",
      "start": 5.944,
      "end": 8.105
    },
    {
      "id": "shot01-4",
      "text": "LogisticRegression。",
      "start": 8.105,
      "end": 9.646
    },
    {
      "id": "shot01-5",
      "text": "不要被名字吓到，",
      "start": 9.646,
      "end": 10.927
    },
    {
      "id": "shot01-6",
      "text": "它对外仍然是熟悉的三步：",
      "start": 10.927,
      "end": 13.029
    },
    {
      "id": "shot01-7",
      "text": "实例化模型，",
      "start": 13.029,
      "end": 14.149
    },
    {
      "id": "shot01-8",
      "text": "fit 训练，",
      "start": 14.149,
      "end": 14.99
    },
    {
      "id": "shot01-9",
      "text": "predict 预测。不同的是，",
      "start": 14.99,
      "end": 17.151
    },
    {
      "id": "shot01-10",
      "text": "这一期我们要看三个 API 参数怎么影响",
      "start": 17.151,
      "end": 20.453
    },
    {
      "id": "shot01-11",
      "text": "模型：",
      "start": 20.453,
      "end": 20.974
    },
    {
      "id": "shot01-12",
      "text": "solver 决定怎么优化，",
      "start": 20.974,
      "end": 22.655
    },
    {
      "id": "shot01-13",
      "text": "penalty 决定加哪种正则，",
      "start": 22.655,
      "end": 24.556
    },
    {
      "id": "shot01-14",
      "text": "C 决定正则强弱。",
      "start": 24.556,
      "end": 25.877
    },
    {
      "id": "shot01-15",
      "text": "后半段再把它放进乳腺癌分类案例，",
      "start": 26.158,
      "end": 29.154
    },
    {
      "id": "shot01-16",
      "text": "跑一遍完整 pipeline。",
      "start": 29.154,
      "end": 30.501
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看 API 主体：",
      "start": 0.0,
      "end": 1.442
    },
    {
      "id": "shot02-1",
      "text": "LogisticRegression 里",
      "start": 1.442,
      "end": 3.244
    },
    {
      "id": "shot02-2",
      "text": "最常见的三个参数是 solver、",
      "start": 3.244,
      "end": 5.527
    },
    {
      "id": "shot02-3",
      "text": "penalty 和 C。",
      "start": 5.527,
      "end": 6.248
    },
    {
      "id": "shot02-4",
      "text": "solver 是优化器，",
      "start": 6.248,
      "end": 8.572
    },
    {
      "id": "shot02-5",
      "text": "也就是怎么找到最优参数；",
      "start": 8.572,
      "end": 10.574
    },
    {
      "id": "shot02-6",
      "text": "初学阶段先知道 liblinear、",
      "start": 10.574,
      "end": 12.757
    },
    {
      "id": "shot02-7",
      "text": "lbfgs、",
      "start": 12.757,
      "end": 13.438
    },
    {
      "id": "shot02-8",
      "text": "saga 这些名字，",
      "start": 13.438,
      "end": 15.241
    },
    {
      "id": "shot02-9",
      "text": "不急着展开。",
      "start": 15.241,
      "end": 16.522
    },
    {
      "id": "shot02-10",
      "text": "penalty 是正则类型，",
      "start": 16.522,
      "end": 18.084
    },
    {
      "id": "shot02-11",
      "text": "常见是 L2 收缩，",
      "start": 18.084,
      "end": 19.747
    },
    {
      "id": "shot02-12",
      "text": "或者 L1 稀疏。",
      "start": 19.747,
      "end": 21.609
    },
    {
      "id": "shot02-13",
      "text": "L2 更像把所有权重整体压小，",
      "start": 21.609,
      "end": 24.473
    },
    {
      "id": "shot02-14",
      "text": "L1 更容易把一些不重要特征压到 0。",
      "start": 24.473,
      "end": 27.257
    },
    {
      "id": "shot02-15",
      "text": "注意 solver 和 penalty",
      "start": 27.763,
      "end": 29.365
    },
    {
      "id": "shot02-16",
      "text": "不能随便乱配，",
      "start": 29.365,
      "end": 30.666
    },
    {
      "id": "shot02-17",
      "text": "比如 lbfgs 不支持 L1；",
      "start": 30.666,
      "end": 33.349
    },
    {
      "id": "shot02-18",
      "text": "初学可以先用 lbfgs 加 L2，",
      "start": 33.349,
      "end": 36.372
    },
    {
      "id": "shot02-19",
      "text": "想看稀疏化时再切 liblinear 或",
      "start": 36.372,
      "end": 39.075
    },
    {
      "id": "shot02-20",
      "text": "saga 加 L1。",
      "start": 39.075,
      "end": 40.576
    },
    {
      "id": "shot02-21",
      "text": "C 最容易反直觉：",
      "start": 40.576,
      "end": 41.998
    },
    {
      "id": "shot02-22",
      "text": "它不是正则强度，",
      "start": 41.998,
      "end": 43.359
    },
    {
      "id": "shot02-23",
      "text": "而是正则强度的倒数。C 越大，",
      "start": 43.359,
      "end": 46.062
    },
    {
      "id": "shot02-24",
      "text": "约束越松；C 越小，正则越强，",
      "start": 46.062,
      "end": 49.265
    },
    {
      "id": "shot02-25",
      "text": "权重会被压得更狠。",
      "start": 49.265,
      "end": 50.947
    },
    {
      "id": "shot02-26",
      "text": "第一轮先记这句就够：",
      "start": 50.947,
      "end": 52.608
    },
    {
      "id": "shot02-27",
      "text": "solver 选算法，",
      "start": 52.608,
      "end": 53.87
    },
    {
      "id": "shot02-28",
      "text": "penalty 选约束形态，",
      "start": 53.87,
      "end": 55.651
    },
    {
      "id": "shot02-29",
      "text": "C 反着调强弱。",
      "start": 55.651,
      "end": 56.933
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "打开参数 demo。",
      "start": 0.0,
      "end": 1.162
    },
    {
      "id": "shot03-1",
      "text": "画面左侧是控制区，",
      "start": 1.162,
      "end": 2.564
    },
    {
      "id": "shot03-2",
      "text": "可以拖 logC、",
      "start": 2.564,
      "end": 3.605
    },
    {
      "id": "shot03-3",
      "text": "切 penalty，",
      "start": 3.605,
      "end": 4.286
    },
    {
      "id": "shot03-4",
      "text": "还可以增加噪声维；",
      "start": 4.286,
      "end": 5.728
    },
    {
      "id": "shot03-5",
      "text": "右侧按镜头显示决策边界或 coef 权重",
      "start": 5.728,
      "end": 8.84
    },
    {
      "id": "shot03-6",
      "text": "条形图。",
      "start": 8.84,
      "end": 9.633
    },
    {
      "id": "shot03-7",
      "text": "先看 L2、",
      "start": 9.633,
      "end": 10.615
    },
    {
      "id": "shot03-8",
      "text": "C 等于 1 的基线，",
      "start": 10.615,
      "end": 11.756
    },
    {
      "id": "shot03-9",
      "text": "边界能把两类样本大致分开，",
      "start": 11.756,
      "end": 13.779
    },
    {
      "id": "shot03-10",
      "text": "权重条也比较平滑。",
      "start": 13.779,
      "end": 15.441
    },
    {
      "id": "shot03-11",
      "text": "把 C 降低，正则变强，",
      "start": 15.441,
      "end": 17.21
    },
    {
      "id": "shot03-12",
      "text": "权重整体被压小，",
      "start": 17.21,
      "end": 18.445
    },
    {
      "id": "shot03-13",
      "text": "边界会变得更保守。",
      "start": 18.445,
      "end": 19.667
    },
    {
      "id": "shot03-14",
      "text": "再切到 L1，",
      "start": 19.939,
      "end": 21.201
    },
    {
      "id": "shot03-15",
      "text": "观察 coef 图：",
      "start": 21.201,
      "end": 22.904
    },
    {
      "id": "shot03-16",
      "text": "如果噪声特征没有贡献，",
      "start": 22.904,
      "end": 24.947
    },
    {
      "id": "shot03-17",
      "text": "L1 更容易把它们压到 0，",
      "start": 24.947,
      "end": 27.211
    },
    {
      "id": "shot03-18",
      "text": "这就是稀疏化。",
      "start": 27.211,
      "end": 28.473
    },
    {
      "id": "shot03-19",
      "text": "这里不要把正则化讲成主线，",
      "start": 28.473,
      "end": 30.957
    },
    {
      "id": "shot03-20",
      "text": "只抓 API 直觉：",
      "start": 30.957,
      "end": 32.62
    },
    {
      "id": "shot03-21",
      "text": "penalty 决定压权重的方式，",
      "start": 32.62,
      "end": 35.264
    },
    {
      "id": "shot03-22",
      "text": "C 决定压得有多狠。",
      "start": 35.264,
      "end": 37.287
    },
    {
      "id": "shot03-23",
      "text": "后面如果模型过拟合，",
      "start": 37.287,
      "end": 39.471
    },
    {
      "id": "shot03-24",
      "text": "调这两个参数就是常见手段。",
      "start": 39.471,
      "end": 41.695
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "进入乳腺癌分类案例。",
      "start": 0.0,
      "end": 1.781
    },
    {
      "id": "shot04-1",
      "text": "完整 pipeline 可以拆成六步。",
      "start": 1.781,
      "end": 3.823
    },
    {
      "id": "shot04-2",
      "text": "第一步加载数据，",
      "start": 3.823,
      "end": 5.144
    },
    {
      "id": "shot04-3",
      "text": "demo 用 sklearn 自带",
      "start": 5.144,
      "end": 6.985
    },
    {
      "id": "shot04-4",
      "text": "breast cancer 数据集。",
      "start": 6.985,
      "end": 8.566
    },
    {
      "id": "shot04-5",
      "text": "第二步明确标签口径：",
      "start": 8.566,
      "end": 10.587
    },
    {
      "id": "shot04-6",
      "text": "这里把恶性当作正例，",
      "start": 10.587,
      "end": 12.509
    },
    {
      "id": "shot04-7",
      "text": "因为医疗场景最关心的是有没有漏掉恶性。",
      "start": 12.509,
      "end": 16.371
    },
    {
      "id": "shot04-8",
      "text": "第三步切分训练集和测试集，",
      "start": 16.371,
      "end": 18.853
    },
    {
      "id": "shot04-9",
      "text": "并且使用 stratify 保持正负比例。",
      "start": 18.853,
      "end": 21.715
    },
    {
      "id": "shot04-10",
      "text": "第四步标准化，",
      "start": 21.715,
      "end": 23.016
    },
    {
      "id": "shot04-11",
      "text": "逻辑回归对特征尺度敏感，",
      "start": 23.016,
      "end": 25.237
    },
    {
      "id": "shot04-12",
      "text": "所以先在训练集 fit 标准化器，",
      "start": 25.237,
      "end": 27.719
    },
    {
      "id": "shot04-13",
      "text": "再 transform 测试集。",
      "start": 27.719,
      "end": 28.96
    },
    {
      "id": "shot04-14",
      "text": "第五步训练",
      "start": 29.376,
      "end": 30.318
    },
    {
      "id": "shot04-15",
      "text": "LogisticRegression。",
      "start": 30.318,
      "end": 31.681
    },
    {
      "id": "shot04-16",
      "text": "第六步评估，",
      "start": 31.681,
      "end": 32.743
    },
    {
      "id": "shot04-17",
      "text": "不只看 accuracy，",
      "start": 32.743,
      "end": 33.966
    },
    {
      "id": "shot04-18",
      "text": "还要看 precision、",
      "start": 33.966,
      "end": 35.008
    },
    {
      "id": "shot04-19",
      "text": "recall、",
      "start": 35.008,
      "end": 35.75
    },
    {
      "id": "shot04-20",
      "text": "F1 和 AUC。",
      "start": 35.75,
      "end": 37.053
    },
    {
      "id": "shot04-21",
      "text": "准确率高当然好，",
      "start": 37.053,
      "end": 38.436
    },
    {
      "id": "shot04-22",
      "text": "但医疗场景更怕漏诊，",
      "start": 38.436,
      "end": 40.34
    },
    {
      "id": "shot04-23",
      "text": "所以 recall 会非常重要。",
      "start": 40.34,
      "end": 42.164
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "打开癌症 pipeline demo。",
      "start": 0.0,
      "end": 1.883
    },
    {
      "id": "shot05-1",
      "text": "这个 demo 是代码讲解模式，",
      "start": 1.883,
      "end": 4.106
    },
    {
      "id": "shot05-2",
      "text": "左边是代码块行高亮，",
      "start": 4.106,
      "end": 6.049
    },
    {
      "id": "shot05-3",
      "text": "右边图表随 step 推进。",
      "start": 6.049,
      "end": 8.032
    },
    {
      "id": "shot05-4",
      "text": "step 1 是导入模块；",
      "start": 8.032,
      "end": 9.735
    },
    {
      "id": "shot05-5",
      "text": "step 2 加载数据，",
      "start": 9.735,
      "end": 11.257
    },
    {
      "id": "shot05-6",
      "text": "图上出现主特征和标签分布；",
      "start": 11.257,
      "end": 13.721
    },
    {
      "id": "shot05-7",
      "text": "step 3 切分训练和测试；",
      "start": 13.721,
      "end": 15.824
    },
    {
      "id": "shot05-8",
      "text": "step 4 标准化，",
      "start": 15.824,
      "end": 17.266
    },
    {
      "id": "shot05-9",
      "text": "横轴从原始尺度变成 z-score；",
      "start": 17.266,
      "end": 20.231
    },
    {
      "id": "shot05-10",
      "text": "step 5 训练模型，",
      "start": 20.231,
      "end": 21.833
    },
    {
      "id": "shot05-11",
      "text": "图上出现概率分界和模型曲线；",
      "start": 21.833,
      "end": 24.498
    },
    {
      "id": "shot05-12",
      "text": "step 6 输出评估指标柱图。",
      "start": 24.498,
      "end": 26.561
    },
    {
      "id": "shot05-13",
      "text": "注意，",
      "start": 26.981,
      "end": 27.322
    },
    {
      "id": "shot05-14",
      "text": "demo 的正例是恶性，",
      "start": 27.322,
      "end": 29.105
    },
    {
      "id": "shot05-15",
      "text": "所以 recall 的含义是：",
      "start": 29.105,
      "end": 30.488
    },
    {
      "id": "shot05-16",
      "text": "真实恶性里抓回来了多少。",
      "start": 30.488,
      "end": 32.752
    },
    {
      "id": "shot05-17",
      "text": "这个口径必须先定住，",
      "start": 32.752,
      "end": 34.576
    },
    {
      "id": "shot05-18",
      "text": "否则后面 precision、",
      "start": 34.576,
      "end": 36.199
    },
    {
      "id": "shot05-19",
      "text": "recall、",
      "start": 36.199,
      "end": 36.84
    },
    {
      "id": "shot05-20",
      "text": "AUC 都会读反。",
      "start": 36.84,
      "end": 38.403
    },
    {
      "id": "shot05-21",
      "text": "整段 demo 的核心不是炫代码，",
      "start": 38.403,
      "end": 40.808
    },
    {
      "id": "shot05-22",
      "text": "而是让你看到：",
      "start": 40.808,
      "end": 41.77
    },
    {
      "id": "shot05-23",
      "text": "模型两行，",
      "start": 41.77,
      "end": 42.932
    },
    {
      "id": "shot05-24",
      "text": "数据处理和评估才是案例的大头。",
      "start": 42.932,
      "end": 45.557
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "癌症案例通常能拿到很高的",
      "start": 0.0,
      "end": 2.182
    },
    {
      "id": "shot06-1",
      "text": "accuracy，",
      "start": 2.182,
      "end": 2.942
    },
    {
      "id": "shot06-2",
      "text": "但这里要提前埋一个问题：",
      "start": 2.942,
      "end": 4.724
    },
    {
      "id": "shot06-3",
      "text": "医疗场景里，",
      "start": 4.724,
      "end": 5.904
    },
    {
      "id": "shot06-4",
      "text": "漏诊一个恶性病人和误报一个健康人，",
      "start": 5.904,
      "end": 9.047
    },
    {
      "id": "shot06-5",
      "text": "代价完全不同。",
      "start": 9.047,
      "end": 10.328
    },
    {
      "id": "shot06-6",
      "text": "accuracy 会把这两种错误都算成错",
      "start": 10.328,
      "end": 12.91
    },
    {
      "id": "shot06-7",
      "text": "一次，",
      "start": 12.91,
      "end": 13.31
    },
    {
      "id": "shot06-8",
      "text": "但业务上它们不是一个量级。",
      "start": 13.31,
      "end": 15.992
    },
    {
      "id": "shot06-9",
      "text": "如果模型把恶性判成良性，这叫漏诊；",
      "start": 15.992,
      "end": 19.395
    },
    {
      "id": "shot06-10",
      "text": "如果把良性判成恶性，这叫误报。",
      "start": 19.395,
      "end": 22.257
    },
    {
      "id": "shot06-11",
      "text": "下一期开始，",
      "start": 22.257,
      "end": 23.277
    },
    {
      "id": "shot06-12",
      "text": "我们会把这两类错误拆开，",
      "start": 23.277,
      "end": 25.319
    },
    {
      "id": "shot06-13",
      "text": "用混淆矩阵明确 TP、FN、FP、",
      "start": 25.319,
      "end": 28.922
    },
    {
      "id": "shot06-14",
      "text": "TN 四个格子。",
      "start": 28.922,
      "end": 29.989
    },
    {
      "id": "shot06-15",
      "text": "只有把错误结构摊开，",
