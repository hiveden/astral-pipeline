{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们已经会用贝叶斯公式把方向翻过来：",
      "start": 0.0,
      "end": 3.302
    },
    {
      "id": "shot01-1",
      "text": "从容易数的 P(W|C)，",
      "start": 3.302,
      "end": 5.223
    },
    {
      "id": "shot01-2",
      "text": "反推真正要的 P(C|W)。",
      "start": 5.223,
      "end": 7.484
    },
    {
      "id": "shot01-3",
      "text": "但这里还有两个问题。第一，",
      "start": 7.484,
      "end": 9.605
    },
    {
      "id": "shot01-4",
      "text": "W 如果不是两个特征，",
      "start": 9.605,
      "end": 11.386
    },
    {
      "id": "shot01-5",
      "text": "而是 10 个词、",
      "start": 11.386,
      "end": 12.458
    },
    {
      "id": "shot01-6",
      "text": "100 个词，",
      "start": 12.458,
      "end": 13.367
    },
    {
      "id": "shot01-7",
      "text": "联合概率就会越来越难数。第二，",
      "start": 13.367,
      "end": 16.13
    },
    {
      "id": "shot01-8",
      "text": "只要某个词在某个类别里没出现过，",
      "start": 16.13,
      "end": 19.037
    },
    {
      "id": "shot01-9",
      "text": "连乘里就会出现 0，",
      "start": 19.037,
      "end": 20.702
    },
    {
      "id": "shot01-10",
      "text": "整条得分直接归零。",
      "start": 20.702,
      "end": 22.567
    },
    {
      "id": "shot01-11",
      "text": "这一期我们解决这两个问题：",
      "start": 22.567,
      "end": 24.652
    },
    {
      "id": "shot01-12",
      "text": "用朴素假设把联合概率拆开，",
      "start": 24.652,
      "end": 27.079
    },
    {
      "id": "shot01-13",
      "text": "再用拉普拉斯平滑给没见过的特征留一点可能",
      "start": 27.079,
      "end": 30.588
    },
    {
      "id": "shot01-14",
      "text": "性。",
      "start": 30.588,
      "end": 30.608
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看为什么联合概率会算不动。",
      "start": 0.0,
      "end": 2.363
    },
    {
      "id": "shot02-1",
      "text": "假设做垃圾邮件分类，",
      "start": 2.363,
      "end": 4.086
    },
    {
      "id": "shot02-2",
      "text": "每个词都只有两种状态：出现，",
      "start": 4.086,
      "end": 6.789
    },
    {
      "id": "shot02-3",
      "text": "或者没出现。",
      "start": 6.789,
      "end": 7.811
    },
    {
      "id": "shot02-4",
      "text": "如果只看 10 个词，",
      "start": 7.811,
      "end": 9.453
    },
    {
      "id": "shot02-5",
      "text": "组合数是 2 的 10 次方，",
      "start": 9.453,
      "end": 11.155
    },
    {
      "id": "shot02-6",
      "text": "也就是 1024 种。",
      "start": 11.155,
      "end": 12.938
    },
    {
      "id": "shot02-7",
      "text": "看 20 个词，",
      "start": 12.938,
      "end": 14.019
    },
    {
      "id": "shot02-8",
      "text": "组合数是 1048576，",
      "start": 14.019,
      "end": 16.102
    },
    {
      "id": "shot02-9",
      "text": "约 100 万种。",
      "start": 16.102,
      "end": 17.624
    },
    {
      "id": "shot02-10",
      "text": "看 50 个词，",
      "start": 17.624,
      "end": 18.666
    },
    {
      "id": "shot02-11",
      "text": "已经超过 1000 万亿种。",
      "start": 18.666,
      "end": 20.508
    },
    {
      "id": "shot02-12",
      "text": "看 100 个词，",
      "start": 20.508,
      "end": 21.55
    },
    {
      "id": "shot02-13",
      "text": "数字大约是 1 后面跟 30 个零。",
      "start": 21.55,
      "end": 23.853
    },
    {
      "id": "shot02-14",
      "text": "训练集通常没有这么多样本，",
      "start": 23.853,
      "end": 26.076
    },
    {
      "id": "shot02-15",
      "text": "绝大多数组合根本没出现过。",
      "start": 26.076,
      "end": 28.019
    },
    {
      "id": "shot02-16",
      "text": "所以直接估计整组特征的联合概率，",
      "start": 28.503,
      "end": 31.303
    },
    {
      "id": "shot02-17",
      "text": "会同时遇到参数爆炸和数据稀疏。",
      "start": 31.303,
      "end": 33.961
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "朴素贝叶斯的做法很直接：",
      "start": 0.0,
      "end": 1.86
    },
    {
      "id": "shot03-1",
      "text": "别再估整组组合，",
      "start": 1.86,
      "end": 3.481
    },
    {
      "id": "shot03-2",
      "text": "改成分别估每一个特征。",
      "start": 3.481,
      "end": 5.501
    },
    {
      "id": "shot03-3",
      "text": "数学上写成，P(w1，w2，",
      "start": 5.501,
      "end": 7.922
    },
    {
      "id": "shot03-4",
      "text": "一直到 wn|C)，",
      "start": 7.922,
      "end": 9.382
    },
    {
      "id": "shot03-5",
      "text": "近似等于 P(w1|C) 乘 P(w2|",
      "start": 9.382,
      "end": 12.083
    },
    {
      "id": "shot03-6",
      "text": "C)，",
      "start": 12.083,
      "end": 12.603
    },
    {
      "id": "shot03-7",
      "text": "一直乘到 P(wn|C)。",
      "start": 12.603,
      "end": 14.403
    },
    {
      "id": "shot03-8",
      "text": "这句话一定要读准：",
      "start": 14.403,
      "end": 15.894
    },
    {
      "id": "shot03-9",
      "text": "它假设的是给定类别 C 以后，",
      "start": 15.894,
      "end": 18.364
    },
    {
      "id": "shot03-10",
      "text": "特征之间条件独立。",
      "start": 18.364,
      "end": 19.965
    },
    {
      "id": "shot03-11",
      "text": "不是说特征本身无条件独立。",
      "start": 19.965,
      "end": 22.545
    },
    {
      "id": "shot03-12",
      "text": "比如在天气表里，",
      "start": 22.545,
      "end": 23.826
    },
    {
      "id": "shot03-13",
      "text": "朴素假设会写 P(阴天，",
      "start": 23.826,
      "end": 25.886
    },
    {
      "id": "shot03-14",
      "text": "风大|下雨) 约等于 P(阴天|下雨)",
      "start": 25.886,
      "end": 28.527
    },
    {
      "id": "shot03-15",
      "text": "乘 P(风大|下雨)。",
      "start": 28.527,
      "end": 29.707
    },
    {
      "id": "shot03-16",
      "text": "它不会说 P(阴天，",
      "start": 30.225,
      "end": 31.952
    },
    {
      "id": "shot03-17",
      "text": "风大) 等于 P(阴天) 乘 P(风大)。",
      "start": 31.952,
      "end": 34.502
    },
    {
      "id": "shot03-18",
      "text": "前者是给定类别后的简化，",
      "start": 34.502,
      "end": 36.831
    },
    {
      "id": "shot03-19",
      "text": "后者通常不成立。",
      "start": 36.831,
      "end": 38.015
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "这个假设很强，",
      "start": 0.0,
      "end": 1.162
    },
    {
      "id": "shot04-1",
      "text": "也很粗糙。文本里，",
      "start": 1.162,
      "end": 3.105
    },
    {
      "id": "shot04-2",
      "text": "词当然不是互相独立的。",
      "start": 3.105,
      "end": 5.168
    },
    {
      "id": "shot04-3",
      "text": "比如评论里出现“垃圾”和“书”，",
      "start": 5.168,
      "end": 7.431
    },
    {
      "id": "shot04-4",
      "text": "经常不是两个互不相干的词，",
      "start": 7.431,
      "end": 9.734
    },
    {
      "id": "shot04-5",
      "text": "而是“垃圾书”这个固定搭配。",
      "start": 9.734,
      "end": 12.218
    },
    {
      "id": "shot04-6",
      "text": "朴素贝叶斯明知道这里有相关性，",
      "start": 12.218,
      "end": 14.501
    },
    {
      "id": "shot04-7",
      "text": "仍然把它们拆开算。",
      "start": 14.501,
      "end": 16.524
    },
    {
      "id": "shot04-8",
      "text": "为什么还能用？",
      "start": 16.524,
      "end": 17.846
    },
    {
      "id": "shot04-9",
      "text": "因为很多分类任务只需要排序大致对。",
      "start": 17.846,
      "end": 21.191
    },
    {
      "id": "shot04-10",
      "text": "我们不一定相信它给出的概率绝对值非常校准，",
      "start": 21.191,
      "end": 24.937
    },
    {
      "id": "shot04-11",
      "text": "但只要差评分子比好评分子大，",
      "start": 24.937,
      "end": 27.601
    },
    {
      "id": "shot04-12",
      "text": "类别判断就能工作。",
      "start": 27.601,
      "end": 28.863
    },
    {
      "id": "shot04-13",
      "text": "朴素这两个字，",
      "start": 29.347,
      "end": 30.494
    },
    {
      "id": "shot04-14",
      "text": "不是说算法幼稚，",
      "start": 30.494,
      "end": 32.165
    },
    {
      "id": "shot04-15",
      "text": "而是说它主动接受一个简化，",
      "start": 32.165,
      "end": 34.681
    },
    {
      "id": "shot04-16",
      "text": "用概率精度换来可计算性。",
      "start": 34.681,
      "end": 37.057
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "朴素假设解决了组合太多的问题，",
      "start": 0.0,
      "end": 2.782
    },
    {
      "id": "shot05-1",
      "text": "但连乘又带来一个新坑：",
      "start": 2.782,
      "end": 5.024
    },
    {
      "id": "shot05-2",
      "text": "任何一项是 0，",
      "start": 5.024,
      "end": 6.525
    },
    {
      "id": "shot05-3",
      "text": "整个乘积就是 0。",
      "start": 6.525,
      "end": 8.006
    },
    {
      "id": "shot05-4",
      "text": "假设训练集的垃圾邮件里碰巧没有“报销”这",
      "start": 8.006,
      "end": 11.249
    },
    {
      "id": "shot05-5",
      "text": "个词。",
      "start": 11.249,
      "end": 11.849
    },
    {
      "id": "shot05-6",
      "text": "新邮件是“请报销机票”。",
      "start": 11.849,
      "end": 14.271
    },
    {
      "id": "shot05-7",
      "text": "如果 P(报销|垃圾邮件) 被直接估成",
      "start": 14.271,
      "end": 17.033
    },
    {
      "id": "shot05-8",
      "text": "0，",
      "start": 17.033,
      "end": 17.574
    },
    {
      "id": "shot05-9",
      "text": "那么不管“请”和“机票”多么支持垃圾邮件，",
      "start": 17.574,
      "end": 21.016
    },
    {
      "id": "shot05-10",
      "text": "这个类别的总分都会被压成 0。",
      "start": 21.016,
      "end": 23.718
    },
    {
      "id": "shot05-11",
      "text": "这显然不合理。没见过，",
      "start": 23.718,
      "end": 25.94
    },
    {
      "id": "shot05-12",
      "text": "不等于不可能。",
      "start": 25.94,
      "end": 27.043
    },
    {
      "id": "shot05-13",
      "text": "它可能只是训练样本太少，",
      "start": 27.043,
      "end": 29.529
    },
    {
      "id": "shot05-14",
      "text": "刚好没轮到。",
      "start": 29.529,
      "end": 30.359
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "拉普拉斯平滑，",
      "start": 0.0,
      "end": 2.682
    },
    {
      "id": "shot06-1",
      "text": "Laplace smoothing，",
      "start": 2.682,
      "end": 2.682
    },
    {
      "id": "shot06-2",
      "text": "就是给没见过的取值留一点票。公式是：",
      "start": 2.682,
      "end": 5.884
    },
    {
      "id": "shot06-3",
      "text": "P(wi|C) 等于 Ni 加 α，",
      "start": 5.884,
      "end": 8.586
    },
    {
      "id": "shot06-4",
      "text": "再除以 N 加 αm。",
      "start": 8.586,
      "end": 10.788
    },
    {
      "id": "shot06-5",
      "text": "Ni 是这个特征在类别 C 里出现了多少",
      "start": 10.788,
      "end": 14.21
    },
    {
      "id": "shot06-6",
      "text": "次。",
      "start": 14.21,
      "end": 14.57
    },
    {
      "id": "shot06-7",
      "text": "N 是这个类别下所有特征出现的总次数。",
      "start": 14.57,
      "end": 18.513
    },
    {
      "id": "shot06-8",
      "text": "m 是可能取值的个数，",
      "start": 18.513,
      "end": 20.535
    },
    {
      "id": "shot06-9",
      "text": "文本里通常就是词表大小。",
      "start": 20.535,
      "end": 22.918
    },
    {
      "id": "shot06-10",
      "text": "α 是平滑系数，",
      "start": 22.918,
      "end": 24.244
    },
    {
      "id": "shot06-11",
      "text": "常见取 1。",
      "start": 24.244,
      "end": 25.449
    },
    {
      "id": "shot06-12",
      "text": "直觉可以这样记：",
      "start": 25.449,
      "end": 26.655
    },
    {
      "id": "shot06-13",
      "text": "每个可能的取值，",
      "start": 26.655,
      "end": 28.021
    },
    {
      "id": "shot06-14",
      "text": "都先假装出现过 α 次。",
      "start": 28.021,
      "end": 29.89
    },
    {
      "id": "shot06-15",
      "text": "这样就算 Ni 是 0，",
      "start": 30.287,
      "end": 31.753
    },
    {
      "id": "shot06-16",
      "text": "分子也还有 α，",
      "start": 31.753,
      "end": 33.218
    },
    {
      "id": "shot06-17",
      "text": "概率不会变成 0。",
      "start": 33.218,
      "end": 34.664
    },
    {
      "id": "shot06-18",
      "text": "分母同时加 αm，",
      "start": 34.664,
      "end": 36.611
    },
    {
      "id": "shot06-19",
      "text": "是为了把所有取值的概率重新归一化，",
      "start": 36.611,
      "end": 39.502
    },
    {
      "id": "shot06-20",
      "text": "保证加起来还是 1。",
      "start": 39.502,
      "end": 40.928
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "用骰子看最直观。",
      "start": 0.0,
      "end": 1.76
    },
    {
      "id": "shot07-1",
      "text": "一个六面骰子只掷 5 次，",
      "start": 1.76,
      "end": 3.661
    },
    {
      "id": "shot07-2",
      "text": "结果是 1、1、2、3、1。",
      "start": 3.661,
      "end": 5.441
    },
    {
      "id": "shot07-3",
      "text": "直接按频率估计，",
      "start": 5.441,
      "end": 6.802
    },
    {
      "id": "shot07-4",
      "text": "点数 1 是 3/5，",
      "start": 6.802,
      "end": 8.562
    },
    {
      "id": "shot07-5",
      "text": "也就是 0.6；",
      "start": 8.562,
      "end": 9.702
    },
    {
      "id": "shot07-6",
      "text": "点数 2 和 3 各是 0.2；",
      "start": 9.702,
      "end": 12.023
    },
    {
      "id": "shot07-7",
      "text": "点数 4、5、",
      "start": 12.023,
      "end": 13.123
    },
    {
      "id": "shot07-8",
      "text": "6 都是 0。",
      "start": 13.123,
      "end": 13.863
    },
    {
      "id": "shot07-9",
      "text": "可是掷 5 次没出现 4，",
      "start": 13.863,
      "end": 15.684
    },
    {
      "id": "shot07-10",
      "text": "不代表 4 永远不可能出现。",
      "start": 15.684,
      "end": 18.064
    },
    {
      "id": "shot07-11",
      "text": "加 α 等于 1 的拉普拉斯平滑后，",
      "start": 18.064,
      "end": 21.385
    },
    {
      "id": "shot07-12",
      "text": "分母从 5 变成 11。",
      "start": 21.385,
      "end": 23.225
    },
    {
      "id": "shot07-13",
      "text": "点数 1 是 4/11，",
      "start": 23.225,
      "end": 24.766
    },
    {
      "id": "shot07-14",
      "text": "约 0.364。",
      "start": 24.766,
      "end": 26.366
    },
    {
      "id": "shot07-15",
      "text": "点数 2 和 3 各是 2/11，",
      "start": 26.366,
      "end": 28.627
    },
    {
      "id": "shot07-16",
      "text": "约 0.182。",
      "start": 28.627,
      "end": 29.507
    },
    {
      "id": "shot07-17",
      "text": "点数 4、5、",
      "start": 30.273,
      "end": 31.629
    },
    {
      "id": "shot07-18",
      "text": "6 各是 1/11，",
      "start": 31.629,
      "end": 33.484
    },
    {
      "id": "shot07-19",
      "text": "约 0.091。",
      "start": 33.484,
      "end": 35.31
    },
    {
      "id": "shot07-20",
      "text": "零概率被救活了，",
      "start": 35.31,
      "end": 36.915
    },
    {
      "id": "shot07-21",
      "text": "高频的 1 也被压低了一些。",
      "start": 36.915,
      "end": 39.002
    },
    {
      "id": "shot07-22",
      "text": "平滑不是篡改数据，",
      "start": 39.002,
      "end": 40.728
    },
    {
      "id": "shot07-23",
      "text": "而是防止小样本把概率判死。",
      "start": 40.728,
      "end": 43.016
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "到这里，",
      "start": 0.0,
      "end": 0.653
    },
    {
      "id": "shot08-1",
      "text": "朴素贝叶斯的数学机器就齐了。",
      "start": 0.653,
      "end": 2.861
    },
    {
      "id": "shot08-2",
      "text": "贝叶斯公式负责把方向翻过来，",
      "start": 2.861,
      "end": 5.382
    },
    {
      "id": "shot08-3",
      "text": "从 P(W|C) 走向 P(C|W)。",
