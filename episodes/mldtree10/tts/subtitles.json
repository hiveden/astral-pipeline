{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "决策树最危险的地方，",
      "start": 0.0,
      "end": 1.661
    },
    {
      "id": "shot01-1",
      "text": "是它太会记训练集。",
      "start": 1.661,
      "end": 3.322
    },
    {
      "id": "shot01-2",
      "text": "只要不限制，",
      "start": 3.322,
      "end": 4.283
    },
    {
      "id": "shot01-3",
      "text": "它可以一路切到每片叶子只剩一个样本。",
      "start": 4.283,
      "end": 7.125
    },
    {
      "id": "shot01-4",
      "text": "训练准确率看起来接近 100%，",
      "start": 7.125,
      "end": 9.607
    },
    {
      "id": "shot01-5",
      "text": "但新样本一来就不稳，",
      "start": 9.607,
      "end": 11.308
    },
    {
      "id": "shot01-6",
      "text": "因为树把训练集里的噪声也当成规律记住了。",
      "start": 11.308,
      "end": 15.091
    },
    {
      "id": "shot01-7",
      "text": "剪枝，",
      "start": 15.091,
      "end": 15.572
    },
    {
      "id": "shot01-8",
      "text": "英文 pruning，",
      "start": 15.572,
      "end": 16.592
    },
    {
      "id": "shot01-9",
      "text": "就是专门处理这个问题：",
      "start": 16.592,
      "end": 18.294
    },
    {
      "id": "shot01-10",
      "text": "把收益不够的细分支砍掉，",
      "start": 18.294,
      "end": 20.415
    },
    {
      "id": "shot01-11",
      "text": "让树简单一点，",
      "start": 20.415,
      "end": 21.696
    },
    {
      "id": "shot01-12",
      "text": "泛化能力更好一点。",
      "start": 21.696,
      "end": 23.097
    },
    {
      "id": "shot01-13",
      "text": "这和前面回归树的深树曲线是同一个问题：",
      "start": 23.097,
      "end": 26.407
    },
    {
      "id": "shot01-14",
      "text": "模型不是不会学习，",
      "start": 26.407,
      "end": 28.012
    },
    {
      "id": "shot01-15",
      "text": "而是学得太细，",
      "start": 28.012,
      "end": 29.136
    },
    {
      "id": "shot01-16",
      "text": "把偶然波动也写进了规则。",
      "start": 29.136,
      "end": 30.961
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "剪枝的动作很直观：",
      "start": 0.0,
      "end": 1.781
    },
    {
      "id": "shot02-1",
      "text": "把一棵子树下面的节点都删掉，",
      "start": 1.781,
      "end": 4.303
    },
    {
      "id": "shot02-2",
      "text": "用一个叶子节点替代。",
      "start": 4.303,
      "end": 5.864
    },
    {
      "id": "shot02-3",
      "text": "这个新叶子的标签通常用原来这片区域里的多",
      "start": 5.864,
      "end": 9.187
    },
    {
      "id": "shot02-4",
      "text": "数类决定。剪掉以后，",
      "start": 9.187,
      "end": 10.988
    },
    {
      "id": "shot02-5",
      "text": "训练集上可能会错几个原本记住的样本，",
      "start": 10.988,
      "end": 14.01
    },
    {
      "id": "shot02-6",
      "text": "但测试集上反而可能更稳。",
      "start": 14.01,
      "end": 16.212
    },
    {
      "id": "shot02-7",
      "text": "它和线性模型里的正则化有相同思想：",
      "start": 16.212,
      "end": 19.399
    },
    {
      "id": "shot02-8",
      "text": "不要让模型为了照顾训练集里的每一个细节，",
      "start": 19.399,
      "end": 22.666
    },
    {
      "id": "shot02-9",
      "text": "把规则写得过度复杂。",
      "start": 22.666,
      "end": 24.571
    },
    {
      "id": "shot02-10",
      "text": "如果画在树上，",
      "start": 24.571,
      "end": 25.853
    },
    {
      "id": "shot02-11",
      "text": "就是把一个内部节点下面的整片分支折叠回去。",
      "start": 25.853,
      "end": 29.582
    },
    {
      "id": "shot02-12",
      "text": "规则少了，路径短了，",
      "start": 29.582,
      "end": 31.225
    },
    {
      "id": "shot02-13",
      "text": "模型牺牲一点训练集精度，",
      "start": 31.225,
      "end": 33.51
    },
    {
      "id": "shot02-14",
      "text": "换取更好的泛化。",
      "start": 33.51,
      "end": 34.653
    },
    {
      "id": "shot02-15",
      "text": "这句话要和前面的过拟合连在一起：",
      "start": 35.021,
      "end": 37.76
    },
    {
      "id": "shot02-16",
      "text": "剪掉的不是知识，",
      "start": 37.76,
      "end": 39.234
    },
    {
      "id": "shot02-17",
      "text": "而是对训练样本偶然细节的记忆。",
      "start": 39.234,
      "end": 42.203
    },
    {
      "id": "shot02-18",
      "text": "这也是为什么剪枝后树图更容易读，",
      "start": 42.203,
      "end": 44.872
    },
    {
      "id": "shot02-19",
      "text": "业务方看到的是少数关键规则，",
      "start": 44.872,
      "end": 47.64
    },
    {
      "id": "shot02-20",
      "text": "而不是一堆只服务训练样本的细枝。",
      "start": 47.64,
      "end": 50.489
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "第一类叫预剪枝，",
      "start": 0.0,
      "end": 1.442
    },
    {
      "id": "shot03-1",
      "text": "英文 pre-pruning。",
      "start": 1.442,
      "end": 2.964
    },
    {
      "id": "shot03-2",
      "text": "它在树生成过程中就提前判断：",
      "start": 2.964,
      "end": 5.287
    },
    {
      "id": "shot03-3",
      "text": "这一刀值不值得切。",
      "start": 5.287,
      "end": 6.849
    },
    {
      "id": "shot03-4",
      "text": "如果切完以后验证集表现没有提升，",
      "start": 6.849,
      "end": 9.313
    },
    {
      "id": "shot03-5",
      "text": "就不切了，",
      "start": 9.313,
      "end": 10.034
    },
    {
      "id": "shot03-6",
      "text": "当前节点直接变叶子。",
      "start": 10.034,
      "end": 12.077
    },
    {
      "id": "shot03-7",
      "text": "在 sklearn 里，",
      "start": 12.077,
      "end": 13.258
    },
    {
      "id": "shot03-8",
      "text": "max_depth、",
      "start": 13.258,
      "end": 14.099
    },
    {
      "id": "shot03-9",
      "text": "min_samples_split、",
      "start": 14.099,
      "end": 15.541
    },
    {
      "id": "shot03-10",
      "text": "min_samples_leaf、",
      "start": 15.541,
      "end": 17.043
    },
    {
      "id": "shot03-11",
      "text": "min_impurity_decrease",
      "start": 17.043,
      "end": 18.445
    },
    {
      "id": "shot03-12",
      "text": "都可以看成预剪枝参数。",
      "start": 18.445,
      "end": 20.088
    },
    {
      "id": "shot03-13",
      "text": "预剪枝的好处是快，",
      "start": 20.584,
      "end": 22.138
    },
    {
      "id": "shot03-14",
      "text": "树一开始就不会长太复杂；",
      "start": 22.138,
      "end": 24.094
    },
    {
      "id": "shot03-15",
      "text": "缺点是有点贪心，",
      "start": 24.094,
      "end": 25.497
    },
    {
      "id": "shot03-16",
      "text": "可能某一刀短期看没提升，",
      "start": 25.497,
      "end": 27.563
    },
    {
      "id": "shot03-17",
      "text": "但后面继续切会变好，",
      "start": 27.563,
      "end": 29.348
    },
    {
      "id": "shot03-18",
      "text": "预剪枝会提前错过它。",
      "start": 29.348,
      "end": 31.173
    },
    {
      "id": "shot03-19",
      "text": "这里的“验证集表现”可以是准确率，",
      "start": 31.173,
      "end": 33.76
    },
    {
      "id": "shot03-20",
      "text": "也可以是其他业务指标。",
      "start": 33.76,
      "end": 35.925
    },
    {
      "id": "shot03-21",
      "text": "关键是不能只问训练集，",
      "start": 35.925,
      "end": 37.811
    },
    {
      "id": "shot03-22",
      "text": "因为训练集通常会奖励更复杂的树。",
      "start": 37.811,
      "end": 40.558
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "第二类叫后剪枝，",
      "start": 0.0,
      "end": 1.321
    },
    {
      "id": "shot04-1",
      "text": "英文 post-pruning。",
      "start": 1.321,
      "end": 2.961
    },
    {
      "id": "shot04-2",
      "text": "它先用训练集长出一棵比较完整的树，",
      "start": 2.961,
      "end": 6.043
    },
    {
      "id": "shot04-3",
      "text": "然后从底往上检查每个非叶节点：",
      "start": 6.043,
      "end": 9.304
    },
    {
      "id": "shot04-4",
      "text": "如果把这一整棵子树折成一个叶子，",
      "start": 9.304,
      "end": 12.286
    },
    {
      "id": "shot04-5",
      "text": "验证集表现更好，就剪掉；",
      "start": 12.286,
      "end": 14.847
    },
    {
      "id": "shot04-6",
      "text": "如果表现变差，",
      "start": 14.847,
      "end": 16.007
    },
    {
      "id": "shot04-7",
      "text": "就保留原子树。",
      "start": 16.007,
      "end": 17.808
    },
    {
      "id": "shot04-8",
      "text": "实际工程里还有一个更简单的口径：",
      "start": 17.808,
      "end": 20.651
    },
    {
      "id": "shot04-9",
      "text": "如果精度持平，",
      "start": 20.651,
      "end": 21.773
    },
    {
      "id": "shot04-10",
      "text": "也可以优先选更小的树，",
      "start": 21.773,
      "end": 23.915
    },
    {
      "id": "shot04-11",
      "text": "因为同样效果下更简单的模型更容易解释。",
      "start": 23.915,
      "end": 27.339
    },
    {
      "id": "shot04-12",
      "text": "后剪枝比预剪枝慢，",
      "start": 27.339,
      "end": 29.121
    },
    {
      "id": "shot04-13",
      "text": "因为要先长完整树，",
      "start": 29.121,
      "end": 30.623
    },
    {
      "id": "shot04-14",
      "text": "再逐个节点试。",
      "start": 30.623,
      "end": 31.624
    },
    {
      "id": "shot04-15",
      "text": "但它通常更稳，",
      "start": 32.165,
      "end": 33.408
    },
    {
      "id": "shot04-16",
      "text": "因为它先看到了完整结构，",
      "start": 33.408,
      "end": 35.432
    },
    {
      "id": "shot04-17",
      "text": "不容易因为早期某一步短期不划算就放弃后面",
      "start": 35.432,
      "end": 39.081
    },
    {
      "id": "shot04-18",
      "text": "的好分支。",
      "start": 39.081,
      "end": 40.163
    },
    {
      "id": "shot04-19",
      "text": "下一期案例里会看到两种口径的差别：",
      "start": 40.163,
      "end": 43.21
    },
    {
      "id": "shot04-20",
      "text": "教学案例常用“上升才剪”，",
      "start": 43.21,
      "end": 45.515
    },
    {
      "id": "shot04-21",
      "text": "工程里常见“持平也剪”。",
      "start": 45.515,
      "end": 48.021
    },
    {
      "id": "shot04-22",
      "text": "先记住原则，再看数字。",
      "start": 48.021,
      "end": 49.965
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "剪枝里最关键的数据分工是：",
      "start": 0.0,
      "end": 2.062
    },
    {
      "id": "shot05-1",
      "text": "训练集负责长树，",
      "start": 2.062,
      "end": 3.564
    },
    {
      "id": "shot05-2",
      "text": "验证集负责判断剪不剪。",
      "start": 3.564,
      "end": 5.526
    },
    {
      "id": "shot05-3",
      "text": "不能让同一批数据既当运动员又当裁判。",
      "start": 5.526,
      "end": 8.629
    },
    {
      "id": "shot05-4",
      "text": "如果只看训练集，",
      "start": 8.629,
      "end": 10.043
    },
    {
      "id": "shot05-5",
      "text": "树越复杂通常越好，",
      "start": 10.043,
      "end": 11.532
    },
    {
      "id": "shot05-6",
      "text": "因为它能记住更多细节。",
      "start": 11.532,
      "end": 13.734
    },
    {
      "id": "shot05-7",
      "text": "验证集的作用，",
      "start": 13.734,
      "end": 14.735
    },
    {
      "id": "shot05-8",
      "text": "是模拟没见过的新数据，",
      "start": 14.735,
      "end": 16.537
    },
    {
      "id": "shot05-9",
      "text": "告诉我们这条规则有没有泛化价值。",
      "start": 16.537,
      "end": 19.139
    },
    {
      "id": "shot05-10",
      "text": "实际工程里，",
      "start": 19.139,
      "end": 20.02
    },
    {
      "id": "shot05-11",
      "text": "sklearn 原生支持代价复杂度剪枝，",
      "start": 20.02,
      "end": 22.522
    },
    {
      "id": "shot05-12",
      "text": "也就是 ccp_alpha。",
      "start": 22.522,
      "end": 23.744
    },
    {
      "id": "shot05-13",
      "text": "常见做法是先拿 pruning path",
      "start": 24.278,
      "end": 26.563
    },
    {
      "id": "shot05-14",
      "text": "生成一串 alpha，",
      "start": 26.563,
      "end": 28.007
    },
    {
      "id": "shot05-15",
      "text": "再用交叉验证选最合适的 alpha。",
      "start": 28.007,
      "end": 30.873
    },
    {
      "id": "shot05-16",
      "text": "交叉验证可以看成把验证集裁判换成多轮裁",
      "start": 30.873,
      "end": 34.662
    },
    {
      "id": "shot05-17",
      "text": "判，",
      "start": 34.662,
      "end": 35.123
    },
    {
      "id": "shot05-18",
      "text": "减少一次划分带来的偶然性。数据越少，",
      "start": 35.123,
      "end": 38.531
    },
    {
      "id": "shot05-19",
      "text": "这一步越重要。",
      "start": 38.531,
      "end": 40.154
    },
    {
      "id": "shot05-20",
      "text": "这句话要和前面的过拟合连在一起：",
      "start": 40.154,
      "end": 42.891
    },
    {
      "id": "shot05-21",
      "text": "剪掉的不是知识，",
      "start": 42.891,
      "end": 44.344
    },
    {
      "id": "shot05-22",
      "text": "而是对训练样本偶然细节的记忆。",
      "start": 44.344,
      "end": 46.95
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期我们讲清楚了剪枝的两条路线。",
      "start": 0.0,
      "end": 2.921
    },
    {
      "id": "shot06-1",
      "text": "预剪枝边长边停，速度快，",
      "start": 2.921,
      "end": 5.262
    },
    {
      "id": "shot06-2",
      "text": "但容易欠拟合；",
      "start": 5.262,
      "end": 6.563
    },
    {
      "id": "shot06-3",
      "text": "后剪枝先长完整树再从底往上砍，成本更高，",
      "start": 6.563,
      "end": 10.424
    },
    {
      "id": "shot06-4",
      "text": "但通常更稳。",
      "start": 10.424,
      "end": 11.545
    },
    {
      "id": "shot06-5",
      "text": "无论哪一种，",
      "start": 11.545,
      "end": 12.345
    },
    {
      "id": "shot06-6",
      "text": "都要靠验证集判断规则值不值得保留。",
      "start": 12.345,
      "end": 15.726
    },
    {
      "id": "shot06-7",
      "text": "下一期我们把这件事放进具体案例：",
      "start": 15.726,
      "end": 18.448
    },
    {
      "id": "shot06-8",
      "text": "看一棵树什么时候该停，",
      "start": 18.448,
      "end": 20.228
    },
    {
      "id": "shot06-9",
      "text": "什么时候该砍，",
      "start": 20.228,
      "end": 21.349
    },
    {
      "id": "shot06-10",
      "text": "以及两种剪枝最后怎么取舍。",
      "start": 21.349,
      "end": 23.983
    },
    {
      "id": "shot06-11",
      "text": "剪枝不是把树随便剪小，",
      "start": 23.983,
      "end": 25.931
    },
    {
      "id": "shot06-12",
      "text": "而是把“复杂度”和“泛化表现”放在一起比",
      "start": 25.931,
      "end": 29.012
    },
    {
      "id": "shot06-13",
      "text": "较。",
      "start": 29.012,
      "end": 29.414
    },
    {
      "id": "shot06-14",
      "text": "能少一条没用规则，就少一条。",
      "start": 29.414,
      "end": 31.679
    },
    {
      "id": "shot06-15",
      "text": "这句话要和前面的过拟合连在一起：",
      "start": 32.146,
      "end": 35.064
    },
    {
      "id": "shot06-16",
      "text": "剪掉的不是知识，",
      "start": 35.064,
      "end": 36.398
    },
    {
      "id": "shot06-17",
      "text": "而是对训练样本偶然细节的记忆。",
      "start": 36.398,
      "end": 39.346
    },
    {
      "id": "shot06-18",
      "text": "这个判断会在下一期被具体化成节点级操作：",
      "start": 39.346,
      "end": 42.916
    },
    {
      "id": "shot06-19",
      "text": "每个节点都要比较剪前和剪后的验证集表现。",
      "start": 42.916,
      "end": 46.385
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.607
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.607,
      "end": 2.144
    }
  ]
}
