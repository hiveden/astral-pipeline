{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "想象后台导出 1000 条用户数据，",
      "start": 0.0,
      "end": 3.046
    },
    {
      "id": "shot01-1",
      "text": "只有年龄、月消费、",
      "start": 3.046,
      "end": 4.909
    },
    {
      "id": "shot01-2",
      "text": "登录频次这些特征，",
      "start": 4.909,
      "end": 6.512
    },
    {
      "id": "shot01-3",
      "text": "没有任何人告诉我们谁是高价值客户，",
      "start": 6.512,
      "end": 9.538
    },
    {
      "id": "shot01-4",
      "text": "谁是流失候选。",
      "start": 9.538,
      "end": 10.8
    },
    {
      "id": "shot01-5",
      "text": "运营同学却问：",
      "start": 10.8,
      "end": 12.103
    },
    {
      "id": "shot01-6",
      "text": "能不能先把用户分几群，",
      "start": 12.103,
      "end": 14.247
    },
    {
      "id": "shot01-7",
      "text": "方便做不同活动？",
      "start": 14.247,
      "end": 15.769
    },
    {
      "id": "shot01-8",
      "text": "这就是聚类要解决的问题。",
      "start": 15.769,
      "end": 18.154
    },
    {
      "id": "shot01-9",
      "text": "分类是拿已有标签去学答案，",
      "start": 18.154,
      "end": 20.759
    },
    {
      "id": "shot01-10",
      "text": "聚类是没有标签时，",
      "start": 20.759,
      "end": 22.402
    },
    {
      "id": "shot01-11",
      "text": "先让数据自己分堆。",
      "start": 22.402,
      "end": 23.885
    },
    {
      "id": "shot01-12",
      "text": "这一期我们先不写代码，",
      "start": 24.375,
      "end": 26.102
    },
    {
      "id": "shot01-13",
      "text": "先把聚类这件事讲清楚：",
      "start": 26.102,
      "end": 28.029
    },
    {
      "id": "shot01-14",
      "text": "它为什么属于无监督学习，",
      "start": 28.029,
      "end": 30.097
    },
    {
      "id": "shot01-15",
      "text": "英文 unsupervised",
      "start": 30.097,
      "end": 31.462
    },
    {
      "id": "shot01-16",
      "text": "learning，",
      "start": 31.462,
      "end": 31.964
    },
    {
      "id": "shot01-17",
      "text": "适合哪些业务场景，",
      "start": 31.964,
      "end": 33.55
    },
    {
      "id": "shot01-18",
      "text": "又为什么本章从 K-Means 开始。",
      "start": 33.55,
      "end": 35.678
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先用一个生活画面建立直觉。",
      "start": 0.0,
      "end": 2.362
    },
    {
      "id": "shot02-1",
      "text": "手机相册里有 1000 张照片，",
      "start": 2.362,
      "end": 4.704
    },
    {
      "id": "shot02-2",
      "text": "我们想粗略整理成人像、风景、票据、",
      "start": 4.704,
      "end": 7.946
    },
    {
      "id": "shot02-3",
      "text": "截图几堆。",
      "start": 7.946,
      "end": 9.047
    },
    {
      "id": "shot02-4",
      "text": "没人提前给每张照片贴标签，",
      "start": 9.047,
      "end": 11.609
    },
    {
      "id": "shot02-5",
      "text": "我们只能看它们像不像：",
      "start": 11.609,
      "end": 13.47
    },
    {
      "id": "shot02-6",
      "text": "颜色像不像，",
      "start": 13.47,
      "end": 14.691
    },
    {
      "id": "shot02-7",
      "text": "主体像不像，",
      "start": 14.691,
      "end": 15.792
    },
    {
      "id": "shot02-8",
      "text": "拍摄时间近不近。",
      "start": 15.792,
      "end": 17.593
    },
    {
      "id": "shot02-9",
      "text": "相册整理的第一步不是判断这张图一定是什么，",
      "start": 17.593,
      "end": 21.196
    },
    {
      "id": "shot02-10",
      "text": "而是先把彼此相似的东西放到一起。聚类，",
      "start": 21.196,
      "end": 24.659
    },
    {
      "id": "shot02-11",
      "text": "英文 Clustering，",
      "start": 24.659,
      "end": 25.96
    },
    {
      "id": "shot02-12",
      "text": "就是机器学习里的这件事。",
      "start": 25.96,
      "end": 27.962
    },
    {
      "id": "shot02-13",
      "text": "训练数据只有特征，没有标签，",
      "start": 27.962,
      "end": 30.563
    },
    {
      "id": "shot02-14",
      "text": "算法根据样本之间的相似性自动分堆。",
      "start": 30.563,
      "end": 33.386
    },
    {
      "id": "shot02-15",
      "text": "分出来的每一堆叫簇，",
      "start": 33.752,
      "end": 35.64
    },
    {
      "id": "shot02-16",
      "text": "英文 cluster。注意，",
      "start": 35.64,
      "end": 37.577
    },
    {
      "id": "shot02-17",
      "text": "簇的语义不是算法自己知道的，",
      "start": 37.577,
      "end": 39.756
    },
    {
      "id": "shot02-18",
      "text": "是人看完结果以后再解释出来的。",
      "start": 39.756,
      "end": 42.286
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "把分类和聚类放到一张图上看。",
      "start": 0.0,
      "end": 2.601
    },
    {
      "id": "shot03-1",
      "text": "分类是监督学习：",
      "start": 2.601,
      "end": 3.861
    },
    {
      "id": "shot03-2",
      "text": "样本进来时已经带着标签，",
      "start": 3.861,
      "end": 5.902
    },
    {
      "id": "shot03-3",
      "text": "比如用户 A 是高价值，",
      "start": 5.902,
      "end": 7.563
    },
    {
      "id": "shot03-4",
      "text": "用户 B 是流失，",
      "start": 7.563,
      "end": 8.723
    },
    {
      "id": "shot03-5",
      "text": "用户 C 是普通。",
      "start": 8.723,
      "end": 10.204
    },
    {
      "id": "shot03-6",
      "text": "模型要学的是特征到标签的映射。",
      "start": 10.204,
      "end": 13.325
    },
    {
      "id": "shot03-7",
      "text": "聚类是无监督学习：",
      "start": 13.325,
      "end": 14.825
    },
    {
      "id": "shot03-8",
      "text": "样本进来时没有标签，只有年龄、消费、",
      "start": 14.825,
      "end": 17.807
    },
    {
      "id": "shot03-9",
      "text": "频次这些数字。",
      "start": 17.807,
      "end": 19.067
    },
    {
      "id": "shot03-10",
      "text": "模型要学的不是谁对应哪个现成答案，",
      "start": 19.067,
      "end": 22.033
    },
    {
      "id": "shot03-11",
      "text": "而是哪些样本彼此更像。",
      "start": 22.033,
      "end": 24.337
    },
    {
      "id": "shot03-12",
      "text": "这个差别会带来一个重要后果：",
      "start": 24.337,
      "end": 26.702
    },
    {
      "id": "shot03-13",
      "text": "分类可以用真实标签判对错，",
      "start": 26.702,
      "end": 29.227
    },
    {
      "id": "shot03-14",
      "text": "聚类没有唯一标准答案。",
      "start": 29.227,
      "end": 30.81
    },
    {
      "id": "shot03-15",
      "text": "距离怎么定义，",
      "start": 31.265,
      "end": 32.43
    },
    {
      "id": "shot03-16",
      "text": "特征怎么选，",
      "start": 32.43,
      "end": 33.433
    },
    {
      "id": "shot03-17",
      "text": "业务想分粗还是分细，",
      "start": 33.433,
      "end": 35.622
    },
    {
      "id": "shot03-18",
      "text": "都会影响最后的簇。",
      "start": 35.622,
      "end": 37.348
    },
    {
      "id": "shot03-19",
      "text": "聚类不是找标准答案，",
      "start": 37.348,
      "end": 39.195
    },
    {
      "id": "shot03-20",
      "text": "而是先给业务一个可解释的分堆方式。",
      "start": 39.195,
      "end": 42.227
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "聚类的应用看起来很散，",
      "start": 0.0,
      "end": 1.883
    },
    {
      "id": "shot04-1",
      "text": "其实都满足同一个条件：",
      "start": 1.883,
      "end": 3.565
    },
    {
      "id": "shot04-2",
      "text": "没有便宜的标签，",
      "start": 3.565,
      "end": 4.967
    },
    {
      "id": "shot04-3",
      "text": "但我们怀疑数据里面有结构。",
      "start": 4.967,
      "end": 7.01
    },
    {
      "id": "shot04-4",
      "text": "第一类是用户画像。",
      "start": 7.01,
      "end": 8.492
    },
    {
      "id": "shot04-5",
      "text": "电商有很多用户行为，",
      "start": 8.492,
      "end": 10.274
    },
    {
      "id": "shot04-6",
      "text": "先聚成几群，",
      "start": 10.274,
      "end": 11.356
    },
    {
      "id": "shot04-7",
      "text": "再对高频高客单用户推会员活动，",
      "start": 11.356,
      "end": 14.22
    },
    {
      "id": "shot04-8",
      "text": "对沉睡用户发召回券。",
      "start": 14.22,
      "end": 16.423
    },
    {
      "id": "shot04-9",
      "text": "第二类是异常检测。",
      "start": 16.423,
      "end": 18.065
    },
    {
      "id": "shot04-10",
      "text": "信用卡交易里，",
      "start": 18.065,
      "end": 19.127
    },
    {
      "id": "shot04-11",
      "text": "绝大多数交易会形成几个正常簇，",
      "start": 19.127,
      "end": 21.971
    },
    {
      "id": "shot04-12",
      "text": "离所有簇都很远的点，",
      "start": 21.971,
      "end": 23.773
    },
    {
      "id": "shot04-13",
      "text": "就值得人工复核。",
      "start": 23.773,
      "end": 25.436
    },
    {
      "id": "shot04-14",
      "text": "第三类是图像分割。",
      "start": 25.436,
      "end": 26.757
    },
    {
      "id": "shot04-15",
      "text": "把一张图片里的每个像素当成样本，",
      "start": 27.321,
      "end": 30.087
    },
    {
      "id": "shot04-16",
      "text": "用颜色特征聚类，",
      "start": 30.087,
      "end": 31.69
    },
    {
      "id": "shot04-17",
      "text": "再把每个像素替换成所属簇的中心颜色，",
      "start": 31.69,
      "end": 35.177
    },
    {
      "id": "shot04-18",
      "text": "图片就会变成少数几种颜色的色块图。",
      "start": 35.177,
      "end": 38.323
    },
    {
      "id": "shot04-19",
      "text": "输入可以是用户、交易，",
      "start": 38.323,
      "end": 40.267
    },
    {
      "id": "shot04-20",
      "text": "也可以是像素。",
      "start": 40.267,
      "end": 41.59
    },
    {
      "id": "shot04-21",
      "text": "只要能编码成定长特征，",
      "start": 41.59,
      "end": 43.714
    },
    {
      "id": "shot04-22",
      "text": "聚类就有机会跑起来。",
      "start": 43.714,
      "end": 45.438
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "聚类算法很多，",
      "start": 0.0,
      "end": 1.181
    },
    {
      "id": "shot05-1",
      "text": "可以先用两条轴理解。",
      "start": 1.181,
      "end": 2.883
    },
    {
      "id": "shot05-2",
      "text": "第一条轴是颗粒度。",
      "start": 2.883,
      "end": 4.465
    },
    {
      "id": "shot05-3",
      "text": "同样 1000 个用户，",
      "start": 4.465,
      "end": 6.127
    },
    {
      "id": "shot05-4",
      "text": "K=2 可以粗分成活跃和沉睡，",
      "start": 6.127,
      "end": 8.991
    },
    {
      "id": "shot05-5",
      "text": "K=20 可以切成更细的人群标签。",
      "start": 8.991,
      "end": 12.195
    },
    {
      "id": "shot05-6",
      "text": "没有绝对正确的 K，",
      "start": 12.195,
      "end": 13.616
    },
    {
      "id": "shot05-7",
      "text": "业务用途决定颗粒度。",
      "start": 13.616,
      "end": 15.319
    },
    {
      "id": "shot05-8",
      "text": "第二条轴是实现方法。",
      "start": 15.319,
      "end": 17.401
    },
    {
      "id": "shot05-9",
      "text": "K-Means 属于划分式聚类，",
      "start": 17.401,
      "end": 19.646
    },
    {
      "id": "shot05-10",
      "text": "核心是离哪个质心最近，",
      "start": 19.646,
      "end": 21.59
    },
    {
      "id": "shot05-11",
      "text": "就归到哪个簇。质心，",
      "start": 21.59,
      "end": 23.234
    },
    {
      "id": "shot05-12",
      "text": "英文 centroid，",
      "start": 23.234,
      "end": 24.336
    },
    {
      "id": "shot05-13",
      "text": "可以先理解成一簇样本的平均位置。",
      "start": 24.336,
      "end": 27.002
    },
    {
      "id": "shot05-14",
      "text": "层次聚类把数据逐层合并或分裂，",
      "start": 27.002,
      "end": 29.948
    },
    {
      "id": "shot05-15",
      "text": "适合看层级关系。",
      "start": 29.948,
      "end": 31.11
    },
    {
      "id": "shot05-16",
      "text": "DBSCAN 按密度连通来分簇，",
      "start": 31.584,
      "end": 35.072
    },
    {
      "id": "shot05-17",
      "text": "适合弯月形、",
      "start": 35.072,
      "end": 36.174
    },
    {
      "id": "shot05-18",
      "text": "噪声多的数据。",
      "start": 36.174,
      "end": 37.477
    },
    {
      "id": "shot05-19",
      "text": "谱聚类把数据看成图再处理，",
      "start": 37.477,
      "end": 39.602
    },
    {
      "id": "shot05-20",
      "text": "适合更复杂的结构。",
      "start": 39.602,
      "end": 41.165
    },
    {
      "id": "shot05-21",
      "text": "本章先选 K-Means，",
      "start": 41.165,
      "end": 42.668
    },
    {
      "id": "shot05-22",
      "text": "是因为它只需要距离和平均两个概念，",
      "start": 42.668,
      "end": 45.555
    },
    {
      "id": "shot05-23",
      "text": "工程接口常见，",
      "start": 45.555,
      "end": 46.877
    },
    {
      "id": "shot05-24",
      "text": "后面的评估指标也容易接上。",
      "start": 46.877,
      "end": 48.701
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.062
    },
    {
      "id": "shot06-1",
      "text": "我们建立了聚类的入口：第一，",
      "start": 1.062,
      "end": 3.388
    },
    {
      "id": "shot06-2",
      "text": "聚类是无监督学习，",
      "start": 3.388,
      "end": 4.831
    },
    {
      "id": "shot06-3",
      "text": "训练数据只有特征，没有标签；第二，",
      "start": 4.831,
      "end": 7.718
    },
    {
      "id": "shot06-4",
      "text": "聚类输出的是簇编号，",
      "start": 7.718,
      "end": 9.402
    },
    {
      "id": "shot06-5",
      "text": "业务含义要靠人事后解释；第三，",
      "start": 9.402,
      "end": 12.028
    },
    {
      "id": "shot06-6",
      "text": "聚类适合没有现成标签、",
      "start": 12.028,
      "end": 13.812
    },
    {
      "id": "shot06-7",
      "text": "但数据可能有结构的场景；第四，",
      "start": 13.812,
      "end": 16.478
    },
    {
      "id": "shot06-8",
      "text": "K-Means 是一个好的入门",
      "start": 16.478,
      "end": 18.162
    },
    {
      "id": "shot06-9",
      "text": "baseline，",
      "start": 18.162,
      "end": 18.824
    },
    {
      "id": "shot06-10",
      "text": "但不是所有数据形状都适合它。",
      "start": 18.824,
      "end": 20.989
    },
    {
      "id": "shot06-11",
      "text": "我们点到但没有展开的内容有两个：",
      "start": 21.215,
      "end": 23.92
    },
    {
      "id": "shot06-12",
      "text": "相似性度量会怎样影响结果，",
      "start": 23.92,
      "end": 26.425
    },
    {
      "id": "shot06-13",
      "text": "后面会在距离和指标里继续出现；",
      "start": 26.425,
      "end": 29.011
    },
    {
      "id": "shot06-14",
      "text": "DBSCAN、",
      "start": 29.011,
      "end": 30.547
    },
    {
      "id": "shot06-15",
      "text": "谱聚类这些算法，",
      "start": 30.547,
      "end": 31.816
    },
    {
      "id": "shot06-16",
      "text": "本章只做对照，",
      "start": 31.816,
      "end": 33.039
    },
    {
      "id": "shot06-17",
      "text": "不展开细节。",
      "start": 33.039,
      "end": 34.141
    },
    {
      "id": "shot06-18",
      "text": "下一期我们进入代码，",
      "start": 34.141,
      "end": 35.864
    },
    {
      "id": "shot06-19",
      "text": "用 sklearn 的 K-Means",
      "start": 35.864,
      "end": 37.568
    },
    {
      "id": "shot06-20",
      "text": "API 跑第一版聚类。",
      "start": 37.568,
      "end": 39.071
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.708
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.708,
      "end": 2.144
    }
  ]
}
