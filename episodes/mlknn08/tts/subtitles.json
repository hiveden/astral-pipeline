{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们讲清楚了为什么必须缩放——",
      "start": 0.0,
      "end": 3.1
    },
    {
      "id": "shot01-1",
      "text": "KNN 距离把维度差直接相加，",
      "start": 3.1,
      "end": 6.82
    },
    {
      "id": "shot01-2",
      "text": "量纲不齐就会被数值大的特征独裁。",
      "start": 6.82,
      "end": 10.24
    },
    {
      "id": "shot01-3",
      "text": "这一期我们看第一种主流缩放方法：归一化，",
      "start": 10.24,
      "end": 13.5
    },
    {
      "id": "shot01-4",
      "text": "英文 Min-Max",
      "start": 13.5,
      "end": 15.22
    },
    {
      "id": "shot01-5",
      "text": "normalization。",
      "start": 15.22,
      "end": 16.74
    },
    {
      "id": "shot01-6",
      "text": "一句话概括它的目的：",
      "start": 16.74,
      "end": 18.74
    },
    {
      "id": "shot01-7",
      "text": "把每一个特征都压到 0 到 1 这个固定区间，",
      "start": 18.74,
      "end": 22.38
    },
    {
      "id": "shot01-8",
      "text": "让每个特征在距离公式里贡献相等。",
      "start": 22.38,
      "end": 25.96
    },
    {
      "id": "shot01-9",
      "text": "这一期我们走完三件事：",
      "start": 25.96,
      "end": 28.04
    },
    {
      "id": "shot01-10",
      "text": "公式两步怎么算，",
      "start": 28.04,
      "end": 29.68
    },
    {
      "id": "shot01-11",
      "text": "sklearn 三步怎么用，",
      "start": 29.68,
      "end": 31.76
    },
    {
      "id": "shot01-12",
      "text": "以及一个常被忽略的副作用——它对异常值很敏感。",
      "start": 31.76,
      "end": 35.717
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "归一化的公式很短：",
      "start": 0.0,
      "end": 1.58
    },
    {
      "id": "shot02-1",
      "text": "x 撇等于 x 减去最小值，",
      "start": 1.58,
      "end": 4.48
    },
    {
      "id": "shot02-2",
      "text": "除以最大值减最小值。语言版：",
      "start": 4.48,
      "end": 7.02
    },
    {
      "id": "shot02-3",
      "text": "每一个原始值减去这一列的最小值，",
      "start": 7.02,
      "end": 10.28
    },
    {
      "id": "shot02-4",
      "text": "再除以这一列的跨度。",
      "start": 10.28,
      "end": 12.28
    },
    {
      "id": "shot02-5",
      "text": "每一列各自算自己的 min 和 max—",
      "start": 12.28,
      "end": 15.04
    },
    {
      "id": "shot02-6",
      "text": "—身高列用身高的最小最大，",
      "start": 15.04,
      "end": 17.72
    },
    {
      "id": "shot02-7",
      "text": "体重列用体重的最小最大，",
      "start": 17.72,
      "end": 20.08
    },
    {
      "id": "shot02-8",
      "text": "视力列用视力的最小最大。",
      "start": 20.08,
      "end": 22.0
    },
    {
      "id": "shot02-9",
      "text": "算完每一列的最小值变成 0，",
      "start": 22.0,
      "end": 24.58
    },
    {
      "id": "shot02-10",
      "text": "最大值变成 1，",
      "start": 24.58,
      "end": 25.64
    },
    {
      "id": "shot02-11",
      "text": "中间所有值线性插到 0 到 1 之间。",
      "start": 25.64,
      "end": 29.32
    },
    {
      "id": "shot02-12",
      "text": "我们用上一期的 8 个健康样本试一下。",
      "start": 29.32,
      "end": 32.0
    },
    {
      "id": "shot02-13",
      "text": "体重列从 65 公斤到 110 公斤，",
      "start": 32.43,
      "end": 35.45
    },
    {
      "id": "shot02-14",
      "text": "min 65、",
      "start": 35.45,
      "end": 36.07
    },
    {
      "id": "shot02-15",
      "text": "max 110、",
      "start": 36.07,
      "end": 36.93
    },
    {
      "id": "shot02-16",
      "text": "跨度 45。",
      "start": 36.93,
      "end": 38.43
    },
    {
      "id": "shot02-17",
      "text": "第一个体重 70 公斤，",
      "start": 38.43,
      "end": 40.45
    },
    {
      "id": "shot02-18",
      "text": "缩放后是 70 减 65 等于 5，",
      "start": 40.45,
      "end": 43.31
    },
    {
      "id": "shot02-19",
      "text": "除以 45 等于 0.111。",
      "start": 43.31,
      "end": 45.71
    },
    {
      "id": "shot02-20",
      "text": "最小那个体重 65 缩放后是 0，",
      "start": 45.71,
      "end": 48.37
    },
    {
      "id": "shot02-21",
      "text": "最大那个 110 缩放后是 1。",
      "start": 48.37,
      "end": 50.91
    },
    {
      "id": "shot02-22",
      "text": "同样规则套到身高、视力，",
      "start": 50.91,
      "end": 53.29
    },
    {
      "id": "shot02-23",
      "text": "三列各自被压到 0 到 1。",
      "start": 53.29,
      "end": 55.33
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "公式一行写完，",
      "start": 0.0,
      "end": 1.4
    },
    {
      "id": "shot03-1",
      "text": "但里面包含两个动作。",
      "start": 1.4,
      "end": 3.24
    },
    {
      "id": "shot03-2",
      "text": "第一个动作叫平移：",
      "start": 3.24,
      "end": 5.0
    },
    {
      "id": "shot03-3",
      "text": "每个值减去最小值。",
      "start": 5.0,
      "end": 6.96
    },
    {
      "id": "shot03-4",
      "text": "这一步等于把整个分布的起点拉到 0——曲",
      "start": 6.96,
      "end": 10.94
    },
    {
      "id": "shot03-5",
      "text": "线形状一点没变，",
      "start": 10.94,
      "end": 12.52
    },
    {
      "id": "shot03-6",
      "text": "整体往左挪。",
      "start": 12.52,
      "end": 14.24
    },
    {
      "id": "shot03-7",
      "text": "体重列原本起点是 65 公斤，",
      "start": 14.24,
      "end": 17.44
    },
    {
      "id": "shot03-8",
      "text": "平移后起点变成 0，",
      "start": 17.44,
      "end": 19.48
    },
    {
      "id": "shot03-9",
      "text": "跨度还是 45。",
      "start": 19.48,
      "end": 21.04
    },
    {
      "id": "shot03-10",
      "text": "第二个动作叫缩放：",
      "start": 21.04,
      "end": 22.98
    },
    {
      "id": "shot03-11",
      "text": "除以跨度 45。",
      "start": 22.98,
      "end": 24.48
    },
    {
      "id": "shot03-12",
      "text": "这一步把跨度从 45 压到 1，",
      "start": 24.48,
      "end": 27.7
    },
    {
      "id": "shot03-13",
      "text": "相邻样本之间的距离也按比例缩。",
      "start": 27.7,
      "end": 31.06
    },
    {
      "id": "shot03-14",
      "text": "体重列变成从 0 到 1，",
      "start": 31.06,
      "end": 33.42
    },
    {
      "id": "shot03-15",
      "text": "曲线形状还是没变。",
      "start": 33.42,
      "end": 35.16
    },
    {
      "id": "shot03-16",
      "text": "两步配合下来：",
      "start": 35.534,
      "end": 37.074
    },
    {
      "id": "shot03-17",
      "text": "起点对齐到 0，",
      "start": 37.074,
      "end": 38.934
    },
    {
      "id": "shot03-18",
      "text": "跨度压到 1，",
      "start": 38.934,
      "end": 40.694
    },
    {
      "id": "shot03-19",
      "text": "每一列都进了同一把 0 到 1 的尺子。",
      "start": 40.694,
      "end": 44.194
    },
    {
      "id": "shot03-20",
      "text": "这里有个关键性质：",
      "start": 44.194,
      "end": 46.154
    },
    {
      "id": "shot03-21",
      "text": "相邻样本之间的相对距离比例完全保留——5",
      "start": 46.154,
      "end": 50.134
    },
    {
      "id": "shot03-22",
      "text": "公斤和 7 公斤之间的差距，",
      "start": 50.134,
      "end": 52.494
    },
    {
      "id": "shot03-23",
      "text": "缩放前占总跨度的多少，",
      "start": 52.494,
      "end": 54.954
    },
    {
      "id": "shot03-24",
      "text": "缩放后还是占多少。",
      "start": 54.954,
      "end": 56.934
    },
    {
      "id": "shot03-25",
      "text": "这就是线性变换的核心：",
      "start": 56.934,
      "end": 59.034
    },
    {
      "id": "shot03-26",
      "text": "保比例。",
      "start": 59.034,
      "end": 60.234
    },
    {
      "id": "shot03-27",
      "text": "这也正是 KNN 在缩放后还能保持邻居关系的根基。",
      "start": 60.234,
      "end": 64.394
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "现在看 sklearn 怎么调。三步。",
      "start": 0.0,
      "end": 2.96
    },
    {
      "id": "shot04-1",
      "text": "第一步导包 MinMaxScaler。",
      "start": 2.96,
      "end": 5.08
    },
    {
      "id": "shot04-2",
      "text": "第二步实例化加",
      "start": 5.08,
      "end": 6.54
    },
    {
      "id": "shot04-3",
      "text": "fit_transform，",
      "start": 6.54,
      "end": 7.74
    },
    {
      "id": "shot04-4",
      "text": "把训练数据缩放。",
      "start": 7.74,
      "end": 8.96
    },
    {
      "id": "shot04-5",
      "text": "这一行干两件事：",
      "start": 8.96,
      "end": 10.64
    },
    {
      "id": "shot04-6",
      "text": "fit 是看一遍训练数据记下每列的",
      "start": 10.64,
      "end": 13.28
    },
    {
      "id": "shot04-7",
      "text": "min 和 max，",
      "start": 13.28,
      "end": 14.08
    },
    {
      "id": "shot04-8",
      "text": "transform 是套公式 x 减",
      "start": 14.08,
      "end": 16.36
    },
    {
      "id": "shot04-9",
      "text": "min 除以跨度。",
      "start": 16.36,
      "end": 17.72
    },
    {
      "id": "shot04-10",
      "text": "第三步训练 KNN，",
      "start": 17.72,
      "end": 19.34
    },
    {
      "id": "shot04-11",
      "text": "把缩放后的数据喂给",
      "start": 19.34,
      "end": 21.02
    },
    {
      "id": "shot04-12",
      "text": "KNeighborsClassifier。",
      "start": 21.02,
      "end": 22.24
    },
    {
      "id": "shot04-13",
      "text": "这里有一个特别容易踩坑的地方：",
      "start": 22.662,
      "end": 25.322
    },
    {
      "id": "shot04-14",
      "text": "预测新数据时，",
      "start": 25.322,
      "end": 26.522
    },
    {
      "id": "shot04-15",
      "text": "必须用同一个 scaler 的",
      "start": 26.522,
      "end": 28.382
    },
    {
      "id": "shot04-16",
      "text": "transform，",
      "start": 28.382,
      "end": 28.822
    },
    {
      "id": "shot04-17",
      "text": "不能再 fit 一次。",
      "start": 28.822,
      "end": 30.742
    },
    {
      "id": "shot04-18",
      "text": "它会用刚才训练数据记下的 min 和max，",
      "start": 30.742,
      "end": 33.662
    },
    {
      "id": "shot04-19",
      "text": "把新数据按同一把尺子缩。",
      "start": 33.662,
      "end": 36.222
    },
    {
      "id": "shot04-20",
      "text": "如果新数据再 fit 一次，",
      "start": 36.222,
      "end": 39.202
    },
    {
      "id": "shot04-21",
      "text": "缩出来的 0 和 1 跟训练那把尺子不是同一把，",
      "start": 39.202,
      "end": 42.862
    },
    {
      "id": "shot04-22",
      "text": "KNN 找邻居就乱了。",
      "start": 42.862,
      "end": 44.482
    },
    {
      "id": "shot04-23",
      "text": "这个动作记住一句话：",
      "start": 44.482,
      "end": 46.302
    },
    {
      "id": "shot04-24",
      "text": "训练 fit 一次，",
      "start": 46.302,
      "end": 47.662
    },
    {
      "id": "shot04-25",
      "text": "预测只 transform。",
      "start": 47.662,
      "end": 49.182
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "代码讲完，",
      "start": 0.0,
      "end": 1.02
    },
    {
      "id": "shot05-1",
      "text": "打开 marimo demo 看现场翻转。",
      "start": 1.02,
      "end": 3.24
    },
    {
      "id": "shot05-2",
      "text": "屏幕上是上一期 8 个健康样本，",
      "start": 3.24,
      "end": 6.1
    },
    {
      "id": "shot05-3",
      "text": "散点图 y 轴是体重，",
      "start": 6.1,
      "end": 8.24
    },
    {
      "id": "shot05-4",
      "text": "4 个健康在下半、",
      "start": 8.24,
      "end": 9.58
    },
    {
      "id": "shot05-5",
      "text": "4 个不健康在上半，",
      "start": 9.58,
      "end": 11.5
    },
    {
      "id": "shot05-6",
      "text": "区别主要在体重和视力。",
      "start": 11.5,
      "end": 13.78
    },
    {
      "id": "shot05-7",
      "text": "左边模型参数：k 滑块、",
      "start": 13.78,
      "end": 15.74
    },
    {
      "id": "shot05-8",
      "text": "缩放下拉、",
      "start": 15.74,
      "end": 17.01
    },
    {
      "id": "shot05-9",
      "text": "异常值开关。",
      "start": 17.01,
      "end": 17.96
    },
    {
      "id": "shot05-10",
      "text": "右边新人特征三滑块。",
      "start": 17.96,
      "end": 20.26
    },
    {
      "id": "shot05-11",
      "text": "中间彩色 callout 显示当前预测。",
      "start": 20.26,
      "end": 23.1
    },
    {
      "id": "shot05-12",
      "text": "下面两张散点图：",
      "start": 23.1,
      "end": 24.76
    },
    {
      "id": "shot05-13",
      "text": "左 Raw 原始量纲、",
      "start": 24.76,
      "end": 26.3
    },
    {
      "id": "shot05-14",
      "text": "右是缩放后。",
      "start": 26.3,
      "end": 27.2
    },
    {
      "id": "shot05-15",
      "text": "先把缩放下拉保持 None，",
      "start": 27.581,
      "end": 30.241
    },
    {
      "id": "shot05-16",
      "text": "新人调到身高 175、",
      "start": 30.241,
      "end": 32.541
    },
    {
      "id": "shot05-17",
      "text": "体重 85、",
      "start": 32.541,
      "end": 33.801
    },
    {
      "id": "shot05-18",
      "text": "视力 1.7——一个有点偏胖但视力很好的人。看预测：",
      "start": 33.801,
      "end": 38.301
    },
    {
      "id": "shot05-19",
      "text": "不健康。",
      "start": 38.301,
      "end": 39.621
    },
    {
      "id": "shot05-20",
      "text": "距离明细表前 3 个邻居有 2 个不健康",
      "start": 39.621,
      "end": 43.141
    },
    {
      "id": "shot05-21",
      "text": "——因为体重 85 跟不健康组的 92、",
      "start": 43.141,
      "end": 46.081
    },
    {
      "id": "shot05-22",
      "text": "95 在体重轴上贴近，",
      "start": 46.081,
      "end": 48.341
    },
    {
      "id": "shot05-23",
      "text": "而视力 1.7 这个关键健康指标跨度太小被淹没。",
      "start": 48.341,
      "end": 52.341
    },
    {
      "id": "shot05-24",
      "text": "现在切缩放下拉到",
      "start": 52.341,
      "end": 54.281
    },
    {
      "id": "shot05-25",
      "text": "MinMaxScaler，其他不动。",
      "start": 54.281,
      "end": 56.341
    },
    {
      "id": "shot05-26",
      "text": "看预测：",
      "start": 56.341,
      "end": 57.521
    },
    {
      "id": "shot05-27",
      "text": "翻成健康。",
      "start": 57.521,
      "end": 59.081
    },
    {
      "id": "shot05-28",
      "text": "前 3 个邻居全是健康。",
      "start": 59.081,
      "end": 60.881
    },
    {
      "id": "shot05-29",
      "text": "右边那张图变成 0 到 1 的方格，",
      "start": 61.248,
      "end": 64.188
    },
    {
      "id": "shot05-30",
      "text": "三个特征公平贡献，",
      "start": 64.188,
      "end": 65.958
    },
    {
      "id": "shot05-31",
      "text": "视力 1.7 这一维终于有了影响——它属",
      "start": 65.958,
      "end": 69.068
    },
    {
      "id": "shot05-32",
      "text": "于健康那组的特征。同样数据、同样 k，",
      "start": 69.068,
      "end": 72.068
    },
    {
      "id": "shot05-33",
      "text": "唯一变化是开了归一化，",
      "start": 72.068,
      "end": 74.328
    },
    {
      "id": "shot05-34",
      "text": "预测就翻转。",
      "start": 74.328,
      "end": 75.268
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "归一化看着很完美，",
      "start": 0.0,
      "end": 1.86
    },
    {
      "id": "shot06-1",
      "text": "但有一个局限——它对上一期讲过的异常值很敏感。",
      "start": 1.86,
      "end": 5.88
    },
    {
      "id": "shot06-2",
      "text": "打开异常值开关——这个开关会往训练集塞一",
      "start": 5.88,
      "end": 9.24
    },
    {
      "id": "shot06-3",
      "text": "个体重 250 公斤的离谱值，",
      "start": 9.24,
      "end": 12.0
    },
    {
      "id": "shot06-4",
      "text": "模拟数据录错。",
      "start": 12.0,
      "end": 13.19
    },
    {
      "id": "shot06-5",
      "text": "看屏幕。",
      "start": 13.19,
      "end": 14.56
    },
    {
      "id": "shot06-6",
      "text": "缩放参数表里体重列的 min 还是 65，",
      "start": 14.56,
      "end": 17.68
    },
    {
      "id": "shot06-7",
      "text": "但 max 被拉到 250，",
      "start": 17.68,
      "end": 19.88
    },
    {
      "id": "shot06-8",
      "text": "跨度从 45 暴涨到 185。",
      "start": 19.88,
      "end": 22.54
    },
    {
      "id": "shot06-9",
      "text": "原本的 110 公斤现在只缩到 0.243。",
      "start": 22.54,
      "end": 25.86
    },
    {
      "id": "shot06-10",
      "text": "也就是说，",
      "start": 26.279,
      "end": 27.019
    },
    {
      "id": "shot06-11",
      "text": "原本占满 0 到 1 区间的 8 个正常样本，",
      "start": 27.019,
      "end": 30.959
    },
    {
      "id": "shot06-12",
      "text": "被压扁到 0 到 0.24 这个角落里—",
      "start": 30.959,
      "end": 34.559
    },
    {
      "id": "shot06-13",
      "text": "—剩下 75% 的区间被一个异常值占据。",
      "start": 34.559,
      "end": 38.199
    },
    {
      "id": "shot06-14",
      "text": "直接后果：",
      "start": 38.199,
      "end": 39.579
    },
    {
      "id": "shot06-15",
      "text": "8 个正常样本之间的体重差距被压缩了 4倍多。",
      "start": 39.579,
      "end": 44.119
    },
    {
      "id": "shot06-16",
      "text": "本来能区分健康和不健康两组的差距，",
      "start": 44.119,
      "end": 47.659
    },
    {
      "id": "shot06-17",
      "text": "现在距离上几乎贴在一起，",
      "start": 47.659,
      "end": 50.499
    },
    {
      "id": "shot06-18",
      "text": "KNN 区分度被严重削弱。",
      "start": 50.499,
      "end": 52.919
    },
    {
      "id": "shot06-19",
      "text": "一句话总结：",
      "start": 53.326,
      "end": 54.566
    },
    {
      "id": "shot06-20",
      "text": "归一化的尺子由 min 和 max 决定，",
      "start": 54.566,
      "end": 57.526
    },
    {
      "id": "shot06-21",
      "text": "min 和 max 是单点决定的——一个",
      "start": 57.526,
      "end": 60.126
    },
    {
      "id": "shot06-22",
      "text": "异常值就能撑开整个区间的尺度。",
      "start": 60.126,
      "end": 62.886
    },
    {
      "id": "shot06-23",
      "text": "这也是教材标注它适合传统精确小数据场景的原因。",
      "start": 62.886,
      "end": 67.226
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "归一化做一个总结。优点：",
      "start": 0.0,
      "end": 2.6
    },
    {
      "id": "shot07-1",
      "text": "固定输出区间是严格的 0 到 1，",
      "start": 2.6,
      "end": 5.5
    },
    {
      "id": "shot07-2",
      "text": "KNN 各特征贡献完全可比，",
      "start": 5.5,
      "end": 8.28
    },
    {
      "id": "shot07-3",
      "text": "几何上很直观。缺点：",
      "start": 8.28,
      "end": 10.44
    },
    {
      "id": "shot07-4",
      "text": "因为依赖 min 和 max，",
      "start": 10.44,
      "end": 12.74
    },
    {
      "id": "shot07-5",
      "text": "单个异常值就能决定整列尺子的范围，",
      "start": 12.74,
      "end": 16.14
    },
    {
      "id": "shot07-6",
      "text": "KNN 在缩放后区分度反而下降。",
      "start": 16.14,
      "end": 19.82
    },
    {
      "id": "shot07-7",
      "text": "所以它的主场是数据本身比较干净、规模小、",
      "start": 19.82,
      "end": 23.26
    },
    {
      "id": "shot07-8",
      "text": "特征上下界已知的场景——比如图像像素天然",
      "start": 23.26,
      "end": 27.64
    },
    {
      "id": "shot07-9",
      "text": "就是 0 到 255，",
      "start": 27.64,
      "end": 29.14
    },
    {
      "id": "shot07-10",
      "text": "或者评分系统已知是 1 到 10——这些",
      "start": 29.14,
      "end": 32.66
    },
    {
      "id": "shot07-11",
      "text": "场景下没有异常值拉飞的风险，",
      "start": 32.66,
      "end": 35.327
    },
    {
      "id": "shot07-12",
      "text": "归一化是首选。",
      "start": 35.327,
      "end": 36.64
    },
    {
      "id": "shot07-13",
      "text": "如果数据比较嘈杂，",
      "start": 37.09,
      "end": 38.63
    },
    {
      "id": "shot07-14",
      "text": "或者经常会有异常值进来，",
      "start": 38.63,
      "end": 40.91
    },
    {
      "id": "shot07-15",
      "text": "就要换下一种工具：标准化。",
      "start": 40.91,
      "end": 43.444
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.32
    },
    {
      "id": "shot08-1",
      "text": "我们讲清楚了三件事：",
      "start": 1.32,
      "end": 3.267
    },
    {
      "id": "shot08-2",
      "text": "归一化的 Min-Max 公式两步——先",
      "start": 3.267,
      "end": 6.34
    },
    {
      "id": "shot08-3",
      "text": "平移到起点 0、",
      "start": 6.34,
      "end": 8.0
    },
    {
      "id": "shot08-4",
      "text": "再缩放到跨度 1；",
      "start": 8.0,
      "end": 10.1
    },
    {
      "id": "shot08-5",
      "text": "sklearn 的",
      "start": 10.1,
      "end": 11.06
    },
    {
      "id": "shot08-6",
      "text": "MinMaxScaler 三步走以及那个",
      "start": 11.06,
      "end": 13.34
    },
    {
      "id": "shot08-7",
      "text": "训练 fit 一次预测只",
      "start": 13.34,
      "end": 15.36
    },
    {
      "id": "shot08-8",
      "text": "transform 的关键纪律；",
      "start": 15.36,
      "end": 17.127
    },
    {
      "id": "shot08-9",
      "text": "归一化的副作用——min 和 max 由",
      "start": 17.127,
      "end": 19.76
    },
    {
      "id": "shot08-10",
      "text": "单点决定，",
      "start": 19.76,
      "end": 21.36
    },
    {
      "id": "shot08-11",
      "text": "一个异常值就能让 KNN 区分度大幅下降。",
      "start": 21.36,
      "end": 24.58
    },
    {
      "id": "shot08-12",
      "text": "点到没展开的：",
      "start": 24.991,
      "end": 26.211
    },
    {
      "id": "shot08-13",
      "text": "把缩放放进 sklearn",
      "start": 26.211,
      "end": 27.951
    },
    {
      "id": "shot08-14",
      "text": "Pipeline 自动化的写法，",
      "start": 27.951,
      "end": 29.851
    },
    {
      "id": "shot08-15",
      "text": "留给后面 LR 章节工程实战；",
      "start": 29.851,
      "end": 32.311
    },
    {
      "id": "shot08-16",
      "text": "像图像归一化或者特定区间映射这种特殊用法，",
      "start": 32.311,
      "end": 36.011
    },
    {
      "id": "shot08-17",
      "text": "留给具体业务场景。",
      "start": 36.011,
      "end": 37.931
    },
    {
      "id": "shot08-18",
      "text": "下一期我们讲第二种缩放方法：标准化，",
      "start": 37.931,
      "end": 41.151
    },
    {
      "id": "shot08-19",
      "text": "英文 Z-score。",
      "start": 41.151,
      "end": 42.711
    },
    {
      "id": "shot08-20",
      "text": "它用统计分布——均值和标准差——代替",
      "start": 42.711,
      "end": 45.811
    },
    {
      "id": "shot08-21",
      "text": "min 和 max，",
      "start": 45.811,
      "end": 46.971
    },
    {
      "id": "shot08-22",
      "text": "对异常值更稳。",
      "start": 46.971,
      "end": 48.291
    },
    {
      "id": "shot08-23",
      "text": "但讲它之前必须先讲清楚什么是高斯分布——",
      "start": 48.291,
      "end": 51.471
    },
    {
      "id": "shot08-24",
      "text": "下一期会把这个数学背景一并铺好。",
      "start": 51.471,
      "end": 53.951
    },
    {
      "id": "shot08-25",
      "text": "如果讲得有不对的地方，",
      "start": 54.319,
      "end": 56.099
    },
    {
      "id": "shot08-26",
      "text": "欢迎在评论区指正。下期见。",
      "start": 56.099,
      "end": 58.139
    }
  ]
}
