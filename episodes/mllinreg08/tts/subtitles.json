{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期梯度下降的下山思想懂了——但每一步",
      "start": 0.0,
      "end": 3.645
    },
    {
      "id": "shot01-1",
      "text": "都用全部样本算梯度，",
      "start": 3.645,
      "end": 5.507
    },
    {
      "id": "shot01-2",
      "text": "大数据时代每步算几亿样本受不了。",
      "start": 5.507,
      "end": 8.411
    },
    {
      "id": "shot01-3",
      "text": "这一期看三种 GD 变体：",
      "start": 8.411,
      "end": 10.334
    },
    {
      "id": "shot01-4",
      "text": "BGD 全部样本、",
      "start": 10.334,
      "end": 11.956
    },
    {
      "id": "shot01-5",
      "text": "SGD 一个样本、",
      "start": 11.956,
      "end": 13.198
    },
    {
      "id": "shot01-6",
      "text": "MBGD 一小批，",
      "start": 13.198,
      "end": 14.76
    },
    {
      "id": "shot01-7",
      "text": "工业主流是第三种。",
      "start": 14.76,
      "end": 16.602
    },
    {
      "id": "shot01-8",
      "text": "再做一次正规方程 vs 梯度下降的全面对比，",
      "start": 16.602,
      "end": 20.508
    },
    {
      "id": "shot01-9",
      "text": "搞清楚什么时候选哪个。",
      "start": 20.508,
      "end": 22.13
    },
    {
      "id": "shot01-10",
      "text": "这一期解决三件事：",
      "start": 22.619,
      "end": 24.162
    },
    {
      "id": "shot01-11",
      "text": "BGD / SGD / MBGD 三种变",
      "start": 24.162,
      "end": 26.946
    },
    {
      "id": "shot01-12",
      "text": "体的优缺点和直觉对比；",
      "start": 26.946,
      "end": 28.97
    },
    {
      "id": "shot01-13",
      "text": "sklearn 对应实现",
      "start": 28.97,
      "end": 30.292
    },
    {
      "id": "shot01-14",
      "text": "SGDRegressor vs",
      "start": 30.292,
      "end": 32.155
    },
    {
      "id": "shot01-15",
      "text": "LinearRegression；",
      "start": 32.155,
      "end": 33.237
    },
    {
      "id": "shot01-16",
      "text": "正规方程 vs GD 八维度完整对比表。",
      "start": 33.237,
      "end": 36.723
    },
    {
      "id": "shot01-17",
      "text": "下一期换角度——训练完了，",
      "start": 36.723,
      "end": 38.866
    },
    {
      "id": "shot01-18",
      "text": "怎么评估模型好不好？",
      "start": 38.866,
      "end": 40.829
    },
    {
      "id": "shot01-19",
      "text": "MAE / MSE / RMSE 三件套。",
      "start": 40.829,
      "end": 44.435
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看 BGD 批量梯度下降，",
      "start": 0.0,
      "end": 2.263
    },
    {
      "id": "shot02-1",
      "text": "全名 Batch Gradient",
      "start": 2.263,
      "end": 3.664
    },
    {
      "id": "shot02-2",
      "text": "Descent。",
      "start": 3.664,
      "end": 4.305
    },
    {
      "id": "shot02-3",
      "text": "每次更新参数都用全部 n 个样本算一遍梯度，再走一步。",
      "start": 4.305,
      "end": 9.01
    },
    {
      "id": "shot02-4",
      "text": "优点是梯度方向最准确，",
      "start": 9.01,
      "end": 11.093
    },
    {
      "id": "shot02-5",
      "text": "下降轨迹最平滑——你能看到损失曲线很干净地往下走，不抖。",
      "start": 11.093,
      "end": 16.539
    },
    {
      "id": "shot02-6",
      "text": "缺点也明显：",
      "start": 16.539,
      "end": 17.7
    },
    {
      "id": "shot02-7",
      "text": "n 等于 1 万还能忍，",
      "start": 17.7,
      "end": 19.362
    },
    {
      "id": "shot02-8",
      "text": "n 等于 100 万每步算 100 万次梯度，",
      "start": 19.362,
      "end": 22.346
    },
    {
      "id": "shot02-9",
      "text": "一轮就要几秒；",
      "start": 22.346,
      "end": 23.647
    },
    {
      "id": "shot02-10",
      "text": "n 等于 1 亿样本？",
      "start": 23.647,
      "end": 25.229
    },
    {
      "id": "shot02-11",
      "text": "一步算几分钟，",
      "start": 25.229,
      "end": 26.33
    },
    {
      "id": "shot02-12",
      "text": "1000 步要几天。",
      "start": 26.33,
      "end": 27.452
    },
    {
      "id": "shot02-13",
      "text": "第二个问题是内存——大数据集装不进单机内存，",
      "start": 27.901,
      "end": 31.605
    },
    {
      "id": "shot02-14",
      "text": "BGD 算梯度要把整张 X 矩阵搬出来，",
      "start": 31.605,
      "end": 34.889
    },
    {
      "id": "shot02-15",
      "text": "工程上根本跑不通。",
      "start": 34.889,
      "end": 36.47
    },
    {
      "id": "shot02-16",
      "text": "所以 BGD 在 LR 时代还能用——身",
      "start": 36.47,
      "end": 39.273
    },
    {
      "id": "shot02-17",
      "text": "高体重 5 个点 / 房价几千行没问题；",
      "start": 39.273,
      "end": 42.457
    },
    {
      "id": "shot02-18",
      "text": "到了深度学习每张图 50 万像素几百万张图的规模，完全淘汰。",
      "start": 42.457,
      "end": 47.482
    },
    {
      "id": "shot02-19",
      "text": "这是上期 GD 公式的标准实现版本——但",
      "start": 47.482,
      "end": 48.043
    },
    {
      "id": "shot02-20",
      "text": "实际工程几乎不用。",
      "start": 48.043,
      "end": 48.043
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "另一个极端是 SGD 随机梯度下降，",
      "start": 0.0,
      "end": 2.981
    },
    {
      "id": "shot03-1",
      "text": "全名 Stochastic",
      "start": 2.981,
      "end": 4.321
    },
    {
      "id": "shot03-2",
      "text": "Gradient Descent。",
      "start": 4.321,
      "end": 5.602
    },
    {
      "id": "shot03-3",
      "text": "每次只随机抽 1 个样本算梯度走一步——",
      "start": 5.602,
      "end": 8.683
    },
    {
      "id": "shot03-4",
      "text": "n 等于 100 万也好 1 亿也好，",
      "start": 8.683,
      "end": 10.904
    },
    {
      "id": "shot03-5",
      "text": "每步只算一次梯度，",
      "start": 10.904,
      "end": 12.404
    },
    {
      "id": "shot03-6",
      "text": "速度直接拉满。优点：极快、内存友好、",
      "start": 12.404,
      "end": 15.945
    },
    {
      "id": "shot03-7",
      "text": "梯度噪声大反而能帮模型跳出局部最优陷阱（",
      "start": 15.945,
      "end": 19.866
    },
    {
      "id": "shot03-8",
      "text": "虽然 LR 凸函数没局部最优）。",
      "start": 19.866,
      "end": 21.427
    },
    {
      "id": "shot03-9",
      "text": "缺点：",
      "start": 21.982,
      "end": 22.523
    },
    {
      "id": "shot03-10",
      "text": "单样本梯度噪声大，",
      "start": 22.523,
      "end": 24.125
    },
    {
      "id": "shot03-11",
      "text": "下降轨迹震荡，",
      "start": 24.125,
      "end": 25.487
    },
    {
      "id": "shot03-12",
      "text": "看损失曲线像锯齿——但平均下来仍在下降；",
      "start": 25.487,
      "end": 29.213
    },
    {
      "id": "shot03-13",
      "text": "震荡导致最终停在最优点附近的小邻域，",
      "start": 29.213,
      "end": 32.337
    },
    {
      "id": "shot03-14",
      "text": "精度不如 BGD 但实际工程够用。",
      "start": 32.337,
      "end": 35.301
    },
    {
      "id": "shot03-15",
      "text": "sklearn 有专门实现叫",
      "start": 35.301,
      "end": 37.304
    },
    {
      "id": "shot03-16",
      "text": "SGDRegressor，",
      "start": 37.304,
      "end": 38.72
    },
    {
      "id": "shot03-17",
      "text": "n 大于 10 万或 online",
      "start": 38.72,
      "end": 40.168
    },
    {
      "id": "shot03-18",
      "text": "learning 在线学习场景一般走它，",
      "start": 40.168,
      "end": 42.732
    },
    {
      "id": "shot03-19",
      "text": "不用 LinearRegression。",
      "start": 42.732,
      "end": 43.994
    },
    {
      "id": "shot03-20",
      "text": "SGD 是大数据时代的破局者——没有SGD，",
      "start": 44.266,
      "end": 47.888
    },
    {
      "id": "shot03-21",
      "text": "深度学习根本训练不出来。",
      "start": 47.888,
      "end": 49.799
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "BGD 太慢 SGD 太抖，",
      "start": 0.0,
      "end": 2.403
    },
    {
      "id": "shot04-1",
      "text": "工程实践中走折中路线：",
      "start": 2.403,
      "end": 4.606
    },
    {
      "id": "shot04-2",
      "text": "小批量梯度下降 MBGD，",
      "start": 4.606,
      "end": 7.149
    },
    {
      "id": "shot04-3",
      "text": "全名 Mini-Batch",
      "start": 7.149,
      "end": 8.35
    },
    {
      "id": "shot04-4",
      "text": "Gradient Descent。",
      "start": 8.35,
      "end": 9.532
    },
    {
      "id": "shot04-5",
      "text": "每次抽 batch_size 个样本算梯",
      "start": 9.532,
      "end": 11.955
    },
    {
      "id": "shot04-6",
      "text": "度走一步——典型值 32、64、128、256，",
      "start": 11.955,
      "end": 16.06
    },
    {
      "id": "shot04-7",
      "text": "深度学习常用 512 或 1024。",
      "start": 16.06,
      "end": 19.224
    },
    {
      "id": "shot04-8",
      "text": "MBGD 兼顾两边：",
      "start": 19.224,
      "end": 21.126
    },
    {
      "id": "shot04-9",
      "text": "梯度足够准（不像 SGD 那么抖），",
      "start": 21.126,
      "end": 24.27
    },
    {
      "id": "shot04-10",
      "text": "又比 BGD 快得多（不用每步算全部样本）。",
      "start": 24.27,
      "end": 27.354
    },
    {
      "id": "shot04-11",
      "text": "还有个工程加分项：",
      "start": 27.784,
      "end": 29.506
    },
    {
      "id": "shot04-12",
      "text": "现代 GPU 一次能并行算几百几千个样本的梯度，",
      "start": 29.506,
      "end": 33.832
    },
    {
      "id": "shot04-13",
      "text": "单样本反而浪费算力——一个 batch",
      "start": 33.832,
      "end": 36.535
    },
    {
      "id": "shot04-14",
      "text": "刚好喂满一张 GPU。",
      "start": 36.535,
      "end": 38.277
    },
    {
      "id": "shot04-15",
      "text": "代价是多了个超参 batch_size要调，",
      "start": 38.277,
      "end": 40.941
    },
    {
      "id": "shot04-16",
      "text": "但实操经验值有规律：",
      "start": 40.941,
      "end": 42.763
    },
    {
      "id": "shot04-17",
      "text": "内存够就 256 起步，",
      "start": 42.763,
      "end": 44.565
    },
    {
      "id": "shot04-18",
      "text": "batch 越大梯度越平滑。",
      "start": 44.565,
      "end": 46.868
    },
    {
      "id": "shot04-19",
      "text": "今天'梯度下降'这个词在 99% 场景里",
      "start": 46.868,
      "end": 50.152
    },
    {
      "id": "shot04-20",
      "text": "说的就是 MBGD，",
      "start": 50.152,
      "end": 51.754
    },
    {
      "id": "shot04-21",
      "text": "纯 BGD 和纯 SGD 都进了博物馆。",
      "start": 51.754,
      "end": 54.458
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "讲完三种 GD，",
      "start": 0.0,
      "end": 1.402
    },
    {
      "id": "shot05-1",
      "text": "打开 demo 看可视化对比。",
      "start": 1.402,
      "end": 3.505
    },
    {
      "id": "shot05-2",
      "text": "dropdown 切 BGD（全部",
      "start": 3.505,
      "end": 5.428
    },
    {
      "id": "shot05-3",
      "text": "200 样本）/ MBGD（batch",
      "start": 5.428,
      "end": 7.751
    },
    {
      "id": "shot05-4",
      "text": "32）/ SGD（1 样本）。主图：",
      "start": 7.751,
      "end": 10.635
    },
    {
      "id": "shot05-5",
      "text": "MSE loss 等高线 + GD 轨迹",
      "start": 10.635,
      "end": 13.86
    },
    {
      "id": "shot05-6",
      "text": "白线脚印（红起点 (0,",
      "start": 13.86,
      "end": 15.862
    },
    {
      "id": "shot05-7",
      "text": "0) → 绿钻最优 (k=0.5,",
      "start": 15.862,
      "end": 19.187
    },
    {
      "id": "shot05-8",
      "text": "b=2)）；副图：",
      "start": 19.187,
      "end": 20.629
    },
    {
      "id": "shot05-9",
      "text": "loss 随 step 下降曲线。",
      "start": 20.629,
      "end": 22.332
    },
    {
      "id": "shot05-10",
      "text": "选 BGD：",
      "start": 22.816,
      "end": 23.738
    },
    {
      "id": "shot05-11",
      "text": "轨迹平滑直奔碗底，",
      "start": 23.738,
      "end": 25.282
    },
    {
      "id": "shot05-12",
      "text": "100 步终态 k=0.72 / b=0",
      "start": 25.282,
      "end": 28.39
    },
    {
      "id": "shot05-13",
      "text": ".72 / MSE=1.23，",
      "start": 28.39,
      "end": 30.575
    },
    {
      "id": "shot05-14",
      "text": "loss 曲线干净单调下降。",
      "start": 30.575,
      "end": 32.74
    },
    {
      "id": "shot05-15",
      "text": "切 MBGD：",
      "start": 32.74,
      "end": 34.003
    },
    {
      "id": "shot05-16",
      "text": "轨迹中度抖动，",
      "start": 34.003,
      "end": 35.346
    },
    {
      "id": "shot05-17",
      "text": "终态 k=0.69 / b=0.70 / MSE=1.27，",
      "start": 35.346,
      "end": 39.938
    },
    {
      "id": "shot05-19",
      "text": "loss 曲线轻度波动但整体下行。",
      "start": 39.938,
      "end": 42.363
    },
    {
      "id": "shot05-20",
      "text": "切 SGD：",
      "start": 42.846,
      "end": 44.008
    },
    {
      "id": "shot05-21",
      "text": "轨迹明显锯齿震荡，",
      "start": 44.008,
      "end": 45.832
    },
    {
      "id": "shot05-22",
      "text": "终态 k=0.74 / b=0.57 / MSE=1.30，",
      "start": 45.832,
      "end": 51.364
    },
    {
      "id": "shot05-24",
      "text": "loss 曲线像锯齿——但平均仍在下降。",
      "start": 51.364,
      "end": 54.891
    },
    {
      "id": "shot05-25",
      "text": "三种都未收敛到真值 (0.5,",
      "start": 54.891,
      "end": 57.416
    },
    {
      "id": "shot05-26",
      "text": "2.0)（lr=0.01 / 100步限制），",
      "start": 57.416,
      "end": 59.28
    },
    {
      "id": "shot05-27",
      "text": "但 BGD 最准 / SGD 最抖 / MBGD 兼顾——前面讲的优缺点视觉钉死。",
      "start": 59.28,
      "end": 65.393
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "讲完三种 GD，",
      "start": 0.0,
      "end": 1.181
    },
    {
      "id": "shot06-1",
      "text": "做一次正规方程 vs 梯度下降的全面对比。",
      "start": 1.181,
      "end": 4.584
    },
    {
      "id": "shot06-2",
      "text": "屏幕上 8 维对照表，",
      "start": 4.584,
      "end": 6.085
    },
    {
      "id": "shot06-3",
      "text": "重点看三条结论：第一，",
      "start": 6.085,
      "end": 8.006
    },
    {
      "id": "shot06-4",
      "text": "正规方程一步出解、",
      "start": 8.006,
      "end": 9.648
    },
    {
      "id": "shot06-5",
      "text": "GD 多步迭代——这是根本路线差异。第二，",
      "start": 9.648,
      "end": 12.89
    },
    {
      "id": "shot06-6",
      "text": "复杂度上正规方程 O(n³) 求逆 + 大数据吃内存，",
      "start": 12.89,
      "end": 17.184
    },
    {
      "id": "shot06-8",
      "text": "GD 单步 O(n) 线性 + SGD/MBGD 内存固定——大数据场景 GD 完胜。",
      "start": 17.184,
      "end": 23.099
    },
    {
      "id": "shot06-10",
      "text": "第三，",
      "start": 23.666,
      "end": 24.307
    },
    {
      "id": "shot06-11",
      "text": "适用范围正规方程只能 LR / Ridge 这种凸二次损失，",
      "start": 24.307,
      "end": 28.698
    },
    {
      "id": "shot06-13",
      "text": "GD 通用所有可导损失——神经网络损失非",
      "start": 28.698,
      "end": 32.326
    },
    {
      "id": "shot06-14",
      "text": "凸根本没解析解，",
      "start": 32.326,
      "end": 33.809
    },
    {
      "id": "shot06-15",
      "text": "必须 GD。",
      "start": 33.809,
      "end": 34.751
    },
    {
      "id": "shot06-16",
      "text": "一句话场景：",
      "start": 34.751,
      "end": 35.854
    },
    {
      "id": "shot06-17",
      "text": "小数据小特征用正规方程，",
      "start": 35.854,
      "end": 38.299
    },
    {
      "id": "shot06-18",
      "text": "大特征或大样本或非线性损失用 GD。",
      "start": 38.299,
      "end": 41.387
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.769
    },
    {
      "id": "shot07-1",
      "text": "我们解决了 LR 优化方法的全景三件事：第一，",
      "start": 1.175,
      "end": 5.579
    },
    {
      "id": "shot07-2",
      "text": "BGD 全部样本最准但慢、",
      "start": 5.579,
      "end": 7.941
    },
    {
      "id": "shot07-3",
      "text": "SGD 一个样本极快但抖、",
      "start": 7.941,
      "end": 10.443
    },
    {
      "id": "shot07-4",
      "text": "MBGD 一批 32 到 512 是工业主流；第二，",
      "start": 10.443,
      "end": 14.906
    },
    {
      "id": "shot07-5",
      "text": "sklearn 对应实现",
      "start": 14.906,
      "end": 16.268
    },
    {
      "id": "shot07-6",
      "text": "LinearRegression 走正规",
      "start": 16.268,
      "end": 18.229
    },
    {
      "id": "shot07-7",
      "text": "方程加 SGDRegressor 走SGD，",
      "start": 18.229,
      "end": 21.332
    },
    {
      "id": "shot07-8",
      "text": "n 大于 10 万换 SGD；第三，",
      "start": 21.332,
      "end": 24.555
    },
    {
      "id": "shot07-9",
      "text": "正规方程 vs GD 八维对比表，",
      "start": 24.555,
      "end": 27.658
    },
    {
      "id": "shot07-10",
      "text": "记住核心一条：",
      "start": 27.658,
      "end": 29.085
    },
    {
      "id": "shot07-11",
      "text": "小数据小特征用正规方程、",
      "start": 29.085,
      "end": 31.416
    },
    {
      "id": "shot07-12",
      "text": "大数据或非线性用 GD。",
      "start": 31.416,
      "end": 33.606
    },
    {
      "id": "shot07-13",
      "text": "点到没展开的：",
      "start": 33.837,
      "end": 35.119
    },
    {
      "id": "shot07-14",
      "text": "自适应学习率算法 Adam 和",
      "start": 35.119,
      "end": 37.203
    },
    {
      "id": "shot07-15",
      "text": "momentum 留给优化器专题；",
      "start": 37.203,
      "end": 39.427
    },
    {
      "id": "shot07-16",
      "text": "学习率衰减 schedule 留给深度学习；",
      "start": 39.427,
      "end": 42.211
    },
    {
      "id": "shot07-17",
      "text": "mini-batch 内的",
      "start": 42.211,
      "end": 43.193
    },
    {
      "id": "shot07-18",
      "text": "BatchNorm 等技巧留给 DL 章。",
      "start": 43.193,
      "end": 46.058
    },
    {
      "id": "shot07-19",
      "text": "下一期换角度——前面 6 期都在讲怎么训练 LR，",
      "start": 46.058,
      "end": 50.125
    },
    {
      "id": "shot07-20",
      "text": "但训练完了模型好不好得有评估指标。",
      "start": 50.125,
      "end": 53.411
    },
    {
      "id": "shot07-21",
      "text": "光看损失值不直观——MSE 单位是 y的平方，",
      "start": 53.411,
      "end": 57.378
    },
    {
      "id": "shot07-22",
      "text": "预测体重的 MSE 是公斤平方根本不是公斤。",
      "start": 57.378,
      "end": 60.803
    },
    {
      "id": "shot07-23",
      "text": "下期讲三件套：",
      "start": 61.325,
      "end": 62.672
    },
    {
      "id": "shot07-24",
      "text": "MAE 平均绝对误差 / MSE 均方误差 / RMSE 均方根误差。",
      "start": 62.672,
      "end": 68.262
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.688
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.688,
      "end": 2.144
    }
  ]
}
