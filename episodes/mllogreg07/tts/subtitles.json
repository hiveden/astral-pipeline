{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期癌症分类案例里，",
      "start": 0.0,
      "end": 1.843
    },
    {
      "id": "shot01-1",
      "text": "模型 accuracy 看起来很高。",
      "start": 1.843,
      "end": 4.307
    },
    {
      "id": "shot01-2",
      "text": "但医疗场景不能只盯一个准确率。",
      "start": 4.307,
      "end": 7.191
    },
    {
      "id": "shot01-3",
      "text": "假设同样是错一次，",
      "start": 7.191,
      "end": 8.974
    },
    {
      "id": "shot01-4",
      "text": "把恶性病人判成良性，",
      "start": 8.974,
      "end": 11.077
    },
    {
      "id": "shot01-5",
      "text": "和把健康人判成恶性，",
      "start": 11.077,
      "end": 13.2
    },
    {
      "id": "shot01-6",
      "text": "业务代价完全不同。",
      "start": 13.2,
      "end": 15.063
    },
    {
      "id": "shot01-7",
      "text": "前者可能是漏诊，",
      "start": 15.063,
      "end": 16.666
    },
    {
      "id": "shot01-8",
      "text": "后者可能只是多做一次复查。",
      "start": 16.666,
      "end": 19.43
    },
    {
      "id": "shot01-9",
      "text": "accuracy 会把它们都压成一个数字，",
      "start": 19.43,
      "end": 22.375
    },
    {
      "id": "shot01-10",
      "text": "混淆矩阵则把错误结构摊开。",
      "start": 22.375,
      "end": 25.079
    },
    {
      "id": "shot01-11",
      "text": "它回答的不是模型对了多少，",
      "start": 25.079,
      "end": 27.663
    },
    {
      "id": "shot01-12",
      "text": "而是模型到底错在哪里。",
      "start": 27.663,
      "end": 29.586
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "混淆矩阵是一个真实标签乘预测标签的二维表。",
      "start": 0.0,
      "end": 3.723
    },
    {
      "id": "shot02-1",
      "text": "二分类下有四个格子。TP，",
      "start": 3.723,
      "end": 6.512
    },
    {
      "id": "shot02-2",
      "text": "True Positive，真正例：",
      "start": 6.512,
      "end": 7.866
    },
    {
      "id": "shot02-3",
      "text": "真实是正例，",
      "start": 7.866,
      "end": 8.847
    },
    {
      "id": "shot02-4",
      "text": "预测也是正例。FN，",
      "start": 8.847,
      "end": 11.46
    },
    {
      "id": "shot02-5",
      "text": "False Negative，伪反例：",
      "start": 11.46,
      "end": 12.79
    },
    {
      "id": "shot02-6",
      "text": "真实是正例，",
      "start": 12.79,
      "end": 13.871
    },
    {
      "id": "shot02-7",
      "text": "却预测成负例，",
      "start": 13.871,
      "end": 15.172
    },
    {
      "id": "shot02-8",
      "text": "也就是漏报。FP，",
      "start": 15.172,
      "end": 17.732
    },
    {
      "id": "shot02-9",
      "text": "False Positive，伪正例：",
      "start": 17.732,
      "end": 19.135
    },
    {
      "id": "shot02-10",
      "text": "真实是负例，",
      "start": 19.135,
      "end": 20.256
    },
    {
      "id": "shot02-11",
      "text": "却预测成正例，",
      "start": 20.256,
      "end": 21.597
    },
    {
      "id": "shot02-12",
      "text": "也就是误报。",
      "start": 21.597,
      "end": 22.538
    },
    {
      "id": "shot02-13",
      "text": "TN，",
      "start": 22.538,
      "end": 23.634
    },
    {
      "id": "shot02-14",
      "text": "True Negative，真反例：",
      "start": 23.634,
      "end": 24.899
    },
    {
      "id": "shot02-15",
      "text": "真实是负例，",
      "start": 24.899,
      "end": 25.94
    },
    {
      "id": "shot02-16",
      "text": "预测也是负例。",
      "start": 25.94,
      "end": 26.921
    },
    {
      "id": "shot02-17",
      "text": "记法抓第二个字母和第一个字母：",
      "start": 27.316,
      "end": 29.804
    },
    {
      "id": "shot02-18",
      "text": "第二个字母 P 或 N 看预测成正还是负；",
      "start": 29.804,
      "end": 33.276
    },
    {
      "id": "shot02-19",
      "text": "第一个字母 T 或 F 看预测对了还是错",
      "start": 33.276,
      "end": 36.587
    },
    {
      "id": "shot02-20",
      "text": "了。",
      "start": 36.587,
      "end": 36.988
    },
    {
      "id": "shot02-21",
      "text": "四个格子加起来等于测试集总样本数。",
      "start": 36.988,
      "end": 39.757
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "用 10 个样本手算一遍。",
      "start": 0.0,
      "end": 2.183
    },
    {
      "id": "shot03-1",
      "text": "假设有 6 个恶性、",
      "start": 2.183,
      "end": 3.785
    },
    {
      "id": "shot03-2",
      "text": "4 个良性，",
      "start": 3.785,
      "end": 4.686
    },
    {
      "id": "shot03-3",
      "text": "并且恶性是正例。",
      "start": 4.686,
      "end": 6.228
    },
    {
      "id": "shot03-4",
      "text": "模型 A 预测对了 3 个恶性，",
      "start": 6.228,
      "end": 8.651
    },
    {
      "id": "shot03-5",
      "text": "也预测对了 4 个良性，",
      "start": 8.651,
      "end": 10.313
    },
    {
      "id": "shot03-6",
      "text": "所以 TP 是 3，",
      "start": 10.313,
      "end": 11.995
    },
    {
      "id": "shot03-7",
      "text": "FN 是剩下没抓到的 3 个恶性，",
      "start": 11.995,
      "end": 14.799
    },
    {
      "id": "shot03-8",
      "text": "FP 是 0，",
      "start": 14.799,
      "end": 15.7
    },
    {
      "id": "shot03-9",
      "text": "TN 是 4。",
      "start": 15.7,
      "end": 17.002
    },
    {
      "id": "shot03-10",
      "text": "模型 B 把 6 个恶性全抓到了，",
      "start": 17.002,
      "end": 19.405
    },
    {
      "id": "shot03-11",
      "text": "所以 TP 是 6，",
      "start": 19.405,
      "end": 20.767
    },
    {
      "id": "shot03-12",
      "text": "FN 是 0；",
      "start": 20.767,
      "end": 21.568
    },
    {
      "id": "shot03-13",
      "text": "但它只预测对 1 个良性，",
      "start": 21.568,
      "end": 23.45
    },
    {
      "id": "shot03-14",
      "text": "另外 3 个良性被误报成恶性，",
      "start": 23.45,
      "end": 25.853
    },
    {
      "id": "shot03-15",
      "text": "所以 FP 是 3，",
      "start": 25.853,
      "end": 27.275
    },
    {
      "id": "shot03-16",
      "text": "TN 是 1。",
      "start": 27.275,
      "end": 27.836
    },
    {
      "id": "shot03-17",
      "text": "两个模型的错误风格完全不同：A 保守，",
      "start": 28.209,
      "end": 31.52
    },
    {
      "id": "shot03-18",
      "text": "漏诊多；B 激进，",
      "start": 31.52,
      "end": 33.186
    },
    {
      "id": "shot03-19",
      "text": "误报多。",
      "start": 33.186,
      "end": 34.289
    },
    {
      "id": "shot03-20",
      "text": "只看准确率，",
      "start": 34.289,
      "end": 35.473
    },
    {
      "id": "shot03-21",
      "text": "很容易漏掉这种结构差异。",
      "start": 35.473,
      "end": 37.28
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开混淆矩阵 demo。",
      "start": 0.0,
      "end": 1.68
    },
    {
      "id": "shot04-1",
      "text": "左侧控制阈值 τ 和业务场景，",
      "start": 1.68,
      "end": 4.341
    },
    {
      "id": "shot04-2",
      "text": "右侧可以看四格矩阵和样本 strip。",
      "start": 4.341,
      "end": 7.122
    },
    {
      "id": "shot04-3",
      "text": "先看 τ 等于 0.5，",
      "start": 7.122,
      "end": 8.922
    },
    {
      "id": "shot04-4",
      "text": "矩阵里直接显示 TP、FN、FP、",
      "start": 8.922,
      "end": 12.003
    },
    {
      "id": "shot04-5",
      "text": "TN 的数量。",
      "start": 12.003,
      "end": 13.223
    },
    {
      "id": "shot04-6",
      "text": "把阈值调低，",
      "start": 13.223,
      "end": 14.403
    },
    {
      "id": "shot04-7",
      "text": "模型更容易判正类，",
      "start": 14.403,
      "end": 16.164
    },
    {
      "id": "shot04-8",
      "text": "所以 TP 可能增加，",
      "start": 16.164,
      "end": 18.064
    },
    {
      "id": "shot04-9",
      "text": "FN 会下降，",
      "start": 18.064,
      "end": 19.064
    },
    {
      "id": "shot04-10",
      "text": "但 FP 也会升高；",
      "start": 19.064,
      "end": 20.805
    },
    {
      "id": "shot04-11",
      "text": "把阈值调高，",
      "start": 20.805,
      "end": 21.905
    },
    {
      "id": "shot04-12",
      "text": "模型更保守，",
      "start": 21.905,
      "end": 23.525
    },
    {
      "id": "shot04-13",
      "text": "FP 会下降，",
      "start": 23.525,
      "end": 24.466
    },
    {
      "id": "shot04-14",
      "text": "但 FN 可能升高。",
      "start": 24.466,
      "end": 26.227
    },
    {
      "id": "shot04-15",
      "text": "切到散点定位镜头，",
      "start": 26.227,
      "end": 27.939
    },
    {
      "id": "shot04-16",
      "text": "每个点按预测概率排开，",
      "start": 27.939,
      "end": 30.215
    },
    {
      "id": "shot04-17",
      "text": "竖线就是当前阈值。",
      "start": 30.215,
      "end": 31.504
    },
    {
      "id": "shot04-18",
      "text": "拖动阈值线时，",
      "start": 32.03,
      "end": 33.236
    },
    {
      "id": "shot04-19",
      "text": "你能看到一些点跨过线，",
      "start": 33.236,
      "end": 35.264
    },
    {
      "id": "shot04-20",
      "text": "颜色从一个格子切到另一个格子。",
      "start": 35.264,
      "end": 37.896
    },
    {
      "id": "shot04-21",
      "text": "混淆矩阵不是静态表格，",
      "start": 37.896,
      "end": 39.885
    },
    {
      "id": "shot04-22",
      "text": "它会随着阈值一起变。",
      "start": 39.885,
      "end": 41.351
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "再切到代价对比。",
      "start": 0.0,
      "end": 1.741
    },
    {
      "id": "shot05-1",
      "text": "疾病筛查里，",
      "start": 1.741,
      "end": 2.782
    },
    {
      "id": "shot05-2",
      "text": "FN 也就是漏诊，",
      "start": 2.782,
      "end": 4.304
    },
    {
      "id": "shot05-3",
      "text": "代价通常远高于 FP 误报，",
      "start": 4.304,
      "end": 6.786
    },
    {
      "id": "shot05-4",
      "text": "所以阈值会倾向于调低：",
      "start": 6.786,
      "end": 8.767
    },
    {
      "id": "shot05-5",
      "text": "宁可多让一些人复查，",
      "start": 8.767,
      "end": 10.469
    },
    {
      "id": "shot05-6",
      "text": "也尽量别漏掉病人。",
      "start": 10.469,
      "end": 12.41
    },
    {
      "id": "shot05-7",
      "text": "反欺诈场景可能相反，",
      "start": 12.41,
      "end": 14.572
    },
    {
      "id": "shot05-8",
      "text": "FP 代表误拦正常用户，代价很高，",
      "start": 14.572,
      "end": 17.655
    },
    {
      "id": "shot05-9",
      "text": "所以阈值可能要调高：",
      "start": 17.655,
      "end": 19.476
    },
    {
      "id": "shot05-10",
      "text": "不要轻易把正常交易拦下来。",
      "start": 19.476,
      "end": 21.718
    },
    {
      "id": "shot05-11",
      "text": "注意这里没有万能阈值。",
      "start": 21.718,
      "end": 23.56
    },
    {
      "id": "shot05-12",
      "text": "0.5 只是常见起点，",
      "start": 23.56,
      "end": 25.401
    },
    {
      "id": "shot05-13",
      "text": "真正的切分口径要由业务代价决定。",
      "start": 25.401,
      "end": 28.545
    },
    {
      "id": "shot05-14",
      "text": "混淆矩阵的价值正在这里：",
      "start": 28.545,
      "end": 30.644
    },
    {
      "id": "shot05-15",
      "text": "它把不同类型的错拆开，",
      "start": 30.644,
      "end": 32.582
    },
    {
      "id": "shot05-16",
      "text": "业务方才知道自己在用哪种错换哪种错。",
      "start": 32.582,
      "end": 35.474
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.961
    },
    {
      "id": "shot06-1",
      "text": "我们把准确率拆成了混淆矩阵四格：",
      "start": 0.961,
      "end": 3.684
    },
    {
      "id": "shot06-2",
      "text": "TP 是命中的正例，",
      "start": 3.684,
      "end": 5.426
    },
    {
      "id": "shot06-3",
      "text": "FN 是漏掉的正例，",
      "start": 5.426,
      "end": 6.908
    },
    {
      "id": "shot06-4",
      "text": "FP 是误报的正例，",
      "start": 6.908,
      "end": 8.75
    },
    {
      "id": "shot06-5",
      "text": "TN 是正确放过的负例。",
      "start": 8.75,
      "end": 10.692
    },
    {
      "id": "shot06-6",
      "text": "我们还看到阈值会改变四格数量，",
      "start": 10.692,
      "end": 13.415
    },
    {
      "id": "shot06-7",
      "text": "而业务代价决定阈值倾向。",
      "start": 13.415,
      "end": 15.938
    },
    {
      "id": "shot06-8",
      "text": "下一期就在这四格基础上继续往上搭：",
      "start": 15.938,
      "end": 19.021
    },
    {
      "id": "shot06-9",
      "text": "预测正例里有多少是真的，",
      "start": 19.021,
      "end": 21.024
    },
    {
      "id": "shot06-10",
      "text": "叫 precision；",
      "start": 21.024,
      "end": 22.065
    },
    {
      "id": "shot06-11",
      "text": "真实正例里抓回多少，",
      "start": 22.065,
      "end": 23.787
    },
    {
      "id": "shot06-12",
      "text": "叫 recall；",
      "start": 23.787,
      "end": 24.668
    },
    {
      "id": "shot06-13",
      "text": "两者怎么折中，",
      "start": 24.668,
      "end": 25.869
    },
    {
      "id": "shot06-14",
      "text": "就是 F1。",
      "start": 25.869,
      "end": 26.169
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.652
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.652,
      "end": 1.976
    }
  ]
}
