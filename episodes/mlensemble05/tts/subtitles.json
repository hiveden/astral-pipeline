{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "前面随机森林的规则很公平：",
      "start": 0.0,
      "end": 2.425
    },
    {
      "id": "shot01-1",
      "text": "每棵树一票，",
      "start": 2.425,
      "end": 3.567
    },
    {
      "id": "shot01-2",
      "text": "大家平等投票。",
      "start": 3.567,
      "end": 4.689
    },
    {
      "id": "shot01-3",
      "text": "AdaBoost 不这么做。",
      "start": 4.689,
      "end": 6.333
    },
    {
      "id": "shot01-4",
      "text": "AdaBoost，",
      "start": 6.333,
      "end": 7.235
    },
    {
      "id": "shot01-5",
      "text": "全称 Adaptive Boosting，",
      "start": 7.235,
      "end": 8.978
    },
    {
      "id": "shot01-6",
      "text": "中文可以理解成自适应提升。",
      "start": 8.978,
      "end": 11.253
    },
    {
      "id": "shot01-7",
      "text": "它相信两件事：第一，",
      "start": 11.253,
      "end": 13.126
    },
    {
      "id": "shot01-8",
      "text": "上一轮分错的样本，",
      "start": 13.126,
      "end": 14.709
    },
    {
      "id": "shot01-9",
      "text": "下一轮应该更重要；第二，",
      "start": 14.709,
      "end": 17.094
    },
    {
      "id": "shot01-10",
      "text": "表现好的弱学习器，",
      "start": 17.094,
      "end": 18.938
    },
    {
      "id": "shot01-11",
      "text": "最终投票时应该更有话语权。",
      "start": 18.938,
      "end": 21.323
    },
    {
      "id": "shot01-12",
      "text": "还是会诊类比。",
      "start": 21.323,
      "end": 22.345
    },
    {
      "id": "shot01-13",
      "text": "第 1 位医生看完以后，",
      "start": 22.747,
      "end": 24.492
    },
    {
      "id": "shot01-14",
      "text": "漏诊病例被重点圈出来，",
      "start": 24.492,
      "end": 26.377
    },
    {
      "id": "shot01-15",
      "text": "第 2 位医生必须多看这些疑难片；",
      "start": 26.377,
      "end": 28.844
    },
    {
      "id": "shot01-16",
      "text": "最后开会时，",
      "start": 28.844,
      "end": 29.766
    },
    {
      "id": "shot01-17",
      "text": "历史上更准的医生发言权更大。",
      "start": 29.766,
      "end": 32.293
    },
    {
      "id": "shot01-18",
      "text": "这一期我们不急着手算 10 个样本，",
      "start": 32.293,
      "end": 34.84
    },
    {
      "id": "shot01-19",
      "text": "先把 AdaBoost 的两个权重和两个",
      "start": 34.84,
      "end": 37.086
    },
    {
      "id": "shot01-20",
      "text": "公式讲清楚。",
      "start": 37.086,
      "end": 37.889
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "AdaBoost 最终输出是一个加权投票。",
      "start": 0.0,
      "end": 2.703
    },
    {
      "id": "shot02-1",
      "text": "每个弱学习器给出一个预测，",
      "start": 2.703,
      "end": 4.825
    },
    {
      "id": "shot02-2",
      "text": "通常记作 h_t(x)，",
      "start": 4.825,
      "end": 6.587
    },
    {
      "id": "shot02-3",
      "text": "它可以投正类，",
      "start": 6.587,
      "end": 7.568
    },
    {
      "id": "shot02-4",
      "text": "也可以投负类。",
      "start": 7.568,
      "end": 8.649
    },
    {
      "id": "shot02-5",
      "text": "但每一票前面还乘一个系数，",
      "start": 8.649,
      "end": 10.872
    },
    {
      "id": "shot02-6",
      "text": "叫学习器权重，",
      "start": 10.872,
      "end": 12.213
    },
    {
      "id": "shot02-7",
      "text": "通常记作 α_t。",
      "start": 12.213,
      "end": 13.875
    },
    {
      "id": "shot02-8",
      "text": "整体就是把所有 α_t h_t(x) 加",
      "start": 13.875,
      "end": 17.078
    },
    {
      "id": "shot02-9",
      "text": "起来，",
      "start": 17.078,
      "end": 17.599
    },
    {
      "id": "shot02-10",
      "text": "再看符号。",
      "start": 17.599,
      "end": 18.92
    },
    {
      "id": "shot02-11",
      "text": "大于 0 判正类，",
      "start": 18.92,
      "end": 20.342
    },
    {
      "id": "shot02-12",
      "text": "小于 0 判负类。",
      "start": 20.342,
      "end": 21.884
    },
    {
      "id": "shot02-13",
      "text": "这个形式和随机森林差别很大。",
      "start": 21.884,
      "end": 24.527
    },
    {
      "id": "shot02-14",
      "text": "随机森林是一棵树一票；",
      "start": 24.527,
      "end": 26.308
    },
    {
      "id": "shot02-15",
      "text": "AdaBoost 是谁更准，",
      "start": 26.308,
      "end": 28.451
    },
    {
      "id": "shot02-16",
      "text": "谁的票更重。",
      "start": 28.451,
      "end": 29.272
    },
    {
      "id": "shot02-17",
      "text": "学习器权重不是拍脑袋给的，",
      "start": 29.846,
      "end": 32.151
    },
    {
      "id": "shot02-18",
      "text": "而是由加权错误率算出来。",
      "start": 32.151,
      "end": 34.415
    },
    {
      "id": "shot02-19",
      "text": "错误率越小，",
      "start": 34.415,
      "end": 35.598
    },
    {
      "id": "shot02-20",
      "text": "α_t 越大；",
      "start": 35.598,
      "end": 36.459
    },
    {
      "id": "shot02-21",
      "text": "错误率接近 0.5，",
      "start": 36.459,
      "end": 38.303
    },
    {
      "id": "shot02-22",
      "text": "α_t 接近 0；",
      "start": 38.303,
      "end": 39.506
    },
    {
      "id": "shot02-23",
      "text": "错误率超过 0.5，",
      "start": 39.506,
      "end": 41.049
    },
    {
      "id": "shot02-24",
      "text": "说明还不如随机猜，",
      "start": 41.049,
      "end": 42.732
    },
    {
      "id": "shot02-25",
      "text": "这一轮弱学习器就不合格。",
      "start": 42.732,
      "end": 44.636
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "学习器权重的公式是 α_t = 1/2",
      "start": 0.0,
      "end": 3.722
    },
    {
      "id": "shot03-1",
      "text": "ln((1-ε_t)/ε_t)。",
      "start": 3.722,
      "end": 7.865
    },
    {
      "id": "shot03-2",
      "text": "先不要被公式吓住，",
      "start": 7.865,
      "end": 9.446
    },
    {
      "id": "shot03-3",
      "text": "把它当成一个从错误率到话语权的转换器。",
      "start": 9.446,
      "end": 13.408
    },
    {
      "id": "shot03-4",
      "text": "ε_t 是当前弱学习器的加权错误率，",
      "start": 13.408,
      "end": 16.65
    },
    {
      "id": "shot03-5",
      "text": "也就是按当前样本权重统计出来的错误比例。",
      "start": 16.65,
      "end": 20.492
    },
    {
      "id": "shot03-6",
      "text": "如果 ε_t 等于 0.1，",
      "start": 20.492,
      "end": 22.493
    },
    {
      "id": "shot03-7",
      "text": "说明它错得很少，",
      "start": 22.493,
      "end": 23.874
    },
    {
      "id": "shot03-8",
      "text": "(1-ε_t)/ε_t 很大，",
      "start": 23.874,
      "end": 26.916
    },
    {
      "id": "shot03-9",
      "text": "取对数后 α_t 就大。",
      "start": 26.916,
      "end": 29.131
    },
    {
      "id": "shot03-10",
      "text": "若 ε_t 等于 0.4，",
      "start": 29.131,
      "end": 30.922
    },
    {
      "id": "shot03-11",
      "text": "它只比随机猜好一点，",
      "start": 30.922,
      "end": 33.056
    },
    {
      "id": "shot03-12",
      "text": "α_t 就比较小。",
      "start": 33.056,
      "end": 34.063
    },
    {
      "id": "shot03-13",
      "text": "若 ε_t 等于 0.5，",
      "start": 34.53,
      "end": 36.516
    },
    {
      "id": "shot03-14",
      "text": "分子分母一样，",
      "start": 36.516,
      "end": 37.76
    },
    {
      "id": "shot03-15",
      "text": "比值是 1，",
      "start": 37.76,
      "end": 38.683
    },
    {
      "id": "shot03-16",
      "text": "对数是 0，",
      "start": 38.683,
      "end": 39.666
    },
    {
      "id": "shot03-17",
      "text": "说明这棵树没有投票价值。",
      "start": 39.666,
      "end": 41.752
    },
    {
      "id": "shot03-18",
      "text": "这个公式同时满足两个直觉：",
      "start": 41.752,
      "end": 43.979
    },
    {
      "id": "shot03-19",
      "text": "越准越有话语权，",
      "start": 43.979,
      "end": 45.584
    },
    {
      "id": "shot03-20",
      "text": "半斤八两就别说话。",
      "start": 45.584,
      "end": 46.767
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "第二个公式负责更新样本权重。",
      "start": 0.0,
      "end": 2.563
    },
    {
      "id": "shot04-1",
      "text": "每条样本都有一个权重，",
      "start": 2.563,
      "end": 4.304
    },
    {
      "id": "shot04-2",
      "text": "记作 D_t(i)。",
      "start": 4.304,
      "end": 5.465
    },
    {
      "id": "shot04-3",
      "text": "第 1 轮开始时，",
      "start": 5.465,
      "end": 6.546
    },
    {
      "id": "shot04-4",
      "text": "所有样本通常一样重要。",
      "start": 6.546,
      "end": 8.628
    },
    {
      "id": "shot04-5",
      "text": "如果某条样本被当前弱学习器分对，",
      "start": 8.628,
      "end": 11.631
    },
    {
      "id": "shot04-6",
      "text": "下一轮权重就乘 e^{-α_t}，",
      "start": 11.631,
      "end": 14.514
    },
    {
      "id": "shot04-7",
      "text": "也就是变小；如果分错，",
      "start": 14.514,
      "end": 16.837
    },
    {
      "id": "shot04-8",
      "text": "就乘 e^{α_t}，",
      "start": 16.837,
      "end": 18.458
    },
    {
      "id": "shot04-9",
      "text": "也就是变大。",
      "start": 18.458,
      "end": 19.419
    },
    {
      "id": "shot04-10",
      "text": "最后再除以一个归一化系数，",
      "start": 19.419,
      "end": 21.46
    },
    {
      "id": "shot04-11",
      "text": "让所有样本权重加起来仍然等于 1。",
      "start": 21.46,
      "end": 24.541
    },
    {
      "id": "shot04-12",
      "text": "这个动作的直觉很直接：",
      "start": 24.541,
      "end": 26.322
    },
    {
      "id": "shot04-13",
      "text": "已经会做的题，",
      "start": 26.322,
      "end": 27.342
    },
    {
      "id": "shot04-14",
      "text": "下一轮少花点注意力；做错的题，",
      "start": 27.342,
      "end": 29.663
    },
    {
      "id": "shot04-15",
      "text": "下一轮放大给后面的学习器看。",
      "start": 29.663,
      "end": 31.664
    },
    {
      "id": "shot04-16",
      "text": "注意，",
      "start": 32.189,
      "end": 32.671
    },
    {
      "id": "shot04-17",
      "text": "AdaBoost 不是把错样本复制出来，",
      "start": 32.671,
      "end": 35.322
    },
    {
      "id": "shot04-18",
      "text": "而是在损失计算里给它更大的权重。",
      "start": 35.322,
      "end": 37.934
    },
    {
      "id": "shot04-19",
      "text": "后面的弱学习器为了降低加权错误率，",
      "start": 37.934,
      "end": 40.826
    },
    {
      "id": "shot04-20",
      "text": "自然会优先照顾这些难样本。",
      "start": 40.826,
      "end": 42.935
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "AdaBoost 还有一个容易忽略的要求：",
      "start": 0.0,
      "end": 2.793
    },
    {
      "id": "shot05-1",
      "text": "基学习器通常要同质。也就是说，",
      "start": 2.793,
      "end": 5.226
    },
    {
      "id": "shot05-2",
      "text": "要么全都是决策树，",
      "start": 5.226,
      "end": 6.648
    },
    {
      "id": "shot05-3",
      "text": "要么全都是逻辑回归，",
      "start": 6.648,
      "end": 8.23
    },
    {
      "id": "shot05-4",
      "text": "不要这一轮用树、",
      "start": 8.23,
      "end": 9.712
    },
    {
      "id": "shot05-5",
      "text": "下一轮用 KNN、",
      "start": 9.712,
      "end": 11.194
    },
    {
      "id": "shot05-6",
      "text": "再下一轮用线性模型。",
      "start": 11.194,
      "end": 13.336
    },
    {
      "id": "shot05-7",
      "text": "混搭不同类型更像异构集成，",
      "start": 13.336,
      "end": 15.699
    },
    {
      "id": "shot05-8",
      "text": "不属于这里的标准 AdaBoost 主线。",
      "start": 15.699,
      "end": 18.202
    },
    {
      "id": "shot05-9",
      "text": "最常用的基学习器是决策桩，",
      "start": 18.202,
      "end": 20.565
    },
    {
      "id": "shot05-10",
      "text": "英文 decision stump，",
      "start": 20.565,
      "end": 22.087
    },
    {
      "id": "shot05-11",
      "text": "也就是深度等于 1 的决策树。",
      "start": 22.087,
      "end": 24.269
    },
    {
      "id": "shot05-12",
      "text": "它只问一个问题，",
      "start": 24.269,
      "end": 25.571
    },
    {
      "id": "shot05-13",
      "text": "比如酒精含量是否大于某个阈值。",
      "start": 25.571,
      "end": 27.974
    },
    {
      "id": "shot05-14",
      "text": "单个决策桩很弱，",
      "start": 28.318,
      "end": 29.903
    },
    {
      "id": "shot05-15",
      "text": "但正适合 boosting：",
      "start": 29.903,
      "end": 31.387
    },
    {
      "id": "shot05-16",
      "text": "它不会一口气把训练集吃透，",
      "start": 31.387,
      "end": 33.493
    },
    {
      "id": "shot05-17",
      "text": "而是每一轮只补一点。",
      "start": 33.493,
      "end": 35.038
    },
    {
      "id": "shot05-18",
      "text": "AdaBoost 的强，",
      "start": 35.038,
      "end": 36.282
    },
    {
      "id": "shot05-19",
      "text": "来自很多个弱判断按顺序接力，",
      "start": 36.282,
      "end": 38.909
    },
    {
      "id": "shot05-20",
      "text": "而不是某一棵树本身特别深、特别复杂。",
      "start": 38.909,
      "end": 41.577
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期先到这里。",
      "start": 0.0,
      "end": 1.182
    },
    {
      "id": "shot06-1",
      "text": "AdaBoost 的机制可以压成两句话：",
      "start": 1.182,
      "end": 3.766
    },
    {
      "id": "shot06-2",
      "text": "训练时，",
      "start": 3.766,
      "end": 4.607
    },
    {
      "id": "shot06-3",
      "text": "分错样本下一轮更重要；投票时，",
      "start": 4.607,
      "end": 7.511
    },
    {
      "id": "shot06-4",
      "text": "错误率更低的弱学习器话语权更大。",
      "start": 7.511,
      "end": 10.676
    },
    {
      "id": "shot06-5",
      "text": "公式上，",
      "start": 10.676,
      "end": 11.571
    },
    {
      "id": "shot06-6",
      "text": "α_t 把加权错误率变成学习器权重，",
      "start": 11.571,
      "end": 14.582
    },
    {
      "id": "shot06-7",
      "text": "样本权重更新公式把错题放大、对题缩小，",
      "start": 14.582,
      "end": 18.127
    },
    {
      "id": "shot06-8",
      "text": "再归一化。到这里，",
      "start": 18.127,
      "end": 19.569
    },
    {
      "id": "shot06-9",
      "text": "我们只讲了公式的意义，",
      "start": 19.569,
      "end": 21.352
    },
    {
      "id": "shot06-10",
      "text": "还没有真正把它跑起来。",
      "start": 21.352,
      "end": 22.854
    },
    {
      "id": "shot06-11",
      "text": "下一期会用 10 个一维样本手算 3 轮：",
      "start": 23.239,
      "end": 26.628
    },
    {
      "id": "shot06-12",
      "text": "先初始化每个样本权重为 0.1，",
      "start": 26.628,
      "end": 29.335
    },
    {
      "id": "shot06-13",
      "text": "再找第 1 个分裂点，算错误率、算 α、",
      "start": 29.335,
      "end": 32.444
    },
    {
      "id": "shot06-14",
      "text": "更新权重，",
      "start": 32.444,
      "end": 33.386
    },
    {
      "id": "shot06-15",
      "text": "然后看错样本怎样一轮一轮被推到前台。",
      "start": 33.386,
      "end": 36.374
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.708
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.708,
      "end": 2.185
    }
  ]
}
