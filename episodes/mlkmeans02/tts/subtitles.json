{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们知道了，",
      "start": 0.0,
      "end": 1.182
    },
    {
      "id": "shot01-1",
      "text": "聚类是在没有标签的时候，",
      "start": 1.182,
      "end": 2.964
    },
    {
      "id": "shot01-2",
      "text": "先把相似样本分成几堆。",
      "start": 2.964,
      "end": 5.007
    },
    {
      "id": "shot01-3",
      "text": "这一期把它落到代码。",
      "start": 5.007,
      "end": 6.529
    },
    {
      "id": "shot01-4",
      "text": "K-Means 的 API 很短，",
      "start": 6.529,
      "end": 8.391
    },
    {
      "id": "shot01-5",
      "text": "最核心的入口就是 K-Means 加一个",
      "start": 8.391,
      "end": 10.714
    },
    {
      "id": "shot01-6",
      "text": "n_clusters。",
      "start": 10.714,
      "end": 11.776
    },
    {
      "id": "shot01-7",
      "text": "这个参数决定我们准备分成几簇。",
      "start": 11.776,
      "end": 14.619
    },
    {
      "id": "shot01-8",
      "text": "然后调用 fit，",
      "start": 14.619,
      "end": 15.741
    },
    {
      "id": "shot01-9",
      "text": "让模型从数据里找质心；",
      "start": 15.741,
      "end": 17.783
    },
    {
      "id": "shot01-10",
      "text": "调用 predict，",
      "start": 17.783,
      "end": 18.805
    },
    {
      "id": "shot01-11",
      "text": "把样本分配到最近质心；",
      "start": 18.805,
      "end": 21.028
    },
    {
      "id": "shot01-12",
      "text": "或者直接用 fit_predict，",
      "start": 21.028,
      "end": 22.81
    },
    {
      "id": "shot01-13",
      "text": "一步拿到每个样本的簇编号。",
      "start": 22.81,
      "end": 24.733
    },
    {
      "id": "shot01-14",
      "text": "看起来只是一行代码，",
      "start": 25.304,
      "end": 27.137
    },
    {
      "id": "shot01-15",
      "text": "但这行代码背后，",
      "start": 27.137,
      "end": 28.547
    },
    {
      "id": "shot01-16",
      "text": "已经包含了选 K、训练质心、",
      "start": 28.547,
      "end": 30.601
    },
    {
      "id": "shot01-17",
      "text": "解释簇编号三件事。",
      "start": 30.601,
      "end": 32.132
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看 n_clusters。",
      "start": 0.0,
      "end": 1.683
    },
    {
      "id": "shot02-1",
      "text": "整理桌面文件时，",
      "start": 1.683,
      "end": 2.925
    },
    {
      "id": "shot02-2",
      "text": "我们可以先拿 3 个篮子：发票、合同、",
      "start": 2.925,
      "end": 5.69
    },
    {
      "id": "shot02-3",
      "text": "照片。",
      "start": 5.69,
      "end": 6.291
    },
    {
      "id": "shot02-4",
      "text": "每个文件来了，",
      "start": 6.291,
      "end": 7.353
    },
    {
      "id": "shot02-5",
      "text": "就放进最像的篮子。",
      "start": 7.353,
      "end": 8.916
    },
    {
      "id": "shot02-6",
      "text": "K-Means 也是这样，",
      "start": 8.916,
      "end": 10.298
    },
    {
      "id": "shot02-7",
      "text": "先告诉模型准备几个篮子，",
      "start": 10.298,
      "end": 12.322
    },
    {
      "id": "shot02-8",
      "text": "再让数据自己决定每个篮子的代表位置。",
      "start": 12.322,
      "end": 15.187
    },
    {
      "id": "shot02-9",
      "text": "n_clusters 等于 2，",
      "start": 15.618,
      "end": 17.28
    },
    {
      "id": "shot02-10",
      "text": "就是粗分两堆；",
      "start": 17.28,
      "end": 18.522
    },
    {
      "id": "shot02-11",
      "text": "n_clusters 等于 8，",
      "start": 18.522,
      "end": 20.004
    },
    {
      "id": "shot02-12",
      "text": "是 sklearn 的默认值，",
      "start": 20.004,
      "end": 22.047
    },
    {
      "id": "shot02-13",
      "text": "但不代表业务上一定正确；",
      "start": 22.047,
      "end": 24.411
    },
    {
      "id": "shot02-14",
      "text": "n_clusters 太大，",
      "start": 24.411,
      "end": 25.653
    },
    {
      "id": "shot02-15",
      "text": "每个簇会越来越碎，",
      "start": 25.653,
      "end": 27.415
    },
    {
      "id": "shot02-16",
      "text": "解释成本也会上升。",
      "start": 27.415,
      "end": 29.098
    },
    {
      "id": "shot02-17",
      "text": "所以 API 本身不难，",
      "start": 29.098,
      "end": 31.061
    },
    {
      "id": "shot02-18",
      "text": "关键责任在这个 K 到底取多少。",
      "start": 31.061,
      "end": 33.965
    },
    {
      "id": "shot02-19",
      "text": "后面的 SSE、",
      "start": 33.965,
      "end": 35.401
    },
    {
      "id": "shot02-20",
      "text": "肘部法、SC、CH，",
      "start": 35.401,
      "end": 37.69
    },
    {
      "id": "shot02-21",
      "text": "都是围绕这个问题展开。",
      "start": 37.69,
      "end": 39.193
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "再看三个方法。",
      "start": 0.0,
      "end": 1.502
    },
    {
      "id": "shot03-1",
      "text": "fit 的意思是训练：",
      "start": 1.502,
      "end": 2.884
    },
    {
      "id": "shot03-2",
      "text": "模型在 X 里反复找质心，",
      "start": 2.884,
      "end": 5.427
    },
    {
      "id": "shot03-3",
      "text": "直到质心稳定或者达到迭代上限。",
      "start": 5.427,
      "end": 8.251
    },
    {
      "id": "shot03-4",
      "text": "predict 的意思是分配：",
      "start": 8.251,
      "end": 9.993
    },
    {
      "id": "shot03-5",
      "text": "给定已经训练好的质心，",
      "start": 9.993,
      "end": 11.896
    },
    {
      "id": "shot03-6",
      "text": "把每个样本分给最近的那个质心。",
      "start": 11.896,
      "end": 15.06
    },
    {
      "id": "shot03-7",
      "text": "fit_predict 是教学和探索阶段",
      "start": 15.06,
      "end": 17.763
    },
    {
      "id": "shot03-8",
      "text": "最常用的快捷写法，",
      "start": 17.763,
      "end": 19.606
    },
    {
      "id": "shot03-9",
      "text": "等价于先 fit，",
      "start": 19.606,
      "end": 21.067
    },
    {
      "id": "shot03-10",
      "text": "再 predict，",
      "start": 21.067,
      "end": 22.289
    },
    {
      "id": "shot03-11",
      "text": "直接返回每个样本的簇编号。",
      "start": 22.289,
      "end": 24.953
    },
    {
      "id": "shot03-12",
      "text": "这里注意一个无监督学习的细节：",
      "start": 24.953,
      "end": 27.636
    },
    {
      "id": "shot03-13",
      "text": "训练时只喂 X，不喂 y。",
      "start": 27.636,
      "end": 29.639
    },
    {
      "id": "shot03-14",
      "text": "即使我们用 make_blobs 生成模",
      "start": 30.132,
      "end": 32.359
    },
    {
      "id": "shot03-15",
      "text": "拟数据时，",
      "start": 32.359,
      "end": 33.222
    },
    {
      "id": "shot03-16",
      "text": "函数顺手返回了 y，",
      "start": 33.222,
      "end": 34.667
    },
    {
      "id": "shot03-17",
      "text": "K-Means 训练也不会使用它。",
      "start": 34.667,
      "end": 37.165
    },
    {
      "id": "shot03-18",
      "text": "聚类要看的，",
      "start": 37.165,
      "end": 38.198
    },
    {
      "id": "shot03-19",
      "text": "是样本之间的相似结构，",
      "start": 38.198,
      "end": 40.105
    },
    {
      "id": "shot03-20",
      "text": "不是已有答案。",
      "start": 40.105,
      "end": 41.148
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "为了先把流程跑通，",
      "start": 0.0,
      "end": 1.762
    },
    {
      "id": "shot04-1",
      "text": "我们用 make_blobs 造一批二维",
      "start": 1.762,
      "end": 4.045
    },
    {
      "id": "shot04-2",
      "text": "点。",
      "start": 4.045,
      "end": 4.405
    },
    {
      "id": "shot04-3",
      "text": "它像一个教学沙盘：",
      "start": 4.405,
      "end": 6.108
    },
    {
      "id": "shot04-4",
      "text": "先在平面上放几个中心，",
      "start": 6.108,
      "end": 8.13
    },
    {
      "id": "shot04-5",
      "text": "再围绕中心生成点。",
      "start": 8.13,
      "end": 9.952
    },
    {
      "id": "shot04-6",
      "text": "代码流程是五步。",
      "start": 9.952,
      "end": 11.474
    },
    {
      "id": "shot04-7",
      "text": "第一步导入 K-Means、",
      "start": 11.474,
      "end": 13.096
    },
    {
      "id": "shot04-8",
      "text": "make_blobs、",
      "start": 13.096,
      "end": 13.897
    },
    {
      "id": "shot04-9",
      "text": "画图库和 CH 指数。",
      "start": 13.897,
      "end": 16.18
    },
    {
      "id": "shot04-10",
      "text": "第二步生成 1000 个样本，",
      "start": 16.18,
      "end": 18.303
    },
    {
      "id": "shot04-11",
      "text": "每个样本 2 个特征，",
      "start": 18.303,
      "end": 19.945
    },
    {
      "id": "shot04-12",
      "text": "围绕 4 个中心分布。",
      "start": 19.945,
      "end": 21.707
    },
    {
      "id": "shot04-13",
      "text": "第三步画原始散点图，",
      "start": 21.707,
      "end": 24.05
    },
    {
      "id": "shot04-14",
      "text": "先确认数据确实有可见结构。",
      "start": 24.05,
      "end": 26.353
    },
    {
      "id": "shot04-15",
      "text": "第四步调用 K-Means 的",
      "start": 26.917,
      "end": 28.5
    },
    {
      "id": "shot04-16",
      "text": "fit_predict，",
      "start": 28.5,
      "end": 29.502
    },
    {
      "id": "shot04-17",
      "text": "给每个点返回一个簇编号。",
      "start": 29.502,
      "end": 31.887
    },
    {
      "id": "shot04-18",
      "text": "第五步按簇编号上色，",
      "start": 31.887,
      "end": 33.931
    },
    {
      "id": "shot04-19",
      "text": "再用",
      "start": 33.931,
      "end": 34.232
    },
    {
      "id": "shot04-20",
      "text": "calinski_harabasz_score",
      "start": 34.232,
      "end": 35.715
    },
    {
      "id": "shot04-21",
      "text": "做一个基础评估。",
      "start": 35.715,
      "end": 37.097
    },
    {
      "id": "shot04-22",
      "text": "这里 CH 先不用记公式，",
      "start": 37.097,
      "end": 39.041
    },
    {
      "id": "shot04-23",
      "text": "只知道它是一个聚类评分，",
      "start": 39.041,
      "end": 41.185
    },
    {
      "id": "shot04-24",
      "text": "分数越高通常表示簇间更分开、簇内更紧。",
      "start": 41.185,
      "end": 44.672
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "这个案例里有一个很好的观察点：",
      "start": 0.0,
      "end": 2.243
    },
    {
      "id": "shot05-1",
      "text": "make_blobs 生成数据时用了 4",
      "start": 2.243,
      "end": 4.806
    },
    {
      "id": "shot05-2",
      "text": "个中心，",
      "start": 4.806,
      "end": 5.446
    },
    {
      "id": "shot05-3",
      "text": "但示例聚类时写的是 n_clusters",
      "start": 5.446,
      "end": 8.11
    },
    {
      "id": "shot05-4",
      "text": "等于 3。",
      "start": 8.11,
      "end": 8.85
    },
    {
      "id": "shot05-5",
      "text": "这不是 API 错误，",
      "start": 8.85,
      "end": 10.232
    },
    {
      "id": "shot05-6",
      "text": "而是在提醒我们：",
      "start": 10.232,
      "end": 11.654
    },
    {
      "id": "shot05-7",
      "text": "K-Means 不会替我们自动决定 K。",
      "start": 11.654,
      "end": 14.777
    },
    {
      "id": "shot05-8",
      "text": "真实结构可能看起来像 4 堆，",
      "start": 14.777,
      "end": 17.16
    },
    {
      "id": "shot05-9",
      "text": "但只要我们指定 K=3，",
      "start": 17.16,
      "end": 19.343
    },
    {
      "id": "shot05-10",
      "text": "模型就必须把它硬分成 3 簇。反过来，",
      "start": 19.343,
      "end": 22.526
    },
    {
      "id": "shot05-11",
      "text": "如果指定 K=8，",
      "start": 22.526,
      "end": 23.988
    },
    {
      "id": "shot05-12",
      "text": "它也会硬分成 8 簇。",
      "start": 23.988,
      "end": 25.836
    },
    {
      "id": "shot05-13",
      "text": "聚类结果不只是算法决定的，",
      "start": 25.836,
      "end": 28.093
    },
    {
      "id": "shot05-14",
      "text": "也是我们给的 K 决定的。",
      "start": 28.093,
      "end": 29.615
    },
    {
      "id": "shot05-15",
      "text": "所以看到 labels 里的 0、1、",
      "start": 30.045,
      "end": 32.11
    },
    {
      "id": "shot05-16",
      "text": "2，",
      "start": 32.11,
      "end": 32.471
    },
    {
      "id": "shot05-17",
      "text": "不要把它们直接读成业务标签。",
      "start": 32.471,
      "end": 34.816
    },
    {
      "id": "shot05-18",
      "text": "它们只是编号，",
      "start": 34.816,
      "end": 36.099
    },
    {
      "id": "shot05-19",
      "text": "业务命名要等看过质心、",
      "start": 36.099,
      "end": 38.084
    },
    {
      "id": "shot05-20",
      "text": "特征均值和样本画像之后再做。",
      "start": 38.084,
      "end": 40.65
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.081
    },
    {
      "id": "shot06-1",
      "text": "我们把 K-Means 的最小代码链路跑",
      "start": 1.081,
      "end": 3.544
    },
    {
      "id": "shot06-2",
      "text": "通了：",
      "start": 3.544,
      "end": 4.184
    },
    {
      "id": "shot06-3",
      "text": "n_clusters 决定簇数，",
      "start": 4.184,
      "end": 6.366
    },
    {
      "id": "shot06-4",
      "text": "fit 负责训练质心，",
      "start": 6.366,
      "end": 8.188
    },
    {
      "id": "shot06-5",
      "text": "predict 负责分配样本，",
      "start": 8.188,
      "end": 10.25
    },
    {
      "id": "shot06-6",
      "text": "fit_predict 把两步合在一起。",
      "start": 10.25,
      "end": 12.492
    },
    {
      "id": "shot06-7",
      "text": "我们还看到，",
      "start": 12.492,
      "end": 13.413
    },
    {
      "id": "shot06-8",
      "text": "模拟数据里的 y 不参与训练，",
      "start": 13.413,
      "end": 15.856
    },
    {
      "id": "shot06-9",
      "text": "聚类只看 X。",
      "start": 15.856,
      "end": 17.818
    },
    {
      "id": "shot06-10",
      "text": "没有展开的内容有两个：",
      "start": 17.818,
      "end": 19.8
    },
    {
      "id": "shot06-11",
      "text": "CH 指数的公式，",
      "start": 19.8,
      "end": 21.461
    },
    {
      "id": "shot06-12",
      "text": "留到评估指标那一期；",
      "start": 21.461,
      "end": 23.343
    },
    {
      "id": "shot06-13",
      "text": "K-Means 训练质心到底怎么迭代，",
      "start": 23.343,
      "end": 26.066
    },
    {
      "id": "shot06-14",
      "text": "留到下一期。",
      "start": 26.066,
      "end": 27.027
    },
    {
      "id": "shot06-15",
      "text": "下一期我们打开 fit_predict",
      "start": 27.283,
      "end": 29.156
    },
    {
      "id": "shot06-16",
      "text": "的内部过程，",
      "start": 29.156,
      "end": 30.223
    },
    {
      "id": "shot06-17",
      "text": "看它怎样反复执行分配样本和更新质心。",
      "start": 30.223,
      "end": 33.605
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.584
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.584,
      "end": 2.074
    }
  ]
}
