{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期 MSE 抛物线底就是最优 k——",
      "start": 0.0,
      "end": 3.081
    },
    {
      "id": "shot01-1",
      "text": "凭什么导数为零就是最低？",
      "start": 3.081,
      "end": 5.242
    },
    {
      "id": "shot01-2",
      "text": "想象开车跑高速，",
      "start": 5.242,
      "end": 6.863
    },
    {
      "id": "shot01-3",
      "text": "地图算的是 1 小时平均速度，",
      "start": 6.863,
      "end": 9.164
    },
    {
      "id": "shot01-4",
      "text": "但你这一秒踩了多深的油门，",
      "start": 9.164,
      "end": 11.524
    },
    {
      "id": "shot01-5",
      "text": "码表才知道——把时间窗口缩到极短的瞬时速",
      "start": 11.524,
      "end": 15.226
    },
    {
      "id": "shot01-6",
      "text": "度就是导数。",
      "start": 15.226,
      "end": 16.626
    },
    {
      "id": "shot01-7",
      "text": "再想象烤蛋糕的烤箱有温度和时间两个旋钮，",
      "start": 16.626,
      "end": 20.488
    },
    {
      "id": "shot01-8",
      "text": "蛋糕熟不熟由两个旋钮一起决定，",
      "start": 20.488,
      "end": 23.25
    },
    {
      "id": "shot01-9",
      "text": "先按住时间只挪温度看效果就是温度方向的偏",
      "start": 23.25,
      "end": 26.865
    },
    {
      "id": "shot01-10",
      "text": "导，",
      "start": 26.865,
      "end": 27.227
    },
    {
      "id": "shot01-11",
      "text": "再按住温度只挪时间就是时间方向的偏导。",
      "start": 27.227,
      "end": 30.24
    },
    {
      "id": "shot01-12",
      "text": "这一期我们把这把钥匙磨亮：",
      "start": 30.769,
      "end": 32.933
    },
    {
      "id": "shot01-13",
      "text": "导数 → 偏导 → 梯度，",
      "start": 32.933,
      "end": 35.597
    },
    {
      "id": "shot01-14",
      "text": "一条线讲清楚 LR 怎么用数学找最小值。",
      "start": 35.597,
      "end": 39.524
    },
    {
      "id": "shot01-15",
      "text": "这一期解决三件事：",
      "start": 39.524,
      "end": 41.347
    },
    {
      "id": "shot01-16",
      "text": "导数等于切线斜率 + 三条求导规则；",
      "start": 41.347,
      "end": 45.233
    },
    {
      "id": "shot01-17",
      "text": "神器导数等于零找极值，",
      "start": 45.233,
      "end": 47.657
    },
    {
      "id": "shot01-18",
      "text": "重算一遍 k 等于 0.9688；",
      "start": 47.657,
      "end": 50.983
    },
    {
      "id": "shot01-19",
      "text": "扩到多元偏导 + 梯度，",
      "start": 50.983,
      "end": 53.307
    },
    {
      "id": "shot01-20",
      "text": "给下期矩阵化铺路。",
      "start": 53.307,
      "end": 54.93
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看导数 derivative 是什么。",
      "start": 0.0,
      "end": 2.103
    },
    {
      "id": "shot02-1",
      "text": "地图算 1 小时平均速度，",
      "start": 2.103,
      "end": 4.106
    },
    {
      "id": "shot02-2",
      "text": "但你这一秒踩了多深的油门，",
      "start": 4.106,
      "end": 6.309
    },
    {
      "id": "shot02-3",
      "text": "码表才知道——把时间窗口缩到极短，",
      "start": 6.309,
      "end": 9.254
    },
    {
      "id": "shot02-4",
      "text": "看这一瞬间的速度。",
      "start": 9.254,
      "end": 10.776
    },
    {
      "id": "shot02-5",
      "text": "把位置换成函数 y 等于 f(x)、",
      "start": 10.776,
      "end": 13.601
    },
    {
      "id": "shot02-6",
      "text": "时间换成 x，",
      "start": 13.601,
      "end": 15.11
    },
    {
      "id": "shot02-7",
      "text": "瞬时变化率就是导数。",
      "start": 15.11,
      "end": 17.046
    },
    {
      "id": "shot02-8",
      "text": "几何上看就是曲线那一点切线",
      "start": 17.046,
      "end": 19.51
    },
    {
      "id": "shot02-9",
      "text": "tangent 的斜率。",
      "start": 19.51,
      "end": 20.932
    },
    {
      "id": "shot02-10",
      "text": "LR 用得到的求导只有三条规则。",
      "start": 20.932,
      "end": 23.356
    },
    {
      "id": "shot02-11",
      "text": "第一条幂函数 power rule：",
      "start": 23.891,
      "end": 25.995
    },
    {
      "id": "shot02-12",
      "text": "x 的 α 次方求导等于 α 乘 x 的",
      "start": 25.995,
      "end": 29.421
    },
    {
      "id": "shot02-13",
      "text": "α 减一次方——x 平方求导等于 2x。",
      "start": 29.421,
      "end": 33.548
    },
    {
      "id": "shot02-14",
      "text": "第二条和的求导规则 sum rule：",
      "start": 33.548,
      "end": 37.555
    },
    {
      "id": "shot02-15",
      "text": "(u+v)' = u' + v'，",
      "start": 37.555,
      "end": 39.418
    },
    {
      "id": "shot02-16",
      "text": "求导可以拆到每一项。",
      "start": 39.418,
      "end": 41.461
    },
    {
      "id": "shot02-17",
      "text": "第三条常数求导规则：",
      "start": 41.461,
      "end": 43.605
    },
    {
      "id": "shot02-18",
      "text": "常数求导等于零。",
      "start": 43.605,
      "end": 45.569
    },
    {
      "id": "shot02-19",
      "text": "三条加起来，",
      "start": 45.569,
      "end": 46.851
    },
    {
      "id": "shot02-20",
      "text": "多项式求导一气呵成。",
      "start": 46.851,
      "end": 49.095
    },
    {
      "id": "shot02-21",
      "text": "指数对数三角 LR 不用，",
      "start": 49.095,
      "end": 51.759
    },
    {
      "id": "shot02-22",
      "text": "会查表就够。",
      "start": 51.759,
      "end": 52.601
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "用三条规则重算上一期的最优 k。",
      "start": 0.0,
      "end": 2.823
    },
    {
      "id": "shot03-1",
      "text": "神器登场：",
      "start": 2.823,
      "end": 3.704
    },
    {
      "id": "shot03-2",
      "text": "函数取极值的位置，",
      "start": 3.704,
      "end": 5.166
    },
    {
      "id": "shot03-3",
      "text": "切线必然水平——导数等于零。直观上看：",
      "start": 5.166,
      "end": 8.309
    },
    {
      "id": "shot03-4",
      "text": "上山下山过渡点斜率为零，",
      "start": 8.309,
      "end": 10.352
    },
    {
      "id": "shot03-5",
      "text": "山顶谷底都这样。",
      "start": 10.352,
      "end": 11.753
    },
    {
      "id": "shot03-6",
      "text": "上一期留下的抛物线 L(k) 等于",
      "start": 11.753,
      "end": 13.836
    },
    {
      "id": "shot03-7",
      "text": "L(k) = 145416k² − 281767.6k + 136497.31",
      "start": 13.836,
      "end": 19.663
    },
    {
      "id": "shot03-9",
      "text": "三条规则一气求导：",
      "start": 19.663,
      "end": 21.188
    },
    {
      "id": "shot03-10",
      "text": "145416 乘 k 平方求导得",
      "start": 21.188,
      "end": 23.656
    },
    {
      "id": "shot03-11",
      "text": "290832 k；",
      "start": 23.656,
      "end": 24.86
    },
    {
      "id": "shot03-12",
      "text": "281767.6 乘 k 求导得",
      "start": 24.86,
      "end": 27.388
    },
    {
      "id": "shot03-13",
      "text": "281767.6；",
      "start": 27.388,
      "end": 28.933
    },
    {
      "id": "shot03-14",
      "text": "常数求导得零。",
      "start": 28.933,
      "end": 29.877
    },
    {
      "id": "shot03-15",
      "text": "所以 L'(k) = 290832k − 281767.6。",
      "start": 30.238,
      "end": 35.605
    },
    {
      "id": "shot03-17",
      "text": "令它等于零，",
      "start": 35.605,
      "end": 36.627
    },
    {
      "id": "shot03-18",
      "text": "解出 k 等于 281767.6 除以",
      "start": 36.627,
      "end": 39.671
    },
    {
      "id": "shot03-19",
      "text": "290832，",
      "start": 39.671,
      "end": 40.812
    },
    {
      "id": "shot03-20",
      "text": "约 0.9688。",
      "start": 40.812,
      "end": 42.395
    },
    {
      "id": "shot03-21",
      "text": "和上一期顶点公式 −B/(2A) 一字不差——殊途同归。",
      "start": 42.395,
      "end": 46.861
    },
    {
      "id": "shot03-23",
      "text": "顶点公式不是神迹，",
      "start": 46.861,
      "end": 48.423
    },
    {
      "id": "shot03-24",
      "text": "就是导数等于零的特例。",
      "start": 48.423,
      "end": 50.566
    },
    {
      "id": "shot03-25",
      "text": "LR 的 MSE 损失是碗形的凸函数",
      "start": 50.566,
      "end": 54.05
    },
    {
      "id": "shot03-26",
      "text": "convex function——只有一",
      "start": 54.05,
      "end": 55.733
    },
    {
      "id": "shot03-27",
      "text": "个底，",
      "start": 55.733,
      "end": 56.193
    },
    {
      "id": "shot03-28",
      "text": "不会出现两个谷。",
      "start": 56.193,
      "end": 57.235
    },
    {
      "id": "shot03-29",
      "text": "因为它是凸函数，",
      "start": 57.781,
      "end": 59.41
    },
    {
      "id": "shot03-30",
      "text": "所以这里导数等于零既必要又充分——必然是",
      "start": 59.41,
      "end": 63.252
    },
    {
      "id": "shot03-31",
      "text": "全局最小。",
      "start": 63.252,
      "end": 64.238
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "导数等于零这把神器搞定一元。",
      "start": 0.0,
      "end": 2.463
    },
    {
      "id": "shot04-1",
      "text": "但 LR 真上线要调的旋钮远不止一个——",
      "start": 2.463,
      "end": 5.827
    },
    {
      "id": "shot04-2",
      "text": "身高体重模型至少 (k,",
      "start": 5.827,
      "end": 7.709
    },
    {
      "id": "shot04-3",
      "text": "b) 两个旋钮，",
      "start": 7.709,
      "end": 8.83
    },
    {
      "id": "shot04-4",
      "text": "房价模型 50 个特征加偏置 51 个旋",
      "start": 8.83,
      "end": 12.033
    },
    {
      "id": "shot04-5",
      "text": "钮一起拧。",
      "start": 12.033,
      "end": 12.814
    },
    {
      "id": "shot04-6",
      "text": "多旋钮怎么办？升级招数：",
      "start": 12.814,
      "end": 14.937
    },
    {
      "id": "shot04-7",
      "text": "把'导数等于零'复制到每一个变量。",
      "start": 14.937,
      "end": 17.96
    },
    {
      "id": "shot04-8",
      "text": "每个变量各自的导数叫偏导 partial",
      "start": 17.96,
      "end": 20.803
    },
    {
      "id": "shot04-9",
      "text": "derivative。",
      "start": 20.803,
      "end": 21.704
    },
    {
      "id": "shot04-10",
      "text": "一句话规则：",
      "start": 21.704,
      "end": 22.705
    },
    {
      "id": "shot04-11",
      "text": "偏导就是只动一个旋钮，",
      "start": 22.705,
      "end": 24.627
    },
    {
      "id": "shot04-12",
      "text": "其它当常数按住。",
      "start": 24.627,
      "end": 25.889
    },
    {
      "id": "shot04-13",
      "text": "多变量函数极值的候选条件升级为：",
      "start": 26.3,
      "end": 29.042
    },
    {
      "id": "shot04-14",
      "text": "所有偏导同时等于零——这只是候选，",
      "start": 29.042,
      "end": 32.134
    },
    {
      "id": "shot04-15",
      "text": "鞍点也满足。",
      "start": 32.134,
      "end": 33.365
    },
    {
      "id": "shot04-16",
      "text": "注意一个反例提醒——一个变量的偏导等于零",
      "start": 33.365,
      "end": 36.727
    },
    {
      "id": "shot04-17",
      "text": "只保证那个方向水平，",
      "start": 36.727,
      "end": 38.668
    },
    {
      "id": "shot04-18",
      "text": "其它方向可能还在下降。",
      "start": 38.668,
      "end": 40.949
    },
    {
      "id": "shot04-19",
      "text": "比如 z 等于 x 平方减 y 平方这种",
      "start": 40.949,
      "end": 44.112
    },
    {
      "id": "shot04-20",
      "text": "鞍点 saddle point 函数（形",
      "start": 44.112,
      "end": 46.213
    },
    {
      "id": "shot04-21",
      "text": "状像马鞍，",
      "start": 46.213,
      "end": 47.154
    },
    {
      "id": "shot04-22",
      "text": "一个方向是谷一个方向是峰），",
      "start": 47.154,
      "end": 49.415
    },
    {
      "id": "shot04-23",
      "text": "原点处 ∂x=0、∂y=0，",
      "start": 49.415,
      "end": 52.577
    },
    {
      "id": "shot04-24",
      "text": "但既不是极小也不是极大——下个 demo",
      "start": 52.577,
      "end": 55.463
    },
    {
      "id": "shot04-25",
      "text": "拿这个鞍点开刀。",
      "start": 55.463,
      "end": 56.653
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "打开 demo。",
      "start": 0.0,
      "end": 0.922
    },
    {
      "id": "shot05-1",
      "text": "这个 demo 不挂 LR 数据，",
      "start": 0.922,
      "end": 2.785
    },
    {
      "id": "shot05-2",
      "text": "用 3 个干净的数学函数：",
      "start": 2.785,
      "end": 4.763
    },
    {
      "id": "shot05-3",
      "text": "碗 z 等于 x 平方加 y 平方、",
      "start": 4.763,
      "end": 7.294
    },
    {
      "id": "shot05-4",
      "text": "偏移碗 (x-1) 平方加 (y-2)",
      "start": 7.294,
      "end": 9.158
    },
    {
      "id": "shot05-5",
      "text": "平方、",
      "start": 9.158,
      "end": 9.579
    },
    {
      "id": "shot05-6",
      "text": "还有鞍点 z 等于 x 平方减 y 平方。",
      "start": 9.579,
      "end": 12.424
    },
    {
      "id": "shot05-7",
      "text": "默认就是鞍点，",
      "start": 12.424,
      "end": 13.547
    },
    {
      "id": "shot05-8",
      "text": "故意挑反例开场。",
      "start": 13.547,
      "end": 15.17
    },
    {
      "id": "shot05-9",
      "text": "先看镜头 A，",
      "start": 15.17,
      "end": 16.272
    },
    {
      "id": "shot05-10",
      "text": "沿 x 切一刀。",
      "start": 16.272,
      "end": 17.935
    },
    {
      "id": "shot05-11",
      "text": "蓝色曲线就是固定 y 等于 1.5 时",
      "start": 17.935,
      "end": 20.721
    },
    {
      "id": "shot05-12",
      "text": "z 随 x 变化的样子。",
      "start": 20.721,
      "end": 22.344
    },
    {
      "id": "shot05-13",
      "text": "x 等于 1.5 这点橙色虚线是切线——",
      "start": 22.648,
      "end": 25.612
    },
    {
      "id": "shot05-14",
      "text": "切线斜率就是这个方向的偏导 ∂z/∂x。",
      "start": 25.612,
      "end": 28.715
    },
    {
      "id": "shot05-15",
      "text": "拖 x 滑块红点沿曲线滑，",
      "start": 28.715,
      "end": 31.238
    },
    {
      "id": "shot05-16",
      "text": "切线斜率实时变。",
      "start": 31.238,
      "end": 32.74
    },
    {
      "id": "shot05-17",
      "text": "把 x 拉到 0、",
      "start": 32.74,
      "end": 34.142
    },
    {
      "id": "shot05-18",
      "text": "y 拉到 0——切线水平，",
      "start": 34.142,
      "end": 36.284
    },
    {
      "id": "shot05-19",
      "text": "∂x 等于 0。",
      "start": 36.284,
      "end": 37.365
    },
    {
      "id": "shot05-20",
      "text": "但这真是极值吗？",
      "start": 37.365,
      "end": 38.827
    },
    {
      "id": "shot05-21",
      "text": "切到镜头 B 看对偶切片。",
      "start": 38.827,
      "end": 41.17
    },
    {
      "id": "shot05-22",
      "text": "左图沿 x 切，",
      "start": 41.17,
      "end": 42.872
    },
    {
      "id": "shot05-23",
      "text": "蓝曲线开口向上像碗——x 方向是极小。",
      "start": 42.872,
      "end": 46.696
    },
    {
      "id": "shot05-24",
      "text": "右图沿 y 切，",
      "start": 46.696,
      "end": 48.258
    },
    {
      "id": "shot05-25",
      "text": "紫曲线开口向下像倒扣的碗——y 方向是极",
      "start": 48.258,
      "end": 51.542
    },
    {
      "id": "shot05-26",
      "text": "大。",
      "start": 51.542,
      "end": 51.562
    },
    {
      "id": "shot05-27",
      "text": "同一点两个方向曲率相反——这就是鞍点",
      "start": 52.366,
      "end": 55.86
    },
    {
      "id": "shot05-28",
      "text": "saddle point。",
      "start": 55.86,
      "end": 57.366
    },
    {
      "id": "shot05-29",
      "text": "一个偏导等于零远远不够，",
      "start": 57.366,
      "end": 60.056
    },
    {
      "id": "shot05-30",
      "text": "所有方向都要水平才是极值。",
      "start": 60.056,
      "end": 62.566
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "再切镜头 C 看全景。",
      "start": 0.0,
      "end": 2.061
    },
    {
      "id": "shot06-1",
      "text": "左边俯视等高线 + 黄色梯度箭头，",
      "start": 2.061,
      "end": 4.943
    },
    {
      "id": "shot06-2",
      "text": "右边 plotly 3D 曲面。",
      "start": 4.943,
      "end": 7.044
    },
    {
      "id": "shot06-3",
      "text": "鞍点 3D 看像马鞍，",
      "start": 7.044,
      "end": 8.625
    },
    {
      "id": "shot06-4",
      "text": "等高线看像十字交叉。",
      "start": 8.625,
      "end": 10.486
    },
    {
      "id": "shot06-5",
      "text": "黄色箭头方向就是梯度 gradient，",
      "start": 10.486,
      "end": 12.707
    },
    {
      "id": "shot06-6",
      "text": "写成 ∇f——所有偏导塞进一个向量。",
      "start": 12.707,
      "end": 16.409
    },
    {
      "id": "shot06-7",
      "text": "梯度方向在几何上是上升最快的方向，",
      "start": 16.409,
      "end": 19.21
    },
    {
      "id": "shot06-8",
      "text": "等高线的法线。",
      "start": 19.21,
      "end": 20.511
    },
    {
      "id": "shot06-9",
      "text": "下期梯度下降会用到，",
      "start": 20.511,
      "end": 22.192
    },
    {
      "id": "shot06-10",
      "text": "本期只记一条性质：",
      "start": 22.192,
      "end": 23.753
    },
    {
      "id": "shot06-11",
      "text": "梯度等于零向量等于所有偏导同时为零。",
      "start": 23.753,
      "end": 26.834
    },
    {
      "id": "shot06-12",
      "text": "最后切到碗函数试一下——dropdown",
      "start": 26.834,
      "end": 29.296
    },
    {
      "id": "shot06-13",
      "text": "切到'碗'。",
      "start": 29.296,
      "end": 29.636
    },
    {
      "id": "shot06-14",
      "text": "两个方向都开口向上，",
      "start": 30.169,
      "end": 32.151
    },
    {
      "id": "shot06-15",
      "text": "原点处梯度等于零是真极小，徽章变绿。",
      "start": 32.151,
      "end": 35.436
    },
    {
      "id": "shot06-16",
      "text": "镜头 D 把切片和等高线对应起来。",
      "start": 35.436,
      "end": 38.399
    },
    {
      "id": "shot06-17",
      "text": "回到 LR：",
      "start": 38.399,
      "end": 39.601
    },
    {
      "id": "shot06-18",
      "text": "损失 L(k,",
      "start": 39.601,
      "end": 40.762
    },
    {
      "id": "shot06-19",
      "text": "b) 是二元函数，",
      "start": 40.762,
      "end": 42.024
    },
    {
      "id": "shot06-20",
      "text": "对 k 偏导一条方程、",
      "start": 42.024,
      "end": 43.626
    },
    {
      "id": "shot06-21",
      "text": "对 b 偏导一条方程，",
      "start": 43.626,
      "end": 45.248
    },
    {
      "id": "shot06-22",
      "text": "联立两条方程两个未知数，",
      "start": 45.248,
      "end": 47.251
    },
    {
      "id": "shot06-23",
      "text": "原则上能解出最优 (k,b)。",
      "start": 47.251,
      "end": 49.674
    },
    {
      "id": "shot06-24",
      "text": "但具体怎么解？",
      "start": 49.674,
      "end": 50.995
    },
    {
      "id": "shot06-25",
      "text": "偏导写成展开式一行行很累——下期升级到矩",
      "start": 50.995,
      "end": 54.86
    },
    {
      "id": "shot06-26",
      "text": "阵语言。",
      "start": 54.86,
      "end": 55.421
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.881
    },
    {
      "id": "shot07-1",
      "text": "我们解决了 LR 黑盒钥匙磨亮三件事：",
      "start": 0.881,
      "end": 3.926
    },
    {
      "id": "shot07-2",
      "text": "第一，",
      "start": 3.926,
      "end": 4.326
    },
    {
      "id": "shot07-3",
      "text": "导数等于切线斜率，",
      "start": 4.326,
      "end": 5.819
    },
    {
      "id": "shot07-4",
      "text": "幂函数加和加常数三条规则；第二，",
      "start": 5.819,
      "end": 8.653
    },
    {
      "id": "shot07-5",
      "text": "神器导数等于零找极值，",
      "start": 8.653,
      "end": 10.576
    },
    {
      "id": "shot07-6",
      "text": "重新算了上一期的 k 等于 0.9688",
      "start": 10.576,
      "end": 13.26
    },
    {
      "id": "shot07-7",
      "text": "殊途同归；第三，",
      "start": 13.52,
      "end": 15.203
    },
    {
      "id": "shot07-8",
      "text": "多元升级到偏导加梯度，",
      "start": 15.203,
      "end": 17.246
    },
    {
      "id": "shot07-9",
      "text": "所有偏导同时为零是极值的候选条件，",
      "start": 17.246,
      "end": 20.23
    },
    {
      "id": "shot07-10",
      "text": "鞍点反例提醒一个偏导等于零远远不够。",
      "start": 20.23,
      "end": 23.095
    },
    {
      "id": "shot07-11",
      "text": "点到没展开的：",
      "start": 23.565,
      "end": 24.767
    },
    {
      "id": "shot07-12",
      "text": "二阶导判别极大极小——二阶导就是导数的导",
      "start": 24.767,
      "end": 28.632
    },
    {
      "id": "shot07-13",
      "text": "数，",
      "start": 28.632,
      "end": 28.913
    },
    {
      "id": "shot07-14",
      "text": "能进一步区分山顶和谷底，",
      "start": 28.913,
      "end": 31.156
    },
    {
      "id": "shot07-15",
      "text": "LR 凸函数只有一个底所以不用纠结；",
      "start": 31.156,
      "end": 34.29
    },
    {
      "id": "shot07-16",
      "text": "梯度方向上升最快这个性质，",
      "start": 34.29,
      "end": 36.664
    },
    {
      "id": "shot07-17",
      "text": "刚才镜头 C 已经看到，",
      "start": 36.664,
      "end": 38.446
    },
    {
      "id": "shot07-18",
      "text": "下期梯度下降会用上。",
      "start": 38.446,
      "end": 40.629
    },
    {
      "id": "shot07-19",
      "text": "下一期我们把偏导联立写法升级到矩阵：",
      "start": 40.629,
      "end": 43.934
    },
    {
      "id": "shot07-20",
      "text": "一行 Xw 覆盖所有样本，",
      "start": 43.934,
      "end": 46.398
    },
    {
      "id": "shot07-21",
      "text": "一行 ∇L = 0 覆盖所有偏导。",
      "start": 46.398,
      "end": 49.342
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.644
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.644,
      "end": 1.993
    }
  ]
}