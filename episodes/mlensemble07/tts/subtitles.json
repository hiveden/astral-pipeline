{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们手算了 AdaBoost 的",
      "start": 0.0,
      "end": 2.083
    },
    {
      "id": "shot01-1",
      "text": "3 轮循环：",
      "start": 2.083,
      "end": 3.104
    },
    {
      "id": "shot01-2",
      "text": "找当前权重下最好的决策桩，",
      "start": 3.104,
      "end": 5.427
    },
    {
      "id": "shot01-3",
      "text": "计算学习器权重，",
      "start": 5.427,
      "end": 6.809
    },
    {
      "id": "shot01-4",
      "text": "放大分错样本，",
      "start": 6.809,
      "end": 8.051
    },
    {
      "id": "shot01-5",
      "text": "缩小分对样本。",
      "start": 8.051,
      "end": 9.392
    },
    {
      "id": "shot01-6",
      "text": "10 个样本还能摊开算，",
      "start": 9.392,
      "end": 11.195
    },
    {
      "id": "shot01-7",
      "text": "换成葡萄酒数据就不该手算了。",
      "start": 11.195,
      "end": 14.059
    },
    {
      "id": "shot01-8",
      "text": "原始数据有 178 瓶酒，",
      "start": 14.059,
      "end": 16.262
    },
    {
      "id": "shot01-9",
      "text": "每瓶有酒精含量、",
      "start": 16.262,
      "end": 17.804
    },
    {
      "id": "shot01-10",
      "text": "色泽等特征，",
      "start": 17.804,
      "end": 18.905
    },
    {
      "id": "shot01-11",
      "text": "类别来自不同产区。",
      "start": 18.905,
      "end": 20.567
    },
    {
      "id": "shot01-12",
      "text": "我们要把手算流程交给 sklearn 的",
      "start": 20.567,
      "end": 23.371
    },
    {
      "id": "shot01-13",
      "text": "AdaBoostClassifier，",
      "start": 23.371,
      "end": 25.153
    },
    {
      "id": "shot01-14",
      "text": "让它自动训练很多棵决策桩，",
      "start": 25.153,
      "end": 27.416
    },
    {
      "id": "shot01-15",
      "text": "再把它们按权重组合起来。",
      "start": 27.416,
      "end": 29.339
    },
    {
      "id": "shot01-16",
      "text": "这期的重点不是追一个固定分数，",
      "start": 29.584,
      "end": 31.928
    },
    {
      "id": "shot01-17",
      "text": "而是跑通一条工程线：",
      "start": 31.928,
      "end": 33.832
    },
    {
      "id": "shot01-18",
      "text": "怎么把 3 类葡萄酒改成二分类，",
      "start": 33.832,
      "end": 36.396
    },
    {
      "id": "shot01-19",
      "text": "怎么做标签编码，",
      "start": 36.396,
      "end": 37.839
    },
    {
      "id": "shot01-20",
      "text": "怎么拿单棵决策桩做基线，",
      "start": 37.839,
      "end": 40.284
    },
    {
      "id": "shot01-21",
      "text": "以及 estimator、",
      "start": 40.284,
      "end": 41.506
    },
    {
      "id": "shot01-22",
      "text": "n_estimators、",
      "start": 41.506,
      "end": 42.608
    },
    {
      "id": "shot01-23",
      "text": "learning_rate 这三个旋钮到",
      "start": 42.608,
      "end": 44.471
    },
    {
      "id": "shot01-24",
      "text": "底控制什么。",
      "start": 44.471,
      "end": 45.112
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看数据。",
      "start": 0.0,
      "end": 1.002
    },
    {
      "id": "shot02-1",
      "text": "葡萄酒原始标签是 Class label，",
      "start": 1.002,
      "end": 3.507
    },
    {
      "id": "shot02-2",
      "text": "取值 1、2、3。",
      "start": 3.507,
      "end": 5.19
    },
    {
      "id": "shot02-3",
      "text": "这个案例为了贴合 AdaBoost 的二",
      "start": 5.19,
      "end": 7.654
    },
    {
      "id": "shot02-4",
      "text": "分类讲法，",
      "start": 7.654,
      "end": 8.616
    },
    {
      "id": "shot02-5",
      "text": "先去掉类别 1，",
      "start": 8.616,
      "end": 9.879
    },
    {
      "id": "shot02-6",
      "text": "只保留类别 2 和 3。",
      "start": 9.879,
      "end": 11.662
    },
    {
      "id": "shot02-7",
      "text": "特征也只取两列：",
      "start": 11.662,
      "end": 13.205
    },
    {
      "id": "shot02-8",
      "text": "Alcohol 表示酒精含量，",
      "start": 13.205,
      "end": 14.868
    },
    {
      "id": "shot02-9",
      "text": "Hue 表示色泽。",
      "start": 14.868,
      "end": 16.411
    },
    {
      "id": "shot02-10",
      "text": "为什么不用全部特征？",
      "start": 16.411,
      "end": 18.455
    },
    {
      "id": "shot02-11",
      "text": "因为教学演示里两个特征可以画在二维平面上，",
      "start": 18.455,
      "end": 22.162
    },
    {
      "id": "shot02-12",
      "text": "后面比较单棵树和 AdaBoost 的决",
      "start": 22.162,
      "end": 24.586
    },
    {
      "id": "shot02-13",
      "text": "策边界会更直观。",
      "start": 24.586,
      "end": 25.789
    },
    {
      "id": "shot02-14",
      "text": "接着用 LabelEncoder 把类别",
      "start": 26.291,
      "end": 28.455
    },
    {
      "id": "shot02-15",
      "text": "2 和 3 转成 0 和 1。这里注意，",
      "start": 28.455,
      "end": 31.019
    },
    {
      "id": "shot02-16",
      "text": "sklearn 可以接受 0 和 1 标",
      "start": 31.019,
      "end": 33.323
    },
    {
      "id": "shot02-17",
      "text": "签，",
      "start": 33.323,
      "end": 33.584
    },
    {
      "id": "shot02-18",
      "text": "也可以接受负 1 和正 1 的标签；",
      "start": 33.584,
      "end": 36.369
    },
    {
      "id": "shot02-19",
      "text": "我们按代码习惯用 0 和 1。",
      "start": 36.369,
      "end": 39.194
    },
    {
      "id": "shot02-20",
      "text": "最后用 train_test_split",
      "start": 39.194,
      "end": 41.117
    },
    {
      "id": "shot02-21",
      "text": "划分训练集和测试集，",
      "start": 41.117,
      "end": 43.221
    },
    {
      "id": "shot02-22",
      "text": "固定 random_state，",
      "start": 43.221,
      "end": 44.583
    },
    {
      "id": "shot02-23",
      "text": "避免每次运行结果漂移。",
      "start": 44.583,
      "end": 46.447
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "集成模型上场前，",
      "start": 0.02,
      "end": 1.482
    },
    {
      "id": "shot03-1",
      "text": "先训练一棵单独的决策树作为基线。",
      "start": 1.482,
      "end": 4.267
    },
    {
      "id": "shot03-2",
      "text": "这里用",
      "start": 4.267,
      "end": 4.768
    },
    {
      "id": "shot03-3",
      "text": "DecisionTreeClassifier，",
      "start": 4.768,
      "end": 6.731
    },
    {
      "id": "shot03-4",
      "text": "criterion 设为 entropy，",
      "start": 6.731,
      "end": 8.955
    },
    {
      "id": "shot03-5",
      "text": "max_depth 设为 1。",
      "start": 8.955,
      "end": 11.138
    },
    {
      "id": "shot03-6",
      "text": "max_depth 等于 1 的树就是决",
      "start": 11.138,
      "end": 13.362
    },
    {
      "id": "shot03-7",
      "text": "策桩，",
      "start": 13.362,
      "end": 13.983
    },
    {
      "id": "shot03-8",
      "text": "它只能问一个问题，",
      "start": 13.983,
      "end": 15.305
    },
    {
      "id": "shot03-9",
      "text": "比如酒精含量是否超过某个阈值，",
      "start": 15.305,
      "end": 18.25
    },
    {
      "id": "shot03-10",
      "text": "或者色泽是否超过某个阈值。",
      "start": 18.25,
      "end": 20.714
    },
    {
      "id": "shot03-11",
      "text": "这个基线很重要，",
      "start": 20.714,
      "end": 21.996
    },
    {
      "id": "shot03-12",
      "text": "因为 AdaBoost 的效果要和它对比，",
      "start": 21.996,
      "end": 24.561
    },
    {
      "id": "shot03-13",
      "text": "而不是孤零零看一个分数。",
      "start": 24.561,
      "end": 26.264
    },
    {
      "id": "shot03-14",
      "text": "单棵决策桩通常会欠拟合：",
      "start": 26.755,
      "end": 28.94
    },
    {
      "id": "shot03-15",
      "text": "它边界简单，",
      "start": 28.94,
      "end": 30.022
    },
    {
      "id": "shot03-16",
      "text": "训练集和测试集都不会特别高。",
      "start": 30.022,
      "end": 32.227
    },
    {
      "id": "shot03-17",
      "text": "但这正适合 AdaBoost。",
      "start": 32.227,
      "end": 34.031
    },
    {
      "id": "shot03-18",
      "text": "AdaBoost 不指望每棵树都很强，",
      "start": 34.031,
      "end": 36.416
    },
    {
      "id": "shot03-19",
      "text": "而是希望每棵树只抓住一小段规律，",
      "start": 36.416,
      "end": 38.981
    },
    {
      "id": "shot03-20",
      "text": "再通过很多轮加权接力，",
      "start": 38.981,
      "end": 40.886
    },
    {
      "id": "shot03-21",
      "text": "把简单边界组合成更复杂的边界。",
      "start": 40.886,
      "end": 43.251
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "接着实例化",
      "start": 0.0,
      "end": 1.182
    },
    {
      "id": "shot04-1",
      "text": "AdaBoostClassifier。",
      "start": 1.182,
      "end": 2.925
    },
    {
      "id": "shot04-2",
      "text": "第一个参数是 estimator，",
      "start": 2.925,
      "end": 4.888
    },
    {
      "id": "shot04-3",
      "text": "也就是基学习器。",
      "start": 4.888,
      "end": 6.37
    },
    {
      "id": "shot04-4",
      "text": "这里传入刚才那棵深度为 1 的决策树。",
      "start": 6.37,
      "end": 9.375
    },
    {
      "id": "shot04-5",
      "text": "老版本 sklearn 里这个参数叫",
      "start": 9.375,
      "end": 11.779
    },
    {
      "id": "shot04-6",
      "text": "base_estimator，",
      "start": 11.779,
      "end": 13.101
    },
    {
      "id": "shot04-7",
      "text": "新版本统一叫 estimator。",
      "start": 13.101,
      "end": 15.645
    },
    {
      "id": "shot04-8",
      "text": "第二个参数是 n_estimators，",
      "start": 15.645,
      "end": 18.21
    },
    {
      "id": "shot04-9",
      "text": "表示最多训练多少个弱学习器。",
      "start": 18.21,
      "end": 21.135
    },
    {
      "id": "shot04-10",
      "text": "案例里设 500，",
      "start": 21.135,
      "end": 22.477
    },
    {
      "id": "shot04-11",
      "text": "意思是允许 500 棵决策桩接力。",
      "start": 22.477,
      "end": 24.901
    },
    {
      "id": "shot04-12",
      "text": "第三个参数是 learning_rate，",
      "start": 25.366,
      "end": 27.53
    },
    {
      "id": "shot04-13",
      "text": "案例里设 0.1。",
      "start": 27.53,
      "end": 29.113
    },
    {
      "id": "shot04-14",
      "text": "它会缩放每轮学习器的话语权，",
      "start": 29.113,
      "end": 31.738
    },
    {
      "id": "shot04-15",
      "text": "也会间接影响样本权重更新速度。",
      "start": 31.738,
      "end": 34.684
    },
    {
      "id": "shot04-16",
      "text": "learning_rate 小，步子稳，",
      "start": 34.684,
      "end": 36.708
    },
    {
      "id": "shot04-17",
      "text": "但通常需要更多 n_estimators",
      "start": 36.708,
      "end": 39.132
    },
    {
      "id": "shot04-18",
      "text": "配合；",
      "start": 39.132,
      "end": 39.633
    },
    {
      "id": "shot04-19",
      "text": "learning_rate 大，",
      "start": 39.633,
      "end": 41.036
    },
    {
      "id": "shot04-20",
      "text": "前几轮推进快，",
      "start": 41.036,
      "end": 42.318
    },
    {
      "id": "shot04-21",
      "text": "但更容易被噪声带偏。",
      "start": 42.318,
      "end": 44.603
    },
    {
      "id": "shot04-22",
      "text": "工程上不要单独拧一个旋钮，",
      "start": 44.603,
      "end": 46.867
    },
    {
      "id": "shot04-23",
      "text": "要把轮数和学习率一起看。",
      "start": 46.867,
      "end": 48.63
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "训练和评估时，",
      "start": 0.0,
      "end": 1.081
    },
    {
      "id": "shot05-1",
      "text": "流程很朴素：",
      "start": 1.081,
      "end": 2.283
    },
    {
      "id": "shot05-2",
      "text": "先 fit 单棵决策桩，",
      "start": 2.283,
      "end": 3.905
    },
    {
      "id": "shot05-3",
      "text": "再在测试集 score；",
      "start": 3.905,
      "end": 5.426
    },
    {
      "id": "shot05-4",
      "text": "再 fit AdaBoost，",
      "start": 5.426,
      "end": 6.648
    },
    {
      "id": "shot05-5",
      "text": "也在同一份测试集 score。注意，",
      "start": 6.648,
      "end": 8.97
    },
    {
      "id": "shot05-6",
      "text": "不要提前写死一个漂亮准确率，",
      "start": 8.97,
      "end": 11.273
    },
    {
      "id": "shot05-7",
      "text": "除非已经用当前环境真实跑过，",
      "start": 11.273,
      "end": 13.816
    },
    {
      "id": "shot05-8",
      "text": "并且记录了数据文件、",
      "start": 13.816,
      "end": 15.418
    },
    {
      "id": "shot05-9",
      "text": "随机种子和库版本。",
      "start": 15.418,
      "end": 17.44
    },
    {
      "id": "shot05-10",
      "text": "这里更重要的是解释差异来源。",
      "start": 17.44,
      "end": 19.863
    },
    {
      "id": "shot05-11",
      "text": "单棵决策桩只能画一条简单分界线，",
      "start": 19.863,
      "end": 22.907
    },
    {
      "id": "shot05-12",
      "text": "AdaBoost 是很多条简单分界线的加",
      "start": 22.907,
      "end": 25.51
    },
    {
      "id": "shot05-13",
      "text": "权组合，",
      "start": 25.51,
      "end": 26.23
    },
    {
      "id": "shot05-14",
      "text": "所以边界会更灵活。",
      "start": 26.23,
      "end": 27.652
    },
    {
      "id": "shot05-15",
      "text": "它通常能比单棵决策桩更好，",
      "start": 27.898,
      "end": 30.504
    },
    {
      "id": "shot05-16",
      "text": "但不保证永远胜过所有模型。随机森林、",
      "start": 30.504,
      "end": 33.992
    },
    {
      "id": "shot05-17",
      "text": "AdaBoost、",
      "start": 33.992,
      "end": 34.934
    },
    {
      "id": "shot05-18",
      "text": "GBDT 在小数据上分数差距可能只有几个",
      "start": 34.934,
      "end": 38.442
    },
    {
      "id": "shot05-19",
      "text": "百分点。",
      "start": 38.442,
      "end": 39.124
    },
    {
      "id": "shot05-20",
      "text": "评价模型不是背结论，",
      "start": 39.124,
      "end": 40.928
    },
    {
      "id": "shot05-21",
      "text": "而是在同一切分、同一指标、",
      "start": 40.928,
      "end": 43.373
    },
    {
      "id": "shot05-22",
      "text": "同一随机种子下做公平对比。",
      "start": 43.373,
      "end": 45.518
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "最后收三个坑。第一，",
      "start": 0.0,
      "end": 1.842
    },
    {
      "id": "shot06-1",
      "text": "基学习器不是越强越好。",
      "start": 1.842,
      "end": 3.805
    },
    {
      "id": "shot06-2",
      "text": "把 max_depth 从 1 改到 5，",
      "start": 3.805,
      "end": 5.807
    },
    {
      "id": "shot06-3",
      "text": "单棵树自己就可能把训练集学得很满，",
      "start": 5.807,
      "end": 8.871
    },
    {
      "id": "shot06-4",
      "text": "AdaBoost 的接力纠错空间反而变小，",
      "start": 8.871,
      "end": 11.714
    },
    {
      "id": "shot06-5",
      "text": "测试集还可能因为方差变大而下降。第二，",
      "start": 11.714,
      "end": 14.958
    },
    {
      "id": "shot06-6",
      "text": "learning_rate 和",
      "start": 14.958,
      "end": 15.899
    },
    {
      "id": "shot06-7",
      "text": "n_estimators 要联调。",
      "start": 15.899,
      "end": 18.142
    },
    {
      "id": "shot06-8",
      "text": "学习率降到 0.01，",
      "start": 18.142,
      "end": 20.004
    },
    {
      "id": "shot06-9",
      "text": "却仍然只训练几十棵树，",
      "start": 20.004,
      "end": 22.147
    },
    {
      "id": "shot06-10",
      "text": "模型很可能欠拟合；",
      "start": 22.147,
      "end": 24.089
    },
    {
      "id": "shot06-11",
      "text": "学习率很大又训练很多棵，",
      "start": 24.089,
      "end": 26.252
    },
    {
      "id": "shot06-12",
      "text": "可能追着噪声跑。第三，",
      "start": 26.252,
      "end": 28.174
    },
    {
      "id": "shot06-13",
      "text": "注意 API 名称。",
      "start": 28.174,
      "end": 29.396
    },
    {
      "id": "shot06-14",
      "text": "旧资料里常见",
      "start": 29.831,
      "end": 31.054
    },
    {
      "id": "shot06-15",
      "text": "base_estimator，",
      "start": 31.054,
      "end": 32.458
    },
    {
      "id": "shot06-16",
      "text": "新版本应该写 estimator。",
      "start": 32.458,
      "end": 34.643
    },
    {
      "id": "shot06-17",
      "text": "到这里，",
      "start": 34.643,
      "end": 35.184
    },
    {
      "id": "shot06-18",
      "text": "AdaBoost 的机制、",
      "start": 35.184,
      "end": 36.568
    },
    {
      "id": "shot06-19",
      "text": "手算和 API 实战就串起来了：",
      "start": 36.568,
      "end": 39.535
    },
    {
      "id": "shot06-20",
      "text": "它用样本权重传递上一轮的错误。",
      "start": 39.535,
      "end": 42.783
    },
    {
      "id": "shot06-21",
      "text": "下一条路线会换一种通信方式，",
      "start": 42.783,
      "end": 45.55
    },
    {
      "id": "shot06-22",
      "text": "不再说哪条样本更重要，",
      "start": 45.55,
      "end": 47.615
    },
    {
      "id": "shot06-23",
      "text": "而是直接告诉下一棵树还差多少。",
      "start": 47.615,
      "end": 50.161
    }
