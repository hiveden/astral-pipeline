{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们说，",
      "start": 0.0,
      "end": 1.1
    },
    {
      "id": "shot01-1",
      "text": "集成学习不是简单复制 5 个一样的模型，",
      "start": 1.1,
      "end": 4.562
    },
    {
      "id": "shot01-2",
      "text": "而是让一群想法不同的模型一起判断。",
      "start": 4.562,
      "end": 7.623
    },
    {
      "id": "shot01-3",
      "text": "那这一期就接着问：",
      "start": 7.623,
      "end": 9.104
    },
    {
      "id": "shot01-4",
      "text": "差异到底怎么制造？",
      "start": 9.104,
      "end": 10.745
    },
    {
      "id": "shot01-5",
      "text": "还是 5 位医生读 CT。",
      "start": 10.745,
      "end": 13.086
    },
    {
      "id": "shot01-6",
      "text": "第一种组织方式，",
      "start": 13.086,
      "end": 14.426
    },
    {
      "id": "shot01-7",
      "text": "是让 5 位医生同时看病例，",
      "start": 14.426,
      "end": 16.707
    },
    {
      "id": "shot01-8",
      "text": "但每个人手里的病例库不同，",
      "start": 16.707,
      "end": 18.928
    },
    {
      "id": "shot01-9",
      "text": "看完之后平等投票。",
      "start": 18.928,
      "end": 20.709
    },
    {
      "id": "shot01-10",
      "text": "第二种组织方式，",
      "start": 20.709,
      "end": 21.989
    },
    {
      "id": "shot01-11",
      "text": "是第 1 位医生先看，",
      "start": 21.989,
      "end": 23.75
    },
    {
      "id": "shot01-12",
      "text": "漏诊的疑难片专门交给第 2 位，",
      "start": 23.75,
      "end": 26.332
    },
    {
      "id": "shot01-13",
      "text": "第 2 位漏掉的再交给第 3 位，",
      "start": 26.332,
      "end": 28.626
    },
    {
      "id": "shot01-14",
      "text": "最后按每位医生表现加权投票。",
      "start": 28.626,
      "end": 31.022
    },
    {
      "id": "shot01-15",
      "text": "前一种就是 bagging，",
      "start": 31.614,
      "end": 32.977
    },
    {
      "id": "shot01-16",
      "text": "后一种就是 boosting。",
      "start": 32.977,
      "end": 34.341
    },
    {
      "id": "shot01-17",
      "text": "它们都是集成学习，",
      "start": 34.341,
      "end": 35.684
    },
    {
      "id": "shot01-18",
      "text": "但气质完全不同：",
      "start": 35.684,
      "end": 37.027
    },
    {
      "id": "shot01-19",
      "text": "bagging 并行求稳，",
      "start": 37.027,
      "end": 38.331
    },
    {
      "id": "shot01-20",
      "text": "boosting 串行纠错。",
      "start": 38.331,
      "end": 40.015
    },
    {
      "id": "shot01-21",
      "text": "这一期我们只解决一个问题：",
      "start": 40.015,
      "end": 41.939
    },
    {
      "id": "shot01-22",
      "text": "同样是多个模型，",
      "start": 41.939,
      "end": 43.323
    },
    {
      "id": "shot01-23",
      "text": "为什么一个靠抽样制造差异，",
      "start": 43.323,
      "end": 45.448
    },
    {
      "id": "shot01-24",
      "text": "一个靠接力修错制造差异。",
      "start": 45.448,
      "end": 47.353
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看 bagging。",
      "start": 0.0,
      "end": 0.981
    },
    {
      "id": "shot02-1",
      "text": "Bagging 的全称是",
      "start": 0.981,
      "end": 2.262
    },
    {
      "id": "shot02-2",
      "text": "Bootstrap",
      "start": 2.262,
      "end": 3.082
    },
    {
      "id": "shot02-3",
      "text": "Aggregating，",
      "start": 3.082,
      "end": 4.183
    },
    {
      "id": "shot02-4",
      "text": "中文常译成装袋法或自助聚合。",
      "start": 4.183,
      "end": 7.365
    },
    {
      "id": "shot02-5",
      "text": "它分两步。第一步，",
      "start": 7.365,
      "end": 9.227
    },
    {
      "id": "shot02-6",
      "text": "bootstrap 抽样，",
      "start": 9.227,
      "end": 10.688
    },
    {
      "id": "shot02-7",
      "text": "也就是有放回抽样。",
      "start": 10.688,
      "end": 12.789
    },
    {
      "id": "shot02-8",
      "text": "假设原始训练集有 1000 条样本，",
      "start": 12.789,
      "end": 15.791
    },
    {
      "id": "shot02-9",
      "text": "我们随机抽 1000 次，",
      "start": 15.791,
      "end": 17.533
    },
    {
      "id": "shot02-10",
      "text": "每抽完一条就放回去，",
      "start": 17.533,
      "end": 19.374
    },
    {
      "id": "shot02-11",
      "text": "所以同一条样本可能被抽中多次，",
      "start": 19.374,
      "end": 22.196
    },
    {
      "id": "shot02-12",
      "text": "也可能一次都没被抽中。",
      "start": 22.196,
      "end": 23.997
    },
    {
      "id": "shot02-13",
      "text": "这样重复 5 次，",
      "start": 23.997,
      "end": 25.358
    },
    {
      "id": "shot02-14",
      "text": "就得到 5 份有重叠但不完全相同的训练子",
      "start": 25.358,
      "end": 28.754
    },
    {
      "id": "shot02-15",
      "text": "集。",
      "start": 28.754,
      "end": 28.901
    },
    {
      "id": "shot02-16",
      "text": "第二步，",
      "start": 29.477,
      "end": 29.898
    },
    {
      "id": "shot02-17",
      "text": "aggregating，",
      "start": 29.898,
      "end": 30.94
    },
    {
      "id": "shot02-18",
      "text": "也就是聚合。",
      "start": 30.94,
      "end": 32.176
    },
    {
      "id": "shot02-19",
      "text": "5 份子集各训练一棵树，",
      "start": 32.176,
      "end": 34.006
    },
    {
      "id": "shot02-20",
      "text": "预测时 5 棵树同时给答案，",
      "start": 34.006,
      "end": 36.471
    },
    {
      "id": "shot02-21",
      "text": "分类任务用平权投票，",
      "start": 36.471,
      "end": 38.515
    },
    {
      "id": "shot02-22",
      "text": "回归任务取平均。",
      "start": 38.515,
      "end": 39.998
    },
    {
      "id": "shot02-23",
      "text": "这里最重要的是三个词：有放回、并行、",
      "start": 39.998,
      "end": 42.984
    },
    {
      "id": "shot02-24",
      "text": "平权。",
      "start": 42.984,
      "end": 43.625
    },
    {
      "id": "shot02-25",
      "text": "每棵树看的数据不一样，",
      "start": 43.625,
      "end": 45.449
    },
    {
      "id": "shot02-26",
      "text": "所以学到的边界不一样；",
      "start": 45.449,
      "end": 47.553
    },
    {
      "id": "shot02-27",
      "text": "每棵树互不依赖，",
      "start": 47.553,
      "end": 48.976
    },
    {
      "id": "shot02-28",
      "text": "所以可以并行训练；",
      "start": 48.976,
      "end": 50.639
    },
    {
      "id": "shot02-29",
      "text": "最后一棵树一票，",
      "start": 50.639,
      "end": 51.942
    },
    {
      "id": "shot02-30",
      "text": "没有谁的话语权更大。",
      "start": 51.942,
      "end": 53.364
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "bagging 主要解决的是不稳定。",
      "start": 0.0,
      "end": 1.942
    },
    {
      "id": "shot03-1",
      "text": "这里引入一个术语：方差，",
      "start": 1.942,
      "end": 3.865
    },
    {
      "id": "shot03-2",
      "text": "英文 variance。",
      "start": 3.865,
      "end": 5.106
    },
    {
      "id": "shot03-3",
      "text": "模型方差大，",
      "start": 5.106,
      "end": 6.288
    },
    {
      "id": "shot03-4",
      "text": "意思是训练数据稍微换一换，",
      "start": 6.288,
      "end": 8.45
    },
    {
      "id": "shot03-5",
      "text": "模型形状和预测结果就大变。",
      "start": 8.45,
      "end": 10.833
    },
    {
      "id": "shot03-6",
      "text": "决策树就是典型例子，",
      "start": 10.833,
      "end": 12.515
    },
    {
      "id": "shot03-7",
      "text": "某个特征刚好排在前面，",
      "start": 12.515,
      "end": 14.588
    },
    {
      "id": "shot03-8",
      "text": "树的根节点可能就完全不同。",
      "start": 14.588,
      "end": 17.001
    },
    {
      "id": "shot03-9",
      "text": "bagging 的做法不是让一棵树变得更",
      "start": 17.001,
      "end": 19.323
    },
    {
      "id": "shot03-10",
      "text": "聪明，",
      "start": 19.323,
      "end": 19.884
    },
    {
      "id": "shot03-11",
      "text": "而是让多棵树从不同数据子集出发，",
      "start": 19.884,
      "end": 22.687
    },
    {
      "id": "shot03-12",
      "text": "各自过拟合到不同方向，",
      "start": 22.687,
      "end": 24.53
    },
    {
      "id": "shot03-13",
      "text": "最后投票或平均，",
      "start": 24.53,
      "end": 26.031
    },
    {
      "id": "shot03-14",
      "text": "把这些随机波动互相抵消。",
      "start": 26.031,
      "end": 27.754
    },
    {
      "id": "shot03-15",
      "text": "用一个虚构示意看：",
      "start": 28.318,
      "end": 29.82
    },
    {
      "id": "shot03-16",
      "text": "单棵树测试准确率可能在 73% 到 83",
      "start": 29.82,
      "end": 33.826
    },
    {
      "id": "shot03-17",
      "text": "% 之间来回晃；",
      "start": 33.826,
      "end": 35.248
    },
    {
      "id": "shot03-18",
      "text": "5 棵 bagging 之后，",
      "start": 35.248,
      "end": 36.57
    },
    {
      "id": "shot03-19",
      "text": "平均水平可能更高，",
      "start": 36.57,
      "end": 38.413
    },
    {
      "id": "shot03-20",
      "text": "重训波动也明显变小。",
      "start": 38.413,
      "end": 40.516
    },
    {
      "id": "shot03-21",
      "text": "这里不要死记数字，记机制：",
      "start": 40.516,
      "end": 42.579
    },
    {
      "id": "shot03-22",
      "text": "只要每棵树的错误不完全重合，",
      "start": 42.579,
      "end": 45.143
    },
    {
      "id": "shot03-23",
      "text": "平均就能压掉一部分随机噪声。",
      "start": 45.143,
      "end": 48.187
    },
    {
      "id": "shot03-24",
      "text": "所以 bagging 适合高方差模型，",
      "start": 48.187,
      "end": 50.471
    },
    {
      "id": "shot03-25",
      "text": "尤其适合决策树。",
      "start": 50.471,
      "end": 51.973
    },
    {
      "id": "shot03-26",
      "text": "它不太适合拿来拯救已经很稳定、",
      "start": 51.973,
      "end": 54.817
    },
    {
      "id": "shot03-27",
      "text": "但本身能力不足的模型。",
      "start": 54.817,
      "end": 56.54
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "再看 boosting，",
      "start": 0.0,
      "end": 1.021
    },
    {
      "id": "shot04-1",
      "text": "中文常译成提升法或增强法。",
      "start": 1.021,
      "end": 3.744
    },
    {
      "id": "shot04-2",
      "text": "它不是让 5 个模型同时训练，",
      "start": 3.744,
      "end": 6.227
    },
    {
      "id": "shot04-3",
      "text": "而是一个接一个训练。",
      "start": 6.227,
      "end": 7.969
    },
    {
      "id": "shot04-4",
      "text": "第 1 个弱学习器先学全体样本，",
      "start": 7.969,
      "end": 10.572
    },
    {
      "id": "shot04-5",
      "text": "学完以后标出哪些样本错了。",
      "start": 10.572,
      "end": 12.914
    },
    {
      "id": "shot04-6",
      "text": "第 2 个弱学习器训练时，",
      "start": 12.914,
      "end": 14.757
    },
    {
      "id": "shot04-7",
      "text": "就更关注这些错样本。",
      "start": 14.757,
      "end": 16.839
    },
    {
      "id": "shot04-8",
      "text": "第 2 个学完，",
      "start": 16.839,
      "end": 17.82
    },
    {
      "id": "shot04-9",
      "text": "再把它没处理好的地方交给第 3 个。",
      "start": 17.82,
      "end": 20.583
    },
    {
      "id": "shot04-10",
      "text": "这样一棒一棒接下去，",
      "start": 20.583,
      "end": 22.088
    },
    {
      "id": "shot04-11",
      "text": "每一棒都在补前一棒的不足。",
      "start": 22.088,
      "end": 24.295
    },
    {
      "id": "shot04-12",
      "text": "最后预测时也不是平权投票，",
      "start": 24.295,
      "end": 26.462
    },
    {
      "id": "shot04-13",
      "text": "而是加权投票：",
      "start": 26.462,
      "end": 27.725
    },
    {
      "id": "shot04-14",
      "text": "表现好的学习器话语权更大，",
      "start": 27.725,
      "end": 30.073
    },
    {
      "id": "shot04-15",
      "text": "表现差的学习器话语权更小。",
      "start": 30.073,
      "end": 32.119
    },
    {
      "id": "shot04-16",
      "text": "这里有两个权重不要混。",
      "start": 32.611,
      "end": 34.274
    },
    {
      "id": "shot04-17",
      "text": "训练阶段调的是样本权重，",
      "start": 34.274,
      "end": 36.557
    },
    {
      "id": "shot04-18",
      "text": "英文 sample weight，",
      "start": 36.557,
      "end": 37.899
    },
    {
      "id": "shot04-19",
      "text": "也就是哪些样本下一轮更重要；",
      "start": 37.899,
      "end": 40.363
    },
    {
      "id": "shot04-20",
      "text": "最终投票阶段用的是学习器权重，",
      "start": 40.363,
      "end": 43.007
    },
    {
      "id": "shot04-21",
      "text": "英文 learner weight，",
      "start": 43.007,
      "end": 44.409
    },
    {
      "id": "shot04-22",
      "text": "也就是哪个模型最后说话更重。",
      "start": 44.409,
      "end": 47.133
    },
    {
      "id": "shot04-23",
      "text": "AdaBoost 会把这两类权重写成显式",
      "start": 47.133,
      "end": 49.977
    },
    {
      "id": "shot04-24",
      "text": "公式，",
      "start": 49.977,
      "end": 50.578
    },
    {
      "id": "shot04-25",
      "text": "后面会专门推。",
      "start": 50.578,
      "end": 51.42
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "boosting 主要解决的是学不够。",
      "start": 0.0,
      "end": 2.083
    },
    {
      "id": "shot05-1",
      "text": "这里再引入一个术语：偏差，",
      "start": 2.083,
      "end": 4.085
    },
    {
      "id": "shot05-2",
      "text": "英文 bias。",
      "start": 4.085,
      "end": 5.106
    },
    {
      "id": "shot05-3",
      "text": "模型偏差大，",
      "start": 5.106,
      "end": 6.148
    },
    {
      "id": "shot05-4",
      "text": "意思是模型能力不足，",
      "start": 6.148,
      "end": 7.79
    },
    {
      "id": "shot05-5",
      "text": "学不到真实规律。",
      "start": 7.79,
      "end": 9.192
    },
    {
      "id": "shot05-6",
      "text": "比如深度等于 1 的决策桩，",
      "start": 9.192,
      "end": 11.034
    },
    {
      "id": "shot05-7",
      "text": "只能问一个问题，",
      "start": 11.034,
      "end": 12.216
    },
    {
      "id": "shot05-8",
      "text": "单独做分类很容易欠拟合。",
      "start": 12.216,
      "end": 14.544
    },
    {
      "id": "shot05-9",
      "text": "bagging 把 5 棵很浅的树拿来平",
      "start": 14.544,
      "end": 17.362
    },
    {
      "id": "shot05-10",
      "text": "均，",
      "start": 17.362,
      "end": 17.662
    },
    {
      "id": "shot05-11",
      "text": "通常也只是 5 个浅判断互相投票，",
      "start": 17.662,
      "end": 20.486
    },
    {
      "id": "shot05-12",
      "text": "能力上限变化不大。",
      "start": 20.486,
      "end": 22.028
    },
    {
      "id": "shot05-13",
      "text": "boosting 的策略相反：",
      "start": 22.028,
      "end": 23.51
    },
    {
      "id": "shot05-14",
      "text": "我就承认每一棵树很弱，",
      "start": 23.51,
      "end": 25.292
    },
    {
      "id": "shot05-15",
      "text": "但让后一棵专门补前一棵没学好的地方。",
      "start": 25.292,
      "end": 28.096
    },
    {
      "id": "shot05-16",
      "text": "第一棵树抓大方向，",
      "start": 28.528,
      "end": 30.07
    },
    {
      "id": "shot05-17",
      "text": "第二棵树补第一批错题，",
      "start": 30.07,
      "end": 31.811
    },
    {
      "id": "shot05-18",
      "text": "第三棵树再补新的错题，",
      "start": 31.811,
      "end": 33.713
    },
    {
      "id": "shot05-19",
      "text": "整体边界就一步步变复杂。",
      "start": 33.713,
      "end": 35.976
    },
    {
      "id": "shot05-20",
      "text": "用一句话区分：",
      "start": 35.976,
      "end": 37.157
    },
    {
      "id": "shot05-21",
      "text": "bagging 适合一棵树太容易抖，",
      "start": 37.157,
      "end": 38.879
    },
    {
      "id": "shot05-22",
      "text": "boosting 适合一棵树太学不深。",
      "start": 38.879,
      "end": 41.301
    },
    {
      "id": "shot05-23",
      "text": "前者主攻方差，",
      "start": 41.301,
      "end": 42.683
    },
    {
      "id": "shot05-24",
      "text": "后者主攻偏差。",
      "start": 42.683,
      "end": 44.264
    },
    {
      "id": "shot05-25",
      "text": "也正因为 boosting 一直追错题，",
      "start": 44.264,
      "end": 46.567
    },
    {
      "id": "shot05-26",
      "text": "树太多或学习节奏太猛时更容易过拟合，",
      "start": 46.567,
      "end": 50.071
    },
    {
      "id": "shot05-27",
      "text": "所以后面会看到学习率和早停这些控制手段。",
      "start": 50.071,
      "end": 53.314
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "把两条路线放到一张表里。第一，看数据。",
      "start": 0.0,
      "end": 3.466
    },
    {
      "id": "shot06-1",
      "text": "bagging 每个模型看有放回抽样出来",
      "start": 3.466,
      "end": 6.21
    },
    {
      "id": "shot06-2",
      "text": "的不同子集；",
      "start": 6.21,
      "end": 7.332
    },
    {
      "id": "shot06-3",
      "text": "boosting 通常看全量数据，",
      "start": 7.332,
      "end": 9.395
    },
    {
      "id": "shot06-4",
      "text": "但每一轮会调整样本重要性，",
      "start": 9.395,
      "end": 11.839
    },
    {
      "id": "shot06-5",
      "text": "或者像 GBDT 那样拟合残差和负梯度。",
      "start": 11.839,
      "end": 15.225
    },
    {
      "id": "shot06-6",
      "text": "第二，看投票。",
      "start": 15.225,
      "end": 16.667
    },
    {
      "id": "shot06-7",
      "text": "bagging 是平权投票，",
      "start": 16.667,
      "end": 18.37
    },
    {
      "id": "shot06-8",
      "text": "一棵树一票；",
      "start": 18.37,
      "end": 19.372
    },
    {
      "id": "shot06-9",
      "text": "boosting 是加权投票，",
      "start": 19.372,
      "end": 21.315
    },
    {
      "id": "shot06-10",
      "text": "或者把每一轮输出按权重累加。第三，",
      "start": 21.315,
      "end": 24.64
    },
    {
      "id": "shot06-11",
      "text": "看训练顺序。",
      "start": 24.64,
      "end": 25.542
    },
    {
      "id": "shot06-12",
      "text": "bagging 里每个弱学习器相互独立，",
      "start": 26.015,
      "end": 28.219
    },
    {
      "id": "shot06-13",
      "text": "可以并行训练；",
      "start": 28.219,
      "end": 29.281
    },
    {
      "id": "shot06-14",
      "text": "boosting 里后一轮依赖前一轮的错",
      "start": 29.281,
      "end": 31.484
    },
    {
      "id": "shot06-15",
      "text": "误，",
      "start": 31.484,
      "end": 31.705
    },
    {
      "id": "shot06-16",
      "text": "必须串行推进。第四，",
      "start": 31.705,
      "end": 33.408
    },
    {
      "id": "shot06-17",
      "text": "看代表算法。",
      "start": 33.408,
      "end": 34.53
    },
    {
      "id": "shot06-18",
      "text": "bagging 的代表是随机森林",
      "start": 34.53,
      "end": 36.413
    },
    {
      "id": "shot06-19",
      "text": "Random Forest；",
      "start": 36.413,
      "end": 37.575
    },
    {
      "id": "shot06-20",
      "text": "boosting 的代表包括",
      "start": 37.575,
      "end": 38.777
    },
    {
      "id": "shot06-21",
      "text": "AdaBoost、GBDT、",
      "start": 38.777,
      "end": 40.64
    },
    {
      "id": "shot06-22",
      "text": "XGBoost 和 LightGBM。",
      "start": 40.64,
      "end": 42.984
    },
    {
      "id": "shot06-23",
      "text": "选型时可以先用一句话判断：想要稳，",
      "start": 42.984,
      "end": 45.929
    },
    {
      "id": "shot06-24",
      "text": "先看 bagging；",
      "start": 45.929,
      "end": 46.931
    },
    {
      "id": "shot06-25",
      "text": "想要榨精度，",
      "start": 46.931,
      "end": 47.872
    },
    {
      "id": "shot06-26",
      "text": "再看 boosting。",
      "start": 47.872,
      "end": 48.894
    },
    {
      "id": "shot06-27",
      "text": "实际工程里常见做法是先用随机森林拿一个稳",
      "start": 49.122,
      "end": 52.417
    },
    {
      "id": "shot06-28",
      "text": "基线，",
      "start": 52.417,
      "end": 52.939
    },
    {
      "id": "shot06-29",
      "text": "再用 XGBoost 或",
      "start": 52.939,
      "end": 54.345
    },
    {
      "id": "shot06-30",
      "text": "LightGBM 看复杂度换来的精度值不",
      "start": 54.345,
      "end": 57.138
    },
    {
      "id": "shot06-31",
      "text": "值。",
      "start": 57.138,
      "end": 57.158
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这里。",
      "start": 0.0,
      "end": 1.062
    },
    {
      "id": "shot07-1",
      "text": "我们把集成学习的两条主路线拆开了。",
      "start": 1.062,
      "end": 3.986
    },
    {
      "id": "shot07-2",
      "text": "Bagging 的关键动作是",
      "start": 3.986,
      "end": 5.428
    },
    {
      "id": "shot07-3",
      "text": "bootstrap 抽样、并行训练、",
      "start": 5.428,
      "end": 7.611
    },
    {
      "id": "shot07-4",
      "text": "平权投票；",
      "start": 7.611,
      "end": 8.613
    },
    {
      "id": "shot07-5",
      "text": "它让每个模型看不一样的数据，",
      "start": 8.613,
      "end": 11.037
    },
    {
      "id": "shot07-6",
      "text": "主要用来降低方差，",
      "start": 11.037,
      "end": 12.619
    },
    {
      "id": "shot07-7",
      "text": "也就是减少模型对训练数据变化的敏感。",
      "start": 12.619,
      "end": 16.264
    },
    {
      "id": "shot07-8",
      "text": "Boosting 的关键动作是串行训练、",
      "start": 16.264,
      "end": 18.828
    },
    {
      "id": "shot07-9",
      "text": "关注错题、加权组合；",
      "start": 18.828,
      "end": 20.791
    },
    {
      "id": "shot07-10",
      "text": "它让后一轮补前一轮的不足，",
      "start": 20.791,
      "end": 23.195
    },
    {
      "id": "shot07-11",
      "text": "主要用来降低偏差，",
      "start": 23.195,
      "end": 24.837
    },
    {
      "id": "shot07-12",
      "text": "也就是补模型能力不够的问题。",
      "start": 24.837,
      "end": 26.981
    },
    {
      "id": "shot07-13",
      "text": "这一期点到但没展开的有三件事：",
      "start": 27.527,
      "end": 29.809
    },
    {
      "id": "shot07-14",
      "text": "bootstrap 里没被抽到的袋外样本",
      "start": 29.809,
      "end": 32.43
    },
    {
      "id": "shot07-15",
      "text": "怎么用，",
      "start": 32.43,
      "end": 33.011
    },
    {
      "id": "shot07-16",
      "text": "留给随机森林；",
      "start": 33.011,
      "end": 34.172
    },
    {
      "id": "shot07-17",
      "text": "AdaBoost 的样本权重和学习器权重",
      "start": 34.172,
      "end": 36.833
    },
    {
      "id": "shot07-18",
      "text": "公式，",
      "start": 36.833,
      "end": 37.294
    },
    {
      "id": "shot07-19",
      "text": "留给 AdaBoost 章；",
      "start": 37.294,
      "end": 38.975
    },
    {
      "id": "shot07-20",
      "text": "GBDT 和 XGBoost 为什么不总",
      "start": 38.975,
      "end": 41.517
    },
    {
      "id": "shot07-21",
      "text": "是显式调样本权重，",
      "start": 41.517,
      "end": 43.338
    },
    {
      "id": "shot07-22",
      "text": "留给后面的 boosting 系列。",
      "start": 43.338,
      "end": 45.419
    },
    {
      "id": "shot07-23",
      "text": "下一期我们先沿着 bagging 这条线",
      "start": 45.419,
      "end": 47.501
    },
    {
      "id": "shot07-24",
      "text": "走，",
      "start": 47.501,
      "end": 48.021
    },
    {
      "id": "shot07-25",
      "text": "进入随机森林：",
      "start": 48.021,
      "end": 49.202
    },
    {
      "id": "shot07-26",
      "text": "它不只让每棵树看不一样的数据，",
      "start": 49.202,
      "end": 51.804
    },
    {
      "id": "shot07-27",
      "text": "还会让每棵树在分裂时看不一样的特征。",
      "start": 51.804,
      "end": 54.666
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.632
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.632,
      "end": 2.159
    }
  ]
}
