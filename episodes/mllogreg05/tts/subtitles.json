{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们已经会用逻辑回归做预测：",
      "start": 0.0,
      "end": 2.885
    },
    {
      "id": "shot01-1",
      "text": "先算 z，",
      "start": 2.885,
      "end": 3.646
    },
    {
      "id": "shot01-2",
      "text": "再算概率 p，",
      "start": 3.646,
      "end": 4.648
    },
    {
      "id": "shot01-3",
      "text": "再按阈值切类。",
      "start": 4.648,
      "end": 5.91
    },
    {
      "id": "shot01-4",
      "text": "但训练模型时还差一个核心问题：",
      "start": 5.91,
      "end": 8.474
    },
    {
      "id": "shot01-5",
      "text": "同一批数据上，",
      "start": 8.474,
      "end": 9.656
    },
    {
      "id": "shot01-6",
      "text": "怎么知道这组 w 和 b 好不好？",
      "start": 9.656,
      "end": 12.14
    },
    {
      "id": "shot01-7",
      "text": "线性回归用 MSE 衡量预测值和真实值的",
      "start": 12.14,
      "end": 15.746
    },
    {
      "id": "shot01-8",
      "text": "误差，",
      "start": 15.746,
      "end": 16.388
    },
    {
      "id": "shot01-9",
      "text": "逻辑回归不能直接照搬。",
      "start": 16.388,
      "end": 18.611
    },
    {
      "id": "shot01-10",
      "text": "因为它输出的是概率，",
      "start": 18.611,
      "end": 20.214
    },
    {
      "id": "shot01-11",
      "text": "真实标签是 0 或 1，",
      "start": 20.214,
      "end": 21.997
    },
    {
      "id": "shot01-12",
      "text": "我们要惩罚的是：",
      "start": 21.997,
      "end": 23.379
    },
    {
      "id": "shot01-13",
      "text": "模型把正确类别的概率给得够不够高。",
      "start": 23.379,
      "end": 25.964
    },
    {
      "id": "shot01-14",
      "text": "这一期就从上一期的 MLE 和 log",
      "start": 26.429,
      "end": 29.282
    },
    {
      "id": "shot01-15",
      "text": "接上，",
      "start": 29.282,
      "end": 29.804
    },
    {
      "id": "shot01-16",
      "text": "推出逻辑回归的损失函数，",
      "start": 29.804,
      "end": 32.175
    },
    {
      "id": "shot01-17",
      "text": "也叫 log-loss 或二分类交叉熵。",
      "start": 32.175,
      "end": 34.566
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "回到 MLE 的思想：参数越好，",
      "start": 0.0,
      "end": 2.804
    },
    {
      "id": "shot02-1",
      "text": "已经看到的标签应该越可能发生。",
      "start": 2.804,
      "end": 5.187
    },
    {
      "id": "shot02-2",
      "text": "对一个样本，",
      "start": 5.187,
      "end": 6.149
    },
    {
      "id": "shot02-3",
      "text": "如果真实标签 y 等于 1，",
      "start": 6.149,
      "end": 8.272
    },
    {
      "id": "shot02-4",
      "text": "模型给正类概率 p，",
      "start": 8.272,
      "end": 10.054
    },
    {
      "id": "shot02-5",
      "text": "那么这个样本被正确解释的概率就是 p。",
      "start": 10.054,
      "end": 13.059
    },
    {
      "id": "shot02-6",
      "text": "如果 y 等于 0，",
      "start": 13.059,
      "end": 14.2
    },
    {
      "id": "shot02-7",
      "text": "正确解释的概率就是 1 减 p。",
      "start": 14.2,
      "end": 16.864
    },
    {
      "id": "shot02-8",
      "text": "两种情况可以合成一个公式：",
      "start": 16.864,
      "end": 19.227
    },
    {
      "id": "shot02-9",
      "text": "p 的 y 次方，",
      "start": 19.227,
      "end": 20.389
    },
    {
      "id": "shot02-10",
      "text": "乘以 1 减 p 的 1 减 y 次方。",
      "start": 20.389,
      "end": 22.672
    },
    {
      "id": "shot02-11",
      "text": "所有样本连乘，",
      "start": 22.672,
      "end": 23.934
    },
    {
      "id": "shot02-12",
      "text": "就是整批数据的似然。",
      "start": 23.934,
      "end": 25.677
    },
    {
      "id": "shot02-13",
      "text": "训练要让它越大越好。",
      "start": 25.677,
      "end": 27.159
    },
    {
      "id": "shot02-14",
      "text": "为了计算方便，",
      "start": 27.65,
      "end": 28.691
    },
    {
      "id": "shot02-15",
      "text": "先取 log，",
      "start": 28.691,
      "end": 29.592
    },
    {
      "id": "shot02-16",
      "text": "把连乘变连加；",
      "start": 29.592,
      "end": 30.994
    },
    {
      "id": "shot02-17",
      "text": "为了写成优化里常见的最小化目标，",
      "start": 30.994,
      "end": 33.898
    },
    {
      "id": "shot02-18",
      "text": "再加负号。",
      "start": 33.898,
      "end": 34.799
    },
    {
      "id": "shot02-19",
      "text": "于是单样本损失等于负的括号：",
      "start": 34.799,
      "end": 37.422
    },
    {
      "id": "shot02-20",
      "text": "y log p，",
      "start": 37.422,
      "end": 38.404
    },
    {
      "id": "shot02-21",
      "text": "加上 1 减 y 乘 log 1 减 p。",
      "start": 38.404,
      "end": 40.967
    },
    {
      "id": "shot02-22",
      "text": "等价地说，",
      "start": 40.967,
      "end": 41.688
    },
    {
      "id": "shot02-23",
      "text": "就是负 y log p，",
      "start": 41.688,
      "end": 43.17
    },
    {
      "id": "shot02-24",
      "text": "再减去 1 减 y 乘 log 1 减",
      "start": 43.17,
      "end": 45.352
    },
    {
      "id": "shot02-25",
      "text": "p。",
      "start": 45.352,
      "end": 46.013
    },
    {
      "id": "shot02-26",
      "text": "它的名字很多：",
      "start": 46.013,
      "end": 47.295
    },
    {
      "id": "shot02-27",
      "text": "负对数似然、",
      "start": 47.295,
      "end": 48.456
    },
    {
      "id": "shot02-28",
      "text": "log-loss、",
      "start": 48.456,
      "end": 49.337
    },
    {
      "id": "shot02-29",
      "text": "二分类交叉熵，",
      "start": 49.337,
      "end": 50.739
    },
    {
      "id": "shot02-30",
      "text": "说的是同一条主线。",
      "start": 50.739,
      "end": 51.981
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "先别急着记公式，",
      "start": 0.0,
      "end": 1.402
    },
    {
      "id": "shot03-1",
      "text": "抓住单样本惩罚就够了。",
      "start": 1.402,
      "end": 3.425
    },
    {
      "id": "shot03-2",
      "text": "如果真实标签是 1，",
      "start": 3.425,
      "end": 4.967
    },
    {
      "id": "shot03-3",
      "text": "模型应该把 p 给高。",
      "start": 4.967,
      "end": 6.77
    },
    {
      "id": "shot03-4",
      "text": "p 等于 0.9，",
      "start": 6.77,
      "end": 8.012
    },
    {
      "id": "shot03-5",
      "text": "损失是负 log 0.9，",
      "start": 8.012,
      "end": 9.594
    },
    {
      "id": "shot03-6",
      "text": "大约 0.105，很小；",
      "start": 9.594,
      "end": 11.557
    },
    {
      "id": "shot03-7",
      "text": "p 等于 0.5，",
      "start": 11.557,
      "end": 12.699
    },
    {
      "id": "shot03-8",
      "text": "损失大约 0.693；",
      "start": 12.699,
      "end": 14.602
    },
    {
      "id": "shot03-9",
      "text": "p 等于 0.1，",
      "start": 14.602,
      "end": 15.804
    },
    {
      "id": "shot03-10",
      "text": "损失大约 2.303，",
      "start": 15.804,
      "end": 17.666
    },
    {
      "id": "shot03-11",
      "text": "惩罚暴涨。也就是说，",
      "start": 17.666,
      "end": 19.629
    },
    {
      "id": "shot03-12",
      "text": "模型越自信地错，损失越大。",
      "start": 19.629,
      "end": 22.213
    },
    {
      "id": "shot03-13",
      "text": "如果真实标签是 0，",
      "start": 22.213,
      "end": 23.755
    },
    {
      "id": "shot03-14",
      "text": "就看 1 减 p，同理。",
      "start": 23.755,
      "end": 25.198
    },
    {
      "id": "shot03-15",
      "text": "这个性质非常适合分类：",
      "start": 25.715,
      "end": 27.579
    },
    {
      "id": "shot03-16",
      "text": "我们不只关心最终切出来对不对，",
      "start": 27.579,
      "end": 30.325
    },
    {
      "id": "shot03-17",
      "text": "还关心模型有没有把正确类别的概率给高。",
      "start": 30.325,
      "end": 33.972
    },
    {
      "id": "shot03-18",
      "text": "一个正例被模型给 0.51 和给 0.",
      "start": 33.972,
      "end": 36.959
    },
    {
      "id": "shot03-19",
      "text": "99，",
      "start": 36.959,
      "end": 37.62
    },
    {
      "id": "shot03-20",
      "text": "虽然阈值下都判正，",
      "start": 37.62,
      "end": 39.283
    },
    {
      "id": "shot03-21",
      "text": "但损失会明显不同。",
      "start": 39.283,
      "end": 40.666
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开损失景观 demo。",
      "start": 0.0,
      "end": 1.843
    },
    {
      "id": "shot04-1",
      "text": "先看 MSE 加 sigmoid 的景观。",
      "start": 1.843,
      "end": 4.406
    },
    {
      "id": "shot04-2",
      "text": "横轴是一维权重 w，",
      "start": 4.406,
      "end": 6.349
    },
    {
      "id": "shot04-3",
      "text": "纵轴是损失 J(w)。",
      "start": 6.349,
      "end": 8.111
    },
    {
      "id": "shot04-4",
      "text": "曲线可能出现多个低谷，",
      "start": 8.111,
      "end": 10.134
    },
    {
      "id": "shot04-5",
      "text": "意思是梯度下降可能卡在局部位置。",
      "start": 10.134,
      "end": 12.918
    },
    {
      "id": "shot04-6",
      "text": "再切到 log-loss 景观，",
      "start": 12.918,
      "end": 14.661
    },
    {
      "id": "shot04-7",
      "text": "曲线更像一个干净的碗。",
      "start": 14.661,
      "end": 16.884
    },
    {
      "id": "shot04-8",
      "text": "更严谨地说，",
      "start": 16.884,
      "end": 17.905
    },
    {
      "id": "shot04-9",
      "text": "log-loss 对逻辑回归参数是凸的，",
      "start": 17.905,
      "end": 20.549
    },
    {
      "id": "shot04-10",
      "text": "通常不会像 MSE 加 sigmoid",
      "start": 20.549,
      "end": 22.892
    },
    {
      "id": "shot04-11",
      "text": "那样出现坏的局部低谷；",
      "start": 22.892,
      "end": 24.875
    },
    {
      "id": "shot04-12",
      "text": "在非完全可分或带正则时，",
      "start": 24.875,
      "end": 27.259
    },
    {
      "id": "shot04-13",
      "text": "会有稳定的全局最优。",
      "start": 27.259,
      "end": 28.681
    },
    {
      "id": "shot04-14",
      "text": "这就是为什么逻辑回归主损失不用 MSE，",
      "start": 29.148,
      "end": 32.735
    },
    {
      "id": "shot04-15",
      "text": "而是用 log-loss：",
      "start": 32.735,
      "end": 34.117
    },
    {
      "id": "shot04-16",
      "text": "它和 sigmoid 配在一起，",
      "start": 34.117,
      "end": 35.94
    },
    {
      "id": "shot04-17",
      "text": "优化形状更友好。",
      "start": 35.94,
      "end": 37.644
    },
    {
      "id": "shot04-18",
      "text": "这里不用展开严格证明，",
      "start": 37.644,
      "end": 39.627
    },
    {
      "id": "shot04-19",
      "text": "只要看懂视觉差异：",
      "start": 39.627,
      "end": 41.571
    },
    {
      "id": "shot04-20",
      "text": "分类不是不能算平方误差，",
      "start": 41.571,
      "end": 44.015
    },
    {
      "id": "shot04-21",
      "text": "而是平方误差配 sigmoid 的训练地",
      "start": 44.015,
      "end": 46.62
    },
    {
      "id": "shot04-22",
      "text": "形不如 log-loss 稳。",
      "start": 46.62,
      "end": 48.063
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "再切到单样本惩罚曲线。",
      "start": 0.0,
      "end": 2.283
    },
    {
      "id": "shot05-1",
      "text": "选择 y 等于 1 时，",
      "start": 2.283,
      "end": 3.945
    },
    {
      "id": "shot05-2",
      "text": "横轴是模型给正类的概率 p，",
      "start": 3.945,
      "end": 6.448
    },
    {
      "id": "shot05-3",
      "text": "纵轴是损失。",
      "start": 6.448,
      "end": 7.63
    },
    {
      "id": "shot05-4",
      "text": "红点在 p 等于 0.9 时很低，",
      "start": 7.63,
      "end": 10.213
    },
    {
      "id": "shot05-5",
      "text": "说明模型把正例判得很准；",
      "start": 10.213,
      "end": 12.356
    },
    {
      "id": "shot05-6",
      "text": "把 p 拖到 0.5，",
      "start": 12.356,
      "end": 13.818
    },
    {
      "id": "shot05-7",
      "text": "损失明显升高；",
      "start": 13.818,
      "end": 15.5
    },
    {
      "id": "shot05-8",
      "text": "继续拖到 0.1，",
      "start": 15.5,
      "end": 16.982
    },
    {
      "id": "shot05-9",
      "text": "曲线急剧上冲，",
      "start": 16.982,
      "end": 18.324
    },
    {
      "id": "shot05-10",
      "text": "表示模型把真实正例几乎当成负例，",
      "start": 18.324,
      "end": 21.328
    },
    {
      "id": "shot05-11",
      "text": "惩罚非常重。",
      "start": 21.328,
      "end": 22.509
    },
    {
      "id": "shot05-12",
      "text": "切到 y 等于 0 时，",
      "start": 22.509,
      "end": 24.011
    },
    {
      "id": "shot05-13",
      "text": "曲线左右反过来，",
      "start": 24.011,
      "end": 25.353
    },
    {
      "id": "shot05-14",
      "text": "因为这次正确概率是 1 减 p。",
      "start": 25.353,
      "end": 27.396
    },
    {
      "id": "shot05-15",
      "text": "这个图把 log-loss 的性格说清楚",
      "start": 27.983,
      "end": 30.41
    },
    {
      "id": "shot05-16",
      "text": "了：",
      "start": 30.41,
      "end": 30.851
    },
    {
      "id": "shot05-17",
      "text": "它奖励正确类别的高概率，",
      "start": 30.851,
      "end": 33.299
    },
    {
      "id": "shot05-18",
      "text": "也严惩自信的错误概率。",
      "start": 33.299,
      "end": 35.104
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.342
    },
    {
      "id": "shot06-1",
      "text": "我们解决了逻辑回归训练目标的来源：第一，",
      "start": 1.342,
      "end": 4.909
    },
    {
      "id": "shot06-2",
      "text": "从 MLE 出发，",
      "start": 4.909,
      "end": 6.572
    },
    {
      "id": "shot06-3",
      "text": "好参数应该让已观测标签整体最可能；",
      "start": 6.572,
      "end": 10.158
    },
    {
      "id": "shot06-4",
      "text": "第二，",
      "start": 10.158,
      "end": 10.799
    },
    {
      "id": "shot06-5",
      "text": "取 log 把连乘变连加，",
      "start": 10.799,
      "end": 13.083
    },
    {
      "id": "shot06-6",
      "text": "加负号把最大化变成最小化；第三，",
      "start": 13.083,
      "end": 16.61
    },
    {
      "id": "shot06-7",
      "text": "得到的 log-loss 会惩罚正确类别",
      "start": 16.61,
      "end": 19.355
    },
    {
      "id": "shot06-8",
      "text": "概率太低的样本，",
      "start": 19.355,
      "end": 20.958
    },
    {
      "id": "shot06-9",
      "text": "尤其严惩自信犯错。",
      "start": 20.958,
      "end": 23.081
    },
    {
      "id": "shot06-10",
      "text": "点到没展开的梯度公式先放下，",
      "start": 23.081,
      "end": 25.746
    },
    {
      "id": "shot06-11",
      "text": "第一轮只要知道这个损失为什么合理。",
      "start": 25.746,
      "end": 28.17
    },
    {
      "id": "shot06-12",
      "text": "下一期进入 sklearn：",
      "start": 28.655,
      "end": 30.262
    },
    {
      "id": "shot06-13",
      "text": "用 LogisticRegression",
      "start": 30.262,
      "end": 31.789
    },
    {
      "id": "shot06-14",
      "text": "跑一个癌症分类案例，",
      "start": 31.789,
      "end": 33.818
    },
    {
      "id": "shot06-15",
      "text": "看 API、标准化、",
      "start": 33.818,
      "end": 35.686
    },
    {
      "id": "shot06-16",
      "text": "训练和评估怎么连起来。",
      "start": 35.686,
      "end": 37.233
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.813
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.813,
      "end": 2.317
    }
  ]
}
