{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "我们开始朴素贝叶斯，",
      "start": 0.0,
      "end": 1.804
    },
    {
      "id": "shot01-1",
      "text": "Naive Bayes。",
      "start": 1.804,
      "end": 2.846
    },
    {
      "id": "shot01-2",
      "text": "它听起来像一个很数学的算法，",
      "start": 2.846,
      "end": 5.151
    },
    {
      "id": "shot01-3",
      "text": "但第一步其实很朴素：",
      "start": 5.151,
      "end": 6.874
    },
    {
      "id": "shot01-4",
      "text": "别先凭印象判断，",
      "start": 6.874,
      "end": 8.397
    },
    {
      "id": "shot01-5",
      "text": "先把历史样本摆出来数一数。",
      "start": 8.397,
      "end": 10.722
    },
    {
      "id": "shot01-6",
      "text": "比如早晨看到阴天、风大，",
      "start": 10.722,
      "end": 12.766
    },
    {
      "id": "shot01-7",
      "text": "午后到底会不会下雨？",
      "start": 12.766,
      "end": 14.53
    },
    {
      "id": "shot01-8",
      "text": "直觉派可能会说，",
      "start": 14.53,
      "end": 15.853
    },
    {
      "id": "shot01-9",
      "text": "大概率会下。",
      "start": 15.853,
      "end": 17.175
    },
    {
      "id": "shot01-10",
      "text": "数据派会说，",
      "start": 17.175,
      "end": 18.278
    },
    {
      "id": "shot01-11",
      "text": "先看 7 行历史天气样本。",
      "start": 18.278,
      "end": 20.556
    },
    {
      "id": "shot01-12",
      "text": "朴素贝叶斯走的就是数据派路线，",
      "start": 20.556,
      "end": 22.827
    },
    {
      "id": "shot01-13",
      "text": "用概率把这件事说清楚。",
      "start": 22.827,
      "end": 24.57
    },
    {
      "id": "shot01-14",
      "text": "这一期我们先搭两块地基：第一，条件概率、",
      "start": 25.091,
      "end": 28.18
    },
    {
      "id": "shot01-15",
      "text": "联合概率和独立性到底怎么数；第二，",
      "start": 28.18,
      "end": 30.928
    },
    {
      "id": "shot01-16",
      "text": "贝叶斯公式怎么把能数的方向，",
      "start": 30.928,
      "end": 33.375
    },
    {
      "id": "shot01-17",
      "text": "翻成真正想预测的方向。",
      "start": 33.375,
      "end": 35.059
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看条件概率，",
      "start": 0.0,
      "end": 1.381
    },
    {
      "id": "shot02-1",
      "text": "conditional",
      "start": 1.381,
      "end": 2.201
    },
    {
      "id": "shot02-2",
      "text": "probability。",
      "start": 2.201,
      "end": 3.102
    },
    {
      "id": "shot02-3",
      "text": "它的核心动作不是套公式，",
      "start": 3.102,
      "end": 5.323
    },
    {
      "id": "shot02-4",
      "text": "而是先缩小范围，",
      "start": 5.323,
      "end": 6.764
    },
    {
      "id": "shot02-5",
      "text": "再数比例。",
      "start": 6.764,
      "end": 7.905
    },
    {
      "id": "shot02-6",
      "text": "生活里也是这样。",
      "start": 7.905,
      "end": 9.206
    },
    {
      "id": "shot02-7",
      "text": "只问一座城市下雨概率多少，",
      "start": 9.206,
      "end": 11.567
    },
    {
      "id": "shot02-8",
      "text": "分母是所有日子；",
      "start": 11.567,
      "end": 13.008
    },
    {
      "id": "shot02-9",
      "text": "如果加上台风外围影响这个条件，",
      "start": 13.008,
      "end": 15.87
    },
    {
      "id": "shot02-10",
      "text": "分母就变成类似天气的日子。",
      "start": 15.87,
      "end": 18.572
    },
    {
      "id": "shot02-11",
      "text": "回到天气表，",
      "start": 18.572,
      "end": 19.652
    },
    {
      "id": "shot02-12",
      "text": "问午后下雨的样本日里，",
      "start": 19.652,
      "end": 21.734
    },
    {
      "id": "shot02-13",
      "text": "早晨是阴天的概率是多少。",
      "start": 21.734,
      "end": 23.955
    },
    {
      "id": "shot02-14",
      "text": "我们先把 7 行样本切到午后下雨这一片，",
      "start": 23.955,
      "end": 27.299
    },
    {
      "id": "shot02-15",
      "text": "只剩 2、3、4、7 号，",
      "start": 27.299,
      "end": 29.161
    },
    {
      "id": "shot02-16",
      "text": "一共 4 个样本。",
      "start": 29.161,
      "end": 30.142
    },
    {
      "id": "shot02-17",
      "text": "再在这 4 个样本里数阴天，有 3、",
      "start": 30.689,
      "end": 33.591
    },
    {
      "id": "shot02-18",
      "text": "4 号，",
      "start": 33.591,
      "end": 34.035
    },
    {
      "id": "shot02-19",
      "text": "一共 2 个。",
      "start": 34.035,
      "end": 35.137
    },
    {
      "id": "shot02-20",
      "text": "所以 P(阴天|下雨) 等于 2 除以",
      "start": 35.137,
      "end": 37.722
    },
    {
      "id": "shot02-21",
      "text": "4，",
      "start": 37.722,
      "end": 37.942
    },
    {
      "id": "shot02-22",
      "text": "也就是 0.5。",
      "start": 37.942,
      "end": 39.305
    },
    {
      "id": "shot02-23",
      "text": "注意这里最关键的是分母变了。",
      "start": 39.305,
      "end": 41.569
    },
    {
      "id": "shot02-24",
      "text": "无条件时分母是 7，",
      "start": 41.569,
      "end": 43.252
    },
    {
      "id": "shot02-25",
      "text": "加了下雨这个条件，",
      "start": 43.252,
      "end": 44.814
    },
    {
      "id": "shot02-26",
      "text": "分母就变成 4。",
      "start": 44.814,
      "end": 46.137
    },
    {
      "id": "shot02-27",
      "text": "条件概率就是在新的样本空间里重新数比例。",
      "start": 46.137,
      "end": 49.282
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "再看联合概率，",
      "start": 0.0,
      "end": 1.142
    },
    {
      "id": "shot03-1",
      "text": "joint probability。",
      "start": 1.142,
      "end": 2.644
    },
    {
      "id": "shot03-2",
      "text": "联合概率问的是两件事同时发生的概率。",
      "start": 2.644,
      "end": 5.889
    },
    {
      "id": "shot03-3",
      "text": "比如早晨是阴天，并且风大。",
      "start": 5.889,
      "end": 8.372
    },
    {
      "id": "shot03-4",
      "text": "它可以两步算：",
      "start": 8.372,
      "end": 9.554
    },
    {
      "id": "shot03-5",
      "text": "先问阴天占多少，",
      "start": 9.554,
      "end": 11.016
    },
    {
      "id": "shot03-6",
      "text": "再问阴天里面风大占多少。",
      "start": 11.016,
      "end": 13.62
    },
    {
      "id": "shot03-7",
      "text": "7 个样本里阴天有 1、3、4 号，",
      "start": 13.62,
      "end": 16.244
    },
    {
      "id": "shot03-8",
      "text": "所以 P(阴天) 是 3/7。",
      "start": 16.244,
      "end": 18.827
    },
    {
      "id": "shot03-9",
      "text": "阴天这 3 天里，",
      "start": 18.827,
      "end": 20.049
    },
    {
      "id": "shot03-10",
      "text": "风大的是 1、4 号，",
      "start": 20.049,
      "end": 21.571
    },
    {
      "id": "shot03-11",
      "text": "所以 P(风大|阴天) 是 2/3。",
      "start": 21.571,
      "end": 24.516
    },
    {
      "id": "shot03-12",
      "text": "两步乘起来，",
      "start": 24.516,
      "end": 25.577
    },
    {
      "id": "shot03-13",
      "text": "得到 2/7。",
      "start": 25.577,
      "end": 27.28
    },
    {
      "id": "shot03-14",
      "text": "反过来也一样。",
      "start": 27.28,
      "end": 28.001
    },
    {
      "id": "shot03-15",
      "text": "先问风大占多少，",
      "start": 28.39,
      "end": 30.012
    },
    {
      "id": "shot03-16",
      "text": "是 3/7；",
      "start": 30.012,
      "end": 31.013
    },
    {
      "id": "shot03-17",
      "text": "再问风大的日子里阴天占多少，",
      "start": 31.013,
      "end": 33.376
    },
    {
      "id": "shot03-18",
      "text": "是 2/3；",
      "start": 33.376,
      "end": 34.357
    },
    {
      "id": "shot03-19",
      "text": "乘起来还是 2/7。",
      "start": 34.357,
      "end": 36.139
    },
    {
      "id": "shot03-20",
      "text": "这就是联合概率的对称性。",
      "start": 36.139,
      "end": 38.122
    },
    {
      "id": "shot03-21",
      "text": "这里顺手检查一下独立性，",
      "start": 38.122,
      "end": 40.324
    },
    {
      "id": "shot03-22",
      "text": "independence。",
      "start": 40.324,
      "end": 41.466
    },
    {
      "id": "shot03-23",
      "text": "如果知道早晨是阴天以后，",
      "start": 41.466,
      "end": 43.548
    },
    {
      "id": "shot03-24",
      "text": "风大概率没有变化，",
      "start": 43.548,
      "end": 45.31
    },
    {
      "id": "shot03-25",
      "text": "才叫独立。",
      "start": 45.31,
      "end": 46.552
    },
    {
      "id": "shot03-26",
      "text": "可全体样本里风大是 3/7，",
      "start": 46.552,
      "end": 49.255
    },
    {
      "id": "shot03-27",
      "text": "约 0.43；",
      "start": 49.255,
      "end": 50.537
    },
    {
      "id": "shot03-28",
      "text": "阴天里面风大是 2/3，",
      "start": 50.537,
      "end": 52.539
    },
    {
      "id": "shot03-29",
      "text": "约 0.67。",
      "start": 52.539,
      "end": 53.761
    },
    {
      "id": "shot03-30",
      "text": "两个数不一样，",
      "start": 53.761,
      "end": 55.002
    },
    {
      "id": "shot03-31",
      "text": "说明云量和风力在这张小表里并不独立。",
      "start": 55.002,
      "end": 58.126
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "现在问题来了。",
      "start": 0.0,
      "end": 1.261
    },
    {
      "id": "shot04-1",
      "text": "训练数据最容易数的是哪种方向？",
      "start": 1.261,
      "end": 3.804
    },
    {
      "id": "shot04-2",
      "text": "是已知类别，再数特征。",
      "start": 3.804,
      "end": 5.826
    },
    {
      "id": "shot04-3",
      "text": "比如午后下雨的日子里，",
      "start": 5.826,
      "end": 7.588
    },
    {
      "id": "shot04-4",
      "text": "有多少天早晨阴天又风大。",
      "start": 7.588,
      "end": 9.77
    },
    {
      "id": "shot04-5",
      "text": "可是预测时我们手里拿到的是反方向：",
      "start": 9.77,
      "end": 12.714
    },
    {
      "id": "shot04-6",
      "text": "已知今天早晨阴天、风大，",
      "start": 12.714,
      "end": 15.016
    },
    {
      "id": "shot04-7",
      "text": "想问午后下雨的概率。",
      "start": 15.016,
      "end": 17.178
    },
    {
      "id": "shot04-8",
      "text": "贝叶斯公式，",
      "start": 17.178,
      "end": 18.279
    },
    {
      "id": "shot04-9",
      "text": "Bayes theorem，",
      "start": 18.279,
      "end": 19.441
    },
    {
      "id": "shot04-10",
      "text": "解决的就是这个方向翻转。",
      "start": 19.441,
      "end": 21.363
    },
    {
      "id": "shot04-11",
      "text": "它来自刚才的联合概率。",
      "start": 21.363,
      "end": 23.205
    },
    {
      "id": "shot04-12",
      "text": "P(CW) 既可以写成 P(W) 乘 P",
      "start": 23.205,
      "end": 26.028
    },
    {
      "id": "shot04-13",
      "text": "(C|W)，",
      "start": 26.028,
      "end": 26.748
    },
    {
      "id": "shot04-14",
      "text": "也可以写成 P(C) 乘 P(W|C)。",
      "start": 26.748,
      "end": 28.37
    },
    {
      "id": "shot04-15",
      "text": "两边表示的是同一件事：",
      "start": 29.418,
      "end": 31.36
    },
    {
      "id": "shot04-16",
      "text": "C 和 W 同时发生。",
      "start": 31.36,
      "end": 33.323
    },
    {
      "id": "shot04-17",
      "text": "把它们放在一起，",
      "start": 33.323,
      "end": 34.695
    },
    {
      "id": "shot04-18",
      "text": "再两边除以 P(W)，",
      "start": 34.695,
      "end": 36.467
    },
    {
      "id": "shot04-19",
      "text": "就得到 P(C|W) 等于 P(W|C)",
      "start": 36.467,
      "end": 39.511
    },
    {
      "id": "shot04-20",
      "text": "乘 P(C)，",
      "start": 39.511,
      "end": 40.432
    },
    {
      "id": "shot04-21",
      "text": "再除以 P(W)。",
      "start": 40.432,
      "end": 42.034
    },
    {
      "id": "shot04-22",
      "text": "C 是类别，",
      "start": 42.034,
      "end": 43.295
    },
    {
      "id": "shot04-23",
      "text": "W 是观察到的特征。",
      "start": 43.295,
      "end": 45.558
    },
    {
      "id": "shot04-24",
      "text": "P(C) 叫先验 prior，",
      "start": 45.558,
      "end": 47.381
    },
    {
      "id": "shot04-25",
      "text": "P(W|C) 叫似然",
      "start": 47.381,
      "end": 48.802
    },
    {
      "id": "shot04-26",
      "text": "likelihood，",
      "start": 48.802,
      "end": 49.804
    },
    {
      "id": "shot04-27",
      "text": "P(W) 叫证据 evidence，",
      "start": 49.804,
      "end": 52.507
    },
    {
      "id": "shot04-28",
      "text": "P(C|W) 叫后验 posterior。",
      "start": 52.507,
      "end": 54.089
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "把公式套回天气案例。",
      "start": 0.0,
      "end": 1.742
    },
    {
      "id": "shot05-1",
      "text": "我们要算 P(下雨|阴天，风大)。",
      "start": 1.742,
      "end": 4.305
    },
    {
      "id": "shot05-2",
      "text": "先验 P(下雨) 很容易数，",
      "start": 4.305,
      "end": 6.461
    },
    {
      "id": "shot05-3",
      "text": "7 个样本里有 4 个下雨，",
      "start": 6.461,
      "end": 8.21
    },
    {
      "id": "shot05-4",
      "text": "所以是 4/7。",
      "start": 8.21,
      "end": 9.725
    },
    {
      "id": "shot05-5",
      "text": "似然 P(阴天，",
      "start": 9.725,
      "end": 11.033
    },
    {
      "id": "shot05-6",
      "text": "风大|下雨)，",
      "start": 11.033,
      "end": 12.034
    },
    {
      "id": "shot05-7",
      "text": "要先切到下雨的 4 天，",
      "start": 12.034,
      "end": 14.157
    },
    {
      "id": "shot05-8",
      "text": "再数里面既是阴天又风大的，",
      "start": 14.157,
      "end": 16.66
    },
    {
      "id": "shot05-9",
      "text": "有 4 号这 1 天，",
      "start": 16.66,
      "end": 17.961
    },
    {
      "id": "shot05-10",
      "text": "所以是 1/4。",
      "start": 17.961,
      "end": 19.426
    },
    {
      "id": "shot05-11",
      "text": "证据 P(阴天，风大)，",
      "start": 19.426,
      "end": 21.368
    },
    {
      "id": "shot05-12",
      "text": "看全体 7 天，",
      "start": 21.368,
      "end": 22.732
    },
    {
      "id": "shot05-13",
      "text": "符合的有 1 号和 4 号，",
      "start": 22.732,
      "end": 24.517
    },
    {
      "id": "shot05-14",
      "text": "所以是 2/7。",
      "start": 24.517,
      "end": 25.841
    },
    {
      "id": "shot05-15",
      "text": "代入贝叶斯公式，",
      "start": 25.841,
      "end": 27.345
    },
    {
      "id": "shot05-16",
      "text": "分子是 1/4 乘 4/7，",
      "start": 27.345,
      "end": 29.812
    },
    {
      "id": "shot05-17",
      "text": "等于 1/7。",
      "start": 29.812,
      "end": 30.654
    },
    {
      "id": "shot05-18",
      "text": "再除以 2/7，",
      "start": 31.122,
      "end": 31.122
    },
    {
      "id": "shot05-19",
      "text": "结果是 1/2，",
      "start": 31.122,
      "end": 31.122
    },
    {
      "id": "shot05-20",
      "text": "也就是 0.5。",
      "start": 31.122,
      "end": 31.122
    },
    {
      "id": "shot05-21",
      "text": "所以早晨看到阴天、风大，",
      "start": 31.122,
      "end": 33.167
    },
    {
      "id": "shot05-22",
      "text": "在这张小表里午后下雨的后验概率是 50%。",
      "start": 33.167,
      "end": 36.997
    },
    {
      "id": "shot05-23",
      "text": "这不是拍脑袋，",
      "start": 36.997,
      "end": 38.14
    },
    {
      "id": "shot05-24",
      "text": "而是从 7 行样本一步一步数出来的。",
      "start": 38.14,
      "end": 40.627
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "还有一个分类时很重要的小技巧。",
      "start": 0.0,
      "end": 2.542
    },
    {
      "id": "shot06-1",
      "text": "完整后验要除以证据 P(W)，",
      "start": 2.542,
      "end": 4.984
    },
    {
      "id": "shot06-2",
      "text": "但如果我们只是想比较下雨和未下雨哪个更大，",
      "start": 4.984,
      "end": 8.947
    },
    {
      "id": "shot06-3",
      "text": "P(W) 对两个类别是同一个分母。",
      "start": 8.947,
      "end": 11.769
    },
    {
      "id": "shot06-4",
      "text": "比较 3/10 和 7/10 谁大，",
      "start": 11.769,
      "end": 13.99
    },
    {
      "id": "shot06-5",
      "text": "不需要反复看 10，",
      "start": 13.99,
      "end": 15.411
    },
    {
      "id": "shot06-6",
      "text": "只看 3 和 7 就够了。",
      "start": 15.411,
      "end": 17.613
    },
    {
      "id": "shot06-7",
      "text": "所以做分类时，",
      "start": 17.613,
      "end": 18.862
    },
    {
      "id": "shot06-8",
      "text": "朴素贝叶斯常常不先算完整后验，",
      "start": 18.862,
      "end": 21.661
    },
    {
      "id": "shot06-9",
      "text": "而是比较每个类别的分子：",
      "start": 21.661,
      "end": 23.995
    },
    {
      "id": "shot06-10",
      "text": "似然乘先验。",
      "start": 23.995,
      "end": 25.268
    },
    {
      "id": "shot06-11",
      "text": "谁的分子大，",
      "start": 25.268,
      "end": 26.29
    },
    {
      "id": "shot06-12",
      "text": "就把样本分到谁。",
      "start": 26.29,
      "end": 27.953
    },
    {
      "id": "shot06-13",
      "text": "数学上这叫 argmax，",
      "start": 27.953,
      "end": 29.756
    },
    {
      "id": "shot06-14",
      "text": "意思是让得分最大的那个类别。",
      "start": 29.756,
      "end": 31.8
    },
    {
      "id": "shot06-15",
      "text": "注意，",
      "start": 32.396,
      "end": 32.939
    },
    {
      "id": "shot06-16",
      "text": "这不是说 P(W) 不存在，",
      "start": 32.939,
      "end": 34.972
    },
    {
      "id": "shot06-17",
      "text": "而是说在比较类别大小时，",
      "start": 34.972,
      "end": 36.965
    },
    {
      "id": "shot06-18",
      "text": "它不会改变排序，可以省掉。",
      "start": 36.965,
      "end": 39.078
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期我们先把概率语言搭起来。",
      "start": 0.0,
      "end": 2.401
    },
    {
      "id": "shot07-1",
      "text": "条件概率的关键是改变分母，先切片，",
      "start": 2.401,
      "end": 5.702
    },
    {
      "id": "shot07-2",
      "text": "再数比例。",
      "start": 5.702,
      "end": 6.803
    },
    {
      "id": "shot07-3",
      "text": "联合概率描述同时发生，",
      "start": 6.803,
      "end": 8.864
    },
    {
      "id": "shot07-4",
      "text": "可以拆成两步相乘。",
      "start": 8.864,
      "end": 10.584
    },
    {
      "id": "shot07-5",
      "text": "独立性说的是，",
      "start": 10.584,
      "end": 11.725
    },
    {
      "id": "shot07-6",
      "text": "知道一件事以后，",
      "start": 11.725,
      "end": 12.945
    },
    {
      "id": "shot07-7",
      "text": "另一件事的概率不变。最后，",
      "start": 12.945,
      "end": 15.326
    },
    {
      "id": "shot07-8",
      "text": "贝叶斯公式把方向翻过来：",
      "start": 15.326,
      "end": 17.647
    },
    {
      "id": "shot07-9",
      "text": "从容易统计的 P(W|C)，",
      "start": 17.647,
      "end": 19.828
    },
    {
      "id": "shot07-10",
      "text": "反推真正想要的 P(C|W)。",
      "start": 19.828,
      "end": 22.289
    },
    {
      "id": "shot07-11",
      "text": "不过这里还留下一个问题。",
      "start": 22.289,
      "end": 24.09
    },
    {
      "id": "shot07-12",
      "text": "我们这次只有云量和风力两个特征，",
      "start": 24.09,
      "end": 26.901
    },
    {
      "id": "shot07-13",
      "text": "所以还能直接数联合概率。",
      "start": 26.901,
      "end": 29.329
    },
    {
      "id": "shot07-14",
      "text": "等特征变成 10 个、",
      "start": 29.329,
      "end": 30.654
    },
    {
      "id": "shot07-15",
      "text": "100 个，",
      "start": 30.654,
      "end": 31.879
    },
    {
      "id": "shot07-16",
      "text": "直接数每一种组合就会越来越困难。",
      "start": 31.879,
      "end": 34.328
    },
    {
      "id": "shot07-17",
      "text": "下一期我们看朴素贝叶斯名字里的“朴素”到",
      "start": 34.617,
      "end": 37.779
    },
    {
      "id": "shot07-18",
      "text": "底朴素在哪里，",
      "start": 37.779,
      "end": 38.907
    },
    {
      "id": "shot07-19",
      "text": "以及它怎么处理没见过的特征。",
      "start": 38.907,
      "end": 40.781
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.724
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.724,
      "end": 2.212
    }
  ]
}
