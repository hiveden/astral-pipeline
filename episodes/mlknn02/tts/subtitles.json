{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们解决了 KNN 的第一个核心问题：",
      "start": 0.0,
      "end": 3.14
    },
    {
      "id": "shot01-1",
      "text": "怎么算距离。",
      "start": 3.14,
      "end": 4.3
    },
    {
      "id": "shot01-2",
      "text": "这一期解决第二个：",
      "start": 4.3,
      "end": 5.64
    },
    {
      "id": "shot01-3",
      "text": "K 取多少？",
      "start": 5.64,
      "end": 6.8
    },
    {
      "id": "shot01-4",
      "text": "K 太小会怎样、",
      "start": 6.8,
      "end": 8.3
    },
    {
      "id": "shot01-5",
      "text": "太大会怎样、",
      "start": 8.3,
      "end": 9.42
    },
    {
      "id": "shot01-6",
      "text": "怎么选最合适的 K——这一期会一次性回答。",
      "start": 9.42,
      "end": 12.46
    },
    {
      "id": "shot01-7",
      "text": "这看起来只是选个数字的小事，",
      "start": 12.46,
      "end": 14.72
    },
    {
      "id": "shot01-8",
      "text": "其实是模型行为的总开关。K 太小，",
      "start": 14.72,
      "end": 18.3
    },
    {
      "id": "shot01-9",
      "text": "模型会贴着每一个训练点连噪声都信；",
      "start": 18.3,
      "end": 21.18
    },
    {
      "id": "shot01-10",
      "text": "K 太大，",
      "start": 21.18,
      "end": 22.28
    },
    {
      "id": "shot01-11",
      "text": "模型会被多数类绑架，",
      "start": 22.28,
      "end": 23.82
    },
    {
      "id": "shot01-12",
      "text": "谁来都给一个答案。",
      "start": 23.82,
      "end": 25.5
    },
    {
      "id": "shot01-13",
      "text": "我们把 K 从 1 一路拖到 121，",
      "start": 25.863,
      "end": 28.423
    },
    {
      "id": "shot01-14",
      "text": "看决策边界从扭曲到平滑再到崩溃，",
      "start": 28.423,
      "end": 31.883
    },
    {
      "id": "shot01-15",
      "text": "最后还会加一个工程实践 trick：",
      "start": 31.883,
      "end": 34.283
    },
    {
      "id": "shot01-16",
      "text": "处理远近邻居权重不平等的问题。",
      "start": 34.283,
      "end": 37.043
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先建立直觉。",
      "start": 0.0,
      "end": 1.4
    },
    {
      "id": "shot02-1",
      "text": "K 控制的是模型听几个邻居的意见。",
      "start": 1.4,
      "end": 4.26
    },
    {
      "id": "shot02-2",
      "text": "把 KNN 想成开会决策。",
      "start": 4.26,
      "end": 6.5
    },
    {
      "id": "shot02-3",
      "text": "K=1 像独裁——只听离你最近的那一个邻居，",
      "start": 6.5,
      "end": 10.24
    },
    {
      "id": "shot02-4",
      "text": "他说啥就是啥。",
      "start": 10.24,
      "end": 11.5
    },
    {
      "id": "shot02-5",
      "text": "如果这个邻居是个怪人，",
      "start": 11.5,
      "end": 13.28
    },
    {
      "id": "shot02-6",
      "text": "你就被一个人的怪意见带跑了。",
      "start": 13.28,
      "end": 16.0
    },
    {
      "id": "shot02-7",
      "text": "K=N 像全民投票——把训练集所有人都拉来投票，",
      "start": 16.0,
      "end": 20.16
    },
    {
      "id": "shot02-8",
      "text": "问题是这种投票没考虑你跟谁更像，",
      "start": 20.16,
      "end": 23.38
    },
    {
      "id": "shot02-9",
      "text": "谁是多数谁就赢，",
      "start": 23.38,
      "end": 24.9
    },
    {
      "id": "shot02-10",
      "text": "你成了多数派的复读机。",
      "start": 24.9,
      "end": 26.66
    },
    {
      "id": "shot02-11",
      "text": "中间的 K，",
      "start": 26.66,
      "end": 27.9
    },
    {
      "id": "shot02-12",
      "text": "比如 K=11，",
      "start": 27.9,
      "end": 29.24
    },
    {
      "id": "shot02-13",
      "text": "是少数议事——叫几个最近邻一起讨论，",
      "start": 29.24,
      "end": 32.9
    },
    {
      "id": "shot02-14",
      "text": "既不被一个怪人独裁，",
      "start": 32.9,
      "end": 34.68
    },
    {
      "id": "shot02-15",
      "text": "也不被多数派绑架。",
      "start": 34.68,
      "end": 36.12
    },
    {
      "id": "shot02-16",
      "text": "这一期要演的就是 K=1、",
      "start": 36.43,
      "end": 38.162
    },
    {
      "id": "shot02-17",
      "text": "K=11、",
      "start": 38.162,
      "end": 39.59
    },
    {
      "id": "shot02-18",
      "text": "K=51、",
      "start": 39.59,
      "end": 40.85
    },
    {
      "id": "shot02-19",
      "text": "K=121 四个档位的现象，",
      "start": 40.85,
      "end": 43.61
    },
    {
      "id": "shot02-20",
      "text": "每个档位都对应开会方式的一种极端或妥协。",
      "start": 43.61,
      "end": 47.33
    },
    {
      "id": "shot02-21",
      "text": "算法的步骤本身没变，",
      "start": 47.33,
      "end": 49.11
    },
    {
      "id": "shot02-22",
      "text": "只是 K 这一个数字在变。",
      "start": 49.11,
      "end": 50.85
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "为了把这四个档位演得清楚，",
      "start": 0.0,
      "end": 2.14
    },
    {
      "id": "shot03-1",
      "text": "我们换一个数据集。",
      "start": 2.14,
      "end": 3.7
    },
    {
      "id": "shot03-2",
      "text": "上一期的 9 部真实电影太少了——K 一",
      "start": 3.7,
      "end": 6.72
    },
    {
      "id": "shot03-3",
      "text": "动准确率就跳，",
      "start": 6.72,
      "end": 7.84
    },
    {
      "id": "shot03-4",
      "text": "看不出连续变化。",
      "start": 7.84,
      "end": 9.22
    },
    {
      "id": "shot03-5",
      "text": "这一期切到 126 部合成数据：",
      "start": 9.22,
      "end": 11.8
    },
    {
      "id": "shot03-6",
      "text": "我用程序随机生成的假电影，",
      "start": 11.8,
      "end": 14.14
    },
    {
      "id": "shot03-7",
      "text": "分两堆放好。",
      "start": 14.14,
      "end": 15.74
    },
    {
      "id": "shot03-8",
      "text": "喜欢堆集中在评分 8.5、",
      "start": 15.74,
      "end": 17.9
    },
    {
      "id": "shot03-9",
      "text": "主演 9.0 那一带，",
      "start": 17.9,
      "end": 19.32
    },
    {
      "id": "shot03-10",
      "text": "不喜欢堆在 6.0 和 5.5。",
      "start": 19.32,
      "end": 21.58
    },
    {
      "id": "shot03-11",
      "text": "两堆样本数略有差异：",
      "start": 21.58,
      "end": 23.64
    },
    {
      "id": "shot03-12",
      "text": "喜欢 60 部，",
      "start": 23.64,
      "end": 24.8
    },
    {
      "id": "shot03-13",
      "text": "不喜欢 66 部——这点差异等会儿在 K",
      "start": 24.8,
      "end": 27.92
    },
    {
      "id": "shot03-14",
      "text": "=121 时会变成关键。",
      "start": 27.92,
      "end": 29.94
    },
    {
      "id": "shot03-15",
      "text": "然后我故意在喜欢堆正中央扔了 6 个评分",
      "start": 30.364,
      "end": 33.624
    },
    {
      "id": "shot03-16",
      "text": "虚高的假烂片，",
      "start": 33.624,
      "end": 34.884
    },
    {
      "id": "shot03-17",
      "text": "标签是不喜欢——把它们想成朋友圈刷高评分",
      "start": 34.884,
      "end": 38.504
    },
    {
      "id": "shot03-18",
      "text": "但其实拍得很烂的电影。",
      "start": 38.504,
      "end": 40.264
    },
    {
      "id": "shot03-19",
      "text": "这 6 个噪声点是这一期的关键道具，",
      "start": 40.264,
      "end": 42.784
    },
    {
      "id": "shot03-20",
      "text": "等下你会看到 K=1 时它们怎么把决策边界搞扭曲。",
      "start": 42.784,
      "end": 46.624
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开 demo 之前先解释一个新概念：决策边界，",
      "start": 0.0,
      "end": 3.02
    },
    {
      "id": "shot04-1",
      "text": "英文 decision boundary。",
      "start": 3.02,
      "end": 4.72
    },
    {
      "id": "shot04-2",
      "text": "屏幕上会有一张图，",
      "start": 4.72,
      "end": 6.27
    },
    {
      "id": "shot04-3",
      "text": "圆点是训练数据——126 部假电影。",
      "start": 6.27,
      "end": 9.72
    },
    {
      "id": "shot04-4",
      "text": "但背景色是另一回事，",
      "start": 9.72,
      "end": 11.38
    },
    {
      "id": "shot04-5",
      "text": "它表示模型对每一个假想新电影的预测：",
      "start": 11.38,
      "end": 14.78
    },
    {
      "id": "shot04-6",
      "text": "我们把整个平面切成 60 乘 60 的格子，",
      "start": 14.78,
      "end": 18.0
    },
    {
      "id": "shot04-7",
      "text": "每一格都问 KNN 一次：",
      "start": 18.0,
      "end": 19.86
    },
    {
      "id": "shot04-8",
      "text": "如果有部新电影评分是 X、",
      "start": 19.86,
      "end": 22.02
    },
    {
      "id": "shot04-9",
      "text": "主演是 Y，",
      "start": 22.02,
      "end": 23.16
    },
    {
      "id": "shot04-10",
      "text": "你预测它是喜欢还是不喜欢？",
      "start": 23.16,
      "end": 25.36
    },
    {
      "id": "shot04-11",
      "text": "淡绿是喜欢，",
      "start": 25.36,
      "end": 26.24
    },
    {
      "id": "shot04-12",
      "text": "淡红是不喜欢。",
      "start": 26.24,
      "end": 27.74
    },
    {
      "id": "shot04-13",
      "text": "淡绿和淡红的分界，",
      "start": 27.74,
      "end": 29.26
    },
    {
      "id": "shot04-14",
      "text": "就是决策边界。",
      "start": 29.26,
      "end": 30.5
    },
    {
      "id": "shot04-15",
      "text": "记住，",
      "start": 30.907,
      "end": 31.427
    },
    {
      "id": "shot04-16",
      "text": "背景色不是数据密度，",
      "start": 31.427,
      "end": 33.267
    },
    {
      "id": "shot04-17",
      "text": "也不是概率——它是 KNN 在全平面的预测地图。K 一变，",
      "start": 33.267,
      "end": 37.567
    },
    {
      "id": "shot04-18",
      "text": "所有 3600 个格子重新投票，",
      "start": 37.567,
      "end": 40.447
    },
    {
      "id": "shot04-19",
      "text": "背景色刷新——决策边界跟着变。",
      "start": 40.447,
      "end": 42.703
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "打开 demo，",
      "start": 0.0,
      "end": 0.82
    },
    {
      "id": "shot05-1",
      "text": "K 拖到 1。",
      "start": 0.82,
      "end": 1.92
    },
    {
      "id": "shot05-2",
      "text": "看决策边界——完全贴着每一个训练点。",
      "start": 1.92,
      "end": 5.307
    },
    {
      "id": "shot05-3",
      "text": "喜欢堆中心那 6 个红点周围，",
      "start": 5.307,
      "end": 7.755
    },
    {
      "id": "shot05-4",
      "text": "炸出 6 个红色孤岛。",
      "start": 7.755,
      "end": 9.8
    },
    {
      "id": "shot05-5",
      "text": "原因很直观：",
      "start": 9.8,
      "end": 11.02
    },
    {
      "id": "shot05-6",
      "text": "K=1 就是上一期说的独裁——每一格只听",
      "start": 11.02,
      "end": 14.32
    },
    {
      "id": "shot05-7",
      "text": "最近一个邻居的，",
      "start": 14.32,
      "end": 15.56
    },
    {
      "id": "shot05-8",
      "text": "落在噪声点旁边的格子，",
      "start": 15.56,
      "end": 17.4
    },
    {
      "id": "shot05-9",
      "text": "最近邻就是噪声本身，",
      "start": 17.4,
      "end": 19.16
    },
    {
      "id": "shot05-10",
      "text": "预测自然变成不喜欢。",
      "start": 19.16,
      "end": 20.94
    },
    {
      "id": "shot05-11",
      "text": "结果是模型把这些假烂片当真规律记下来了。",
      "start": 20.94,
      "end": 24.38
    },
    {
      "id": "shot05-12",
      "text": "这就是过拟合，",
      "start": 24.38,
      "end": 25.42
    },
    {
      "id": "shot05-13",
      "text": "英文 overfitting。",
      "start": 25.42,
      "end": 26.72
    },
    {
      "id": "shot05-14",
      "text": "上一期 demo 我们也演过 K=1，",
      "start": 27.103,
      "end": 29.843
    },
    {
      "id": "shot05-15",
      "text": "但那时只有 9 部数据看不出后果——现在",
      "start": 29.843,
      "end": 32.763
    },
    {
      "id": "shot05-16",
      "text": "126 部 + 6 个噪声，",
      "start": 32.763,
      "end": 34.803
    },
    {
      "id": "shot05-17",
      "text": "K=1 的代价就显形了：",
      "start": 34.803,
      "end": 37.023
    },
    {
      "id": "shot05-18",
      "text": "决策边界扭成 6 个孤岛——周围明明一片",
      "start": 37.023,
      "end": 40.263
    },
    {
      "id": "shot05-19",
      "text": "绿色喜欢区，",
      "start": 40.263,
      "end": 41.563
    },
    {
      "id": "shot05-20",
      "text": "每个噪声点都把自己一小圈拉成了不喜欢的红圈。",
      "start": 41.563,
      "end": 45.303
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "我们把 K 慢慢拖大，",
      "start": 0.0,
      "end": 1.78
    },
    {
      "id": "shot06-1",
      "text": "先到 11。看：",
      "start": 1.78,
      "end": 3.24
    },
    {
      "id": "shot06-2",
      "text": "6 个红色孤岛全部消失了。为什么？",
      "start": 3.24,
      "end": 6.38
    },
    {
      "id": "shot06-3",
      "text": "K=11 时每一格要听 11 个邻居一起投票，",
      "start": 6.38,
      "end": 10.14
    },
    {
      "id": "shot06-4",
      "text": "6 个孤立的噪声点被周围一片喜欢的邻居淹没。",
      "start": 10.14,
      "end": 14.34
    },
    {
      "id": "shot06-5",
      "text": "这个 11 不是随便选的——它接近样本数",
      "start": 14.34,
      "end": 17.62
    },
    {
      "id": "shot06-6",
      "text": "126 的平方根，",
      "start": 17.62,
      "end": 19.06
    },
    {
      "id": "shot06-7",
      "text": "是 KNN 调参的常用经验值。",
      "start": 19.06,
      "end": 21.94
    },
    {
      "id": "shot06-8",
      "text": "准确率从 K=1 时的 82% 跳到89%。",
      "start": 21.94,
      "end": 25.96
    },
    {
      "id": "shot06-9",
      "text": "准确率怎么算的？",
      "start": 25.96,
      "end": 27.38
    },
    {
      "id": "shot06-10",
      "text": "方法很直接：",
      "start": 27.631,
      "end": 28.871
    },
    {
      "id": "shot06-11",
      "text": "拿出 1 部电影当题目，",
      "start": 28.871,
      "end": 30.551
    },
    {
      "id": "shot06-12",
      "text": "用剩下 125 部预测它，",
      "start": 30.551,
      "end": 32.951
    },
    {
      "id": "shot06-13",
      "text": "记一次对错；",
      "start": 32.951,
      "end": 33.791
    },
    {
      "id": "shot06-14",
      "text": "126 部每部都当一次题目，",
      "start": 33.791,
      "end": 36.331
    },
    {
      "id": "shot06-15",
      "text": "跑完 126 次，",
      "start": 36.331,
      "end": 37.971
    },
    {
      "id": "shot06-16",
      "text": "预测对的比例就是这个 K 的准确率。",
      "start": 37.971,
      "end": 40.571
    },
    {
      "id": "shot06-17",
      "text": "这种打分方式叫交叉验证，",
      "start": 40.571,
      "end": 42.851
    },
    {
      "id": "shot06-18",
      "text": "英文 cross-validation。",
      "start": 42.851,
      "end": 44.811
    },
    {
      "id": "shot06-19",
      "text": "我们刚才用的是它的一个特例叫留一交叉验证",
      "start": 44.811,
      "end": 48.051
    },
    {
      "id": "shot06-20",
      "text": "leave-one-out",
      "start": 48.051,
      "end": 48.951
    },
    {
      "id": "shot06-21",
      "text": "cross-validation，",
      "start": 48.951,
      "end": 49.871
    },
    {
      "id": "shot06-22",
      "text": "每次留 1 个；",
      "start": 49.871,
      "end": 51.171
    },
    {
      "id": "shot06-23",
      "text": "其他常见版本（留 5 个、",
      "start": 51.171,
      "end": 53.251
    },
    {
      "id": "shot06-24",
      "text": "留 10 个等）05 章会专门讲。",
      "start": 53.251,
      "end": 55.631
    },
    {
      "id": "shot06-25",
      "text": "所以 89% 意思是 126 部里大约",
      "start": 55.841,
      "end": 59.241
    },
    {
      "id": "shot06-26",
      "text": "112 部预测对了。",
      "start": 59.241,
      "end": 61.501
    },
    {
      "id": "shot06-27",
      "text": "继续拖到 51。注意看，",
      "start": 61.501,
      "end": 63.621
    },
    {
      "id": "shot06-28",
      "text": "决策边界还在变得更光滑，",
      "start": 63.621,
      "end": 66.141
    },
    {
      "id": "shot06-29",
      "text": "但准确率几乎没动，",
      "start": 66.141,
      "end": 68.001
    },
    {
      "id": "shot06-30",
      "text": "还在 89% 到 90% 这个高位。",
      "start": 68.001,
      "end": 71.881
    },
    {
      "id": "shot06-31",
      "text": "这一段我们叫平台期——K 在中间一段范围里，",
      "start": 71.881,
      "end": 75.921
    },
    {
      "id": "shot06-32",
      "text": "准确率不太敏感，",
      "start": 75.921,
      "end": 77.341
    },
    {
      "id": "shot06-33",
      "text": "怎么选都差不多。",
      "start": 77.341,
      "end": 78.621
    },
    {
      "id": "shot06-34",
      "text": "这是个好消息：",
      "start": 78.621,
      "end": 79.921
    },
    {
      "id": "shot06-35",
      "text": "选 K 不需要在 11、13、",
      "start": 79.921,
      "end": 82.261
    },
    {
      "id": "shot06-36",
      "text": "15 之间精挑细选，",
      "start": 82.261,
      "end": 84.041
    },
    {
      "id": "shot06-37",
      "text": "避开两端选一个中段值就行。",
      "start": 84.041,
      "end": 86.361
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "现在跳到极端，",
      "start": 0.0,
      "end": 1.72
    },
    {
      "id": "shot07-1",
      "text": "K 拖到 121，",
      "start": 1.72,
      "end": 3.42
    },
    {
      "id": "shot07-2",
      "text": "几乎等于样本数 126。看：",
      "start": 3.42,
      "end": 6.74
    },
    {
      "id": "shot07-3",
      "text": "决策边界整张图几乎全部变红，",
      "start": 6.74,
      "end": 9.48
    },
    {
      "id": "shot07-4",
      "text": "准确率暴跌到 52%。为什么？",
      "start": 9.48,
      "end": 12.6
    },
    {
      "id": "shot07-5",
      "text": "K=121 就是上一期说的全民投票——每",
      "start": 12.6,
      "end": 15.98
    },
    {
      "id": "shot07-6",
      "text": "一格要听 121 个邻居的意见，",
      "start": 15.98,
      "end": 18.4
    },
    {
      "id": "shot07-7",
      "text": "几乎相当于把整个训练集都拉来投票。",
      "start": 18.4,
      "end": 21.98
    },
    {
      "id": "shot07-8",
      "text": "这个数据集里不喜欢有 66 部，",
      "start": 21.98,
      "end": 24.3
    },
    {
      "id": "shot07-9",
      "text": "喜欢有 60 部，",
      "start": 24.3,
      "end": 25.54
    },
    {
      "id": "shot07-10",
      "text": "多数类是不喜欢——所以无论新电影落哪儿，",
      "start": 25.54,
      "end": 28.68
    },
    {
      "id": "shot07-11",
      "text": "66 票永远压过 60 票，",
      "start": 28.68,
      "end": 30.86
    },
    {
      "id": "shot07-12",
      "text": "预测都被绑架成不喜欢。",
      "start": 30.86,
      "end": 32.68
    },
    {
      "id": "shot07-13",
      "text": "模型退化成了永远预测多数类，",
      "start": 33.203,
      "end": 35.663
    },
    {
      "id": "shot07-14",
      "text": "特征信息完全失效。",
      "start": 35.663,
      "end": 37.423
    },
    {
      "id": "shot07-15",
      "text": "这就是欠拟合，",
      "start": 37.423,
      "end": 38.803
    },
    {
      "id": "shot07-16",
      "text": "英文 underfitting。",
      "start": 38.803,
      "end": 40.163
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "把刚才的演示串成一张图：",
      "start": 0.0,
      "end": 2.22
    },
    {
      "id": "shot08-1",
      "text": "K=1 时决策边界被噪声扭成 6 个孤岛，",
      "start": 2.22,
      "end": 6.02
    },
    {
      "id": "shot08-2",
      "text": "K=121 时全图被多数派绑架，",
      "start": 6.02,
      "end": 9.44
    },
    {
      "id": "shot08-3",
      "text": "中段从 K=11 到 K=51 是 89",
      "start": 9.44,
      "end": 13.047
    },
    {
      "id": "shot08-4",
      "text": "% 的宽平台。",
      "start": 13.047,
      "end": 14.66
    },
    {
      "id": "shot08-5",
      "text": "两端各有毛病，",
      "start": 14.66,
      "end": 16.1
    },
    {
      "id": "shot08-6",
      "text": "中段最舒服——这种 K 一头一尾各坏一头的取舍，",
      "start": 16.1,
      "end": 20.22
    },
    {
      "id": "shot08-7",
      "text": "在 ML 里有个名字叫偏差方差权衡，",
      "start": 20.22,
      "end": 23.92
    },
    {
      "id": "shot08-8",
      "text": "英文 bias-variance",
      "start": 23.92,
      "end": 25.52
    },
    {
      "id": "shot08-9",
      "text": "trade-off。",
      "start": 25.52,
      "end": 26.42
    },
    {
      "id": "shot08-10",
      "text": "回到本节主问题：",
      "start": 26.42,
      "end": 28.24
    },
    {
      "id": "shot08-11",
      "text": "K 该怎么选？",
      "start": 28.24,
      "end": 29.78
    },
    {
      "id": "shot08-12",
      "text": "答案很简单——避开 1、避开 N、",
      "start": 29.78,
      "end": 32.22
    },
    {
      "id": "shot08-13",
      "text": "中段平台里随便选。",
      "start": 32.22,
      "end": 33.96
    },
    {
      "id": "shot08-14",
      "text": "最实用的经验值是 K ≈ √N，",
      "start": 34.322,
      "end": 37.322
    },
    {
      "id": "shot08-15",
      "text": "本数据集 √126 ≈ 11，",
      "start": 37.322,
      "end": 40.282
    },
    {
      "id": "shot08-16",
      "text": "直接用就够。",
      "start": 40.282,
      "end": 41.542
    },
    {
      "id": "shot08-17",
      "text": "想再精挑可以用刚才说的交叉验证给每个 K",
      "start": 41.542,
      "end": 45.222
    },
    {
      "id": "shot08-18",
      "text": "打分挑最高的，",
      "start": 45.222,
      "end": 46.582
    },
    {
      "id": "shot08-19",
      "text": "但工程上很少这么细。",
      "start": 46.582,
      "end": 48.922
    },
    {
      "id": "shot08-20",
      "text": "原因 demo 里已经看过了——平台期",
      "start": 48.922,
      "end": 51.582
    },
    {
      "id": "shot08-21",
      "text": "K=11 到 K=51 的准确率都在",
      "start": 51.582,
      "end": 54.942
    },
    {
      "id": "shot08-22",
      "text": "89-90%，",
      "start": 54.942,
      "end": 56.182
    },
    {
      "id": "shot08-23",
      "text": "挑 K=11 还是 K=23，",
      "start": 56.182,
      "end": 59.102
    },
    {
      "id": "shot08-24",
      "text": "跑出来都是差不多的分数。",
      "start": 59.102,
      "end": 60.902
    }
  ],
  "shot09": [
    {
      "id": "shot09-0",
      "text": "最后讲一个 KNN 的工程优化。",
      "start": 0.0,
      "end": 2.52
    },
    {
      "id": "shot09-1",
      "text": "在我们刚才的多数票里，",
      "start": 2.52,
      "end": 4.06
    },
    {
      "id": "shot09-2",
      "text": "每个邻居都是 1 票——不管它离你 0.",
      "start": 4.06,
      "end": 6.76
    },
    {
      "id": "shot09-3",
      "text": "5 还是 5.0，权重一样。",
      "start": 6.76,
      "end": 8.86
    },
    {
      "id": "shot09-4",
      "text": "但凭直觉，",
      "start": 8.86,
      "end": 9.94
    },
    {
      "id": "shot09-5",
      "text": "更近的邻居应该更可信。",
      "start": 9.94,
      "end": 12.36
    },
    {
      "id": "shot09-6",
      "text": "距离加权投票就是按这个直觉调权：",
      "start": 12.36,
      "end": 15.24
    },
    {
      "id": "shot09-7",
      "text": "每个邻居的票数等于距离的倒数，",
      "start": 15.24,
      "end": 18.14
    },
    {
      "id": "shot09-8",
      "text": "1 除以 d，",
      "start": 18.14,
      "end": 19.18
    },
    {
      "id": "shot09-9",
      "text": "离得越近权重越大。",
      "start": 19.18,
      "end": 20.9
    },
    {
      "id": "shot09-10",
      "text": "术语叫距离加权投票，",
      "start": 20.9,
      "end": 22.88
    },
    {
      "id": "shot09-11",
      "text": "英文 distance-weighted",
      "start": 22.88,
      "end": 24.46
    },
    {
      "id": "shot09-12",
      "text": "voting。",
      "start": 24.46,
      "end": 25.16
    },
    {
      "id": "shot09-13",
      "text": "切回 demo，",
      "start": 25.16,
      "end": 26.06
    },
    {
      "id": "shot09-14",
      "text": "K 拖到 21，",
      "start": 26.06,
      "end": 27.02
    },
    {
      "id": "shot09-15",
      "text": "把距离加权开关打开。",
      "start": 27.02,
      "end": 28.92
    },
    {
      "id": "shot09-16",
      "text": "看决策边界——比纯多数票更紧贴训练点。",
      "start": 29.207,
      "end": 33.647
    },
    {
      "id": "shot09-17",
      "text": "原因是远处的邻居影响被压低了，",
      "start": 33.647,
      "end": 36.727
    },
    {
      "id": "shot09-18",
      "text": "每一格的预测主要由身边几个最近邻决定。",
      "start": 36.727,
      "end": 40.587
    },
    {
      "id": "shot09-19",
      "text": "加权还有个附带好处：",
      "start": 40.587,
      "end": 42.567
    },
    {
      "id": "shot09-20",
      "text": "偶数 K 时不容易平票。",
      "start": 42.567,
      "end": 44.987
    },
    {
      "id": "shot09-21",
      "text": "比如 K=4 时 2 比 2 票，",
      "start": 44.987,
      "end": 47.807
    },
    {
      "id": "shot09-22",
      "text": "但距离不同，",
      "start": 47.807,
      "end": 48.987
    },
    {
      "id": "shot09-23",
      "text": "加权后总分一定不相等，",
      "start": 48.987,
      "end": 51.217
    },
    {
      "id": "shot09-24",
      "text": "平票自动破解。",
      "start": 51.217,
      "end": 52.517
    },
    {
      "id": "shot09-25",
      "text": "注意一个副作用：",
      "start": 52.517,
      "end": 53.907
    },
    {
      "id": "shot09-26",
      "text": "如果噪声点离查询点很近，",
      "start": 53.907,
      "end": 56.687
    },
    {
      "id": "shot09-27",
      "text": "加权反而会放大它的影响。",
      "start": 56.687,
      "end": 58.767
    },
    {
      "id": "shot09-28",
      "text": "加权不是万能开关，",
      "start": 58.767,
      "end": 60.627
    },
    {
      "id": "shot09-29",
      "text": "要看场景。",
      "start": 60.627,
      "end": 61.747
    },
    {
      "id": "shot09-30",
      "text": "实操上的简单判断：",
      "start": 62.093,
      "end": 63.713
    },
    {
      "id": "shot09-31",
      "text": "数据干净就开（远邻被压权稳赚），",
      "start": 63.713,
      "end": 64.893
    },
    {
      "id": "shot09-32",
      "text": "数据可能有噪声就开关都试一遍，",
      "start": 64.893,
      "end": 67.853
    },
    {
      "id": "shot09-33",
      "text": "对比哪个准确率高。",
      "start": 67.853,
      "end": 69.193
    }
  ],
  "shot10": [
    {
      "id": "shot10-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.16
    },
    {
      "id": "shot10-1",
      "text": "我们系统讲清楚了三件事：",
      "start": 1.16,
      "end": 3.14
    },
    {
      "id": "shot10-2",
      "text": "K 该怎么选(KNN 的第二个核心问题)，",
      "start": 3.14,
      "end": 5.94
    },
    {
      "id": "shot10-3",
      "text": "决策边界这个 ML 通用可视化语言，",
      "start": 5.94,
      "end": 8.9
    },
    {
      "id": "shot10-4",
      "text": "以及处理远近权重不平等的距离加权投票。",
      "start": 8.9,
      "end": 12.23
    },
    {
      "id": "shot10-5",
      "text": "过程里点到了几个概念但没系统展开：",
      "start": 12.23,
      "end": 15.46
    },
    {
      "id": "shot10-6",
      "text": "过拟合和欠拟合，",
      "start": 15.46,
      "end": 16.7
    },
    {
      "id": "shot10-7",
      "text": "本期只演示了 KNN 上的视觉表现，",
      "start": 16.7,
      "end": 19.24
    },
    {
      "id": "shot10-8",
      "text": "完整定义留给第 2 章 LR 过拟合专章讲；偏差、方差、",
      "start": 19.24,
      "end": 23.6
    },
    {
      "id": "shot10-9",
      "text": "偏差方差权衡这一组，",
      "start": 23.6,
      "end": 25.42
    },
    {
      "id": "shot10-10",
      "text": "也留给同一专章；",
      "start": 25.42,
      "end": 27.5
    },
    {
      "id": "shot10-11",
      "text": "交叉验证的完整方法留给本章第 5 节超参",
      "start": 27.5,
      "end": 31.04
    },
    {
      "id": "shot10-12",
      "text": "数搜索专章。",
      "start": 31.04,
      "end": 31.9
    },
    {
      "id": "shot10-13",
      "text": "这一期的核心是 K 怎么选，",
      "start": 32.3,
      "end": 34.22
    },
    {
      "id": "shot10-14",
      "text": "扯太多概念会分散。",
      "start": 34.22,
      "end": 35.74
    },
    {
      "id": "shot10-15",
      "text": "如果讲得有不对的地方，",
      "start": 35.74,
      "end": 37.08
    },
    {
      "id": "shot10-16",
      "text": "欢迎在评论区指正。",
      "start": 37.08,
      "end": 38.58
    },
    {
      "id": "shot10-17",
      "text": "下一期我们把 KNN 串成完整工作流，",
      "start": 38.58,
      "end": 41.62
    },
    {
      "id": "shot10-18",
      "text": "看怎么从分类切到回归。下集见。",
      "start": 41.62,
      "end": 44.281
    }
  ]
}
