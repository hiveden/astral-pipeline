{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "AdaBoost 告诉下一棵树的是：",
      "start": 0.08,
      "end": 2.044
    },
    {
      "id": "shot01-1",
      "text": "哪些样本错了，",
      "start": 2.044,
      "end": 3.286
    },
    {
      "id": "shot01-2",
      "text": "所以要多看。",
      "start": 3.286,
      "end": 4.388
    },
    {
      "id": "shot01-3",
      "text": "GBDT 换了一种说法：",
      "start": 4.388,
      "end": 6.011
    },
    {
      "id": "shot01-4",
      "text": "不要只告诉我错没错，",
      "start": 6.011,
      "end": 7.834
    },
    {
      "id": "shot01-5",
      "text": "直接告诉我还差多少。",
      "start": 7.834,
      "end": 9.538
    },
    {
      "id": "shot01-6",
      "text": "比如真实年龄是 100 岁，",
      "start": 9.538,
      "end": 11.281
    },
    {
      "id": "shot01-7",
      "text": "第一棵树预测 80，",
      "start": 11.281,
      "end": 12.764
    },
    {
      "id": "shot01-8",
      "text": "残差就是 20。",
      "start": 12.764,
      "end": 14.367
    },
    {
      "id": "shot01-9",
      "text": "第二棵树不再重新预测 100 岁，",
      "start": 14.367,
      "end": 16.691
    },
    {
      "id": "shot01-10",
      "text": "而是专门学习这 20 岁的缺口，",
      "start": 16.691,
      "end": 18.995
    },
    {
      "id": "shot01-11",
      "text": "预测 16。",
      "start": 18.995,
      "end": 20.117
    },
    {
      "id": "shot01-12",
      "text": "现在累计预测变成 96，",
      "start": 20.117,
      "end": 22.121
    },
    {
      "id": "shot01-13",
      "text": "残差只剩 4。",
      "start": 22.121,
      "end": 23.503
    },
    {
      "id": "shot01-14",
      "text": "第三棵树再学 4，",
      "start": 23.503,
      "end": 24.886
    },
    {
      "id": "shot01-15",
      "text": "预测 3.2，",
      "start": 24.886,
      "end": 25.908
    },
    {
      "id": "shot01-16",
      "text": "累计就到 99.2。",
      "start": 25.908,
      "end": 27.09
    },
    {
      "id": "shot01-17",
      "text": "GBDT 的直觉就在这里：",
      "start": 27.793,
      "end": 29.696
    },
    {
      "id": "shot01-18",
      "text": "每棵树不是重做整道题，",
      "start": 29.696,
      "end": 31.919
    },
    {
      "id": "shot01-19",
      "text": "而是补上一棵树漏掉的那段差。",
      "start": 31.919,
      "end": 34.383
    },
    {
      "id": "shot01-20",
      "text": "这期我们先讲提升树的残差接力，",
      "start": 34.383,
      "end": 36.967
    },
    {
      "id": "shot01-21",
      "text": "再把残差推广成负梯度，",
      "start": 36.967,
      "end": 39.03
    },
    {
      "id": "shot01-22",
      "text": "解释为什么 GBDT 能从回归走到分类。",
      "start": 39.03,
      "end": 41.855
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "提升树的关键定义是残差。",
      "start": 0.0,
      "end": 2.482
    },
    {
      "id": "shot02-1",
      "text": "残差等于真实值减当前预测值，",
      "start": 2.482,
      "end": 5.363
    },
    {
      "id": "shot02-2",
      "text": "记作 r 等于 y 减 f x。",
      "start": 5.363,
      "end": 7.925
    },
    {
      "id": "shot02-3",
      "text": "它带方向，也带大小。残差为正，",
      "start": 7.925,
      "end": 10.667
    },
    {
      "id": "shot02-4",
      "text": "说明当前预测低了；残差为负，",
      "start": 10.667,
      "end": 13.268
    },
    {
      "id": "shot02-5",
      "text": "说明当前预测高了；",
      "start": 13.268,
      "end": 14.969
    },
    {
      "id": "shot02-6",
      "text": "绝对值越大，",
      "start": 14.969,
      "end": 15.97
    },
    {
      "id": "shot02-7",
      "text": "说明还差得越多。",
      "start": 15.97,
      "end": 17.758
    },
    {
      "id": "shot02-8",
      "text": "第 m 棵树训练时，",
      "start": 17.758,
      "end": 19.312
    },
    {
      "id": "shot02-9",
      "text": "目标变量不再是原始 y，",
      "start": 19.312,
      "end": 21.253
    },
    {
      "id": "shot02-10",
      "text": "而是上一轮的残差。",
      "start": 21.253,
      "end": 22.934
    },
    {
      "id": "shot02-11",
      "text": "训练完以后，",
      "start": 22.934,
      "end": 23.835
    },
    {
      "id": "shot02-12",
      "text": "把这棵树的输出加到当前累计预测上，",
      "start": 23.835,
      "end": 27.057
    },
    {
      "id": "shot02-13",
      "text": "再重新计算残差。",
      "start": 27.057,
      "end": 28.798
    },
    {
      "id": "shot02-14",
      "text": "这个过程会反复进行，",
      "start": 28.798,
      "end": 30.439
    },
    {
      "id": "shot02-15",
      "text": "直到树的数量达到设定值，",
      "start": 30.439,
      "end": 32.641
    },
    {
      "id": "shot02-16",
      "text": "或者残差已经足够小。",
      "start": 32.641,
      "end": 34.122
    },
    {
      "id": "shot02-17",
      "text": "用商品 82 元的例子看，",
      "start": 34.696,
      "end": 36.723
    },
    {
      "id": "shot02-18",
      "text": "第一棵树猜 50，",
      "start": 36.723,
      "end": 38.238
    },
    {
      "id": "shot02-19",
      "text": "残差 32；",
      "start": 38.238,
      "end": 39.131
    },
    {
      "id": "shot02-20",
      "text": "第二棵树学 32，",
      "start": 39.131,
      "end": 40.596
    },
    {
      "id": "shot02-21",
      "text": "预测 20，",
      "start": 40.596,
      "end": 41.549
    },
    {
      "id": "shot02-22",
      "text": "残差 12；",
      "start": 41.549,
      "end": 42.282
    },
    {
      "id": "shot02-23",
      "text": "第三棵树学 12，",
      "start": 42.282,
      "end": 43.506
    },
    {
      "id": "shot02-24",
      "text": "预测 10，",
      "start": 43.506,
      "end": 44.208
    },
    {
      "id": "shot02-25",
      "text": "累计 80，",
      "start": 44.208,
      "end": 44.971
    },
    {
      "id": "shot02-26",
      "text": "已经接近 82。",
      "start": 44.971,
      "end": 46.054
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "现在把 AdaBoost 和提升树放在一",
      "start": 0.0,
      "end": 2.561
    },
    {
      "id": "shot03-1",
      "text": "起看。",
      "start": 2.561,
      "end": 3.122
    },
    {
      "id": "shot03-2",
      "text": "它们都属于 boosting，",
      "start": 3.122,
      "end": 4.422
    },
    {
      "id": "shot03-3",
      "text": "都是串行训练，",
      "start": 4.422,
      "end": 5.663
    },
    {
      "id": "shot03-4",
      "text": "后一棵树依赖前面已经训练出的结果。",
      "start": 5.663,
      "end": 8.545
    },
    {
      "id": "shot03-5",
      "text": "但传递的信息完全不同。",
      "start": 8.545,
      "end": 10.546
    },
    {
      "id": "shot03-6",
      "text": "AdaBoost 传递的是样本权重：",
      "start": 10.546,
      "end": 12.787
    },
    {
      "id": "shot03-7",
      "text": "这条样本上一轮错了，",
      "start": 12.787,
      "end": 14.388
    },
    {
      "id": "shot03-8",
      "text": "下一轮请多看它。",
      "start": 14.388,
      "end": 16.249
    },
    {
      "id": "shot03-9",
      "text": "原始标签不变，",
      "start": 16.249,
      "end": 17.574
    },
    {
      "id": "shot03-10",
      "text": "只是每条样本的重要性变了。",
      "start": 17.574,
      "end": 19.882
    },
    {
      "id": "shot03-11",
      "text": "提升树传递的是残差：",
      "start": 19.882,
      "end": 21.768
    },
    {
      "id": "shot03-12",
      "text": "当前模型在这条样本上还差多少，",
      "start": 21.768,
      "end": 24.698
    },
    {
      "id": "shot03-13",
      "text": "下一轮就直接学这个差额。",
      "start": 24.698,
      "end": 26.785
    },
    {
      "id": "shot03-14",
      "text": "对回归来说，",
      "start": 26.785,
      "end": 27.868
    },
    {
      "id": "shot03-15",
      "text": "残差比权重更直接，",
      "start": 27.868,
      "end": 29.815
    },
    {
      "id": "shot03-16",
      "text": "因为它同时包含方向和大小。",
      "start": 29.815,
      "end": 32.042
    },
    {
      "id": "shot03-17",
      "text": "预测 80 岁但真实 100 岁，",
      "start": 32.584,
      "end": 35.169
    },
    {
      "id": "shot03-18",
      "text": "不只是错了，",
      "start": 35.169,
      "end": 35.971
    },
    {
      "id": "shot03-19",
      "text": "还低估了 20 岁。",
      "start": 35.971,
      "end": 37.595
    },
    {
      "id": "shot03-20",
      "text": "下一棵树知道这个数，",
      "start": 37.595,
      "end": 39.158
    },
    {
      "id": "shot03-21",
      "text": "就能专门补 20，",
      "start": 39.158,
      "end": 40.761
    },
    {
      "id": "shot03-22",
      "text": "而不需要重新猜整个人的年龄。",
      "start": 40.761,
      "end": 42.866
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "那为什么还要引入负梯度？",
      "start": 0.0,
      "end": 1.941
    },
    {
      "id": "shot04-1",
      "text": "因为残差这套说法，",
      "start": 1.941,
      "end": 3.542
    },
    {
      "id": "shot04-2",
      "text": "只在平方损失下特别自然。",
      "start": 3.542,
      "end": 5.883
    },
    {
      "id": "shot04-3",
      "text": "平方损失可以写成二分之一乘真实值和预测值",
      "start": 5.883,
      "end": 9.645
    },
    {
      "id": "shot04-4",
      "text": "差的平方。",
      "start": 9.645,
      "end": 10.526
    },
    {
      "id": "shot04-5",
      "text": "对预测值求导，再取负号，",
      "start": 10.526,
      "end": 12.667
    },
    {
      "id": "shot04-6",
      "text": "结果正好是真实值减预测值，",
      "start": 12.667,
      "end": 15.188
    },
    {
      "id": "shot04-7",
      "text": "也就是残差。",
      "start": 15.188,
      "end": 16.489
    },
    {
      "id": "shot04-8",
      "text": "所以在平方损失下，",
      "start": 16.489,
      "end": 18.03
    },
    {
      "id": "shot04-9",
      "text": "残差就是损失函数下降最快的方向。",
      "start": 18.03,
      "end": 20.991
    },
    {
      "id": "shot04-10",
      "text": "可一旦换成别的损失，",
      "start": 20.991,
      "end": 22.712
    },
    {
      "id": "shot04-11",
      "text": "比如分类里的对数损失，",
      "start": 22.712,
      "end": 24.713
    },
    {
      "id": "shot04-12",
      "text": "或者抗离群点的绝对损失，",
      "start": 24.713,
      "end": 26.854
    },
    {
      "id": "shot04-13",
      "text": "普通残差就不再等于最合适的修正方向。",
      "start": 26.854,
      "end": 29.696
    },
    {
      "id": "shot04-14",
      "text": "GBDT 的推广是：",
      "start": 30.169,
      "end": 31.495
    },
    {
      "id": "shot04-15",
      "text": "下一棵树不一定拟合残差，",
      "start": 31.495,
      "end": 33.624
    },
    {
      "id": "shot04-16",
      "text": "而是拟合损失函数对当前预测的负梯度。",
      "start": 33.624,
      "end": 37.099
    },
    {
      "id": "shot04-17",
      "text": "负梯度告诉模型，",
      "start": 37.099,
      "end": 38.404
    },
    {
      "id": "shot04-18",
      "text": "当前预测往哪个方向修，",
      "start": 38.404,
      "end": 40.232
    },
    {
      "id": "shot04-19",
      "text": "损失下降最快。",
      "start": 40.232,
      "end": 41.176
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "GBDT 还有两个容易忽略的细节。",
      "start": 0.0,
      "end": 2.782
    },
    {
      "id": "shot05-1",
      "text": "第一是初始化。",
      "start": 2.782,
      "end": 4.044
    },
    {
      "id": "shot05-2",
      "text": "回归平方损失下，",
      "start": 4.044,
      "end": 5.385
    },
    {
      "id": "shot05-3",
      "text": "最好的常数初始预测通常是训练集目标值的均",
      "start": 5.385,
      "end": 9.208
    },
    {
      "id": "shot05-4",
      "text": "值，",
      "start": 9.208,
      "end": 9.548
    },
    {
      "id": "shot05-5",
      "text": "因为均值能让平方误差最小。",
      "start": 9.548,
      "end": 11.79
    },
    {
      "id": "shot05-6",
      "text": "后面的树不是从零开始，",
      "start": 11.79,
      "end": 13.652
    },
    {
      "id": "shot05-7",
      "text": "而是在这个基准上不断修正。",
      "start": 13.652,
      "end": 16.114
    },
    {
      "id": "shot05-8",
      "text": "第二是 learning_rate，",
      "start": 16.114,
      "end": 17.355
    },
    {
      "id": "shot05-9",
      "text": "也叫 shrinkage。",
      "start": 17.355,
      "end": 18.396
    },
    {
      "id": "shot05-10",
      "text": "每棵树算出的修正量不会一定全额加进去，",
      "start": 18.396,
      "end": 22.019
    },
    {
      "id": "shot05-11",
      "text": "而是先乘一个小系数，",
      "start": 22.019,
      "end": 23.661
    },
    {
      "id": "shot05-12",
      "text": "比如 0.1，",
      "start": 23.661,
      "end": 24.862
    },
    {
      "id": "shot05-13",
      "text": "再加到累计预测里。",
      "start": 24.862,
      "end": 26.203
    },
    {
      "id": "shot05-14",
      "text": "学习率小，",
      "start": 26.679,
      "end": 27.641
    },
    {
      "id": "shot05-15",
      "text": "模型每一步更谨慎，",
      "start": 27.641,
      "end": 29.325
    },
    {
      "id": "shot05-16",
      "text": "通常泛化更稳，",
      "start": 29.325,
      "end": 30.788
    },
    {
      "id": "shot05-17",
      "text": "但需要更多棵树；学习率大，收敛快，",
      "start": 30.788,
      "end": 33.815
    },
    {
      "id": "shot05-18",
      "text": "但可能过冲，",
      "start": 33.815,
      "end": 34.777
    },
    {
      "id": "shot05-19",
      "text": "也可能更快拟合噪声。",
      "start": 34.777,
      "end": 36.661
    },
    {
      "id": "shot05-20",
      "text": "你可以把 GBDT 想成梯度下降的树模型",
      "start": 36.661,
      "end": 39.989
    },
    {
      "id": "shot05-21",
      "text": "版本：",
      "start": 39.989,
      "end": 40.49
    },
    {
      "id": "shot05-22",
      "text": "每棵树给一个方向，",
      "start": 40.49,
      "end": 42.134
    },
    {
      "id": "shot05-23",
      "text": "学习率控制每一步走多远。",
      "start": 42.134,
      "end": 44.118
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "把这一段收成一句话：",
      "start": 0.0,
      "end": 1.643
    },
    {
      "id": "shot06-1",
      "text": "提升树拟合残差，",
      "start": 1.643,
      "end": 3.287
    },
    {
      "id": "shot06-2",
      "text": "GBDT 拟合负梯度；",
      "start": 3.287,
      "end": 5.11
    },
    {
      "id": "shot06-3",
      "text": "在平方损失下，",
      "start": 5.11,
      "end": 6.312
    },
    {
      "id": "shot06-4",
      "text": "两者刚好是同一件事。",
      "start": 6.312,
      "end": 8.216
    },
    {
      "id": "shot06-5",
      "text": "AdaBoost 用样本权重告诉下一轮哪",
      "start": 8.216,
      "end": 11.102
    },
    {
      "id": "shot06-6",
      "text": "里更重要，",
      "start": 11.102,
      "end": 12.024
    },
    {
      "id": "shot06-7",
      "text": "GBDT 用负梯度告诉下一轮往哪修、",
      "start": 12.024,
      "end": 15.109
    },
    {
      "id": "shot06-8",
      "text": "修多少。",
      "start": 15.109,
      "end": 16.172
    },
    {
      "id": "shot06-9",
      "text": "这个变化非常关键，",
      "start": 16.172,
      "end": 17.755
    },
    {
      "id": "shot06-10",
      "text": "因为它让 boosting 不只适合二分",
      "start": 17.755,
      "end": 19.879
    },
    {
      "id": "shot06-11",
      "text": "类，",
      "start": 19.879,
      "end": 20.36
    },
    {
      "id": "shot06-12",
      "text": "也能支持回归、",
      "start": 20.36,
      "end": 21.622
    },
    {
      "id": "shot06-13",
      "text": "分类和其他可微损失。",
      "start": 21.622,
      "end": 23.285
    },
    {
      "id": "shot06-14",
      "text": "后面用 sklearn 的",
      "start": 23.93,
      "end": 25.332
    },
    {
      "id": "shot06-15",
      "text": "GradientBoostingClassifier",
      "start": 25.332,
      "end": 27.014
    },
    {
      "id": "shot06-16",
      "text": "时，",
      "start": 27.014,
      "end": 27.455
    },
    {
      "id": "shot06-17",
      "text": "我们不需要手写负梯度，",
      "start": 27.455,
      "end": 29.458
    },
    {
      "id": "shot06-18",
      "text": "库会根据损失函数自动算。",
      "start": 29.458,
      "end": 32.001
    },
    {
      "id": "shot06-19",
      "text": "真正要理解的是框架：",
      "start": 32.001,
      "end": 33.924
    },
    {
      "id": "shot06-20",
      "text": "先有初始预测，",
      "start": 33.924,
      "end": 35.146
    },
    {
      "id": "shot06-21",
      "text": "再一轮一轮算当前模型的修正方向，",
      "start": 35.146,
      "end": 38.19
    },
    {
      "id": "shot06-22",
      "text": "用一棵回归树拟合这个方向，",
      "start": 38.19,
      "end": 40.473
    },
    {
      "id": "shot06-23",
      "text": "最后把所有树的修正量累加起来。",
      "start": 40.473,
      "end": 43.137
    },
    {
      "id": "shot06-24",
      "text": "下一期我们把这套机制放进具体数字里，",
      "start": 43.137,
      "end": 46.311
    },
    {
      "id": "shot06-25",
      "text": "手算 GBDT 怎样从均值一步步靠近真实",
      "start": 46.311,
