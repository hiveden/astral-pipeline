{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们说逻辑回归先算出线性分数 z，",
      "start": 0.0,
      "end": 3.783
    },
    {
      "id": "shot01-1",
      "text": "再用 sigmoid 把它压成 0 到",
      "start": 3.783,
      "end": 6.145
    },
    {
      "id": "shot01-2",
      "text": "1 之间的概率。",
      "start": 6.145,
      "end": 7.326
    },
    {
      "id": "shot01-3",
      "text": "那问题来了：",
      "start": 7.326,
      "end": 8.367
    },
    {
      "id": "shot01-4",
      "text": "概率到底在说什么？",
      "start": 8.367,
      "end": 10.148
    },
    {
      "id": "shot01-5",
      "text": "如果模型说某封邮件 91% 是垃圾邮件，",
      "start": 10.148,
      "end": 14.532
    },
    {
      "id": "shot01-6",
      "text": "这不是一句玄学信心，",
      "start": 14.532,
      "end": 16.533
    },
    {
      "id": "shot01-7",
      "text": "而是在概率校准良好时，可以读成：",
      "start": 16.533,
      "end": 19.716
    },
    {
      "id": "shot01-8",
      "text": "相同规则和相似样本下，",
      "start": 19.716,
      "end": 22.117
    },
    {
      "id": "shot01-9",
      "text": "这类事件发生的比例大约是 91%。",
      "start": 22.117,
      "end": 25.54
    },
    {
      "id": "shot01-10",
      "text": "实际模型概率还要用验证集检查校准。",
      "start": 25.54,
      "end": 29.305
    },
    {
      "id": "shot01-11",
      "text": "这一期不急着推逻辑回归的损失函数，",
      "start": 29.305,
      "end": 32.247
    },
    {
      "id": "shot01-12",
      "text": "先把概率语言补齐。",
      "start": 32.247,
      "end": 33.738
    },
    {
      "id": "shot01-13",
      "text": "我们解决三件事：",
      "start": 34.332,
      "end": 35.735
    },
    {
      "id": "shot01-14",
      "text": "单个事件的概率怎么读；",
      "start": 35.735,
      "end": 37.68
    },
    {
      "id": "shot01-15",
      "text": "两个事件一起发生叫联合概率；",
      "start": 37.68,
      "end": 40.506
    },
    {
      "id": "shot01-16",
      "text": "已经知道一个条件后再问另一个事件叫条件概",
      "start": 40.506,
      "end": 44.014
    },
    {
      "id": "shot01-17",
      "text": "率。",
      "start": 44.014,
      "end": 44.455
    },
    {
      "id": "shot01-18",
      "text": "下一期 MLE 会直接用这些语言来估参数。",
      "start": 44.455,
      "end": 47.683
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先用一副扑克牌做最小例子。",
      "start": 0.0,
      "end": 2.404
    },
    {
      "id": "shot02-1",
      "text": "一副牌 52 张，",
      "start": 2.404,
      "end": 3.826
    },
    {
      "id": "shot02-2",
      "text": "红色牌 26 张，",
      "start": 3.826,
      "end": 5.449
    },
    {
      "id": "shot02-3",
      "text": "所以抽到红色牌的概率是 26 除以 52，",
      "start": 5.449,
      "end": 9.135
    },
    {
      "id": "shot02-4",
      "text": "等于 0.5。",
      "start": 9.135,
      "end": 10.357
    },
    {
      "id": "shot02-5",
      "text": "K 有 4 张，",
      "start": 10.357,
      "end": 11.479
    },
    {
      "id": "shot02-6",
      "text": "所以抽到 K 的概率是 4 除以 52，",
      "start": 11.479,
      "end": 14.404
    },
    {
      "id": "shot02-7",
      "text": "等于 1/13。",
      "start": 14.404,
      "end": 15.947
    },
    {
      "id": "shot02-8",
      "text": "两个条件一起满足，",
      "start": 15.947,
      "end": 17.549
    },
    {
      "id": "shot02-9",
      "text": "比如抽到红色 K，",
      "start": 17.549,
      "end": 19.092
    },
    {
      "id": "shot02-10",
      "text": "这叫联合概率：既要红色，又要 K。",
      "start": 19.092,
      "end": 22.037
    },
    {
      "id": "shot02-11",
      "text": "一副牌里红色 K 只有 2 张，",
      "start": 22.037,
      "end": 24.501
    },
    {
      "id": "shot02-12",
      "text": "所以概率是 2 除以 52。",
      "start": 24.501,
      "end": 26.344
    },
    {
      "id": "shot02-13",
      "text": "再看条件概率：",
      "start": 27.067,
      "end": 28.39
    },
    {
      "id": "shot02-14",
      "text": "如果已经知道这张牌是红色，",
      "start": 28.39,
      "end": 30.534
    },
    {
      "id": "shot02-15",
      "text": "问它是 K 的概率，",
      "start": 30.534,
      "end": 31.957
    },
    {
      "id": "shot02-16",
      "text": "就是 2 除以 26，",
      "start": 31.957,
      "end": 33.441
    },
    {
      "id": "shot02-17",
      "text": "仍然是 1/13；",
      "start": 33.441,
      "end": 34.763
    },
    {
      "id": "shot02-18",
      "text": "如果已经知道它是 K，",
      "start": 34.763,
      "end": 36.287
    },
    {
      "id": "shot02-19",
      "text": "问它是红色的概率，",
      "start": 36.287,
      "end": 37.81
    },
    {
      "id": "shot02-20",
      "text": "就是 2 除以 4，",
      "start": 37.81,
      "end": 39.093
    },
    {
      "id": "shot02-21",
      "text": "等于 0.5。",
      "start": 39.093,
      "end": 40.355
    },
    {
      "id": "shot02-22",
      "text": "联合概率问的是一起发生；",
      "start": 40.355,
      "end": 42.841
    },
    {
      "id": "shot02-23",
      "text": "条件概率问的是在某个事实已经成立之后，",
      "start": 42.841,
      "end": 46.208
    },
    {
      "id": "shot02-24",
      "text": "另一个事实的概率。",
      "start": 46.208,
      "end": 47.37
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "概率里最容易出错的是独立性。",
      "start": 0.0,
      "end": 2.361
    },
    {
      "id": "shot03-1",
      "text": "还是扑克牌，问：",
      "start": 2.361,
      "end": 3.622
    },
    {
      "id": "shot03-2",
      "text": "连续抽两张，",
      "start": 3.622,
      "end": 4.723
    },
    {
      "id": "shot03-3",
      "text": "都是 A 的概率是多少？",
      "start": 4.723,
      "end": 6.284
    },
    {
      "id": "shot03-4",
      "text": "如果每次抽完都放回，",
      "start": 6.284,
      "end": 7.985
    },
    {
      "id": "shot03-5",
      "text": "第二次抽牌面对的还是完整 52 张牌，",
      "start": 7.985,
      "end": 11.327
    },
    {
      "id": "shot03-6",
      "text": "第一次结果不会改变第二次概率。",
      "start": 11.327,
      "end": 14.108
    },
    {
      "id": "shot03-7",
      "text": "这时两次抽样独立，",
      "start": 14.108,
      "end": 15.829
    },
    {
      "id": "shot03-8",
      "text": "概率是 4/52 乘以 4/52，",
      "start": 15.829,
      "end": 18.431
    },
    {
      "id": "shot03-9",
      "text": "约等于 0.5917%。",
      "start": 18.431,
      "end": 20.852
    },
    {
      "id": "shot03-10",
      "text": "如果第一次抽完不放回，",
      "start": 20.852,
      "end": 22.794
    },
    {
      "id": "shot03-11",
      "text": "情况就变了。",
      "start": 22.794,
      "end": 23.954
    },
    {
      "id": "shot03-12",
      "text": "第一张抽到 A 之后，",
      "start": 23.954,
      "end": 25.455
    },
    {
      "id": "shot03-13",
      "text": "牌堆只剩 51 张，",
      "start": 25.455,
      "end": 27.196
    },
    {
      "id": "shot03-14",
      "text": "A 只剩 3 张，",
      "start": 27.196,
      "end": 28.518
    },
    {
      "id": "shot03-15",
      "text": "第二次抽到 A 的概率变成 3/51。",
      "start": 28.518,
      "end": 31.148
    },
    {
      "id": "shot03-16",
      "text": "所以不放回时概率是 4/52 乘以 3/",
      "start": 31.576,
      "end": 34.606
    },
    {
      "id": "shot03-17",
      "text": "51，",
      "start": 34.606,
      "end": 35.489
    },
    {
      "id": "shot03-18",
      "text": "约等于 0.4525%。",
      "start": 35.489,
      "end": 37.877
    },
    {
      "id": "shot03-19",
      "text": "差别不来自公式花哨，",
      "start": 37.877,
      "end": 39.844
    },
    {
      "id": "shot03-20",
      "text": "而是来自一个朴素事实：",
      "start": 39.844,
      "end": 41.911
    },
    {
      "id": "shot03-21",
      "text": "第二次抽样环境已经被第一次改变了。",
      "start": 41.911,
      "end": 44.46
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开纸牌 demo。",
      "start": 0.0,
      "end": 1.261
    },
    {
      "id": "shot04-1",
      "text": "屏幕左侧可以调试验次数 N 和抽牌方式，",
      "start": 1.261,
      "end": 4.584
    },
    {
      "id": "shot04-2",
      "text": "右侧曲线显示累计频率怎么逼近理论概率。",
      "start": 4.584,
      "end": 8.188
    },
    {
      "id": "shot04-3",
      "text": "先看放回抽样，",
      "start": 8.188,
      "end": 9.709
    },
    {
      "id": "shot04-4",
      "text": "N 设到 10000。",
      "start": 9.709,
      "end": 10.77
    },
    {
      "id": "shot04-5",
      "text": "蓝色曲线一开始会抖，",
      "start": 10.77,
      "end": 12.472
    },
    {
      "id": "shot04-6",
      "text": "试验次数越多越贴近绿色理论线，",
      "start": 12.472,
      "end": 15.174
    },
    {
      "id": "shot04-7",
      "text": "理论值大约是 0.5917%。",
      "start": 15.174,
      "end": 18.257
    },
    {
      "id": "shot04-8",
      "text": "再切到不放回抽样，",
      "start": 18.257,
      "end": 19.781
    },
    {
      "id": "shot04-9",
      "text": "曲线收敛到另一条更低的理论线，",
      "start": 19.781,
      "end": 22.168
    },
    {
      "id": "shot04-10",
      "text": "大约是 0.4525%。",
      "start": 22.168,
      "end": 24.214
    },
    {
      "id": "shot04-11",
      "text": "这不是随机误差，",
      "start": 24.214,
      "end": 25.457
    },
    {
      "id": "shot04-12",
      "text": "而是规则改变了：",
      "start": 25.457,
      "end": 26.861
    },
    {
      "id": "shot04-13",
      "text": "放回时第二次还是 4 张 A 里抽，",
      "start": 26.861,
      "end": 29.368
    },
    {
      "id": "shot04-14",
      "text": "不放回时第二次只剩 3 张 A。",
      "start": 29.368,
      "end": 31.333
    },
    {
      "id": "shot04-15",
      "text": "最后切到理论值对比图，",
      "start": 31.886,
      "end": 34.032
    },
    {
      "id": "shot04-16",
      "text": "两根柱子直接并排，",
      "start": 34.032,
      "end": 35.917
    },
    {
      "id": "shot04-17",
      "text": "放回概率比不放回高大约 30.8%。",
      "start": 35.917,
      "end": 39.286
    },
    {
      "id": "shot04-18",
      "text": "这个 demo 想强调的不是扑克牌本身，",
      "start": 39.286,
      "end": 42.093
    },
    {
      "id": "shot04-19",
      "text": "而是概率计算前必须先问清楚：",
      "start": 42.093,
      "end": 44.64
    },
    {
      "id": "shot04-20",
      "text": "事件之间到底独立不独立。",
      "start": 44.64,
      "end": 46.364
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "现在把扑克牌收回来，",
      "start": 0.0,
      "end": 1.801
    },
    {
      "id": "shot05-1",
      "text": "连接到逻辑回归。",
      "start": 1.801,
      "end": 3.202
    },
    {
      "id": "shot05-2",
      "text": "LR 对每个样本输出一个概率：",
      "start": 3.202,
      "end": 5.963
    },
    {
      "id": "shot05-3",
      "text": "这个客户流失的概率，",
      "start": 5.963,
      "end": 7.664
    },
    {
      "id": "shot05-4",
      "text": "这封邮件是垃圾邮件的概率，",
      "start": 7.664,
      "end": 9.965
    },
    {
      "id": "shot05-5",
      "text": "这个病人是阳性的概率。",
      "start": 9.965,
      "end": 12.127
    },
    {
      "id": "shot05-6",
      "text": "单个样本只需要读一个概率，",
      "start": 12.127,
      "end": 14.568
    },
    {
      "id": "shot05-7",
      "text": "但训练模型时，",
      "start": 14.568,
      "end": 15.949
    },
    {
      "id": "shot05-8",
      "text": "我们手里有很多已经发生的样本和标签。",
      "start": 15.949,
      "end": 19.311
    },
    {
      "id": "shot05-9",
      "text": "一个自然想法是：",
      "start": 19.311,
      "end": 20.631
    },
    {
      "id": "shot05-10",
      "text": "如果参数选得好，",
      "start": 20.631,
      "end": 22.112
    },
    {
      "id": "shot05-11",
      "text": "已经看到的这些标签应该整体都比较可能发生。",
      "start": 22.112,
      "end": 26.09
    },
    {
      "id": "shot05-12",
      "text": "整体可能性怎么写？",
      "start": 26.09,
      "end": 27.898
    },
    {
      "id": "shot05-13",
      "text": "在独立样本的假设下，",
      "start": 27.898,
      "end": 29.726
    },
    {
      "id": "shot05-14",
      "text": "可以把每个样本对应的概率乘起来。",
      "start": 29.726,
      "end": 32.318
    },
    {
      "id": "shot05-15",
      "text": "这个连乘形式就是下一期 MLE 的入口：",
      "start": 32.826,
      "end": 36.075
    },
    {
      "id": "shot05-16",
      "text": "什么样的参数，",
      "start": 36.075,
      "end": 37.198
    },
    {
      "id": "shot05-17",
      "text": "能让已经观测到的数据最可能出现。到这里，",
      "start": 37.198,
      "end": 40.387
    },
    {
      "id": "shot05-18",
      "text": "本期只需要记住一句话：",
      "start": 40.387,
      "end": 42.172
    },
    {
      "id": "shot05-19",
      "text": "概率不只用于输出结果，",
      "start": 42.172,
      "end": 44.137
    },
    {
      "id": "shot05-20",
      "text": "也能反过来评价一组参数是否解释得通数据。",
      "start": 44.137,
      "end": 47.446
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.921
    },
    {
      "id": "shot06-1",
      "text": "我们补齐了概率语言的三块地基：第一，",
      "start": 0.921,
      "end": 4.045
    },
    {
      "id": "shot06-2",
      "text": "概率是事件发生可能性的数；第二，",
      "start": 4.045,
      "end": 6.728
    },
    {
      "id": "shot06-3",
      "text": "联合概率问两个事件一起发生，",
      "start": 6.728,
      "end": 9.191
    },
    {
      "id": "shot06-4",
      "text": "条件概率问在一个事实已经成立之后另一个事",
      "start": 9.191,
      "end": 12.495
    },
    {
      "id": "shot06-5",
      "text": "件的概率；第三，",
      "start": 12.495,
      "end": 14.237
    },
    {
      "id": "shot06-6",
      "text": "独立性不能靠感觉猜，",
      "start": 14.237,
      "end": 15.959
    },
    {
      "id": "shot06-7",
      "text": "要看一次事件会不会改变下一次事件的环境。",
      "start": 15.959,
      "end": 19.403
    },
    {
      "id": "shot06-8",
      "text": "点到但没展开的内容有两件：",
      "start": 19.403,
      "end": 21.646
    },
    {
      "id": "shot06-9",
      "text": "贝叶斯公式留给后面的朴素贝叶斯；",
      "start": 21.646,
      "end": 24.309
    },
    {
      "id": "shot06-10",
      "text": "概率连乘如何变成可训练的目标，",
      "start": 24.309,
      "end": 26.792
    },
    {
      "id": "shot06-11",
      "text": "留给下一期。",
      "start": 26.792,
      "end": 27.493
    },
    {
      "id": "shot06-12",
      "text": "下一期我们用一枚不均匀硬币进入极大似然估",
      "start": 27.997,
      "end": 31.633
    },
    {
      "id": "shot06-13",
      "text": "计，",
      "start": 31.633,
      "end": 31.954
    },
    {
      "id": "shot06-14",
      "text": "看看为什么观测到 4 次正面 2 次反面",
      "start": 31.954,
      "end": 35.289
    },
    {
      "id": "shot06-15",
      "text": "时，",
      "start": 35.289,
      "end": 35.731
    },
    {
      "id": "shot06-16",
      "text": "最合理的正面概率是 4/6。",
      "start": 35.731,
      "end": 37.86
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.713
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.713,
      "end": 2.037
    }
  ]
}
