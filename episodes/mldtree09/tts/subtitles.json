{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们手算了回归树。",
      "start": 0.0,
      "end": 2.161
    },
    {
      "id": "shot01-1",
      "text": "现在看它和线性回归放在同一组数据上，",
      "start": 2.161,
      "end": 5.342
    },
    {
      "id": "shot01-2",
      "text": "会画出什么形状。",
      "start": 5.342,
      "end": 6.723
    },
    {
      "id": "shot01-3",
      "text": "线性回归只能画一条直线，",
      "start": 6.723,
      "end": 8.884
    },
    {
      "id": "shot01-4",
      "text": "适合整体趋势接近直线的任务。",
      "start": 8.884,
      "end": 11.545
    },
    {
      "id": "shot01-5",
      "text": "回归树画的是一串阶梯，",
      "start": 11.545,
      "end": 13.686
    },
    {
      "id": "shot01-6",
      "text": "每片叶子输出一个均值，",
      "start": 13.686,
      "end": 15.906
    },
    {
      "id": "shot01-7",
      "text": "适合分段跳变的任务。",
      "start": 15.906,
      "end": 18.127
    },
    {
      "id": "shot01-8",
      "text": "比如房屋面积到某个区间以后价格突然上一个",
      "start": 18.127,
      "end": 21.789
    },
    {
      "id": "shot01-9",
      "text": "台阶，",
      "start": 21.789,
      "end": 22.429
    },
    {
      "id": "shot01-10",
      "text": "线性回归会斜着穿过去，",
      "start": 22.429,
      "end": 24.61
    },
    {
      "id": "shot01-11",
      "text": "回归树可以直接用一刀切出两个价格段。",
      "start": 24.61,
      "end": 27.883
    },
    {
      "id": "shot01-12",
      "text": "这期要解决的不是哪个模型永远更好，",
      "start": 27.883,
      "end": 31.116
    },
    {
      "id": "shot01-13",
      "text": "而是看数据形状。",
      "start": 31.116,
      "end": 32.802
    },
    {
      "id": "shot01-14",
      "text": "关系平滑时直线省事，",
      "start": 32.802,
      "end": 35.111
    },
    {
      "id": "shot01-15",
      "text": "关系分段时阶梯更贴合。",
      "start": 35.111,
      "end": 37.26
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "sklearn 里，",
      "start": 0.0,
      "end": 0.842
    },
    {
      "id": "shot02-1",
      "text": "回归树用",
      "start": 0.842,
      "end": 1.563
    },
    {
      "id": "shot02-2",
      "text": "DecisionTreeRegressor。",
      "start": 1.563,
      "end": 3.366
    },
    {
      "id": "shot02-3",
      "text": "它和分类树的参数很像，",
      "start": 3.366,
      "end": 5.309
    },
    {
      "id": "shot02-4",
      "text": "也有 max_depth、",
      "start": 5.309,
      "end": 6.11
    },
    {
      "id": "shot02-5",
      "text": "min_samples_split、",
      "start": 6.11,
      "end": 7.893
    },
    {
      "id": "shot02-6",
      "text": "min_samples_leaf、",
      "start": 7.893,
      "end": 9.075
    },
    {
      "id": "shot02-7",
      "text": "random_state。",
      "start": 9.075,
      "end": 9.997
    },
    {
      "id": "shot02-8",
      "text": "不同的是 criterion 不再选",
      "start": 9.997,
      "end": 11.86
    },
    {
      "id": "shot02-9",
      "text": "gini 或 entropy，",
      "start": 11.86,
      "end": 13.021
    },
    {
      "id": "shot02-10",
      "text": "而是选回归损失，",
      "start": 13.021,
      "end": 14.484
    },
    {
      "id": "shot02-11",
      "text": "比如 squared_error。",
      "start": 14.484,
      "end": 16.127
    },
    {
      "id": "shot02-12",
      "text": "默认思路就是上一期讲的平方误差最小化。",
      "start": 16.127,
      "end": 19.152
    },
    {
      "id": "shot02-13",
      "text": "fit 的输入仍然是 X 和 y，",
      "start": 19.804,
      "end": 22.409
    },
    {
      "id": "shot02-14",
      "text": "predict 输出的不是类别 0 或",
      "start": 22.409,
      "end": 24.654
    },
    {
      "id": "shot02-15",
      "text": "1，",
      "start": 24.654,
      "end": 25.075
    },
    {
      "id": "shot02-16",
      "text": "而是连续数值预测。",
      "start": 25.075,
      "end": 26.819
    },
    {
      "id": "shot02-17",
      "text": "如果从分类树切过来，",
      "start": 26.819,
      "end": 28.682
    },
    {
      "id": "shot02-18",
      "text": "最需要换脑子的就是 predict 的含",
      "start": 28.682,
      "end": 31.168
    },
    {
      "id": "shot02-19",
      "text": "义。",
      "start": 31.168,
      "end": 31.829
    },
    {
      "id": "shot02-20",
      "text": "分类输出类别标签，",
      "start": 31.829,
      "end": 33.673
    },
    {
      "id": "shot02-21",
      "text": "回归输出叶子里的平均数。",
      "start": 33.673,
      "end": 35.456
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "代码里可以同时训练 3 个模型。",
      "start": 0.0,
      "end": 2.642
    },
    {
      "id": "shot03-1",
      "text": "第一个是线性回归，",
      "start": 2.642,
      "end": 4.224
    },
    {
      "id": "shot03-2",
      "text": "它输出一条平滑直线。",
      "start": 4.224,
      "end": 6.065
    },
    {
      "id": "shot03-3",
      "text": "第二个是浅层回归树，",
      "start": 6.065,
      "end": 7.847
    },
    {
      "id": "shot03-4",
      "text": "比如 max_depth 等于 1 或",
      "start": 7.847,
      "end": 9.728
    },
    {
      "id": "shot03-5",
      "text": "2，",
      "start": 9.728,
      "end": 10.009
    },
    {
      "id": "shot03-6",
      "text": "它只能切一两刀，",
      "start": 10.009,
      "end": 11.37
    },
    {
      "id": "shot03-7",
      "text": "所以阶梯很少，",
      "start": 11.37,
      "end": 12.571
    },
    {
      "id": "shot03-8",
      "text": "容易欠拟合，",
      "start": 12.571,
      "end": 13.652
    },
    {
      "id": "shot03-9",
      "text": "但稳定。",
      "start": 13.652,
      "end": 14.813
    },
    {
      "id": "shot03-10",
      "text": "第三个是深层回归树，",
      "start": 14.813,
      "end": 16.674
    },
    {
      "id": "shot03-11",
      "text": "如果不加限制，",
      "start": 16.674,
      "end": 17.755
    },
    {
      "id": "shot03-12",
      "text": "它可以切到每个叶子只剩很少样本，",
      "start": 17.755,
      "end": 20.438
    },
    {
      "id": "shot03-13",
      "text": "训练集上几乎贴着每个点走。",
      "start": 20.438,
      "end": 22.88
    },
    {
      "id": "shot03-14",
      "text": "这看起来很准，",
      "start": 22.88,
      "end": 24.081
    },
    {
      "id": "shot03-15",
      "text": "但新数据一来就容易崩。",
      "start": 24.081,
      "end": 25.962
    },
    {
      "id": "shot03-16",
      "text": "回归树的弹性很强，",
      "start": 25.962,
      "end": 27.664
    },
    {
      "id": "shot03-17",
      "text": "强到必须加刹车。",
      "start": 27.664,
      "end": 28.825
    },
    {
      "id": "shot03-18",
      "text": "录屏时可以让三条曲线同时出现：",
      "start": 29.24,
      "end": 32.024
    },
    {
      "id": "shot03-19",
      "text": "直线负责给基线，",
      "start": 32.024,
      "end": 33.626
    },
    {
      "id": "shot03-20",
      "text": "浅树负责给可解释台阶，",
      "start": 33.626,
      "end": 35.91
    },
    {
      "id": "shot03-21",
      "text": "深树负责展示过拟合风险。",
      "start": 35.91,
      "end": 38.414
    },
    {
      "id": "shot03-22",
      "text": "录屏时要把训练曲线和测试表现一起看，",
      "start": 38.414,
      "end": 41.618
    },
    {
      "id": "shot03-23",
      "text": "避免观众只被深树在训练点上的贴合程度吸引。",
      "start": 41.618,
      "end": 45.484
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "什么时候回归树比直线更合适？",
      "start": 0.0,
      "end": 2.503
    },
    {
      "id": "shot04-1",
      "text": "关键看业务是不是分段。",
      "start": 2.503,
      "end": 4.346
    },
    {
      "id": "shot04-2",
      "text": "电费按阶梯计价，",
      "start": 4.346,
      "end": 5.968
    },
    {
      "id": "shot04-3",
      "text": "超过某个用电量后单价跳变；",
      "start": 5.968,
      "end": 8.211
    },
    {
      "id": "shot04-4",
      "text": "房租可能过一条街就换一个价格带；",
      "start": 8.211,
      "end": 10.794
    },
    {
      "id": "shot04-5",
      "text": "用户消费金额也可能按等级出现台阶。",
      "start": 10.794,
      "end": 14.299
    },
    {
      "id": "shot04-6",
      "text": "这些场景里，",
      "start": 14.299,
      "end": 15.2
    },
    {
      "id": "shot04-7",
      "text": "一条直线会把跳变抹平，",
      "start": 15.2,
      "end": 17.323
    },
    {
      "id": "shot04-8",
      "text": "而回归树的阶梯正好能表达“这个区间一个均",
      "start": 17.323,
      "end": 20.591
    },
    {
      "id": "shot04-9",
      "text": "值，",
      "start": 20.591,
      "end": 20.812
    },
    {
      "id": "shot04-10",
      "text": "那个区间另一个均值”。",
      "start": 20.812,
      "end": 22.355
    },
    {
      "id": "shot04-11",
      "text": "但如果真实关系本来就是平滑线性，",
      "start": 22.355,
      "end": 25.403
    },
    {
      "id": "shot04-12",
      "text": "回归树反而可能切出多余台阶。",
      "start": 25.403,
      "end": 28.23
    },
    {
      "id": "shot04-13",
      "text": "因此选择回归树前，",
      "start": 28.23,
      "end": 29.914
    },
    {
      "id": "shot04-14",
      "text": "先问业务有没有明显阈值。",
      "start": 29.914,
      "end": 31.678
    },
    {
      "id": "shot04-15",
      "text": "只要规则天然分段，",
      "start": 32.286,
      "end": 34.161
    },
    {
      "id": "shot04-16",
      "text": "树就容易讲清；",
      "start": 34.161,
      "end": 35.334
    },
    {
      "id": "shot04-17",
      "text": "如果没有阈值，",
      "start": 35.334,
      "end": 36.477
    },
    {
      "id": "shot04-18",
      "text": "线性或平滑模型可能更稳。",
      "start": 36.477,
      "end": 38.833
    },
    {
      "id": "shot04-19",
      "text": "录屏时要把训练曲线和测试表现一起看，",
      "start": 38.833,
      "end": 42.052
    },
    {
      "id": "shot04-20",
      "text": "避免观众只被深树在训练点上的贴合程度吸引。",
      "start": 42.052,
      "end": 45.761
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "回归树最常用的刹车仍然是三把。",
      "start": 0.0,
      "end": 3.044
    },
    {
      "id": "shot05-1",
      "text": "max_depth 限制树最多长几层，",
      "start": 3.044,
      "end": 5.707
    },
    {
      "id": "shot05-2",
      "text": "直接控制模型复杂度。",
      "start": 5.707,
      "end": 7.589
    },
    {
      "id": "shot05-3",
      "text": "min_samples_split 限制",
      "start": 7.589,
      "end": 9.411
    },
    {
      "id": "shot05-4",
      "text": "一个节点至少有多少样本才允许继续切。",
      "start": 9.411,
      "end": 12.936
    },
    {
      "id": "shot05-5",
      "text": "min_samples_leaf 限制每",
      "start": 12.936,
      "end": 14.758
    },
    {
      "id": "shot05-6",
      "text": "片叶子至少留下多少样本，",
      "start": 14.758,
      "end": 17.06
    },
    {
      "id": "shot05-7",
      "text": "防止叶子只记住一两个点。",
      "start": 17.06,
      "end": 19.664
    },
    {
      "id": "shot05-8",
      "text": "三个参数里，",
      "start": 19.664,
      "end": 20.565
    },
    {
      "id": "shot05-9",
      "text": "min_samples_leaf 很直观：",
      "start": 20.565,
      "end": 22.767
    },
    {
      "id": "shot05-10",
      "text": "每个预测均值至少要由一小群样本支撑，",
      "start": 22.767,
      "end": 26.512
    },
    {
      "id": "shot05-11",
      "text": "而不是由单个样本决定。",
      "start": 26.512,
      "end": 28.074
    },
    {
      "id": "shot05-12",
      "text": "调回归树时，",
      "start": 28.649,
      "end": 29.833
    },
    {
      "id": "shot05-13",
      "text": "别只追训练误差，",
      "start": 29.833,
      "end": 31.377
    },
    {
      "id": "shot05-14",
      "text": "要看测试集或交叉验证表现。",
      "start": 31.377,
      "end": 33.845
    },
    {
      "id": "shot05-15",
      "text": "三个参数经常一起用。",
      "start": 33.845,
      "end": 35.731
    },
    {
      "id": "shot05-16",
      "text": "只限制深度可能仍有很小叶子，",
      "start": 35.731,
      "end": 38.559
    },
    {
      "id": "shot05-17",
      "text": "只限制叶子样本数又可能树很深，",
      "start": 38.559,
      "end": 41.348
    },
    {
      "id": "shot05-18",
      "text": "组合起来才更稳。",
      "start": 41.348,
      "end": 42.632
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期我们把回归树落到 sklearn。",
      "start": 0.0,
      "end": 2.582
    },
    {
      "id": "shot06-1",
      "text": "线性回归画直线，",
      "start": 2.582,
      "end": 4.204
    },
    {
      "id": "shot06-2",
      "text": "回归树画阶梯；",
      "start": 4.204,
      "end": 5.525
    },
    {
      "id": "shot06-3",
      "text": "浅树稳定但可能欠拟合，",
      "start": 5.525,
      "end": 7.647
    },
    {
      "id": "shot06-4",
      "text": "深树灵活但容易过拟合。参数上，",
      "start": 7.647,
      "end": 10.65
    },
    {
      "id": "shot06-5",
      "text": "max_depth、",
      "start": 10.65,
      "end": 11.33
    },
    {
      "id": "shot06-6",
      "text": "min_samples_split、",
      "start": 11.33,
      "end": 12.512
    },
    {
      "id": "shot06-7",
      "text": "min_samples_leaf 都是在",
      "start": 12.512,
      "end": 14.013
    },
    {
      "id": "shot06-8",
      "text": "给树踩刹车。",
      "start": 14.013,
      "end": 15.494
    },
    {
      "id": "shot06-9",
      "text": "到这里你应该已经反复听到过拟合这个词了。",
      "start": 15.494,
      "end": 18.937
    },
    {
      "id": "shot06-10",
      "text": "下一期我们正式讲决策树的正则化手段：",
      "start": 18.937,
      "end": 22.005
    },
    {
      "id": "shot06-11",
      "text": "剪枝。",
      "start": 22.005,
      "end": 22.381
    },
    {
      "id": "shot06-12",
      "text": "这条线和分类树完全一致：树越深，",
      "start": 22.997,
      "end": 25.841
    },
    {
      "id": "shot06-13",
      "text": "表达能力越强；",
      "start": 25.841,
      "end": 27.062
    },
    {
      "id": "shot06-14",
      "text": "表达能力太强，",
      "start": 27.062,
      "end": 28.264
    },
    {
      "id": "shot06-15",
      "text": "就需要剪枝或预剪枝把复杂度压回来。",
      "start": 28.264,
      "end": 31.708
    },
    {
      "id": "shot06-16",
      "text": "录屏时要把训练曲线和测试表现一起看，",
      "start": 31.708,
      "end": 34.933
    },
    {
      "id": "shot06-17",
      "text": "避免观众只被深树在训练点上的贴合程度吸引。",
      "start": 34.933,
      "end": 39.379
    },
    {
      "id": "shot06-18",
      "text": "真正上线前，",
      "start": 39.379,
      "end": 40.58
    },
    {
      "id": "shot06-19",
      "text": "还要用交叉验证确认这些刹车参数，",
      "start": 40.58,
      "end": 43.804
    },
    {
      "id": "shot06-20",
      "text": "而不是只看某一次划分的测试分数。",
      "start": 43.804,
      "end": 46.548
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.652
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.652,
      "end": 1.955
    }
  ]
}
