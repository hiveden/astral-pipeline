{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们讲 bagging：",
      "start": 0.0,
      "end": 1.402
    },
    {
      "id": "shot01-1",
      "text": "让每棵树看不同的数据子集，",
      "start": 1.402,
      "end": 3.746
    },
    {
      "id": "shot01-2",
      "text": "最后平权投票。随机森林，",
      "start": 3.746,
      "end": 6.33
    },
    {
      "id": "shot01-3",
      "text": "英文 Random Forest，",
      "start": 6.33,
      "end": 8.253
    },
    {
      "id": "shot01-4",
      "text": "就是 bagging 思想最经典的落地版",
      "start": 8.253,
      "end": 10.696
    },
    {
      "id": "shot01-5",
      "text": "本。",
      "start": 10.696,
      "end": 10.997
    },
    {
      "id": "shot01-6",
      "text": "但它比普通 bagging 多加了一层限",
      "start": 10.997,
      "end": 13.34
    },
    {
      "id": "shot01-7",
      "text": "制。",
      "start": 13.34,
      "end": 13.921
    },
    {
      "id": "shot01-8",
      "text": "还是医生会诊的类比：",
      "start": 13.921,
      "end": 15.998
    },
    {
      "id": "shot01-9",
      "text": "5 位医生看的病例库不同，",
      "start": 15.998,
      "end": 18.228
    },
    {
      "id": "shot01-10",
      "text": "这已经能制造差异；",
      "start": 18.228,
      "end": 19.81
    },
    {
      "id": "shot01-11",
      "text": "但如果所有医生都最先盯同一个指标，",
      "start": 19.81,
      "end": 22.915
    },
    {
      "id": "shot01-12",
      "text": "比如一个特别强的肿瘤标志物，",
      "start": 22.915,
      "end": 25.279
    },
    {
      "id": "shot01-13",
      "text": "他们的判断路径还是会很像。",
      "start": 25.279,
      "end": 27.102
    },
    {
      "id": "shot01-14",
      "text": "随机森林会再规定一件事：",
      "start": 27.633,
      "end": 29.296
    },
    {
      "id": "shot01-15",
      "text": "每位医生每做一道判断时，",
      "start": 29.296,
      "end": 31.419
    },
    {
      "id": "shot01-16",
      "text": "只能从一小部分检查指标里挑。",
      "start": 31.419,
      "end": 33.882
    },
    {
      "id": "shot01-17",
      "text": "这样有人先看年龄和血常规，",
      "start": 33.882,
      "end": 35.945
    },
    {
      "id": "shot01-18",
      "text": "有人先看影像和体温，",
      "start": 35.945,
      "end": 37.708
    },
    {
      "id": "shot01-19",
      "text": "意见来源就更分散。",
      "start": 37.708,
      "end": 39.31
    },
    {
      "id": "shot01-20",
      "text": "这一期我们讲清随机森林的核心：既换数据，",
      "start": 39.31,
      "end": 42.956
    },
    {
      "id": "shot01-21",
      "text": "也换视角。",
      "start": 42.956,
      "end": 43.557
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "随机森林可以拆成一个公式式的定义：",
      "start": 0.0,
      "end": 3.082
    },
    {
      "id": "shot02-1",
      "text": "随机森林等于 bagging 加决策树，",
      "start": 3.082,
      "end": 5.684
    },
    {
      "id": "shot02-2",
      "text": "再加特征随机。第一，",
      "start": 5.684,
      "end": 7.566
    },
    {
      "id": "shot02-3",
      "text": "基学习器用决策树。",
      "start": 7.566,
      "end": 9.207
    },
    {
      "id": "shot02-4",
      "text": "决策树本身方差高，",
      "start": 9.207,
      "end": 10.868
    },
    {
      "id": "shot02-5",
      "text": "训练数据稍微变化，",
      "start": 10.868,
      "end": 12.49
    },
    {
      "id": "shot02-6",
      "text": "树形就可能大变，",
      "start": 12.49,
      "end": 14.011
    },
    {
      "id": "shot02-7",
      "text": "所以很适合被 bagging 稳住。",
      "start": 14.011,
      "end": 16.433
    },
    {
      "id": "shot02-8",
      "text": "第二，",
      "start": 16.433,
      "end": 16.833
    },
    {
      "id": "shot02-9",
      "text": "每棵树用 bootstrap 抽样得到自",
      "start": 16.833,
      "end": 19.435
    },
    {
      "id": "shot02-10",
      "text": "己的训练子集，",
      "start": 19.435,
      "end": 20.556
    },
    {
      "id": "shot02-11",
      "text": "这叫样本随机。",
      "start": 20.556,
      "end": 21.637
    },
    {
      "id": "shot02-12",
      "text": "第三，",
      "start": 22.169,
      "end": 22.71
    },
    {
      "id": "shot02-13",
      "text": "也是随机森林比普通 bagging 多出",
      "start": 22.71,
      "end": 25.114
    },
    {
      "id": "shot02-14",
      "text": "来的部分：",
      "start": 25.114,
      "end": 25.875
    },
    {
      "id": "shot02-15",
      "text": "每个节点分裂时，",
      "start": 25.875,
      "end": 27.238
    },
    {
      "id": "shot02-16",
      "text": "不让全部特征都参与竞争，",
      "start": 27.238,
      "end": 29.261
    },
    {
      "id": "shot02-17",
      "text": "而是先随机抽一部分特征，",
      "start": 29.261,
      "end": 31.445
    },
    {
      "id": "shot02-18",
      "text": "再从这部分里找最优分裂。",
      "start": 31.445,
      "end": 33.528
    },
    {
      "id": "shot02-19",
      "text": "比如一共有 20 个特征，",
      "start": 33.528,
      "end": 35.251
    },
    {
      "id": "shot02-20",
      "text": "每个节点只随机看 4 个左右。",
      "start": 35.251,
      "end": 37.876
    },
    {
      "id": "shot02-21",
      "text": "这样强特征不会每次都压倒其他特征，",
      "start": 37.876,
      "end": 40.901
    },
    {
      "id": "shot02-22",
      "text": "树和树之间的结构差异会更大。",
      "start": 40.901,
      "end": 43.405
    },
    {
      "id": "shot02-23",
      "text": "预测时仍然很朴素：",
      "start": 43.405,
      "end": 45.148
    },
    {
      "id": "shot02-24",
      "text": "分类任务平权投票，",
      "start": 45.148,
      "end": 47.031
    },
    {
      "id": "shot02-25",
      "text": "回归任务取平均。",
      "start": 47.031,
      "end": 48.173
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "先看第一层随机，",
      "start": 0.0,
      "end": 1.321
    },
    {
      "id": "shot03-1",
      "text": "也就是 bootstrap 抽样。",
      "start": 1.321,
      "end": 2.982
    },
    {
      "id": "shot03-2",
      "text": "假设原始训练集有 1000 条样本。",
      "start": 2.982,
      "end": 5.804
    },
    {
      "id": "shot03-3",
      "text": "每棵树都从这 1000 条里有放回地抽",
      "start": 5.804,
      "end": 8.466
    },
    {
      "id": "shot03-4",
      "text": "1000 次，",
      "start": 8.466,
      "end": 9.266
    },
    {
      "id": "shot03-5",
      "text": "形成自己的训练子集。",
      "start": 9.266,
      "end": 11.127
    },
    {
      "id": "shot03-6",
      "text": "因为有放回，",
      "start": 11.127,
      "end": 12.168
    },
    {
      "id": "shot03-7",
      "text": "同一条样本可能出现多次；",
      "start": 12.168,
      "end": 14.75
    },
    {
      "id": "shot03-8",
      "text": "也因为是随机抽，",
      "start": 14.75,
      "end": 16.291
    },
    {
      "id": "shot03-9",
      "text": "不同树拿到的子集不会完全相同。",
      "start": 16.291,
      "end": 18.973
    },
    {
      "id": "shot03-10",
      "text": "这里有一个很重要的平衡：",
      "start": 18.973,
      "end": 20.894
    },
    {
      "id": "shot03-11",
      "text": "每棵树的训练集既要有差异，",
      "start": 20.894,
      "end": 23.296
    },
    {
      "id": "shot03-12",
      "text": "又不能完全互斥。",
      "start": 23.296,
      "end": 24.877
    },
    {
      "id": "shot03-13",
      "text": "如果完全一样，",
      "start": 24.877,
      "end": 26.278
    },
    {
      "id": "shot03-14",
      "text": "所有树容易长得一样；",
      "start": 26.278,
      "end": 28.46
    },
    {
      "id": "shot03-15",
      "text": "如果完全不重叠，",
      "start": 28.46,
      "end": 30.232
    },
    {
      "id": "shot03-16",
      "text": "每棵树只学到一小块片面信息，",
      "start": 30.232,
      "end": 33.071
    },
    {
      "id": "shot03-17",
      "text": "投票也不可靠。",
      "start": 33.071,
      "end": 34.018
    },
    {
      "id": "shot03-18",
      "text": "有放回抽样刚好让子集之间有交集也有差异。",
      "start": 34.45,
      "end": 38.137
    },
    {
      "id": "shot03-19",
      "text": "直觉上，",
      "start": 38.137,
      "end": 38.798
    },
    {
      "id": "shot03-20",
      "text": "每棵树都见过大部分核心规律，",
      "start": 38.798,
      "end": 41.263
    },
    {
      "id": "shot03-21",
      "text": "但又各自带着不同的样本偏好。",
      "start": 41.263,
      "end": 43.828
    },
    {
      "id": "shot03-22",
      "text": "这样投票时，",
      "start": 43.828,
      "end": 44.89
    },
    {
      "id": "shot03-23",
      "text": "每棵树既不是克隆体，",
      "start": 44.89,
      "end": 46.714
    },
    {
      "id": "shot03-24",
      "text": "也不是只懂局部的孤岛。",
      "start": 46.714,
      "end": 48.277
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "再看第二层随机，",
      "start": 0.0,
      "end": 1.442
    },
    {
      "id": "shot04-1",
      "text": "也就是特征随机。",
      "start": 1.442,
      "end": 2.884
    },
    {
      "id": "shot04-2",
      "text": "普通决策树在每个节点分裂时，",
      "start": 2.884,
      "end": 5.408
    },
    {
      "id": "shot04-3",
      "text": "会扫描所有特征，",
      "start": 5.408,
      "end": 7.05
    },
    {
      "id": "shot04-4",
      "text": "选最能降低不纯度的那个。问题是，",
      "start": 7.05,
      "end": 9.894
    },
    {
      "id": "shot04-5",
      "text": "如果某个特征特别强，",
      "start": 9.894,
      "end": 11.617
    },
    {
      "id": "shot04-6",
      "text": "比如泰坦尼克数据里的性别，",
      "start": 11.617,
      "end": 13.8
    },
    {
      "id": "shot04-7",
      "text": "很多树都会优先用它当根节点。",
      "start": 13.8,
      "end": 16.684
    },
    {
      "id": "shot04-8",
      "text": "树一旦从同一个根节点开始，",
      "start": 16.684,
      "end": 19.03
    },
    {
      "id": "shot04-9",
      "text": "后面的结构也容易相似，",
      "start": 19.03,
      "end": 21.074
    },
    {
      "id": "shot04-10",
      "text": "投票时就像 5 个人都按同一本答案册做题。",
      "start": 21.074,
      "end": 24.542
    },
    {
      "id": "shot04-11",
      "text": "随机森林的处理方式是：",
      "start": 24.542,
      "end": 26.406
    },
    {
      "id": "shot04-12",
      "text": "每个节点先随机抽一小批候选特征，",
      "start": 26.406,
      "end": 29.473
    },
    {
      "id": "shot04-13",
      "text": "只在这批里面选最优。",
      "start": 29.473,
      "end": 30.937
    },
    {
      "id": "shot04-14",
      "text": "这个限制看起来会让单棵树变弱，",
      "start": 31.333,
      "end": 34.161
    },
    {
      "id": "shot04-15",
      "text": "但能显著降低树和树之间的相关性。",
      "start": 34.161,
      "end": 37.271
    },
    {
      "id": "shot04-16",
      "text": "集成学习要的不是每棵树都最强，",
      "start": 37.271,
      "end": 39.979
    },
    {
      "id": "shot04-17",
      "text": "而是整体投票更稳。",
      "start": 39.979,
      "end": 41.684
    },
    {
      "id": "shot04-18",
      "text": "随机森林愿意牺牲一点单树能力，",
      "start": 41.684,
      "end": 44.452
    },
    {
      "id": "shot04-19",
      "text": "换来更多视角差异。",
      "start": 44.452,
      "end": 45.877
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "训练完以后，",
      "start": 0.0,
      "end": 0.821
    },
    {
      "id": "shot05-1",
      "text": "随机森林预测很直接。分类时，",
      "start": 0.821,
      "end": 3.403
    },
    {
      "id": "shot05-2",
      "text": "把新样本交给所有树，",
      "start": 3.403,
      "end": 5.165
    },
    {
      "id": "shot05-3",
      "text": "每棵树投一票，",
      "start": 5.165,
      "end": 6.446
    },
    {
      "id": "shot05-4",
      "text": "票数最多的类别就是最终结果；回归时，",
      "start": 6.446,
      "end": 9.308
    },
    {
      "id": "shot05-5",
      "text": "让所有树各自预测一个数，再取平均。",
      "start": 9.308,
      "end": 12.131
    },
    {
      "id": "shot05-6",
      "text": "除了预测，",
      "start": 12.131,
      "end": 12.832
    },
    {
      "id": "shot05-7",
      "text": "随机森林还有两个常见副产品。",
      "start": 12.832,
      "end": 15.354
    },
    {
      "id": "shot05-8",
      "text": "第一个叫 OOB，",
      "start": 15.354,
      "end": 16.615
    },
    {
      "id": "shot05-9",
      "text": "英文 out of bag，",
      "start": 16.615,
      "end": 18.096
    },
    {
      "id": "shot05-10",
      "text": "中文叫袋外样本。",
      "start": 18.096,
      "end": 19.378
    },
    {
      "id": "shot05-11",
      "text": "因为 bootstrap 抽样时，",
      "start": 19.378,
      "end": 20.819
    },
    {
      "id": "shot05-12",
      "text": "总会有一部分样本没被某棵树抽到，",
      "start": 20.819,
      "end": 23.481
    },
    {
      "id": "shot05-13",
      "text": "这些样本可以临时当验证样本，",
      "start": 23.481,
      "end": 25.803
    },
    {
      "id": "shot05-14",
      "text": "估计模型泛化表现。",
      "start": 25.803,
      "end": 27.385
    },
    {
      "id": "shot05-15",
      "text": "第二个是特征重要性。",
      "start": 27.385,
      "end": 28.666
    },
    {
      "id": "shot05-16",
      "text": "树在分裂时会记录每个特征带来多少不纯度下",
      "start": 29.022,
      "end": 32.951
    },
    {
      "id": "shot05-17",
      "text": "降，",
      "start": 32.951,
      "end": 33.251
    },
    {
      "id": "shot05-18",
      "text": "把所有树汇总起来，",
      "start": 33.251,
      "end": 34.735
    },
    {
      "id": "shot05-19",
      "text": "就能得到哪些特征更常帮模型做判断。",
      "start": 34.735,
      "end": 37.921
    },
    {
      "id": "shot05-20",
      "text": "本期先点名，",
      "start": 37.921,
      "end": 39.024
    },
    {
      "id": "shot05-21",
      "text": "不展开工程用法。",
      "start": 39.024,
      "end": 40.527
    },
    {
      "id": "shot05-22",
      "text": "下一期讲 API 时，",
      "start": 40.527,
      "end": 42.151
    },
    {
      "id": "shot05-23",
      "text": "会看到这些概念对应到 oob_score",
      "start": 42.151,
      "end": 44.616
    },
    {
      "id": "shot05-24",
      "text": "和",
      "start": 44.616,
      "end": 44.736
    },
    {
      "id": "shot05-25",
      "text": "feature_importances_。",
      "start": 44.736,
      "end": 45.999
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这里。",
      "start": 0.0,
      "end": 1.062
    },
    {
      "id": "shot06-1",
      "text": "随机森林的主线很简单：",
      "start": 1.062,
      "end": 2.965
    },
    {
      "id": "shot06-2",
      "text": "它是 bagging 的代表算法，",
      "start": 2.965,
      "end": 4.768
    },
    {
      "id": "shot06-3",
      "text": "基学习器用决策树；",
      "start": 4.768,
      "end": 6.451
    },
    {
      "id": "shot06-4",
      "text": "第一层随机是样本随机，",
      "start": 6.451,
      "end": 8.514
    },
    {
      "id": "shot06-5",
      "text": "用 bootstrap 让每棵树看不同但",
      "start": 8.514,
      "end": 11.119
    },
    {
      "id": "shot06-6",
      "text": "有交集的数据；",
      "start": 11.119,
      "end": 12.761
    },
    {
      "id": "shot06-7",
      "text": "第二层随机是特征随机，",
      "start": 12.761,
      "end": 14.805
    },
    {
      "id": "shot06-8",
      "text": "让每个节点只从部分特征里挑分裂，",
      "start": 14.805,
      "end": 17.75
    },
    {
      "id": "shot06-9",
      "text": "减少树之间抱团。",
      "start": 17.75,
      "end": 19.493
    },
    {
      "id": "shot06-10",
      "text": "两层随机的目的都是同一个：",
      "start": 19.493,
      "end": 21.596
    },
    {
      "id": "shot06-11",
      "text": "让树独立犯不同的错，",
      "start": 21.596,
      "end": 23.52
    },
    {
      "id": "shot06-12",
      "text": "再用投票和平均把这些错抵消。",
      "start": 23.52,
      "end": 25.803
    },
    {
      "id": "shot06-13",
