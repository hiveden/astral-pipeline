{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们看完过拟合的 4 类解决办法—",
      "start": 0.0,
      "end": 3.667
    },
    {
      "id": "shot01-1",
      "text": "—前 3 类清洗数据 / 加数据 / 减",
      "start": 3.667,
      "end": 6.012
    },
    {
      "id": "shot01-2",
      "text": "特征都是事后补救，",
      "start": 6.012,
      "end": 7.855
    },
    {
      "id": "shot01-3",
      "text": "最工程化的招是正则化：",
      "start": 7.855,
      "end": 10.0
    },
    {
      "id": "shot01-4",
      "text": "从损失函数本身下手让模型自动收敛到'权重",
      "start": 10.0,
      "end": 13.947
    },
    {
      "id": "shot01-5",
      "text": "小'的方向。",
      "start": 13.947,
      "end": 14.889
    },
    {
      "id": "shot01-6",
      "text": "这一期 L1 L2 双拳出击。",
      "start": 14.889,
      "end": 17.134
    },
    {
      "id": "shot01-7",
      "text": "这一期解决三件事：",
      "start": 17.522,
      "end": 19.237
    },
    {
      "id": "shot01-8",
      "text": "正则化核心思想——损失加权重惩罚项；",
      "start": 19.237,
      "end": 22.548
    },
    {
      "id": "shot01-9",
      "text": "L1 Lasso 等量收缩出稀疏解自动砍",
      "start": 22.548,
      "end": 25.832
    },
    {
      "id": "shot01-10",
      "text": "特征 vs L2 Ridge 按比例收缩",
      "start": 25.832,
      "end": 28.836
    },
    {
      "id": "shot01-11",
      "text": "整体平滑两种机制对比；",
      "start": 28.836,
      "end": 31.038
    },
    {
      "id": "shot01-12",
      "text": "几何直觉 L1 菱形 vs L2 圆形等",
      "start": 31.038,
      "end": 35.063
    },
    {
      "id": "shot01-13",
      "text": "高线 + sklearn API",
      "start": 35.063,
      "end": 37.146
    },
    {
      "id": "shot01-14",
      "text": "alpha 调参实操。",
      "start": 37.326,
      "end": 39.529
    },
    {
      "id": "shot01-15",
      "text": "这是 LR 章最后一期。",
      "start": 39.529,
      "end": 41.751
    },
    {
      "id": "shot01-16",
      "text": "下一章我们把 LR 加 sigmoid",
      "start": 41.751,
      "end": 44.375
    },
    {
      "id": "shot01-17",
      "text": "推广到离散分类问题——逻辑回归。",
      "start": 44.375,
      "end": 46.818
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "正则化的核心想法一句话：",
      "start": 0.0,
      "end": 1.88
    },
    {
      "id": "shot02-1",
      "text": "训练损失里加一个'权重大小'的惩罚项，",
      "start": 1.88,
      "end": 4.881
    },
    {
      "id": "shot02-2",
      "text": "让模型不只追求拟合数据还要追求'权重小'",
      "start": 4.881,
      "end": 8.342
    },
    {
      "id": "shot02-3",
      "text": "——简单的模型不容易过拟合。",
      "start": 8.342,
      "end": 10.402
    },
    {
      "id": "shot02-4",
      "text": "原始 LR 的损失只看预测和真实值的差距，",
      "start": 10.402,
      "end": 13.983
    },
    {
      "id": "shot02-5",
      "text": "等于 MSE。",
      "start": 13.983,
      "end": 15.603
    },
    {
      "id": "shot02-6",
      "text": "加正则后的损失变成 MSE 加上 α 乘",
      "start": 15.603,
      "end": 19.304
    },
    {
      "id": "shot02-7",
      "text": "以权重范数，",
      "start": 19.304,
      "end": 20.845
    },
    {
      "id": "shot02-8",
      "text": "α 是个超参控制惩罚强度。",
      "start": 20.845,
      "end": 22.905
    },
    {
      "id": "shot02-9",
      "text": "α = 0 退化成普通 LR；",
      "start": 23.443,
      "end": 26.307
    },
    {
      "id": "shot02-10",
      "text": "α 极大模型只关心权重最小不顾拟合，",
      "start": 26.307,
      "end": 29.631
    },
    {
      "id": "shot02-11",
      "text": "等价于全部权重置 0；",
      "start": 29.631,
      "end": 31.534
    },
    {
      "id": "shot02-12",
      "text": "中间值刚好平衡。",
      "start": 31.534,
      "end": 33.356
    },
    {
      "id": "shot02-13",
      "text": "'权重大小'怎么衡量有两种主流方案：",
      "start": 33.356,
      "end": 36.26
    },
    {
      "id": "shot02-14",
      "text": "取绝对值之和叫 L1 范数对应",
      "start": 36.26,
      "end": 38.904
    },
    {
      "id": "shot02-15",
      "text": "Lasso 回归，",
      "start": 38.904,
      "end": 40.205
    },
    {
      "id": "shot02-16",
      "text": "取平方和叫 L2 范数对应 Ridge回归。",
      "start": 40.205,
      "end": 43.89
    },
    {
      "id": "shot02-17",
      "text": "两种衡量给模型两种不同的'压权重'机制—",
      "start": 43.89,
      "end": 47.284
    },
    {
      "id": "shot02-18",
      "text": "—下面分别看。",
      "start": 47.284,
      "end": 48.156
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "L1 Lasso 全名 Least",
      "start": 0.0,
      "end": 2.063
    },
    {
      "id": "shot03-1",
      "text": "Absolute Shrinkage",
      "start": 2.063,
      "end": 3.645
    },
    {
      "id": "shot03-2",
      "text": "and Selection",
      "start": 3.645,
      "end": 4.326
    },
    {
      "id": "shot03-3",
      "text": "Operator——名字里就含'收缩 + 选择'两个动作。",
      "start": 4.326,
      "end": 8.311
    },
    {
      "id": "shot03-5",
      "text": "损失加 α · Σ|wᵢ|。",
      "start": 8.311,
      "end": 11.575
    },
    {
      "id": "shot03-6",
      "text": "这个惩罚项有个特殊性质：",
      "start": 11.575,
      "end": 13.858
    },
    {
      "id": "shot03-7",
      "text": "求梯度时绝对值的导数是 +1 或 −1",
      "start": 13.858,
      "end": 17.203
    },
    {
      "id": "shot03-8",
      "text": "跟权重大小无关——意味着每个权重都被等量推向 0。",
      "start": 17.203,
      "end": 21.409
    },
    {
      "id": "shot03-9",
      "text": "结果是大权重被推得相对慢、",
      "start": 21.984,
      "end": 24.268
    },
    {
      "id": "shot03-10",
      "text": "小权重很快推到 0 然后停在 0——产生",
      "start": 24.268,
      "end": 27.695
    },
    {
      "id": "shot03-11",
      "text": "稀疏解 sparse solution。",
      "start": 27.695,
      "end": 29.478
    },
    {
      "id": "shot03-12",
      "text": "稀疏解的工程意义巨大：",
      "start": 29.478,
      "end": 31.341
    },
    {
      "id": "shot03-13",
      "text": "那些被推到 0 的权重对应的特征实际上被",
      "start": 31.341,
      "end": 34.467
    },
    {
      "id": "shot03-14",
      "text": "自动剔除——L1 是自带特征选择",
      "start": 34.467,
      "end": 37.132
    },
    {
      "id": "shot03-15",
      "text": "feature selection 功能的回归。",
      "start": 37.132,
      "end": 38.835
    },
    {
      "id": "shot03-16",
      "text": "比如有 100 个特征但只有 10 个真有用，",
      "start": 39.413,
      "end": 42.437
    },
    {
      "id": "shot03-17",
      "text": "L1 的 α 调对了直接给你一个非零权重",
      "start": 42.437,
      "end": 45.722
    },
    {
      "id": "shot03-18",
      "text": "只有 10 个、",
      "start": 45.722,
      "end": 46.503
    },
    {
      "id": "shot03-19",
      "text": "其余 90 个权重都是 0 的稀疏模型—",
      "start": 46.503,
      "end": 49.086
    },
    {
      "id": "shot03-20",
      "text": "—告诉你哪 10 个特征重要。",
      "start": 49.086,
      "end": 51.429
    },
    {
      "id": "shot03-21",
      "text": "这就是上期 4 类解决过拟合里'减少特征",
      "start": 51.429,
      "end": 54.674
    },
    {
      "id": "shot03-22",
      "text": "'这条路的自动版本——不用人工筛特征",
      "start": 54.674,
      "end": 57.277
    },
    {
      "id": "shot03-23",
      "text": "L1 帮你筛。",
      "start": 57.277,
      "end": 58.118
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "L2 Ridge 岭回归。",
      "start": 0.0,
      "end": 2.082
    },
    {
      "id": "shot04-1",
      "text": "损失加 α · Σwᵢ²。",
      "start": 2.082,
      "end": 5.704
    },
    {
      "id": "shot04-2",
      "text": "L2 惩罚项求梯度是 2wᵢ——梯度大小",
      "start": 5.704,
      "end": 9.787
    },
    {
      "id": "shot04-3",
      "text": "和权重本身成正比，",
      "start": 9.787,
      "end": 11.648
    },
    {
      "id": "shot04-4",
      "text": "意味着权重被按比例推小：",
      "start": 11.648,
      "end": 13.97
    },
    {
      "id": "shot04-5",
      "text": "大权重被推得快、",
      "start": 13.97,
      "end": 15.531
    },
    {
      "id": "shot04-6",
      "text": "小权重被推得慢但都不会真正归零，",
      "start": 15.531,
      "end": 18.513
    },
    {
      "id": "shot04-7",
      "text": "最后所有权重都被压到一个小但非零的整体水平。",
      "start": 18.513,
      "end": 23.082
    },
    {
      "id": "shot04-8",
      "text": "L2 没有 L1 那种特征选择能力——所",
      "start": 23.082,
      "end": 26.159
    },
    {
      "id": "shot04-9",
      "text": "有特征保留只是权重整体收缩。",
      "start": 26.159,
      "end": 28.601
    },
    {
      "id": "shot04-10",
      "text": "但 L2 有 L1 没有的工程优势：",
      "start": 29.188,
      "end": 31.75
    },
    {
      "id": "shot04-11",
      "text": "第一损失函数处处可导，",
      "start": 31.75,
      "end": 33.632
    },
    {
      "id": "shot04-12",
      "text": "正规方程仍然有闭式解 w = (XᵀX + αI)⁻¹Xᵀy——给 XᵀX 加",
      "start": 33.632,
      "end": 41.899
    },
    {
      "id": "shot04-14",
      "text": "一个对角项强制正定可逆，",
      "start": 41.899,
      "end": 44.421
    },
    {
      "id": "shot04-15",
      "text": "正好解决正规方程那一期提到的'XᵀX 不",
      "start": 44.421,
      "end": 48.304
    },
    {
      "id": "shot04-16",
      "text": "可逆'问题。",
      "start": 48.304,
      "end": 49.386
    },
    {
      "id": "shot04-17",
      "text": "第二惩罚项凸函数加凸函数还是凸函数全局最优。",
      "start": 49.386,
      "end": 53.798
    },
    {
      "id": "shot04-18",
      "text": "第三对多重共线性数据特别稳——共线特征会",
      "start": 53.798,
      "end": 57.67
    },
    {
      "id": "shot04-19",
      "text": "被均匀分配权重不会让某一个特征独大。",
      "start": 57.67,
      "end": 60.859
    },
    {
      "id": "shot04-20",
      "text": "所以工程默认走 L2，",
      "start": 61.419,
      "end": 63.452
    },
    {
      "id": "shot04-21",
      "text": "特征数远多于样本时才换 L1。",
      "start": 63.452,
      "end": 65.908
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "为什么 L1 出稀疏解 L2 不出？",
      "start": 0.0,
      "end": 2.785
    },
    {
      "id": "shot05-1",
      "text": "先看几何直觉，",
      "start": 2.785,
      "end": 3.927
    },
    {
      "id": "shot05-2",
      "text": "再打开 demo 看实战，分两段。先看几何：",
      "start": 3.927,
      "end": 7.273
    },
    {
      "id": "shot05-3",
      "text": "在 w1 w2 二维平面画 MSE 损失",
      "start": 7.273,
      "end": 10.739
    },
    {
      "id": "shot05-4",
      "text": "的等高线是椭圆，",
      "start": 10.739,
      "end": 12.001
    },
    {
      "id": "shot05-5",
      "text": "正则化等价于约束 w 在某个范围内取最小损失。",
      "start": 12.001,
      "end": 16.248
    },
    {
      "id": "shot05-6",
      "text": "L1 约束 |w1| 加 |w2| 小于",
      "start": 16.248,
      "end": 19.093
    },
    {
      "id": "shot05-7",
      "text": "等于常数，",
      "start": 19.093,
      "end": 20.175
    },
    {
      "id": "shot05-8",
      "text": "画出来是个菱形——4 个顶点正好在坐标轴上。",
      "start": 20.175,
      "end": 23.361
    },
    {
      "id": "shot05-9",
      "text": "损失椭圆从外往内收缩，",
      "start": 23.755,
      "end": 26.157
    },
    {
      "id": "shot05-10",
      "text": "最先碰到菱形的是某个顶点——顶点恰好在",
      "start": 26.157,
      "end": 29.62
    },
    {
      "id": "shot05-11",
      "text": "w1 等于 0 的轴上意味着另一个权重为0：",
      "start": 29.62,
      "end": 33.573
    },
    {
      "id": "shot05-12",
      "text": "稀疏解。",
      "start": 33.573,
      "end": 34.664
    },
    {
      "id": "shot05-13",
      "text": "L2 约束 w1 平方加 w2 平方小于",
      "start": 34.664,
      "end": 38.827
    },
    {
      "id": "shot05-14",
      "text": "等于常数是个圆——损失椭圆碰到圆的切点几",
      "start": 38.827,
      "end": 42.851
    },
    {
      "id": "shot05-15",
      "text": "乎肯定不在轴上，",
      "start": 42.851,
      "end": 44.432
    },
    {
      "id": "shot05-16",
      "text": "两个权重都非零：",
      "start": 44.432,
      "end": 45.933
    },
    {
      "id": "shot05-17",
      "text": "所以整体收缩。",
      "start": 45.933,
      "end": 46.954
    },
    {
      "id": "shot05-18",
      "text": "几何讲完，",
      "start": 47.423,
      "end": 48.244
    },
    {
      "id": "shot05-19",
      "text": "现在打开 demo 看实战——demo",
      "start": 48.244,
      "end": 50.507
    },
    {
      "id": "shot05-20",
      "text": "不画几何图，",
      "start": 50.507,
      "end": 51.609
    },
    {
      "id": "shot05-21",
      "text": "只用真实数据看正则化效果，",
      "start": 51.609,
      "end": 54.133
    },
    {
      "id": "shot05-22",
      "text": "3 个镜头 A 拟合曲线 / B 权重对",
      "start": 54.133,
      "end": 56.696
    },
    {
      "id": "shot05-23",
      "text": "比 / C α-MSE 路径（demo",
      "start": 56.696,
      "end": 59.24
    },
    {
      "id": "shot05-24",
      "text": "屏幕标的是 λ，",
      "start": 59.24,
      "end": 60.542
    },
    {
      "id": "shot05-25",
      "text": "跟 α 是同一个量）。",
      "start": 60.542,
      "end": 62.324
    },
    {
      "id": "shot05-26",
      "text": "先看镜头 A 弱正则 α 接近 0 时—",
      "start": 62.324,
      "end": 65.409
    },
    {
      "id": "shot05-27",
      "text": "—拟合曲线弯弯绕绕拼命穿过每个数据点，",
      "start": 65.409,
      "end": 69.188
    },
    {
      "id": "shot05-28",
      "text": "典型过拟合。",
      "start": 69.188,
      "end": 70.316
    },
    {
      "id": "shot05-29",
      "text": "把 α 调强——拟合曲线立刻变平滑，",
      "start": 70.562,
      "end": 73.747
    },
    {
      "id": "shot05-30",
      "text": "从过拟合的扭曲变成稳重的趋势线，",
      "start": 73.747,
      "end": 76.671
    },
    {
      "id": "shot05-31",
      "text": "正则化的效果一眼可见。",
      "start": 76.671,
      "end": 78.734
    },
    {
      "id": "shot05-32",
      "text": "切到镜头 B 权重对比：",
      "start": 78.734,
      "end": 80.557
    },
    {
      "id": "shot05-33",
      "text": "左边是 L1 Lasso 权重柱、",
      "start": 80.557,
      "end": 83.06
    },
    {
      "id": "shot05-34",
      "text": "右边是 L2 Ridge 权重柱。",
      "start": 83.06,
      "end": 85.904
    },
    {
      "id": "shot05-35",
      "text": "α 越大 L1 高次项一根根归零变成稀疏柱状图、",
      "start": 85.904,
      "end": 90.411
    },
    {
      "id": "shot05-36",
      "text": "L2 所有柱整体压小但都不为零。",
      "start": 90.411,
      "end": 93.275
    },
    {
      "id": "shot05-37",
      "text": "最后切到镜头 C α-MSE 路径——横",
      "start": 93.707,
      "end": 97.256
    },
    {
      "id": "shot05-38",
      "text": "轴是 log α、",
      "start": 97.256,
      "end": 98.479
    },
    {
      "id": "shot05-39",
      "text": "纵轴是测试 MSE，",
      "start": 98.479,
      "end": 100.364
    },
    {
      "id": "shot05-40",
      "text": "红蓝两条曲线分别是 Lasso 和",
      "start": 100.364,
      "end": 102.63
    },
    {
      "id": "shot05-41",
      "text": "Ridge 随 α 变化的测试误差。",
      "start": 102.63,
      "end": 105.297
    },
    {
      "id": "shot05-42",
      "text": "两条曲线都有 U 形最低点，",
      "start": 105.297,
      "end": 107.563
    },
    {
      "id": "shot05-43",
      "text": "最低点对应的 α 就是工程上要选的最优正则强度。",
      "start": 107.563,
      "end": 111.212
    },
    {
      "id": "shot05-44",
      "text": "sklearn 一行调用：",
      "start": 111.693,
      "end": 113.375
    },
    {
      "id": "shot05-45",
      "text": "from sklearn.",
      "start": 113.375,
      "end": 114.537
    },
    {
      "id": "shot05-46",
      "text": "linear_model import",
      "start": 114.537,
      "end": 115.698
    },
    {
      "id": "shot05-47",
      "text": "Lasso,",
      "start": 115.698,
      "end": 116.139
    },
    {
      "id": "shot05-48",
      "text": "Ridge，",
      "start": 116.139,
      "end": 116.56
    },
    {
      "id": "shot05-49",
      "text": "Lasso 加 alpha=0.1 / Ridge 加 alpha=1.0，",
      "start": 116.56,
      "end": 120.445
    },
    {
      "id": "shot05-51",
      "text": "fit predict 同 LR。",
      "start": 120.445,
      "end": 122.114
    },
    {
      "id": "shot05-52",
      "text": "α 调参用网格搜索 + 交叉验证——",
      "start": 122.114,
      "end": 125.312
    },
    {
      "id": "shot05-53",
      "text": "KNN 章已讲过。",
      "start": 125.312,
      "end": 126.894
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.002
    },
    {
      "id": "shot06-1",
      "text": "核心一句话：",
      "start": 1.002,
      "end": 2.024
    },
    {
      "id": "shot06-2",
      "text": "正则化从损失函数本身下手，",
      "start": 2.024,
      "end": 4.57
    },
    {
      "id": "shot06-3",
      "text": "给权重加惩罚自动引导模型找简单解——比事",
      "start": 4.57,
      "end": 8.257
    },
    {
      "id": "shot06-4",
      "text": "后清洗 / 加数据 / 减特征更优雅。",
      "start": 8.257,
      "end": 11.123
    },
    {
      "id": "shot06-5",
      "text": "α 控制惩罚强度，",
      "start": 11.123,
      "end": 12.827
    },
    {
      "id": "shot06-6",
      "text": "工程上靠网格搜索 + 交叉验证选最优。",
      "start": 12.827,
      "end": 15.673
    },
    {
      "id": "shot06-7",
      "text": "LR 章到此完结——回顾整章脊梁：",
      "start": 16.129,
      "end": 19.911
    },
    {
      "id": "shot06-8",
      "text": "从 LR 是什么、",
      "start": 19.911,
      "end": 21.552
    },
    {
      "id": "shot06-9",
      "text": "sklearn 4 行跑通，",
      "start": 21.552,
      "end": 23.334
    },
    {
      "id": "shot06-10",
      "text": "到损失函数 MSE、",
      "start": 23.334,
      "end": 25.395
    },
    {
      "id": "shot06-11",
      "text": "偏导和矩阵两件家伙合体推出正规方程、",
      "start": 25.395,
      "end": 29.257
    },
    {
      "id": "shot06-12",
      "text": "再到梯度下降三变体；",
      "start": 29.257,
      "end": 31.339
    },
    {
      "id": "shot06-13",
      "text": "评估三件套 MAE / MSE / RMSE、",
      "start": 31.339,
      "end": 35.581
    },
    {
      "id": "shot06-15",
      "text": "加州房价完整 pipeline 实战；",
      "start": 35.581,
      "end": 38.444
    },
    {
      "id": "shot06-16",
      "text": "最后过拟合 U 形和正则化药方收尾。",
      "start": 38.444,
      "end": 41.976
    },
    {
      "id": "shot06-17",
      "text": "一个核心思想贯穿——找最小损失就是好模型，",
      "start": 41.976,
      "end": 46.03
    },
    {
      "id": "shot06-18",
      "text": "方法可以闭式解析也可以梯度下降。",
      "start": 46.03,
      "end": 48.539
    },
    {
      "id": "shot06-19",
      "text": "点到没展开的：",
      "start": 49.102,
      "end": 50.324
    },
    {
      "id": "shot06-20",
      "text": "弹性网 ElasticNet 是 L1",
      "start": 50.324,
      "end": 53.508
    },
    {
      "id": "shot06-21",
      "text": "加 L2 混合留给 sklearn 文档；",
      "start": 53.508,
      "end": 56.752
    },
    {
      "id": "shot06-22",
      "text": "贝叶斯视角下 L1 对应 Laplace先验、",
      "start": 56.752,
      "end": 60.337
    },
    {
      "id": "shot06-23",
      "text": "L2 对应高斯先验留给贝叶斯统计；",
      "start": 60.337,
      "end": 63.861
    },
    {
      "id": "shot06-24",
      "text": "正则化路径 regularization",
      "start": 63.861,
      "end": 66.084
    },
    {
      "id": "shot06-25",
      "text": "path 留给特征工程专题。",
      "start": 66.084,
      "end": 68.067
    },
    {
      "id": "shot06-26",
      "text": "下一章我们把 LR 加 sigmoid",
      "start": 68.621,
      "end": 70.947
    },
    {
      "id": "shot06-27",
      "text": "推广到离散类别预测——垃圾邮件、肿瘤良恶、",
      "start": 70.947,
      "end": 74.296
    },
    {
      "id": "shot06-28",
      "text": "客户流失这类二分类问题，",
      "start": 74.296,
      "end": 76.261
    },
    {
      "id": "shot06-29",
      "text": "叫逻辑回归 Logistic",
      "start": 76.261,
      "end": 78.065
    },
    {
      "id": "shot06-30",
      "text": "Regression 简写 LogReg。",
      "start": 78.065,
      "end": 80.15
    },
    {
      "id": "shot06-31",
      "text": "LR 是回归基线、",
      "start": 80.15,
      "end": 81.614
    },
    {
      "id": "shot06-32",
      "text": "LogReg 是分类基线，",
      "start": 81.614,
      "end": 83.278
    },
    {
      "id": "shot06-33",
      "text": "两兄弟覆盖了 ML 一半最经典的应用。",
      "start": 83.278,
      "end": 86.086
    }
