{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们拿到了一把尺子：信息增益。",
      "start": 0.0,
      "end": 2.861
    },
    {
      "id": "shot01-1",
      "text": "现在问题变成，",
      "start": 2.861,
      "end": 4.141
    },
    {
      "id": "shot01-2",
      "text": "怎么用这把尺子真的长出一棵树。ID3，",
      "start": 4.141,
      "end": 7.543
    },
    {
      "id": "shot01-3",
      "text": "英文 Iterative",
      "start": 7.543,
      "end": 8.863
    },
    {
      "id": "shot01-4",
      "text": "Dichotomiser 3，",
      "start": 8.863,
      "end": 10.304
    },
    {
      "id": "shot01-5",
      "text": "就是最经典的一套流程。",
      "start": 10.304,
      "end": 12.544
    },
    {
      "id": "shot01-6",
      "text": "它的做法很朴素：",
      "start": 12.544,
      "end": 14.085
    },
    {
      "id": "shot01-7",
      "text": "在当前这堆样本上，",
      "start": 14.085,
      "end": 15.726
    },
    {
      "id": "shot01-8",
      "text": "先算每个特征的信息增益，",
      "start": 15.726,
      "end": 17.926
    },
    {
      "id": "shot01-9",
      "text": "选最大的那个做节点，",
      "start": 17.926,
      "end": 19.727
    },
    {
      "id": "shot01-10",
      "text": "再按这个特征把样本切成子集。",
      "start": 19.727,
      "end": 22.408
    },
    {
      "id": "shot01-11",
      "text": "每个子集如果还不纯，",
      "start": 22.408,
      "end": 24.109
    },
    {
      "id": "shot01-12",
      "text": "就重复同样动作。",
      "start": 24.109,
      "end": 25.59
    },
    {
      "id": "shot01-13",
      "text": "一直递归下去，",
      "start": 25.59,
      "end": 26.822
    },
    {
      "id": "shot01-14",
      "text": "直到子集已经纯净，",
      "start": 26.822,
      "end": 28.559
    },
    {
      "id": "shot01-15",
      "text": "或者没有特征可用了。",
      "start": 28.559,
      "end": 29.913
    },
    {
      "id": "shot01-16",
      "text": "这一期的重点不是再推公式，",
      "start": 30.261,
      "end": 32.467
    },
    {
      "id": "shot01-17",
      "text": "而是把公式放回树结构里，",
      "start": 32.467,
      "end": 34.713
    },
    {
      "id": "shot01-18",
      "text": "弄清楚一个节点怎么变成多个分支，",
      "start": 34.713,
      "end": 37.521
    },
    {
      "id": "shot01-19",
      "text": "多个分支又怎么继续长。",
      "start": 37.521,
      "end": 38.884
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "把流程拆成 4 步。第一步，",
      "start": 0.0,
      "end": 2.66
    },
    {
      "id": "shot02-1",
      "text": "计算每个候选特征的信息增益。第二步，",
      "start": 2.66,
      "end": 6.101
    },
    {
      "id": "shot02-2",
      "text": "选择信息增益最大的特征。第三步，",
      "start": 6.101,
      "end": 9.202
    },
    {
      "id": "shot02-3",
      "text": "用这个特征作为当前节点，",
      "start": 9.202,
      "end": 11.542
    },
    {
      "id": "shot02-4",
      "text": "把数据集按特征取值切成若干子集。",
      "start": 11.542,
      "end": 14.863
    },
    {
      "id": "shot02-5",
      "text": "第四步，",
      "start": 14.863,
      "end": 15.663
    },
    {
      "id": "shot02-6",
      "text": "对每个子集重复前面 3 步。注意，",
      "start": 15.663,
      "end": 18.983
    },
    {
      "id": "shot02-7",
      "text": "这里的重复不是简单排队用完所有特征，",
      "start": 18.983,
      "end": 22.544
    },
    {
      "id": "shot02-8",
      "text": "而是对子树递归。",
      "start": 22.544,
      "end": 24.024
    },
    {
      "id": "shot02-9",
      "text": "某一支如果已经全是同一类，",
      "start": 24.024,
      "end": 26.305
    },
    {
      "id": "shot02-10",
      "text": "就直接贴叶子标签；",
      "start": 26.305,
      "end": 28.005
    },
    {
      "id": "shot02-11",
      "text": "某一支如果还混杂，",
      "start": 28.005,
      "end": 29.611
    },
    {
      "id": "shot02-12",
      "text": "就继续往下找下一刀。",
      "start": 29.611,
      "end": 31.458
    },
    {
      "id": "shot02-13",
      "text": "ID3 的核心就是这 4 个词：贪心、",
      "start": 31.458,
      "end": 34.269
    },
    {
      "id": "shot02-14",
      "text": "递归、信息增益、叶子标签。",
      "start": 34.269,
      "end": 36.155
    },
    {
      "id": "shot02-15",
      "text": "如果把它画成流程图，",
      "start": 36.631,
      "end": 38.359
    },
    {
      "id": "shot02-16",
      "text": "最上面是当前数据集，",
      "start": 38.359,
      "end": 40.187
    },
    {
      "id": "shot02-17",
      "text": "中间是候选特征打分，",
      "start": 40.187,
      "end": 42.095
    },
    {
      "id": "shot02-18",
      "text": "下面是分裂后的子集。",
      "start": 42.095,
      "end": 43.903
    },
    {
      "id": "shot02-19",
      "text": "每个子集又回到同一张流程图。",
      "start": 43.903,
      "end": 45.952
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "看一个业务化例子。",
      "start": 0.0,
      "end": 1.581
    },
    {
      "id": "shot03-1",
      "text": "我们想预测论坛用户会不会流失，",
      "start": 1.581,
      "end": 4.502
    },
    {
      "id": "shot03-2",
      "text": "手里有登录频率、发帖频率、",
      "start": 4.502,
      "end": 6.903
    },
    {
      "id": "shot03-3",
      "text": "账号年龄这些特征。",
      "start": 6.903,
      "end": 8.484
    },
    {
      "id": "shot03-4",
      "text": "ID3 不会先凭直觉说登录频率最重要，",
      "start": 8.484,
      "end": 12.386
    },
    {
      "id": "shot03-5",
      "text": "而是把每个特征都拿来试切一次。",
      "start": 12.386,
      "end": 15.327
    },
    {
      "id": "shot03-6",
      "text": "比如按登录频率切，",
      "start": 15.327,
      "end": 17.168
    },
    {
      "id": "shot03-7",
      "text": "低频用户那支流失比例很高，",
      "start": 17.168,
      "end": 19.589
    },
    {
      "id": "shot03-8",
      "text": "高频用户那支留存比例很高，",
      "start": 19.589,
      "end": 22.07
    },
    {
      "id": "shot03-9",
      "text": "两个子集明显更纯，",
      "start": 22.07,
      "end": 23.991
    },
    {
      "id": "shot03-10",
      "text": "信息增益就大。",
      "start": 23.991,
      "end": 25.352
    },
    {
      "id": "shot03-11",
      "text": "按账号年龄切，",
      "start": 25.352,
      "end": 26.939
    },
    {
      "id": "shot03-12",
      "text": "如果左右两边仍然混着流失和留存，",
      "start": 26.939,
      "end": 30.032
    },
    {
      "id": "shot03-13",
      "text": "信息增益就小。",
      "start": 30.032,
      "end": 31.438
    },
    {
      "id": "shot03-14",
      "text": "于是第一刀选登录频率。",
      "start": 31.438,
      "end": 33.186
    },
    {
      "id": "shot03-15",
      "text": "切完以后，",
      "start": 33.753,
      "end": 34.475
    },
    {
      "id": "shot03-16",
      "text": "算法不会停止，",
      "start": 34.475,
      "end": 35.737
    },
    {
      "id": "shot03-17",
      "text": "而是在每个还混杂的子集里继续算增益，",
      "start": 35.737,
      "end": 39.405
    },
    {
      "id": "shot03-18",
      "text": "继续选下一刀。",
      "start": 39.405,
      "end": 40.768
    },
    {
      "id": "shot03-19",
      "text": "这样讲的好处是，",
      "start": 40.768,
      "end": 42.051
    },
    {
      "id": "shot03-20",
      "text": "观众能把“信息增益最大”从公式里的一个分",
      "start": 42.051,
      "end": 45.739
    },
    {
      "id": "shot03-21",
      "text": "数，",
      "start": 45.739,
      "end": 46.28
    },
    {
      "id": "shot03-22",
      "text": "翻译成业务里的一个动作：",
      "start": 46.28,
      "end": 48.445
    },
    {
      "id": "shot03-23",
      "text": "先问最能区分人群的问题。",
      "start": 48.445,
      "end": 50.79
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "训练完成以后，",
      "start": 0.0,
      "end": 1.081
    },
    {
      "id": "shot04-1",
      "text": "预测新样本就很简单。",
      "start": 1.081,
      "end": 2.802
    },
    {
      "id": "shot04-2",
      "text": "新用户进来，",
      "start": 2.802,
      "end": 3.682
    },
    {
      "id": "shot04-3",
      "text": "先看根节点，",
      "start": 3.682,
      "end": 4.703
    },
    {
      "id": "shot04-4",
      "text": "比如登录频率。低频，",
      "start": 4.703,
      "end": 6.244
    },
    {
      "id": "shot04-5",
      "text": "就走低频那条分支；",
      "start": 6.244,
      "end": 7.765
    },
    {
      "id": "shot04-6",
      "text": "再看下一个节点，",
      "start": 7.765,
      "end": 8.966
    },
    {
      "id": "shot04-7",
      "text": "比如发帖频率；",
      "start": 8.966,
      "end": 10.147
    },
    {
      "id": "shot04-8",
      "text": "继续按判断结果往下走，",
      "start": 10.147,
      "end": 11.928
    },
    {
      "id": "shot04-9",
      "text": "直到走到叶子。",
      "start": 11.928,
      "end": 13.048
    },
    {
      "id": "shot04-10",
      "text": "叶子上写着流失，",
      "start": 13.048,
      "end": 14.389
    },
    {
      "id": "shot04-11",
      "text": "就预测流失；写着留存，",
      "start": 14.389,
      "end": 16.711
    },
    {
      "id": "shot04-12",
      "text": "就预测留存。",
      "start": 16.711,
      "end": 17.771
    },
    {
      "id": "shot04-13",
      "text": "这里的标签通常按多数类决定：",
      "start": 17.771,
      "end": 20.153
    },
    {
      "id": "shot04-14",
      "text": "如果某片叶子里大多数训练样本都流失，",
      "start": 20.153,
      "end": 23.015
    },
    {
      "id": "shot04-15",
      "text": "这片叶子就贴流失标签。",
      "start": 23.015,
      "end": 24.816
    },
    {
      "id": "shot04-16",
      "text": "训练时要遍历候选特征和切法，",
      "start": 24.816,
      "end": 27.207
    },
    {
      "id": "shot04-17",
      "text": "推理时只走一条路径，",
      "start": 27.207,
      "end": 28.855
    },
    {
      "id": "shot04-18",
      "text": "所以决策树常见特点是训练比较贵，",
      "start": 28.855,
      "end": 31.447
    },
    {
      "id": "shot04-19",
      "text": "推理非常快。",
      "start": 31.447,
      "end": 32.17
    },
    {
      "id": "shot04-20",
      "text": "这也是决策树容易解释的原因。",
      "start": 32.66,
      "end": 35.027
    },
    {
      "id": "shot04-21",
      "text": "预测过程不是一串矩阵运算，",
      "start": 35.027,
      "end": 37.414
    },
    {
      "id": "shot04-22",
      "text": "而是一条可复述的规则路径：因为低频，",
      "start": 37.414,
      "end": 40.784
    },
    {
      "id": "shot04-23",
      "text": "所以再看发帖，",
      "start": 40.784,
      "end": 41.987
    },
    {
      "id": "shot04-24",
      "text": "最后落到流失叶子。",
      "start": 41.987,
      "end": 43.351
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "ID3 很适合教学，",
      "start": 0.0,
      "end": 1.543
    },
    {
      "id": "shot05-1",
      "text": "因为它把决策树的骨架讲得非常清楚。",
      "start": 1.543,
      "end": 4.569
    },
    {
      "id": "shot05-2",
      "text": "但它不适合直接当工业默认方案。第一，",
      "start": 4.569,
      "end": 7.595
    },
    {
      "id": "shot05-3",
      "text": "它原版主要处理离散特征，",
      "start": 7.595,
      "end": 9.819
    },
    {
      "id": "shot05-4",
      "text": "连续数值要先分桶。第二，",
      "start": 9.819,
      "end": 11.783
    },
    {
      "id": "shot05-5",
      "text": "它会偏爱取值多的特征，",
      "start": 11.783,
      "end": 13.587
    },
    {
      "id": "shot05-6",
      "text": "比如用户 ID 这种每个样本都不一样的列。",
      "start": 13.587,
      "end": 16.953
    },
    {
      "id": "shot05-7",
      "text": "第三，",
      "start": 16.953,
      "end": 17.314
    },
    {
      "id": "shot05-8",
      "text": "它没有内置剪枝，",
      "start": 17.314,
      "end": 18.622
    },
    {
      "id": "shot05-9",
      "text": "树很容易长得过深。第四，",
      "start": 18.622,
      "end": 20.42
    },
    {
      "id": "shot05-10",
      "text": "它是多叉树，",
      "start": 20.42,
      "end": 21.542
    },
    {
      "id": "shot05-11",
      "text": "工程部署和剪枝都没有二叉树方便。",
      "start": 21.542,
      "end": 23.907
    },
    {
      "id": "shot05-12",
      "text": "所以我们学 ID3，",
      "start": 24.251,
      "end": 25.914
    },
    {
      "id": "shot05-13",
      "text": "不是因为它是工业首选，",
      "start": 25.914,
      "end": 27.756
    },
    {
      "id": "shot05-14",
      "text": "而是因为信息熵、信息增益、",
      "start": 27.756,
      "end": 30.12
    },
    {
      "id": "shot05-15",
      "text": "贪心递归这些概念，",
      "start": 30.12,
      "end": 31.662
    },
    {
      "id": "shot05-16",
      "text": "是后面 C4.5 和 CART 的地基。",
      "start": 31.662,
      "end": 35.107
    },
    {
      "id": "shot05-17",
      "text": "这些限制会在后面逐个被修补。",
      "start": 35.107,
      "end": 37.932
    },
    {
      "id": "shot05-18",
      "text": "C4.5 修多值偏好，",
      "start": 37.932,
      "end": 39.955
    },
    {
      "id": "shot05-19",
      "text": "CART 改成二叉并覆盖回归，",
      "start": 39.955,
      "end": 42.726
    },
    {
      "id": "shot05-20",
      "text": "剪枝负责控制树不要记住噪声。",
      "start": 42.726,
      "end": 45.383
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期我们把 ID3 流程跑通了：",
      "start": 0.0,
      "end": 2.522
    },
    {
      "id": "shot06-1",
      "text": "每个节点算信息增益，",
      "start": 2.522,
      "end": 4.283
    },
    {
      "id": "shot06-2",
      "text": "选增益最大的特征，",
      "start": 4.283,
      "end": 5.744
    },
    {
      "id": "shot06-3",
      "text": "把样本切成子集，",
      "start": 5.744,
      "end": 7.164
    },
    {
      "id": "shot06-4",
      "text": "再对子集递归。",
      "start": 7.164,
      "end": 8.565
    },
    {
      "id": "shot06-5",
      "text": "子集纯了就停，",
      "start": 8.565,
      "end": 9.806
    },
    {
      "id": "shot06-6",
      "text": "贴叶子标签；",
      "start": 9.806,
      "end": 10.767
    },
    {
      "id": "shot06-7",
      "text": "还混杂就继续长。",
      "start": 10.767,
      "end": 12.147
    },
    {
      "id": "shot06-8",
      "text": "没展开的核心问题，",
      "start": 12.147,
      "end": 13.648
    },
    {
      "id": "shot06-9",
      "text": "是 ID3 为什么会偏爱取值多的特征。",
      "start": 13.648,
      "end": 17.131
    },
    {
      "id": "shot06-10",
      "text": "下一期就专门修这个问题：",
      "start": 17.131,
      "end": 19.192
    },
    {
      "id": "shot06-11",
      "text": "C4.5 用信息增益率，",
      "start": 19.192,
      "end": 21.253
    },
    {
      "id": "shot06-12",
      "text": "在信息增益后面加一个惩罚项，",
      "start": 21.253,
      "end": 23.654
    },
    {
      "id": "shot06-13",
      "text": "让“切太碎”的特征别轻易胜出。",
      "start": 23.654,
      "end": 25.876
    },
    {
      "id": "shot06-14",
      "text": "这一期要留下的不是每个公式细节，",
      "start": 26.402,
      "end": 28.929
    },
    {
      "id": "shot06-15",
      "text": "而是一张递归图：",
      "start": 28.929,
      "end": 30.413
    },
    {
      "id": "shot06-16",
      "text": "当前节点做局部最优选择，",
      "start": 30.413,
      "end": 32.76
    },
    {
      "id": "shot06-17",
      "text": "子节点继续做同样选择，",
      "start": 32.76,
      "end": 34.826
    },
    {
      "id": "shot06-18",
      "text": "整棵树就这样长出来。",
      "start": 34.826,
      "end": 36.551
    },
    {
      "id": "shot06-19",
      "text": "这会让整棵树保持同一种动作：",
      "start": 36.551,
      "end": 39.058
    },
    {
      "id": "shot06-20",
      "text": "当前节点只解决当前子集，",
      "start": 39.058,
      "end": 41.445
    },
    {
      "id": "shot06-21",
