{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "GBDT 已经能用一棵棵树拟合负梯度，",
      "start": 0.0,
      "end": 3.685
    },
    {
      "id": "shot01-1",
      "text": "在结构化数据上很能打。",
      "start": 3.685,
      "end": 5.827
    },
    {
      "id": "shot01-2",
      "text": "但一旦进入真实业务，",
      "start": 5.827,
      "end": 7.609
    },
    {
      "id": "shot01-3",
      "text": "会遇到几个问题：",
      "start": 7.609,
      "end": 9.011
    },
    {
      "id": "shot01-4",
      "text": "树长太深会过拟合，",
      "start": 9.011,
      "end": 11.033
    },
    {
      "id": "shot01-5",
      "text": "叶子输出太极端也没人约束；",
      "start": 11.033,
      "end": 13.917
    },
    {
      "id": "shot01-6",
      "text": "什么时候继续分裂，",
      "start": 13.917,
      "end": 15.359
    },
    {
      "id": "shot01-7",
      "text": "什么时候停止，",
      "start": 15.359,
      "end": 16.64
    },
    {
      "id": "shot01-8",
      "text": "很多时候靠 max_depth 这类超参",
      "start": 16.64,
      "end": 19.304
    },
    {
      "id": "shot01-9",
      "text": "数硬挡；",
      "start": 19.304,
      "end": 20.044
    },
    {
      "id": "shot01-10",
      "text": "数据量大时，",
      "start": 20.044,
      "end": 21.276
    },
    {
      "id": "shot01-11",
      "text": "枚举切分点又很慢。",
      "start": 21.276,
      "end": 23.148
    },
    {
      "id": "shot01-12",
      "text": "XGBoost 的定位，",
      "start": 23.148,
      "end": 24.63
    },
    {
      "id": "shot01-13",
      "text": "就是把 GBDT 做成更强的工业级版本。",
      "start": 24.63,
      "end": 27.574
    },
    {
      "id": "shot01-14",
      "text": "它不是完全换了一种算法，",
      "start": 28.103,
      "end": 30.127
    },
    {
      "id": "shot01-15",
      "text": "而是在 GBDT 的框架上加了几件关键装",
      "start": 30.127,
      "end": 33.254
    },
    {
      "id": "shot01-16",
      "text": "备：",
      "start": 33.254,
      "end": 33.615
    },
    {
      "id": "shot01-17",
      "text": "二阶泰勒展开，",
      "start": 33.615,
      "end": 34.817
    },
    {
      "id": "shot01-18",
      "text": "同时看一阶导和二阶导；",
      "start": 34.817,
      "end": 36.741
    },
    {
      "id": "shot01-19",
      "text": "目标函数里加入正则项，",
      "start": 36.741,
      "end": 38.545
    },
    {
      "id": "shot01-20",
      "text": "惩罚叶子数量和叶子值大小；",
      "start": 38.545,
      "end": 40.83
    },
    {
      "id": "shot01-21",
      "text": "分裂条件从目标函数推导出来；",
      "start": 40.83,
      "end": 43.376
    },
    {
      "id": "shot01-22",
      "text": "工程上再配合直方图、列采样、",
      "start": 43.376,
      "end": 45.941
    },
    {
      "id": "shot01-23",
      "text": "缺失值处理和并行优化。",
      "start": 45.941,
      "end": 47.745
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "GBDT 的核心是负梯度，",
      "start": 0.0,
      "end": 2.301
    },
    {
      "id": "shot02-1",
      "text": "也就是一阶导信息。",
      "start": 2.301,
      "end": 3.922
    },
    {
      "id": "shot02-2",
      "text": "它告诉我们损失往哪个方向下降最快，",
      "start": 3.922,
      "end": 7.263
    },
    {
      "id": "shot02-3",
      "text": "但对这一步走多远，",
      "start": 7.263,
      "end": 8.624
    },
    {
      "id": "shot02-4",
      "text": "主要还要靠 learning_rate",
      "start": 8.624,
      "end": 10.305
    },
    {
      "id": "shot02-5",
      "text": "和树的拟合结果控制。",
      "start": 10.305,
      "end": 12.285
    },
    {
      "id": "shot02-6",
      "text": "XGBoost 多看一层二阶导，",
      "start": 12.285,
      "end": 14.867
    },
    {
      "id": "shot02-7",
      "text": "也叫 Hessian。",
      "start": 14.867,
      "end": 16.027
    },
    {
      "id": "shot02-8",
      "text": "可以把一阶导理解成坡度，",
      "start": 16.027,
      "end": 18.253
    },
    {
      "id": "shot02-9",
      "text": "二阶导理解成坡度变化的快慢，",
      "start": 18.253,
      "end": 20.859
    },
    {
      "id": "shot02-10",
      "text": "也就是曲率。",
      "start": 20.859,
      "end": 22.062
    },
    {
      "id": "shot02-11",
      "text": "只看一阶导，",
      "start": 22.062,
      "end": 23.105
    },
    {
      "id": "shot02-12",
      "text": "相当于用一条直线近似损失曲面；",
      "start": 23.105,
      "end": 26.172
    },
    {
      "id": "shot02-13",
      "text": "加上二阶导，",
      "start": 26.172,
      "end": 27.235
    },
    {
      "id": "shot02-14",
      "text": "相当于用一条抛物线去贴这个曲面。",
      "start": 27.235,
      "end": 29.781
    },
    {
      "id": "shot02-15",
      "text": "抛物线更知道附近形状，",
      "start": 30.332,
      "end": 32.378
    },
    {
      "id": "shot02-16",
      "text": "所以叶子输出可以推成闭式公式，",
      "start": 32.378,
      "end": 34.986
    },
    {
      "id": "shot02-17",
      "text": "而不是只取残差均值。",
      "start": 34.986,
      "end": 36.771
    },
    {
      "id": "shot02-18",
      "text": "这也是后面目标函数推导里最重要的铺垫：",
      "start": 36.771,
      "end": 39.84
    },
    {
      "id": "shot02-19",
      "text": "每个样本不只传一个 g，",
      "start": 39.84,
      "end": 41.745
    },
    {
      "id": "shot02-20",
      "text": "还会传一个 h。",
      "start": 41.745,
      "end": 42.628
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "第二个升级是正则项。",
      "start": 0.0,
      "end": 1.501
    },
    {
      "id": "shot03-1",
      "text": "XGBoost 的目标函数不是只有训练损",
      "start": 1.501,
      "end": 4.904
    },
    {
      "id": "shot03-2",
      "text": "失，",
      "start": 4.904,
      "end": 5.364
    },
    {
      "id": "shot03-3",
      "text": "还会加上树的复杂度惩罚。",
      "start": 5.364,
      "end": 7.866
    },
    {
      "id": "shot03-4",
      "text": "复杂度可以写成两部分：",
      "start": 7.866,
      "end": 9.927
    },
    {
      "id": "shot03-5",
      "text": "γ 乘叶子数量 T，",
      "start": 9.927,
      "end": 11.829
    },
    {
      "id": "shot03-6",
      "text": "再加二分之一乘 λ 乘叶子值向量的平方范",
      "start": 11.829,
      "end": 15.612
    },
    {
      "id": "shot03-7",
      "text": "数。白话说，叶子越多，",
      "start": 15.612,
      "end": 17.573
    },
    {
      "id": "shot03-8",
      "text": "扣分越多；",
      "start": 17.573,
      "end": 18.854
    },
    {
      "id": "shot03-9",
      "text": "叶子输出值越大，",
      "start": 18.854,
      "end": 20.298
    },
    {
      "id": "shot03-10",
      "text": "扣分越多。",
      "start": 20.298,
      "end": 21.461
    },
    {
      "id": "shot03-11",
      "text": "这样模型就不会为了追训练集上一点点误差，",
      "start": 21.461,
      "end": 25.212
    },
    {
      "id": "shot03-12",
      "text": "随意长出很多叶子，",
      "start": 25.212,
      "end": 27.097
    },
    {
      "id": "shot03-13",
      "text": "也不会让某个叶子给出特别激进的修正。",
      "start": 27.097,
      "end": 29.824
    },
    {
      "id": "shot03-14",
      "text": "GBDT 主要靠",
      "start": 30.317,
      "end": 31.32
    },
    {
      "id": "shot03-15",
      "text": "learning_rate、",
      "start": 31.32,
      "end": 32.142
    },
    {
      "id": "shot03-16",
      "text": "max_depth、",
      "start": 32.142,
      "end": 32.945
    },
    {
      "id": "shot03-17",
      "text": "subsample 这些外部旋钮控制过拟",
      "start": 32.945,
      "end": 35.486
    },
    {
      "id": "shot03-18",
      "text": "合；",
      "start": 35.486,
      "end": 36.034
    },
    {
      "id": "shot03-19",
      "text": "XGBoost 把正则直接写进目标函数里。",
      "start": 36.034,
      "end": 39.204
    },
    {
      "id": "shot03-20",
      "text": "这个区别很关键，",
      "start": 39.204,
      "end": 40.508
    },
    {
      "id": "shot03-21",
      "text": "因为后面的叶子值和分裂 Gain 都会从",
      "start": 40.508,
      "end": 43.216
    },
    {
      "id": "shot03-22",
      "text": "同一个目标函数推导出来。",
      "start": 43.216,
      "end": 44.74
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "第三个升级是分裂准则。",
      "start": 0.0,
      "end": 2.124
    },
    {
      "id": "shot04-1",
      "text": "普通决策树可以用基尼指数、信息增益，",
      "start": 2.124,
      "end": 4.989
    },
    {
      "id": "shot04-2",
      "text": "GBDT 回归树会看残差的平方误差下降。",
      "start": 4.989,
      "end": 8.415
    },
    {
      "id": "shot04-3",
      "text": "XGBoost 的分裂 Gain 来自目",
      "start": 8.415,
      "end": 10.699
    },
    {
      "id": "shot04-4",
      "text": "标函数本身。",
      "start": 10.699,
      "end": 11.741
    },
    {
      "id": "shot04-5",
      "text": "它会比较父节点不分裂时的得分，",
      "start": 11.741,
      "end": 14.366
    },
    {
      "id": "shot04-6",
      "text": "以及分成左右子节点后的得分。",
      "start": 14.366,
      "end": 17.351
    },
    {
      "id": "shot04-7",
      "text": "只有左右子节点带来的损失下降，",
      "start": 17.351,
      "end": 20.136
    },
    {
      "id": "shot04-8",
      "text": "超过新增叶子带来的 γ 惩罚，",
      "start": 20.136,
      "end": 22.761
    },
    {
      "id": "shot04-9",
      "text": "分裂才值得做。这样一来，",
      "start": 22.761,
      "end": 24.724
    },
    {
      "id": "shot04-10",
      "text": "停止条件就不只是人为设一个最大深度。",
      "start": 24.724,
      "end": 27.73
    },
    {
      "id": "shot04-11",
      "text": "即使 max_depth 还没到，",
      "start": 28.016,
      "end": 29.801
    },
    {
      "id": "shot04-12",
      "text": "只要继续分裂的 Gain 小于等于 0，",
      "start": 29.801,
      "end": 32.249
    },
    {
      "id": "shot04-13",
      "text": "这个节点就不该再拆。",
      "start": 32.249,
      "end": 33.934
    },
    {
      "id": "shot04-14",
      "text": "对工程来说，",
      "start": 33.934,
      "end": 34.837
    },
    {
      "id": "shot04-15",
      "text": "这比纯靠深度上限更有解释性：",
      "start": 34.837,
      "end": 37.485
    },
    {
      "id": "shot04-16",
      "text": "不是因为树被强行拦住，",
      "start": 37.485,
      "end": 39.35
    },
    {
      "id": "shot04-17",
      "text": "而是因为继续长叶子已经不划算。",
      "start": 39.35,
      "end": 41.597
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "第四类升级是工程优化。",
      "start": 0.0,
      "end": 1.803
    },
    {
      "id": "shot05-1",
      "text": "XGBoost 常被说成快，但要注意，",
      "start": 1.803,
      "end": 5.148
    },
    {
      "id": "shot05-2",
      "text": "它的 boosting 树仍然是串行的。",
      "start": 5.148,
      "end": 7.485
    },
    {
      "id": "shot05-3",
      "text": "第 m 棵树必须等前 m 减 1 棵树训",
      "start": 7.485,
      "end": 10.016
    },
    {
      "id": "shot05-4",
      "text": "练完，",
      "start": 10.016,
      "end": 10.437
    },
    {
      "id": "shot05-5",
      "text": "拿到新的 g 和 h，才能开始。",
      "start": 10.437,
      "end": 12.941
    },
    {
      "id": "shot05-6",
      "text": "它的并行主要发生在单棵树内部，",
      "start": 12.941,
      "end": 15.645
    },
    {
      "id": "shot05-7",
      "text": "比如不同特征的直方图统计可以并行。",
      "start": 15.645,
      "end": 18.93
    },
    {
      "id": "shot05-8",
      "text": "连续特征可以先分桶，",
      "start": 18.93,
      "end": 20.713
    },
    {
      "id": "shot05-9",
      "text": "不必枚举所有原始取值，",
      "start": 20.713,
      "end": 23.057
    },
    {
      "id": "shot05-10",
      "text": "这就是直方图近似。",
      "start": 23.057,
      "end": 24.739
    },
    {
      "id": "shot05-11",
      "text": "列采样让每棵树只看一部分特征，既提速，",
      "start": 24.739,
      "end": 28.185
    },
    {
      "id": "shot05-12",
      "text": "也增加多样性。",
      "start": 28.185,
      "end": 29.187
    },
    {
      "id": "shot05-13",
      "text": "缺失值处理也更自动：",
      "start": 29.656,
      "end": 31.482
    },
    {
      "id": "shot05-14",
      "text": "分裂时可以尝试缺失值走左边还是右边，",
      "start": 31.482,
      "end": 34.731
    },
    {
      "id": "shot05-15",
      "text": "选择收益更高的方向。",
      "start": 34.731,
      "end": 36.476
    },
    {
      "id": "shot05-16",
      "text": "把这些机制叠起来，",
      "start": 36.476,
      "end": 38.181
    },
    {
      "id": "shot05-17",
      "text": "XGBoost 才能在大规模结构化数据上",
      "start": 38.181,
      "end": 41.291
    },
    {
      "id": "shot05-18",
      "text": "又快又稳。",
      "start": 41.291,
      "end": 41.893
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "把随机森林、GBDT、",
      "start": 0.0,
      "end": 1.643
    },
    {
      "id": "shot06-1",
      "text": "XGBoost 放在一张图里会更清楚。",
      "start": 1.643,
      "end": 4.467
    },
    {
      "id": "shot06-2",
      "text": "随机森林属于 bagging，各树独立，",
      "start": 4.467,
      "end": 6.871
    },
    {
      "id": "shot06-3",
      "text": "靠随机样本和随机特征制造差异，",
      "start": 6.871,
      "end": 9.556
    },
    {
      "id": "shot06-4",
      "text": "训练可以并行，",
      "start": 9.556,
      "end": 10.658
    },
    {
      "id": "shot06-5",
      "text": "调参相对轻。",
      "start": 10.658,
      "end": 12.18
    },
    {
      "id": "shot06-6",
      "text": "GBDT 属于 boosting，",
      "start": 12.18,
      "end": 13.763
    },
    {
      "id": "shot06-7",
      "text": "各树串行，",
      "start": 13.763,
      "end": 14.685
    },
    {
      "id": "shot06-8",
      "text": "后一棵树拟合前面模型的负梯度，",
      "start": 14.685,
      "end": 17.249
    },
    {
      "id": "shot06-9",
      "text": "通常精度更高，但训练慢，",
      "start": 17.249,
      "end": 19.272
    },
    {
      "id": "shot06-10",
      "text": "正则不够系统。",
      "start": 19.272,
      "end": 20.154
    },
    {
      "id": "shot06-11",
      "text": "XGBoost 仍然是 boosting，",
      "start": 20.54,
      "end": 22.624
    },
    {
      "id": "shot06-12",
      "text": "仍然一棵棵接力，",
      "start": 22.624,
      "end": 24.066
    },
    {
      "id": "shot06-13",
      "text": "但每个样本传的是一阶导和二阶导，",
      "start": 24.066,
      "end": 26.931
    },
    {
      "id": "shot06-14",
      "text": "叶子值和分裂条件从带正则的目标函数推出来，",
      "start": 26.931,
      "end": 30.558
    },
    {
      "id": "shot06-15",
      "text": "工程上还有直方图和特征级并行。",
      "start": 30.558,
      "end": 33.523
    },
    {
      "id": "shot06-16",
      "text": "记忆上可以这样区分：",
      "start": 33.523,
      "end": 35.086
    },
    {
      "id": "shot06-17",
      "text": "随机森林靠随机多数投票，",
      "start": 35.086,
      "end": 37.51
    },
    {
      "id": "shot06-18",
      "text": "GBDT 靠负梯度逐轮修正，",
      "start": 37.51,
      "end": 40.055
    },
    {
      "id": "shot06-19",
      "text": "XGBoost 靠二阶导和正则把修正做得",
      "start": 40.055,
      "end": 43.12
    },
    {
      "id": "shot06-20",
      "text": "更稳、更快。",
      "start": 43.12,
      "end": 44.162
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这期先建立 XGBoost 的全局图。",
      "start": 0.0,
      "end": 2.783
    },
    {
      "id": "shot07-1",
      "text": "第一，",
      "start": 2.783,
      "end": 3.244
    },
    {
      "id": "shot07-2",
      "text": "它仍然是 boosting，",
      "start": 3.244,
      "end": 4.525
    },
    {
      "id": "shot07-3",
      "text": "不是把树变成并行投票。第二，",
      "start": 4.525,
      "end": 7.088
    },
    {
      "id": "shot07-4",
      "text": "它比 GBDT 多看二阶信息，",
      "start": 7.088,
      "end": 9.531
    },
    {
      "id": "shot07-5",
      "text": "所以不仅知道往哪修，",
      "start": 9.531,
      "end": 11.313
    },
    {
      "id": "shot07-6",
      "text": "也更知道修多少合适。第三，",
      "start": 11.313,
      "end": 14.096
    },
    {
      "id": "shot07-7",
      "text": "它把正则项写进目标函数，",
      "start": 14.096,
      "end": 16.279
    },
    {
      "id": "shot07-8",
      "text": "用 γ 控制叶子数量，",
      "start": 16.279,
      "end": 18.301
    },
    {
      "id": "shot07-9",
      "text": "用 λ 控制叶子值大小。第四，",
      "start": 18.301,
      "end": 21.004
    },
    {
      "id": "shot07-10",
      "text": "它用目标函数推出分裂 Gain，",
      "start": 21.004,
      "end": 23.407
    },
    {
      "id": "shot07-11",
      "text": "让是否分裂有更清楚的数学依据。",
      "start": 23.407,
      "end": 25.87
    },
    {
      "id": "shot07-12",
      "text": "第五，",
      "start": 26.4,
      "end": 26.941
    },
    {
      "id": "shot07-13",
      "text": "它通过直方图、列采样、",
      "start": 26.941,
      "end": 29.083
    },
    {
      "id": "shot07-14",
      "text": "缺失值默认方向和特征级并行，",
      "start": 29.083,
      "end": 32.067
    },
    {
      "id": "shot07-15",
      "text": "把树模型训练做得更工程化。",
      "start": 32.067,
      "end": 34.871
    },
    {
      "id": "shot07-16",
      "text": "下一期我们进入最核心的数学推导：",
      "start": 34.871,
      "end": 37.534
    },
    {
      "id": "shot07-17",
      "text": "从损失加正则开始，",
      "start": 37.534,
      "end": 39.376
    },
    {
      "id": "shot07-18",
      "text": "用二阶泰勒展开，",
      "start": 39.376,
      "end": 40.978
    },
    {
      "id": "shot07-19",
      "text": "把目标函数变成按叶子求和，",
      "start": 40.978,
      "end": 43.542
    },
    {
      "id": "shot07-20",
      "text": "最后推出最优叶子值和分裂 Gain。",
      "start": 43.542,
      "end": 46.185
    }
  ],
