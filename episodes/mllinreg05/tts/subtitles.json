{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们拿到了'偏导等于零'这把钥匙—",
      "start": 0.0,
      "end": 3.005
    },
    {
      "id": "shot01-1",
      "text": "—但多元 LR 有 n 个特征加一个偏置b，",
      "start": 3.005,
      "end": 6.37
    },
    {
      "id": "shot01-2",
      "text": "要联立 n + 1 条偏导方程，",
      "start": 6.37,
      "end": 8.773
    },
    {
      "id": "shot01-3",
      "text": "一行行写太累。",
      "start": 8.773,
      "end": 10.576
    },
    {
      "id": "shot01-4",
      "text": "换个生活场景理解：",
      "start": 10.576,
      "end": 12.238
    },
    {
      "id": "shot01-5",
      "text": "教务处期末出全班成绩单，",
      "start": 12.238,
      "end": 14.589
    },
    {
      "id": "shot01-6",
      "text": "5 个学生 3 门课写在一张表上，",
      "start": 14.589,
      "end": 17.196
    },
    {
      "id": "shot01-7",
      "text": "张三的成绩单语文 70 数学 80 英语",
      "start": 17.196,
      "end": 20.17
    },
    {
      "id": "shot01-8",
      "text": "90 竖着摆就是一个向量，",
      "start": 20.17,
      "end": 22.394
    },
    {
      "id": "shot01-9",
      "text": "全班 5 个学生 3 门课的整张表就是一个矩阵——向量加矩阵就是数据的两种'装法'。",
      "start": 22.394,
      "end": 28.443
    },
    {
      "id": "shot01-11",
      "text": "这一期升级到矩阵语言：",
      "start": 28.81,
      "end": 30.593
    },
    {
      "id": "shot01-12",
      "text": "一行 Xw 覆盖所有样本，",
      "start": 30.593,
      "end": 33.257
    },
    {
      "id": "shot01-13",
      "text": "一行 ∇L = 0 覆盖所有偏导。",
      "start": 33.257,
      "end": 36.622
    },
    {
      "id": "shot01-14",
      "text": "这一期解决三件事：",
      "start": 36.622,
      "end": 38.184
    },
    {
      "id": "shot01-15",
      "text": "标量 / 向量 / 矩阵分清楚 + ML",
      "start": 38.184,
      "end": 41.169
    },
    {
      "id": "shot01-16",
      "text": "形状约定行样本列特征；",
      "start": 41.169,
      "end": 43.413
    },
    {
      "id": "shot01-17",
      "text": "向量点积让单样本预测变一行；",
      "start": 43.413,
      "end": 46.317
    },
    {
      "id": "shot01-18",
      "text": "矩阵乘法让 m 个样本一行覆盖。",
      "start": 46.317,
      "end": 49.402
    },
    {
      "id": "shot01-19",
      "text": "下一期合体偏导和矩阵两件家伙，",
      "start": 49.402,
      "end": 52.226
    },
    {
      "id": "shot01-20",
      "text": "一气呵成推出正规方程。",
      "start": 52.226,
      "end": 53.929
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先把名字理顺。",
      "start": 0.0,
      "end": 1.26
    },
    {
      "id": "shot02-1",
      "text": "一个数字叫标量 scalar，",
      "start": 1.26,
      "end": 3.461
    },
    {
      "id": "shot02-2",
      "text": "比如 56.3 公斤。",
      "start": 3.461,
      "end": 5.622
    },
    {
      "id": "shot02-3",
      "text": "一串数字叠成一列叫向量 vector，",
      "start": 5.622,
      "end": 8.563
    },
    {
      "id": "shot02-4",
      "text": "比如一个学生的身高体重 (160,",
      "start": 8.563,
      "end": 11.544
    },
    {
      "id": "shot02-5",
      "text": "56.3) 写成竖着的两行。",
      "start": 11.544,
      "end": 14.025
    },
    {
      "id": "shot02-6",
      "text": "多个学生的数据排成网格叫矩阵",
      "start": 14.025,
      "end": 16.586
    },
    {
      "id": "shot02-7",
      "text": "matrix——5 行就是 5 个学生，",
      "start": 16.586,
      "end": 19.021
    },
    {
      "id": "shot02-8",
      "text": "2 列就是 2 个特征。",
      "start": 19.021,
      "end": 20.954
    },
    {
      "id": "shot02-9",
      "text": "再升一维就是张量 tensor，",
      "start": 20.954,
      "end": 23.061
    },
    {
      "id": "shot02-10",
      "text": "深度学习里大量用，",
      "start": 23.061,
      "end": 24.666
    },
    {
      "id": "shot02-11",
      "text": "本期不展开。",
      "start": 24.666,
      "end": 25.79
    },
    {
      "id": "shot02-12",
      "text": "机器学习有一条形状约定要记死：行是样本、列是特征、",
      "start": 25.79,
      "end": 30.546
    },
    {
      "id": "shot02-13",
      "text": "向量默认竖着写。",
      "start": 30.546,
      "end": 31.67
    },
    {
      "id": "shot02-14",
      "text": "一份训练数据 X 的形状写成 m × n，",
      "start": 32.12,
      "end": 36.129
    },
    {
      "id": "shot02-15",
      "text": "m 是样本数、",
      "start": 36.129,
      "end": 37.352
    },
    {
      "id": "shot02-16",
      "text": "n 是特征数。",
      "start": 37.352,
      "end": 38.274
    },
    {
      "id": "shot02-17",
      "text": "前面教务处那张表就是 5 × 3（5 学",
      "start": 38.274,
      "end": 40.966
    },
    {
      "id": "shot02-18",
      "text": "生 3 课程）。",
      "start": 40.966,
      "end": 41.501
    },
    {
      "id": "shot02-19",
      "text": "标签 y 是个 m 维列向量。",
      "start": 41.501,
      "end": 43.766
    },
    {
      "id": "shot02-20",
      "text": "这套约定 sklearn / numpy / PyTorch 一致，",
      "start": 43.766,
      "end": 47.334
    },
    {
      "id": "shot02-22",
      "text": "记死了写代码不踩 shape 错误。",
      "start": 47.334,
      "end": 49.279
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "回到 LR 公式。",
      "start": 0.0,
      "end": 1.442
    },
    {
      "id": "shot03-1",
      "text": "一元 y = kx + b，",
      "start": 1.442,
      "end": 3.986
    },
    {
      "id": "shot03-2",
      "text": "多元 y = w1x1 + w2x2 + ... + wnxn + b——n 个加权项加偏置。",
      "start": 3.986,
      "end": 12.419
    },
    {
      "id": "shot03-5",
      "text": "两个 n 维向量对应位置相乘再加起来，",
      "start": 12.419,
      "end": 15.243
    },
    {
      "id": "shot03-6",
      "text": "这个操作有专门名字：",
      "start": 15.243,
      "end": 16.685
    },
    {
      "id": "shot03-7",
      "text": "向量点积 dot product。",
      "start": 16.685,
      "end": 18.668
    },
    {
      "id": "shot03-8",
      "text": "用矩阵记号写成 wᵀx，",
      "start": 18.668,
      "end": 21.713
    },
    {
      "id": "shot03-9",
      "text": "T 是转置 transpose 的缩写。",
      "start": 21.713,
      "end": 23.656
    },
    {
      "id": "shot03-10",
      "text": "点积的几何含义本期不展开，",
      "start": 23.876,
      "end": 26.0
    },
    {
      "id": "shot03-11",
      "text": "先看代数：",
      "start": 26.0,
      "end": 27.262
    },
    {
      "id": "shot03-12",
      "text": "把 w 和 x 这两个 n 维列向量相乘，",
      "start": 27.262,
      "end": 30.227
    },
    {
      "id": "shot03-13",
      "text": "相同位置的数字相乘，",
      "start": 30.227,
      "end": 31.95
    },
    {
      "id": "shot03-14",
      "text": "n 个乘积加起来——结果是一个标量。",
      "start": 31.95,
      "end": 34.675
    },
    {
      "id": "shot03-15",
      "text": "这就是单样本 LR 预测：",
      "start": 34.675,
      "end": 37.013
    },
    {
      "id": "shot03-16",
      "text": "ŷ = wᵀx + b。",
      "start": 37.013,
      "end": 39.904
    },
    {
      "id": "shot03-17",
      "text": "原本 n 个加号的式子，",
      "start": 39.904,
      "end": 41.627
    },
    {
      "id": "shot03-18",
      "text": "现在一个点积写完。",
      "start": 41.627,
      "end": 43.09
    },
    {
      "id": "shot03-19",
      "text": "这是从'手算每一项'到'向量化'的第一步。",
      "start": 43.09,
      "end": 45.895
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开 demo。",
      "start": 0.0,
      "end": 0.941
    },
    {
      "id": "shot04-1",
      "text": "这个 demo 不挂 LR 真实数据，",
      "start": 0.941,
      "end": 3.084
    },
    {
      "id": "shot04-2",
      "text": "用最小的玩具矩阵演示矩阵乘法机制。",
      "start": 3.084,
      "end": 6.248
    },
    {
      "id": "shot04-3",
      "text": "先看镜头 A 向量：",
      "start": 6.248,
      "end": 7.709
    },
    {
      "id": "shot04-4",
      "text": "两个 2 维向量 a 和 b 用箭头画出来，",
      "start": 7.709,
      "end": 10.573
    },
    {
      "id": "shot04-5",
      "text": "拖滑块改坐标，",
      "start": 10.573,
      "end": 11.895
    },
    {
      "id": "shot04-6",
      "text": "右侧实时显示点积、",
      "start": 11.895,
      "end": 13.697
    },
    {
      "id": "shot04-7",
      "text": "L1 范数、",
      "start": 13.697,
      "end": 14.658
    },
    {
      "id": "shot04-8",
      "text": "L2 范数、",
      "start": 14.658,
      "end": 15.639
    },
    {
      "id": "shot04-9",
      "text": "夹角余弦。",
      "start": 15.639,
      "end": 16.961
    },
    {
      "id": "shot04-10",
      "text": "点积有个直观含义：",
      "start": 16.961,
      "end": 18.483
    },
    {
      "id": "shot04-11",
      "text": "方向越对齐数值越大，",
      "start": 18.483,
      "end": 20.305
    },
    {
      "id": "shot04-12",
      "text": "互相垂直时点积是 0。",
      "start": 20.305,
      "end": 21.887
    },
    {
      "id": "shot04-13",
      "text": "把 b 的 x 坐标慢慢拖到 0——b",
      "start": 22.421,
      "end": 25.147
    },
    {
      "id": "shot04-14",
      "text": "旋转到和 a 垂直，",
      "start": 25.147,
      "end": 26.595
    },
    {
      "id": "shot04-15",
      "text": "cosθ 实时降到 0、",
      "start": 26.595,
      "end": 28.295
    },
    {
      "id": "shot04-16",
      "text": "点积 a 点 b 也降到 0，",
      "start": 28.295,
      "end": 29.999
    },
    {
      "id": "shot04-17",
      "text": "绿色投影线消失。",
      "start": 29.999,
      "end": 31.402
    },
    {
      "id": "shot04-18",
      "text": "这就是'方向越垂直点积越小'的视觉证据。",
      "start": 31.402,
      "end": 35.111
    },
    {
      "id": "shot04-19",
      "text": "切到镜头 B 矩阵乘：",
      "start": 35.111,
      "end": 36.695
    },
    {
      "id": "shot04-20",
      "text": "A(3×2) · w(2维)，得到 3 维向量。",
      "start": 36.695,
      "end": 41.466
    },
    {
      "id": "shot04-23",
      "text": "屏幕上 A 的每一行用色块染色，",
      "start": 42.031,
      "end": 44.814
    },
    {
      "id": "shot04-24",
      "text": "w 用色块染色，",
      "start": 44.814,
      "end": 46.396
    },
    {
      "id": "shot04-25",
      "text": "乘法过程动画展开：",
      "start": 46.396,
      "end": 48.278
    },
    {
      "id": "shot04-26",
      "text": "A 第 i 行的两个数字分别和 w 的两",
      "start": 48.278,
      "end": 51.502
    },
    {
      "id": "shot04-27",
      "text": "个数字相乘再相加，",
      "start": 51.502,
      "end": 53.184
    },
    {
      "id": "shot04-28",
      "text": "得到结果向量第 i 个分量。",
      "start": 53.184,
      "end": 55.706
    },
    {
      "id": "shot04-29",
      "text": "拖'行 i'滑块依次高亮 0、1、2 行，",
      "start": 55.706,
      "end": 59.01
    },
    {
      "id": "shot04-30",
      "text": "每次结果格子填一个数字。",
      "start": 59.01,
      "end": 61.555
    },
    {
      "id": "shot04-31",
      "text": "最后切到镜头 C LR 预演：",
      "start": 61.555,
      "end": 64.301
    },
    {
      "id": "shot04-32",
      "text": "X 是 4×3 矩阵，w 是 3 维权重，Xw 输出 4 维预测向量 ŷ。",
      "start": 64.301,
      "end": 74.383
    },
    {
      "id": "shot04-36",
      "text": "这就是矩阵乘法 Xw 的全部内涵。",
      "start": 74.799,
      "end": 77.972
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "把镜头 C 的画面落地到代码——这是矩阵",
      "start": 0.0,
      "end": 3.186
    },
    {
      "id": "shot05-1",
      "text": "化最大的工程价值。",
      "start": 3.186,
      "end": 4.889
    },
    {
      "id": "shot05-2",
      "text": "手写 for 循环算 m 个样本预测，",
      "start": 4.889,
      "end": 7.774
    },
    {
      "id": "shot05-3",
      "text": "需要写 m 次循环 + n 次点积，",
      "start": 7.774,
      "end": 10.319
    },
    {
      "id": "shot05-4",
      "text": "Python 解释器一行行执行慢得要命。",
      "start": 10.319,
      "end": 13.305
    },
    {
      "id": "shot05-5",
      "text": "换成 Xw，",
      "start": 13.305,
      "end": 14.948
    },
    {
      "id": "shot05-6",
      "text": "一行 numpy 表达式，",
      "start": 14.948,
      "end": 16.551
    },
    {
      "id": "shot05-7",
      "text": "底层走 C 实现的 BLAS 库，",
      "start": 16.551,
      "end": 19.316
    },
    {
      "id": "shot05-8",
      "text": "加上 SIMD 指令并行——同样的运算快",
      "start": 19.316,
      "end": 22.762
    },
    {
      "id": "shot05-9",
      "text": "100 倍以上。",
      "start": 22.762,
      "end": 23.503
    },
    {
      "id": "shot05-10",
      "text": "这就是为什么所有 ML 框架代码到处都是矩阵运算：",
      "start": 24.052,
      "end": 28.576
    },
    {
      "id": "shot05-11",
      "text": "不是为了好看，",
      "start": 28.576,
      "end": 29.677
    },
    {
      "id": "shot05-12",
      "text": "是运行速度相差几十到几百倍。",
      "start": 29.677,
      "end": 32.64
    },
    {
      "id": "shot05-13",
      "text": "LR 的训练和预测两个核心步骤都是矩阵乘法。",
      "start": 32.64,
      "end": 36.984
    },
    {
      "id": "shot05-14",
      "text": "训练算 XᵀX 这种乘积，",
      "start": 36.984,
      "end": 40.547
    },
    {
      "id": "shot05-15",
      "text": "预测算 Xw——一行公式背后是",
      "start": 40.547,
      "end": 43.73
    },
    {
      "id": "shot05-16",
      "text": "BLAS 把你 1 万样本的预测从几秒压",
      "start": 43.73,
      "end": 47.213
    },
    {
      "id": "shot05-17",
      "text": "到几十毫秒。",
      "start": 47.213,
      "end": 48.394
    },
    {
      "id": "shot05-18",
      "text": "这套加速思路深度学习更狠：",
      "start": 48.394,
      "end": 50.957
    },
    {
      "id": "shot05-19",
      "text": "GPU 同时算几千个矩阵元素，",
      "start": 50.957,
      "end": 53.771
    },
    {
      "id": "shot05-20",
      "text": "几十层网络的前向反向传播全是矩阵乘。",
      "start": 53.771,
      "end": 57.047
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "再补三个矩阵性质，",
      "start": 0.0,
      "end": 1.663
    },
    {
      "id": "shot06-1",
      "text": "下期下下期会反复用。",
      "start": 1.663,
      "end": 3.908
    },
    {
      "id": "shot06-2",
      "text": "第一个转置 transpose，",
      "start": 3.908,
      "end": 5.531
    },
    {
      "id": "shot06-3",
      "text": "把矩阵的行变列、列变行，",
      "start": 5.531,
      "end": 7.656
    },
    {
      "id": "shot06-4",
      "text": "符号写成右上角加 T。",
      "start": 7.656,
      "end": 9.941
    },
    {
      "id": "shot06-5",
      "text": "LR 正规方程会出现 XᵀX，",
      "start": 9.941,
      "end": 13.949
    },
    {
      "id": "shot06-6",
      "text": "这就是把列特征换成行特征再相乘。",
      "start": 13.949,
      "end": 17.416
    },
    {
      "id": "shot06-7",
      "text": "第二个逆 inverse，",
      "start": 17.416,
      "end": 18.839
    },
    {
      "id": "shot06-8",
      "text": "类似数字倒数：A·A⁻¹ = I。",
      "start": 18.839,
      "end": 22.607
    },
    {
      "id": "shot06-9",
      "text": "但矩阵的逆不一定存在，",
      "start": 22.951,
      "end": 24.713
    },
    {
      "id": "shot06-10",
      "text": "特征共线时 XᵀX 不可逆，",
      "start": 24.713,
      "end": 27.556
    },
    {
      "id": "shot06-11",
      "text": "正规方程失效——这是下期 sklearn",
      "start": 27.556,
      "end": 30.099
    },
    {
      "id": "shot06-12",
      "text": "不直接求逆走 SVD 的原因。",
      "start": 30.099,
      "end": 32.402
    },
    {
      "id": "shot06-13",
      "text": "第三个矩阵乘法不满足交换律：",
      "start": 32.402,
      "end": 34.624
    },
    {
      "id": "shot06-14",
      "text": "AB ≠ BA，",
      "start": 34.624,
      "end": 36.586
    },
    {
      "id": "shot06-15",
      "text": "连形状都可能不允许。",
      "start": 36.586,
      "end": 38.709
    },
    {
      "id": "shot06-16",
      "text": "最后两个范数也提一下：",
      "start": 38.709,
      "end": 40.451
    },
    {
      "id": "shot06-17",
      "text": "L2 范数是各分量平方和开方，",
      "start": 40.451,
      "end": 43.094
    },
    {
      "id": "shot06-18",
      "text": "MSE 损失就是残差向量的 L2 范数平方；",
      "start": 43.094,
      "end": 46.978
    },
    {
      "id": "shot06-19",
      "text": "L1 范数是各分量绝对值之和。",
      "start": 46.978,
      "end": 49.281
    },
    {
      "id": "shot06-20",
      "text": "L1 砍特征 / L2 整体收缩，",
      "start": 49.889,
      "end": 52.674
    },
    {
      "id": "shot06-21",
      "text": "留给正则化那一期展开。",
      "start": 52.674,
      "end": 54.147
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.762
    },
    {
      "id": "shot07-1",
      "text": "我们解决了 LR 矩阵化语言三件事：第一，",
      "start": 0.762,
      "end": 4.068
    },
    {
      "id": "shot07-2",
      "text": "标量向量矩阵分清楚加 ML 形状约定，",
      "start": 4.068,
      "end": 7.394
    },
    {
      "id": "shot07-3",
      "text": "行样本列特征向量竖；第二，",
      "start": 7.394,
      "end": 9.819
    },
    {
      "id": "shot07-4",
      "text": "向量点积让单样本预测从 n 项加号变成一行 wᵀx；第三，",
      "start": 9.819,
      "end": 16.091
    },
    {
      "id": "shot07-6",
      "text": "矩阵乘法让 m 个样本一行覆盖，",
      "start": 16.091,
      "end": 18.977
    },
    {
      "id": "shot07-7",
      "text": "向量化比 for 循环快 100 倍。",
      "start": 18.977,
      "end": 21.141
    },
    {
      "id": "shot07-8",
      "text": "点到没展开的：",
      "start": 21.37,
      "end": 22.472
    },
    {
      "id": "shot07-9",
      "text": "张量推广留给深度学习；",
      "start": 22.472,
      "end": 24.476
    },
    {
      "id": "shot07-10",
      "text": "矩阵求逆细节工程上调 numpy 一行；",
      "start": 24.476,
      "end": 27.181
    },
    {
      "id": "shot07-11",
      "text": "点积的几何含义和 cosθ 几何意义不展开；",
      "start": 27.181,
      "end": 30.367
    },
    {
      "id": "shot07-12",
      "text": "L1 / L2 范数留给正则化那一期。",
      "start": 30.367,
      "end": 33.573
    },
    {
      "id": "shot07-13",
      "text": "下一期我们把上期偏导和这一期矩阵两件家伙合体，",
      "start": 33.573,
      "end": 37.64
    },
    {
      "id": "shot07-14",
      "text": "一气呵成推出 LR 解析解 w = (XᵀX)⁻¹Xᵀy——经典正规方程。",
      "start": 37.64,
      "end": 44.613
    }
  ],
