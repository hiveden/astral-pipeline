{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期加州房价 pipeline 顺利收",
      "start": 0.0,
      "end": 2.622
    },
    {
      "id": "shot01-1",
      "text": "尾——但 R 平方只有 0.6094 还",
      "start": 2.622,
      "end": 5.645
    },
    {
      "id": "shot01-2",
      "text": "有 40% 没解释，",
      "start": 5.645,
      "end": 7.486
    },
    {
      "id": "shot01-3",
      "text": "自然想到加更多特征 + 用更复杂模型应该能改进。",
      "start": 7.486,
      "end": 11.81
    },
    {
      "id": "shot01-4",
      "text": "但这里有个反直觉的现象：",
      "start": 11.81,
      "end": 13.771
    },
    {
      "id": "shot01-5",
      "text": "训练误差越小测试误差反而越大——拟合得太",
      "start": 13.771,
      "end": 17.174
    },
    {
      "id": "shot01-6",
      "text": "好不是好事，是病。",
      "start": 17.174,
      "end": 19.075
    },
    {
      "id": "shot01-7",
      "text": "这一期我们看 LR 的另一面：",
      "start": 19.075,
      "end": 21.257
    },
    {
      "id": "shot01-8",
      "text": "欠拟合 / 过拟合 / U 形曲线。",
      "start": 21.257,
      "end": 23.099
    },
    {
      "id": "shot01-9",
      "text": "这一期解决三件事：",
      "start": 23.677,
      "end": 25.379
    },
    {
      "id": "shot01-10",
      "text": "欠拟合 / 良好 / 过拟合三档区分 + 训练测试误差分化的典型信号；",
      "start": 25.379,
      "end": 30.807
    },
    {
      "id": "shot01-12",
      "text": "多项式次数从 1 到 12 拖动",
      "start": 30.807,
      "end": 33.45
    },
    {
      "id": "shot01-13",
      "text": "demo 演示 U 形曲线，",
      "start": 33.45,
      "end": 35.453
    },
    {
      "id": "shot01-14",
      "text": "测试 MSE 先降后升的视觉证据；",
      "start": 35.453,
      "end": 38.985
    },
    {
      "id": "shot01-15",
      "text": "4 类解决办法预告 E11 正则化。",
      "start": 38.985,
      "end": 42.222
    },
    {
      "id": "shot01-16",
      "text": "下一期讲药方：",
      "start": 42.222,
      "end": 43.584
    },
    {
      "id": "shot01-17",
      "text": "L1 砍特征 / L2 整体收缩。",
      "start": 43.584,
      "end": 46.108
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先把三档区分清楚。",
      "start": 0.0,
      "end": 1.683
    },
    {
      "id": "shot02-1",
      "text": "欠拟合 underfitting：",
      "start": 1.683,
      "end": 3.166
    },
    {
      "id": "shot02-2",
      "text": "模型太简单装不下数据规律——训练误差很大",
      "start": 3.166,
      "end": 6.632
    },
    {
      "id": "shot02-3",
      "text": "测试误差也很大，",
      "start": 6.632,
      "end": 8.055
    },
    {
      "id": "shot02-4",
      "text": "肉眼看拟合曲线和数据点偏离明显。",
      "start": 8.055,
      "end": 11.12
    },
    {
      "id": "shot02-5",
      "text": "比如用一条直线去拟合一个抛物线趋势的数据，",
      "start": 11.12,
      "end": 14.606
    },
    {
      "id": "shot02-6",
      "text": "永远拟合不上。",
      "start": 14.606,
      "end": 16.009
    },
    {
      "id": "shot02-7",
      "text": "良好 good fit：",
      "start": 16.009,
      "end": 17.431
    },
    {
      "id": "shot02-8",
      "text": "模型复杂度刚好——训练误差小测试误差也小，",
      "start": 17.431,
      "end": 21.539
    },
    {
      "id": "shot02-9",
      "text": "两个误差几乎一致，",
      "start": 21.539,
      "end": 23.316
    },
    {
      "id": "shot02-10",
      "text": "拟合曲线穿过数据云的中心。",
      "start": 23.316,
      "end": 25.265
    },
    {
      "id": "shot02-11",
      "text": "过拟合 overfitting：",
      "start": 25.768,
      "end": 27.03
    },
    {
      "id": "shot02-12",
      "text": "模型太复杂把训练数据里的噪声也当规律学了",
      "start": 27.03,
      "end": 30.595
    },
    {
      "id": "shot02-13",
      "text": "——训练误差极小甚至接近 0，",
      "start": 30.595,
      "end": 32.699
    },
    {
      "id": "shot02-14",
      "text": "但测试误差暴增，",
      "start": 32.699,
      "end": 34.261
    },
    {
      "id": "shot02-15",
      "text": "拟合曲线为了穿过每个训练点而扭来扭去，",
      "start": 34.261,
      "end": 37.446
    },
    {
      "id": "shot02-16",
      "text": "对新数据完全不准。",
      "start": 37.446,
      "end": 39.269
    },
    {
      "id": "shot02-17",
      "text": "判定标志一句话：",
      "start": 39.269,
      "end": 40.711
    },
    {
      "id": "shot02-18",
      "text": "训练误差和测试误差曲线分化是过拟合的典型信号。",
      "start": 40.711,
      "end": 45.057
    },
    {
      "id": "shot02-19",
      "text": "这就是为什么 ML 必须留测试集——光看",
      "start": 45.057,
      "end": 48.322
    },
    {
      "id": "shot02-20",
      "text": "训练误差永远是误判。",
      "start": 48.322,
      "end": 49.785
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "用一组合成数据走一遍。",
      "start": 0.0,
      "end": 1.922
    },
    {
      "id": "shot03-1",
      "text": "生成 100 个点 x 在负 3 到 3",
      "start": 1.922,
      "end": 4.705
    },
    {
      "id": "shot03-2",
      "text": "之间均匀分布，",
      "start": 4.705,
      "end": 5.907
    },
    {
      "id": "shot03-3",
      "text": "y = 0.5x² + x + 2 加上N(0,",
      "start": 5.907,
      "end": 10.192
    },
    {
      "id": "shot03-4",
      "text": "1) 高斯噪声——本质是带噪声的抛物线。三档实测：",
      "start": 10.192,
      "end": 14.536
    },
    {
      "id": "shot03-5",
      "text": "第一档只用 X 一次项，",
      "start": 14.536,
      "end": 16.519
    },
    {
      "id": "shot03-6",
      "text": "相当于线性回归直线拟合，",
      "start": 16.519,
      "end": 18.821
    },
    {
      "id": "shot03-7",
      "text": "训练 MSE 等于 3.075、",
      "start": 18.821,
      "end": 21.645
    },
    {
      "id": "shot03-8",
      "text": "测试 MSE 等于 3.153——欠拟合，",
      "start": 21.645,
      "end": 25.068
    },
    {
      "id": "shot03-9",
      "text": "模型连抛物线趋势都装不下。",
      "start": 25.068,
      "end": 27.131
    },
    {
      "id": "shot03-10",
      "text": "第二档加上 X 平方项变成多项式 LR，",
      "start": 27.588,
      "end": 31.252
    },
    {
      "id": "shot03-11",
      "text": "训练 MSE 跌到 1.099、",
      "start": 31.252,
      "end": 33.755
    },
    {
      "id": "shot03-12",
      "text": "测试 MSE 1.112——良好拟合，",
      "start": 33.755,
      "end": 36.698
    },
    {
      "id": "shot03-13",
      "text": "因为数据本来就是抛物线生成的，",
      "start": 36.698,
      "end": 39.094
    },
    {
      "id": "shot03-14",
      "text": "2 次模型刚好匹配。",
      "start": 39.094,
      "end": 41.103
    },
    {
      "id": "shot03-15",
      "text": "第三档把次数推到 X 到 X 的 10",
      "start": 41.103,
      "end": 44.106
    },
    {
      "id": "shot03-16",
      "text": "次方共 10 个特征，",
      "start": 44.106,
      "end": 45.568
    },
    {
      "id": "shot03-17",
      "text": "训练 MSE 继续降到 0.85 左右—",
      "start": 45.568,
      "end": 48.561
    },
    {
      "id": "shot03-18",
      "text": "—但测试 MSE 反弹到 1.415。",
      "start": 48.561,
      "end": 51.294
    },
    {
      "id": "shot03-19",
      "text": "注意第三档的反弹：",
      "start": 51.527,
      "end": 52.973
    },
    {
      "id": "shot03-20",
      "text": "训练误差还在降但测试误差升了——这就是过",
      "start": 52.973,
      "end": 56.386
    },
    {
      "id": "shot03-21",
      "text": "拟合的数字证据，",
      "start": 56.386,
      "end": 57.992
    },
    {
      "id": "shot03-22",
      "text": "模型把噪声也学进去了。",
      "start": 57.992,
      "end": 59.779
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开 demo 看可视化的 U 形。",
      "start": 0.0,
      "end": 2.363
    },
    {
      "id": "shot04-1",
      "text": "屏幕上一组散点是合成数据，",
      "start": 2.363,
      "end": 4.826
    },
    {
      "id": "shot04-2",
      "text": "红色拟合曲线随多项式次数 degree变化。",
      "start": 4.826,
      "end": 8.451
    },
    {
      "id": "shot04-3",
      "text": "下方两条曲线：",
      "start": 8.451,
      "end": 9.732
    },
    {
      "id": "shot04-4",
      "text": "蓝色是训练 MSE 随 degree 的变化，",
      "start": 9.732,
      "end": 12.836
    },
    {
      "id": "shot04-5",
      "text": "红色是测试 MSE 随 degree 的变化。",
      "start": 12.836,
      "end": 16.08
    },
    {
      "id": "shot04-6",
      "text": "先看预设 A 欠拟合 degree 等于1：",
      "start": 16.08,
      "end": 18.844
    },
    {
      "id": "shot04-7",
      "text": "拟合曲线是条直线，",
      "start": 18.844,
      "end": 20.566
    },
    {
      "id": "shot04-8",
      "text": "明显贴不上抛物线散点，",
      "start": 20.566,
      "end": 22.829
    },
    {
      "id": "shot04-9",
      "text": "训练和测试误差都在 3 左右。",
      "start": 22.829,
      "end": 25.072
    },
    {
      "id": "shot04-10",
      "text": "切到预设 B 刚好 degree 等于2：",
      "start": 25.527,
      "end": 27.868
    },
    {
      "id": "shot04-11",
      "text": "拟合曲线变成抛物线穿过散点中心，",
      "start": 27.868,
      "end": 31.389
    },
    {
      "id": "shot04-12",
      "text": "训练测试都跌到 1 左右——视觉上和数字",
      "start": 31.389,
      "end": 34.77
    },
    {
      "id": "shot04-13",
      "text": "上都最优。",
      "start": 34.77,
      "end": 35.97
    },
    {
      "id": "shot04-14",
      "text": "切到预设 C 微过拟合 degree 等于 5：",
      "start": 35.97,
      "end": 39.131
    },
    {
      "id": "shot04-15",
      "text": "拟合曲线开始有小幅扭动，",
      "start": 39.131,
      "end": 41.752
    },
    {
      "id": "shot04-16",
      "text": "训练继续往下走但测试已经开始爬升。",
      "start": 41.752,
      "end": 45.013
    },
    {
      "id": "shot04-17",
      "text": "再切预设 D 严重过拟合 degree",
      "start": 45.013,
      "end": 47.361
    },
    {
      "id": "shot04-18",
      "text": "等于 12：",
      "start": 47.361,
      "end": 48.525
    },
    {
      "id": "shot04-19",
      "text": "拟合曲线疯狂扭曲为了穿过每个训练点，",
      "start": 48.525,
      "end": 52.017
    },
    {
      "id": "shot04-20",
      "text": "训练 MSE 接近 0 但测试 MSE暴增。",
      "start": 52.017,
      "end": 55.308
    },
    {
      "id": "shot04-21",
      "text": "回看下方两条曲线：",
      "start": 55.86,
      "end": 57.503
    },
    {
      "id": "shot04-22",
      "text": "蓝色训练 MSE 单调下降、",
      "start": 57.503,
      "end": 60.106
    },
    {
      "id": "shot04-23",
      "text": "红色测试 MSE 在 degree 等于",
      "start": 60.106,
      "end": 62.85
    },
    {
      "id": "shot04-24",
      "text": "2 时最低后向上爬——经典 U 形。",
      "start": 62.85,
      "end": 66.215
    },
    {
      "id": "shot04-25",
      "text": "最后切到 E 自定义模式，",
      "start": 66.215,
      "end": 68.218
    },
    {
      "id": "shot04-26",
      "text": "慢拖 degree 从 1 一直到 12，",
      "start": 68.218,
      "end": 70.582
    },
    {
      "id": "shot04-27",
      "text": "连续看拟合曲线从直线 → 抛物线 → 轻",
      "start": 70.582,
      "end": 74.307
    },
    {
      "id": "shot04-28",
      "text": "微扭曲 → 疯狂扭曲的全过程，",
      "start": 74.307,
      "end": 77.111
    },
    {
      "id": "shot04-29",
      "text": "下方两条曲线红蓝交叉点和 U 形拐点同步",
      "start": 77.111,
      "end": 80.937
    },
    {
      "id": "shot04-30",
      "text": "呈现——这就是过拟合最直观的动态证据。",
      "start": 80.937,
      "end": 83.961
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "为什么会过拟合？两个角度。代数角度：",
      "start": 0.0,
      "end": 3.162
    },
    {
      "id": "shot05-1",
      "text": "参数太多自由度太高，",
      "start": 3.162,
      "end": 5.083
    },
    {
      "id": "shot05-2",
      "text": "模型学到了噪声而不是规律。",
      "start": 5.083,
      "end": 7.524
    },
    {
      "id": "shot05-3",
      "text": "统计角度有个经典权衡叫偏差-方差权衡",
      "start": 7.524,
      "end": 11.587
    },
    {
      "id": "shot05-4",
      "text": "bias-variance",
      "start": 11.587,
      "end": 12.588
    },
    {
      "id": "shot05-5",
      "text": "tradeoff。",
      "start": 12.588,
      "end": 13.728
    },
    {
      "id": "shot05-6",
      "text": "bias 偏差是模型对真实规律的系统性偏",
      "start": 13.728,
      "end": 17.19
    },
    {
      "id": "shot05-7",
      "text": "离——模型太简单时高 bias 装不下规",
      "start": 17.19,
      "end": 20.092
    },
    {
      "id": "shot05-8",
      "text": "律就是欠拟合。",
      "start": 20.092,
      "end": 21.377
    },
    {
      "id": "shot05-9",
      "text": "variance 方差是模型对训练数据的",
      "start": 21.377,
      "end": 24.127
    },
    {
      "id": "shot05-10",
      "text": "敏感度——模型太复杂时高",
      "start": 24.127,
      "end": 26.415
    },
    {
      "id": "shot05-11",
      "text": "variance 换组训练数据预测就变了，",
      "start": 26.415,
      "end": 29.165
    },
    {
      "id": "shot05-12",
      "text": "就是过拟合。",
      "start": 29.165,
      "end": 29.848
    },
    {
      "id": "shot05-13",
      "text": "良好拟合就是两者平衡的甜点。",
      "start": 30.405,
      "end": 33.167
    },
    {
      "id": "shot05-14",
      "text": "怎么解决过拟合？",
      "start": 33.167,
      "end": 34.548
    },
    {
      "id": "shot05-15",
      "text": "4 类办法。",
      "start": 34.548,
      "end": 35.409
    },
    {
      "id": "shot05-16",
      "text": "第一清洗数据，",
      "start": 35.409,
      "end": 36.69
    },
    {
      "id": "shot05-17",
      "text": "去掉异常点和噪声标签——脏数据是过拟合的温床。",
      "start": 36.69,
      "end": 40.894
    },
    {
      "id": "shot05-18",
      "text": "第二加更多数据——数据多到一定量噪声被平均掉，",
      "start": 40.894,
      "end": 45.117
    },
    {
      "id": "shot05-19",
      "text": "模型只能学规律。",
      "start": 45.117,
      "end": 46.959
    },
    {
      "id": "shot05-20",
      "text": "第三减少特征——把没用的高次特征去掉、",
      "start": 46.959,
      "end": 50.282
    },
    {
      "id": "shot05-21",
      "text": "关联特征合并，",
      "start": 50.282,
      "end": 51.563
    },
    {
      "id": "shot05-22",
      "text": "让模型自由度降下来。",
      "start": 51.563,
      "end": 53.344
    },
    {
      "id": "shot05-23",
      "text": "第四正则化 regularization",
      "start": 53.344,
      "end": 55.411
    },
    {
      "id": "shot05-24",
      "text": "——给损失函数加一个'惩罚复杂度'的项，",
      "start": 55.411,
      "end": 58.461
    },
    {
      "id": "shot05-25",
      "text": "让训练自动倾向'简单'的模型。",
      "start": 58.461,
      "end": 60.488
    },
    {
      "id": "shot05-26",
      "text": "前 3 类都是训练前的人工补救，",
      "start": 60.94,
      "end": 63.552
    },
    {
      "id": "shot05-27",
      "text": "第 4 类是从损失函数本身下手最优雅最工",
      "start": 63.552,
      "end": 67.129
    },
    {
      "id": "shot05-28",
      "text": "程化——下期专门讲。",
      "start": 67.129,
      "end": 68.676
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.961
    },
    {
      "id": "shot06-1",
      "text": "我们解决了过拟合三件事：第一，",
      "start": 0.961,
      "end": 3.405
    },
    {
      "id": "shot06-2",
      "text": "欠拟合 / 良好 / 过拟合三档，",
      "start": 3.405,
      "end": 5.347
    },
    {
      "id": "shot06-3",
      "text": "判定看训练 vs 测试误差是否分化；第二，",
      "start": 5.347,
      "end": 8.692
    },
    {
      "id": "shot06-4",
      "text": "多项式次数 1 到 12 拖动 U 形曲线，",
      "start": 8.692,
      "end": 11.556
    },
    {
      "id": "shot06-5",
      "text": "测试 MSE 在 degree 等于 2时最低、",
      "start": 11.556,
      "end": 14.34
    },
    {
      "id": "shot06-6",
      "text": "degree 越高越差；第三，",
      "start": 14.34,
      "end": 16.864
    },
    {
      "id": "shot06-7",
      "text": "bias 高欠拟合、",
      "start": 16.864,
      "end": 17.945
    },
    {
      "id": "shot06-8",
      "text": "variance 高过拟合，",
      "start": 17.945,
      "end": 19.387
    },
    {
      "id": "shot06-9",
      "text": "背后是经典权衡。",
      "start": 19.387,
      "end": 20.669
    },
    {
      "id": "shot06-10",
      "text": "点到没展开的：",
      "start": 20.898,
      "end": 22.119
    },
    {
      "id": "shot06-11",
      "text": "bias-variance 严格数学分解",
      "start": 22.119,
      "end": 24.562
    },
    {
      "id": "shot06-12",
      "text": "留给统计学习理论；",
      "start": 24.562,
      "end": 26.384
    },
    {
      "id": "shot06-13",
      "text": "交叉验证选最优 degree 的网格搜索",
      "start": 26.384,
      "end": 29.707
    },
    {
      "id": "shot06-14",
      "text": "KNN 章已经讲过；",
      "start": 29.707,
      "end": 31.769
    },
    {
      "id": "shot06-15",
      "text": "早停 early stopping 这种",
      "start": 31.769,
      "end": 33.771
    },
    {
      "id": "shot06-16",
      "text": "动态过拟合控制留给深度学习；",
      "start": 33.771,
      "end": 36.534
    },
    {
      "id": "shot06-17",
      "text": "模型集成 ensemble 留给 RF / GBDT。",
      "start": 36.534,
      "end": 40.579
    },
    {
      "id": "shot06-19",
      "text": "下一期讲过拟合最工程化的药方——正则化。",
      "start": 40.579,
      "end": 44.302
    },
    {
      "id": "shot06-20",
      "text": "在损失函数里直接加一个权重的惩罚项，",
      "start": 44.302,
      "end": 47.726
    },
    {
      "id": "shot06-21",
      "text": "让模型自动收敛到'权重小'的方向。",
      "start": 47.726,
      "end": 50.449
    },
    {
      "id": "shot06-22",
      "text": "L1 正则化让权重稀疏直接砍掉某些特征、",
      "start": 50.862,
      "end": 54.893
    },
    {
      "id": "shot06-23",
      "text": "L2 正则化让所有权重整体缩水避免极端值。",
      "start": 54.893,
      "end": 58.964
    },
    {
      "id": "shot06-24",
      "text": "这就是 LR 章最后一期。",
      "start": 58.964,
      "end": 60.609
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.593
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
