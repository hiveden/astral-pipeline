{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们看到，",
      "start": 0.0,
      "end": 1.342
    },
    {
      "id": "shot01-1",
      "text": "决策树每一刀都想把样本切得更纯。",
      "start": 1.342,
      "end": 4.385
    },
    {
      "id": "shot01-2",
      "text": "但“更纯”不能只靠眼睛看，",
      "start": 4.385,
      "end": 6.708
    },
    {
      "id": "shot01-3",
      "text": "算法需要一个数字。",
      "start": 6.708,
      "end": 8.329
    },
    {
      "id": "shot01-4",
      "text": "想象一个袋子里有 100 个球。",
      "start": 8.329,
      "end": 10.612
    },
    {
      "id": "shot01-5",
      "text": "如果 100 个全是红球，",
      "start": 10.612,
      "end": 12.434
    },
    {
      "id": "shot01-6",
      "text": "你闭眼摸一个也知道是红球，",
      "start": 12.434,
      "end": 14.757
    },
    {
      "id": "shot01-7",
      "text": "这叫几乎没有不确定性。",
      "start": 14.757,
      "end": 17.06
    },
    {
      "id": "shot01-8",
      "text": "如果 50 个红球、",
      "start": 17.06,
      "end": 18.424
    },
    {
      "id": "shot01-9",
      "text": "50 个蓝球，",
      "start": 18.424,
      "end": 19.307
    },
    {
      "id": "shot01-10",
      "text": "你每次摸之前都很难猜，",
      "start": 19.307,
      "end": 21.294
    },
    {
      "id": "shot01-11",
      "text": "这叫最不确定。信息熵，",
      "start": 21.294,
      "end": 23.381
    },
    {
      "id": "shot01-12",
      "text": "英文 entropy，",
      "start": 23.381,
      "end": 24.505
    },
    {
      "id": "shot01-13",
      "text": "就是专门量化这种不确定性的尺子。熵越大，",
      "start": 24.505,
      "end": 28.177
    },
    {
      "id": "shot01-14",
      "text": "样本越混杂；熵越小，样本越纯。",
      "start": 28.177,
      "end": 30.766
    },
    {
      "id": "shot01-15",
      "text": "这一期所有公式都围绕这个直觉展开：",
      "start": 31.274,
      "end": 34.262
    },
    {
      "id": "shot01-16",
      "text": "算法不是在追求复杂数学，",
      "start": 34.262,
      "end": 36.508
    },
    {
      "id": "shot01-17",
      "text": "而是在给“我有多难猜对”找一个稳定刻度。",
      "start": 36.508,
      "end": 39.857
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看单个事件的信息量。",
      "start": 0.0,
      "end": 1.883
    },
    {
      "id": "shot02-1",
      "text": "太阳从东边升起，",
      "start": 1.883,
      "end": 3.365
    },
    {
      "id": "shot02-2",
      "text": "概率接近 99%，",
      "start": 3.365,
      "end": 5.027
    },
    {
      "id": "shot02-3",
      "text": "你听到这句话几乎不会惊讶，",
      "start": 5.027,
      "end": 6.99
    },
    {
      "id": "shot02-4",
      "text": "所以信息量很小。",
      "start": 6.99,
      "end": 8.331
    },
    {
      "id": "shot02-5",
      "text": "太阳从西边升起，",
      "start": 8.331,
      "end": 9.713
    },
    {
      "id": "shot02-6",
      "text": "概率假设只有 1%，",
      "start": 9.713,
      "end": 11.476
    },
    {
      "id": "shot02-7",
      "text": "一旦发生就是爆炸新闻，",
      "start": 11.476,
      "end": 13.298
    },
    {
      "id": "shot02-8",
      "text": "所以信息量很大。",
      "start": 13.298,
      "end": 14.981
    },
    {
      "id": "shot02-9",
      "text": "信息论把这个直觉写成一个公式：",
      "start": 14.981,
      "end": 17.484
    },
    {
      "id": "shot02-10",
      "text": "事件信息量等于负的 log2 概率。",
      "start": 17.484,
      "end": 19.987
    },
    {
      "id": "shot02-11",
      "text": "概率越小，",
      "start": 19.987,
      "end": 20.976
    },
    {
      "id": "shot02-12",
      "text": "负 log2 越大，",
      "start": 20.976,
      "end": 21.97
    },
    {
      "id": "shot02-13",
      "text": "信息量越大。",
      "start": 21.97,
      "end": 22.952
    },
    {
      "id": "shot02-14",
      "text": "这里不用纠结 log 的细节，",
      "start": 22.952,
      "end": 24.654
    },
    {
      "id": "shot02-15",
      "text": "只抓住直觉：",
      "start": 24.654,
      "end": 25.775
    },
    {
      "id": "shot02-16",
      "text": "常见事件没什么信息，",
      "start": 25.775,
      "end": 27.438
    },
    {
      "id": "shot02-17",
      "text": "罕见事件信息量很高。",
      "start": 27.438,
      "end": 28.94
    },
    {
      "id": "shot02-18",
      "text": "这个公式的作用不是让我们背 log，",
      "start": 29.366,
      "end": 31.892
    },
    {
      "id": "shot02-19",
      "text": "而是保证两个性质：",
      "start": 31.892,
      "end": 33.576
    },
    {
      "id": "shot02-20",
      "text": "概率越低信息量越大，",
      "start": 33.576,
      "end": 35.602
    },
    {
      "id": "shot02-21",
      "text": "两个独立事件同时发生时信息量可以相加。",
      "start": 35.602,
      "end": 39.17
    },
    {
      "id": "shot02-22",
      "text": "这样看，",
      "start": 39.17,
      "end": 39.872
    },
    {
      "id": "shot02-23",
      "text": "纯度不是主观感受，",
      "start": 39.872,
      "end": 41.536
    },
    {
      "id": "shot02-24",
      "text": "而是可以比较的数字。",
      "start": 41.536,
      "end": 43.221
    },
    {
      "id": "shot02-25",
      "text": "后面每一次选特征，",
      "start": 43.221,
      "end": 44.784
    },
    {
      "id": "shot02-26",
      "text": "都会用这个数字做裁判。",
      "start": 44.784,
      "end": 46.609
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "信息熵就是把所有可能事件的信息量按概率加",
      "start": 0.0,
      "end": 3.763
    },
    {
      "id": "shot03-1",
      "text": "权平均。二分类时，",
      "start": 3.763,
      "end": 5.424
    },
    {
      "id": "shot03-2",
      "text": "如果正类概率是 p，",
      "start": 5.424,
      "end": 7.145
    },
    {
      "id": "shot03-3",
      "text": "负类概率是 1 减 p，",
      "start": 7.145,
      "end": 8.976
    },
    {
      "id": "shot03-4",
      "text": "熵就是两边信息量的平均。",
      "start": 8.976,
      "end": 11.148
    },
    {
      "id": "shot03-5",
      "text": "p 等于 0 或 1，",
      "start": 11.148,
      "end": 12.409
    },
    {
      "id": "shot03-6",
      "text": "说明所有样本都属于同一类，",
      "start": 12.409,
      "end": 14.87
    },
    {
      "id": "shot03-7",
      "text": "熵等于 0。",
      "start": 14.87,
      "end": 16.071
    },
    {
      "id": "shot03-8",
      "text": "p 等于 0.5，红蓝各半，",
      "start": 16.071,
      "end": 18.253
    },
    {
      "id": "shot03-9",
      "text": "猜哪类最难，",
      "start": 18.253,
      "end": 19.503
    },
    {
      "id": "shot03-10",
      "text": "熵达到 1。",
      "start": 19.503,
      "end": 20.475
    },
    {
      "id": "shot03-11",
      "text": "三分类也一样：",
      "start": 20.475,
      "end": 21.658
    },
    {
      "id": "shot03-12",
      "text": "三类越平均，熵越大；",
      "start": 21.658,
      "end": 23.463
    },
    {
      "id": "shot03-13",
      "text": "某一类越占主导，熵越小。",
      "start": 23.463,
      "end": 25.669
    },
    {
      "id": "shot03-14",
      "text": "对决策树来说，",
      "start": 25.669,
      "end": 27.033
    },
    {
      "id": "shot03-15",
      "text": "熵不是抽象概念，",
      "start": 27.033,
      "end": 28.457
    },
    {
      "id": "shot03-16",
      "text": "它直接回答一个问题：",
      "start": 28.457,
      "end": 30.082
    },
    {
      "id": "shot03-17",
      "text": "这堆样本现在有多难分类。",
      "start": 30.082,
      "end": 31.927
    },
    {
      "id": "shot03-18",
      "text": "所以看熵的时候，",
      "start": 32.455,
      "end": 33.719
    },
    {
      "id": "shot03-19",
      "text": "不要只看类别数量，",
      "start": 33.719,
      "end": 35.203
    },
    {
      "id": "shot03-20",
      "text": "还要看比例。",
      "start": 35.203,
      "end": 36.687
    },
    {
      "id": "shot03-21",
      "text": "三类问题里，",
      "start": 36.687,
      "end": 37.69
    },
    {
      "id": "shot03-22",
      "text": "九成样本都在同一类，",
      "start": 37.69,
      "end": 39.696
    },
    {
      "id": "shot03-23",
      "text": "虽然类别有三个，",
      "start": 39.696,
      "end": 41.25
    },
    {
      "id": "shot03-24",
      "text": "熵也不会特别高。这样看，",
      "start": 41.25,
      "end": 43.146
    },
    {
      "id": "shot03-25",
      "text": "纯度不是主观感受，",
      "start": 43.146,
      "end": 44.69
    },
    {
      "id": "shot03-26",
      "text": "而是可以比较的数字。",
      "start": 44.69,
      "end": 46.555
    },
    {
      "id": "shot03-27",
      "text": "后面每一次选特征，",
      "start": 46.555,
      "end": 48.18
    },
    {
      "id": "shot03-28",
      "text": "都会用这个数字做裁判。",
      "start": 48.18,
      "end": 49.744
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开 demo 看这把尺子怎么动。",
      "start": 0.0,
      "end": 2.142
    },
    {
      "id": "shot04-1",
      "text": "左边有 p1 滑块和预设，",
      "start": 2.142,
      "end": 4.144
    },
    {
      "id": "shot04-2",
      "text": "右边上方是两类占比柱状图，",
      "start": 4.144,
      "end": 6.766
    },
    {
      "id": "shot04-3",
      "text": "下方是 H 随 p1 变化的曲线。",
      "start": 6.766,
      "end": 9.549
    },
    {
      "id": "shot04-4",
      "text": "先选均匀 p 等于 0.50，",
      "start": 9.549,
      "end": 11.711
    },
    {
      "id": "shot04-5",
      "text": "两根柱子一样高，",
      "start": 11.711,
      "end": 13.152
    },
    {
      "id": "shot04-6",
      "text": "H 等于 1.000，",
      "start": 13.152,
      "end": 14.854
    },
    {
      "id": "shot04-7",
      "text": "这是二分类最混乱的位置。",
      "start": 14.854,
      "end": 17.216
    },
    {
      "id": "shot04-8",
      "text": "再选略偏 p 等于 0.30，",
      "start": 17.216,
      "end": 19.979
    },
    {
      "id": "shot04-9",
      "text": "H 降到大约 0.881，",
      "start": 19.979,
      "end": 22.001
    },
    {
      "id": "shot04-10",
      "text": "不确定性下降了一点。",
      "start": 22.001,
      "end": 23.662
    },
    {
      "id": "shot04-11",
      "text": "继续选重偏 p 等于 0.10，",
      "start": 23.662,
      "end": 26.135
    },
    {
      "id": "shot04-12",
      "text": "H 变成大约 0.469，",
      "start": 26.135,
      "end": 28.491
    },
    {
      "id": "shot04-13",
      "text": "大多数样本已经属于同一类。",
      "start": 28.491,
      "end": 30.383
    },
    {
      "id": "shot04-14",
      "text": "最后选纯净 p 等于 0.00，",
      "start": 30.858,
      "end": 33.983
    },
    {
      "id": "shot04-15",
      "text": "H 等于 0。",
      "start": 33.983,
      "end": 34.945
    },
    {
      "id": "shot04-16",
      "text": "注意红点在曲线上移动时，",
      "start": 34.945,
      "end": 37.289
    },
    {
      "id": "shot04-17",
      "text": "最高点永远在 0.5，",
      "start": 37.289,
      "end": 39.372
    },
    {
      "id": "shot04-18",
      "text": "越靠两端越接近 0。",
      "start": 39.372,
      "end": 41.616
    },
    {
      "id": "shot04-19",
      "text": "这个 demo 的价值在于把公式变成形",
      "start": 41.616,
      "end": 44.381
    },
    {
      "id": "shot04-20",
      "text": "状：",
      "start": 44.381,
      "end": 44.761
    },
    {
      "id": "shot04-21",
      "text": "曲线中间最高，",
      "start": 44.761,
      "end": 46.124
    },
    {
      "id": "shot04-22",
      "text": "两端最低。",
      "start": 46.124,
      "end": 47.506
    },
    {
      "id": "shot04-23",
      "text": "以后看到某个节点类别接近五五开，",
      "start": 47.506,
      "end": 50.571
    },
    {
      "id": "shot04-24",
      "text": "就能立刻联想到它还很混杂。",
      "start": 50.571,
      "end": 52.715
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "有了熵，",
      "start": 0.0,
      "end": 0.701
    },
    {
      "id": "shot05-1",
      "text": "下一步就能评价一刀切得好不好。切之前，",
      "start": 0.701,
      "end": 4.083
    },
    {
      "id": "shot05-2",
      "text": "整堆样本有一个总熵 H。",
      "start": 4.083,
      "end": 6.225
    },
    {
      "id": "shot05-3",
      "text": "用某个特征切开以后，",
      "start": 6.225,
      "end": 7.887
    },
    {
      "id": "shot05-4",
      "text": "会得到几个子集，",
      "start": 7.887,
      "end": 9.368
    },
    {
      "id": "shot05-5",
      "text": "每个子集又有自己的熵。条件熵，",
      "start": 9.368,
      "end": 12.551
    },
    {
      "id": "shot05-6",
      "text": "英文 conditional",
      "start": 12.551,
      "end": 13.812
    },
    {
      "id": "shot05-7",
      "text": "entropy，",
      "start": 13.812,
      "end": 14.552
    },
    {
      "id": "shot05-8",
      "text": "就是这些子集熵的加权平均，",
      "start": 14.552,
      "end": 17.014
    },
    {
      "id": "shot05-9",
      "text": "权重用子集样本数占比。",
      "start": 17.014,
      "end": 19.196
    },
    {
      "id": "shot05-10",
      "text": "为什么要加权？",
      "start": 19.196,
      "end": 20.357
    },
    {
      "id": "shot05-11",
      "text": "因为 100 个样本里的大子集比 2 个",
      "start": 20.357,
      "end": 23.247
    },
    {
      "id": "shot05-12",
      "text": "样本的小子集更重要。",
      "start": 23.247,
      "end": 25.093
    },
    {
      "id": "shot05-13",
      "text": "一个特征切完以后，",
      "start": 25.093,
      "end": 26.538
    },
    {
      "id": "shot05-14",
      "text": "如果每个子集都很纯，",
      "start": 26.538,
      "end": 28.425
    },
    {
      "id": "shot05-15",
      "text": "条件熵就低；",
      "start": 28.425,
      "end": 29.97
    },
    {
      "id": "shot05-16",
      "text": "如果切完还是混杂，",
      "start": 29.97,
      "end": 31.656
    },
    {
      "id": "shot05-17",
      "text": "条件熵就高。",
      "start": 31.656,
      "end": 32.438
    },
    {
      "id": "shot05-18",
      "text": "换成树的语言，",
      "start": 32.827,
      "end": 34.109
    },
    {
      "id": "shot05-19",
      "text": "条件熵就是问：",
      "start": 34.109,
      "end": 35.35
    },
    {
      "id": "shot05-20",
      "text": "我已经知道特征 A 的取值以后，",
      "start": 35.35,
      "end": 37.893
    },
    {
      "id": "shot05-21",
      "text": "类别还剩多少不确定性。剩得越少，",
      "start": 37.893,
      "end": 40.877
    },
    {
      "id": "shot05-22",
      "text": "这个特征越有用。这样看，",
      "start": 40.877,
      "end": 42.759
    },
    {
      "id": "shot05-23",
      "text": "纯度不是主观感受，",
      "start": 42.759,
      "end": 44.462
    },
    {
      "id": "shot05-24",
      "text": "而是可以比较的数字。",
      "start": 44.462,
      "end": 46.204
    },
    {
      "id": "shot05-25",
      "text": "后面每一次选特征，",
      "start": 46.204,
      "end": 47.826
    },
    {
      "id": "shot05-26",
      "text": "都会用这个数字做裁判。",
      "start": 47.826,
      "end": 49.368
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "信息增益，",
      "start": 0.0,
      "end": 0.922
    },
    {
      "id": "shot06-1",
      "text": "英文 information gain，",
      "start": 0.922,
      "end": 2.544
    },
    {
      "id": "shot06-2",
      "text": "就更直接了：",
      "start": 2.544,
      "end": 3.646
    },
    {
      "id": "shot06-3",
      "text": "切之前的熵，",
      "start": 3.646,
      "end": 4.728
    },
    {
      "id": "shot06-4",
      "text": "减去切之后的条件熵。",
      "start": 4.728,
      "end": 6.751
    },
    {
      "id": "shot06-5",
      "text": "公式是 g(D，",
      "start": 6.751,
      "end": 7.813
    },
    {
      "id": "shot06-6",
      "text": "A) 等于 H(D) 减 H(D|A)。",
      "start": 7.813,
      "end": 10.077
    },
    {
      "id": "shot06-7",
      "text": "如果某个特征让样本从很混杂变得很纯，",
      "start": 10.077,
      "end": 13.803
    },
    {
      "id": "shot06-8",
      "text": "条件熵下降多，",
      "start": 13.803,
      "end": 15.386
    },
    {
      "id": "shot06-9",
      "text": "信息增益就大。",
      "start": 15.386,
      "end": 16.908
    },
    {
      "id": "shot06-10",
      "text": "ID3 决策树正是按这个分数选特征：",
      "start": 16.908,
      "end": 20.294
    },
    {
      "id": "shot06-11",
      "text": "每个节点都算一遍所有候选特征的信息增益，",
      "start": 20.294,
      "end": 24.06
    },
    {
      "id": "shot06-12",
      "text": "谁让熵降得最多，",
      "start": 24.06,
      "end": 25.683
    },
    {
      "id": "shot06-13",
      "text": "谁就当这一层的分裂特征。",
      "start": 25.683,
      "end": 27.426
    },
    {
      "id": "shot06-14",
      "text": "颜色案例里，",
      "start": 27.926,
      "end": 29.088
    },
    {
      "id": "shot06-15",
      "text": "按颜色切的增益大约是 0.46；",
      "start": 29.088,
      "end": 31.812
    },
    {
      "id": "shot06-16",
      "text": "按厚度切，",
      "start": 31.812,
      "end": 32.834
    },
    {
      "id": "shot06-17",
      "text": "两边仍然混杂，",
      "start": 32.834,
      "end": 34.256
    },
    {
      "id": "shot06-18",
      "text": "所以增益更小。结论很短：",
      "start": 34.256,
      "end": 36.669
    },
    {
      "id": "shot06-19",
      "text": "熵降得最多的特征，",
      "start": 36.669,
      "end": 38.202
    },
    {
      "id": "shot06-20",
      "text": "就是 ID3 的分裂点。",
      "start": 38.202,
      "end": 40.045
    },
    {
      "id": "shot06-21",
      "text": "这里的“增益”可以理解成省下来的猜测成",
      "start": 40.045,
      "end": 43.11
    },
    {
      "id": "shot06-22",
      "text": "本。",
      "start": 43.11,
      "end": 43.771
    },
    {
      "id": "shot06-23",
      "text": "原来要面对整堆样本的不确定性，",
      "start": 43.771,
      "end": 46.635
    },
    {
      "id": "shot06-24",
      "text": "切完以后只面对各个子集的剩余不确定性。",
      "start": 46.635,
      "end": 50.161
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期我们给“纯”补上了数字。第一，",
      "start": 0.0,
      "end": 2.562
    },
    {
      "id": "shot07-1",
      "text": "信息熵衡量一堆样本有多混杂；第二，",
      "start": 2.562,
      "end": 5.725
    },
    {
      "id": "shot07-2",
      "text": "条件熵衡量按某个特征切完以后，",
      "start": 5.725,
      "end": 8.748
    },
    {
      "id": "shot07-3",
      "text": "子集平均还剩多少混杂；第三，",
      "start": 8.748,
      "end": 11.53
    },
    {
      "id": "shot07-4",
      "text": "信息增益就是熵下降了多少。",
      "start": 11.53,
      "end": 14.413
    },
    {
      "id": "shot07-5",
      "text": "ID3 会选择信息增益最大的特征，",
      "start": 14.413,
      "end": 17.396
    },
    {
      "id": "shot07-6",
      "text": "因为这一刀最能降低不确定性。",
      "start": 17.396,
      "end": 19.958
    },
    {
      "id": "shot07-7",
      "text": "本期没展开的是信息增益的一个缺点：",
      "start": 19.958,
      "end": 22.72
    },
    {
      "id": "shot07-8",
      "text": "它会偏爱取值特别多的特征。",
      "start": 22.72,
      "end": 25.022
    },
    {
      "id": "shot07-9",
      "text": "这个问题先放一放。",
      "start": 25.022,
      "end": 26.924
    },
    {
      "id": "shot07-10",
      "text": "下一期我们先看 ID3 怎么把信息增益变",
      "start": 26.924,
      "end": 30.234
    },
    {
      "id": "shot07-11",
      "text": "成完整建树流程：算增益，选最大，",
      "start": 30.234,
      "end": 33.484
    },
    {
      "id": "shot07-12",
      "text": "切子集，再递归。",
      "start": 33.484,
      "end": 34.928
    },
    {
      "id": "shot07-13",
      "text": "把这三步连起来，",
      "start": 35.193,
      "end": 36.717
    },
    {
      "id": "shot07-14",
      "text": "ID3 的选择标准就很清楚：",
      "start": 36.717,
      "end": 38.782
    },
    {
      "id": "shot07-15",
      "text": "不是选看起来最像业务原因的特征，",
      "start": 38.782,
      "end": 41.529
    },
    {
      "id": "shot07-16",
      "text": "而是选能让熵下降最多的特征。这样看，",
      "start": 41.529,
      "end": 44.917
    },
    {
      "id": "shot07-17",
      "text": "纯度不是主观感受，",
      "start": 44.917,
      "end": 46.601
    },
    {
      "id": "shot07-18",
      "text": "而是可以比较的数字。",
      "start": 46.601,
      "end": 48.165
    },
    {
      "id": "shot07-19",
      "text": "后面每一次选特征，",
      "start": 48.165,
      "end": 49.709
    },
    {
      "id": "shot07-20",
      "text": "都会用这个数字做裁判。",
      "start": 49.709,
      "end": 51.393
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.772
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.772,
      "end": 2.274
    }
  ]
}
