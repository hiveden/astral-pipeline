{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期正规方程一步出解很爽——但有硬伤：",
      "start": 0,
      "end": 4.125
    },
    {
      "id": "shot01-1",
      "text": "XᵀX 不一定可逆，",
      "start": 4.125,
      "end": 6.168
    },
    {
      "id": "shot01-2",
      "text": "求逆复杂度 O(n³)，",
      "start": 6.168,
      "end": 8.39
    },
    {
      "id": "shot01-3",
      "text": "特征过万直接跑不动。",
      "start": 8.39,
      "end": 10.353
    },
    {
      "id": "shot01-4",
      "text": "这一期我们换思路：",
      "start": 10.353,
      "end": 12.015
    },
    {
      "id": "shot01-5",
      "text": "放弃一步出解，",
      "start": 12.015,
      "end": 13.216
    },
    {
      "id": "shot01-6",
      "text": "从随机起点出发，",
      "start": 13.216,
      "end": 14.958
    },
    {
      "id": "shot01-7",
      "text": "沿坡度最陡的反方向一步步往下走，梯度下降 Gradient Descent，",
      "start": 14.958,
      "end": 20.345
    },
    {
      "id": "shot01-9",
      "text": "简写 GD，",
      "start": 20.345,
      "end": 21.426
    },
    {
      "id": "shot01-10",
      "text": "是机器学习最重要的优化算法没有之一。",
      "start": 21.426,
      "end": 24.51
    },
    {
      "id": "shot01-11",
      "text": "这一期解决三件事：",
      "start": 24.785,
      "end": 26.288
    },
    {
      "id": "shot01-12",
      "text": "下山法的几何直觉 + 梯度向量 + 更新公式 w ← w − α∇L；",
      "start": 26.288,
      "end": 32.078
    },
    {
      "id": "shot01-14",
      "text": "学习率 α 太小慢 / 合适收敛 / 太大震荡的 3 档对比；",
      "start": 32.078,
      "end": 36.265
    },
    {
      "id": "shot01-16",
      "text": "f(θ) = θ²，4 步实算建立数字感。",
      "start": 36.265,
      "end": 39.251
    },
    {
      "id": "shot01-17",
      "text": "下一期看 BGD / SGD / MBGD 三种下山变体加上和正规方程的总对比。",
      "start": 39.251,
      "end": 45.402
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "想象你被蒙眼放在一座山的山顶，",
      "start": 0,
      "end": 2.641
    },
    {
      "id": "shot02-1",
      "text": "要找最低的山谷在哪。",
      "start": 2.641,
      "end": 4.442
    },
    {
      "id": "shot02-2",
      "text": "你看不见全局，",
      "start": 4.442,
      "end": 5.622
    },
    {
      "id": "shot02-3",
      "text": "但每一步都能感知脚下哪个方向最陡，就往那个方向反着走。",
      "start": 5.622,
      "end": 10.304
    },
    {
      "id": "shot02-5",
      "text": "重复这个动作，",
      "start": 10.304,
      "end": 11.305
    },
    {
      "id": "shot02-6",
      "text": "无论起点在哪，",
      "start": 11.305,
      "end": 12.625
    },
    {
      "id": "shot02-7",
      "text": "最终都会滚到谷底。",
      "start": 12.625,
      "end": 14.451
    },
    {
      "id": "shot02-8",
      "text": "GD 就是这个直觉的数学版。",
      "start": 14.451,
      "end": 16.807
    },
    {
      "id": "shot02-9",
      "text": "偏导那一期讲过梯度 ∇L，",
      "start": 16.807,
      "end": 19.008
    },
    {
      "id": "shot02-10",
      "text": "是所有偏导组成的向量。",
      "start": 19.008,
      "end": 21.229
    },
    {
      "id": "shot02-11",
      "text": "这个向量有个几何含义本期正式登场：",
      "start": 21.229,
      "end": 24.378
    },
    {
      "id": "shot02-12",
      "text": "梯度 ∇L 指向函数上升最快的方向。",
      "start": 24.378,
      "end": 27.326
    },
    {
      "id": "shot02-13",
      "text": "我们要下山，",
      "start": 27.326,
      "end": 28.329
    },
    {
      "id": "shot02-14",
      "text": "就沿相反方向——也就是负梯度 -∇L 方向走，下降最快。",
      "start": 28.329,
      "end": 33.143
    },
    {
      "id": "shot02-15",
      "text": "LR 损失 L(w,b) 是个二维抛物面（碗），",
      "start": 33.767,
      "end": 37.44
    },
    {
      "id": "shot02-16",
      "text": "梯度在 (w,b) 平面上指向上升最快的方向，",
      "start": 37.44,
      "end": 41.024
    },
    {
      "id": "shot02-18",
      "text": "负梯度就指向碗底——一步步迭代逼近最优。",
      "start": 41.024,
      "end": 44.673
    },
    {
      "id": "shot02-19",
      "text": "这个'局部贪心'策略对凸函数永远收敛到全局最低，",
      "start": 44.673,
      "end": 48.984
    },
    {
      "id": "shot02-20",
      "text": "对 LR MSE 这种碗形损失天生匹配。",
      "start": 48.984,
      "end": 52.653
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "把'走一步'写成数学：",
      "start": 0,
      "end": 1.583
    },
    {
      "id": "shot03-1",
      "text": "每次迭代用当前位置 w 减去 α∇L，得到新位置：w ← w − α∇L。",
      "start": 1.583,
      "end": 9.861
    },
    {
      "id": "shot03-3",
      "text": "这就是 GD 参数更新的核心公式。",
      "start": 9.861,
      "end": 12.366
    },
    {
      "id": "shot03-4",
      "text": "其中 α 叫学习率 learning rate，",
      "start": 12.366,
      "end": 14.912
    },
    {
      "id": "shot03-5",
      "text": "控制每一步走多大。",
      "start": 14.912,
      "end": 16.155
    },
    {
      "id": "shot03-6",
      "text": "学习率太小，",
      "start": 16.547,
      "end": 17.749
    },
    {
      "id": "shot03-7",
      "text": "一步只走一点，",
      "start": 17.749,
      "end": 18.91
    },
    {
      "id": "shot03-8",
      "text": "要走几千几万步才到底，",
      "start": 18.91,
      "end": 20.932
    },
    {
      "id": "shot03-9",
      "text": "训练慢得要命；",
      "start": 20.932,
      "end": 22.134
    },
    {
      "id": "shot03-10",
      "text": "学习率太大，",
      "start": 22.134,
      "end": 23.075
    },
    {
      "id": "shot03-11",
      "text": "一脚跨过山谷直接冲到对面山坡，",
      "start": 23.075,
      "end": 25.998
    },
    {
      "id": "shot03-12",
      "text": "下次又冲回来——震荡不收敛甚至发散；",
      "start": 25.998,
      "end": 29.182
    },
    {
      "id": "shot03-13",
      "text": "学习率合适，",
      "start": 29.182,
      "end": 30.344
    },
    {
      "id": "shot03-14",
      "text": "几十到几百步收敛到最优。",
      "start": 30.344,
      "end": 32.807
    },
    {
      "id": "shot03-15",
      "text": "LR 工程经验值通常在 0.001 到 0.01 之间，",
      "start": 32.807,
      "end": 37.032
    },
    {
      "id": "shot03-17",
      "text": "需要根据数据规模和特征量级调。",
      "start": 37.032,
      "end": 39.715
    },
    {
      "id": "shot03-18",
      "text": "具体调多少没有公式——只能跑几次取效果最好的，",
      "start": 39.715,
      "end": 43.459
    },
    {
      "id": "shot03-19",
      "text": "这是后面深度学习炼丹的基本功。",
      "start": 43.459,
      "end": 45.582
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "用最简单的函数走一遍。",
      "start": 0,
      "end": 1.924
    },
    {
      "id": "shot04-1",
      "text": "f(θ) = θ²，",
      "start": 1.924,
      "end": 3.668
    },
    {
      "id": "shot04-2",
      "text": "最低点在 θ = 0，",
      "start": 3.668,
      "end": 5.231
    },
    {
      "id": "shot04-3",
      "text": "导数 f'(θ) = 2θ。",
      "start": 5.231,
      "end": 7.916
    },
    {
      "id": "shot04-4",
      "text": "起点 θ₀ = 1，",
      "start": 7.916,
      "end": 9.8
    },
    {
      "id": "shot04-5",
      "text": "学习率 α = 0.4。",
      "start": 9.8,
      "end": 11.424
    },
    {
      "id": "shot04-6",
      "text": "代入 GD 公式 θ ← θ − α·f'(θ)，跑 4 步：",
      "start": 11.856,
      "end": 17.563
    },
    {
      "id": "shot04-8",
      "text": "θ₁ = 0.2、",
      "start": 17.563,
      "end": 19.606
    },
    {
      "id": "shot04-9",
      "text": "θ₂ = 0.04、",
      "start": 19.606,
      "end": 21.909
    },
    {
      "id": "shot04-10",
      "text": "θ₃ = 0.008、",
      "start": 21.909,
      "end": 24.212
    },
    {
      "id": "shot04-11",
      "text": "θ₄ ≈ 0.0016——4 步基本收敛到 0。规律：",
      "start": 24.212,
      "end": 29.158
    },
    {
      "id": "shot04-12",
      "text": "越靠近最低点梯度越小、步子越短，",
      "start": 29.158,
      "end": 31.881
    },
    {
      "id": "shot04-13",
      "text": "自动收敛。",
      "start": 31.881,
      "end": 33.213
    },
    {
      "id": "shot04-14",
      "text": "LR 实际是二维 (w,b) 一起更新，",
      "start": 33.213,
      "end": 36.167
    },
    {
      "id": "shot04-16",
      "text": "本质完全一样。",
      "start": 36.167,
      "end": 37.168
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "打开本章核心 demo：5 视图同步联动 + 4 镜头切换 + 7 预设，",
      "start": 0,
      "end": 5.329
    },
    {
      "id": "shot05-2",
      "text": "看 GD 全景。",
      "start": 5.329,
      "end": 6.572
    },
    {
      "id": "shot05-3",
      "text": "先看镜头 A：业务 + 收敛默认视图。",
      "start": 6.572,
      "end": 9.517
    },
    {
      "id": "shot05-4",
      "text": "左图真实数据加当前拟合线加红方块标记残差平方，",
      "start": 9.517,
      "end": 13.925
    },
    {
      "id": "shot05-5",
      "text": "右图是 loss 随迭代步数下降的曲线。",
      "start": 13.925,
      "end": 16.93
    },
    {
      "id": "shot05-6",
      "text": "挑预设✓完美：",
      "start": 16.93,
      "end": 18.388
    },
    {
      "id": "shot05-7",
      "text": "起点 (4,4)、",
      "start": 18.388,
      "end": 19.234
    },
    {
      "id": "shot05-8",
      "text": "lr = 0.08，",
      "start": 19.234,
      "end": 20.576
    },
    {
      "id": "shot05-9",
      "text": "拖帧 0 到 30 红方块收缩白线滚到碗底，",
      "start": 20.576,
      "end": 23.822
    },
    {
      "id": "shot05-10",
      "text": "右图损失单调下降——典型收敛画面。",
      "start": 23.822,
      "end": 26.406
    },
    {
      "id": "shot05-11",
      "text": "换预设龟速，lr = 0.005，",
      "start": 26.955,
      "end": 30.617
    },
    {
      "id": "shot05-12",
      "text": "拖满 30 步白线只挪一小段、",
      "start": 30.617,
      "end": 33.539
    },
    {
      "id": "shot05-13",
      "text": "损失基本不动，",
      "start": 33.539,
      "end": 34.84
    },
    {
      "id": "shot05-14",
      "text": "太小的 lr 拖累训练。",
      "start": 34.84,
      "end": 36.862
    },
    {
      "id": "shot05-15",
      "text": "切镜头 C：地形 + 收敛，看 2D 等高线俯视。",
      "start": 36.862,
      "end": 41.104
    },
    {
      "id": "shot05-16",
      "text": "选振荡，lr = 0.27，",
      "start": 41.104,
      "end": 44.086
    },
    {
      "id": "shot05-17",
      "text": "白线在碗壁两侧锯齿摇摆，右图 loss 锯齿震荡。",
      "start": 44.086,
      "end": 49.15
    },
    {
      "id": "shot05-19",
      "text": "再选发散，lr = 0.4，",
      "start": 49.15,
      "end": 52.232
    },
    {
      "id": "shot05-20",
      "text": "白线直接飞出曲面、",
      "start": 52.232,
      "end": 54.013
    },
    {
      "id": "shot05-21",
      "text": "loss 冲天柱发散。",
      "start": 54.013,
      "end": 55.754
    },
    {
      "id": "shot05-22",
      "text": "学习率三档收敛 / 龟速 / 震荡 / 发散视觉钉死。",
      "start": 55.754,
      "end": 59.933
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "再切镜头 B 滚球加地形看 1D 切片几何：",
      "start": 0,
      "end": 3.488
    },
    {
      "id": "shot06-1",
      "text": "把 b 固定让 w 变 loss 是抛物线，",
      "start": 3.488,
      "end": 6.334
    },
    {
      "id": "shot06-2",
      "text": "红球沿曲线滚到谷底，右图 2D 等高线显示 GD 脚印和负梯度黄箭头。",
      "start": 6.334,
      "end": 12.768
    },
    {
      "id": "shot06-4",
      "text": "1D 抛物线就是 2D 等高线的一个剖面。",
      "start": 12.768,
      "end": 16.095
    },
    {
      "id": "shot06-5",
      "text": "最后切镜头 D 3D 全景，",
      "start": 16.095,
      "end": 18.139
    },
    {
      "id": "shot06-6",
      "text": "这是本期视觉最重要的环节。",
      "start": 18.139,
      "end": 19.963
    },
    {
      "id": "shot06-7",
      "text": "左图是 loss 碗的立体曲面拖拽可旋转，",
      "start": 20.493,
      "end": 23.775
    },
    {
      "id": "shot06-8",
      "text": "白线就是 GD 轨迹从碗壁高处滚到碗底，",
      "start": 23.775,
      "end": 27.058
    },
    {
      "id": "shot06-9",
      "text": "右图 2D 等高线是 3D 的俯视投影，同一个画面两种维度看，",
      "start": 27.058,
      "end": 31.541
    },
    {
      "id": "shot06-11",
      "text": "3D 高度对应 2D 颜色深浅。",
      "start": 31.541,
      "end": 34.333
    },
    {
      "id": "shot06-12",
      "text": "挑预设长征起点 (5.5,-3.5)，lr = 0.05：",
      "start": 34.333,
      "end": 38.546
    },
    {
      "id": "shot06-15",
      "text": "3D 视角下白线确实在碗里走出长征轨迹。",
      "start": 38.546,
      "end": 42.169
    },
    {
      "id": "shot06-16",
      "text": "再换预设鞍点 (2,-3.5)：",
      "start": 42.169,
      "end": 44.611
    },
    {
      "id": "shot06-18",
      "text": "白线在鞍点附近徘徊不收敛，3D 看马鞍立体感最强。",
      "start": 44.611,
      "end": 49.074
    },
    {
      "id": "shot06-20",
      "text": "3D 建立'碗底 = 最优'的立体直觉。",
      "start": 49.691,
      "end": 52.275
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "把抽象的 GD 落到具体业务。",
      "start": 0,
      "end": 2.584
    },
    {
      "id": "shot07-1",
      "text": "银行信贷场景：",
      "start": 2.584,
      "end": 4.447
    },
    {
      "id": "shot07-2",
      "text": "x 是客户月收入，",
      "start": 4.447,
      "end": 5.849
    },
    {
      "id": "shot07-3",
      "text": "y 是给客户的贷款额度，",
      "start": 5.849,
      "end": 7.852
    },
    {
      "id": "shot07-4",
      "text": "模型 ŷ = wx + b。",
      "start": 7.852,
      "end": 10.837
    },
    {
      "id": "shot07-5",
      "text": "损失 MSE 对 w 求偏导：∂L/∂w = 2Σ(wxᵢ + b − yᵢ)xᵢ；",
      "start": 10.837,
      "end": 21.373
    },
    {
      "id": "shot07-8",
      "text": "对 b 求偏导：∂L/∂b = 2Σ(wxᵢ + b − yᵢ)。",
      "start": 21.373,
      "end": 28.303
    },
    {
      "id": "shot07-11",
      "text": "每次迭代：",
      "start": 28.912,
      "end": 29.994
    },
    {
      "id": "shot07-12",
      "text": "w ← w − α∂L/∂w，b ← b − α∂L/∂b，同时更新。",
      "start": 29.994,
      "end": 37.084
    },
    {
      "id": "shot07-14",
      "text": "学习率 α 实际怎么选？",
      "start": 37.084,
      "end": 39.087
    },
    {
      "id": "shot07-15",
      "text": "工程上从 0.01 起步跑 100 步看",
      "start": 39.087,
      "end": 42.632
    },
    {
      "id": "shot07-16",
      "text": "损失曲线——下降平滑就好；",
      "start": 42.632,
      "end": 45.036
    },
    {
      "id": "shot07-17",
      "text": "震荡说明大了缩小 10 倍试 0.001；",
      "start": 45.036,
      "end": 48.641
    },
    {
      "id": "shot07-18",
      "text": "下降慢说明小了放大 10 倍试 0.1。",
      "start": 48.641,
      "end": 51.906
    },
    {
      "id": "shot07-19",
      "text": "收敛判据有两条：",
      "start": 52.378,
      "end": 53.802
    },
    {
      "id": "shot07-20",
      "text": "相邻两步损失差小于一个小阈值 ε，比如 1e-6；",
      "start": 53.802,
      "end": 59.077
    },
    {
      "id": "shot07-22",
      "text": "或者达到最大迭代数比如 1000 步——",
      "start": 59.077,
      "end": 62.025
    },
    {
      "id": "shot07-23",
      "text": "满足任意一条就停。",
      "start": 62.025,
      "end": 63.649
    },
    {
      "id": "shot07-24",
