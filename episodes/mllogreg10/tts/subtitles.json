{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "前面几期，",
      "start": 0.0,
      "end": 0.902
    },
    {
      "id": "shot01-1",
      "text": "我们已经把逻辑回归的核心工具凑齐了：",
      "start": 0.902,
      "end": 4.168
    },
    {
      "id": "shot01-2",
      "text": "sigmoid 把线性分数变成概率，",
      "start": 4.168,
      "end": 6.632
    },
    {
      "id": "shot01-3",
      "text": "log loss 负责训练，",
      "start": 6.632,
      "end": 8.275
    },
    {
      "id": "shot01-4",
      "text": "predict_proba 输出风险分数，",
      "start": 8.275,
      "end": 10.84
    },
    {
      "id": "shot01-5",
      "text": "混淆矩阵、",
      "start": 10.84,
      "end": 11.781
    },
    {
      "id": "shot01-6",
      "text": "P/R/F1 和 AUC 负责评估。",
      "start": 11.781,
      "end": 14.747
    },
    {
      "id": "shot01-7",
      "text": "现在把它们放到一个业务问题里：",
      "start": 14.747,
      "end": 17.091
    },
    {
      "id": "shot01-8",
      "text": "电信客户流失预测。",
      "start": 17.091,
      "end": 19.095
    },
    {
      "id": "shot01-9",
      "text": "业务方真正关心的不是模型能不能算出一个",
      "start": 19.095,
      "end": 22.481
    },
    {
      "id": "shot01-10",
      "text": "0 或 1，",
      "start": 22.481,
      "end": 23.322
    },
    {
      "id": "shot01-11",
      "text": "而是能不能提前找出高风险客户，",
      "start": 23.322,
      "end": 26.228
    },
    {
      "id": "shot01-12",
      "text": "让运营有机会做挽留。",
      "start": 26.228,
      "end": 27.851
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "这一期的 demo 使用合成 Telco",
      "start": 0.0,
      "end": 2.102
    },
    {
      "id": "shot02-1",
      "text": "分布，",
      "start": 2.102,
      "end": 2.663
    },
    {
      "id": "shot02-2",
      "text": "不依赖外部真实 CSV。",
      "start": 2.663,
      "end": 5.066
    },
    {
      "id": "shot02-3",
      "text": "数据规模是 7000 个客户，",
      "start": 5.066,
      "end": 7.028
    },
    {
      "id": "shot02-4",
      "text": "每个客户有在网月数、月费、",
      "start": 7.028,
      "end": 9.411
    },
    {
      "id": "shot02-5",
      "text": "是否老年用户、合约类型、网络服务、",
      "start": 9.411,
      "end": 12.475
    },
    {
      "id": "shot02-6",
      "text": "支付方式、",
      "start": 12.475,
      "end": 13.295
    },
    {
      "id": "shot02-7",
      "text": "是否无纸化账单、",
      "start": 13.295,
      "end": 14.697
    },
    {
      "id": "shot02-8",
      "text": "是否有伴侣或家属、",
      "start": 14.697,
      "end": 16.479
    },
    {
      "id": "shot02-9",
      "text": "是否开通在线安全和技术支持等特征。",
      "start": 16.479,
      "end": 19.443
    },
    {
      "id": "shot02-10",
      "text": "目标列是 Churn，",
      "start": 19.443,
      "end": 20.824
    },
    {
      "id": "shot02-11",
      "text": "也就是客户是否流失。",
      "start": 20.824,
      "end": 22.887
    },
    {
      "id": "shot02-12",
      "text": "当前合成数据里，",
      "start": 22.887,
      "end": 24.408
    },
    {
      "id": "shot02-13",
      "text": "流失客户是 1307 个，",
      "start": 24.408,
      "end": 26.851
    },
    {
      "id": "shot02-14",
      "text": "流失率约百分之十八点七。",
      "start": 26.851,
      "end": 28.393
    },
    {
      "id": "shot02-15",
      "text": "注意这已经是不平衡分类：",
      "start": 29.409,
      "end": 31.439
    },
    {
      "id": "shot02-16",
      "text": "大多数客户没有流失，",
      "start": 31.439,
      "end": 33.086
    },
    {
      "id": "shot02-17",
      "text": "少数客户才是业务正例。",
      "start": 33.086,
      "end": 34.975
    },
    {
      "id": "shot02-18",
      "text": "模型的目标不是把所有客户都判成留存，",
      "start": 34.975,
      "end": 37.97
    },
    {
      "id": "shot02-19",
      "text": "而是把真正可能流失的人排到风险列表前面。",
      "start": 37.97,
      "end": 41.064
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "完整流程可以拆成六步。",
      "start": 0.0,
      "end": 1.803
    },
    {
      "id": "shot03-1",
      "text": "第一步导入 pandas、",
      "start": 1.803,
      "end": 3.024
    },
    {
      "id": "shot03-2",
      "text": "numpy、",
      "start": 3.024,
      "end": 3.585
    },
    {
      "id": "shot03-3",
      "text": "sklearn 里的模型、切分、",
      "start": 3.585,
      "end": 5.328
    },
    {
      "id": "shot03-4",
      "text": "标准化和指标函数。",
      "start": 5.328,
      "end": 6.87
    },
    {
      "id": "shot03-5",
      "text": "第二步加载并理解数据，",
      "start": 6.87,
      "end": 8.632
    },
    {
      "id": "shot03-6",
      "text": "确认目标列、",
      "start": 8.632,
      "end": 9.554
    },
    {
      "id": "shot03-7",
      "text": "样本量和流失率。",
      "start": 9.554,
      "end": 10.936
    },
    {
      "id": "shot03-8",
      "text": "第三步做特征处理：",
      "start": 10.936,
      "end": 12.478
    },
    {
      "id": "shot03-9",
      "text": "客户 ID 只是标识符，",
      "start": 12.478,
      "end": 14.18
    },
    {
      "id": "shot03-10",
      "text": "要 drop 掉；",
      "start": 14.18,
      "end": 15.081
    },
    {
      "id": "shot03-11",
      "text": "Churn 转成 0/1；合约、",
      "start": 15.081,
      "end": 17.545
    },
    {
      "id": "shot03-12",
      "text": "网络服务、",
      "start": 17.545,
      "end": 18.346
    },
    {
      "id": "shot03-13",
      "text": "支付方式这些类别字段要做 one-hot。",
      "start": 18.346,
      "end": 21.03
    },
    {
      "id": "shot03-14",
      "text": "第四步切分训练集和测试集，",
      "start": 21.03,
      "end": 23.353
    },
    {
      "id": "shot03-15",
      "text": "并对数值特征做标准化。",
      "start": 23.353,
      "end": 25.016
    },
    {
      "id": "shot03-16",
      "text": "标准化器只在训练集 fit，",
      "start": 25.498,
      "end": 27.636
    },
    {
      "id": "shot03-17",
      "text": "再 transform 训练集和测试集，",
      "start": 27.636,
      "end": 30.007
    },
    {
      "id": "shot03-18",
      "text": "避免信息泄露。",
      "start": 30.007,
      "end": 31.45
    },
    {
      "id": "shot03-19",
      "text": "第五步训练",
      "start": 31.45,
      "end": 32.412
    },
    {
      "id": "shot03-20",
      "text": "LogisticRegression，",
      "start": 32.412,
      "end": 33.955
    },
    {
      "id": "shot03-21",
      "text": "这里使用 class_weight",
      "start": 33.955,
      "end": 35.198
    },
    {
      "id": "shot03-22",
      "text": "balanced，",
      "start": 35.198,
      "end": 35.879
    },
    {
      "id": "shot03-23",
      "text": "让少数类流失客户得到更高权重。",
      "start": 35.879,
      "end": 39.186
    },
    {
      "id": "shot03-24",
      "text": "第六步用 predict_proba 取",
      "start": 39.186,
      "end": 41.21
    },
    {
      "id": "shot03-25",
      "text": "正类概率，",
      "start": 41.21,
      "end": 41.971
    },
    {
      "id": "shot03-26",
      "text": "再计算 accuracy、",
      "start": 41.971,
      "end": 43.254
    },
    {
      "id": "shot03-27",
      "text": "precision、",
      "start": 43.254,
      "end": 44.035
    },
    {
      "id": "shot03-28",
      "text": "recall、",
      "start": 44.035,
      "end": 44.637
    },
    {
      "id": "shot03-29",
      "text": "F1 和 AUC。",
      "start": 44.637,
      "end": 45.799
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开客户流失 pipeline demo。",
      "start": 0.0,
      "end": 2.205
    },
    {
      "id": "shot04-1",
      "text": "这个页面的核心是左侧代码块和右侧图表联动。",
      "start": 2.205,
      "end": 5.773
    },
    {
      "id": "shot04-2",
      "text": "切到 step 1，",
      "start": 5.773,
      "end": 6.695
    },
    {
      "id": "shot04-3",
      "text": "只看导入代码，",
      "start": 6.695,
      "end": 7.757
    },
    {
      "id": "shot04-4",
      "text": "先把依赖交代清楚。",
      "start": 7.757,
      "end": 9.521
    },
    {
      "id": "shot04-5",
      "text": "切到 step 2，",
      "start": 9.521,
      "end": 10.484
    },
    {
      "id": "shot04-6",
      "text": "主图显示 tenure 和 Churn",
      "start": 10.484,
      "end": 11.927
    },
    {
      "id": "shot04-7",
      "text": "的散点，",
      "start": 11.927,
      "end": 12.708
    },
    {
      "id": "shot04-8",
      "text": "右侧面板显示 7000 个客户、",
      "start": 12.708,
      "end": 14.733
    },
    {
      "id": "shot04-9",
      "text": "流失和留存数量，",
      "start": 14.733,
      "end": 16.016
    },
    {
      "id": "shot04-10",
      "text": "以及当前流失率。",
      "start": 16.016,
      "end": 17.319
    },
    {
      "id": "shot04-11",
      "text": "切到 step 3，",
      "start": 17.319,
      "end": 18.261
    },
    {
      "id": "shot04-12",
      "text": "类别特征 one-hot 后，",
      "start": 18.261,
      "end": 19.804
    },
    {
      "id": "shot04-13",
      "text": "特征矩阵变成 17 维。",
      "start": 19.804,
      "end": 21.268
    },
    {
      "id": "shot04-14",
      "text": "切到 step 4，",
      "start": 21.65,
      "end": 22.653
    },
    {
      "id": "shot04-15",
      "text": "横轴从原始 tenure 变成",
      "start": 22.653,
      "end": 24.418
    },
    {
      "id": "shot04-16",
      "text": "z-score，",
      "start": 24.418,
      "end": 25.04
    },
    {
      "id": "shot04-17",
      "text": "说明标准化已经发生。",
      "start": 25.04,
      "end": 26.725
    },
    {
      "id": "shot04-18",
      "text": "切到 step 5，",
      "start": 26.725,
      "end": 27.688
    },
    {
      "id": "shot04-19",
      "text": "逻辑回归训练完成，",
      "start": 27.688,
      "end": 29.313
    },
    {
      "id": "shot04-20",
      "text": "图上出现单维近似的 sigmoid 决策",
      "start": 29.313,
      "end": 31.961
    },
    {
      "id": "shot04-21",
      "text": "曲线，",
      "start": 31.961,
      "end": 32.422
    },
    {
      "id": "shot04-22",
      "text": "右下角出现 top-10 系数排行。",
      "start": 32.422,
      "end": 34.749
    },
    {
      "id": "shot04-23",
      "text": "最后切到 step 6，",
      "start": 35.039,
      "end": 36.623
    },
    {
      "id": "shot04-24",
      "text": "评估指标柱图出现：",
      "start": 36.623,
      "end": 38.188
    },
    {
      "id": "shot04-25",
      "text": "当前实跑 accuracy 约 0.",
      "start": 38.188,
      "end": 40.173
    },
    {
      "id": "shot04-26",
      "text": "763，",
      "start": 40.173,
      "end": 41.055
    },
    {
      "id": "shot04-27",
      "text": "precision 约 0.428，",
      "start": 41.055,
      "end": 42.9
    },
    {
      "id": "shot04-28",
      "text": "recall 约 0.792，",
      "start": 42.9,
      "end": 44.986
    },
    {
      "id": "shot04-29",
      "text": "F1 约 0.556，",
      "start": 44.986,
      "end": 46.65
    },
    {
      "id": "shot04-30",
      "text": "AUC 约 0.862。",
      "start": 46.65,
      "end": 48.395
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "为什么这里不能只看 accuracy？",
      "start": 0.0,
      "end": 2.261
    },
    {
      "id": "shot05-1",
      "text": "因为流失客户是少数类。",
      "start": 2.261,
      "end": 4.402
    },
    {
      "id": "shot05-2",
      "text": "如果一个模型什么都不做，",
      "start": 4.402,
      "end": 6.343
    },
    {
      "id": "shot05-3",
      "text": "只把所有人都判成留存，",
      "start": 6.343,
      "end": 8.424
    },
    {
      "id": "shot05-4",
      "text": "也能拿到一个看起来不低的准确率，",
      "start": 8.424,
      "end": 11.185
    },
    {
      "id": "shot05-5",
      "text": "但它对业务没有价值：",
      "start": 11.185,
      "end": 13.086
    },
    {
      "id": "shot05-6",
      "text": "真正会流失的人一个都没抓到。",
      "start": 13.086,
      "end": 15.708
    },
    {
      "id": "shot05-7",
      "text": "流失场景里，",
      "start": 15.708,
      "end": 17.048
    },
    {
      "id": "shot05-8",
      "text": "FN 的代价通常很高。",
      "start": 17.048,
      "end": 18.889
    },
    {
      "id": "shot05-9",
      "text": "真要走的客户没被识别，",
      "start": 18.889,
      "end": 20.975
    },
    {
      "id": "shot05-10",
      "text": "就错过挽留窗口；",
      "start": 20.975,
      "end": 22.781
    },
    {
      "id": "shot05-11",
      "text": "FP 的代价是给本来不会流失的人多发一次",
      "start": 22.781,
      "end": 26.151
    },
    {
      "id": "shot05-12",
      "text": "权益或多做一次触达。",
      "start": 26.151,
      "end": 27.916
    },
    {
      "id": "shot05-13",
      "text": "两者都要管，",
      "start": 27.916,
      "end": 29.099
    },
    {
      "id": "shot05-14",
      "text": "但很多业务会更重视 recall 和",
      "start": 29.099,
      "end": 31.647
    },
    {
      "id": "shot05-15",
      "text": "AUC。",
      "start": 31.647,
      "end": 32.028
    },
    {
      "id": "shot05-16",
      "text": "Recall 告诉我们抓回了多少真流失客",
      "start": 32.565,
      "end": 35.375
    },
    {
      "id": "shot05-17",
      "text": "户，",
      "start": 35.375,
      "end": 35.816
    },
    {
      "id": "shot05-18",
      "text": "AUC 告诉我们风险排序是否可靠。",
      "start": 35.816,
      "end": 39.268
    },
    {
      "id": "shot05-19",
      "text": "最后要不要调阈值，",
      "start": 39.268,
      "end": 40.773
    },
    {
      "id": "shot05-20",
      "text": "则取决于挽留成本和客户生命周期价值。",
      "start": 40.773,
      "end": 43.923
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "逻辑回归还有一个实用优点：",
      "start": 0.0,
      "end": 2.245
    },
    {
      "id": "shot06-1",
      "text": "系数可以回到业务解释。",
      "start": 2.245,
      "end": 4.169
    },
    {
      "id": "shot06-2",
      "text": "因为我们做了标准化，",
      "start": 4.169,
      "end": 5.571
    },
    {
      "id": "shot06-3",
      "text": "系数大小更适合横向比较。",
      "start": 5.571,
      "end": 7.896
    },
    {
      "id": "shot06-4",
      "text": "当前 demo 的 top 系数里，",
      "start": 7.896,
      "end": 9.86
    },
    {
      "id": "shot06-5",
      "text": "Contract_Two year 和",
      "start": 9.86,
      "end": 10.922
    },
    {
      "id": "shot06-6",
      "text": "tenure 是明显负系数，",
      "start": 10.922,
      "end": 12.786
    },
    {
      "id": "shot06-7",
      "text": "表示两年合约和在网时间更长，",
      "start": 12.786,
      "end": 15.371
    },
    {
      "id": "shot06-8",
      "text": "会把客户推向留存。",
      "start": 15.371,
      "end": 17.375
    },
    {
      "id": "shot06-9",
      "text": "Contract_One year 也是",
      "start": 17.375,
      "end": 18.718
    },
    {
      "id": "shot06-10",
      "text": "负向。",
      "start": 18.718,
      "end": 19.099
    },
    {
      "id": "shot06-11",
      "text": "InternetService_Fiber",
      "start": 19.32,
      "end": 20.784
    },
    {
      "id": "shot06-12",
      "text": "optic、",
      "start": 20.784,
      "end": 21.386
    },
    {
      "id": "shot06-13",
      "text": "MonthlyCharges、",
      "start": 21.386,
      "end": 22.489
    },
    {
      "id": "shot06-14",
      "text": "PaymentMethod_Electronic",
      "start": 22.489,
      "end": 24.054
    },
    {
      "id": "shot06-15",
      "text": "check 是正系数，",
      "start": 24.054,
      "end": 25.458
    },
    {
      "id": "shot06-16",
      "text": "表示它们会把流失风险往上推。",
      "start": 25.458,
      "end": 28.045
    },
    {
      "id": "shot06-17",
      "text": "OnlineSecurity_Yes、",
      "start": 28.045,
      "end": 29.569
    },
    {
      "id": "shot06-18",
      "text": "TechSupport_Yes、",
      "start": 29.569,
      "end": 30.692
    },
    {
      "id": "shot06-19",
      "text": "Dependents_Yes、",
      "start": 30.692,
      "end": 31.776
    },
    {
      "id": "shot06-20",
      "text": "Partner_Yes 是负系数，",
      "start": 31.776,
      "end": 33.641
    },
    {
      "id": "shot06-21",
      "text": "说明服务绑定和关系绑定可能有留存作用。",
      "start": 33.641,
      "end": 36.649
    },
    {
      "id": "shot06-22",
      "text": "更严谨地说，",
      "start": 37.074,
      "end": 38.095
    },
    {
      "id": "shot06-23",
      "text": "系数比较的是当前编码、标准化、",
      "start": 38.095,
      "end": 41.013
    },
    {
      "id": "shot06-24",
      "text": "正则化和其他变量固定下，",
      "start": 41.013,
      "end": 43.282
    },
    {
      "id": "shot06-25",
      "text": "对 log-odds 的边际影响；",
      "start": 43.282,
      "end": 45.325
    },
    {
      "id": "shot06-26",
      "text": "相关特征之间的排名要谨慎读。",
      "start": 45.325,
      "end": 48.089
    },
    {
      "id": "shot06-27",
      "text": "这里不要把系数解释成因果结论，",
      "start": 48.089,
      "end": 50.712
    },
    {
      "id": "shot06-28",
      "text": "它只是模型在当前数据分布里学到的相关方向。",
      "start": 50.712,
      "end": 55.178
    },
    {
      "id": "shot06-29",
      "text": "但它已经足够帮助业务提出下一步问题：",
      "start": 55.178,
      "end": 58.403
    },
    {
      "id": "shot06-30",
      "text": "哪些客户要优先挽留，",
      "start": 58.403,
      "end": 60.365
    },
    {
      "id": "shot06-31",
      "text": "哪些服务可能是留存杠杆。",
      "start": 60.365,
      "end": 62.468
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "到这里，",
      "start": 0.0,
      "end": 0.501
    },
    {
      "id": "shot07-1",
      "text": "逻辑回归这一章就闭环了。",
      "start": 0.501,
      "end": 2.724
    },
    {
      "id": "shot07-2",
      "text": "我们从一个线性分数 z 开始，",
      "start": 2.724,
      "end": 4.967
    },
    {
      "id": "shot07-3",
      "text": "用 sigmoid 把它变成概率；",
      "start": 4.967,
      "end": 7.05
    },
    {
      "id": "shot07-4",
      "text": "用最大似然和 log loss 解释为什",
      "start": 7.05,
      "end": 9.514
    },
    {
      "id": "shot07-5",
      "text": "么模型会这样训练；",
      "start": 9.514,
      "end": 10.996
    },
    {
      "id": "shot07-6",
      "text": "用 sklearn API 把训练、",
      "start": 10.996,
      "end": 13.42
    },
    {
      "id": "shot07-7",
      "text": "预测概率、",
      "start": 13.42,
      "end": 14.301
    },
    {
      "id": "shot07-8",
      "text": "正则化和标准化串起来；",
      "start": 14.301,
      "end": 16.604
    },
    {
      "id": "shot07-9",
      "text": "再用混淆矩阵、",
      "start": 16.604,
      "end": 17.746
    },
    {
      "id": "shot07-10",
      "text": "precision、",
      "start": 17.746,
      "end": 18.467
    },
    {
      "id": "shot07-11",
      "text": "recall、F1、",
      "start": 18.467,
      "end": 19.609
    },
    {
      "id": "shot07-12",
      "text": "ROC 和 AUC 看模型到底好在哪里、",
      "start": 19.609,
      "end": 23.094
    },
    {
      "id": "shot07-13",
      "text": "错在哪里。",
      "start": 23.094,
      "end": 23.615
    },
    {
      "id": "shot07-14",
      "text": "最后回到客户流失，",
      "start": 24.098,
      "end": 25.623
    },
    {
      "id": "shot07-15",
      "text": "把概率分数变成风险排序，",
      "start": 25.623,
      "end": 27.789
    },
    {
      "id": "shot07-16",
      "text": "把阈值选择交给业务代价，",
      "start": 27.789,
      "end": 29.835
    },
    {
      "id": "shot07-17",
      "text": "把系数解释变成可讨论的业务线索。",
      "start": 29.835,
      "end": 32.885
    },
    {
      "id": "shot07-18",
      "text": "逻辑回归看起来简单，",
      "start": 32.885,
      "end": 34.61
    },
    {
      "id": "shot07-19",
      "text": "但它给了分类问题一套非常完整的基线方法。",
      "start": 34.61,
      "end": 38.0
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下章见，",
      "start": 0.0,
      "end": 0.689
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.689,
