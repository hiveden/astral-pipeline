{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "打开手机看天气，",
      "start": 0.0,
      "end": 1.201
    },
    {
      "id": "shot01-1",
      "text": "我们通常不只看“明天下雨”或者“明天不下",
      "start": 1.201,
      "end": 4.245
    },
    {
      "id": "shot01-2",
      "text": "雨”，",
      "start": 4.245,
      "end": 4.665
    },
    {
      "id": "shot01-3",
      "text": "还会看一行小字：",
      "start": 4.665,
      "end": 6.347
    },
    {
      "id": "shot01-4",
      "text": "降雨概率 70%。",
      "start": 6.347,
      "end": 8.37
    },
    {
      "id": "shot01-5",
      "text": "这行概率很关键，",
      "start": 8.37,
      "end": 9.691
    },
    {
      "id": "shot01-6",
      "text": "因为业务动作完全不同：",
      "start": 9.691,
      "end": 11.874
    },
    {
      "id": "shot01-7",
      "text": "70% 就带伞，",
      "start": 11.874,
      "end": 13.455
    },
    {
      "id": "shot01-8",
      "text": "30% 可能顺手带折叠伞，",
      "start": 13.455,
      "end": 16.038
    },
    {
      "id": "shot01-9",
      "text": "5% 基本可以不管。类别、概率、动作，",
      "start": 16.038,
      "end": 19.462
    },
    {
      "id": "shot01-10",
      "text": "这三件事绑在一起，",
      "start": 19.462,
      "end": 21.184
    },
    {
      "id": "shot01-11",
      "text": "才是一个可用的判断。",
      "start": 21.184,
      "end": 22.406
    },
    {
      "id": "shot01-12",
      "text": "逻辑回归，",
      "start": 22.863,
      "end": 23.644
    },
    {
      "id": "shot01-13",
      "text": "英文 Logistic",
      "start": 23.644,
      "end": 24.886
    },
    {
      "id": "shot01-14",
      "text": "Regression，",
      "start": 24.886,
      "end": 25.586
    },
    {
      "id": "shot01-15",
      "text": "简写 LR，",
      "start": 25.586,
      "end": 26.768
    },
    {
      "id": "shot01-16",
      "text": "做的就是类似的事：",
      "start": 26.768,
      "end": 28.009
    },
    {
      "id": "shot01-17",
      "text": "它不是预测连续数值，",
      "start": 28.009,
      "end": 29.992
    },
    {
      "id": "shot01-18",
      "text": "而是解决二分类问题，",
      "start": 29.992,
      "end": 31.934
    },
    {
      "id": "shot01-19",
      "text": "同时给出属于正类的概率。",
      "start": 31.934,
      "end": 34.337
    },
    {
      "id": "shot01-20",
      "text": "这一期我们先把 LR 的入门链条立起来：",
      "start": 34.337,
      "end": 37.321
    },
    {
      "id": "shot01-21",
      "text": "线性模型怎么算分，",
      "start": 37.321,
      "end": 38.763
    },
    {
      "id": "shot01-22",
      "text": "sigmoid 怎么把分数变成概率，",
      "start": 38.763,
      "end": 41.105
    },
    {
      "id": "shot01-23",
      "text": "阈值又怎么把概率切成类别。",
      "start": 41.105,
      "end": 42.888
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先纠正一个最容易误会的点：",
      "start": 0.0,
      "end": 2.242
    },
    {
      "id": "shot02-1",
      "text": "逻辑回归名字里有“回归”，",
      "start": 2.242,
      "end": 4.284
    },
    {
      "id": "shot02-2",
      "text": "但它不是线性回归那种预测房价、体重、",
      "start": 4.284,
      "end": 7.406
    },
    {
      "id": "shot02-3",
      "text": "销售额的连续值模型。",
      "start": 7.406,
      "end": 9.648
    },
    {
      "id": "shot02-4",
      "text": "它的主场是二分类：",
      "start": 9.648,
      "end": 11.229
    },
    {
      "id": "shot02-5",
      "text": "疾病诊断里阳性还是阴性，",
      "start": 11.229,
      "end": 13.511
    },
    {
      "id": "shot02-6",
      "text": "银行风控里放贷还是不放贷，",
      "start": 13.511,
      "end": 16.113
    },
    {
      "id": "shot02-7",
      "text": "情感分析里正面还是负面，",
      "start": 16.113,
      "end": 18.335
    },
    {
      "id": "shot02-8",
      "text": "邮件系统里垃圾还是正常。",
      "start": 18.335,
      "end": 20.597
    },
    {
      "id": "shot02-9",
      "text": "为什么还叫回归？",
      "start": 20.597,
      "end": 22.32
    },
    {
      "id": "shot02-10",
      "text": "因为它内部第一步确实借用了线性回归的形式：",
      "start": 22.32,
      "end": 26.028
    },
    {
      "id": "shot02-11",
      "text": "把特征乘权重再加偏置，",
      "start": 26.028,
      "end": 28.472
    },
    {
      "id": "shot02-12",
      "text": "得到一个线性分数。",
      "start": 28.472,
      "end": 30.055
    },
    {
      "id": "shot02-13",
      "text": "只是线性回归到这里就把分数当预测值输出，",
      "start": 30.055,
      "end": 33.743
    },
    {
      "id": "shot02-14",
      "text": "而逻辑回归不会直接输出这个分数。",
      "start": 33.743,
      "end": 36.187
    },
    {
      "id": "shot02-15",
      "text": "它还要把分数翻译成概率，",
      "start": 36.778,
      "end": 38.984
    },
    {
      "id": "shot02-16",
      "text": "再用阈值切成 0 或 1。",
      "start": 38.984,
      "end": 41.492
    },
    {
      "id": "shot02-17",
      "text": "所以一句话定位：",
      "start": 41.492,
      "end": 42.916
    },
    {
      "id": "shot02-18",
      "text": "LR 是“线性打分 + 概率翻译 + 阈",
      "start": 42.916,
      "end": 46.767
    },
    {
      "id": "shot02-19",
      "text": "值切类”的二分类模型。",
      "start": 46.767,
      "end": 48.472
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "把这条链展开看。第一步，",
      "start": 0.0,
      "end": 2.162
    },
    {
      "id": "shot03-1",
      "text": "线性模型算分。",
      "start": 2.162,
      "end": 3.604
    },
    {
      "id": "shot03-2",
      "text": "比如一封邮件里“中奖”出现一次加 1.5",
      "start": 3.604,
      "end": 6.647
    },
    {
      "id": "shot03-3",
      "text": "分，",
      "start": 6.647,
      "end": 7.028
    },
    {
      "id": "shot03-4",
      "text": "发件人陌生加 1.2 分，",
      "start": 7.028,
      "end": 9.1
    },
    {
      "id": "shot03-5",
      "text": "正文长度正常减 0.4 分，",
      "start": 9.1,
      "end": 11.412
    },
    {
      "id": "shot03-6",
      "text": "最后得到 z 等于 2.3。",
      "start": 11.412,
      "end": 13.335
    },
    {
      "id": "shot03-7",
      "text": "z 只是一个普通实数，",
      "start": 13.335,
      "end": 15.016
    },
    {
      "id": "shot03-8",
      "text": "可能是 2.3，",
      "start": 15.016,
      "end": 16.078
    },
    {
      "id": "shot03-9",
      "text": "也可能是负 4.2，",
      "start": 16.078,
      "end": 17.519
    },
    {
      "id": "shot03-10",
      "text": "甚至 1024。第二步，",
      "start": 17.519,
      "end": 19.601
    },
    {
      "id": "shot03-11",
      "text": "sigmoid 函数把 z 压到 0 到",
      "start": 19.601,
      "end": 21.804
    },
    {
      "id": "shot03-12",
      "text": "1 之间，",
      "start": 21.804,
      "end": 22.364
    },
    {
      "id": "shot03-13",
      "text": "得到概率 p。",
      "start": 22.364,
      "end": 23.446
    },
    {
      "id": "shot03-14",
      "text": "比如 z 等于 2.3，",
      "start": 23.446,
      "end": 24.987
    },
    {
      "id": "shot03-15",
      "text": "p 大约是 0.91，",
      "start": 24.987,
      "end": 26.489
    },
    {
      "id": "shot03-16",
      "text": "就能读成“91% 概率是垃圾邮件”。",
      "start": 26.489,
      "end": 29.132
    },
    {
      "id": "shot03-17",
      "text": "第三步，",
      "start": 29.523,
      "end": 30.224
    },
    {
      "id": "shot03-18",
      "text": "拿 p 和阈值比。",
      "start": 30.224,
      "end": 31.646
    },
    {
      "id": "shot03-19",
      "text": "最常见阈值是 0.5，",
      "start": 31.646,
      "end": 33.508
    },
    {
      "id": "shot03-20",
      "text": "p 大于等于 0.5 判正类，",
      "start": 33.508,
      "end": 35.911
    },
    {
      "id": "shot03-21",
      "text": "小于 0.5 判负类。注意，",
      "start": 35.911,
      "end": 38.274
    },
    {
      "id": "shot03-22",
      "text": "阈值不是死的。",
      "start": 38.274,
      "end": 39.536
    },
    {
      "id": "shot03-23",
      "text": "金融风控宁可错杀，",
      "start": 39.536,
      "end": 41.418
    },
    {
      "id": "shot03-24",
      "text": "可以把阈值抬高；",
      "start": 41.418,
      "end": 42.86
    },
    {
      "id": "shot03-25",
      "text": "广告召回想多抓一些潜在点击，",
      "start": 42.86,
      "end": 45.463
    },
    {
      "id": "shot03-26",
      "text": "可以把阈值压低。",
      "start": 45.463,
      "end": 47.025
    },
    {
      "id": "shot03-27",
      "text": "这样 LR 的三段职责就分开了：",
      "start": 47.025,
      "end": 49.508
    },
    {
      "id": "shot03-28",
      "text": "线性层负责特征怎么加权，",
      "start": 49.508,
      "end": 51.731
    },
    {
      "id": "shot03-29",
      "text": "sigmoid 负责把分数翻译成概率，",
      "start": 51.731,
      "end": 54.695
    },
    {
      "id": "shot03-30",
      "text": "阈值负责业务怎么切。",
      "start": 54.695,
      "end": 56.097
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开 demo 看 sigmoid 这道",
      "start": 0.0,
      "end": 1.742
    },
    {
      "id": "shot04-1",
      "text": "桥。",
      "start": 1.742,
      "end": 2.103
    },
    {
      "id": "shot04-2",
      "text": "左侧是控制区，",
      "start": 2.103,
      "end": 3.184
    },
    {
      "id": "shot04-3",
      "text": "有 z 滑块和几个预设；",
      "start": 3.184,
      "end": 4.966
    },
    {
      "id": "shot04-4",
      "text": "右侧主图是 S 形曲线，",
      "start": 4.966,
      "end": 6.948
    },
    {
      "id": "shot04-5",
      "text": "下面是当前概率条，",
      "start": 6.948,
      "end": 8.67
    },
    {
      "id": "shot04-6",
      "text": "底部面板显示 z、σ(z)、",
      "start": 8.67,
      "end": 11.181
    },
    {
      "id": "shot04-7",
      "text": "σ'(z)，",
      "start": 11.181,
      "end": 12.155
    },
    {
      "id": "shot04-8",
      "text": "以及按 0.5 阈值得到的类别。",
      "start": 12.155,
      "end": 14.718
    },
    {
      "id": "shot04-9",
      "text": "先看 z 等于 0。",
      "start": 14.718,
      "end": 16.6
    },
    {
      "id": "shot04-10",
      "text": "红点在曲线正中间，",
      "start": 16.6,
      "end": 18.496
    },
    {
      "id": "shot04-11",
      "text": "σ(0) 等于 0.5，",
      "start": 18.496,
      "end": 20.104
    },
    {
      "id": "shot04-12",
      "text": "导数 σ'(0) 等于 0.25，",
      "start": 20.104,
      "end": 22.687
    },
    {
      "id": "shot04-13",
      "text": "这是整条曲线最敏感的位置。",
      "start": 22.687,
      "end": 24.689
    },
    {
      "id": "shot04-14",
      "text": "接着选预设 z 等于 2，",
      "start": 25.321,
      "end": 27.224
    },
    {
      "id": "shot04-15",
      "text": "红点往右上走，",
      "start": 27.224,
      "end": 28.686
    },
    {
      "id": "shot04-16",
      "text": "σ(2) 等于 0.8808，",
      "start": 28.686,
      "end": 30.869
    },
    {
      "id": "shot04-17",
      "text": "已经明显偏正类；",
      "start": 30.869,
      "end": 32.312
    },
    {
      "id": "shot04-18",
      "text": "再选 z 等于负 2，",
      "start": 32.312,
      "end": 33.974
    },
    {
      "id": "shot04-19",
      "text": "红点对称地往左下走，",
      "start": 33.974,
      "end": 36.052
    },
    {
      "id": "shot04-20",
      "text": "σ(-2) 等于 0.1192，偏负类。",
      "start": 36.052,
      "end": 39.302
    },
    {
      "id": "shot04-21",
      "text": "注意这两个点的导数一样，",
      "start": 39.302,
      "end": 41.125
    },
    {
      "id": "shot04-22",
      "text": "都是 0.105 左右，",
      "start": 41.125,
      "end": 42.807
    },
    {
      "id": "shot04-23",
      "text": "因为 sigmoid 关于中点对称。",
      "start": 42.807,
      "end": 45.291
    },
    {
      "id": "shot04-24",
      "text": "最后切到饱和区，",
      "start": 45.291,
      "end": 46.653
    },
    {
      "id": "shot04-25",
      "text": "把 z 拖到 10。",
      "start": 46.653,
      "end": 47.815
    },
    {
      "id": "shot04-26",
      "text": "概率条几乎顶满，",
      "start": 48.031,
      "end": 49.628
    },
    {
      "id": "shot04-27",
      "text": "σ(10) 等于 0.999955，",
      "start": 49.628,
      "end": 52.2
    },
    {
      "id": "shot04-28",
      "text": "看起来非常确定；",
      "start": 52.2,
      "end": 53.642
    },
    {
      "id": "shot04-29",
      "text": "但导数只剩 0.000045，",
      "start": 53.642,
      "end": 56.428
    },
    {
      "id": "shot04-30",
      "text": "曲线几乎变平。",
      "start": 56.428,
      "end": 57.771
    },
    {
      "id": "shot04-31",
      "text": "意思是输入再变大一点，",
      "start": 57.771,
      "end": 59.755
    },
    {
      "id": "shot04-32",
      "text": "输出几乎不动了。",
      "start": 59.755,
      "end": 61.218
    },
    {
      "id": "shot04-33",
      "text": "这就是 sigmoid 的两头饱和。",
      "start": 61.218,
      "end": 62.941
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "再切到导数模式。",
      "start": 0.0,
      "end": 1.62
    },
    {
      "id": "shot05-1",
      "text": "屏幕左边还是 sigmoid 本身，",
      "start": 1.62,
      "end": 3.961
    },
    {
      "id": "shot05-2",
      "text": "右边是它的导数曲线。",
      "start": 3.961,
      "end": 5.761
    },
    {
      "id": "shot05-3",
      "text": "导数公式很漂亮：",
      "start": 5.761,
      "end": 7.467
    },
    {
      "id": "shot05-4",
      "text": "σ'(z) 等于 σ(z) 乘以 1 减",
      "start": 7.467,
      "end": 10.412
    },
    {
      "id": "shot05-5",
      "text": "σ(z)。",
      "start": 10.412,
      "end": 10.923
    },
    {
      "id": "shot05-6",
      "text": "这意味着前向已经算出 σ(z) 以后，",
      "start": 10.923,
      "end": 13.623
    },
    {
      "id": "shot05-7",
      "text": "导数可以直接用它自己算出来，",
      "start": 13.623,
      "end": 15.824
    },
    {
      "id": "shot05-8",
      "text": "不需要重新算一次指数函数。",
      "start": 15.824,
      "end": 18.324
    },
    {
      "id": "shot05-9",
      "text": "右图形状像一个小钟，",
      "start": 18.324,
      "end": 20.105
    },
    {
      "id": "shot05-10",
      "text": "最高点在 z 等于 0，",
      "start": 20.105,
      "end": 21.865
    },
    {
      "id": "shot05-11",
      "text": "峰值 0.25；",
      "start": 21.865,
      "end": 23.225
    },
    {
      "id": "shot05-12",
      "text": "z 越往两头走，",
      "start": 23.225,
      "end": 24.686
    },
    {
      "id": "shot05-13",
      "text": "导数越接近 0。",
      "start": 24.686,
      "end": 25.686
    },
    {
      "id": "shot05-14",
      "text": "把红点从负 10 拖到 10，",
      "start": 26.202,
      "end": 28.304
    },
    {
      "id": "shot05-15",
      "text": "可以看到左图概率从接近 0 穿过 0.5",
      "start": 28.304,
      "end": 31.308
    },
    {
      "id": "shot05-16",
      "text": "再接近 1，",
      "start": 31.308,
      "end": 32.088
    },
    {
      "id": "shot05-17",
      "text": "右图导数则是中间高、两头低。",
      "start": 32.088,
      "end": 34.651
    },
    {
      "id": "shot05-18",
      "text": "这里先别展开深度学习，",
      "start": 34.651,
      "end": 36.433
    },
    {
      "id": "shot05-19",
      "text": "只记住一个直觉：",
      "start": 36.433,
      "end": 37.654
    },
    {
      "id": "shot05-20",
      "text": "sigmoid 中间最敏感，",
      "start": 37.654,
      "end": 39.176
    },
    {
      "id": "shot05-21",
      "text": "两头最迟钝。",
      "start": 39.176,
      "end": 40.658
    },
    {
      "id": "shot05-22",
      "text": "对 LR 这种一层模型来说，",
      "start": 40.658,
      "end": 42.8
    },
    {
      "id": "shot05-23",
      "text": "这正好把无界分数平滑翻译成概率；",
      "start": 42.8,
      "end": 45.923
    },
    {
      "id": "shot05-24",
      "text": "但如果把很多层 sigmoid 叠起来，",
      "start": 45.923,
      "end": 48.326
    },
    {
      "id": "shot05-25",
      "text": "梯度会一层层变小，",
      "start": 48.326,
      "end": 50.208
    },
    {
      "id": "shot05-26",
      "text": "所以深度网络后来更常用 ReLU。",
      "start": 50.208,
      "end": 52.751
    },
    {
      "id": "shot05-27",
      "text": "这个点本期只作为边界提示，",
      "start": 52.751,
      "end": 54.853
    },
    {
      "id": "shot05-28",
      "text": "不继续展开。",
      "start": 54.853,
      "end": 55.474
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.202
    },
    {
      "id": "shot06-1",
      "text": "我们先把逻辑回归的入口搭起来：第一，",
      "start": 1.202,
      "end": 4.447
    },
    {
      "id": "shot06-2",
      "text": "LR 名字带回归，",
      "start": 4.447,
      "end": 5.909
    },
    {
      "id": "shot06-3",
      "text": "但主场是二分类，",
      "start": 5.909,
      "end": 7.511
    },
    {
      "id": "shot06-4",
      "text": "比如阳性阴性、",
      "start": 7.511,
      "end": 8.993
    },
    {
      "id": "shot06-5",
      "text": "放贷不放贷、",
      "start": 8.993,
      "end": 10.195
    },
    {
      "id": "shot06-6",
      "text": "正面负面；第二，",
      "start": 10.195,
      "end": 11.737
    },
    {
      "id": "shot06-7",
      "text": "它不是直接输出类别，",
      "start": 11.737,
      "end": 13.821
    },
    {
      "id": "shot06-8",
      "text": "而是先用线性模型算分 z，",
      "start": 13.821,
      "end": 16.384
    },
    {
      "id": "shot06-9",
      "text": "再用 sigmoid 把 z 压到 0",
      "start": 16.384,
      "end": 18.487
    },
    {
      "id": "shot06-10",
      "text": "到 1 之间当概率；第三，",
      "start": 18.487,
      "end": 21.011
    },
    {
      "id": "shot06-11",
      "text": "阈值把概率切成类别，",
      "start": 21.011,
      "end": 23.194
    },
    {
      "id": "shot06-12",
      "text": "默认常见是 0.5，",
      "start": 23.194,
      "end": 24.997
    },
    {
      "id": "shot06-13",
      "text": "但业务可以按代价调整。",
      "start": 24.997,
      "end": 26.8
    },
    {
      "id": "shot06-14",
      "text": "这一期点到但没展开的有三件事：",
      "start": 27.206,
      "end": 29.668
    },
    {
      "id": "shot06-15",
      "text": "概率本身怎么严谨理解，",
      "start": 29.668,
      "end": 31.429
    },
    {
      "id": "shot06-16",
      "text": "留给下一期；",
      "start": 31.429,
      "end": 32.35
    },
    {
      "id": "shot06-17",
      "text": "参数 w 和 b 怎么从数据里学出来，",
      "start": 32.35,
      "end": 34.992
    },
    {
      "id": "shot06-18",
      "text": "留给 MLE 与损失函数；",
      "start": 34.992,
      "end": 37.304
    },
    {
      "id": "shot06-19",
      "text": "阈值怎么调才符合业务代价，",
      "start": 37.304,
      "end": 39.416
    },
    {
      "id": "shot06-20",
      "text": "留给分类评估那几期。",
      "start": 39.416,
      "end": 41.498
    },
    {
      "id": "shot06-21",
      "text": "下一期我们先补概率语言：联合概率、",
      "start": 41.498,
      "end": 44.26
    },
    {
      "id": "shot06-22",
      "text": "条件概率、独立事件。",
      "start": 44.26,
      "end": 45.921
    },
    {
      "id": "shot06-23",
      "text": "只有先知道概率在说什么，",
      "start": 45.921,
      "end": 47.943
    },
    {
      "id": "shot06-24",
      "text": "后面 MLE 和 log-loss 才能",
      "start": 47.943,
      "end": 50.185
    },
    {
      "id": "shot06-25",
      "text": "接得上。",
      "start": 50.185,
      "end": 50.465
    }
  ],
