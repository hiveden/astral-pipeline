{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们把概率语言补齐了：",
      "start": 0.0,
      "end": 2.322
    },
    {
      "id": "shot01-1",
      "text": "单个事件有概率，",
      "start": 2.322,
      "end": 3.684
    },
    {
      "id": "shot01-2",
      "text": "多个独立样本的概率可以连乘。",
      "start": 3.684,
      "end": 6.086
    },
    {
      "id": "shot01-3",
      "text": "现在换一个方向问：",
      "start": 6.086,
      "end": 7.767
    },
    {
      "id": "shot01-4",
      "text": "如果结果已经发生了，",
      "start": 7.767,
      "end": 9.609
    },
    {
      "id": "shot01-5",
      "text": "参数应该取多少才最合理？",
      "start": 9.609,
      "end": 11.751
    },
    {
      "id": "shot01-6",
      "text": "比如一枚硬币抛了 6 次，结果是正、反、",
      "start": 11.751,
      "end": 14.874
    },
    {
      "id": "shot01-7",
      "text": "反、正、正、正。",
      "start": 14.874,
      "end": 16.215
    },
    {
      "id": "shot01-8",
      "text": "正面出现了 4 次，",
      "start": 16.215,
      "end": 17.616
    },
    {
      "id": "shot01-9",
      "text": "反面出现了 2 次。直觉上，",
      "start": 17.616,
      "end": 19.738
    },
    {
      "id": "shot01-10",
      "text": "这枚硬币正面概率应该是 4/6；",
      "start": 19.738,
      "end": 22.421
    },
    {
      "id": "shot01-11",
      "text": "在伯努利硬币模型里，",
      "start": 22.421,
      "end": 24.183
    },
    {
      "id": "shot01-12",
      "text": "MLE 给出的答案也正好是 4/6。",
      "start": 24.183,
      "end": 26.585
    },
    {
      "id": "shot01-13",
      "text": "极大似然估计，",
      "start": 27.079,
      "end": 28.422
    },
    {
      "id": "shot01-14",
      "text": "英文 Maximum",
      "start": 28.422,
      "end": 29.625
    },
    {
      "id": "shot01-15",
      "text": "Likelihood",
      "start": 29.625,
      "end": 30.407
    },
    {
      "id": "shot01-16",
      "text": "Estimation，",
      "start": 30.407,
      "end": 31.349
    },
    {
      "id": "shot01-17",
      "text": "简写 MLE，",
      "start": 31.349,
      "end": 32.652
    },
    {
      "id": "shot01-18",
      "text": "就是把这个直觉写成数学流程：",
      "start": 32.652,
      "end": 35.118
    },
    {
      "id": "shot01-19",
      "text": "找一个参数，",
      "start": 35.118,
      "end": 36.06
    },
    {
      "id": "shot01-20",
      "text": "让已经看到的数据最可能发生。",
      "start": 36.06,
      "end": 38.145
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "把硬币例子写清楚。",
      "start": 0.0,
      "end": 1.542
    },
    {
      "id": "shot02-1",
      "text": "假设正面概率是 θ，",
      "start": 1.542,
      "end": 3.465
    },
    {
      "id": "shot02-2",
      "text": "反面概率就是 1 减 θ。",
      "start": 3.465,
      "end": 5.448
    },
    {
      "id": "shot02-3",
      "text": "观测序列里有 4 次正面、",
      "start": 5.448,
      "end": 7.497
    },
    {
      "id": "shot02-4",
      "text": "2 次反面，",
      "start": 7.497,
      "end": 8.372
    },
    {
      "id": "shot02-5",
      "text": "所以这组观测出现的概率可以写成 θ 的",
      "start": 8.372,
      "end": 11.296
    },
    {
      "id": "shot02-6",
      "text": "4 次方乘以 1 减 θ 的 2 次方。",
      "start": 11.296,
      "end": 14.18
    },
    {
      "id": "shot02-7",
      "text": "这个函数叫似然函数。注意，",
      "start": 14.18,
      "end": 16.824
    },
    {
      "id": "shot02-8",
      "text": "它不是问未来下一次正面概率是多少，",
      "start": 16.824,
      "end": 20.048
    },
    {
      "id": "shot02-9",
      "text": "而是在问：",
      "start": 20.048,
      "end": 20.849
    },
    {
      "id": "shot02-10",
      "text": "如果 θ 取某个值，",
      "start": 20.849,
      "end": 22.752
    },
    {
      "id": "shot02-11",
      "text": "已经看到的这 6 次结果有多合理。",
      "start": 22.752,
      "end": 25.376
    },
    {
      "id": "shot02-12",
      "text": "θ 太小，",
      "start": 25.832,
      "end": 26.653
    },
    {
      "id": "shot02-13",
      "text": "比如 0.1，",
      "start": 26.653,
      "end": 27.595
    },
    {
      "id": "shot02-14",
      "text": "会让 4 次正面显得很意外；θ 太大，",
      "start": 27.595,
      "end": 30.822
    },
    {
      "id": "shot02-15",
      "text": "比如 0.9，",
      "start": 30.822,
      "end": 31.804
    },
    {
      "id": "shot02-16",
      "text": "又会让 2 次反面显得很意外。",
      "start": 31.804,
      "end": 34.229
    },
    {
      "id": "shot02-17",
      "text": "让这组结果最不意外的位置，",
      "start": 34.229,
      "end": 36.393
    },
    {
      "id": "shot02-18",
      "text": "数学上正好是 θ 等于 4/6。",
      "start": 36.393,
      "end": 38.938
    },
    {
      "id": "shot02-19",
      "text": "这就是 MLE 的核心。",
      "start": 38.938,
      "end": 40.542
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "打开硬币 MLE demo。",
      "start": 0.0,
      "end": 2.303
    },
    {
      "id": "shot03-1",
      "text": "左侧可以改观测序列，",
      "start": 2.303,
      "end": 4.084
    },
    {
      "id": "shot03-2",
      "text": "也可以拖 θ；",
      "start": 4.084,
      "end": 5.326
    },
    {
      "id": "shot03-3",
      "text": "右侧是一条似然曲线，",
      "start": 5.326,
      "end": 7.208
    },
    {
      "id": "shot03-4",
      "text": "红点是当前 θ，",
      "start": 7.208,
      "end": 8.85
    },
    {
      "id": "shot03-5",
      "text": "竖线标出 θ 星，",
      "start": 8.85,
      "end": 10.611
    },
    {
      "id": "shot03-6",
      "text": "也就是 k/n。",
      "start": 10.611,
      "end": 12.273
    },
    {
      "id": "shot03-7",
      "text": "先看 θ 等于 0.5，",
      "start": 12.273,
      "end": 14.456
    },
    {
      "id": "shot03-8",
      "text": "这是公平硬币的猜测，",
      "start": 14.456,
      "end": 16.037
    },
    {
      "id": "shot03-9",
      "text": "但红点不在最高处。",
      "start": 16.037,
      "end": 17.959
    },
    {
      "id": "shot03-10",
      "text": "数学上的 θ 星正好是 4/6；",
      "start": 17.959,
      "end": 20.842
    },
    {
      "id": "shot03-11",
      "text": "demo 里把 θ 拖到 4/6 附近，",
      "start": 20.842,
      "end": 24.006
    },
    {
      "id": "shot03-12",
      "text": "红点来到曲线峰值，",
      "start": 24.006,
      "end": 25.848
    },
    {
      "id": "shot03-13",
      "text": "说明这组 4 正 2 反的观测在这里最合",
      "start": 25.848,
      "end": 28.751
    },
    {
      "id": "shot03-14",
      "text": "理。",
      "start": 28.751,
      "end": 28.771
    },
    {
      "id": "shot03-15",
      "text": "再把 θ 拖到 0.1，",
      "start": 29.205,
      "end": 31.129
    },
    {
      "id": "shot03-16",
      "text": "曲线值明显变小，",
      "start": 31.129,
      "end": 32.593
    },
    {
      "id": "shot03-17",
      "text": "因为 θ=0.1 很难解释 4 次正面；",
      "start": 32.593,
      "end": 36.081
    },
    {
      "id": "shot03-18",
      "text": "拖到 0.9 也会变小，",
      "start": 36.081,
      "end": 37.805
    },
    {
      "id": "shot03-19",
      "text": "因为它很难解释 2 次反面。",
      "start": 37.805,
      "end": 40.33
    },
    {
      "id": "shot03-20",
      "text": "这个 demo 把 MLE 的一句话可视",
      "start": 40.33,
      "end": 43.077
    },
    {
      "id": "shot03-21",
      "text": "化了：",
      "start": 43.077,
      "end": 43.558
    },
    {
      "id": "shot03-22",
      "text": "不是选一个看起来平均的参数，",
      "start": 43.558,
      "end": 46.264
    },
    {
      "id": "shot03-23",
      "text": "而是选让已发生数据最可能的参数。",
      "start": 46.264,
      "end": 49.05
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "接下来解释为什么机器学习里经常给似然函数",
      "start": 0.0,
      "end": 3.505
    },
    {
      "id": "shot04-1",
      "text": "取 log。",
      "start": 3.505,
      "end": 4.226
    },
    {
      "id": "shot04-2",
      "text": "原因有两个。第一，",
      "start": 4.226,
      "end": 5.868
    },
    {
      "id": "shot04-3",
      "text": "log 是单调递增函数。",
      "start": 5.868,
      "end": 7.751
    },
    {
      "id": "shot04-4",
      "text": "原来的 L 越大，",
      "start": 7.751,
      "end": 9.233
    },
    {
      "id": "shot04-5",
      "text": "log L 也越大，",
      "start": 9.233,
      "end": 10.615
    },
    {
      "id": "shot04-6",
      "text": "所以最大值位置不变。也就是说，",
      "start": 10.615,
      "end": 13.238
    },
    {
      "id": "shot04-7",
      "text": "最大化 L 和最大化 log L，",
      "start": 13.238,
      "end": 15.541
    },
    {
      "id": "shot04-8",
      "text": "会选到同一个参数。第二，",
      "start": 15.541,
      "end": 18.006
    },
    {
      "id": "shot04-9",
      "text": "概率连乘很难算。样本一多，几十个、",
      "start": 18.006,
      "end": 21.598
    },
    {
      "id": "shot04-10",
      "text": "几百个小于 1 的概率乘在一起，",
      "start": 21.598,
      "end": 24.127
    },
    {
      "id": "shot04-11",
      "text": "会变成一个极小的数；",
      "start": 24.127,
      "end": 25.772
    },
    {
      "id": "shot04-12",
      "text": "但取 log 以后，",
      "start": 25.772,
      "end": 27.037
    },
    {
      "id": "shot04-13",
      "text": "连乘变成连加，",
      "start": 27.037,
      "end": 28.542
    },
    {
      "id": "shot04-14",
      "text": "数值更稳定，",
      "start": 28.542,
      "end": 29.726
    },
    {
      "id": "shot04-15",
      "text": "求导也更顺手。",
      "start": 29.726,
      "end": 30.809
    },
    {
      "id": "shot04-16",
      "text": "硬币 demo 里切到 L 和 lnL",
      "start": 31.252,
      "end": 34.183
    },
    {
      "id": "shot04-17",
      "text": "对照，",
      "start": 34.183,
      "end": 34.745
    },
    {
      "id": "shot04-18",
      "text": "两条曲线高度和形状不一样，",
      "start": 34.745,
      "end": 37.295
    },
    {
      "id": "shot04-19",
      "text": "但峰值在同一个 θ 上。",
      "start": 37.295,
      "end": 39.463
    },
    {
      "id": "shot04-20",
      "text": "这就是 log 的核心价值：",
      "start": 39.463,
      "end": 41.33
    },
    {
      "id": "shot04-21",
      "text": "不改答案位置，",
      "start": 41.33,
      "end": 42.475
    },
    {
      "id": "shot04-22",
      "text": "但把计算变得可控。",
      "start": 42.475,
      "end": 43.88
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "再打开 underflow demo，",
      "start": 0.0,
      "end": 1.601
    },
    {
      "id": "shot05-1",
      "text": "看 log 为什么不只是数学优雅，",
      "start": 1.601,
      "end": 4.043
    },
    {
      "id": "shot05-2",
      "text": "而是工程刚需。",
      "start": 4.043,
      "end": 5.364
    },
    {
      "id": "shot05-3",
      "text": "先设 N 等于 10、",
      "start": 5.364,
      "end": 6.906
    },
    {
      "id": "shot05-4",
      "text": "P 等于 0.5，",
      "start": 6.906,
      "end": 7.926
    },
    {
      "id": "shot05-5",
      "text": "直接算 P 的 N 次方还能正常显示。",
      "start": 7.926,
      "end": 10.829
    },
    {
      "id": "shot05-6",
      "text": "再切到 N 等于 1000、",
      "start": 10.829,
      "end": 12.71
    },
    {
      "id": "shot05-7",
      "text": "P 仍然是 0.5，",
      "start": 12.71,
      "end": 14.052
    },
    {
      "id": "shot05-8",
      "text": "直接连乘已经小到接近浮点数底部；",
      "start": 14.052,
      "end": 17.374
    },
    {
      "id": "shot05-9",
      "text": "如果继续放大到更极端的 N 和更小的 P，",
      "start": 17.374,
      "end": 20.797
    },
    {
      "id": "shot05-10",
      "text": "结果会直接塌成 0。",
      "start": 20.797,
      "end": 22.498
    },
    {
      "id": "shot05-11",
      "text": "塌成 0 以后，",
      "start": 22.498,
      "end": 23.379
    },
    {
      "id": "shot05-12",
      "text": "模型就分不清两个非常小的概率谁更大，",
      "start": 23.379,
      "end": 26.762
    },
    {
      "id": "shot05-13",
      "text": "训练会出问题。",
      "start": 26.762,
      "end": 27.743
    },
    {
      "id": "shot05-14",
      "text": "但 log 版是 N 乘以 lnP，",
      "start": 28.278,
      "end": 30.681
    },
    {
      "id": "shot05-15",
      "text": "比如 N=1000、",
      "start": 30.681,
      "end": 31.923
    },
    {
      "id": "shot05-16",
      "text": "P=0.5 时大约是 -693.1，",
      "start": 31.923,
      "end": 34.787
    },
    {
      "id": "shot05-17",
      "text": "它仍然是一个干净的有限负数。",
      "start": 34.787,
      "end": 37.19
    },
    {
      "id": "shot05-18",
      "text": "右侧扫描图更直观：",
      "start": 37.19,
      "end": 38.933
    },
    {
      "id": "shot05-19",
      "text": "直接版一路掉到 0，",
      "start": 38.933,
      "end": 40.274
    },
    {
      "id": "shot05-20",
      "text": "log 版保持一条稳定斜线。",
      "start": 40.274,
      "end": 42.738
    },
    {
      "id": "shot05-21",
      "text": "所以后面讲逻辑回归损失时，",
      "start": 42.738,
      "end": 45.101
    },
    {
      "id": "shot05-22",
      "text": "看到 log 不要害怕，",
      "start": 45.101,
      "end": 46.583
    },
    {
      "id": "shot05-23",
      "text": "它是在救数值计算。",
      "start": 46.583,
      "end": 47.805
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "现在把这两件工具接回逻辑回归。",
      "start": 0.0,
      "end": 3.063
    },
    {
      "id": "shot06-1",
      "text": "LR 对每个样本输出正类概率 p。",
      "start": 3.063,
      "end": 6.487
    },
    {
      "id": "shot06-2",
      "text": "如果真实标签是 1，",
      "start": 6.487,
      "end": 8.229
    },
    {
      "id": "shot06-3",
      "text": "我们希望 p 越大越好；",
      "start": 8.229,
      "end": 10.211
    },
    {
      "id": "shot06-4",
      "text": "如果真实标签是 0，",
      "start": 10.211,
      "end": 11.913
    },
    {
      "id": "shot06-5",
      "text": "我们希望 1 减 p 越大越好。",
      "start": 11.913,
      "end": 14.436
    },
    {
      "id": "shot06-6",
      "text": "把所有样本正确发生的概率连乘起来，",
      "start": 14.436,
      "end": 17.599
    },
    {
      "id": "shot06-7",
      "text": "就是整组训练数据的似然。",
      "start": 17.599,
      "end": 20.302
    },
    {
      "id": "shot06-8",
      "text": "训练时要找一组 w 和 b，",
      "start": 20.302,
      "end": 22.765
    },
    {
      "id": "shot06-9",
      "text": "让这个似然尽可能大。",
      "start": 22.765,
      "end": 24.607
    },
    {
      "id": "shot06-10",
      "text": "为了计算稳定，",
      "start": 24.607,
      "end": 25.888
    },
    {
      "id": "shot06-11",
      "text": "把似然取 log，",
      "start": 25.888,
      "end": 27.35
    },
    {
      "id": "shot06-12",
      "text": "连乘变连加。",
      "start": 27.35,
      "end": 28.371
    },
    {
      "id": "shot06-13",
      "text": "再因为优化算法通常写成最小化问题，",
      "start": 28.887,
      "end": 31.916
    },
    {
      "id": "shot06-14",
      "text": "我们给它加一个负号，",
      "start": 31.916,
      "end": 33.641
    },
    {
      "id": "shot06-15",
      "text": "最大化对数似然就变成最小化负对数似然。",
      "start": 33.641,
      "end": 37.172
    },
    {
      "id": "shot06-16",
      "text": "下一期讲的逻辑回归损失函数，",
      "start": 37.172,
      "end": 39.779
    },
    {
      "id": "shot06-17",
      "text": "正是从这里长出来的。",
      "start": 39.779,
      "end": 41.143
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.792
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.792,
      "end": 2.233
    }
  ]
}
