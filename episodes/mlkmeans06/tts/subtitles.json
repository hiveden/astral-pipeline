{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "一家商场有 200 个会员，",
      "start": 0.0,
      "end": 2.103
    },
    {
      "id": "shot01-1",
      "text": "店长不想给所有人发同一张优惠券。",
      "start": 2.103,
      "end": 4.866
    },
    {
      "id": "shot01-2",
      "text": "有人收入高、消费也高，",
      "start": 4.866,
      "end": 6.889
    },
    {
      "id": "shot01-3",
      "text": "适合会员活动；",
      "start": 6.889,
      "end": 8.15
    },
    {
      "id": "shot01-4",
      "text": "有人收入高但消费低，",
      "start": 8.15,
      "end": 10.093
    },
    {
      "id": "shot01-5",
      "text": "可能需要唤醒；",
      "start": 10.093,
      "end": 11.354
    },
    {
      "id": "shot01-6",
      "text": "有人收入低但消费高，",
      "start": 11.354,
      "end": 13.296
    },
    {
      "id": "shot01-7",
      "text": "可能对折扣敏感。",
      "start": 13.296,
      "end": 15.039
    },
    {
      "id": "shot01-8",
      "text": "如果我们先把顾客分成几类，",
      "start": 15.039,
      "end": 17.362
    },
    {
      "id": "shot01-9",
      "text": "再给每类设计动作，",
      "start": 17.362,
      "end": 18.883
    },
    {
      "id": "shot01-10",
      "text": "营销就会具体很多。",
      "start": 18.883,
      "end": 20.626
    },
    {
      "id": "shot01-11",
      "text": "这一期用 K-Means 做一个完整顾客",
      "start": 20.626,
      "end": 23.289
    },
    {
      "id": "shot01-12",
      "text": "分群案例，",
      "start": 23.289,
      "end": 24.13
    },
    {
      "id": "shot01-13",
      "text": "把前面学过的 API、选 K、",
      "start": 24.13,
      "end": 26.653
    },
    {
      "id": "shot01-14",
      "text": "评估指标和业务解释串起来。",
      "start": 26.653,
      "end": 28.836
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "这份数据有 200 条顾客记录，",
      "start": 0.0,
      "end": 2.303
    },
    {
      "id": "shot02-1",
      "text": "原始字段包括性别、年龄、年收入、",
      "start": 2.303,
      "end": 5.247
    },
    {
      "id": "shot02-2",
      "text": "消费指数。",
      "start": 5.247,
      "end": 6.168
    },
    {
      "id": "shot02-3",
      "text": "案例代码没有把 4 个字段全部放进模型，",
      "start": 6.168,
      "end": 9.292
    },
    {
      "id": "shot02-4",
      "text": "而是只取年收入和消费指数两列。",
      "start": 9.292,
      "end": 12.116
    },
    {
      "id": "shot02-5",
      "text": "横轴是 Annual Income，",
      "start": 12.116,
      "end": 13.998
    },
    {
      "id": "shot02-6",
      "text": "也就是年收入；",
      "start": 13.998,
      "end": 15.08
    },
    {
      "id": "shot02-7",
      "text": "纵轴是 Spending Score，",
      "start": 15.08,
      "end": 16.682
    },
    {
      "id": "shot02-8",
      "text": "也就是消费指数。",
      "start": 16.682,
      "end": 18.324
    },
    {
      "id": "shot02-9",
      "text": "这样一张二维图很容易解释：",
      "start": 18.324,
      "end": 20.447
    },
    {
      "id": "shot02-10",
      "text": "右上角是收入高、消费也高；",
      "start": 20.447,
      "end": 22.95
    },
    {
      "id": "shot02-11",
      "text": "右下角是收入高但消费低；",
      "start": 22.95,
      "end": 25.213
    },
    {
      "id": "shot02-12",
      "text": "左上角是收入低但消费高。要注意，",
      "start": 25.213,
      "end": 27.916
    },
    {
      "id": "shot02-13",
      "text": "K-Means 看到的只有 X。",
      "start": 27.916,
      "end": 29.258
    },
    {
      "id": "shot02-14",
      "text": "没有进入 X 的性别和年龄，",
      "start": 30.129,
      "end": 32.448
    },
    {
      "id": "shot02-15",
      "text": "不会影响聚类结果。",
      "start": 32.448,
      "end": 33.779
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "这个案例保留原始做法：",
      "start": 0.0,
      "end": 1.781
    },
    {
      "id": "shot03-1",
      "text": "没有做标准化。",
      "start": 1.781,
      "end": 3.042
    },
    {
      "id": "shot03-2",
      "text": "原因是它只用了年收入和消费指数两列，",
      "start": 3.042,
      "end": 6.425
    },
    {
      "id": "shot03-3",
      "text": "两个维度的数值范围相对可比较。",
      "start": 6.425,
      "end": 9.127
    },
    {
      "id": "shot03-4",
      "text": "这里不要误解成 K-Means 不需要标",
      "start": 9.127,
      "end": 11.429
    },
    {
      "id": "shot03-5",
      "text": "准化。",
      "start": 11.429,
      "end": 11.989
    },
    {
      "id": "shot03-6",
      "text": "K-Means 每一步都在算距离，",
      "start": 11.989,
      "end": 14.031
    },
    {
      "id": "shot03-7",
      "text": "所以它对特征尺度很敏感。",
      "start": 14.031,
      "end": 16.453
    },
    {
      "id": "shot03-8",
      "text": "如果我们把年龄、年收入、",
      "start": 16.453,
      "end": 18.454
    },
    {
      "id": "shot03-9",
      "text": "消费指数一起放进模型，",
      "start": 18.454,
      "end": 20.296
    },
    {
      "id": "shot03-10",
      "text": "就要重新检查量纲。",
      "start": 20.296,
      "end": 22.017
    },
    {
      "id": "shot03-11",
      "text": "年收入的数值范围可能比年龄大很多，",
      "start": 22.017,
      "end": 25.049
    },
    {
      "id": "shot03-12",
      "text": "模型就可能主要按收入分簇。实践里，",
      "start": 25.049,
      "end": 28.262
    },
    {
      "id": "shot03-13",
      "text": "只要多个特征的量纲差别明显，",
      "start": 28.262,
      "end": 30.712
    },
    {
      "id": "shot03-14",
      "text": "就应该考虑标准化，",
      "start": 30.712,
      "end": 32.399
    },
    {
      "id": "shot03-15",
      "text": "再比较聚类结果。",
      "start": 32.399,
      "end": 33.623
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "接下来选 K。",
      "start": 0.0,
      "end": 1.402
    },
    {
      "id": "shot04-1",
      "text": "代码从 K=2 到 K=10 循环，",
      "start": 1.402,
      "end": 4.325
    },
    {
      "id": "shot04-2",
      "text": "每个 K 都训练一次 K-Means。",
      "start": 4.325,
      "end": 6.608
    },
    {
      "id": "shot04-3",
      "text": "训练后记录两个指标：",
      "start": 6.608,
      "end": 8.23
    },
    {
      "id": "shot04-4",
      "text": "一个是 km.inertia_，",
      "start": 8.23,
      "end": 10.512
    },
    {
      "id": "shot04-5",
      "text": "也就是 SSE；",
      "start": 10.512,
      "end": 11.854
    },
    {
      "id": "shot04-6",
      "text": "另一个是",
      "start": 11.854,
      "end": 12.374
    },
    {
      "id": "shot04-7",
      "text": "silhouette_score，",
      "start": 12.374,
      "end": 13.756
    },
    {
      "id": "shot04-8",
      "text": "也就是 SC 轮廓系数。",
      "start": 13.756,
      "end": 15.638
    },
    {
      "id": "shot04-9",
      "text": "SSE 用来看肘部，",
      "start": 15.638,
      "end": 17.901
    },
    {
      "id": "shot04-10",
      "text": "SC 用来看簇内近、簇间远。",
      "start": 17.901,
      "end": 20.684
    },
    {
      "id": "shot04-11",
      "text": "示例曲线给出的采用值是 K=5。",
      "start": 20.684,
      "end": 22.806
    },
    {
      "id": "shot04-12",
      "text": "注意，",
      "start": 23.498,
      "end": 23.919
    },
    {
      "id": "shot04-13",
      "text": "我们仍然说 K=5 是这个案例的候选和采",
      "start": 23.919,
      "end": 27.229
    },
    {
      "id": "shot04-14",
      "text": "用值，",
      "start": 27.229,
      "end": 27.791
    },
    {
      "id": "shot04-15",
      "text": "不说它是所有口径下唯一最优。",
      "start": 27.791,
      "end": 30.399
    },
    {
      "id": "shot04-16",
      "text": "真实项目里，",
      "start": 30.399,
      "end": 31.522
    },
    {
      "id": "shot04-17",
      "text": "还要结合每一簇的人数、",
      "start": 31.522,
      "end": 33.555
    },
    {
      "id": "shot04-18",
      "text": "质心位置和业务动作一起判断。",
      "start": 33.555,
      "end": 36.036
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "确定 K=5 以后，",
      "start": 0.0,
      "end": 1.741
    },
    {
      "id": "shot05-1",
      "text": "代码实例化 K-Means，",
      "start": 1.741,
      "end": 3.683
    },
    {
      "id": "shot05-2",
      "text": "设置 n_clusters 等于 5，",
      "start": 3.683,
      "end": 6.144
    },
    {
      "id": "shot05-3",
      "text": "训练模型，",
      "start": 6.144,
      "end": 7.245
    },
    {
      "id": "shot05-4",
      "text": "然后用 predict 得到每个顾客的簇",
      "start": 7.245,
      "end": 9.947
    },
    {
      "id": "shot05-5",
      "text": "编号。画图时，",
      "start": 9.947,
      "end": 11.448
    },
    {
      "id": "shot05-6",
      "text": "顾客点按簇编号上色，",
      "start": 11.448,
      "end": 13.69
    },
    {
      "id": "shot05-7",
      "text": "黑色大点表示 5 个质心。",
      "start": 13.69,
      "end": 16.291
    },
    {
      "id": "shot05-8",
      "text": "看图时不要先盯颜色名字，",
      "start": 16.291,
      "end": 18.813
    },
    {
      "id": "shot05-9",
      "text": "也不要相信第 0 簇、",
      "start": 18.813,
      "end": 20.294
    },
    {
      "id": "shot05-10",
      "text": "第 1 簇这些编号有固定含义。",
      "start": 20.294,
      "end": 22.516
    },
    {
      "id": "shot05-11",
      "text": "聚类编号只是算法返回的整数，",
      "start": 22.516,
      "end": 25.218
    },
    {
      "id": "shot05-12",
      "text": "可能随着随机初始化变化。更稳定、",
      "start": 25.218,
      "end": 28.169
    },
    {
      "id": "shot05-13",
      "text": "更能解释的是质心位置。",
      "start": 28.169,
      "end": 29.829
    },
    {
      "id": "shot05-14",
      "text": "右上角那一簇，",
      "start": 30.284,
      "end": 31.488
    },
    {
      "id": "shot05-15",
      "text": "年收入高、",
      "start": 31.488,
      "end": 32.612
    },
    {
      "id": "shot05-16",
      "text": "消费指数高，",
      "start": 32.612,
      "end": 33.836
    },
    {
      "id": "shot05-17",
      "text": "所以可以命名为黄金客户。",
      "start": 33.836,
      "end": 36.164
    },
    {
      "id": "shot05-18",
      "text": "这个名字来自坐标含义，",
      "start": 36.164,
      "end": 38.07
    },
    {
      "id": "shot05-19",
      "text": "不来自编号。",
      "start": 38.07,
      "end": 38.792
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "聚类交付不是一列 labels，",
      "start": 0.0,
      "end": 2.041
    },
    {
      "id": "shot06-1",
      "text": "而是人群画像和动作建议。",
      "start": 2.041,
      "end": 4.263
    },
    {
      "id": "shot06-2",
      "text": "右上角的黄金客户，",
      "start": 4.263,
      "end": 5.863
    },
    {
      "id": "shot06-3",
      "text": "可以重点做会员活动、",
      "start": 5.863,
      "end": 7.644
    },
    {
      "id": "shot06-4",
      "text": "新品邀请和高价值权益。",
      "start": 7.644,
      "end": 9.646
    },
    {
      "id": "shot06-5",
      "text": "右下角收入高但消费低，",
      "start": 9.646,
      "end": 11.947
    },
    {
      "id": "shot06-6",
      "text": "可能需要唤醒，",
      "start": 11.947,
      "end": 13.148
    },
    {
      "id": "shot06-7",
      "text": "看看是不是品类不匹配、触达不够、",
      "start": 13.148,
      "end": 15.909
    },
    {
      "id": "shot06-8",
      "text": "还是竞品吸走了预算。",
      "start": 15.909,
      "end": 18.071
    },
    {
      "id": "shot06-9",
      "text": "左上角收入不高但消费指数高，",
      "start": 18.071,
      "end": 20.872
    },
    {
      "id": "shot06-10",
      "text": "可能对活动更敏感，",
      "start": 20.872,
      "end": 22.433
    },
    {
      "id": "shot06-11",
      "text": "可以用折扣和积分策略维护。",
      "start": 22.433,
      "end": 24.815
    },
    {
      "id": "shot06-12",
      "text": "左下角收入和消费都低，",
      "start": 24.815,
      "end": 26.916
    },
    {
      "id": "shot06-13",
      "text": "可能不适合投入太高成本。",
      "start": 26.916,
      "end": 29.058
    },
    {
      "id": "shot06-14",
      "text": "这里的动作只是示例，",
      "start": 29.058,
      "end": 30.669
    },
    {
      "id": "shot06-15",
      "text": "真实业务还要看利润、品类、",
      "start": 30.669,
      "end": 33.146
    },
    {
      "id": "shot06-16",
      "text": "渠道和用户生命周期。",
      "start": 33.146,
      "end": 34.798
    },
    {
      "id": "shot06-17",
      "text": "但方法论不变：先聚类，再看画像，",
      "start": 35.308,
      "end": 38.199
    },
    {
      "id": "shot06-18",
      "text": "最后设计动作。",
      "start": 38.199,
      "end": 39.109
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这里，",
      "start": 0.0,
      "end": 0.842
    },
    {
      "id": "shot07-1",
      "text": "K-Means 这一章也收束一下。",
      "start": 0.842,
      "end": 2.826
    },
    {
      "id": "shot07-2",
      "text": "我们从没有标签的数据开始，",
      "start": 2.826,
      "end": 4.93
    },
    {
      "id": "shot07-3",
      "text": "先讲了聚类的定位；",
      "start": 4.93,
      "end": 6.473
    },
    {
      "id": "shot07-4",
      "text": "再用 sklearn API 跑通最小例",
      "start": 6.473,
      "end": 9.118
    },
    {
      "id": "shot07-5",
      "text": "子；",
      "start": 9.118,
      "end": 9.419
    },
    {
      "id": "shot07-6",
      "text": "接着打开 K-Means 的迭代过程，",
      "start": 9.419,
      "end": 11.563
    },
    {
      "id": "shot07-7",
      "text": "看分配样本和更新质心；",
      "start": 11.563,
      "end": 13.887
    },
    {
      "id": "shot07-8",
      "text": "然后用 SSE、肘部法、SC、",
      "start": 13.887,
      "end": 16.472
    },
    {
      "id": "shot07-9",
      "text": "CH 辅助选择 K；",
      "start": 16.472,
      "end": 18.957
    },
    {
      "id": "shot07-10",
      "text": "最后落到顾客分群案例。",
      "start": 18.957,
      "end": 20.621
    },
    {
      "id": "shot07-11",
      "text": "整章一句话：",
      "start": 21.046,
      "end": 22.048
    },
    {
      "id": "shot07-12",
      "text": "K-Means 做的不是替业务发明标签，",
      "start": 22.048,
      "end": 24.734
    },
    {
      "id": "shot07-13",
      "text": "而是把相似样本先分到一起，",
      "start": 24.734,
      "end": 27.139
    },
    {
      "id": "shot07-14",
      "text": "让业务有机会看见结构、命名人群、",
      "start": 27.139,
      "end": 30.005
    },
    {
      "id": "shot07-15",
      "text": "设计动作。",
      "start": 30.005,
      "end": 30.867
    },
    {
      "id": "shot07-16",
      "text": "后面遇到聚类项目，",
      "start": 30.867,
      "end": 32.35
    },
    {
      "id": "shot07-17",
      "text": "先问三件事：",
      "start": 32.35,
      "end": 33.573
    },
    {
      "id": "shot07-18",
      "text": "特征是否合理，",
      "start": 33.573,
      "end": 34.956
    },
    {
      "id": "shot07-19",
      "text": "K 是否可解释，",
      "start": 34.956,
      "end": 36.128
    },
    {
      "id": "shot07-20",
      "text": "簇画像能不能行动。",
      "start": 36.128,
      "end": 37.261
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下章见，",
      "start": 0.0,
      "end": 0.813
    },
    {
      "id": "shot08-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.813,
      "end": 2.297
    }
  ]
}
