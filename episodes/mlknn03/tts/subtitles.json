{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "前两期我们用 KNN 判断一个新样本是哪",
      "start": 0.0,
      "end": 3.12
    },
    {
      "id": "shot01-1",
      "text": "一类——比如喜欢还是不喜欢。",
      "start": 3.12,
      "end": 5.02
    },
    {
      "id": "shot01-2",
      "text": "这一期把这些拼起来：",
      "start": 5.02,
      "end": 6.36
    },
    {
      "id": "shot01-3",
      "text": "KNN 的完整工作流是什么样？而且，",
      "start": 6.36,
      "end": 9.02
    },
    {
      "id": "shot01-4",
      "text": "KNN 不止能判类别，",
      "start": 9.02,
      "end": 10.68
    },
    {
      "id": "shot01-5",
      "text": "还能预测一个连续数字——比如给电影打几分。",
      "start": 10.68,
      "end": 13.68
    },
    {
      "id": "shot01-6",
      "text": "同样的思想，",
      "start": 13.68,
      "end": 14.76
    },
    {
      "id": "shot01-7",
      "text": "不一样的输出。",
      "start": 14.76,
      "end": 16.18
    },
    {
      "id": "shot01-8",
      "text": "走完这一期，",
      "start": 16.18,
      "end": 17.04
    },
    {
      "id": "shot01-9",
      "text": "KNN 的全貌就清楚了。",
      "start": 17.04,
      "end": 18.8
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先把 KNN 的工作流写下来，",
      "start": 0.0,
      "end": 2.42
    },
    {
      "id": "shot02-1",
      "text": "一共 5 步。第一步，",
      "start": 2.42,
      "end": 3.94
    },
    {
      "id": "shot02-2",
      "text": "算测试样本到每一个训练样本的距离。第二步，",
      "start": 3.94,
      "end": 7.52
    },
    {
      "id": "shot02-3",
      "text": "按距离升序排序。第三步，",
      "start": 7.52,
      "end": 9.82
    },
    {
      "id": "shot02-4",
      "text": "取出最近的 K 个。第四步，多数表决。第五步，",
      "start": 9.82,
      "end": 13.3
    },
    {
      "id": "shot02-5",
      "text": "把表决结果作为预测类别输出。",
      "start": 13.3,
      "end": 15.54
    },
    {
      "id": "shot02-6",
      "text": "这就是 KNN 分类的全部。",
      "start": 15.54,
      "end": 17.98
    },
    {
      "id": "shot02-7",
      "text": "前两期每一步我们都讲过——算距离用欧氏距",
      "start": 17.98,
      "end": 21.34
    },
    {
      "id": "shot02-8",
      "text": "离来自第 1 期，",
      "start": 21.34,
      "end": 22.4
    },
    {
      "id": "shot02-9",
      "text": "K 怎么选来自第 2 期，",
      "start": 22.4,
      "end": 24.06
    },
    {
      "id": "shot02-10",
      "text": "多数表决和加权细节也在第 2 期末尾——",
      "start": 24.06,
      "end": 27.26
    },
    {
      "id": "shot02-11",
      "text": "这一期就是把它们串成完整流水线。",
      "start": 27.26,
      "end": 29.64
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "现在引入第二个任务类型：回归。",
      "start": 0.0,
      "end": 2.46
    },
    {
      "id": "shot03-1",
      "text": "机器学习里有两类基本任务，",
      "start": 2.46,
      "end": 4.4
    },
    {
      "id": "shot03-2",
      "text": "区别只在于输出长什么样。分类，",
      "start": 4.4,
      "end": 7.26
    },
    {
      "id": "shot03-3",
      "text": "英文 classification，",
      "start": 7.26,
      "end": 8.28
    },
    {
      "id": "shot03-4",
      "text": "输出是几种固定选项——喜欢或不喜欢、猫或狗、",
      "start": 8.28,
      "end": 12.7
    },
    {
      "id": "shot03-5",
      "text": "垃圾邮件或正常邮件。回归，",
      "start": 12.7,
      "end": 15.56
    },
    {
      "id": "shot03-6",
      "text": "英文 regression，",
      "start": 15.56,
      "end": 16.66
    },
    {
      "id": "shot03-7",
      "text": "输出是一个具体的数字——房价、股价、",
      "start": 16.66,
      "end": 19.82
    },
    {
      "id": "shot03-8",
      "text": "电影完成度。",
      "start": 19.82,
      "end": 20.66
    },
    {
      "id": "shot03-9",
      "text": "简单判断：",
      "start": 20.66,
      "end": 21.88
    },
    {
      "id": "shot03-10",
      "text": "你想预测的东西是从有限选项里挑一个？分类。",
      "start": 21.88,
      "end": 25.6
    },
    {
      "id": "shot03-11",
      "text": "是一个具体数字？",
      "start": 25.6,
      "end": 26.66
    },
    {
      "id": "shot03-12",
      "text": "回归。",
      "start": 26.66,
      "end": 27.82
    },
    {
      "id": "shot03-13",
      "text": "KNN 同样的思想，",
      "start": 27.82,
      "end": 29.28
    },
    {
      "id": "shot03-14",
      "text": "能做这两件事——核心一个，变种两个。",
      "start": 29.28,
      "end": 32.579
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "分类和回归 5 步流程并排放在一起，",
      "start": 0.0,
      "end": 3.4
    },
    {
      "id": "shot04-1",
      "text": "会发现前 3 步完全一样：算距离、排序、取前 K。",
      "start": 3.4,
      "end": 8.02
    },
    {
      "id": "shot04-2",
      "text": "区别只在第 4 步——分类是多数表决，",
      "start": 8.02,
      "end": 11.2
    },
    {
      "id": "shot04-3",
      "text": "回归是求平均。",
      "start": 11.2,
      "end": 12.64
    },
    {
      "id": "shot04-4",
      "text": "一边是离散类别投票，",
      "start": 12.64,
      "end": 14.5
    },
    {
      "id": "shot04-5",
      "text": "一边是 K 个邻居数值的算术平均。",
      "start": 14.5,
      "end": 17.64
    },
    {
      "id": "shot04-6",
      "text": "第 5 步输出对应不同：",
      "start": 17.64,
      "end": 19.34
    },
    {
      "id": "shot04-7",
      "text": "分类输出标签，",
      "start": 19.34,
      "end": 20.66
    },
    {
      "id": "shot04-8",
      "text": "回归输出数字。换句话说，",
      "start": 20.66,
      "end": 22.86
    },
    {
      "id": "shot04-9",
      "text": "KNN 从分类切到回归，",
      "start": 22.86,
      "end": 25.04
    },
    {
      "id": "shot04-10",
      "text": "流水线只换一个零件——把第 4 步的多数",
      "start": 25.04,
      "end": 28.1
    },
    {
      "id": "shot04-11",
      "text": "票换成平均值。",
      "start": 28.1,
      "end": 29.26
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "打开新的 demo——这次数据集还是电影，",
      "start": 0.0,
      "end": 2.9
    },
    {
      "id": "shot05-1",
      "text": "但目标值变了：",
      "start": 2.9,
      "end": 3.98
    },
    {
      "id": "shot05-2",
      "text": "不再是喜欢或不喜欢的标签，",
      "start": 3.98,
      "end": 6.16
    },
    {
      "id": "shot05-3",
      "text": "而是观看完成度，",
      "start": 6.16,
      "end": 7.54
    },
    {
      "id": "shot05-4",
      "text": "0 到 100% 的连续值。",
      "start": 7.54,
      "end": 9.74
    },
    {
      "id": "shot05-5",
      "text": "这次用新生成的 80 部电影，",
      "start": 9.74,
      "end": 12.02
    },
    {
      "id": "shot05-6",
      "text": "目标值大致由评分和主演吸引度决定。",
      "start": 12.02,
      "end": 15.14
    },
    {
      "id": "shot05-7",
      "text": "打开 demo，",
      "start": 15.14,
      "end": 16.26
    },
    {
      "id": "shot05-8",
      "text": "K 取 7。",
      "start": 16.26,
      "end": 17.42
    },
    {
      "id": "shot05-9",
      "text": "看决策面——它不再是分类那种淡绿淡红的双色块，",
      "start": 17.42,
      "end": 21.8
    },
    {
      "id": "shot05-10",
      "text": "而是一个连续色阶，",
      "start": 21.8,
      "end": 23.62
    },
    {
      "id": "shot05-11",
      "text": "从冷色到暖色。",
      "start": 23.62,
      "end": 25.22
    },
    {
      "id": "shot05-12",
      "text": "每一格的颜色对应这一格的预测完成度。",
      "start": 25.22,
      "end": 28.3
    },
    {
      "id": "shot05-13",
      "text": "下方有一个新指标：",
      "start": 28.642,
      "end": 30.082
    },
    {
      "id": "shot05-14",
      "text": "MAE，",
      "start": 30.082,
      "end": 31.402
    },
    {
      "id": "shot05-15",
      "text": "平均绝对误差，",
      "start": 31.402,
      "end": 32.922
    },
    {
      "id": "shot05-16",
      "text": "每部电影预测值和真实值取差的绝对值，",
      "start": 32.922,
      "end": 36.302
    },
    {
      "id": "shot05-17",
      "text": "再求平均——避免正负误差相互抵消。",
      "start": 36.302,
      "end": 39.442
    },
    {
      "id": "shot05-18",
      "text": "意思就是预测和真实平均差几个百分点。",
      "start": 39.442,
      "end": 42.442
    },
    {
      "id": "shot05-19",
      "text": "MAE 越小越准。",
      "start": 42.442,
      "end": 44.722
    },
    {
      "id": "shot05-20",
      "text": "回归还有 RMSE 和 R² 两个常用指标，",
      "start": 44.722,
      "end": 48.122
    },
    {
      "id": "shot05-21",
      "text": "但这一期先用 MAE 一个就够了，",
      "start": 48.122,
      "end": 50.922
    },
    {
      "id": "shot05-22",
      "text": "后面 sklearn 章节再展开。",
      "start": 50.922,
      "end": 52.862
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "现在拖 K，",
      "start": 0.0,
      "end": 1.24
    },
    {
      "id": "shot06-1",
      "text": "看回归在两端会怎样。",
      "start": 1.24,
      "end": 3.16
    },
    {
      "id": "shot06-2",
      "text": "K=1，",
      "start": 3.16,
      "end": 4.32
    },
    {
      "id": "shot06-3",
      "text": "决策面变得斑驳，",
      "start": 4.32,
      "end": 5.68
    },
    {
      "id": "shot06-4",
      "text": "每一格的颜色就是离它最近那一个训练点的完",
      "start": 5.68,
      "end": 8.71
    },
    {
      "id": "shot06-5",
      "text": "成度——预测跟着噪声跑。",
      "start": 8.71,
      "end": 10.82
    },
    {
      "id": "shot06-6",
      "text": "中段我们就不重看了，",
      "start": 10.82,
      "end": 12.48
    },
    {
      "id": "shot06-7",
      "text": "跟分类一样有平台期。",
      "start": 12.48,
      "end": 14.8
    },
    {
      "id": "shot06-8",
      "text": "直接跳到极端，",
      "start": 14.8,
      "end": 16.22
    },
    {
      "id": "shot06-9",
      "text": "K=80，",
      "start": 16.22,
      "end": 17.48
    },
    {
      "id": "shot06-10",
      "text": "已经等于样本数。",
      "start": 17.48,
      "end": 19.0
    },
    {
      "id": "shot06-11",
      "text": "看决策面：",
      "start": 19.0,
      "end": 20.08
    },
    {
      "id": "shot06-12",
      "text": "变成了单一颜色，",
      "start": 20.08,
      "end": 21.46
    },
    {
      "id": "shot06-13",
      "text": "对应训练集所有完成度的平均值——这个数据",
      "start": 21.46,
      "end": 24.9
    },
    {
      "id": "shot06-14",
      "text": "集均值大约 41%。",
      "start": 24.9,
      "end": 26.84
    },
    {
      "id": "shot06-15",
      "text": "无论新电影落哪儿，",
      "start": 26.84,
      "end": 28.58
    },
    {
      "id": "shot06-16",
      "text": "预测都是这个数——模型完全忽略了特征。",
      "start": 28.58,
      "end": 31.64
    },
    {
      "id": "shot06-17",
      "text": "这就是回归版的极端欠拟合，",
      "start": 31.986,
      "end": 34.266
    },
    {
      "id": "shot06-18",
      "text": "回归这边连多数类偏向都没有，",
      "start": 34.266,
      "end": 36.486
    },
    {
      "id": "shot06-19",
      "text": "直接变成全局均值。顺便一提：",
      "start": 36.486,
      "end": 39.206
    },
    {
      "id": "shot06-20",
      "text": "加权投票在回归里也能用，逻辑同理，",
      "start": 39.206,
      "end": 42.206
    },
    {
      "id": "shot06-21",
      "text": "离得近的邻居数值贡献大，",
      "start": 42.206,
      "end": 44.026
    },
    {
      "id": "shot06-22",
      "text": "这一期就不演了。",
      "start": 44.026,
      "end": 45.206
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "再看右边一张图叫残差图，",
      "start": 0.0,
      "end": 2.18
    },
    {
      "id": "shot07-1",
      "text": "英文 residual plot。",
      "start": 2.18,
      "end": 3.86
    },
    {
      "id": "shot07-2",
      "text": "横轴是真实完成度，",
      "start": 3.86,
      "end": 5.36
    },
    {
      "id": "shot07-3",
      "text": "纵轴是预测完成度。",
      "start": 5.36,
      "end": 6.76
    },
    {
      "id": "shot07-4",
      "text": "如果预测完美，",
      "start": 6.76,
      "end": 7.8
    },
    {
      "id": "shot07-5",
      "text": "所有点应该落在对角虚线上。",
      "start": 7.8,
      "end": 10.1
    },
    {
      "id": "shot07-6",
      "text": "点越偏离对角线，",
      "start": 10.1,
      "end": 11.52
    },
    {
      "id": "shot07-7",
      "text": "误差越大。",
      "start": 11.52,
      "end": 12.78
    },
    {
      "id": "shot07-8",
      "text": "点的颜色表示残差方向——残差等于预测减真实，",
      "start": 12.78,
      "end": 16.94
    },
    {
      "id": "shot07-9",
      "text": "红色表示残差为正、预测偏高；",
      "start": 16.94,
      "end": 19.34
    },
    {
      "id": "shot07-10",
      "text": "蓝色表示残差为负、预测偏低。",
      "start": 19.34,
      "end": 21.78
    },
    {
      "id": "shot07-11",
      "text": "残差图是回归任务最有用的诊断工具之一：",
      "start": 21.78,
      "end": 24.98
    },
    {
      "id": "shot07-12",
      "text": "模型在哪个区间预测准、",
      "start": 24.98,
      "end": 26.76
    },
    {
      "id": "shot07-13",
      "text": "在哪儿系统性偏差，",
      "start": 26.76,
      "end": 28.3
    },
    {
      "id": "shot07-14",
      "text": "一眼能看出来。",
      "start": 28.3,
      "end": 29.42
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "这一期到这，",
      "start": 0.0,
      "end": 1.0
    },
    {
      "id": "shot08-1",
      "text": "KNN 的第 1 章三期到这就讲完了。",
      "start": 1.0,
      "end": 3.66
    },
    {
      "id": "shot08-2",
      "text": "这一期讲清楚的：",
      "start": 3.66,
      "end": 5.12
    },
    {
      "id": "shot08-3",
      "text": "KNN 5 步工作流、",
      "start": 5.12,
      "end": 6.66
    },
    {
      "id": "shot08-4",
      "text": "分类和回归只差第 4 步（投票换平均）、",
      "start": 6.66,
      "end": 10.26
    },
    {
      "id": "shot08-5",
      "text": "MAE 和残差图两个回归看图工具。",
      "start": 10.26,
      "end": 13.72
    },
    {
      "id": "shot08-6",
      "text": "这一期点到没展开的：",
      "start": 13.72,
      "end": 15.6
    },
    {
      "id": "shot08-7",
      "text": "RMSE 和 R² 这两个回归评估指标，",
      "start": 15.6,
      "end": 19.28
    },
    {
      "id": "shot08-8",
      "text": "加上 KNN 没有训练阶段、",
      "start": 19.28,
      "end": 21.14
    },
    {
      "id": "shot08-9",
      "text": "整个数据集就是模型的特性——这些留给下一",
      "start": 21.14,
      "end": 24.4
    },
    {
      "id": "shot08-10",
      "text": "站 sklearn API 章。",
      "start": 24.4,
      "end": 25.9
    },
    {
      "id": "shot08-11",
      "text": "整章三期串起来一句话：",
      "start": 26.245,
      "end": 28.605
    },
    {
      "id": "shot08-12",
      "text": "KNN 看 K 个最近邻——核心一个找邻居，",
      "start": 28.605,
      "end": 32.245
    },
    {
      "id": "shot08-13",
      "text": "变种两个分类投票、",
      "start": 32.245,
      "end": 34.025
    },
    {
      "id": "shot08-14",
      "text": "回归平均。",
      "start": 34.025,
      "end": 35.345
    },
    {
      "id": "shot08-15",
      "text": "下一站我们用 sklearn 把五步流程",
      "start": 35.345,
      "end": 37.945
    },
    {
      "id": "shot08-16",
      "text": "一行代码跑起来。",
      "start": 37.945,
      "end": 39.845
    },
    {
      "id": "shot08-17",
      "text": "如果讲得有不对的地方，",
      "start": 39.845,
      "end": 41.685
    },
    {
      "id": "shot08-18",
      "text": "欢迎在评论区指正。下集见。",
      "start": 41.685,
      "end": 44.217
    }
  ]
}
