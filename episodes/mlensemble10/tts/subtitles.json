{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "随机森林那期，",
      "start": 0.0,
      "end": 1.141
    },
    {
      "id": "shot01-1",
      "text": "我们用泰坦尼克数据做过生存预测。",
      "start": 1.141,
      "end": 3.803
    },
    {
      "id": "shot01-2",
      "text": "随机森林的路线是 bagging：",
      "start": 3.803,
      "end": 5.625
    },
    {
      "id": "shot01-3",
      "text": "很多棵树独立训练，最后投票。",
      "start": 5.625,
      "end": 7.867
    },
    {
      "id": "shot01-4",
      "text": "现在换成 GBDT，",
      "start": 7.867,
      "end": 9.128
    },
    {
      "id": "shot01-5",
      "text": "它仍然可以处理泰坦尼克二分类，",
      "start": 9.128,
      "end": 11.55
    },
    {
      "id": "shot01-6",
      "text": "但训练方式完全变了。",
      "start": 11.55,
      "end": 13.672
    },
    {
      "id": "shot01-7",
      "text": "GBDT 是 boosting，",
      "start": 13.672,
      "end": 15.073
    },
    {
      "id": "shot01-8",
      "text": "每一棵新树都依赖上一轮模型的错误方向。",
      "start": 15.073,
      "end": 18.416
    },
    {
      "id": "shot01-9",
      "text": "分类任务里，",
      "start": 18.416,
      "end": 19.276
    },
    {
      "id": "shot01-10",
      "text": "这个错误方向不再是简单的真实值减预测值，",
      "start": 19.276,
      "end": 22.939
    },
    {
      "id": "shot01-11",
      "text": "而是对数损失下的负梯度。",
      "start": 22.939,
      "end": 24.621
    },
    {
      "id": "shot01-12",
      "text": "好消息是，",
      "start": 25.195,
      "end": 26.036
    },
    {
      "id": "shot01-13",
      "text": "用 sklearn 的",
      "start": 26.036,
      "end": 27.178
    },
    {
      "id": "shot01-14",
      "text": "GradientBoostingClassifier",
      "start": 27.178,
      "end": 28.801
    },
    {
      "id": "shot01-15",
      "text": "时，",
      "start": 28.801,
      "end": 29.221
    },
    {
      "id": "shot01-16",
      "text": "我们不需要手写这些梯度。",
      "start": 29.221,
      "end": 31.164
    },
    {
      "id": "shot01-17",
      "text": "只要准备好特征和标签，",
      "start": 31.164,
      "end": 32.987
    },
    {
      "id": "shot01-18",
      "text": "模型会把对数损失、负梯度、",
      "start": 32.987,
      "end": 35.44
    },
    {
      "id": "shot01-19",
      "text": "树的累加都封装起来。",
      "start": 35.44,
      "end": 37.614
    },
    {
      "id": "shot01-20",
      "text": "这期重点是把概念落到 pipeline：",
      "start": 37.614,
      "end": 40.098
    },
    {
      "id": "shot01-21",
      "text": "数据怎么处理，",
      "start": 40.098,
      "end": 41.24
    },
    {
      "id": "shot01-22",
      "text": "参数怎么理解，",
      "start": 41.24,
      "end": 42.502
    },
    {
      "id": "shot01-23",
      "text": "GridSearchCV 怎么调，",
      "start": 42.502,
      "end": 44.264
    },
    {
      "id": "shot01-24",
      "text": "以及它和 RF、",
      "start": 44.264,
      "end": 45.206
    },
    {
      "id": "shot01-25",
      "text": "AdaBoost 的工程差异。",
      "start": 45.206,
      "end": 47.349
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "泰坦尼克案例的特征保持简洁，",
      "start": 0.0,
      "end": 2.425
    },
    {
      "id": "shot02-1",
      "text": "只取 Pclass、Age、",
      "start": 2.425,
      "end": 4.149
    },
    {
      "id": "shot02-2",
      "text": "Sex 三列，",
      "start": 4.149,
      "end": 5.011
    },
    {
      "id": "shot02-3",
      "text": "目标是 Survived。",
      "start": 5.011,
      "end": 6.414
    },
    {
      "id": "shot02-4",
      "text": "Age 有缺失值，",
      "start": 6.414,
      "end": 8.082
    },
    {
      "id": "shot02-5",
      "text": "示例里用均值填充。",
      "start": 8.082,
      "end": 10.201
    },
    {
      "id": "shot02-6",
      "text": "Sex 是类别特征，",
      "start": 10.201,
      "end": 11.524
    },
    {
      "id": "shot02-7",
      "text": "Pclass 虽然是数字，",
      "start": 11.524,
      "end": 13.067
    },
    {
      "id": "shot02-8",
      "text": "但本质上也可以当成离散等级，",
      "start": 13.067,
      "end": 15.513
    },
    {
      "id": "shot02-9",
      "text": "所以用 get_dummies 做",
      "start": 15.513,
      "end": 17.136
    },
    {
      "id": "shot02-10",
      "text": "one hot 编码。处理完后，",
      "start": 17.136,
      "end": 19.601
    },
    {
      "id": "shot02-11",
      "text": "用 train_test_split 划",
      "start": 19.601,
      "end": 21.445
    },
    {
      "id": "shot02-12",
      "text": "分训练集和测试集，",
      "start": 21.445,
      "end": 23.068
    },
    {
      "id": "shot02-13",
      "text": "并固定 random_state。",
      "start": 23.068,
      "end": 24.732
    },
    {
      "id": "shot02-14",
      "text": "这个流程和随机森林案例很像，",
      "start": 24.975,
      "end": 27.24
    },
    {
      "id": "shot02-15",
      "text": "因为模型不同不代表数据处理可以随便变。",
      "start": 27.24,
      "end": 30.587
    },
    {
      "id": "shot02-16",
      "text": "要比较模型，",
      "start": 30.587,
      "end": 31.569
    },
    {
      "id": "shot02-17",
      "text": "最好让它们使用同一份特征、",
      "start": 31.569,
      "end": 33.674
    },
    {
      "id": "shot02-18",
      "text": "同一套切分和同一评价指标。",
      "start": 33.674,
      "end": 35.918
    },
    {
      "id": "shot02-19",
      "text": "这样最后看到的差异，",
      "start": 35.918,
      "end": 37.562
    },
    {
      "id": "shot02-20",
      "text": "才主要来自模型机制，",
      "start": 37.562,
      "end": 39.426
    },
    {
      "id": "shot02-21",
      "text": "而不是来自预处理不一致。",
      "start": 39.426,
      "end": 41.13
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "GradientBoostingClassifier",
      "start": 0.0,
      "end": 1.762
    },
    {
      "id": "shot03-1",
      "text": "的核心参数和前面概念一一对应。",
      "start": 1.802,
      "end": 4.925
    },
    {
      "id": "shot03-2",
      "text": "n_estimators 是树的数量，",
      "start": 4.925,
      "end": 7.107
    },
    {
      "id": "shot03-3",
      "text": "默认常见起点是 100。",
      "start": 7.107,
      "end": 9.069
    },
    {
      "id": "shot03-4",
      "text": "learning_rate 是每棵树修正",
      "start": 9.069,
      "end": 11.151
    },
    {
      "id": "shot03-5",
      "text": "量的缩放，",
      "start": 11.151,
      "end": 12.132
    },
    {
      "id": "shot03-6",
      "text": "通常和 n_estimators 联动：",
      "start": 12.132,
      "end": 14.434
    },
    {
      "id": "shot03-7",
      "text": "学习率小，",
      "start": 14.434,
      "end": 15.645
    },
    {
      "id": "shot03-8",
      "text": "树要更多；",
      "start": 15.645,
      "end": 16.996
    },
    {
      "id": "shot03-9",
      "text": "学习率大，",
      "start": 16.996,
      "end": 18.198
    },
    {
      "id": "shot03-10",
      "text": "树可以少一些，",
      "start": 18.198,
      "end": 19.359
    },
    {
      "id": "shot03-11",
      "text": "但过拟合风险更高。",
      "start": 19.359,
      "end": 21.341
    },
    {
      "id": "shot03-12",
      "text": "max_depth 控制每棵树的深度。",
      "start": 21.341,
      "end": 23.743
    },
    {
      "id": "shot03-13",
      "text": "GBDT 里的单棵树通常不用太深，",
      "start": 23.957,
      "end": 26.643
    },
    {
      "id": "shot03-14",
      "text": "深度 2 到 4 就能作为常见搜索范围。",
      "start": 26.643,
      "end": 29.47
    },
    {
      "id": "shot03-15",
      "text": "subsample 是每轮抽取多少比例样",
      "start": 29.47,
      "end": 32.136
    },
    {
      "id": "shot03-16",
      "text": "本，",
      "start": 32.136,
      "end": 32.396
    },
    {
      "id": "shot03-17",
      "text": "小于 1 时会引入随机性，",
      "start": 32.396,
      "end": 34.441
    },
    {
      "id": "shot03-18",
      "text": "变成随机梯度提升，",
      "start": 34.441,
      "end": 36.025
    },
    {
      "id": "shot03-19",
      "text": "有时能提升泛化。",
      "start": 36.025,
      "end": 37.428
    },
    {
      "id": "shot03-20",
      "text": "分类默认使用 log_loss，",
      "start": 37.428,
      "end": 39.272
    },
    {
      "id": "shot03-21",
      "text": "也就是对数损失。",
      "start": 39.272,
      "end": 41.016
    },
    {
      "id": "shot03-22",
      "text": "使用者传 0 和 1 标签即可，",
      "start": 41.016,
      "end": 43.201
    },
    {
      "id": "shot03-23",
      "text": "不需要手动把概率差、",
      "start": 43.201,
      "end": 44.865
    },
    {
      "id": "shot03-24",
      "text": "负梯度和 sigmoid 写出来。",
      "start": 44.865,
      "end": 46.449
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "基础训练很直接：",
      "start": 0.0,
      "end": 1.281
    },
    {
      "id": "shot04-1",
      "text": "实例化",
      "start": 1.281,
      "end": 1.842
    },
    {
      "id": "shot04-2",
      "text": "GradientBoostingClassifier，",
      "start": 1.842,
      "end": 3.503
    },
    {
      "id": "shot04-3",
      "text": "fit 训练集，",
      "start": 3.503,
      "end": 4.444
    },
    {
      "id": "shot04-4",
      "text": "再用 score 或",
      "start": 4.444,
      "end": 5.405
    },
    {
      "id": "shot04-5",
      "text": "classification_report",
      "start": 5.405,
      "end": 6.647
    },
    {
      "id": "shot04-6",
      "text": "评估测试集。",
      "start": 6.647,
      "end": 7.668
    },
    {
      "id": "shot04-7",
      "text": "这里不要把某个准确率当成固定结论，",
      "start": 7.668,
      "end": 10.61
    },
    {
      "id": "shot04-8",
      "text": "除非数据文件、",
      "start": 10.61,
      "end": 11.672
    },
    {
      "id": "shot04-9",
      "text": "随机种子和库版本都一致。",
      "start": 11.672,
      "end": 13.774
    },
    {
      "id": "shot04-10",
      "text": "讲解重点放在流程和判断方式。调参时，",
      "start": 13.774,
      "end": 17.457
    },
    {
      "id": "shot04-11",
      "text": "用 GridSearchCV 搜索",
      "start": 17.457,
      "end": 19.179
    },
    {
      "id": "shot04-12",
      "text": "n_estimators 和",
      "start": 19.179,
      "end": 20.28
    },
    {
      "id": "shot04-13",
      "text": "max_depth 是一个入门组合。",
      "start": 20.28,
      "end": 22.302
    },
    {
      "id": "shot04-14",
      "text": "更完整的做法是把",
      "start": 22.556,
      "end": 23.898
    },
    {
      "id": "shot04-15",
      "text": "learning_rate 也纳入联调，",
      "start": 23.898,
      "end": 25.74
    },
    {
      "id": "shot04-16",
      "text": "比如学习率 0.05、0.1、0.2，",
      "start": 25.74,
      "end": 28.793
    },
    {
      "id": "shot04-17",
      "text": "树数量 80、120、200，树深 2、",
      "start": 28.793,
      "end": 31.706
    },
    {
      "id": "shot04-18",
      "text": "3、4。",
      "start": 31.706,
      "end": 32.407
    },
    {
      "id": "shot04-19",
      "text": "交叉验证 cv 可以先设 3，",
      "start": 32.407,
      "end": 35.05
    },
    {
      "id": "shot04-20",
      "text": "数据更稳定时再加大。",
      "start": 35.05,
      "end": 37.253
    },
    {
      "id": "shot04-21",
      "text": "每次调参都固定 random_state，",
      "start": 37.253,
      "end": 39.615
    },
    {
      "id": "shot04-22",
      "text": "否则模型之间的小差异会混入随机波动，",
      "start": 39.615,
      "end": 42.939
    },
    {
      "id": "shot04-23",
      "text": "影响判断。",
      "start": 42.939,
      "end": 43.6
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "到这里，",
      "start": 0.0,
      "end": 0.48
    },
    {
      "id": "shot05-1",
      "text": "本章已经有三个能跑泰坦尼克分类的集成模型。",
      "start": 0.48,
      "end": 4.363
    },
    {
      "id": "shot05-2",
      "text": "随机森林是并行训练，各树独立，",
      "start": 4.363,
      "end": 7.025
    },
    {
      "id": "shot05-3",
      "text": "训练速度快，",
      "start": 7.025,
      "end": 8.165
    },
    {
      "id": "shot05-4",
      "text": "调参压力小，",
      "start": 8.165,
      "end": 9.006
    },
    {
      "id": "shot05-5",
      "text": "适合作为强基线。",
      "start": 9.006,
      "end": 10.427
    },
    {
      "id": "shot05-6",
      "text": "AdaBoost 是串行训练，",
      "start": 10.427,
      "end": 12.368
    },
    {
      "id": "shot05-7",
      "text": "主要通过样本权重强调错样本，",
      "start": 12.368,
      "end": 15.11
    },
    {
      "id": "shot05-8",
      "text": "基学习器常用决策桩，",
      "start": 15.11,
      "end": 17.051
    },
    {
      "id": "shot05-9",
      "text": "对离群点和噪声会比较敏感，",
      "start": 17.051,
      "end": 19.552
    },
    {
      "id": "shot05-10",
      "text": "因为错样本会被反复放大。",
      "start": 19.552,
      "end": 22.074
    },
    {
      "id": "shot05-11",
      "text": "GBDT 也是串行训练，",
      "start": 22.074,
      "end": 24.0
    },
    {
      "id": "shot05-12",
      "text": "但传递的是负梯度，",
      "start": 24.0,
      "end": 25.726
    },
    {
      "id": "shot05-13",
      "text": "通常准确率上限更高，",
      "start": 25.726,
      "end": 27.772
    },
    {
      "id": "shot05-14",
      "text": "参数也更多，",
      "start": 27.772,
      "end": 29.076
    },
    {
      "id": "shot05-15",
      "text": "训练速度比随机森林慢。",
      "start": 29.076,
      "end": 31.142
    },
    {
      "id": "shot05-16",
      "text": "实践里不要默认某个模型一定赢。",
      "start": 31.142,
      "end": 33.71
    },
    {
      "id": "shot05-17",
      "text": "先用随机森林拿稳健基线，",
      "start": 33.96,
      "end": 36.167
    },
    {
      "id": "shot05-18",
      "text": "再试 GBDT 看是否有明显收益。",
      "start": 36.167,
      "end": 38.774
    },
    {
      "id": "shot05-19",
      "text": "如果 GBDT 精度更好但训练太慢，",
      "start": 38.774,
      "end": 41.382
    },
    {
      "id": "shot05-20",
      "text": "或者需要更强正则和更快构树，",
      "start": 41.382,
      "end": 43.87
    },
    {
      "id": "shot05-21",
      "text": "就自然进入下一章的 XGBoost。",
      "start": 43.87,
      "end": 46.357
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期把 GBDT 从回归手算带到了分类",
      "start": 0.0,
      "end": 3.184
    },
    {
      "id": "shot06-1",
      "text": "实战。",
      "start": 3.184,
      "end": 3.825
    },
    {
      "id": "shot06-2",
      "text": "核心变化只有一个：",
      "start": 3.825,
      "end": 5.407
    },
    {
      "id": "shot06-3",
      "text": "损失函数从平方损失换成对数损失，",
      "start": 5.407,
      "end": 9.211
    },
    {
      "id": "shot06-4",
      "text": "负梯度的具体数值变了，",
      "start": 9.211,
      "end": 11.113
    },
    {
      "id": "shot06-5",
      "text": "但串行修正框架不变。工程上，",
      "start": 11.113,
      "end": 14.237
    },
    {
      "id": "shot06-6",
      "text": "我们用 Pclass、Age、",
      "start": 14.237,
      "end": 16.22
    },
    {
      "id": "shot06-7",
      "text": "Sex 做特征，",
      "start": 16.22,
      "end": 17.221
    },
    {
      "id": "shot06-8",
      "text": "Age 均值填充，",
      "start": 17.221,
      "end": 18.723
    },
    {
      "id": "shot06-9",
      "text": "类别变量 one hot 编码，",
      "start": 18.723,
      "end": 20.565
    },
    {
      "id": "shot06-10",
      "text": "然后用",
      "start": 20.565,
      "end": 21.126
    },
    {
      "id": "shot06-11",
      "text": "GradientBoostingClassifier",
      "start": 21.126,
      "end": 22.828
    },
    {
      "id": "shot06-12",
      "text": "训练和调参。",
      "start": 22.828,
      "end": 23.909
    },
    {
      "id": "shot06-13",
      "text": "模型参数里，",
      "start": 24.137,
      "end": 25.158
    },
    {
      "id": "shot06-14",
      "text": "n_estimators 决定树的数量，",
      "start": 25.158,
      "end": 27.321
    },
    {
      "id": "shot06-15",
      "text": "learning_rate 控制步长，",
      "start": 27.321,
      "end": 28.963
    },
    {
      "id": "shot06-16",
      "text": "max_depth 控制单棵树复杂度，",
      "start": 28.963,
      "end": 31.546
    },
    {
      "id": "shot06-17",
      "text": "subsample 增加随机性。",
      "start": 31.546,
      "end": 33.388
    },
    {
      "id": "shot06-18",
      "text": "GBDT 已经是很强的结构化数据模型，",
      "start": 33.388,
      "end": 36.592
    },
    {
      "id": "shot06-19",
      "text": "但它仍有两个不足：",
      "start": 36.592,
      "end": 38.174
    },
    {
      "id": "shot06-20",
      "text": "正则化没有 XGBoost 那么系统，",
      "start": 38.174,
      "end": 40.938
    },
    {
      "id": "shot06-21",
      "text": "训练速度也不够工业化。",
      "start": 40.938,
      "end": 43.14
    },
    {
      "id": "shot06-22",
      "text": "下一期我们看 XGBoost 怎样把",
      "start": 43.14,
      "end": 45.824
    },
    {
      "id": "shot06-23",
      "text": "GBDT 升级成带二阶导、",
      "start": 45.824,
      "end": 48.026
    },
    {
      "id": "shot06-24",
      "text": "正则项和工程优化的版本。",
