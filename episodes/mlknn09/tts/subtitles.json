{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们讲了归一化，",
      "start": 0.0,
      "end": 1.88
    },
    {
      "id": "shot01-1",
      "text": "公式简单效果直接，",
      "start": 1.88,
      "end": 3.76
    },
    {
      "id": "shot01-2",
      "text": "但有个局限——单个异常值就能撑开整个尺度。",
      "start": 3.76,
      "end": 7.76
    },
    {
      "id": "shot01-3",
      "text": "这一期讲第二种主流缩放方法：标准化，",
      "start": 7.76,
      "end": 11.26
    },
    {
      "id": "shot01-4",
      "text": "英文 Z-score",
      "start": 11.26,
      "end": 12.3
    },
    {
      "id": "shot01-5",
      "text": "standardization。",
      "start": 12.3,
      "end": 13.74
    },
    {
      "id": "shot01-6",
      "text": "它对异常值明显更稳，",
      "start": 13.74,
      "end": 15.92
    },
    {
      "id": "shot01-7",
      "text": "是 KNN 实战常用的选择。",
      "start": 15.92,
      "end": 18.32
    },
    {
      "id": "shot01-8",
      "text": "但要把它讲清楚，",
      "start": 18.32,
      "end": 19.52
    },
    {
      "id": "shot01-9",
      "text": "得先补一个数学背景：",
      "start": 19.52,
      "end": 21.48
    },
    {
      "id": "shot01-10",
      "text": "高斯分布——也叫正态分布，",
      "start": 21.48,
      "end": 23.66
    },
    {
      "id": "shot01-11",
      "text": "自然界里最常见的那条钟形曲线。",
      "start": 23.66,
      "end": 26.52
    },
    {
      "id": "shot01-12",
      "text": "这一期我们走完三件事：",
      "start": 26.882,
      "end": 28.662
    },
    {
      "id": "shot01-13",
      "text": "高斯分布是什么、",
      "start": 28.662,
      "end": 29.902
    },
    {
      "id": "shot01-14",
      "text": "Z-score 公式怎么变换数据、",
      "start": 29.902,
      "end": 31.802
    },
    {
      "id": "shot01-15",
      "text": "demo 现场对比异常值场景下标准化为什么稳。",
      "start": 31.802,
      "end": 35.428
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先把上一期那个局限拎清楚。",
      "start": 0.0,
      "end": 2.26
    },
    {
      "id": "shot02-1",
      "text": "归一化用每一列的最小值和最大值算尺子，",
      "start": 2.26,
      "end": 6.38
    },
    {
      "id": "shot02-2",
      "text": "min 和 max 是由单点决定的——任",
      "start": 6.38,
      "end": 9.26
    },
    {
      "id": "shot02-3",
      "text": "何一个离谱样本，",
      "start": 9.26,
      "end": 10.48
    },
    {
      "id": "shot02-4",
      "text": "都能直接定义边界。",
      "start": 10.48,
      "end": 12.66
    },
    {
      "id": "shot02-5",
      "text": "一个 250 公斤的异常体重，",
      "start": 12.66,
      "end": 15.06
    },
    {
      "id": "shot02-6",
      "text": "把整列正常样本压到角落 0 到 0.24之间，",
      "start": 15.06,
      "end": 19.32
    },
    {
      "id": "shot02-7",
      "text": "KNN 区分度被严重削弱。",
      "start": 19.32,
      "end": 21.68
    },
    {
      "id": "shot02-8",
      "text": "标准化的解法很直接：",
      "start": 21.68,
      "end": 23.76
    },
    {
      "id": "shot02-9",
      "text": "不再用单点的 min 和 max 当尺子，",
      "start": 23.76,
      "end": 26.68
    },
    {
      "id": "shot02-10",
      "text": "改用整列数据的统计分布——均值和标准差。",
      "start": 26.68,
      "end": 30.46
    },
    {
      "id": "shot02-11",
      "text": "少数几个异常值，",
      "start": 30.821,
      "end": 32.441
    },
    {
      "id": "shot02-12",
      "text": "对整列的均值影响有限，",
      "start": 32.441,
      "end": 34.701
    },
    {
      "id": "shot02-13",
      "text": "对标准差影响也有限——尺子稳，",
      "start": 34.701,
      "end": 38.361
    },
    {
      "id": "shot02-14",
      "text": "缩放结果就稳。",
      "start": 38.361,
      "end": 39.541
    },
    {
      "id": "shot02-15",
      "text": "但要讲清楚均值和标准差为什么稳，",
      "start": 39.541,
      "end": 42.581
    },
    {
      "id": "shot02-16",
      "text": "必须先看它们描述的是什么形状的分布。",
      "start": 42.581,
      "end": 45.881
    },
    {
      "id": "shot02-17",
      "text": "这就是高斯分布。",
      "start": 45.881,
      "end": 47.501
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "什么是高斯分布？",
      "start": 0.0,
      "end": 1.94
    },
    {
      "id": "shot03-1",
      "text": "最直接的方式是看图。",
      "start": 1.94,
      "end": 4.32
    },
    {
      "id": "shot03-2",
      "text": "把一群人的身高拿来画直方图，",
      "start": 4.32,
      "end": 7.32
    },
    {
      "id": "shot03-3",
      "text": "横轴是身高、",
      "start": 7.32,
      "end": 8.92
    },
    {
      "id": "shot03-4",
      "text": "纵轴是这个身高的人数。",
      "start": 8.92,
      "end": 11.62
    },
    {
      "id": "shot03-5",
      "text": "你会看到一条中间高两边低的曲线——平均身",
      "start": 11.62,
      "end": 15.66
    },
    {
      "id": "shot03-6",
      "text": "高那一带人最多，",
      "start": 15.66,
      "end": 17.26
    },
    {
      "id": "shot03-7",
      "text": "特别高和特别矮的人越来越少，",
      "start": 17.26,
      "end": 20.0
    },
    {
      "id": "shot03-8",
      "text": "左右大致对称。",
      "start": 20.0,
      "end": 21.66
    },
    {
      "id": "shot03-9",
      "text": "这条曲线就叫钟形——形状像座钟。",
      "start": 21.66,
      "end": 25.66
    },
    {
      "id": "shot03-10",
      "text": "把考试成绩拿来画也是这个样子，",
      "start": 25.66,
      "end": 28.72
    },
    {
      "id": "shot03-11",
      "text": "平均分附近最密集，",
      "start": 28.72,
      "end": 30.5
    },
    {
      "id": "shot03-12",
      "text": "特别高分和特别低分越来越少。",
      "start": 30.5,
      "end": 33.54
    },
    {
      "id": "shot03-13",
      "text": "把工厂里同款零件的尺寸误差拿来画也是这样，",
      "start": 33.54,
      "end": 38.04
    },
    {
      "id": "shot03-14",
      "text": "绝大多数贴近设计值，",
      "start": 38.04,
      "end": 40.26
    },
    {
      "id": "shot03-15",
      "text": "偏差越大越罕见。",
      "start": 40.26,
      "end": 41.9
    },
    {
      "id": "shot03-16",
      "text": "这种中间高两边低的钟形分布，",
      "start": 42.562,
      "end": 45.602
    },
    {
      "id": "shot03-17",
      "text": "数学上有个名字叫正态分布，",
      "start": 45.602,
      "end": 48.122
    },
    {
      "id": "shot03-18",
      "text": "也叫高斯分布——以提出它的数学家高斯命名。",
      "start": 48.122,
      "end": 52.562
    },
    {
      "id": "shot03-19",
      "text": "背后有一个深刻的原因：",
      "start": 52.562,
      "end": 54.442
    },
    {
      "id": "shot03-20",
      "text": "当一个数值是大量独立随机因素叠加的结果—",
      "start": 54.442,
      "end": 58.342
    },
    {
      "id": "shot03-21",
      "text": "—身高受成百上千个基因和环境因素影响、",
      "start": 58.342,
      "end": 62.242
    },
    {
      "id": "shot03-22",
      "text": "考试成绩受很多临场因素影响——这种叠加趋",
      "start": 62.242,
      "end": 66.262
    },
    {
      "id": "shot03-23",
      "text": "向高斯分布。",
      "start": 66.262,
      "end": 67.502
    },
    {
      "id": "shot03-24",
      "text": "所以现实数据里，",
      "start": 67.502,
      "end": 69.149
    },
    {
      "id": "shot03-25",
      "text": "钟形几乎无处不在。",
      "start": 69.149,
      "end": 70.662
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "高斯分布完全由两个参数决定。",
      "start": 0.0,
      "end": 2.68
    },
    {
      "id": "shot04-1",
      "text": "第一个叫均值 μ，",
      "start": 2.68,
      "end": 4.16
    },
    {
      "id": "shot04-2",
      "text": "它控制钟形的中心位置在哪。",
      "start": 4.16,
      "end": 7.06
    },
    {
      "id": "shot04-3",
      "text": "固定其他不变，",
      "start": 7.06,
      "end": 8.5
    },
    {
      "id": "shot04-4",
      "text": "μ 变大整条钟形右移，",
      "start": 8.5,
      "end": 10.82
    },
    {
      "id": "shot04-5",
      "text": "μ 变小左移，",
      "start": 10.82,
      "end": 12.36
    },
    {
      "id": "shot04-6",
      "text": "曲线形状一点不变，",
      "start": 12.36,
      "end": 14.22
    },
    {
      "id": "shot04-7",
      "text": "只是位置在挪。",
      "start": 14.22,
      "end": 15.44
    },
    {
      "id": "shot04-8",
      "text": "第二个叫标准差 σ，",
      "start": 15.44,
      "end": 17.88
    },
    {
      "id": "shot04-9",
      "text": "它控制钟形的胖瘦。",
      "start": 17.88,
      "end": 19.853
    },
    {
      "id": "shot04-10",
      "text": "σ 越小钟形越高瘦数据越集中，",
      "start": 19.853,
      "end": 23.253
    },
    {
      "id": "shot04-11",
      "text": "σ 越大钟形越矮胖数据越散。",
      "start": 23.253,
      "end": 26.52
    },
    {
      "id": "shot04-12",
      "text": "一个完整的高斯分布写成 N 括号 μ 和",
      "start": 26.52,
      "end": 29.94
    },
    {
      "id": "shot04-13",
      "text": "σ 平方——严格说第二个参数是方差 σ平方，",
      "start": 29.94,
      "end": 34.42
    },
    {
      "id": "shot04-14",
      "text": "但平时讲就直接说标准差 σ。",
      "start": 34.42,
      "end": 37.2
    },
    {
      "id": "shot04-15",
      "text": "当 μ 等于 0、",
      "start": 37.747,
      "end": 39.047
    },
    {
      "id": "shot04-16",
      "text": "σ 等于 1 的时候，",
      "start": 39.047,
      "end": 40.387
    },
    {
      "id": "shot04-17",
      "text": "叫标准正态分布，",
      "start": 40.387,
      "end": 42.407
    },
    {
      "id": "shot04-18",
      "text": "写成 N 括号 0 和 1——所有高斯分",
      "start": 42.407,
      "end": 45.327
    },
    {
      "id": "shot04-19",
      "text": "布的基准形态。",
      "start": 45.327,
      "end": 46.607
    },
    {
      "id": "shot04-20",
      "text": "还有一个非常实用的定律叫 3σ 法则，",
      "start": 46.607,
      "end": 50.267
    },
    {
      "id": "shot04-21",
      "text": "也叫 68 95 99.7 法则。",
      "start": 50.267,
      "end": 53.587
    },
    {
      "id": "shot04-22",
      "text": "它告诉我们：",
      "start": 53.587,
      "end": 54.604
    },
    {
      "id": "shot04-23",
      "text": "钟形里有 68% 的数据落在均值左右一个",
      "start": 54.604,
      "end": 58.347
    },
    {
      "id": "shot04-24",
      "text": "σ 范围内、",
      "start": 58.347,
      "end": 59.527
    },
    {
      "id": "shot04-25",
      "text": "95% 落在两个 σ 范围内、",
      "start": 59.527,
      "end": 62.567
    },
    {
      "id": "shot04-26",
      "text": "99.7% 落在三个 σ 范围内。",
      "start": 62.567,
      "end": 64.947
    },
    {
      "id": "shot04-27",
      "text": "一个例子：",
      "start": 65.166,
      "end": 66.266
    },
    {
      "id": "shot04-28",
      "text": "工厂生产某零件长度服从 N 括号 10",
      "start": 66.266,
      "end": 69.246
    },
    {
      "id": "shot04-29",
      "text": "毫米 0.1 毫米——99.7% 的零件",
      "start": 69.246,
      "end": 72.466
    },
    {
      "id": "shot04-30",
      "text": "长度在 9.7 到 10.3 毫米之间—",
      "start": 72.466,
      "end": 75.186
    },
    {
      "id": "shot04-31",
      "text": "—测出 10.5 毫米的，",
      "start": 75.186,
      "end": 77.586
    },
    {
      "id": "shot04-32",
      "text": "距均值 5 个 σ，",
      "start": 77.586,
      "end": 79.046
    },
    {
      "id": "shot04-33",
      "text": "远在 3σ 之外，",
      "start": 79.046,
      "end": 81.306
    },
    {
      "id": "shot04-34",
      "text": "直接报警。",
      "start": 81.306,
      "end": 82.946
    },
    {
      "id": "shot04-35",
      "text": "这套法则在质量检测、异常识别、",
      "start": 82.946,
      "end": 85.846
    },
    {
      "id": "shot04-36",
      "text": "A/B 测试里到处都在用。",
      "start": 85.846,
      "end": 87.486
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "现在回到标准化。",
      "start": 0.0,
      "end": 1.46
    },
    {
      "id": "shot05-1",
      "text": "Z-score 公式：",
      "start": 1.46,
      "end": 2.6
    },
    {
      "id": "shot05-2",
      "text": "x 撇等于 x 减 μ 除以 σ。语言版：",
      "start": 2.6,
      "end": 7.14
    },
    {
      "id": "shot05-3",
      "text": "每一个原始值减去该列均值，",
      "start": 7.14,
      "end": 9.86
    },
    {
      "id": "shot05-4",
      "text": "再除以该列标准差。",
      "start": 9.86,
      "end": 11.84
    },
    {
      "id": "shot05-5",
      "text": "这一组动作干了两件事。",
      "start": 11.84,
      "end": 13.867
    },
    {
      "id": "shot05-6",
      "text": "减 μ 是中心化——也就是把钟形的中心位",
      "start": 13.867,
      "end": 17.6
    },
    {
      "id": "shot05-7",
      "text": "置挪到 0。",
      "start": 17.6,
      "end": 18.96
    },
    {
      "id": "shot05-8",
      "text": "除 σ 是缩放——把幅度从 σ 压成 1。",
      "start": 18.96,
      "end": 23.06
    },
    {
      "id": "shot05-9",
      "text": "两步配合，",
      "start": 23.06,
      "end": 24.38
    },
    {
      "id": "shot05-10",
      "text": "任意位置任意胖瘦的 N μ σ，",
      "start": 24.38,
      "end": 26.84
    },
    {
      "id": "shot05-11",
      "text": "都被拉到标准正态 N 0 1。",
      "start": 26.84,
      "end": 29.74
    },
    {
      "id": "shot05-12",
      "text": "Z-score 输出的数字含义是：",
      "start": 29.74,
      "end": 31.7
    },
    {
      "id": "shot05-13",
      "text": "这个值距离均值多少个 σ。",
      "start": 31.7,
      "end": 33.88
    },
    {
      "id": "shot05-14",
      "text": "某人 z 等于 1.5——比平均高 1.",
      "start": 34.517,
      "end": 37.137
    },
    {
      "id": "shot05-15",
      "text": "5 个标准差，",
      "start": 37.137,
      "end": 38.197
    },
    {
      "id": "shot05-16",
      "text": "按 3σ 法则对应前 7%。",
      "start": 38.197,
      "end": 40.997
    },
    {
      "id": "shot05-17",
      "text": "z 等于负 2——低于平均 2 个标准差，",
      "start": 40.997,
      "end": 44.117
    },
    {
      "id": "shot05-18",
      "text": "处于最低 2.3%。",
      "start": 44.117,
      "end": 45.777
    },
    {
      "id": "shot05-19",
      "text": "用上一期 8 个健康样本的身高列试一下。",
      "start": 45.777,
      "end": 49.057
    },
    {
      "id": "shot05-20",
      "text": "8 个身高均值约 172 厘米，",
      "start": 49.057,
      "end": 51.597
    },
    {
      "id": "shot05-21",
      "text": "标准差约 5。",
      "start": 51.597,
      "end": 53.137
    },
    {
      "id": "shot05-22",
      "text": "175 厘米的人 z 等于 175 减",
      "start": 53.137,
      "end": 56.297
    },
    {
      "id": "shot05-23",
      "text": "172 除以 5 等于 0.6。",
      "start": 56.297,
      "end": 58.937
    },
    {
      "id": "shot05-24",
      "text": "165 厘米的人 z 等于 负 1.4。",
      "start": 58.937,
      "end": 61.957
    },
    {
      "id": "shot05-25",
      "text": "每一列各自做这个变换，",
      "start": 62.316,
      "end": 64.456
    },
    {
      "id": "shot05-26",
      "text": "所有特征都围绕 0 散开、",
      "start": 64.456,
      "end": 66.736
    },
    {
      "id": "shot05-27",
      "text": "标准差都是 1，",
      "start": 66.736,
      "end": 68.176
    },
    {
      "id": "shot05-28",
      "text": "KNN 距离贡献完全对等。",
      "start": 68.176,
      "end": 70.116
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "sklearn API 跟上一期归一化几",
      "start": 0.0,
      "end": 2.76
    },
    {
      "id": "shot06-1",
      "text": "乎是同一套，三步走。",
      "start": 2.76,
      "end": 4.54
    },
    {
      "id": "shot06-2",
      "text": "第一步实例化一个",
      "start": 4.54,
      "end": 5.78
    },
    {
      "id": "shot06-3",
      "text": "StandardScaler。",
      "start": 5.78,
      "end": 7.08
    },
    {
      "id": "shot06-4",
      "text": "第二步 fit_transform 训练",
      "start": 7.08,
      "end": 8.9
    },
    {
      "id": "shot06-5",
      "text": "数据——fit 是看一遍训练集记下每一列",
      "start": 8.9,
      "end": 11.96
    },
    {
      "id": "shot06-6",
      "text": "的 μ 和 σ，",
      "start": 11.96,
      "end": 13.1
    },
    {
      "id": "shot06-7",
      "text": "transform 是把 Z-score",
      "start": 13.1,
      "end": 14.56
    },
    {
      "id": "shot06-8",
      "text": "公式套上去。",
      "start": 14.56,
      "end": 15.92
    },
    {
      "id": "shot06-9",
      "text": "第三步把缩放后的数据喂给",
      "start": 15.92,
      "end": 17.96
    },
    {
      "id": "shot06-10",
      "text": "KNeighborsClassifier。",
      "start": 17.96,
      "end": 19.26
    },
    {
      "id": "shot06-11",
      "text": "预测新数据的纪律跟上一期完全一样：",
      "start": 19.643,
      "end": 22.843
    },
    {
      "id": "shot06-12",
      "text": "训练 fit 一次，",
      "start": 22.843,
      "end": 24.303
    },
    {
      "id": "shot06-13",
      "text": "预测只 transform——用同一个",
      "start": 24.303,
      "end": 26.543
    },
    {
      "id": "shot06-14",
      "text": "scaler 按训练时记下的 μ 和 σ",
      "start": 26.543,
      "end": 29.303
    },
    {
      "id": "shot06-15",
      "text": "缩——再 fit 一次尺子就乱了。",
      "start": 29.303,
      "end": 32.223
    },
    {
      "id": "shot06-16",
      "text": "跟上一期的 MinMaxScaler 在",
      "start": 32.223,
      "end": 34.663
    },
    {
      "id": "shot06-17",
      "text": "代码层面就差一个类名，",
      "start": 34.663,
      "end": 36.683
    },
    {
      "id": "shot06-18",
      "text": "但内部尺子的逻辑完全不同——一个看的是",
      "start": 36.683,
      "end": 39.903
    },
    {
      "id": "shot06-19",
      "text": "min 和 max 两个边界点，",
      "start": 39.903,
      "end": 42.043
    },
    {
      "id": "shot06-20",
      "text": "一个看的是整列的统计分布。",
      "start": 42.043,
      "end": 44.283
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "切回上一期那个 marimo demo，",
      "start": 0.0,
      "end": 2.24
    },
    {
      "id": "shot07-1",
      "text": "布局不变。",
      "start": 2.24,
      "end": 3.32
    },
    {
      "id": "shot07-2",
      "text": "沿用量纲不齐的场景：",
      "start": 3.32,
      "end": 4.92
    },
    {
      "id": "shot07-3",
      "text": "新人身高 175、",
      "start": 4.92,
      "end": 6.64
    },
    {
      "id": "shot07-4",
      "text": "体重 85、",
      "start": 6.64,
      "end": 7.8
    },
    {
      "id": "shot07-5",
      "text": "视力 1.7。",
      "start": 7.8,
      "end": 8.76
    },
    {
      "id": "shot07-6",
      "text": "先把缩放下拉切到",
      "start": 8.76,
      "end": 10.66
    },
    {
      "id": "shot07-7",
      "text": "StandardScaler，",
      "start": 10.66,
      "end": 11.82
    },
    {
      "id": "shot07-8",
      "text": "异常值开关关闭。",
      "start": 11.82,
      "end": 13.32
    },
    {
      "id": "shot07-9",
      "text": "看缩放参数表：",
      "start": 13.32,
      "end": 14.98
    },
    {
      "id": "shot07-10",
      "text": "身高 μ 约 172、",
      "start": 14.98,
      "end": 16.82
    },
    {
      "id": "shot07-11",
      "text": "σ 约 5；",
      "start": 16.82,
      "end": 18.12
    },
    {
      "id": "shot07-12",
      "text": "体重 μ 85、",
      "start": 18.12,
      "end": 19.56
    },
    {
      "id": "shot07-13",
      "text": "σ 15；",
      "start": 19.56,
      "end": 20.66
    },
    {
      "id": "shot07-14",
      "text": "视力 μ 约 0.97、",
      "start": 20.66,
      "end": 22.48
    },
    {
      "id": "shot07-15",
      "text": "σ 约 0.55。预测：健康。",
      "start": 22.48,
      "end": 25.42
    },
    {
      "id": "shot07-16",
      "text": "前 3 个邻居全是健康——正常数据下两种",
      "start": 25.42,
      "end": 28.54
    },
    {
      "id": "shot07-17",
      "text": "缩放都好用。",
      "start": 28.54,
      "end": 29.63
    },
    {
      "id": "shot07-18",
      "text": "现在打开异常值开关，",
      "start": 29.869,
      "end": 31.769
    },
    {
      "id": "shot07-19",
      "text": "往训练集塞 250 公斤的离谱体重。",
      "start": 31.769,
      "end": 34.649
    },
    {
      "id": "shot07-20",
      "text": "看缩放参数表：",
      "start": 34.649,
      "end": 36.049
    },
    {
      "id": "shot07-21",
      "text": "体重 μ 跳到 103.56、",
      "start": 36.049,
      "end": 38.669
    },
    {
      "id": "shot07-22",
      "text": "σ 跳到 53.72。",
      "start": 38.669,
      "end": 41.029
    },
    {
      "id": "shot07-23",
      "text": "注意 σ 也跟着变大了——这是关键：",
      "start": 41.029,
      "end": 44.009
    },
    {
      "id": "shot07-24",
      "text": "异常值同时拉高了 μ 和 σ，",
      "start": 44.009,
      "end": 46.609
    },
    {
      "id": "shot07-25",
      "text": "尺子也跟着变厚，",
      "start": 46.609,
      "end": 48.049
    },
    {
      "id": "shot07-26",
      "text": "没把正常样本压到角落里。",
      "start": 48.049,
      "end": 50.129
    },
    {
      "id": "shot07-27",
      "text": "看右边缩放后散点图：",
      "start": 50.501,
      "end": 52.601
    },
    {
      "id": "shot07-28",
      "text": "8 个正常样本仍均匀散在零附近，",
      "start": 52.601,
      "end": 55.761
    },
    {
      "id": "shot07-29",
      "text": "异常值落在 z 等于 2.73——超过2σ，",
      "start": 55.761,
      "end": 60.161
    },
    {
      "id": "shot07-30",
      "text": "已经在 95% 之外的尾部 5%，",
      "start": 60.161,
      "end": 63.381
    },
    {
      "id": "shot07-31",
      "text": "按 3σ 法则属于罕见值，",
      "start": 63.381,
      "end": 66.121
    },
    {
      "id": "shot07-32",
      "text": "但它没绑架其他点。",
      "start": 66.121,
      "end": 68.201
    },
    {
      "id": "shot07-33",
      "text": "距离明细里前 3 个邻居仍是健康那一组，",
      "start": 68.201,
      "end": 71.761
    },
    {
      "id": "shot07-34",
      "text": "预测仍是健康。",
      "start": 71.761,
      "end": 73.321
    },
    {
      "id": "shot07-35",
      "text": "一句话总结：",
      "start": 73.321,
      "end": 74.421
    },
    {
      "id": "shot07-36",
      "text": "标准化是全员投票的尺子，",
      "start": 74.421,
      "end": 77.081
    },
    {
      "id": "shot07-37",
      "text": "异常值有发言权但不能独裁。",
      "start": 77.081,
      "end": 79.802
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "为了把对比看得更清楚，",
      "start": 0.0,
      "end": 2.06
    },
    {
      "id": "shot08-1",
      "text": "我们保持异常值开关打开，",
      "start": 2.06,
      "end": 4.78
    },
    {
      "id": "shot08-2",
      "text": "把缩放下拉切回 MinMaxScaler。",
      "start": 4.78,
      "end": 8.0
    },
    {
      "id": "shot08-3",
      "text": "看右边那张散点图。",
      "start": 8.0,
      "end": 10.4
    },
    {
      "id": "shot08-4",
      "text": "两张图并排——刚才标准化的散点图正常样本均匀散开，",
      "start": 10.4,
      "end": 15.02
    },
    {
      "id": "shot08-5",
      "text": "现在 Min-Max 的散点图 8 个正",
      "start": 15.02,
      "end": 17.36
    },
    {
      "id": "shot08-6",
      "text": "常样本被挤到左下角一个小区域，",
      "start": 17.36,
      "end": 20.44
    },
    {
      "id": "shot08-7",
      "text": "原本占满 0 到 1 的体重维度，",
      "start": 20.44,
      "end": 23.28
    },
    {
      "id": "shot08-8",
      "text": "现在 8 个正常样本只占 0 到 0.24，",
      "start": 23.28,
      "end": 26.76
    },
    {
      "id": "shot08-9",
      "text": "剩下 75% 的横向区间被一个异常值独占。",
      "start": 26.76,
      "end": 30.52
    },
    {
      "id": "shot08-10",
      "text": "这就是上一期讲的归一化软肋——min 和",
      "start": 30.943,
      "end": 33.783
    },
    {
      "id": "shot08-11",
      "text": "max 由单点决定，",
      "start": 33.783,
      "end": 35.523
    },
    {
      "id": "shot08-12",
      "text": "单点拉飞整个尺子。同样数据，",
      "start": 35.523,
      "end": 38.223
    },
    {
      "id": "shot08-13",
      "text": "标准化保持稳定，",
      "start": 38.223,
      "end": 39.928
    },
    {
      "id": "shot08-14",
      "text": "归一化区分度明显下降——这就是为什么",
      "start": 39.928,
      "end": 42.683
    },
    {
      "id": "shot08-15",
      "text": "KNN 实战常用标准化做默认。",
      "start": 42.683,
      "end": 45.383
    }
  ],
  "shot09": [
    {
      "id": "shot09-0",
      "text": "把两种方法的对比正式写下来。",
      "start": 0.0,
      "end": 2.62
    },
    {
      "id": "shot09-1",
      "text": "归一化用 min 和 max 当尺子，",
      "start": 2.62,
      "end": 5.58
    },
    {
      "id": "shot09-2",
      "text": "输出严格在 0 到 1 之间，",
      "start": 5.58,
      "end": 7.96
    },
    {
      "id": "shot09-3",
      "text": "对异常值敏感。",
      "start": 7.96,
      "end": 9.56
    },
    {
      "id": "shot09-4",
      "text": "标准化用 μ 和 σ 当尺子，",
      "start": 9.56,
      "end": 12.46
    },
    {
      "id": "shot09-5",
      "text": "输出不固定区间但常见在负 3 到正 3之间，",
      "start": 12.46,
      "end": 16.96
    },
    {
      "id": "shot09-6",
      "text": "对异常值相对稳定。怎么选？",
      "start": 16.96,
      "end": 20.06
    },
    {
      "id": "shot09-7",
      "text": "两条简单原则。第一条，",
      "start": 20.06,
      "end": 22.54
    },
    {
      "id": "shot09-8",
      "text": "如果数据本身需要严格的 0 到 1 输出",
      "start": 22.54,
      "end": 25.76
    },
    {
      "id": "shot09-9",
      "text": "区间——比如图像像素直接接神经网络输入、",
      "start": 25.76,
      "end": 29.84
    },
    {
      "id": "shot09-10",
      "text": "或者上下界已知的评分——选归一化。",
      "start": 29.84,
      "end": 33.2
    },
    {
      "id": "shot09-11",
      "text": "第二条，",
      "start": 33.607,
      "end": 34.367
    },
    {
      "id": "shot09-12",
      "text": "其他几乎所有 KNN 实战场景——尤其是",
      "start": 34.367,
      "end": 37.667
    },
    {
      "id": "shot09-13",
      "text": "数据可能有噪声或异常值——选标准化。",
      "start": 37.667,
      "end": 41.147
    },
    {
      "id": "shot09-14",
      "text": "教材原话很直白：",
      "start": 41.147,
      "end": 42.887
    },
    {
      "id": "shot09-15",
      "text": "以后就是用你了。",
      "start": 42.887,
      "end": 44.587
    },
    {
      "id": "shot09-16",
      "text": "再补一句工程经验：",
      "start": 44.587,
      "end": 46.267
    },
    {
      "id": "shot09-17",
      "text": "实在不确定怎么选的时候，",
      "start": 46.267,
      "end": 48.367
    },
    {
      "id": "shot09-18",
      "text": "两种都跑一遍，",
      "start": 48.367,
      "end": 49.707
    },
    {
      "id": "shot09-19",
      "text": "比 KNN 准确率谁高用谁——选不出差别",
      "start": 49.707,
      "end": 52.907
    },
    {
      "id": "shot09-20",
      "text": "就用标准化做兜底。",
      "start": 52.907,
      "end": 54.521
    }
  ],
  "shot10": [
    {
      "id": "shot10-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.32
    },
    {
      "id": "shot10-1",
      "text": "我们讲清楚了四件事：",
      "start": 1.32,
      "end": 3.12
    },
    {
      "id": "shot10-2",
      "text": "高斯分布由 μ 和 σ 两个参数决定，",
      "start": 3.12,
      "end": 6.45
    },
    {
      "id": "shot10-3",
      "text": "3σ 法则给出 68 95 99.7 三",
      "start": 6.45,
      "end": 10.36
    },
    {
      "id": "shot10-4",
      "text": "档判异常的工具；",
      "start": 10.36,
      "end": 11.72
    },
    {
      "id": "shot10-5",
      "text": "Z-score 用减 μ 除 σ 把任意",
      "start": 11.72,
      "end": 14.42
    },
    {
      "id": "shot10-6",
      "text": "分布拉成标准正态，",
      "start": 14.42,
      "end": 16.28
    },
    {
      "id": "shot10-7",
      "text": "输出是距离均值多少个 σ；",
      "start": 16.28,
      "end": 19.12
    },
    {
      "id": "shot10-8",
      "text": "sklearn",
      "start": 19.12,
      "end": 19.9
    },
    {
      "id": "shot10-9",
      "text": "StandardScaler 三步走与归",
      "start": 19.9,
      "end": 22.08
    },
    {
      "id": "shot10-10",
      "text": "一化只差一个类名；",
      "start": 22.08,
      "end": 23.78
    },
    {
      "id": "shot10-11",
      "text": "KNN 实战常用标准化做默认——异常值有",
      "start": 23.78,
      "end": 27.14
    },
    {
      "id": "shot10-12",
      "text": "发言权但不能独裁。",
      "start": 27.14,
      "end": 28.74
    },
    {
      "id": "shot10-13",
      "text": "点到没展开的：",
      "start": 29.155,
      "end": 30.295
    },
    {
      "id": "shot10-14",
      "text": "高斯概率密度函数和中心极限定理，",
      "start": 30.295,
      "end": 33.075
    },
    {
      "id": "shot10-15",
      "text": "留给统计学专题；",
      "start": 33.075,
      "end": 35.115
    },
    {
      "id": "shot10-16",
      "text": "其他缩放工具如 RobustScaler",
      "start": 35.115,
      "end": 37.575
    },
    {
      "id": "shot10-17",
      "text": "抗极端异常、",
      "start": 37.575,
      "end": 38.955
    },
    {
      "id": "shot10-18",
      "text": "PowerTransformer 拉偏态",
      "start": 38.955,
      "end": 40.475
    },
    {
      "id": "shot10-19",
      "text": "成近似正态，",
      "start": 40.475,
      "end": 41.775
    },
    {
      "id": "shot10-20",
      "text": "遇到具体场景再展开。",
      "start": 41.775,
      "end": 43.855
    },
    {
      "id": "shot10-21",
      "text": "整个缩放章一句话总结：",
      "start": 43.855,
      "end": 46.135
    },
    {
      "id": "shot10-22",
      "text": "缩放是 KNN 距离公平的前提——归一化压区间、",
      "start": 46.135,
      "end": 50.175
    },
    {
      "id": "shot10-23",
      "text": "标准化压分布。",
      "start": 50.175,
      "end": 51.575
    },
    {
      "id": "shot10-24",
      "text": "距离族加上缩放，",
      "start": 51.575,
      "end": 53.195
    },
    {
      "id": "shot10-25",
      "text": "KNN 工具齐了——下一期用",
      "start": 53.195,
      "end": 55.415
    },
    {
      "id": "shot10-26",
      "text": "sklearn 在鸢尾花真实数据上把整条",
      "start": 55.415,
      "end": 58.515
    },
    {
      "id": "shot10-27",
      "text": "流水线跑通。",
      "start": 58.515,
      "end": 59.435
    },
    {
      "id": "shot10-28",
      "text": "如果讲得有不对的地方，",
      "start": 59.874,
      "end": 61.574
    },
    {
      "id": "shot10-29",
      "text": "欢迎在评论区指正。下期见。",
      "start": 61.574,
      "end": 63.594
    }
  ]
}
