{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期讲完评估指标三件套——单元数据集太抽象，",
      "start": 0.0,
      "end": 3.731
    },
    {
      "id": "shot01-1",
      "text": "这一期上真实案例：",
      "start": 3.731,
      "end": 5.115
    },
    {
      "id": "shot01-2",
      "text": "加州房价 8 特征 2 万样本，",
      "start": 5.115,
      "end": 7.421
    },
    {
      "id": "shot01-3",
      "text": "从加载到评估完整 6 步",
      "start": 7.421,
      "end": 9.378
    },
    {
      "id": "shot01-4",
      "text": "pipeline 一站跑通。",
      "start": 9.378,
      "end": 10.59
    },
    {
      "id": "shot01-5",
      "text": "这一期解决三件事：",
      "start": 11.067,
      "end": 12.269
    },
    {
      "id": "shot01-6",
      "text": "fetch_california_housing",
      "start": 12.269,
      "end": 13.952
    },
    {
      "id": "shot01-7",
      "text": "加载数据 + train_test_split 拆分 + StandardScaler 标准化的预处理三件套，",
      "start": 13.952,
      "end": 19.461
    },
    {
      "id": "shot01-11",
      "text": "为什么 LR 多元必须做标准化；",
      "start": 19.461,
      "end": 21.684
    },
    {
      "id": "shot01-12",
      "text": "LinearRegression 走正规",
      "start": 21.684,
      "end": 23.187
    },
    {
      "id": "shot01-13",
      "text": "方程和 SGDRegressor 走梯度",
      "start": 23.187,
      "end": 25.771
    },
    {
      "id": "shot01-14",
      "text": "下降两种解法，",
      "start": 25.771,
      "end": 27.133
    },
    {
      "id": "shot01-15",
      "text": "验证凸优化下殊途同归；",
      "start": 27.133,
      "end": 29.777
    },
    {
      "id": "shot01-16",
      "text": "MSE / MAE / RMSE / R² 四个指标全部跑出来对外报告。",
      "start": 29.777,
      "end": 35.647
    },
    {
      "id": "shot01-18",
      "text": "下一期看 LR 的另一面：",
      "start": 36.118,
      "end": 38.142
    },
    {
      "id": "shot01-19",
      "text": "拟合得太好是好事吗？",
      "start": 38.142,
      "end": 39.984
    },
    {
      "id": "shot01-20",
      "text": "反直觉的过拟合 U 形现象。",
      "start": 39.984,
      "end": 42.098
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看数据集背景。",
      "start": 0.0,
      "end": 1.743
    },
    {
      "id": "shot02-1",
      "text": "机器学习最经典的回归 benchmark",
      "start": 1.743,
      "end": 4.348
    },
    {
      "id": "shot02-2",
      "text": "原本是 Boston Housing",
      "start": 4.348,
      "end": 5.811
    },
    {
      "id": "shot02-3",
      "text": "波士顿房价 13 特征，",
      "start": 5.811,
      "end": 7.595
    },
    {
      "id": "shot02-4",
      "text": "但 2022 年 sklearn 已经把",
      "start": 7.595,
      "end": 9.879
    },
    {
      "id": "shot02-5",
      "text": "它废弃下架——原因是数据集里有种族特征B 列，",
      "start": 9.879,
      "end": 13.807
    },
    {
      "id": "shot02-6",
      "text": "相关研究构建时含有种族偏见，",
      "start": 13.807,
      "end": 16.231
    },
    {
      "id": "shot02-7",
      "text": "sklearn 出于伦理考虑彻底移除。",
      "start": 16.231,
      "end": 18.997
    },
    {
      "id": "shot02-8",
      "text": "替代品就是加州房价 California",
      "start": 19.448,
      "end": 21.811
    },
    {
      "id": "shot02-9",
      "text": "Housing：",
      "start": 21.811,
      "end": 22.652
    },
    {
      "id": "shot02-10",
      "text": "8 个特征、",
      "start": 22.652,
      "end": 23.493
    },
    {
      "id": "shot02-11",
      "text": "20640 个样本、",
      "start": 23.493,
      "end": 24.935
    },
    {
      "id": "shot02-12",
      "text": "来自 1990 年加州人口普查。",
      "start": 24.935,
      "end": 27.718
    },
    {
      "id": "shot02-13",
      "text": "8 个特征分别是：",
      "start": 27.718,
      "end": 29.08
    },
    {
      "id": "shot02-14",
      "text": "MedInc 区域中位数收入、",
      "start": 29.08,
      "end": 31.182
    },
    {
      "id": "shot02-15",
      "text": "HouseAge 房龄中位数、",
      "start": 31.182,
      "end": 33.465
    },
    {
      "id": "shot02-16",
      "text": "AveRooms 平均房间数、",
      "start": 33.465,
      "end": 35.587
    },
    {
      "id": "shot02-17",
      "text": "AveBedrms 平均卧室数、",
      "start": 35.587,
      "end": 37.97
    },
    {
      "id": "shot02-18",
      "text": "Population 区域人口、",
      "start": 37.97,
      "end": 39.993
    },
    {
      "id": "shot02-19",
      "text": "AveOccup 平均住户数、",
      "start": 39.993,
      "end": 42.295
    },
    {
      "id": "shot02-20",
      "text": "Latitude 纬度、",
      "start": 42.295,
      "end": 43.256
    },
    {
      "id": "shot02-21",
      "text": "Longitude 经度。",
      "start": 43.256,
      "end": 44.358
    },
    {
      "id": "shot02-22",
      "text": "标签是房价中位数，",
      "start": 44.77,
      "end": 46.476
    },
    {
      "id": "shot02-23",
      "text": "单位 10 万美元。",
      "start": 46.476,
      "end": 47.84
    },
    {
      "id": "shot02-24",
      "text": "一行代码加载：",
      "start": 47.84,
      "end": 49.165
    },
    {
      "id": "shot02-25",
      "text": "fetch_california_housing",
      "start": 49.165,
      "end": 50.81
    },
    {
      "id": "shot02-26",
      "text": "返回 X 和 y。",
      "start": 50.81,
      "end": 52.396
    },
    {
      "id": "shot02-27",
      "text": "这是 sklearn 当前推荐的回归实战",
      "start": 52.396,
      "end": 55.406
    },
    {
      "id": "shot02-28",
      "text": "标准数据集——比身高体重 5 个点真实得多。",
      "start": 55.406,
      "end": 58.918
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "看 pipeline 前 3 步。",
      "start": 0.0,
      "end": 1.664
    },
    {
      "id": "shot03-1",
      "text": "第一步加载数据，",
      "start": 1.664,
      "end": 3.047
    },
    {
      "id": "shot03-2",
      "text": "刚才那行",
      "start": 3.047,
      "end": 3.789
    },
    {
      "id": "shot03-3",
      "text": "fetch_california_housing。",
      "start": 3.789,
      "end": 5.293
    },
    {
      "id": "shot03-4",
      "text": "第二步切分训练测试集，",
      "start": 5.293,
      "end": 7.378
    },
    {
      "id": "shot03-5",
      "text": "sklearn dot",
      "start": 7.378,
      "end": 8.3
    },
    {
      "id": "shot03-6",
      "text": "model_selection 里的",
      "start": 8.3,
      "end": 9.523
    },
    {
      "id": "shot03-7",
      "text": "train_test_split：",
      "start": 9.523,
      "end": 10.947
    },
    {
      "id": "shot03-8",
      "text": "传入 X y、",
      "start": 10.947,
      "end": 11.508
    },
    {
      "id": "shot03-9",
      "text": "test_size 等于 0.2 留",
      "start": 11.508,
      "end": 14.014
    },
    {
      "id": "shot03-10",
      "text": "20% 当测试集、",
      "start": 14.014,
      "end": 15.859
    },
    {
      "id": "shot03-11",
      "text": "random_state 等于 22 固",
      "start": 15.859,
      "end": 17.763
    },
    {
      "id": "shot03-12",
      "text": "定随机种子保证结果可复现。",
      "start": 17.763,
      "end": 19.808
    },
    {
      "id": "shot03-13",
      "text": "返回 X_train X_test",
      "start": 20.355,
      "end": 21.697
    },
    {
      "id": "shot03-14",
      "text": "y_train y_test 4 个数组。",
      "start": 21.858,
      "end": 24.202
    },
    {
      "id": "shot03-15",
      "text": "第三步标准化——这一步多元 LR 必须做。原因：",
      "start": 24.202,
      "end": 28.749
    },
    {
      "id": "shot03-16",
      "text": "加州 8 特征量纲悬殊，",
      "start": 28.749,
      "end": 30.793
    },
    {
      "id": "shot03-17",
      "text": "纬度经度在 30 到 40，",
      "start": 30.793,
      "end": 33.097
    },
    {
      "id": "shot03-18",
      "text": "AveOccup 在 1 到 5，",
      "start": 33.097,
      "end": 34.619
    },
    {
      "id": "shot03-19",
      "text": "MedInc 在 0 到 15，",
      "start": 34.619,
      "end": 36.503
    },
    {
      "id": "shot03-20",
      "text": "Population 在几百到几万——量",
      "start": 36.503,
      "end": 38.646
    },
    {
      "id": "shot03-21",
      "text": "纲差几个数量级，",
      "start": 38.646,
      "end": 40.069
    },
    {
      "id": "shot03-22",
      "text": "权重 w 不在同一个尺度上，",
      "start": 40.069,
      "end": 42.453
    },
    {
      "id": "shot03-23",
      "text": "正规方程数值不稳，",
      "start": 42.453,
      "end": 44.155
    },
    {
      "id": "shot03-24",
      "text": "梯度下降会震荡。",
      "start": 44.155,
      "end": 45.318
    },
    {
      "id": "shot03-25",
      "text": "StandardScaler 把每个特征",
      "start": 45.927,
      "end": 47.769
    },
    {
      "id": "shot03-26",
      "text": "减去均值再除以标准差，",
      "start": 47.769,
      "end": 49.751
    },
    {
      "id": "shot03-27",
      "text": "让所有特征均值 0、方差 1。",
      "start": 49.751,
      "end": 52.173
    },
    {
      "id": "shot03-28",
      "text": "注意一个工程铁律：",
      "start": 52.173,
      "end": 53.835
    },
    {
      "id": "shot03-29",
      "text": "fit_transform 只在训练集上做，",
      "start": 53.835,
      "end": 55.997
    },
    {
      "id": "shot03-30",
      "text": "transform 应用到测试集——不能",
      "start": 55.997,
      "end": 58.199
    },
    {
      "id": "shot03-31",
      "text": "让测试集信息泄露到训练阶段，",
      "start": 58.199,
      "end": 60.621
    },
    {
      "id": "shot03-32",
      "text": "这是数据科学的基本纪律。",
      "start": 60.621,
      "end": 62.343
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "第 4 步训练，",
      "start": 0.0,
      "end": 1.121
    },
    {
      "id": "shot04-1",
      "text": "跑两种解法对比。",
      "start": 1.121,
      "end": 2.704
    },
    {
      "id": "shot04-2",
      "text": "第一种 LinearRegression",
      "start": 2.704,
      "end": 4.446
    },
    {
      "id": "shot04-3",
      "text": "内部走正规方程加 SVD 分解，",
      "start": 4.446,
      "end": 7.309
    },
    {
      "id": "shot04-4",
      "text": "前面 5 期讲的就是它：",
      "start": 7.309,
      "end": 8.851
    },
    {
      "id": "shot04-5",
      "text": "实例化 fit predict 三行。",
      "start": 8.851,
      "end": 11.034
    },
    {
      "id": "shot04-6",
      "text": "一行代码出 8 个 coef 加 1 个",
      "start": 11.034,
      "end": 13.638
    },
    {
      "id": "shot04-7",
      "text": "intercept——这就是 8 个特",
      "start": 13.638,
      "end": 15.5
    },
    {
      "id": "shot04-8",
      "text": "征的权重和偏置。",
      "start": 15.5,
      "end": 16.762
    },
    {
      "id": "shot04-9",
      "text": "第二种 SGDRegressor 内部走",
      "start": 17.197,
      "end": 19.34
    },
    {
      "id": "shot04-10",
      "text": "随机梯度下降，",
      "start": 19.34,
      "end": 20.482
    },
    {
      "id": "shot04-11",
      "text": "前面 7 期讲的就是它：",
      "start": 20.482,
      "end": 21.884
    },
    {
      "id": "shot04-12",
      "text": "实例化时设 max_iter 等于1000、",
      "start": 21.884,
      "end": 24.668
    },
    {
      "id": "shot04-13",
      "text": "learning_rate 等于 '",
      "start": 24.668,
      "end": 25.709
    },
    {
      "id": "shot04-14",
      "text": "constant'、",
      "start": 25.709,
      "end": 26.831
    },
    {
      "id": "shot04-15",
      "text": "eta0 等于 0.0001——注意",
      "start": 26.831,
      "end": 29.034
    },
    {
      "id": "shot04-16",
      "text": "eta0 必须设小，",
      "start": 29.034,
      "end": 30.356
    },
    {
      "id": "shot04-17",
      "text": "sklearn 1.8 默认参数在加州数",
      "start": 30.356,
      "end": 33.301
    },
    {
      "id": "shot04-18",
      "text": "据上会发散，",
      "start": 33.301,
      "end": 34.382
    },
    {
      "id": "shot04-19",
      "text": "这是个工程坑。",
      "start": 34.382,
      "end": 35.945
    },
    {
      "id": "shot04-20",
      "text": "其它步骤一样 fit predict。",
      "start": 35.945,
      "end": 38.168
    },
    {
      "id": "shot04-21",
      "text": "两种解法都跑完，",
      "start": 38.168,
      "end": 39.75
    },
    {
      "id": "shot04-22",
      "text": "对外预测同一组测试集。",
      "start": 39.75,
      "end": 41.413
    },
    {
      "id": "shot04-23",
      "text": "直觉上两种方法路径完全不同：",
      "start": 41.937,
      "end": 44.304
    },
    {
      "id": "shot04-24",
      "text": "一种代数公式一步出解、",
      "start": 44.304,
      "end": 46.17
    },
    {
      "id": "shot04-25",
      "text": "一种数值迭代慢慢逼近——但因为 LR",
      "start": 46.17,
      "end": 49.501
    },
    {
      "id": "shot04-26",
      "text": "MSE 是凸函数全局唯一最优，",
      "start": 49.501,
      "end": 52.149
    },
    {
      "id": "shot04-27",
      "text": "两种路径终点必须一致。",
      "start": 52.149,
      "end": 54.296
    },
    {
      "id": "shot04-28",
      "text": "这正是凸优化的精髓——不论你怎么走，",
      "start": 54.296,
      "end": 57.004
    },
    {
      "id": "shot04-29",
      "text": "碗底就是那一个。",
      "start": 57.004,
      "end": 57.947
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "第 5 步评估，",
      "start": 0.0,
      "end": 1.021
    },
    {
      "id": "shot05-1",
      "text": "把上一期的三件套加 R² 决定系数全跑出来。",
      "start": 1.021,
      "end": 4.807
    },
    {
      "id": "shot05-2",
      "text": "从 sklearn dot",
      "start": 4.807,
      "end": 5.888
    },
    {
      "id": "shot05-3",
      "text": "metrics 引入",
      "start": 5.888,
      "end": 7.13
    },
    {
      "id": "shot05-4",
      "text": "mean_squared_error、",
      "start": 7.13,
      "end": 8.372
    },
    {
      "id": "shot05-5",
      "text": "mean_absolute_error、",
      "start": 8.372,
      "end": 10.455
    },
    {
      "id": "shot05-6",
      "text": "r2_score。",
      "start": 10.455,
      "end": 11.837
    },
    {
      "id": "shot05-7",
      "text": "两种解法对比实测：",
      "start": 11.837,
      "end": 13.7
    },
    {
      "id": "shot05-8",
      "text": "正规方程 MSE 等于 0.5075、",
      "start": 13.7,
      "end": 17.465
    },
    {
      "id": "shot05-9",
      "text": "MAE 等于 0.5267、",
      "start": 17.465,
      "end": 20.249
    },
    {
      "id": "shot05-10",
      "text": "RMSE 等于 0.7124、",
      "start": 20.249,
      "end": 23.193
    },
    {
      "id": "shot05-11",
      "text": "R 平方等于 0.6094。",
      "start": 23.193,
      "end": 25.697
    },
    {
      "id": "shot05-12",
      "text": "SGD 调好 eta0 后：",
      "start": 25.924,
      "end": 27.648
    },
    {
      "id": "shot05-13",
      "text": "MSE 等于 0.5075、",
      "start": 27.648,
      "end": 30.232
    },
    {
      "id": "shot05-14",
      "text": "R 平方等于 0.6095——和正规方程一字不差，",
      "start": 30.232,
      "end": 34.4
    },
    {
      "id": "shot05-15",
      "text": "验证凸优化殊途同归。",
      "start": 34.4,
      "end": 36.584
    },
    {
      "id": "shot05-16",
      "text": "R 平方 0.6 说明模型解释了 60%",
      "start": 36.584,
      "end": 39.91
    },
    {
      "id": "shot05-17",
      "text": "的房价方差——对线性模型 + 8 个特征不算坏，",
      "start": 39.91,
      "end": 43.617
    },
    {
      "id": "shot05-18",
      "text": "但还有 40% 没解释，",
      "start": 43.617,
      "end": 45.821
    },
    {
      "id": "shot05-19",
      "text": "留给更复杂的模型或特征工程。",
      "start": 45.821,
      "end": 48.005
    },
    {
      "id": "shot05-20",
      "text": "第 6 步预测新样本：",
      "start": 48.693,
      "end": 50.417
    },
    {
      "id": "shot05-21",
      "text": "构造一个新区域的特征向量比如收入中位数8、",
      "start": 50.417,
      "end": 54.386
    },
    {
      "id": "shot05-22",
      "text": "房龄 30、其它默认，",
      "start": 54.386,
      "end": 56.251
    },
    {
      "id": "shot05-23",
      "text": "scaler 一定要先",
      "start": 56.251,
      "end": 57.674
    },
    {
      "id": "shot05-24",
      "text": "transform 再喂给 model.",
      "start": 57.674,
      "end": 59.258
    },
    {
      "id": "shot05-25",
      "text": "predict——返回预测房价中位数。",
      "start": 59.258,
      "end": 61.984
    },
    {
