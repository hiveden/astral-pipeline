{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期讲了剪枝方法，",
      "start": 0.0,
      "end": 1.821
    },
    {
      "id": "shot01-1",
      "text": "这一期看案例。",
      "start": 1.821,
      "end": 3.189
    },
    {
      "id": "shot01-2",
      "text": "剪枝最容易误解的地方，",
      "start": 3.189,
      "end": 4.783
    },
    {
      "id": "shot01-3",
      "text": "是以为树越小越好，",
      "start": 4.783,
      "end": 6.665
    },
    {
      "id": "shot01-4",
      "text": "或者树越大越好。",
      "start": 6.665,
      "end": 8.306
    },
    {
      "id": "shot01-5",
      "text": "其实都不对。",
      "start": 8.306,
      "end": 9.247
    },
    {
      "id": "shot01-6",
      "text": "正确问题是：",
      "start": 9.247,
      "end": 10.207
    },
    {
      "id": "shot01-7",
      "text": "某个分支留下来以后，",
      "start": 10.207,
      "end": 12.009
    },
    {
      "id": "shot01-8",
      "text": "验证集表现有没有变好。",
      "start": 12.009,
      "end": 14.25
    },
    {
      "id": "shot01-9",
      "text": "如果没变好，甚至变差，",
      "start": 14.25,
      "end": 16.172
    },
    {
      "id": "shot01-10",
      "text": "这个分支就不值得保留。",
      "start": 16.172,
      "end": 17.967
    },
    {
      "id": "shot01-11",
      "text": "剪枝不是凭感觉修树，",
      "start": 17.967,
      "end": 20.24
    },
    {
      "id": "shot01-12",
      "text": "而是用验证集给每个分支做一次小考试。",
      "start": 20.24,
      "end": 23.592
    },
    {
      "id": "shot01-13",
      "text": "我们先用书本分类案例看预剪枝怎么提前停，",
      "start": 23.592,
      "end": 27.325
    },
    {
      "id": "shot01-14",
      "text": "再用西瓜书脐部案例看后剪枝怎么自底向上折",
      "start": 27.325,
      "end": 31.178
    },
    {
      "id": "shot01-15",
      "text": "叠子树。",
      "start": 31.178,
      "end": 31.659
    },
    {
      "id": "shot01-16",
      "text": "这两个案例合在一起，",
      "start": 32.061,
      "end": 33.425
    },
    {
      "id": "shot01-17",
      "text": "正好覆盖剪枝的两个时机：",
      "start": 33.425,
      "end": 35.713
    },
    {
      "id": "shot01-18",
      "text": "切之前先拦住，",
      "start": 35.713,
      "end": 37.017
    },
    {
      "id": "shot01-19",
      "text": "或者长完以后再回头检查。",
      "start": 37.017,
      "end": 39.004
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看书本分类案例。",
      "start": 0.0,
      "end": 1.743
    },
    {
      "id": "shot02-1",
      "text": "训练集里有 8 条样本，",
      "start": 1.743,
      "end": 3.445
    },
    {
      "id": "shot02-2",
      "text": "特征是颜色和插图，",
      "start": 3.445,
      "end": 5.128
    },
    {
      "id": "shot02-3",
      "text": "类别是科技书或文学书。",
      "start": 5.128,
      "end": 7.211
    },
    {
      "id": "shot02-4",
      "text": "验证集有 4 条样本，",
      "start": 7.211,
      "end": 8.834
    },
    {
      "id": "shot02-5",
      "text": "只负责检查泛化效果。",
      "start": 8.834,
      "end": 10.917
    },
    {
      "id": "shot02-6",
      "text": "根节点还没有分裂时，",
      "start": 10.917,
      "end": 12.62
    },
    {
      "id": "shot02-7",
      "text": "训练集里科技书和文学书各占一半，",
      "start": 12.62,
      "end": 15.404
    },
    {
      "id": "shot02-8",
      "text": "没有多数类，",
      "start": 15.404,
      "end": 16.487
    },
    {
      "id": "shot02-9",
      "text": "标签只能按平票约定选一个类别替代。",
      "start": 16.487,
      "end": 19.655
    },
    {
      "id": "shot02-10",
      "text": "预剪枝从这里就开始问：",
      "start": 19.655,
      "end": 21.48
    },
    {
      "id": "shot02-11",
      "text": "如果按颜色分裂，",
      "start": 21.48,
      "end": 22.904
    },
    {
      "id": "shot02-12",
      "text": "验证集准确率有没有比不分裂更好。",
      "start": 22.904,
      "end": 25.791
    },
    {
      "id": "shot02-13",
      "text": "如果有提升，",
      "start": 25.791,
      "end": 26.794
    },
    {
      "id": "shot02-14",
      "text": "就允许颜色这一刀；",
      "start": 26.794,
      "end": 28.679
    },
    {
      "id": "shot02-15",
      "text": "如果没有提升，",
      "start": 28.679,
      "end": 29.701
    },
    {
      "id": "shot02-16",
      "text": "就把当前节点直接当叶子。",
      "start": 29.701,
      "end": 31.626
    },
    {
      "id": "shot02-17",
      "text": "这个过程的关键不是训练集分得多漂亮，",
      "start": 32.137,
      "end": 35.301
    },
    {
      "id": "shot02-18",
      "text": "而是验证集是否认可这次分裂。",
      "start": 35.301,
      "end": 38.045
    },
    {
      "id": "shot02-19",
      "text": "这也是训练集和验证集分工最清楚的一幕：",
      "start": 38.045,
      "end": 41.67
    },
    {
      "id": "shot02-20",
      "text": "训练集负责提出候选树，",
      "start": 41.67,
      "end": 43.993
    },
    {
      "id": "shot02-21",
      "text": "验证集负责决定这棵候选树值不值得接受。",
      "start": 43.993,
      "end": 47.558
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "预剪枝的步骤可以写成一句话：",
      "start": 0.0,
      "end": 2.142
    },
    {
      "id": "shot03-1",
      "text": "每一刀之前，",
      "start": 2.142,
      "end": 3.122
    },
    {
      "id": "shot03-2",
      "text": "先问值不值。",
      "start": 3.122,
      "end": 4.423
    },
    {
      "id": "shot03-3",
      "text": "根节点候选是颜色。",
      "start": 4.423,
      "end": 6.125
    },
    {
      "id": "shot03-4",
      "text": "用颜色切开以后，",
      "start": 6.125,
      "end": 7.726
    },
    {
      "id": "shot03-5",
      "text": "蓝色叶子大多是科技书，",
      "start": 7.726,
      "end": 9.867
    },
    {
      "id": "shot03-6",
      "text": "红色叶子大多是文学书，",
      "start": 9.867,
      "end": 11.949
    },
    {
      "id": "shot03-7",
      "text": "再拿验证集跑一遍。",
      "start": 11.949,
      "end": 13.65
    },
    {
      "id": "shot03-8",
      "text": "如果分裂后准确率提高，",
      "start": 13.65,
      "end": 15.692
    },
    {
      "id": "shot03-9",
      "text": "就保留颜色这个节点，",
      "start": 15.692,
      "end": 17.333
    },
    {
      "id": "shot03-10",
      "text": "继续往下。",
      "start": 17.333,
      "end": 18.554
    },
    {
      "id": "shot03-11",
      "text": "到了下一层，再试插图。",
      "start": 18.554,
      "end": 20.435
    },
    {
      "id": "shot03-12",
      "text": "红色子树如果继续按插图切，",
      "start": 20.435,
      "end": 23.118
    },
    {
      "id": "shot03-13",
      "text": "验证集表现没有提升，",
      "start": 23.118,
      "end": 24.986
    },
    {
      "id": "shot03-14",
      "text": "甚至在某种标签约定下会从 100% 降到",
      "start": 24.986,
      "end": 28.502
    },
    {
      "id": "shot03-15",
      "text": "50%，",
      "start": 28.502,
      "end": 29.687
    },
    {
      "id": "shot03-16",
      "text": "这一刀就不允许切。",
      "start": 29.687,
      "end": 30.853
    },
    {
      "id": "shot03-17",
      "text": "这样生成的树通常更小，",
      "start": 31.34,
      "end": 33.164
    },
    {
      "id": "shot03-18",
      "text": "训练和预测都更快，",
      "start": 33.164,
      "end": 34.708
    },
    {
      "id": "shot03-19",
      "text": "但也可能过早停下，",
      "start": 34.708,
      "end": 36.292
    },
    {
      "id": "shot03-20",
      "text": "错过后面有价值的组合。",
      "start": 36.292,
      "end": 38.096
    },
    {
      "id": "shot03-21",
      "text": "所以预剪枝看起来保守，",
      "start": 38.096,
      "end": 39.961
    },
    {
      "id": "shot03-22",
      "text": "但它的保守有理由：",
      "start": 39.961,
      "end": 41.384
    },
    {
      "id": "shot03-23",
      "text": "它宁可少长一层，",
      "start": 41.384,
      "end": 42.908
    },
    {
      "id": "shot03-24",
      "text": "也不愿为了训练集上的细节破坏验证集表现。",
      "start": 42.908,
      "end": 46.376
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "后剪枝反过来，",
      "start": 0.0,
      "end": 1.282
    },
    {
      "id": "shot04-1",
      "text": "先让树完整长出来，",
      "start": 1.282,
      "end": 3.245
    },
    {
      "id": "shot04-2",
      "text": "再自底向上试着折叠。",
      "start": 3.245,
      "end": 5.249
    },
    {
      "id": "shot04-3",
      "text": "西瓜书脐部案例里，",
      "start": 5.249,
      "end": 6.812
    },
    {
      "id": "shot04-4",
      "text": "完整树在验证集上的精度只有 42.9%，",
      "start": 6.812,
      "end": 10.758
    },
    {
      "id": "shot04-5",
      "text": "也就是 7 个验证样本里只对 3 个。",
      "start": 10.758,
      "end": 13.463
    },
    {
      "id": "shot04-6",
      "text": "算法从最深的内部结点开始考察。",
      "start": 13.463,
      "end": 16.689
    },
    {
      "id": "shot04-7",
      "text": "先看结点 6，",
      "start": 16.689,
      "end": 17.831
    },
    {
      "id": "shot04-8",
      "text": "把它下面的子树临时折成一个叶子，",
      "start": 17.831,
      "end": 20.535
    },
    {
      "id": "shot04-9",
      "text": "精度升到 57.1%，",
      "start": 20.535,
      "end": 22.679
    },
    {
      "id": "shot04-10",
      "text": "所以确认剪掉。",
      "start": 22.679,
      "end": 24.121
    },
    {
      "id": "shot04-11",
      "text": "再看结点 5，",
      "start": 24.121,
      "end": 25.384
    },
    {
      "id": "shot04-12",
      "text": "精度没有继续上升，",
      "start": 25.384,
      "end": 26.886
    },
    {
      "id": "shot04-13",
      "text": "按本案例主流程保留。",
      "start": 26.886,
      "end": 28.369
    },
    {
      "id": "shot04-14",
      "text": "这里要把口径说清楚：",
      "start": 28.775,
      "end": 30.748
    },
    {
      "id": "shot04-15",
      "text": "案例用的是精度上升才剪；",
      "start": 30.748,
      "end": 33.022
    },
    {
      "id": "shot04-16",
      "text": "如果按更偏工程的简单优先原则，",
      "start": 33.022,
      "end": 36.127
    },
    {
      "id": "shot04-17",
      "text": "精度持平也可以剪。",
      "start": 36.127,
      "end": 37.729
    },
    {
      "id": "shot04-18",
      "text": "这个差异不是数学矛盾，",
      "start": 37.729,
      "end": 39.492
    },
    {
      "id": "shot04-19",
      "text": "而是策略选择。",
      "start": 39.492,
      "end": 41.075
    },
    {
      "id": "shot04-20",
      "text": "上升才剪更保守，",
      "start": 41.075,
      "end": 42.838
    },
    {
      "id": "shot04-21",
      "text": "持平也剪更偏向简单模型，",
      "start": 42.838,
      "end": 45.462
    },
    {
      "id": "shot04-22",
      "text": "两个口径要在同一项目里保持一致。",
      "start": 45.462,
      "end": 47.746
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "继续往上看，",
      "start": 0.0,
      "end": 1.021
    },
    {
      "id": "shot05-1",
      "text": "结点 2 被折叠以后，",
      "start": 1.021,
      "end": 2.503
    },
    {
      "id": "shot05-2",
      "text": "验证集精度升到 71.4%，",
      "start": 2.503,
      "end": 5.107
    },
    {
      "id": "shot05-3",
      "text": "也就是 7 个样本里对 5 个，",
      "start": 5.107,
      "end": 7.029
    },
    {
      "id": "shot05-4",
      "text": "所以确认剪掉。",
      "start": 7.029,
      "end": 8.291
    },
    {
      "id": "shot05-5",
      "text": "再考察结点 3 和根结点 1，",
      "start": 8.291,
      "end": 10.494
    },
    {
      "id": "shot05-6",
      "text": "精度没有提升，就保留。",
      "start": 10.494,
      "end": 12.136
    },
    {
      "id": "shot05-7",
      "text": "最后得到的后剪枝树，",
      "start": 12.136,
      "end": 13.658
    },
    {
      "id": "shot05-8",
      "text": "精度也是 71.4%。",
      "start": 13.658,
      "end": 15.981
    },
    {
      "id": "shot05-9",
      "text": "画面上可以看到一个很具体的变化：",
      "start": 15.981,
      "end": 18.344
    },
    {
      "id": "shot05-10",
      "text": "色泽等于乌黑的分支下面，",
      "start": 18.344,
      "end": 20.547
    },
    {
      "id": "shot05-11",
      "text": "原来还有纹理子树，",
      "start": 20.547,
      "end": 22.029
    },
    {
      "id": "shot05-12",
      "text": "剪完以后整棵纹理子树被取消，",
      "start": 22.029,
      "end": 24.652
    },
    {
      "id": "shot05-13",
      "text": "乌黑直接变成一个叶子，",
      "start": 24.652,
      "end": 26.615
    },
    {
      "id": "shot05-14",
      "text": "标签按这个子树里的多数类给出。",
      "start": 26.615,
      "end": 28.878
    },
    {
      "id": "shot05-15",
      "text": "这个例子说明，",
      "start": 29.489,
      "end": 30.652
    },
    {
      "id": "shot05-16",
      "text": "后剪枝不是随便砍短，",
      "start": 30.652,
      "end": 32.737
    },
    {
      "id": "shot05-17",
      "text": "而是每砍一次都要用验证集验算。",
      "start": 32.737,
      "end": 35.583
    },
    {
      "id": "shot05-18",
      "text": "和预剪枝相比，",
      "start": 35.583,
      "end": 36.926
    },
    {
      "id": "shot05-19",
      "text": "后剪枝多花了计算成本，",
      "start": 36.926,
      "end": 39.051
    },
    {
      "id": "shot05-20",
      "text": "但换来的是先看完整结构，",
      "start": 39.051,
      "end": 41.617
    },
    {
      "id": "shot05-21",
      "text": "再决定哪些局部规则没有泛化价值。",
      "start": 41.617,
      "end": 44.825
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "把两种方法放在一起看。",
      "start": 0.0,
      "end": 1.641
    },
    {
      "id": "shot06-1",
      "text": "预剪枝像边装修边验收，",
      "start": 1.641,
      "end": 3.761
    },
    {
      "id": "shot06-2",
      "text": "看到不划算的地方立刻停，优点是快，",
      "start": 3.761,
      "end": 6.803
    },
    {
      "id": "shot06-3",
      "text": "缺点是容易欠拟合。",
      "start": 6.803,
      "end": 8.423
    },
    {
      "id": "shot06-4",
      "text": "后剪枝像先把房子完整装完，",
      "start": 8.423,
      "end": 10.864
    },
    {
      "id": "shot06-5",
      "text": "再请验房师逐项返工，",
      "start": 10.864,
      "end": 12.865
    },
    {
      "id": "shot06-6",
      "text": "优点是泛化通常更好，",
      "start": 12.865,
      "end": 14.806
    },
    {
      "id": "shot06-7",
      "text": "缺点是慢。到这里，",
      "start": 14.806,
      "end": 16.546
    },
    {
      "id": "shot06-8",
      "text": "决策树这一章就闭环了。",
      "start": 16.546,
      "end": 18.447
    },
    {
      "id": "shot06-9",
      "text": "ID3 用信息增益选特征，",
      "start": 18.447,
      "end": 20.753
    },
    {
      "id": "shot06-10",
      "text": "C4.5 用信息增益率惩罚多值偏好，",
      "start": 20.753,
      "end": 24.042
    },
    {
      "id": "shot06-11",
      "text": "CART 用基尼指数和平方损失覆盖分类与",
      "start": 24.042,
      "end": 27.651
    },
    {
      "id": "shot06-12",
      "text": "回归。",
      "start": 27.651,
      "end": 28.193
    },
    {
      "id": "shot06-13",
      "text": "单棵树最大的优点是可解释：",
      "start": 28.193,
      "end": 30.539
    },
    {
      "id": "shot06-14",
      "text": "规则能画出来，",
      "start": 30.539,
      "end": 31.782
    },
    {
      "id": "shot06-15",
      "text": "业务方能读。",
      "start": 31.782,
      "end": 32.564
    },
    {
      "id": "shot06-16",
      "text": "最大的缺点也很清楚：",
      "start": 33.013,
      "end": 34.834
    },
    {
      "id": "shot06-17",
      "text": "容易过拟合，",
      "start": 34.834,
      "end": 36.034
    },
    {
      "id": "shot06-18",
      "text": "不够稳定。",
      "start": 36.034,
      "end": 37.121
    },
    {
      "id": "shot06-19",
      "text": "剪枝能缓解，",
      "start": 37.121,
      "end": 38.055
