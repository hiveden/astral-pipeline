{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "这一期我们讲机器学习的入门第一站，",
      "start": 0.0,
      "end": 2.86
    },
    {
      "id": "shot01-1",
      "text": "K 近邻算法，",
      "start": 2.86,
      "end": 3.94
    },
    {
      "id": "shot01-2",
      "text": "英文名 K Nearest",
      "start": 3.94,
      "end": 5.44
    },
    {
      "id": "shot01-3",
      "text": "Neighbor，",
      "start": 5.44,
      "end": 6.2
    },
    {
      "id": "shot01-4",
      "text": "简写 KNN。",
      "start": 6.2,
      "end": 7.56
    },
    {
      "id": "shot01-5",
      "text": "一句话概括它的思想：",
      "start": 7.56,
      "end": 9.06
    },
    {
      "id": "shot01-6",
      "text": "要判断一个新样本属于哪一类，",
      "start": 9.06,
      "end": 11.44
    },
    {
      "id": "shot01-7",
      "text": "就去找和它最像的 K 个邻居，",
      "start": 11.44,
      "end": 13.9
    },
    {
      "id": "shot01-8",
      "text": "看这 K 个邻居里哪一类最多，",
      "start": 13.9,
      "end": 16.24
    },
    {
      "id": "shot01-9",
      "text": "新样本就归到哪一类。",
      "start": 16.24,
      "end": 18.36
    },
    {
      "id": "shot01-10",
      "text": "算法版的近朱者赤，近墨者黑。",
      "start": 18.36,
      "end": 20.98
    },
    {
      "id": "shot01-11",
      "text": "这一期我们解决 KNN 的第一个核心问题：",
      "start": 20.98,
      "end": 24.28
    },
    {
      "id": "shot01-12",
      "text": "怎么定义最像，",
      "start": 24.28,
      "end": 25.64
    },
    {
      "id": "shot01-13",
      "text": "也就是怎么算距离。",
      "start": 25.64,
      "end": 27.18
    },
    {
      "id": "shot01-14",
      "text": "下一期再讲 K 取多少。",
      "start": 27.18,
      "end": 29.14
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先用一个最简单的画面建立直觉。",
      "start": 0.0,
      "end": 2.6
    },
    {
      "id": "shot02-1",
      "text": "想象一张二维平面，",
      "start": 2.6,
      "end": 4.64
    },
    {
      "id": "shot02-2",
      "text": "上面散落着两类已经标好的图形：",
      "start": 4.64,
      "end": 7.6
    },
    {
      "id": "shot02-3",
      "text": "一堆五角星，",
      "start": 7.6,
      "end": 8.42
    },
    {
      "id": "shot02-4",
      "text": "一堆三角形。",
      "start": 8.42,
      "end": 10.38
    },
    {
      "id": "shot02-5",
      "text": "现在平面正中间出现一个问号，",
      "start": 10.38,
      "end": 12.68
    },
    {
      "id": "shot02-6",
      "text": "我们不知道它是哪一类。",
      "start": 12.68,
      "end": 14.9
    },
    {
      "id": "shot02-7",
      "text": "怎么判定？",
      "start": 14.9,
      "end": 16.02
    },
    {
      "id": "shot02-8",
      "text": "看它周围的邻居谁多。",
      "start": 16.02,
      "end": 17.92
    },
    {
      "id": "shot02-9",
      "text": "这就引出 KNN 的两个核心问题：",
      "start": 17.92,
      "end": 20.24
    },
    {
      "id": "shot02-10",
      "text": "怎么定义\"近\"（距离怎么算），",
      "start": 20.24,
      "end": 22.98
    },
    {
      "id": "shot02-11",
      "text": "以及看几个邻居（K 取多少）。",
      "start": 22.98,
      "end": 25.54
    },
    {
      "id": "shot02-12",
      "text": "先演示一下 K 的威力。",
      "start": 25.54,
      "end": 27.64
    },
    {
      "id": "shot02-13",
      "text": "如果我们看 3 个邻居，",
      "start": 27.64,
      "end": 29.34
    },
    {
      "id": "shot02-14",
      "text": "假设是 2 个三角形加 1 个五角星，",
      "start": 29.34,
      "end": 32.6
    },
    {
      "id": "shot02-15",
      "text": "三角形 2 票赢，",
      "start": 32.6,
      "end": 34.2
    },
    {
      "id": "shot02-16",
      "text": "问号就被判成三角形。",
      "start": 34.2,
      "end": 35.8
    },
    {
      "id": "shot02-17",
      "text": "但如果改看 5 个邻居，",
      "start": 36.121,
      "end": 38.281
    },
    {
      "id": "shot02-18",
      "text": "可能这 5 个里有 3 个五角星 2 个三角形，",
      "start": 38.281,
      "end": 41.681
    },
    {
      "id": "shot02-19",
      "text": "五角星赢，",
      "start": 41.681,
      "end": 42.901
    },
    {
      "id": "shot02-20",
      "text": "问号这次又变成五角星了。同一个点，",
      "start": 42.901,
      "end": 46.321
    },
    {
      "id": "shot02-21",
      "text": "看的邻居数不同，",
      "start": 46.321,
      "end": 47.761
    },
    {
      "id": "shot02-22",
      "text": "结论可能完全相反——所以 K 取多少很关键。",
      "start": 47.761,
      "end": 51.701
    },
    {
      "id": "shot02-23",
      "text": "但 K 怎么选留给下一期，",
      "start": 51.701,
      "end": 53.861
    },
    {
      "id": "shot02-24",
      "text": "这一期我们先解决第一个问题：",
      "start": 53.861,
      "end": 56.261
    },
    {
      "id": "shot02-25",
      "text": "距离怎么算。",
      "start": 56.261,
      "end": 57.381
    },
    {
      "id": "shot02-26",
      "text": "这里先把术语对一下：",
      "start": 57.381,
      "end": 59.261
    },
    {
      "id": "shot02-27",
      "text": "图上每个图形叫样本，",
      "start": 59.261,
      "end": 61.001
    },
    {
      "id": "shot02-28",
      "text": "sample。",
      "start": 61.001,
      "end": 61.581
    },
    {
      "id": "shot02-29",
      "text": "已经标好类别的样本叫训练样本",
      "start": 61.95,
      "end": 64.69
    },
    {
      "id": "shot02-30",
      "text": "training sample，",
      "start": 64.81,
      "end": 65.81
    },
    {
      "id": "shot02-31",
      "text": "待预测的那个叫测试样本 test",
      "start": 65.81,
      "end": 68.13
    },
    {
      "id": "shot02-32",
      "text": "sample。",
      "start": 68.13,
      "end": 69.09
    },
    {
      "id": "shot02-33",
      "text": "样本所在的二维平面叫特征空间，",
      "start": 69.09,
      "end": 71.93
    },
    {
      "id": "shot02-34",
      "text": "五角星和三角形这两个标签叫类别，",
      "start": 71.93,
      "end": 74.55
    },
    {
      "id": "shot02-35",
      "text": "看几个邻居那个数字 K 叫超参数，",
      "start": 74.55,
      "end": 77.61
    },
    {
      "id": "shot02-36",
      "text": "意思是模型自己学不出来、",
      "start": 77.61,
      "end": 79.41
    },
    {
      "id": "shot02-37",
      "text": "需要我们手动设定的参数。",
      "start": 79.41,
      "end": 81.39
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "光看图形不够具体，",
      "start": 0.0,
      "end": 1.64
    },
    {
      "id": "shot03-1",
      "text": "换一个真实场景。",
      "start": 1.64,
      "end": 3.04
    },
    {
      "id": "shot03-2",
      "text": "假设你听说流浪地球 3 上映了，",
      "start": 3.04,
      "end": 5.64
    },
    {
      "id": "shot03-3",
      "text": "豆瓣 8.5 分，",
      "start": 5.64,
      "end": 6.84
    },
    {
      "id": "shot03-4",
      "text": "你会喜欢吗？",
      "start": 6.84,
      "end": 7.8
    },
    {
      "id": "shot03-5",
      "text": "最自然的判断方式：翻看历史，",
      "start": 7.8,
      "end": 10.34
    },
    {
      "id": "shot03-6",
      "text": "你过去打过分的电影里，",
      "start": 10.34,
      "end": 12.08
    },
    {
      "id": "shot03-7",
      "text": "评分最接近 8.5 的几部，",
      "start": 12.08,
      "end": 14.1
    },
    {
      "id": "shot03-8",
      "text": "你大多打了什么标签。",
      "start": 14.1,
      "end": 16.06
    },
    {
      "id": "shot03-9",
      "text": "比如流浪地球 2，",
      "start": 16.06,
      "end": 17.3
    },
    {
      "id": "shot03-10",
      "text": "8.4 分，你喜欢；阿凡达，",
      "start": 17.3,
      "end": 19.58
    },
    {
      "id": "shot03-11",
      "text": "8.7 分，你喜欢；泰坦尼克，",
      "start": 19.58,
      "end": 22.18
    },
    {
      "id": "shot03-12",
      "text": "9.5 分，你喜欢；",
      "start": 22.18,
      "end": 24.02
    },
    {
      "id": "shot03-13",
      "text": "哥斯拉 6.4，",
      "start": 24.02,
      "end": 25.28
    },
    {
      "id": "shot03-14",
      "text": "上海堡垒 2.9，",
      "start": 25.28,
      "end": 26.74
    },
    {
      "id": "shot03-15",
      "text": "这两部你不喜欢。",
      "start": 26.74,
      "end": 27.88
    },
    {
      "id": "shot03-16",
      "text": "流浪地球 3 是 8.5 分，",
      "start": 28.136,
      "end": 30.436
    },
    {
      "id": "shot03-17",
      "text": "最接近的 3 部，",
      "start": 30.436,
      "end": 31.596
    },
    {
      "id": "shot03-18",
      "text": "分别是 8.4 分、",
      "start": 31.596,
      "end": 33.176
    },
    {
      "id": "shot03-19",
      "text": "8.7 分、",
      "start": 33.176,
      "end": 34.076
    },
    {
      "id": "shot03-20",
      "text": "9.5 分，",
      "start": 34.076,
      "end": 35.116
    },
    {
      "id": "shot03-21",
      "text": "3 票全是喜欢，",
      "start": 35.116,
      "end": 36.496
    },
    {
      "id": "shot03-22",
      "text": "预测你会喜欢。",
      "start": 36.496,
      "end": 38.096
    },
    {
      "id": "shot03-23",
      "text": "这就是一维 KNN：",
      "start": 38.096,
      "end": 39.676
    },
    {
      "id": "shot03-24",
      "text": "每部电影只用一个数字描述，",
      "start": 39.676,
      "end": 41.836
    },
    {
      "id": "shot03-25",
      "text": "距离就是数字差的绝对值，",
      "start": 41.836,
      "end": 43.816
    },
    {
      "id": "shot03-26",
      "text": "找最近的 K 个邻居投票。",
      "start": 43.816,
      "end": 45.816
    },
    {
      "id": "shot03-27",
      "text": "但你看电影真的只看评分吗？",
      "start": 45.816,
      "end": 48.096
    },
    {
      "id": "shot03-28",
      "text": "同样 8.5 分，",
      "start": 48.096,
      "end": 49.456
    },
    {
      "id": "shot03-29",
      "text": "恐怖片和科幻片你不一定都喜欢；",
      "start": 49.456,
      "end": 52.496
    },
    {
      "id": "shot03-30",
      "text": "主演是熟脸还是陌生面孔，",
      "start": 52.496,
      "end": 54.536
    },
    {
      "id": "shot03-31",
      "text": "会影响判断；",
      "start": 54.536,
      "end": 55.876
    },
    {
      "id": "shot03-32",
      "text": "题材你感不感兴趣，",
      "start": 55.876,
      "end": 57.256
    },
    {
      "id": "shot03-33",
      "text": "也是一回事。",
      "start": 57.256,
      "end": 58.216
    },
    {
      "id": "shot03-34",
      "text": "一个数字不够用，",
      "start": 58.216,
      "end": 59.576
    },
    {
      "id": "shot03-35",
      "text": "我们需要更多维度。",
      "start": 59.576,
      "end": 61.096
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "我们给电影再加一个特征：",
      "start": 0.0,
      "end": 1.96
    },
    {
      "id": "shot04-1",
      "text": "主演吸引度，",
      "start": 1.96,
      "end": 2.96
    },
    {
      "id": "shot04-2",
      "text": "0 到 10 分，",
      "start": 2.96,
      "end": 3.96
    },
    {
      "id": "shot04-3",
      "text": "表示你对主演阵容的喜爱程度。",
      "start": 3.96,
      "end": 6.44
    },
    {
      "id": "shot04-4",
      "text": "流浪地球 3 现在是一组数字 8.5 和9.5。",
      "start": 6.44,
      "end": 9.92
    },
    {
      "id": "shot04-5",
      "text": "每部电影从一个数字变成两个数字，",
      "start": 9.92,
      "end": 12.6
    },
    {
      "id": "shot04-6",
      "text": "从数轴上一个点变成平面上一个点。",
      "start": 12.6,
      "end": 15.78
    },
    {
      "id": "shot04-7",
      "text": "这时候近不近，",
      "start": 15.78,
      "end": 16.7
    },
    {
      "id": "shot04-8",
      "text": "从数字差升级到平面直线距离。怎么算？勾股定理：",
      "start": 16.7,
      "end": 21.44
    },
    {
      "id": "shot04-9",
      "text": "横坐标差的平方加上纵坐标差的平方，再开方。",
      "start": 21.44,
      "end": 25.1
    },
    {
      "id": "shot04-10",
      "text": "流浪地球 3 是 8.5 和 9.5，",
      "start": 25.411,
      "end": 28.031
    },
    {
      "id": "shot04-11",
      "text": "流浪地球 2 是 8.4 和 9.0，",
      "start": 28.031,
      "end": 30.591
    },
    {
      "id": "shot04-12",
      "text": "距离就是 0.01 加 0.25 开方，",
      "start": 30.591,
      "end": 33.431
    },
    {
      "id": "shot04-13",
      "text": "约等于 0.51。直觉看图，",
      "start": 33.431,
      "end": 35.991
    },
    {
      "id": "shot04-14",
      "text": "流浪地球 3 跟复仇者联盟 4、",
      "start": 35.991,
      "end": 38.211
    },
    {
      "id": "shot04-15",
      "text": "流浪地球 2、",
      "start": 38.211,
      "end": 39.211
    },
    {
      "id": "shot04-16",
      "text": "泰坦尼克这些点离得近，",
      "start": 39.211,
      "end": 40.871
    },
    {
      "id": "shot04-17",
      "text": "跟上海堡垒离得远——位置关系直接对应距离大小。",
      "start": 40.871,
      "end": 45.06
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "公式讲完，",
      "start": 0.0,
      "end": 0.7
    },
    {
      "id": "shot05-1",
      "text": "我们打开一个 marimo 互动",
      "start": 0.7,
      "end": 2.48
    },
    {
      "id": "shot05-2",
      "text": "demo 把它玩起来。",
      "start": 2.48,
      "end": 3.94
    },
    {
      "id": "shot05-3",
      "text": "屏幕上是一张二维散点图，",
      "start": 3.94,
      "end": 6.22
    },
    {
      "id": "shot05-4",
      "text": "横轴是评分，",
      "start": 6.22,
      "end": 7.36
    },
    {
      "id": "shot05-5",
      "text": "纵轴是主演吸引度。",
      "start": 7.36,
      "end": 9.153
    },
    {
      "id": "shot05-6",
      "text": "9 部历史电影散落其中——绿点是你喜欢过的，",
      "start": 9.153,
      "end": 12.94
    },
    {
      "id": "shot05-7",
      "text": "红点是你不喜欢的。",
      "start": 12.94,
      "end": 14.64
    },
    {
      "id": "shot05-8",
      "text": "蓝色菱形点就是要预测的新电影。",
      "start": 14.64,
      "end": 17.7
    },
    {
      "id": "shot05-9",
      "text": "它的坐标由下面三个滑块控制：评分、",
      "start": 17.7,
      "end": 21.06
    },
    {
      "id": "shot05-10",
      "text": "主演吸引度，",
      "start": 21.06,
      "end": 22.0
    },
    {
      "id": "shot05-11",
      "text": "还有 k 邻居数。",
      "start": 22.0,
      "end": 23.46
    },
    {
      "id": "shot05-12",
      "text": "从蓝菱形出发的黄色虚线，",
      "start": 23.46,
      "end": 25.86
    },
    {
      "id": "shot05-13",
      "text": "连到的就是离它最近的 k 个邻居，",
      "start": 25.86,
      "end": 28.34
    },
    {
      "id": "shot05-14",
      "text": "灰色虚线是其他更远的。",
      "start": 28.34,
      "end": 30.4
    },
    {
      "id": "shot05-15",
      "text": "下面那张距离明细表按距离从小到大排序，",
      "start": 30.709,
      "end": 34.752
    },
    {
      "id": "shot05-16",
      "text": "前 k 行黄色高亮。",
      "start": 34.752,
      "end": 36.654
    },
    {
      "id": "shot05-17",
      "text": "最上面的色条实时显示预测结果。",
      "start": 36.654,
      "end": 39.616
    },
    {
      "id": "shot05-18",
      "text": "我们把评分调到 8.5，",
      "start": 39.616,
      "end": 41.758
    },
    {
      "id": "shot05-19",
      "text": "主演调到 9.5——这正是上一节豆瓣手算的题目。",
      "start": 41.758,
      "end": 46.101
    },
    {
      "id": "shot05-20",
      "text": "k 取 5，看：",
      "start": 46.101,
      "end": 47.582
    },
    {
      "id": "shot05-21",
      "text": "5 个最近邻全是绿点，",
      "start": 47.582,
      "end": 49.584
    },
    {
      "id": "shot05-22",
      "text": "距离从 0.30 到 1.58，",
      "start": 49.584,
      "end": 52.106
    },
    {
      "id": "shot05-23",
      "text": "5 票全喜欢，",
      "start": 52.106,
      "end": 53.427
    },
    {
      "id": "shot05-24",
      "text": "预测会喜欢。",
      "start": 53.427,
      "end": 55.069
    },
    {
      "id": "shot05-25",
      "text": "现在把新电影拖到上海堡垒那个角落，",
      "start": 55.069,
      "end": 58.182
    },
    {
      "id": "shot05-26",
      "text": "评分 2.9、",
      "start": 58.182,
      "end": 59.427
    },
    {
      "id": "shot05-27",
      "text": "主演 3.5，",
      "start": 59.427,
      "end": 60.612
    },
    {
      "id": "shot05-28",
      "text": "颜色立刻翻红——5 个邻居里 4 个是不喜欢，",
      "start": 60.612,
      "end": 64.368
    },
    {
      "id": "shot05-29",
      "text": "足够把预测压成不喜欢。",
      "start": 64.368,
      "end": 66.115
    },
    {
      "id": "shot05-30",
      "text": "再把 k 调到 1，",
      "start": 66.623,
      "end": 68.083
    },
    {
      "id": "shot05-31",
      "text": "整张图就只听最近那一个邻居的——稳定性完",
      "start": 68.083,
      "end": 71.513
    },
    {
      "id": "shot05-32",
      "text": "全依赖那一个点。",
      "start": 71.513,
      "end": 72.703
    },
    {
      "id": "shot05-33",
      "text": "这就是 KNN 在二维空间最直观的样子。",
      "start": 72.703,
      "end": 75.563
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "继续加特征：",
      "start": 0.0,
      "end": 1.22
    },
    {
      "id": "shot06-1",
      "text": "题材匹配度、",
      "start": 1.22,
      "end": 2.3
    },
    {
      "id": "shot06-2",
      "text": "导演风格、视效分、",
      "start": 2.3,
      "end": 3.92
    },
    {
      "id": "shot06-3",
      "text": "剧情深度……每部电影从二维点变成 5 维、10 维、N 维点。",
      "start": 3.92,
      "end": 8.44
    },
    {
      "id": "shot06-4",
      "text": "这里的维度，",
      "start": 8.44,
      "end": 9.3
    },
    {
      "id": "shot06-5",
      "text": "英文叫 dimension。",
      "start": 9.3,
      "end": 10.84
    },
    {
      "id": "shot06-6",
      "text": "公式同源——每多一维，",
      "start": 10.84,
      "end": 12.8
    },
    {
      "id": "shot06-7",
      "text": "就加一项平方，最后开方。",
      "start": 12.8,
      "end": 14.92
    },
    {
      "id": "shot06-8",
      "text": "这个公式有个正式名字：",
      "start": 14.92,
      "end": 17.38
    },
    {
      "id": "shot06-9",
      "text": "欧氏距离 Euclidean",
      "start": 17.38,
      "end": 19.22
    },
    {
      "id": "shot06-10",
      "text": "distance，",
      "start": 19.22,
      "end": 19.5
    },
    {
      "id": "shot06-11",
      "text": "是机器学习里最常用的距离度量。",
      "start": 19.5,
      "end": 22.34
    },
    {
      "id": "shot06-12",
      "text": "它就是直线距离，4 维、10 维，",
      "start": 22.617,
      "end": 24.817
    },
    {
      "id": "shot06-13",
      "text": "甚至 768 维的 embedding",
      "start": 24.817,
      "end": 26.817
    },
    {
      "id": "shot06-14",
      "text": "向量——这里 embedding 是",
      "start": 26.817,
      "end": 28.237
    },
    {
      "id": "shot06-15",
      "text": "AI 把一段文本变成的高维数字向量，",
      "start": 28.237,
      "end": 31.077
    },
    {
      "id": "shot06-16",
      "text": "后面的章节会专门讲，",
      "start": 31.077,
      "end": 32.897
    },
    {
      "id": "shot06-17",
      "text": "全都用这同一个公式。",
      "start": 32.897,
      "end": 34.977
    },
    {
      "id": "shot06-18",
      "text": "但这里有个有趣的反差：",
      "start": 34.977,
      "end": 36.777
    },
    {
      "id": "shot06-19",
      "text": "我们人脑画图最多到三维，",
      "start": 36.777,
      "end": 39.457
    },
    {
      "id": "shot06-20",
      "text": "4 维以上根本想象不出来，",
      "start": 39.457,
      "end": 41.577
    },
    {
      "id": "shot06-21",
      "text": "心里“哪部最像”这种直觉就开始模糊了。",
      "start": 41.577,
      "end": 44.677
    },
    {
      "id": "shot06-22",
      "text": "但 KNN 不在乎，",
      "start": 44.677,
      "end": 46.207
    },
    {
      "id": "shot06-23",
      "text": "它只看数字。",
      "start": 46.207,
      "end": 47.437
    },
    {
      "id": "shot06-24",
      "text": "人脑失灵的地方，",
      "start": 47.437,
      "end": 48.677
    },
    {
      "id": "shot06-25",
      "text": "正是 KNN 接管的地方。",
      "start": 48.677,
      "end": 50.497
    },
    {
      "id": "shot06-26",
      "text": "这也是 KNN 的实用价值：",
      "start": 50.845,
      "end": 52.845
    },
    {
      "id": "shot06-27",
      "text": "任何能用一组数字描述的东西——电影、用户画像、商品、",
      "start": 52.845,
      "end": 57.385
    },
    {
      "id": "shot06-28",
      "text": "文本 embedding——都能用",
      "start": 57.385,
      "end": 58.985
    },
    {
      "id": "shot06-29",
      "text": "KNN 处理。",
      "start": 58.985,
      "end": 59.785
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "刚才 demo 里 5 个邻居的距离 0.30、0.51、1.00、1.02、1.58，",
      "start": 0.0,
      "end": 5.32
    },
    {
      "id": "shot07-1",
      "text": "这些数字怎么来的？",
      "start": 5.32,
      "end": 6.7
    },
    {
      "id": "shot07-2",
      "text": "我们用纸笔走一遍公式，",
      "start": 6.7,
      "end": 8.54
    },
    {
      "id": "shot07-3",
      "text": "让你看清每一步。题目：",
      "start": 8.54,
      "end": 10.62
    },
    {
      "id": "shot07-4",
      "text": "9 部已知电影 + 流浪地球 3 待预测，",
      "start": 10.62,
      "end": 13.58
    },
    {
      "id": "shot07-5",
      "text": "K 取 5。第一步，",
      "start": 13.58,
      "end": 15.36
    },
    {
      "id": "shot07-6",
      "text": "算 10 号到前 9 部的欧式距离，",
      "start": 15.36,
      "end": 18.08
    },
    {
      "id": "shot07-7",
      "text": "公式是横向差平方加纵向差平方再开方。",
      "start": 18.08,
      "end": 21.68
    },
    {
      "id": "shot07-8",
      "text": "流浪地球 3 是 8.5 和 9.5。",
      "start": 21.68,
      "end": 24.46
    },
    {
      "id": "shot07-9",
      "text": "到流浪地球 2，",
      "start": 24.46,
      "end": 25.627
    },
    {
      "id": "shot07-10",
      "text": "8.4 和 9.0：",
      "start": 25.627,
      "end": 27.24
    },
    {
      "id": "shot07-11",
      "text": "差是 0.1 和 0.5。",
      "start": 27.24,
      "end": 28.957
    },
    {
      "id": "shot07-12",
      "text": "平方分别是 0.01 和 0.25，",
      "start": 29.157,
      "end": 31.697
    },
    {
      "id": "shot07-13",
      "text": "加起来 0.26，",
      "start": 31.697,
      "end": 33.357
    },
    {
      "id": "shot07-14",
      "text": "开方约等于 0.51。",
      "start": 33.357,
      "end": 35.577
    },
    {
      "id": "shot07-15",
      "text": "到复仇者联盟 4，",
      "start": 35.577,
      "end": 37.037
    },
    {
      "id": "shot07-16",
      "text": "8.5 和 9.2：",
      "start": 37.037,
      "end": 38.377
    },
    {
      "id": "shot07-17",
      "text": "差是 0 和 0.3，",
      "start": 38.377,
      "end": 40.057
    },
    {
      "id": "shot07-18",
      "text": "平方加起来 0.09，",
      "start": 40.057,
      "end": 41.997
    },
    {
      "id": "shot07-19",
      "text": "开方 0.30——这是 demo 里最近的那一个。",
      "start": 41.997,
      "end": 45.477
    },
    {
      "id": "shot07-20",
      "text": "到上海堡垒，",
      "start": 45.477,
      "end": 46.537
    },
    {
      "id": "shot07-21",
      "text": "2.9 和 3.5：",
      "start": 46.537,
      "end": 47.797
    },
    {
      "id": "shot07-22",
      "text": "差是 5.6 和 6.0，",
      "start": 47.797,
      "end": 49.537
    },
    {
      "id": "shot07-23",
      "text": "平方是 31.36 和 36，",
      "start": 49.537,
      "end": 51.977
    },
    {
      "id": "shot07-24",
      "text": "距离 8.21——一下被甩开。",
      "start": 51.977,
      "end": 54.417
    },
    {
      "id": "shot07-25",
      "text": "9 个距离全算出来。第二步，升序排序。",
      "start": 54.417,
      "end": 57.557
    },
    {
      "id": "shot07-26",
      "text": "最近的前 5 部依次是：",
      "start": 57.999,
      "end": 59.739
    },
    {
      "id": "shot07-27",
      "text": "复仇者 0.30、",
      "start": 59.739,
      "end": 61.179
    },
    {
      "id": "shot07-28",
      "text": "流浪地球 2 0.51、",
      "start": 61.179,
      "end": 62.699
    },
    {
      "id": "shot07-29",
      "text": "泰坦尼克 1.00、",
      "start": 62.699,
      "end": 63.999
    },
    {
      "id": "shot07-30",
      "text": "阿凡达 1.02、",
      "start": 63.999,
      "end": 65.359
    },
    {
      "id": "shot07-31",
      "text": "沙丘 2 1.58。",
      "start": 65.359,
      "end": 66.799
    },
    {
      "id": "shot07-32",
      "text": "后面 4 部是：",
      "start": 66.799,
      "end": 67.759
    },
    {
      "id": "shot07-33",
      "text": "长津湖 1.86，",
      "start": 67.759,
      "end": 69.299
    },
    {
      "id": "shot07-34",
      "text": "寒战 3.16，",
      "start": 69.299,
      "end": 70.579
    },
    {
      "id": "shot07-35",
      "text": "哥斯拉 3.27，",
      "start": 70.579,
      "end": 71.799
    },
    {
      "id": "shot07-36",
      "text": "最远是上海堡垒 8.21。第三步，",
      "start": 71.799,
      "end": 74.919
    },
    {
      "id": "shot07-37",
      "text": "K=5 取前 5 名投票：",
      "start": 74.919,
      "end": 77.069
    },
    {
      "id": "shot07-38",
      "text": "5 部全是喜欢标签——5 票喜欢，",
      "start": 77.069,
      "end": 79.546
    },
    {
      "id": "shot07-39",
      "text": "0 票不喜欢。结论：",
      "start": 79.546,
      "end": 80.959
    },
    {
      "id": "shot07-40",
      "text": "流浪地球 3 预测为喜欢。",
      "start": 80.959,
      "end": 82.779
    },
    {
      "id": "shot07-41",
      "text": "这就是 KNN 在二维空间的完整流程：算距离、排序、取前 K、",
      "start": 83.2,
      "end": 88.84
    },
    {
      "id": "shot07-42",
      "text": "多数表决，",
      "start": 88.84,
      "end": 90.0
    },
    {
      "id": "shot07-43",
      "text": "英文叫 majority vote。",
      "start": 90.0,
      "end": 91.791
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.4
    },
    {
      "id": "shot08-1",
      "text": "我们解决了 KNN 的第一个核心问题——",
      "start": 1.4,
      "end": 3.98
    },
    {
      "id": "shot08-2",
      "text": "距离怎么算：",
      "start": 3.98,
      "end": 5.6
    },
    {
      "id": "shot08-3",
      "text": "欧氏距离，",
      "start": 5.6,
      "end": 7.22
    },
    {
      "id": "shot08-4",
      "text": "从一维数字差到 N 维平方和开方，",
      "start": 7.22,
      "end": 10.62
    },
    {
      "id": "shot08-5",
      "text": "公式同源。",
      "start": 10.62,
      "end": 12.02
    },
    {
      "id": "shot08-6",
      "text": "同时引入了一组基础术语，包括样本、",
      "start": 12.02,
      "end": 15.6
    },
    {
      "id": "shot08-7",
      "text": "训练样本 / 测试样本、特征空间、类别、K、超参数、维度、",
      "start": 15.6,
      "end": 20.24
    },
    {
      "id": "shot08-8",
      "text": "多数表决。",
      "start": 20.24,
      "end": 21.68
    },
    {
      "id": "shot08-9",
      "text": "过程里点到但没展开的：",
      "start": 21.68,
      "end": 23.84
    },
    {
      "id": "shot08-10",
      "text": "embedding 这种 AI 高维数字",
      "start": 23.84,
      "end": 25.98
    },
    {
      "id": "shot08-11",
      "text": "向量留给后续专题；",
      "start": 25.98,
      "end": 27.94
    },
    {
      "id": "shot08-12",
      "text": "其他距离度量比如曼哈顿、切比雪夫、",
      "start": 27.94,
      "end": 30.925
    },
    {
      "id": "shot08-13",
      "text": "闵可夫斯基，",
      "start": 30.925,
      "end": 32.0
    },
    {
      "id": "shot08-14",
      "text": "留给本章第 3 节距离度量专章。",
      "start": 32.0,
      "end": 34.54
    },
    {
      "id": "shot08-15",
      "text": "下一期我们解决第二个核心问题：",
      "start": 34.943,
      "end": 37.403
    },
    {
      "id": "shot08-16",
      "text": "K 取多少？",
      "start": 37.403,
      "end": 38.683
    },
    {
      "id": "shot08-17",
      "text": "K 太小会怎样、",
      "start": 38.683,
      "end": 39.923
    },
    {
      "id": "shot08-18",
      "text": "太大会怎样、",
      "start": 39.923,
      "end": 40.983
    },
    {
      "id": "shot08-19",
      "text": "怎么选最合适的 K——一次性回答。",
      "start": 40.983,
      "end": 43.943
    },
    {
      "id": "shot08-20",
      "text": "如果讲得有不对的地方，",
      "start": 43.943,
      "end": 45.903
    },
    {
      "id": "shot08-21",
      "text": "欢迎在评论区指正。下期见。",
      "start": 45.903,
      "end": 48.361
    }
  ]
}
