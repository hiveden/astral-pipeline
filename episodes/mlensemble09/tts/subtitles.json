{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "GBDT 的概念已经有了：",
      "start": 0.0,
      "end": 1.482
    },
    {
      "id": "shot01-1",
      "text": "先给一个初始预测，",
      "start": 1.482,
      "end": 2.844
    },
    {
      "id": "shot01-2",
      "text": "再让每棵树拟合上一轮的负梯度。",
      "start": 2.844,
      "end": 5.127
    },
    {
      "id": "shot01-3",
      "text": "在平方损失下，",
      "start": 5.127,
      "end": 6.209
    },
    {
      "id": "shot01-4",
      "text": "这个负梯度就是残差。",
      "start": 6.209,
      "end": 7.771
    },
    {
      "id": "shot01-5",
      "text": "可如果只停在这句话，",
      "start": 7.771,
      "end": 9.253
    },
    {
      "id": "shot01-6",
      "text": "很多细节还是空的。",
      "start": 9.253,
      "end": 10.695
    },
    {
      "id": "shot01-7",
      "text": "残差表怎么来？",
      "start": 10.695,
      "end": 11.857
    },
    {
      "id": "shot01-8",
      "text": "每棵 CART 回归树怎么选切分点？",
      "start": 11.857,
      "end": 14.521
    },
    {
      "id": "shot01-9",
      "text": "叶子值为什么是残差均值？",
      "start": 14.521,
      "end": 16.444
    },
    {
      "id": "shot01-10",
      "text": "预测值又怎么一轮一轮更新？",
      "start": 16.444,
      "end": 18.627
    },
    {
      "id": "shot01-11",
      "text": "这一期我们把 GBDT 当成一张逐轮修错",
      "start": 18.627,
      "end": 21.431
    },
    {
      "id": "shot01-12",
      "text": "账本来手算。",
      "start": 21.431,
      "end": 22.132
    },
    {
      "id": "shot01-13",
      "text": "先用 5 个学习时长样本走通两轮，",
      "start": 22.503,
      "end": 25.469
    },
    {
      "id": "shot01-14",
      "text": "再回到主线 10 样本，",
      "start": 25.469,
      "end": 27.193
    },
    {
      "id": "shot01-15",
      "text": "核对初始均值 7.31、",
      "start": 27.193,
      "end": 29.397
    },
    {
      "id": "shot01-16",
      "text": "第一棵树切分点 6.5，",
      "start": 29.397,
      "end": 31.421
    },
    {
      "id": "shot01-17",
      "text": "以及 x 等于 6 时最终预测 6.61",
      "start": 31.421,
      "end": 34.487
    },
    {
      "id": "shot01-18",
      "text": "这个结果。",
      "start": 34.487,
      "end": 35.289
    },
    {
      "id": "shot01-19",
      "text": "看完以后，",
      "start": 35.289,
      "end": 36.391
    },
    {
      "id": "shot01-20",
      "text": "GBDT 不再是一串公式，",
      "start": 36.391,
      "end": 38.415
    },
    {
      "id": "shot01-21",
      "text": "而是一张能逐列更新的表。",
      "start": 38.415,
      "end": 40.459
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先用最小例子建立流程。",
      "start": 0.0,
      "end": 2.002
    },
    {
      "id": "shot02-1",
      "text": "假设有 5 个年级，",
      "start": 2.002,
      "end": 3.503
    },
    {
      "id": "shot02-2",
      "text": "学习时长分别是 5、6、7、8、",
      "start": 3.503,
      "end": 5.925
    },
    {
      "id": "shot02-3",
      "text": "9 小时。",
      "start": 5.925,
      "end": 6.686
    },
    {
      "id": "shot02-4",
      "text": "平方损失下，",
      "start": 6.686,
      "end": 7.847
    },
    {
      "id": "shot02-5",
      "text": "GBDT 的初始预测选目标值均值。",
      "start": 7.847,
      "end": 10.89
    },
    {
      "id": "shot02-6",
      "text": "5 个数的均值是 7，",
      "start": 10.89,
      "end": 12.632
    },
    {
      "id": "shot02-7",
      "text": "所以第 0 轮所有样本的预测都是 7。",
      "start": 12.632,
      "end": 16.135
    },
    {
      "id": "shot02-8",
      "text": "年级 1 的真实值是 5，",
      "start": 16.135,
      "end": 18.257
    },
    {
      "id": "shot02-9",
      "text": "残差是 5 减 7，",
      "start": 18.257,
      "end": 19.798
    },
    {
      "id": "shot02-10",
      "text": "等于负 2；",
      "start": 19.798,
      "end": 20.779
    },
    {
      "id": "shot02-11",
      "text": "年级 2 的残差是负 1；",
      "start": 20.779,
      "end": 22.784
    },
    {
      "id": "shot02-12",
      "text": "年级 3 的残差是 0；",
      "start": 22.784,
      "end": 24.648
    },
    {
      "id": "shot02-13",
      "text": "年级 4 是正 1；",
      "start": 24.648,
      "end": 26.252
    },
    {
      "id": "shot02-14",
      "text": "年级 5 是正 2。",
      "start": 26.252,
      "end": 27.796
    },
    {
      "id": "shot02-15",
      "text": "第一棵树要学的不是原始学习时长，",
      "start": 27.796,
      "end": 30.563
    },
    {
      "id": "shot02-16",
      "text": "而是这一列残差。",
      "start": 30.563,
      "end": 31.685
    },
    {
      "id": "shot02-17",
      "text": "图上可以画一条 y 等于 7 的水平线：",
      "start": 32.256,
      "end": 34.985
    },
    {
      "id": "shot02-18",
      "text": "左边两个点在水平线下方，",
      "start": 34.985,
      "end": 37.012
    },
    {
      "id": "shot02-19",
      "text": "说明被高估；",
      "start": 37.012,
      "end": 38.236
    },
    {
      "id": "shot02-20",
      "text": "右边两个点在水平线上方，",
      "start": 38.236,
      "end": 40.243
    },
    {
      "id": "shot02-21",
      "text": "说明被低估。",
      "start": 40.243,
      "end": 40.965
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "现在用残差作为目标，",
      "start": 0.0,
      "end": 1.662
    },
    {
      "id": "shot03-1",
      "text": "训练一棵只有一个切分点的 CART 回归",
      "start": 1.662,
      "end": 4.345
    },
    {
      "id": "shot03-2",
      "text": "树。",
      "start": 4.345,
      "end": 4.745
    },
    {
      "id": "shot03-3",
      "text": "候选切分点是 1.5、2.5、3.5、",
      "start": 4.745,
      "end": 7.548
    },
    {
      "id": "shot03-4",
      "text": "4.5。",
      "start": 7.548,
      "end": 8.149
    },
    {
      "id": "shot03-5",
      "text": "每个切分点把样本分成左右两组，",
      "start": 8.149,
      "end": 10.691
    },
    {
      "id": "shot03-6",
      "text": "每组用组内残差均值作为叶子值，",
      "start": 10.691,
      "end": 13.554
    },
    {
      "id": "shot03-7",
      "text": "然后计算残差到叶子均值的误差平方和，",
      "start": 13.554,
      "end": 16.878
    },
    {
      "id": "shot03-8",
      "text": "也就是 SSE。",
      "start": 16.878,
      "end": 17.939
    },
    {
      "id": "shot03-9",
      "text": "以 2.5 为例，",
      "start": 18.637,
      "end": 19.959
    },
    {
      "id": "shot03-10",
      "text": "左边是年级 1 和 2，",
      "start": 19.959,
      "end": 21.661
    },
    {
      "id": "shot03-11",
      "text": "残差负 2、负 1，",
      "start": 21.661,
      "end": 23.123
    },
    {
      "id": "shot03-12",
      "text": "均值负 1.5，",
      "start": 23.123,
      "end": 24.465
    },
    {
      "id": "shot03-13",
      "text": "左边 SSE 是 0.5；",
      "start": 24.465,
      "end": 26.488
    },
    {
      "id": "shot03-14",
      "text": "右边是年级 3、4、5，残差 0、1、",
      "start": 26.488,
      "end": 29.011
    },
    {
      "id": "shot03-15",
      "text": "2，均值 1，",
      "start": 29.011,
      "end": 30.193
    },
    {
      "id": "shot03-16",
      "text": "右边 SSE 是 2。",
      "start": 30.193,
      "end": 32.015
    },
    {
      "id": "shot03-17",
      "text": "总 SSE 是 2.5。枚举后，",
      "start": 32.015,
      "end": 34.619
    },
    {
      "id": "shot03-18",
      "text": "1.5 和 4.5 的 SSE 都是 5，",
      "start": 34.619,
      "end": 37.342
    },
    {
      "id": "shot03-19",
      "text": "2.5 和 3.5 都是 2.5。",
      "start": 37.342,
      "end": 39.926
    },
    {
      "id": "shot03-20",
      "text": "按示例取 2.5，",
      "start": 39.926,
      "end": 41.448
    },
    {
      "id": "shot03-21",
      "text": "于是第一棵树左叶输出负 1.5，",
      "start": 41.448,
      "end": 44.131
    },
    {
      "id": "shot03-22",
      "text": "右叶输出正 1。",
      "start": 44.131,
      "end": 45.153
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "第一棵树训练好以后，",
      "start": 0.0,
      "end": 1.682
    },
    {
      "id": "shot04-1",
      "text": "把它的输出加到原来的预测上。",
      "start": 1.682,
      "end": 4.045
    },
    {
      "id": "shot04-2",
      "text": "年级 1 和 2 走左叶，",
      "start": 4.045,
      "end": 6.067
    },
    {
      "id": "shot04-3",
      "text": "原来预测 7，",
      "start": 6.067,
      "end": 7.028
    },
    {
      "id": "shot04-4",
      "text": "加上负 1.5，",
      "start": 7.028,
      "end": 8.189
    },
    {
      "id": "shot04-5",
      "text": "变成 5.5。年级 3、4、",
      "start": 8.189,
      "end": 10.392
    },
    {
      "id": "shot04-6",
      "text": "5 走右叶，",
      "start": 10.392,
      "end": 11.333
    },
    {
      "id": "shot04-7",
      "text": "原来预测 7，",
      "start": 11.333,
      "end": 12.274
    },
    {
      "id": "shot04-8",
      "text": "加上正 1，",
      "start": 12.274,
      "end": 12.975
    },
    {
      "id": "shot04-9",
      "text": "变成 8。",
      "start": 12.975,
      "end": 14.076
    },
    {
      "id": "shot04-10",
      "text": "再用真实值减新预测，",
      "start": 14.076,
      "end": 16.038
    },
    {
      "id": "shot04-11",
      "text": "就得到新残差：",
      "start": 16.038,
      "end": 17.16
    },
    {
      "id": "shot04-12",
      "text": "年级 1 是负 0.5，",
      "start": 17.16,
      "end": 18.761
    },
    {
      "id": "shot04-13",
      "text": "年级 2 是正 0.5，",
      "start": 18.761,
      "end": 20.343
    },
    {
      "id": "shot04-14",
      "text": "年级 3 是负 1，",
      "start": 20.343,
      "end": 21.545
    },
    {
      "id": "shot04-15",
      "text": "年级 4 是 0，",
      "start": 21.545,
      "end": 22.506
    },
    {
      "id": "shot04-16",
      "text": "年级 5 是正 1。你会发现，",
      "start": 22.506,
      "end": 24.508
    },
    {
      "id": "shot04-17",
      "text": "残差整体变小了，",
      "start": 24.508,
      "end": 25.99
    },
    {
      "id": "shot04-18",
      "text": "但不是每个点都立刻变好。",
      "start": 25.99,
      "end": 27.712
    },
    {
      "id": "shot04-19",
      "text": "年级 3 原来残差是 0，",
      "start": 28.225,
      "end": 30.311
    },
    {
      "id": "shot04-20",
      "text": "第一棵树之后反而变成负 1。这很正常，",
      "start": 30.311,
      "end": 33.842
    },
    {
      "id": "shot04-21",
      "text": "因为一棵浅树只能做粗糙分段。",
      "start": 33.842,
      "end": 36.51
    },
    {
      "id": "shot04-22",
      "text": "GBDT 的思路不是一棵树解决全部，",
      "start": 36.51,
      "end": 39.379
    },
    {
      "id": "shot04-23",
      "text": "而是下一棵树继续修新残差。",
      "start": 39.379,
      "end": 41.605
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "第二棵树从新残差出发，",
      "start": 0.0,
      "end": 2.002
    },
    {
      "id": "shot05-1",
      "text": "重复同一套枚举。",
      "start": 2.002,
      "end": 3.604
    },
    {
      "id": "shot05-2",
      "text": "严格按 SSE 复算，",
      "start": 3.604,
      "end": 5.566
    },
    {
      "id": "shot05-3",
      "text": "第二棵树最优切分点是 4.5。",
      "start": 5.566,
      "end": 7.829
    },
    {
      "id": "shot05-4",
      "text": "左边年级 1、2、3、",
      "start": 7.829,
      "end": 9.29
    },
    {
      "id": "shot05-5",
      "text": "4 的新残差是负 0.5、",
      "start": 9.29,
      "end": 11.432
    },
    {
      "id": "shot05-6",
      "text": "正 0.5、负 1、0，",
      "start": 11.432,
      "end": 12.934
    },
    {
      "id": "shot05-7",
      "text": "均值是负 0.25；",
      "start": 12.934,
      "end": 14.536
    },
    {
      "id": "shot05-8",
      "text": "右边只有年级 5，",
      "start": 14.536,
      "end": 16.017
    },
    {
      "id": "shot05-9",
      "text": "新残差是正 1，",
      "start": 16.017,
      "end": 17.259
    },
    {
      "id": "shot05-10",
      "text": "所以叶子值是 1。更新后，",
      "start": 17.259,
      "end": 19.461
    },
    {
      "id": "shot05-11",
      "text": "年级 1 的预测从 5.5 变成 5.",
      "start": 19.461,
      "end": 21.784
    },
    {
      "id": "shot05-12",
      "text": "25，",
      "start": 21.784,
      "end": 22.244
    },
    {
      "id": "shot05-13",
      "text": "年级 4 从 8 变成 7.75，",
      "start": 22.244,
      "end": 24.527
    },
    {
      "id": "shot05-14",
      "text": "年级 5 从 8 变成 9。",
      "start": 24.527,
      "end": 26.249
    },
    {
      "id": "shot05-15",
      "text": "残差不是直线归零，",
      "start": 26.249,
      "end": 27.81
    },
    {
      "id": "shot05-16",
      "text": "而是一轮一轮被压小。",
      "start": 27.81,
      "end": 29.092
    },
    {
      "id": "shot05-17",
      "text": "动画上可以把每轮残差柱画成账本：",
      "start": 29.52,
      "end": 32.351
    },
    {
      "id": "shot05-18",
      "text": "第 0 轮平均绝对残差是 1.2，",
      "start": 32.351,
      "end": 34.941
    },
    {
      "id": "shot05-19",
      "text": "第一轮约 0.6，",
      "start": 34.941,
      "end": 36.286
    },
    {
      "id": "shot05-20",
      "text": "第二轮约 0.40，",
      "start": 36.286,
      "end": 37.893
    },
    {
      "id": "shot05-21",
      "text": "后面继续下降。",
      "start": 37.893,
      "end": 38.816
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "再回到 10 样本主线。",
      "start": 0.0,
      "end": 1.62
    },
    {
      "id": "shot06-1",
      "text": "这里的目标值是 5.56、5.70、",
      "start": 1.62,
      "end": 3.901
    },
    {
      "id": "shot06-2",
      "text": "5.91，",
      "start": 3.901,
      "end": 4.961
    },
    {
      "id": "shot06-3",
      "text": "一直到 9.05。",
      "start": 4.961,
      "end": 6.382
    },
    {
      "id": "shot06-4",
      "text": "初始化常数是目标均值 7.31。",
      "start": 6.382,
      "end": 9.202
    },
    {
      "id": "shot06-5",
      "text": "第一轮残差就是每个 y 减 7.31，",
      "start": 9.202,
      "end": 12.223
    },
    {
      "id": "shot06-6",
      "text": "比如 x 等于 1 的残差是负 1.75，",
      "start": 12.223,
      "end": 15.344
    },
    {
      "id": "shot06-7",
      "text": "x 等于 10 的残差是正 1.74。",
      "start": 15.344,
      "end": 18.505
    },
    {
      "id": "shot06-8",
      "text": "第一棵树枚举切分点后，",
      "start": 18.505,
      "end": 20.405
    },
    {
      "id": "shot06-9",
      "text": "最优切分点是 6.5。",
      "start": 20.405,
      "end": 22.046
    },
    {
      "id": "shot06-10",
      "text": "左叶残差均值约负 1.07，",
      "start": 22.046,
      "end": 24.347
    },
    {
      "id": "shot06-11",
      "text": "右叶约正 1.60。",
      "start": 24.347,
      "end": 26.088
    },
    {
      "id": "shot06-12",
      "text": "第二棵树在新残差上继续训练，",
      "start": 26.088,
      "end": 28.726
    },
    {
      "id": "shot06-13",
      "text": "示例最优切分点是 3.5。",
      "start": 28.726,
      "end": 30.227
    },
    {
      "id": "shot06-14",
      "text": "第三棵树再次更新，",
      "start": 30.713,
      "end": 32.337
    },
    {
      "id": "shot06-15",
      "text": "切分点回到 6.5。",
      "start": 32.337,
      "end": 33.961
    },
    {
      "id": "shot06-16",
      "text": "以 x 等于 6 的样本为例，",
      "start": 33.961,
      "end": 36.046
    },
    {
      "id": "shot06-17",
      "text": "最终预测是 7.31 加负 1.07，",
      "start": 36.046,
      "end": 39.254
    },
    {
      "id": "shot06-18",
      "text": "再加 0.22，",
      "start": 39.254,
      "end": 40.457
    },
    {
      "id": "shot06-19",
      "text": "再加 0.15，",
      "start": 40.457,
      "end": 41.5
    },
    {
      "id": "shot06-20",
      "text": "等于 6.61。",
      "start": 41.5,
      "end": 42.703
    },
    {
      "id": "shot06-21",
      "text": "真实值是 7.05，",
      "start": 42.703,
      "end": 44.307
    },
    {
      "id": "shot06-22",
      "text": "残差还剩 0.44，",
      "start": 44.307,
      "end": 46.212
    },
    {
      "id": "shot06-23",
      "text": "继续迭代还能更接近。",
      "start": 46.212,
      "end": 47.836
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这套手算要抓住 4 个动作。第一，",
      "start": 0.0,
      "end": 2.341
    },
    {
      "id": "shot07-1",
      "text": "初始化不是随便猜，",
      "start": 2.341,
      "end": 3.901
    },
    {
      "id": "shot07-2",
      "text": "平方损失下用均值。第二，",
      "start": 3.901,
      "end": 6.042
    },
    {
      "id": "shot07-3",
      "text": "每一轮都重新计算残差，",
      "start": 6.042,
      "end": 8.083
    },
    {
      "id": "shot07-4",
      "text": "下一棵树的训练目标是新残差，",
      "start": 8.083,
      "end": 10.424
    },
    {
      "id": "shot07-5",
      "text": "不是原始 y。第三，",
      "start": 10.424,
      "end": 12.164
    },
    {
      "id": "shot07-6",
      "text": "CART 回归树选切分点时，",
      "start": 12.164,
      "end": 14.645
    },
    {
      "id": "shot07-7",
      "text": "叶子输出是组内残差均值，",
      "start": 14.645,
      "end": 16.846
    },
    {
      "id": "shot07-8",
      "text": "评判标准是 SSE 最小。第四，",
      "start": 16.846,
      "end": 19.849
    },
    {
      "id": "shot07-9",
      "text": "最终预测一定要把初始常数和每棵树的修正值",
      "start": 19.849,
      "end": 23.217
    },
    {
      "id": "shot07-10",
      "text": "全部加起来，",
      "start": 23.217,
      "end": 24.4
    },
    {
      "id": "shot07-11",
      "text": "不能漏掉 f0。",
      "start": 24.4,
      "end": 26.044
    },
    {
      "id": "shot07-12",
      "text": "训练时是逐轮残差表，",
      "start": 26.044,
      "end": 27.948
    },
    {
      "id": "shot07-13",
      "text": "推理时是新样本依次走过每棵树，",
      "start": 27.948,
      "end": 30.815
    },
    {
      "id": "shot07-14",
      "text": "把每个叶子值累加。",
      "start": 30.815,
      "end": 32.58
    },
    {
      "id": "shot07-15",
      "text": "回归手算到这里就完整了。",
      "start": 32.58,
      "end": 34.144
    },
    {
      "id": "shot07-16",
      "text": "下一期我们把损失从平方损失换成对数损失，",
      "start": 34.525,
      "end": 38.718
    },
    {
      "id": "shot07-17",
      "text": "用",
      "start": 38.718,
      "end": 38.898
    },
    {
      "id": "shot07-18",
      "text": "GradientBoostingClassifier",
      "start": 38.898,
      "end": 40.443
    },
    {
      "id": "shot07-19",
      "text": "跑泰坦尼克二分类。",
      "start": 40.443,
      "end": 42.088
    },
    {
      "id": "shot07-20",
      "text": "机制仍然是接力修正，",
      "start": 42.088,
      "end": 43.914
    },
    {
      "id": "shot07-21",
      "text": "只是残差表换成分类损失下的负梯度。",
      "start": 43.914,
      "end": 46.802
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "下期见，",
