{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们把 KNN 能用的 4 种距离",
      "start": 0.0,
      "end": 3.02
    },
    {
      "id": "shot01-1",
      "text": "都讲完了——欧氏、曼哈顿、切比雪夫、",
      "start": 3.02,
      "end": 6.232
    },
    {
      "id": "shot01-2",
      "text": "闵可夫斯基。",
      "start": 6.232,
      "end": 7.32
    },
    {
      "id": "shot01-3",
      "text": "4 个公式表面差异挺大，",
      "start": 7.32,
      "end": 9.54
    },
    {
      "id": "shot01-4",
      "text": "本质却共用一个动作：",
      "start": 9.54,
      "end": 11.54
    },
    {
      "id": "shot01-5",
      "text": "把每个维度的差异直接加起来。",
      "start": 11.54,
      "end": 14.54
    },
    {
      "id": "shot01-6",
      "text": "这一动作有一个问题——如果不同特征的数值",
      "start": 14.54,
      "end": 17.92
    },
    {
      "id": "shot01-7",
      "text": "范围差异大，",
      "start": 17.92,
      "end": 19.16
    },
    {
      "id": "shot01-8",
      "text": "加起来谁会赢？",
      "start": 19.16,
      "end": 20.2
    },
    {
      "id": "shot01-9",
      "text": "数值大的那个独裁。",
      "start": 20.2,
      "end": 21.98
    },
    {
      "id": "shot01-10",
      "text": "这一期我们用一个具体的健康预测案例把这件事讲透：",
      "start": 21.98,
      "end": 26.0
    },
    {
      "id": "shot01-11",
      "text": "为什么 KNN 用之前必须先缩放，",
      "start": 26.0,
      "end": 29.3
    },
    {
      "id": "shot01-12",
      "text": "到底是什么坏掉了。",
      "start": 29.3,
      "end": 30.64
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "我们换一个真实业务场景。",
      "start": 0.0,
      "end": 2.66
    },
    {
      "id": "shot02-1",
      "text": "假设你要做一个健康预测的小工具：",
      "start": 2.66,
      "end": 5.42
    },
    {
      "id": "shot02-2",
      "text": "输入一个人的身高、体重、视力，",
      "start": 5.42,
      "end": 7.78
    },
    {
      "id": "shot02-3",
      "text": "预测他是健康还是不健康。",
      "start": 7.78,
      "end": 10.46
    },
    {
      "id": "shot02-4",
      "text": "训练数据 8 个人。",
      "start": 10.46,
      "end": 12.42
    },
    {
      "id": "shot02-5",
      "text": "健康那 4 个人，",
      "start": 12.42,
      "end": 13.62
    },
    {
      "id": "shot02-6",
      "text": "身高大约 168 到 180 厘米之间，",
      "start": 13.62,
      "end": 17.06
    },
    {
      "id": "shot02-7",
      "text": "体重 65 到 78 公斤之间，",
      "start": 17.06,
      "end": 19.88
    },
    {
      "id": "shot02-8",
      "text": "视力 1.2 到 1.8。",
      "start": 19.88,
      "end": 21.74
    },
    {
      "id": "shot02-9",
      "text": "不健康那 4 个人特点很鲜明：",
      "start": 21.74,
      "end": 23.92
    },
    {
      "id": "shot02-10",
      "text": "体重明显偏重，",
      "start": 23.92,
      "end": 25.32
    },
    {
      "id": "shot02-11",
      "text": "从 92 公斤一直到 110 公斤；视力偏弱，",
      "start": 25.32,
      "end": 28.88
    },
    {
      "id": "shot02-12",
      "text": "0.3 到 0.6。",
      "start": 28.88,
      "end": 30.32
    },
    {
      "id": "shot02-13",
      "text": "这是一个标准的 KNN 题：",
      "start": 30.721,
      "end": 32.781
    },
    {
      "id": "shot02-14",
      "text": "来一个新人，",
      "start": 32.781,
      "end": 33.661
    },
    {
      "id": "shot02-15",
      "text": "找训练集里最像他的几个邻居，",
      "start": 33.661,
      "end": 36.481
    },
    {
      "id": "shot02-16",
      "text": "看邻居标签多数是什么。",
      "start": 36.481,
      "end": 38.401
    },
    {
      "id": "shot02-17",
      "text": "看着挺合理对吧。",
      "start": 38.401,
      "end": 39.641
    },
    {
      "id": "shot02-18",
      "text": "但有个细节：",
      "start": 39.641,
      "end": 40.801
    },
    {
      "id": "shot02-19",
      "text": "三个特征的数值范围完全不在一个尺度上。",
      "start": 40.801,
      "end": 44.481
    },
    {
      "id": "shot02-20",
      "text": "身高跨度 15、",
      "start": 44.481,
      "end": 45.941
    },
    {
      "id": "shot02-21",
      "text": "体重跨度 45、",
      "start": 45.941,
      "end": 47.441
    },
    {
      "id": "shot02-22",
      "text": "视力跨度只有 1.5。",
      "start": 47.441,
      "end": 49.081
    },
    {
      "id": "shot02-23",
      "text": "三个数字一比，",
      "start": 49.081,
      "end": 50.481
    },
    {
      "id": "shot02-24",
      "text": "体重的跨度是视力的 30 倍。",
      "start": 50.481,
      "end": 52.703
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "现在 KNN 真的算距离了。",
      "start": 0.0,
      "end": 2.26
    },
    {
      "id": "shot03-1",
      "text": "欧氏公式我们熟——三个维度差平方求和再开方。",
      "start": 2.26,
      "end": 6.42
    },
    {
      "id": "shot03-2",
      "text": "问题就出在平方求和这一步。",
      "start": 6.42,
      "end": 9.64
    },
    {
      "id": "shot03-3",
      "text": "来一个新人，",
      "start": 9.64,
      "end": 11.04
    },
    {
      "id": "shot03-4",
      "text": "假设他身高 175、",
      "start": 11.04,
      "end": 12.94
    },
    {
      "id": "shot03-5",
      "text": "体重 85、",
      "start": 12.94,
      "end": 14.12
    },
    {
      "id": "shot03-6",
      "text": "视力 1.7。",
      "start": 14.12,
      "end": 15.76
    },
    {
      "id": "shot03-7",
      "text": "算他到训练集第 1 个人——身高 175、",
      "start": 15.76,
      "end": 19.06
    },
    {
      "id": "shot03-8",
      "text": "体重 70、",
      "start": 19.06,
      "end": 19.96
    },
    {
      "id": "shot03-9",
      "text": "视力 1.5——的距离。",
      "start": 19.96,
      "end": 21.96
    },
    {
      "id": "shot03-10",
      "text": "三个差分别是 0、15、0.2。平方一下：0、225、0.04。",
      "start": 21.96,
      "end": 27.9
    },
    {
      "id": "shot03-11",
      "text": "注意看这一行：",
      "start": 27.9,
      "end": 29.96
    },
    {
      "id": "shot03-12",
      "text": "体重那一项是 225，",
      "start": 29.96,
      "end": 32.28
    },
    {
      "id": "shot03-13",
      "text": "视力那一项是 0.04。",
      "start": 32.28,
      "end": 34.14
    },
    {
      "id": "shot03-14",
      "text": "225 和 0.04 加起来约等于",
      "start": 34.896,
      "end": 37.616
    },
    {
      "id": "shot03-15",
      "text": "225——视力这一维等于不存在。",
      "start": 37.616,
      "end": 40.116
    },
    {
      "id": "shot03-16",
      "text": "再算他到第 5 个人——165、95、",
      "start": 40.116,
      "end": 43.436
    },
    {
      "id": "shot03-17",
      "text": "0.4：",
      "start": 43.436,
      "end": 44.576
    },
    {
      "id": "shot03-18",
      "text": "差是 10、10、1.3，",
      "start": 44.576,
      "end": 46.896
    },
    {
      "id": "shot03-19",
      "text": "平方是 100、100、1.69，",
      "start": 46.896,
      "end": 49.376
    },
    {
      "id": "shot03-20",
      "text": "依然是身高 + 体重那两项主导，",
      "start": 49.376,
      "end": 52.566
    },
    {
      "id": "shot03-21",
      "text": "视力的 1.69 完全沉底。",
      "start": 52.566,
      "end": 55.196
    },
    {
      "id": "shot03-22",
      "text": "一句话总结：",
      "start": 55.196,
      "end": 56.476
    },
    {
      "id": "shot03-23",
      "text": "欧氏距离里每个特征的隐式权重，",
      "start": 56.476,
      "end": 59.196
    },
    {
      "id": "shot03-24",
      "text": "等于这个特征数值范围的平方。",
      "start": 59.196,
      "end": 62.036
    },
    {
      "id": "shot03-25",
      "text": "体重跨度 45，",
      "start": 62.036,
      "end": 63.581
    },
    {
      "id": "shot03-26",
      "text": "权重 2025；",
      "start": 63.581,
      "end": 65.183
    },
    {
      "id": "shot03-27",
      "text": "视力跨度 1.5，",
      "start": 65.183,
      "end": 66.721
    },
    {
      "id": "shot03-28",
      "text": "权重 2.25。",
      "start": 66.721,
      "end": 67.916
    },
    {
      "id": "shot03-29",
      "text": "体重的权重是视力的 900 倍。",
      "start": 68.282,
      "end": 70.902
    },
    {
      "id": "shot03-30",
      "text": "所以 KNN 表面上在用 3 个特征找邻居，",
      "start": 70.902,
      "end": 74.222
    },
    {
      "id": "shot03-31",
      "text": "实际只在用体重——视力的差异在距离里几乎被忽略。",
      "start": 74.222,
      "end": 78.336
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "这里要澄清一个常见误解。",
      "start": 0.0,
      "end": 2.34
    },
    {
      "id": "shot04-1",
      "text": "很多人会说，",
      "start": 2.34,
      "end": 3.76
    },
    {
      "id": "shot04-2",
      "text": "量纲不一致那是不是说距离根本不能算？不是。",
      "start": 3.76,
      "end": 7.94
    },
    {
      "id": "shot04-3",
      "text": "距离公式照样能算——平方加开方数学上没毛病，",
      "start": 7.94,
      "end": 12.66
    },
    {
      "id": "shot04-4",
      "text": "结果也是一个数字。",
      "start": 12.66,
      "end": 14.54
    },
    {
      "id": "shot04-5",
      "text": "问题不在能不能算，",
      "start": 14.54,
      "end": 16.66
    },
    {
      "id": "shot04-6",
      "text": "在于算出来的距离反映了什么。",
      "start": 16.66,
      "end": 19.54
    },
    {
      "id": "shot04-7",
      "text": "理想中我们希望它反映三个特征综合下的相似度。",
      "start": 19.54,
      "end": 23.74
    },
    {
      "id": "shot04-8",
      "text": "但实际它只反映了那个数值跨度最大的特征。",
      "start": 23.74,
      "end": 27.78
    },
    {
      "id": "shot04-9",
      "text": "换个说法：",
      "start": 27.78,
      "end": 29.02
    },
    {
      "id": "shot04-10",
      "text": "KNN 默认假设所有特征同等重要。",
      "start": 29.02,
      "end": 32.3
    },
    {
      "id": "shot04-11",
      "text": "如果不缩放就直接喂数据，",
      "start": 32.708,
      "end": 35.188
    },
    {
      "id": "shot04-12",
      "text": "等于是在说体重的重要性是视力的 900",
      "start": 35.188,
      "end": 38.188
    },
    {
      "id": "shot04-13",
      "text": "倍——这个假设你从来没显式做过，",
      "start": 38.188,
      "end": 41.108
    },
    {
      "id": "shot04-14",
      "text": "是数据量纲偷偷替你做的决策。",
      "start": 41.108,
      "end": 44.108
    },
    {
      "id": "shot04-15",
      "text": "所以预处理的真正动机不是让公式跑得动，",
      "start": 44.108,
      "end": 47.848
    },
    {
      "id": "shot04-16",
      "text": "是把特征重要性从数值范围里解耦——先回到公平起点。",
      "start": 47.848,
      "end": 52.508
    },
    {
      "id": "shot04-17",
      "text": "要不要再显式给某个特征加权重，",
      "start": 52.508,
      "end": 55.408
    },
    {
      "id": "shot04-18",
      "text": "那是后续业务问题，",
      "start": 55.408,
      "end": 56.808
    },
    {
      "id": "shot04-19",
      "text": "不能让数据规模代你决定。",
      "start": 56.808,
      "end": 59.228
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "这件事直接打开 demo 看。",
      "start": 0.0,
      "end": 1.98
    },
    {
      "id": "shot05-1",
      "text": "沿用上面 8 个人——4 个健康在上半，",
      "start": 1.98,
      "end": 5.913
    },
    {
      "id": "shot05-2",
      "text": "4 个不健康在下半。",
      "start": 5.913,
      "end": 8.16
    },
    {
      "id": "shot05-3",
      "text": "新人定在体重 75 公斤、",
      "start": 8.16,
      "end": 11.02
    },
    {
      "id": "shot05-4",
      "text": "视力 1.7，",
      "start": 11.02,
      "end": 12.0
    },
    {
      "id": "shot05-5",
      "text": "一个偏瘦视力好的人，",
      "start": 12.0,
      "end": 14.04
    },
    {
      "id": "shot05-6",
      "text": "按常理应该跟健康组接近。",
      "start": 14.04,
      "end": 16.98
    },
    {
      "id": "shot05-7",
      "text": "看散点图：",
      "start": 16.98,
      "end": 18.54
    },
    {
      "id": "shot05-8",
      "text": "横轴体重，",
      "start": 18.54,
      "end": 19.78
    },
    {
      "id": "shot05-9",
      "text": "纵轴视力，",
      "start": 19.78,
      "end": 21.0
    },
    {
      "id": "shot05-10",
      "text": "新人是黑色五角星。",
      "start": 21.0,
      "end": 23.16
    },
    {
      "id": "shot05-11",
      "text": "三个最近邻 KNN 用黄圈标出来了，",
      "start": 23.16,
      "end": 26.44
    },
    {
      "id": "shot05-12",
      "text": "全是健康组的 1 号、4 号、2 号，",
      "start": 26.44,
      "end": 29.24
    },
    {
      "id": "shot05-13",
      "text": "预测健康。",
      "start": 29.24,
      "end": 31.1
    },
    {
      "id": "shot05-14",
      "text": "看右边距离公式拆分——体重项贡献 86%，",
      "start": 31.1,
      "end": 35.6
    },
    {
      "id": "shot05-15",
      "text": "红色长条几乎独占，",
      "start": 35.6,
      "end": 37.78
    },
    {
      "id": "shot05-16",
      "text": "视力项只有 0.1%，",
      "start": 37.78,
      "end": 39.78
    },
    {
      "id": "shot05-17",
      "text": "几乎没参与。",
      "start": 39.78,
      "end": 40.96
    },
    {
      "id": "shot05-18",
      "text": "现在做两个对比。",
      "start": 41.336,
      "end": 43.016
    },
    {
      "id": "shot05-19",
      "text": "第一个：",
      "start": 43.016,
      "end": 44.716
    },
    {
      "id": "shot05-20",
      "text": "拖视力滑块，",
      "start": 44.716,
      "end": 46.556
    },
    {
      "id": "shot05-21",
      "text": "从 1.7 一路拖到 0.3，",
      "start": 46.556,
      "end": 49.116
    },
    {
      "id": "shot05-22",
      "text": "视力急剧变差，",
      "start": 49.116,
      "end": 50.736
    },
    {
      "id": "shot05-23",
      "text": "从健康人变成几乎看不清的人。",
      "start": 50.736,
      "end": 53.516
    },
    {
      "id": "shot05-24",
      "text": "看 top-3 邻居——还是 1 号、4 号、2 号，没换。",
      "start": 53.516,
      "end": 57.796
    },
    {
      "id": "shot05-25",
      "text": "视力差从 0.2 跨到 1.4，",
      "start": 57.796,
      "end": 60.536
    },
    {
      "id": "shot05-26",
      "text": "平方贡献 1.96，",
      "start": 60.536,
      "end": 62.396
    },
    {
      "id": "shot05-27",
      "text": "对距离的贡献还是被体重碾压。第二个：",
      "start": 62.396,
      "end": 66.216
    },
    {
      "id": "shot05-28",
      "text": "视力调回 1.7，",
      "start": 66.216,
      "end": 67.776
    },
    {
      "id": "shot05-29",
      "text": "拖体重——只动 3 公斤，",
      "start": 67.776,
      "end": 69.776
    },
    {
      "id": "shot05-30",
      "text": "从 75 到 78。",
      "start": 69.776,
      "end": 71.336
    },
    {
      "id": "shot05-31",
      "text": "看 top-3——1 号被 2 号挤到第三，",
      "start": 71.336,
      "end": 74.036
    },
    {
      "id": "shot05-32",
      "text": "邻居重排了。",
      "start": 74.036,
      "end": 74.996
    },
    {
      "id": "shot05-33",
      "text": "体重差变化 3 公斤平方 9，",
      "start": 75.313,
      "end": 77.613
    },
    {
      "id": "shot05-34",
      "text": "已经足够撼动距离结构。一句话：",
      "start": 77.613,
      "end": 80.553
    },
    {
      "id": "shot05-35",
      "text": "视力大变邻居不变，",
      "start": 80.553,
      "end": 82.213
    },
    {
      "id": "shot05-36",
      "text": "体重微变邻居全换。",
      "start": 82.213,
      "end": 84.033
    },
    {
      "id": "shot05-37",
      "text": "这就是体重独裁的现场体感。",
      "start": 84.033,
      "end": 86.213
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "解决方向已经清楚了：",
      "start": 0.0,
      "end": 2.02
    },
    {
      "id": "shot06-1",
      "text": "把所有特征拉到同一把尺子上。",
      "start": 2.02,
      "end": 4.72
    },
    {
      "id": "shot06-2",
      "text": "具体怎么拉，",
      "start": 4.72,
      "end": 5.5
    },
    {
      "id": "shot06-3",
      "text": "主流有两种做法。",
      "start": 5.5,
      "end": 7.2
    },
    {
      "id": "shot06-4",
      "text": "第一种叫归一化，",
      "start": 7.2,
      "end": 8.52
    },
    {
      "id": "shot06-5",
      "text": "英文 Min-Max",
      "start": 8.52,
      "end": 9.58
    },
    {
      "id": "shot06-6",
      "text": "normalization——把每个特征",
      "start": 9.58,
      "end": 11.56
    },
    {
      "id": "shot06-7",
      "text": "压到一个固定区间，",
      "start": 11.56,
      "end": 13.08
    },
    {
      "id": "shot06-8",
      "text": "最常见是 0 到 1。",
      "start": 13.08,
      "end": 15.38
    },
    {
      "id": "shot06-9",
      "text": "每列各自看自己的最小最大值，",
      "start": 15.38,
      "end": 18.38
    },
    {
      "id": "shot06-10",
      "text": "做一次平移加缩放。",
      "start": 18.38,
      "end": 20.12
    },
    {
      "id": "shot06-11",
      "text": "第二种叫标准化，",
      "start": 20.489,
      "end": 21.989
    },
    {
      "id": "shot06-12",
      "text": "英文 Z-score",
      "start": 21.989,
      "end": 23.129
    },
    {
      "id": "shot06-13",
      "text": "standardization——不固定",
      "start": 23.129,
      "end": 24.809
    },
    {
      "id": "shot06-14",
      "text": "到 0 到 1 区间，",
      "start": 24.809,
      "end": 26.149
    },
    {
      "id": "shot06-15",
      "text": "而是基于统计分布，",
      "start": 26.149,
      "end": 27.649
    },
    {
      "id": "shot06-16",
      "text": "把每个特征转换成均值 0、",
      "start": 27.649,
      "end": 30.069
    },
    {
      "id": "shot06-17",
      "text": "标准差 1 的分布。",
      "start": 30.069,
      "end": 31.509
    },
    {
      "id": "shot06-18",
      "text": "两种方法的目标一样：",
      "start": 31.509,
      "end": 33.069
    },
    {
      "id": "shot06-19",
      "text": "让每个特征对距离的贡献变得可比。",
      "start": 33.069,
      "end": 36.609
    },
    {
      "id": "shot06-20",
      "text": "但它们各自有适用场景，",
      "start": 36.609,
      "end": 38.629
    },
    {
      "id": "shot06-21",
      "text": "差别在对异常值的稳定性上——偶尔混进训练",
      "start": 38.629,
      "end": 42.649
    },
    {
      "id": "shot06-22",
      "text": "集的离谱值，",
      "start": 42.649,
      "end": 43.529
    },
    {
      "id": "shot06-23",
      "text": "比如录数据多打了一个零，",
      "start": 43.529,
      "end": 45.589
    },
    {
      "id": "shot06-24",
      "text": "叫异常值——这个对比下两期分别讲。",
      "start": 45.589,
      "end": 48.489
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.26
    },
    {
      "id": "shot07-1",
      "text": "我们讲清楚了三件事：",
      "start": 1.26,
      "end": 3.04
    },
    {
      "id": "shot07-2",
      "text": "所有距离公式都共用一个把维度差相加的动作，",
      "start": 3.04,
      "end": 7.64
    },
    {
      "id": "shot07-3",
      "text": "量纲不齐时数值大的特征会主导距离；",
      "start": 7.64,
      "end": 11.04
    },
    {
      "id": "shot07-4",
      "text": "KNN 默认假设所有特征同等重要，",
      "start": 11.04,
      "end": 14.2
    },
    {
      "id": "shot07-5",
      "text": "违反这个假设是数据规模在替你做决定；",
      "start": 14.2,
      "end": 17.86
    },
    {
      "id": "shot07-6",
      "text": "缩放的真正动机是把特征重要性从数值范围里解耦。",
      "start": 17.86,
      "end": 22.24
    },
    {
      "id": "shot07-7",
      "text": "点到没展开的：",
      "start": 22.24,
      "end": 23.34
    },
    {
      "id": "shot07-8",
      "text": "怎么具体缩放——归一化和标准化的公式 /",
      "start": 23.34,
      "end": 26.94
    },
    {
      "id": "shot07-9",
      "text": "API / 异常值表现，",
      "start": 26.94,
      "end": 28.7
    },
    {
      "id": "shot07-10",
      "text": "下两期分别讲；",
      "start": 28.7,
      "end": 29.92
    },
    {
      "id": "shot07-11",
      "text": "什么时候选哪种——也放到对比里讲。",
      "start": 29.92,
      "end": 32.74
    },
    {
      "id": "shot07-12",
      "text": "下一期我们看第一种主流缩放方法：归一化，",
      "start": 33.072,
      "end": 36.352
    },
    {
      "id": "shot07-13",
      "text": "把所有特征压到 0 到 1 之间，",
      "start": 36.352,
      "end": 38.912
    },
    {
      "id": "shot07-14",
      "text": "看公式怎么写、",
      "start": 38.912,
      "end": 40.232
    },
    {
      "id": "shot07-15",
      "text": "sklearn 怎么调，",
      "start": 40.232,
      "end": 41.492
    },
    {
      "id": "shot07-16",
      "text": "以及它有什么副作用。",
      "start": 41.492,
      "end": 42.932
    },
    {
      "id": "shot07-17",
      "text": "如果讲得有不对的地方，",
      "start": 42.932,
      "end": 44.532
    },
    {
      "id": "shot07-18",
      "text": "欢迎在评论区指正。下期见。",
      "start": 44.532,
      "end": 46.892
    }
  ]
}
