{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "前面几期我们一直在手算特征怎么切。",
      "start": 0.0,
      "end": 2.961
    },
    {
      "id": "shot01-1",
      "text": "这一期落到工程项目：",
      "start": 2.961,
      "end": 4.502
    },
    {
      "id": "shot01-2",
      "text": "Titanic 生存预测。",
      "start": 4.502,
      "end": 6.102
    },
    {
      "id": "shot01-3",
      "text": "这个任务天然适合决策树，",
      "start": 6.102,
      "end": 8.383
    },
    {
      "id": "shot01-4",
      "text": "因为历史上救援顺序本来就很像规则链：",
      "start": 8.383,
      "end": 11.554
    },
    {
      "id": "shot01-5",
      "text": "舱位高低、性别、年龄，",
      "start": 11.554,
      "end": 13.224
    },
    {
      "id": "shot01-6",
      "text": "都会影响生存概率。",
      "start": 13.224,
      "end": 15.285
    },
    {
      "id": "shot01-7",
      "text": "我们的目标不是还原历史因果，",
      "start": 15.285,
      "end": 17.606
    },
    {
      "id": "shot01-8",
      "text": "而是用数据训练一个分类模型，",
      "start": 17.606,
      "end": 19.987
    },
    {
      "id": "shot01-9",
      "text": "输入乘客信息，",
      "start": 19.987,
      "end": 21.227
    },
    {
      "id": "shot01-10",
      "text": "预测 Survived，",
      "start": 21.227,
      "end": 22.567
    },
    {
      "id": "shot01-11",
      "text": "也就是是否生还。",
      "start": 22.567,
      "end": 24.249
    },
    {
      "id": "shot01-12",
      "text": "这也是教学项目只选少量特征的原因：",
      "start": 24.249,
      "end": 27.422
    },
    {
      "id": "shot01-13",
      "text": "先让规则树的结构和代码流程足够清楚，",
      "start": 27.422,
      "end": 30.856
    },
    {
      "id": "shot01-14",
      "text": "再讨论更多字段能不能继续提升效果。",
      "start": 30.856,
      "end": 33.547
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "这份数据里，",
      "start": 0.0,
      "end": 0.881
    },
    {
      "id": "shot02-1",
      "text": "标签 y 是 Survived，",
      "start": 0.881,
      "end": 2.682
    },
    {
      "id": "shot02-2",
      "text": "0 表示未生还，",
      "start": 2.682,
      "end": 4.024
    },
    {
      "id": "shot02-3",
      "text": "1 表示生还。",
      "start": 4.024,
      "end": 5.305
    },
    {
      "id": "shot02-4",
      "text": "特征 x 我们只用 3 个：",
      "start": 5.305,
      "end": 7.186
    },
    {
      "id": "shot02-5",
      "text": "Pclass、Age、Sex。",
      "start": 7.186,
      "end": 8.868
    },
    {
      "id": "shot02-6",
      "text": "Pclass 是船票等级，",
      "start": 8.868,
      "end": 10.689
    },
    {
      "id": "shot02-7",
      "text": "能间接反映舱位和资源；",
      "start": 10.689,
      "end": 12.891
    },
    {
      "id": "shot02-8",
      "text": "Age 是年龄，",
      "start": 12.891,
      "end": 14.092
    },
    {
      "id": "shot02-9",
      "text": "可能影响救援优先级；",
      "start": 14.092,
      "end": 15.954
    },
    {
      "id": "shot02-10",
      "text": "Sex 是性别，",
      "start": 15.954,
      "end": 17.235
    },
    {
      "id": "shot02-11",
      "text": "在 Titanic 这种场景里非常关键。",
      "start": 17.235,
      "end": 20.218
    },
    {
      "id": "shot02-12",
      "text": "其他字段，",
      "start": 20.218,
      "end": 20.939
    },
    {
      "id": "shot02-13",
      "text": "比如 Name、",
      "start": 20.939,
      "end": 21.759
    },
    {
      "id": "shot02-14",
      "text": "Ticket、",
      "start": 21.759,
      "end": 22.316
    },
    {
      "id": "shot02-15",
      "text": "Cabin，",
      "start": 22.316,
      "end": 22.68
    },
    {
      "id": "shot02-16",
      "text": "看起来信息多，",
      "start": 22.68,
      "end": 23.921
    },
    {
      "id": "shot02-17",
      "text": "但要么缺失严重，",
      "start": 23.921,
      "end": 25.483
    },
    {
      "id": "shot02-18",
      "text": "要么容易让模型记住个体，",
      "start": 25.483,
      "end": 27.504
    },
    {
      "id": "shot02-19",
      "text": "而不是学到可泛化规律。",
      "start": 27.504,
      "end": 29.146
    },
    {
      "id": "shot02-20",
      "text": "教学项目先用 3 个特征，",
      "start": 29.561,
      "end": 31.805
    },
    {
      "id": "shot02-21",
      "text": "把完整流程跑通最重要。",
      "start": 31.805,
      "end": 34.269
    },
    {
      "id": "shot02-22",
      "text": "少选特征还有一个好处：",
      "start": 34.269,
      "end": 36.353
    },
    {
      "id": "shot02-23",
      "text": "后面画树时节点更容易读。",
      "start": 36.353,
      "end": 39.118
    },
    {
      "id": "shot02-24",
      "text": "观众能看懂每条规则，",
      "start": 39.118,
      "end": 41.302
    },
    {
      "id": "shot02-25",
      "text": "才能理解决策树为什么适合解释型项目。",
      "start": 41.302,
      "end": 44.948
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "核心模型是",
      "start": 0.0,
      "end": 0.982
    },
    {
      "id": "shot03-1",
      "text": "DecisionTreeClassifier。",
      "start": 0.982,
      "end": 2.946
    },
    {
      "id": "shot03-2",
      "text": "常用参数可以分成三类。",
      "start": 2.946,
      "end": 5.17
    },
    {
      "id": "shot03-3",
      "text": "第一类是开关，",
      "start": 5.17,
      "end": 6.593
    },
    {
      "id": "shot03-4",
      "text": "criterion 选择切分标准，",
      "start": 6.593,
      "end": 8.917
    },
    {
      "id": "shot03-5",
      "text": "常见是 gini，",
      "start": 8.917,
      "end": 10.2
    },
    {
      "id": "shot03-6",
      "text": "也可以用 entropy。注意，",
      "start": 10.2,
      "end": 12.063
    },
    {
      "id": "shot03-7",
      "text": "sklearn 里的 entropy 仍",
      "start": 12.063,
      "end": 13.807
    },
    {
      "id": "shot03-8",
      "text": "然是 CART 二叉树，",
      "start": 13.807,
      "end": 15.61
    },
    {
      "id": "shot03-9",
      "text": "不是 ID3 或 C4.5。",
      "start": 15.61,
      "end": 17.354
    },
    {
      "id": "shot03-10",
      "text": "第二类是刹车，",
      "start": 17.847,
      "end": 22.497
    },
    {
      "id": "shot03-11",
      "text": "比如 max_depth、",
      "start": 22.497,
      "end": 22.497
    },
    {
      "id": "shot03-12",
      "text": "min_samples_split、",
      "start": 22.497,
      "end": 22.497
    },
    {
      "id": "shot03-13",
      "text": "min_samples_leaf，",
      "start": 22.497,
      "end": 22.497
    },
    {
      "id": "shot03-14",
      "text": "用来限制树不要长得太深。",
      "start": 22.497,
      "end": 24.662
    },
    {
      "id": "shot03-15",
      "text": "第三类是种子 random_state，",
      "start": 24.662,
      "end": 26.686
    },
    {
      "id": "shot03-16",
      "text": "用来保证同样代码每次跑出同样结果。",
      "start": 26.686,
      "end": 29.933
    },
    {
      "id": "shot03-17",
      "text": "决策树很容易过拟合，",
      "start": 29.933,
      "end": 31.757
    },
    {
      "id": "shot03-18",
      "text": "所以生产代码几乎不会放任",
      "start": 31.757,
      "end": 33.882
    },
    {
      "id": "shot03-19",
      "text": "max_depth 一直长。",
      "start": 33.882,
      "end": 34.904
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "完整流程可以分 6 步。第一，读入数据。",
      "start": 0.0,
      "end": 3.306
    },
    {
      "id": "shot04-1",
      "text": "第二，",
      "start": 3.306,
      "end": 3.767
    },
    {
      "id": "shot04-2",
      "text": "取出 x 和 y，",
      "start": 3.767,
      "end": 5.19
    },
    {
      "id": "shot04-3",
      "text": "y 是 Survived，",
      "start": 5.19,
      "end": 6.612
    },
    {
      "id": "shot04-4",
      "text": "x 先取 Pclass、Sex、Age。",
      "start": 6.612,
      "end": 8.977
    },
    {
      "id": "shot04-5",
      "text": "第三，",
      "start": 8.977,
      "end": 9.458
    },
    {
      "id": "shot04-6",
      "text": "处理缺失值，",
      "start": 9.458,
      "end": 10.64
    },
    {
      "id": "shot04-7",
      "text": "Age 有缺失，",
      "start": 10.64,
      "end": 11.822
    },
    {
      "id": "shot04-8",
      "text": "代码先算年龄均值，",
      "start": 11.822,
      "end": 13.465
    },
    {
      "id": "shot04-9",
      "text": "再填回缺口。第四，",
      "start": 13.465,
      "end": 15.489
    },
    {
      "id": "shot04-10",
      "text": "把 Sex 这种文本类别转成",
      "start": 15.489,
      "end": 17.793
    },
    {
      "id": "shot04-11",
      "text": "one-hot 数字列，",
      "start": 17.793,
      "end": 19.155
    },
    {
      "id": "shot04-12",
      "text": "代码会得到 Sex_female 和",
      "start": 19.155,
      "end": 21.159
    },
    {
      "id": "shot04-13",
      "text": "Sex_male，",
      "start": 21.159,
      "end": 22.081
    },
    {
      "id": "shot04-14",
      "text": "然后删掉 Sex_male，",
      "start": 22.081,
      "end": 23.744
    },
    {
      "id": "shot04-15",
      "text": "最后保留 Sex_female。",
      "start": 23.744,
      "end": 25.106
    },
    {
      "id": "shot04-16",
      "text": "所以这一列等于 1 表示 female，",
      "start": 25.648,
      "end": 28.235
    },
    {
      "id": "shot04-17",
      "text": "等于 0 表示 male。第五，",
      "start": 28.235,
      "end": 30.219
    },
    {
      "id": "shot04-18",
      "text": "切分训练集和测试集，",
      "start": 30.219,
      "end": 31.984
    },
    {
      "id": "shot04-19",
      "text": "再调用 fit 训练模型。第六，",
      "start": 31.984,
      "end": 34.249
    },
    {
      "id": "shot04-20",
      "text": "用 predict 预测，",
      "start": 34.249,
      "end": 35.553
    },
    {
      "id": "shot04-21",
      "text": "再用 score 或",
      "start": 35.553,
      "end": 36.675
    },
    {
      "id": "shot04-22",
      "text": "classification_report",
      "start": 36.675,
      "end": 38.079
    },
    {
      "id": "shot04-23",
      "text": "评估。",
      "start": 38.079,
      "end": 38.66
    },
    {
      "id": "shot04-24",
      "text": "决策树训练很方便，",
      "start": 38.66,
      "end": 40.284
    },
    {
      "id": "shot04-25",
      "text": "但流程里的数据处理一点不能省。",
      "start": 40.284,
      "end": 42.53
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "决策树还有一个工程优势：",
      "start": 0.0,
      "end": 2.164
    },
    {
      "id": "shot05-1",
      "text": "可以把规则画出来。",
      "start": 2.164,
      "end": 3.827
    },
    {
      "id": "shot05-2",
      "text": "用 plot_tree 时，",
      "start": 3.827,
      "end": 4.929
    },
    {
      "id": "shot05-3",
      "text": "如果不给 feature_names，",
      "start": 4.929,
      "end": 6.372
    },
    {
      "id": "shot05-4",
      "text": "图里只会出现 x0、x1、x2，",
      "start": 6.372,
      "end": 9.117
    },
    {
      "id": "shot05-5",
      "text": "业务方看不懂。",
      "start": 9.117,
      "end": 10.339
    },
    {
      "id": "shot05-6",
      "text": "实际代码传入的是 x.columns，",
      "start": 10.339,
      "end": 13.485
    },
    {
      "id": "shot05-7",
      "text": "当前特征名会显示成 Pclass、",
      "start": 13.485,
      "end": 16.01
    },
    {
      "id": "shot05-8",
      "text": "Age、",
      "start": 16.01,
      "end": 16.311
    },
    {
      "id": "shot05-9",
      "text": "Sex_female，",
      "start": 16.311,
      "end": 17.733
    },
    {
      "id": "shot05-10",
      "text": "节点条件才会变成能读的规则。",
      "start": 17.733,
      "end": 20.398
    },
    {
      "id": "shot05-11",
      "text": "这里也顺手记两个坑。",
      "start": 20.398,
      "end": 21.701
    },
    {
      "id": "shot05-12",
      "text": "第一，",
      "start": 22.134,
      "end": 22.716
    },
    {
      "id": "shot05-13",
      "text": "老写法里 pandas 链式索引加",
      "start": 22.716,
      "end": 25.122
    },
    {
      "id": "shot05-14",
      "text": "inplace 容易触发",
      "start": 25.122,
      "end": 26.666
    },
    {
      "id": "shot05-15",
      "text": "SettingWithCopyWarning，",
      "start": 26.666,
      "end": 28.27
    },
    {
      "id": "shot05-16",
      "text": "本期代码已经先 copy 再赋值，",
      "start": 28.27,
      "end": 30.857
    },
    {
      "id": "shot05-17",
      "text": "写法更稳。第二，",
      "start": 30.857,
      "end": 32.923
    },
    {
      "id": "shot05-18",
      "text": "classification_report",
      "start": 32.923,
      "end": 33.985
    },
    {
      "id": "shot05-19",
      "text": "的参数顺序是 y_true 在前，",
      "start": 33.985,
      "end": 36.592
    },
    {
      "id": "shot05-20",
      "text": "y_pred 在后，",
      "start": 36.592,
      "end": 37.936
    },
    {
      "id": "shot05-21",
      "text": "顺序反了会让 precision 和",
      "start": 37.936,
      "end": 39.821
    },
    {
      "id": "shot05-22",
      "text": "recall 的含义混乱。",
      "start": 39.821,
      "end": 41.064
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "这一期我们把分类树工程跑通了：",
      "start": 0.0,
      "end": 2.703
    },
    {
      "id": "shot06-1",
      "text": "明确 y 是 Survived，",
      "start": 2.703,
      "end": 4.506
    },
    {
      "id": "shot06-2",
      "text": "选 Pclass、Age、",
      "start": 4.506,
      "end": 6.088
    },
    {
      "id": "shot06-3",
      "text": "Sex 三个特征，",
      "start": 6.088,
      "end": 7.469
    },
    {
      "id": "shot06-4",
      "text": "处理缺失和类别编码，",
      "start": 7.469,
      "end": 9.352
    },
    {
      "id": "shot06-5",
      "text": "再训练",
      "start": 9.352,
      "end": 9.952
    },
    {
      "id": "shot06-6",
      "text": "DecisionTreeClassifier，",
      "start": 9.952,
      "end": 11.715
    },
    {
      "id": "shot06-7",
      "text": "最后评估和画树。到这里，",
      "start": 11.715,
      "end": 13.917
    },
    {
      "id": "shot06-8",
      "text": "分类任务已经闭环。",
      "start": 13.917,
      "end": 15.88
    },
    {
      "id": "shot06-9",
      "text": "下一期换一个问题：",
      "start": 15.88,
      "end": 17.622
    },
    {
      "id": "shot06-10",
      "text": "如果标签不是生还或未生还，而是房价、",
      "start": 17.622,
      "end": 21.347
    },
    {
      "id": "shot06-11",
      "text": "销量、",
      "start": 21.347,
      "end": 21.867
    },
    {
      "id": "shot06-12",
      "text": "温度这种连续数值，",
      "start": 21.867,
      "end": 23.779
    },
    {
      "id": "shot06-13",
      "text": "树还能不能用？答案是能，",
      "start": 23.779,
      "end": 25.792
    },
    {
      "id": "shot06-14",
      "text": "只是纯度尺子要从分类不纯度换成平方损失。",
      "start": 25.792,
      "end": 29.497
    },
    {
      "id": "shot06-15",
      "text": "这也为回归树做了铺垫：",
      "start": 29.924,
      "end": 31.809
    },
    {
      "id": "shot06-16",
      "text": "模型外壳仍然是 fit 和",
      "start": 31.809,
      "end": 33.713
    },
    {
      "id": "shot06-17",
      "text": "predict，",
      "start": 33.713,
      "end": 34.595
    },
    {
      "id": "shot06-18",
      "text": "变化的是标签类型、",
      "start": 34.595,
      "end": 36.239
    },
    {
      "id": "shot06-19",
      "text": "切分标准和叶子输出。",
      "start": 36.239,
      "end": 38.144
    },
    {
      "id": "shot06-20",
      "text": "录屏时可以把代码光标停在对应位置，",
      "start": 38.144,
      "end": 41.472
    },
    {
      "id": "shot06-21",
      "text": "让观众看到特征列和树图节点名称是一一对应",
      "start": 41.472,
      "end": 45.401
    },
    {
      "id": "shot06-22",
      "text": "的。",
      "start": 45.401,
      "end": 45.421
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.709
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.709,
      "end": 2.109
    }
  ]
}
