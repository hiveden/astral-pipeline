{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们讲了线性回归是什么——从一元的",
      "start": 0.0,
      "end": 3.445
    },
    {
      "id": "shot01-1",
      "text": "y = kx + b，",
      "start": 3.445,
      "end": 6.009
    },
    {
      "id": "shot01-2",
      "text": "到多元的 wᵀx + b。",
      "start": 6.009,
      "end": 9.995
    },
    {
      "id": "shot01-3",
      "text": "但每次手算 w 和 b 太累——这一期我",
      "start": 9.995,
      "end": 13.18
    },
    {
      "id": "shot01-4",
      "text": "们打开 sklearn，",
      "start": 13.18,
      "end": 14.983
    },
    {
      "id": "shot01-5",
      "text": "4 行代码跑通线性回归，",
      "start": 14.983,
      "end": 17.387
    },
    {
      "id": "shot01-6",
      "text": "顺便把上期那个悬案解决：",
      "start": 17.387,
      "end": 19.59
    },
    {
      "id": "shot01-7",
      "text": "小明身高 176 厘米，",
      "start": 19.59,
      "end": 21.573
    },
    {
      "id": "shot01-8",
      "text": "体重到底多少。",
      "start": 21.573,
      "end": 22.475
    },
    {
      "id": "shot01-9",
      "text": "这一期我们解决三件事：",
      "start": 23.019,
      "end": 24.745
    },
    {
      "id": "shot01-10",
      "text": "sklearn 5 步流程怎么用；",
      "start": 24.745,
      "end": 26.819
    },
    {
      "id": "shot01-11",
      "text": "6 个场景演示 API 在不同数据 / 不同参数下的表现；",
      "start": 26.819,
      "end": 31.327
    },
    {
      "id": "shot01-13",
      "text": "以及 5 个新手最常见的坑。",
      "start": 31.327,
      "end": 33.555
    },
    {
      "id": "shot01-14",
      "text": "下一期我们打开 sklearn 内部的黑盒：",
      "start": 33.555,
      "end": 36.565
    },
    {
      "id": "shot01-15",
      "text": "先讲损失函数。",
      "start": 36.565,
      "end": 37.95
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看 5 步流程。",
      "start": 0.0,
      "end": 1.381
    },
    {
      "id": "shot02-1",
      "text": "第一步导入：",
      "start": 1.381,
      "end": 2.503
    },
    {
      "id": "shot02-2",
      "text": "从 sklearn.",
      "start": 2.503,
      "end": 3.223
    },
    {
      "id": "shot02-3",
      "text": "linear_model 引入",
      "start": 3.223,
      "end": 4.665
    },
    {
      "id": "shot02-4",
      "text": "LinearRegression 类。",
      "start": 4.665,
      "end": 6.006
    },
    {
      "id": "shot02-5",
      "text": "第二步准备数据：",
      "start": 6.006,
      "end": 7.567
    },
    {
      "id": "shot02-6",
      "text": "X 是身高列表，",
      "start": 7.567,
      "end": 9.329
    },
    {
      "id": "shot02-7",
      "text": "但必须写成嵌套列表——每个样本是一个独立的列表，",
      "start": 9.329,
      "end": 13.593
    },
    {
      "id": "shot02-8",
      "text": "比如 160 写成中括号 160 中括号，",
      "start": 13.593,
      "end": 17.217
    },
    {
      "id": "shot02-9",
      "text": "5 个样本就是 5 个嵌套中括号。",
      "start": 17.217,
      "end": 20.22
    },
    {
      "id": "shot02-10",
      "text": "这是 sklearn 的硬规则：",
      "start": 20.22,
      "end": 22.242
    },
    {
      "id": "shot02-11",
      "text": "X 必须是二维数组。",
      "start": 22.242,
      "end": 24.464
    },
    {
      "id": "shot02-12",
      "text": "y 是体重列表，一维就够。",
      "start": 24.464,
      "end": 26.206
    },
    {
      "id": "shot02-13",
      "text": "第三步实例化：",
      "start": 26.637,
      "end": 27.979
    },
    {
      "id": "shot02-14",
      "text": "写一行 estimator 等于",
      "start": 27.979,
      "end": 29.822
    },
    {
      "id": "shot02-15",
      "text": "LinearRegression 加括号",
      "start": 29.822,
      "end": 31.424
    },
    {
      "id": "shot02-16",
      "text": "——一个空对象，",
      "start": 31.424,
      "end": 32.385
    },
    {
      "id": "shot02-17",
      "text": "里面什么模型都没学。",
      "start": 32.385,
      "end": 34.248
    },
    {
      "id": "shot02-18",
      "text": "第四步 fit：",
      "start": 34.248,
      "end": 35.45
    },
    {
      "id": "shot02-19",
      "text": "调用 estimator.fit 传入x、",
      "start": 35.45,
      "end": 38.214
    },
    {
      "id": "shot02-20",
      "text": "y——这一行就是训练，",
      "start": 38.214,
      "end": 39.896
    },
    {
      "id": "shot02-21",
      "text": "sklearn 内部会算出 w 和 b。",
      "start": 39.896,
      "end": 43.201
    },
    {
      "id": "shot02-22",
      "text": "第五步 predict：",
      "start": 43.201,
      "end": 44.543
    },
    {
      "id": "shot02-23",
      "text": "调用 estimator.predict",
      "start": 44.543,
      "end": 46.726
    },
    {
      "id": "shot02-24",
      "text": "传入新样本——返回预测值。",
      "start": 46.726,
      "end": 48.609
    },
    {
      "id": "shot02-25",
      "text": "fit 之后还能查参数：",
      "start": 49.141,
      "end": 50.629
    },
    {
      "id": "shot02-26",
      "text": "coef 下划线是权重 w，",
      "start": 50.629,
      "end": 52.799
    },
    {
      "id": "shot02-27",
      "text": "intercept 下划线是截距 b。",
      "start": 52.799,
      "end": 55.552
    },
    {
      "id": "shot02-28",
      "text": "注意一个 sklearn 约定：",
      "start": 55.552,
      "end": 57.401
    },
    {
      "id": "shot02-29",
      "text": "凡是 fit 之后才有的属性，",
      "start": 57.401,
      "end": 59.531
    },
    {
      "id": "shot02-30",
      "text": "都带下划线后缀。",
      "start": 59.531,
      "end": 60.696
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "打开 demo，",
      "start": 0.0,
      "end": 0.72
    },
    {
      "id": "shot03-1",
      "text": "我们按 6 个观察场景走一遍。",
      "start": 0.72,
      "end": 3.062
    },
    {
      "id": "shot03-2",
      "text": "先看画面分工：",
      "start": 3.062,
      "end": 4.303
    },
    {
      "id": "shot03-3",
      "text": "左侧是数据和 x_new 控件，",
      "start": 4.303,
      "end": 6.444
    },
    {
      "id": "shot03-4",
      "text": "中间是拟合图，",
      "start": 6.444,
      "end": 7.685
    },
    {
      "id": "shot03-5",
      "text": "右侧是关键读数。",
      "start": 7.685,
      "end": 9.146
    },
    {
      "id": "shot03-6",
      "text": "图表会在两种视角之间切换：",
      "start": 9.146,
      "end": 11.468
    },
    {
      "id": "shot03-7",
      "text": "默认用缩放视图，看清点、",
      "start": 11.468,
      "end": 13.77
    },
    {
      "id": "shot03-8",
      "text": "线和预测值；",
      "start": 13.77,
      "end": 15.15
    },
    {
      "id": "shot03-9",
      "text": "关掉 fit_intercept 时切到",
      "start": 15.15,
      "end": 17.132
    },
    {
      "id": "shot03-10",
      "text": "原点视图，",
      "start": 17.132,
      "end": 18.133
    },
    {
      "id": "shot03-11",
      "text": "专门看红线为什么必须穿过坐标原点。",
      "start": 18.133,
      "end": 21.455
    },
    {
      "id": "shot03-12",
      "text": "场景 1，",
      "start": 21.455,
      "end": 22.182
    },
    {
      "id": "shot03-13",
      "text": "4 行跑通最经典版本：",
      "start": 22.182,
      "end": 24.337
    },
    {
      "id": "shot03-14",
      "text": "5 个身高体重点，",
      "start": 24.337,
      "end": 25.898
    },
    {
      "id": "shot03-15",
      "text": "fit_intercept 默认开。",
      "start": 25.898,
      "end": 27.179
    },
    {
      "id": "shot03-16",
      "text": "看参数面板：",
      "start": 27.659,
      "end": 28.8
    },
    {
      "id": "shot03-17",
      "text": "coef 等于 0.93，",
      "start": 28.8,
      "end": 31.203
    },
    {
      "id": "shot03-18",
      "text": "intercept 等于负 93.27，",
      "start": 31.203,
      "end": 33.786
    },
    {
      "id": "shot03-19",
      "text": "预测 176 厘米对应 70.30 公斤",
      "start": 33.786,
      "end": 37.31
    },
    {
      "id": "shot03-20",
      "text": "——上期那个小明体重悬案的答案。",
      "start": 37.31,
      "end": 39.753
    },
    {
      "id": "shot03-21",
      "text": "R 平方 0.98，",
      "start": 39.753,
      "end": 41.555
    },
    {
      "id": "shot03-22",
      "text": "5 个点几乎全在直线上。",
      "start": 41.555,
      "end": 43.718
    },
    {
      "id": "shot03-23",
      "text": "场景 2，",
      "start": 43.718,
      "end": 44.819
    },
    {
      "id": "shot03-24",
      "text": "关掉 fit_intercept：",
      "start": 44.819,
      "end": 46.601
    },
    {
      "id": "shot03-25",
      "text": "勾掉这个开关，",
      "start": 46.601,
      "end": 48.003
    },
    {
      "id": "shot03-26",
      "text": "强制截距等于 0。",
      "start": 48.003,
      "end": 49.865
    },
    {
      "id": "shot03-27",
      "text": "红线被迫穿过原点。",
      "start": 49.865,
      "end": 51.467
    },
    {
      "id": "shot03-28",
      "text": "coef 从 0.93 跌到 0.38，",
      "start": 52.017,
      "end": 55.243
    },
    {
      "id": "shot03-29",
      "text": "predict 从 70.30 偏低到",
      "start": 55.243,
      "end": 57.848
    },
    {
      "id": "shot03-30",
      "text": "67.40，",
      "start": 57.848,
      "end": 59.004
    },
    {
      "id": "shot03-31",
      "text": "R 平方从 0.98 暴跌到 0.64。",
      "start": 59.004,
      "end": 61.996
    },
    {
      "id": "shot03-32",
      "text": "结论：",
      "start": 61.996,
      "end": 62.457
    },
    {
      "id": "shot03-33",
      "text": "默认 True 不要乱关。场景 3，",
      "start": 62.457,
      "end": 64.982
    },
    {
      "id": "shot03-34",
      "text": "数据从 5 点扩到 30 点：",
      "start": 64.982,
      "end": 67.086
    },
    {
      "id": "shot03-35",
      "text": "散点变成一团带噪声的云，",
      "start": 67.086,
      "end": 69.431
    },
    {
      "id": "shot03-36",
      "text": "红线还在中间穿过。",
      "start": 69.431,
      "end": 71.455
    },
    {
      "id": "shot03-37",
      "text": "coef 仍约 0.96，",
      "start": 71.455,
      "end": 73.619
    },
    {
      "id": "shot03-38",
      "text": "跟场景 1 的 0.93 差不多——参数",
      "start": 73.619,
      "end": 76.545
    },
    {
      "id": "shot03-39",
      "text": "主要由数据分布决定，",
      "start": 76.545,
      "end": 78.168
    },
    {
      "id": "shot03-40",
      "text": "不由数据量决定。",
      "start": 78.168,
      "end": 79.19
    },
    {
      "id": "shot03-41",
      "text": "多点反而让 LR 对噪声更鲁棒。",
      "start": 79.472,
      "end": 82.753
    },
    {
      "id": "shot03-42",
      "text": "场景 4，",
      "start": 82.753,
      "end": 83.633
    },
    {
      "id": "shot03-43",
      "text": "切到加州房价真实数据：",
      "start": 83.633,
      "end": 85.994
    },
    {
      "id": "shot03-44",
      "text": "散点从身高体重换成收入和房价，",
      "start": 85.994,
      "end": 89.174
    },
    {
      "id": "shot03-45",
      "text": "单位完全不同。",
      "start": 89.174,
      "end": 90.635
    },
    {
      "id": "shot03-46",
      "text": "注意一个细节——API 代码一行没变，",
      "start": 90.635,
      "end": 93.935
    },
    {
      "id": "shot03-47",
      "text": "sklearn 自动算出新的 coef",
      "start": 93.935,
      "end": 96.416
    },
    {
      "id": "shot03-48",
      "text": "和 intercept。",
      "start": 96.416,
      "end": 97.996
    },
    {
      "id": "shot03-49",
      "text": "这就是参数化模型的好处：",
      "start": 97.996,
      "end": 100.537
    },
    {
      "id": "shot03-50",
      "text": "换数据不换代码。场景 5，",
      "start": 100.537,
      "end": 103.157
    },
    {
      "id": "shot03-51",
      "text": "加州 + 关 fit_intercept：",
      "start": 103.157,
      "end": 105.619
    },
    {
      "id": "shot03-52",
      "text": "和场景 2 一样关掉开关，",
      "start": 105.619,
      "end": 108.422
    },
    {
      "id": "shot03-53",
      "text": "但这次更严重。",
      "start": 108.422,
      "end": 109.733
    },
    {
      "id": "shot03-54",
      "text": "R 平方掉到 0.10——几乎学不到东西。",
      "start": 110.027,
      "end": 113.449
    },
    {
      "id": "shot03-55",
      "text": "加州房价的中心点不在原点附近，",
      "start": 113.449,
      "end": 116.27
    },
    {
      "id": "shot03-56",
      "text": "强行穿原点的拟合彻底失败。场景 6，",
      "start": 116.27,
      "end": 119.711
    },
    {
      "id": "shot03-57",
      "text": "拖动新样本：",
      "start": 119.711,
      "end": 120.912
    },
    {
      "id": "shot03-58",
      "text": "把 x_new 从 176 拖到 165，",
      "start": 120.912,
      "end": 123.953
    },
    {
      "id": "shot03-59",
      "text": "红线不动，",
      "start": 123.953,
      "end": 125.094
    },
    {
      "id": "shot03-60",
      "text": "蓝菱形沿红线滑到 165，",
      "start": 125.094,
      "end": 127.815
    },
    {
      "id": "shot03-61",
      "text": "预测 60.08 公斤——这是数据范围内",
      "start": 127.815,
      "end": 131.016
    },
    {
      "id": "shot03-62",
      "text": "的内插。",
      "start": 131.016,
      "end": 132.057
    },
    {
      "id": "shot03-63",
      "text": "注意一个隐患：",
      "start": 132.057,
      "end": 133.437
    },
    {
      "id": "shot03-64",
      "text": "拖出训练范围比如 200 厘米，",
      "start": 133.437,
      "end": 135.878
    },
    {
      "id": "shot03-65",
      "text": "LR 还是会给一个数字，",
      "start": 135.878,
      "end": 138.039
    },
    {
      "id": "shot03-66",
      "text": "但这是外推，不可信。",
      "start": 138.039,
      "end": 140.043
    },
    {
      "id": "shot03-67",
      "text": "LR 没有'我不知道'机制。",
      "start": 140.043,
      "end": 142.212
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "5 步流程跑完，",
      "start": 0.0,
      "end": 1.362
    },
    {
      "id": "shot04-1",
      "text": "提一下 5 个新手最容易踩的坑。第一坑，",
      "start": 1.362,
      "end": 4.426
    },
    {
      "id": "shot04-2",
      "text": "X 必须是二维。",
      "start": 4.426,
      "end": 5.928
    },
    {
      "id": "shot04-3",
      "text": "一维列表 sklearn 直接报错——修复有两条：",
      "start": 5.928,
      "end": 9.613
    },
    {
      "id": "shot04-4",
      "text": "写嵌套中括号，",
      "start": 9.613,
      "end": 11.095
    },
    {
      "id": "shot04-5",
      "text": "或者用 numpy reshape 加负",
      "start": 11.095,
      "end": 13.078
    },
    {
      "id": "shot04-6",
      "text": "1 加 1。第二坑，",
      "start": 13.078,
      "end": 14.76
    },
    {
      "id": "shot04-7",
      "text": "fit_intercept 默认",
      "start": 14.76,
      "end": 16.403
    },
    {
      "id": "shot04-8",
      "text": "True 不要乱关，",
      "start": 16.403,
      "end": 17.624
    },
    {
      "id": "shot04-9",
      "text": "除非数据已经手动中心化，",
      "start": 17.624,
      "end": 19.787
    },
    {
      "id": "shot04-10",
      "text": "或者业务上确定 x 等于 0 时 y 必",
      "start": 19.787,
      "end": 22.691
    },
    {
      "id": "shot04-11",
      "text": "须等于 0。",
      "start": 22.691,
      "end": 23.532
    },
    {
      "id": "shot04-12",
      "text": "刚才场景 2 和场景 5 演示过——R",
      "start": 23.532,
      "end": 26.537
    },
    {
      "id": "shot04-13",
      "text": "平方暴跌不是开玩笑。",
      "start": 26.537,
      "end": 27.979
    },
    {
      "id": "shot04-14",
      "text": "第三坑点几个线代术语：矩阵 matrix / 向量 vector / 共线 collinearity，",
      "start": 28.515,
      "end": 35.228
    },
    {
      "id": "shot04-17",
      "text": "SVD singular value decomposition / 范数 norm，",
      "start": 35.228,
      "end": 39.375
    },
    {
      "id": "shot04-20",
      "text": "这些都是后面矩阵化和正规方程那两期的内容，",
      "start": 39.375,
      "end": 42.942
    },
    {
      "id": "shot04-21",
      "text": "本期只用来描述现象不展开公式。",
      "start": 42.942,
      "end": 46.268
    },
    {
      "id": "shot04-22",
      "text": "sklearn 内部不直接求矩阵逆——它",
      "start": 46.268,
      "end": 48.813
    },
    {
      "id": "shot04-23",
      "text": "走 SVD 路径，",
      "start": 48.813,
      "end": 50.155
    },
    {
      "id": "shot04-24",
      "text": "特征共线时用伪逆给最小范数解。",
      "start": 50.155,
      "end": 52.68
    },
    {
      "id": "shot04-25",
      "text": "代价是比直接求逆慢 2 到 3 倍，",
      "start": 52.887,
      "end": 55.392
    },
    {
      "id": "shot04-26",
      "text": "但稳定性优先。第四坑，",
      "start": 55.392,
      "end": 57.216
    },
    {
      "id": "shot04-27",
      "text": "LinearRegression 不做特征缩放。",
      "start": 57.216,
      "end": 59.802
    },
    {
      "id": "shot04-28",
      "text": "一元单特征没事，",
      "start": 59.802,
      "end": 61.285
    },
    {
      "id": "shot04-29",
      "text": "多元量纲悬殊得配",
      "start": 61.285,
      "end": 62.989
    },
    {
      "id": "shot04-30",
      "text": "StandardScaler——加州房价",
      "start": 62.989,
      "end": 64.893
    },
    {
      "id": "shot04-31",
      "text": "8 特征那期会展开。第五坑，",
      "start": 64.893,
      "end": 67.238
    },
    {
      "id": "shot04-32",
      "text": "coef 下划线的 shape。",
      "start": 67.238,
      "end": 69.202
    },
    {
      "id": "shot04-33",
      "text": "单目标 y 是一维时，",
      "start": 69.434,
      "end": 70.94
    },
    {
      "id": "shot04-34",
      "text": "coef 是 n 个特征长度的一维数组；",
      "start": 70.94,
      "end": 74.072
    },
    {
      "id": "shot04-35",
      "text": "多目标 y 是二维时变成",
      "start": 74.072,
      "end": 76.099
    },
    {
      "id": "shot04-36",
      "text": "n_targets 乘",
      "start": 76.099,
      "end": 77.123
    },
    {
      "id": "shot04-37",
      "text": "n_features 的二维。",
      "start": 77.123,
      "end": 78.689
    },
    {
      "id": "shot04-38",
      "text": "下游代码取索引前先看 shape，",
      "start": 78.689,
      "end": 81.098
    },
    {
      "id": "shot04-39",
      "text": "不然容易踩维度坑。",
      "start": 81.098,
      "end": 82.343
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 0.921
    },
    {
      "id": "shot05-1",
      "text": "我们解决了 sklearn 用法的入门三件事：第一，",
      "start": 0.921,
      "end": 4.426
    },
    {
      "id": "shot05-2",
      "text": "5 步流程——导入、",
      "start": 4.426,
      "end": 6.41
    },
    {
      "id": "shot05-3",
      "text": "准备 2D 数据、实例化、fit、",
      "start": 6.41,
      "end": 9.374
    },
    {
      "id": "shot05-4",
      "text": "predict；第二，",
      "start": 9.374,
      "end": 10.89
    },
    {
      "id": "shot05-5",
      "text": "6 个场景演示 API 在不同数据 / 不同参数下的表现；第三，",
      "start": 10.89,
      "end": 16.733
    },
    {
      "id": "shot05-7",
      "text": "5 个新手坑——最关键是 X 必须二维 + fit_intercept 别乱关。",
      "start": 16.733,
      "end": 22.595
    },
    {
      "id": "shot05-9",
      "text": "点到没展开的：",
      "start": 23.026,
      "end": 24.048
    },
    {
      "id": "shot05-10",
      "text": "完整 API 速查表，",
      "start": 24.048,
      "end": 25.831
    },
    {
      "id": "shot05-11",
      "text": "构造参数 4 个加 fit 后属性 5",
      "start": 25.831,
      "end": 28.175
    },
    {
      "id": "shot05-12",
      "text": "个加核心方法 3 个，",
      "start": 28.175,
      "end": 29.938
    },
    {
      "id": "shot05-13",
      "text": "需要时查 sklearn 文档；",
      "start": 29.938,
      "end": 31.941
    },
    {
      "id": "shot05-14",
      "text": "多元量纲悬殊的标准化操作留给加州房价那一期；",
      "start": 31.941,
      "end": 35.848
    },
    {
      "id": "shot05-15",
      "text": "大数据场景的 SGDRegressor",
      "start": 35.848,
      "end": 38.192
    },
    {
      "id": "shot05-16",
      "text": "留给梯度下降变体那一期。",
      "start": 38.192,
      "end": 40.716
    },
    {
      "id": "shot05-17",
      "text": "下一期我们打开 sklearn 的黑盒：",
      "start": 40.716,
      "end": 43.301
    },
    {
      "id": "shot05-18",
      "text": "fit 一行调用，",
      "start": 43.301,
      "end": 44.462
    },
    {
      "id": "shot05-19",
      "text": "内部到底在做什么？",
      "start": 44.462,
      "end": 45.945
    },
    {
      "id": "shot05-20",
      "text": "什么是'好直线'？",
      "start": 45.945,
      "end": 46.847
    },
    {
      "id": "shot05-21",
      "text": "答案是损失函数——先定义'好' 等于'损失最小'，再求最优。",
      "start": 47.308,
      "end": 52.484
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.825
    },
    {
      "id": "shot06-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.825,
      "end": 2.335
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "打开 demo 前，",
      "start": 0.0,
      "end": 0.942
    },
    {
      "id": "shot07-1",
      "text": "先补三个看面板的关键词。第一，",
      "start": 0.942,
      "end": 3.826
    },
    {
      "id": "shot07-2",
      "text": "fit_intercept 是",
      "start": 3.826,
      "end": 5.088
    },
    {
      "id": "shot07-3",
      "text": "LinearRegression 括号里",
      "start": 5.088,
      "end": 6.631
    },
    {
      "id": "shot07-4",
      "text": "的一个开关，",
      "start": 6.631,
      "end": 7.572
    },
    {
      "id": "shot07-5",
      "text": "可以理解成：",
      "start": 7.572,
      "end": 8.394
    },
    {
      "id": "shot07-6",
      "text": "这条直线能不能上下平移。",
      "start": 8.394,
      "end": 10.838
    },
    {
      "id": "shot07-7",
      "text": "默认 True 时，",
      "start": 10.838,
      "end": 11.779
    },
    {
      "id": "shot07-8",
      "text": "模型会同时调斜率 w 和截距 b，",
      "start": 11.779,
      "end": 14.804
    },
    {
      "id": "shot07-9",
      "text": "公式是 y = wx + b，",
      "start": 14.804,
      "end": 17.419
    },
    {
      "id": "shot07-10",
      "text": "直线可以上下移动，",
      "start": 17.419,
      "end": 18.871
    },
    {
      "id": "shot07-11",
      "text": "自己找最贴近数据的位置。",
      "start": 18.871,
      "end": 20.734
    },
    {
      "id": "shot07-12",
      "text": "如果设成 False，",
      "start": 21.076,
      "end": 22.457
    },
    {
      "id": "shot07-13",
      "text": "就把 b 锁死为 0，",
      "start": 22.457,
      "end": 24.158
    },
    {
      "id": "shot07-14",
      "text": "公式变成 y = wx，",
      "start": 24.158,
      "end": 26.639
    },
    {
      "id": "shot07-15",
      "text": "模型只能调斜率，",
      "start": 26.639,
      "end": 28.26
    },
    {
      "id": "shot07-16",
      "text": "不能上下平移，",
      "start": 28.26,
      "end": 29.481
    },
    {
      "id": "shot07-17",
      "text": "所以直线必须穿过原点。第二，",
      "start": 29.481,
      "end": 32.202
    },
    {
      "id": "shot07-18",
      "text": "coef 和 intercept 分别对",
      "start": 32.202,
      "end": 34.804
    },
    {
      "id": "shot07-19",
      "text": "应上一期的权重 w 和截距 b，",
      "start": 34.804,
      "end": 37.826
    },
    {
      "id": "shot07-20",
      "text": "它们是 fit 之后学出来的结果。第三，",
      "start": 37.826,
      "end": 41.307
    },
    {
      "id": "shot07-21",
      "text": "R 平方先当成拟合分数读就行，",
      "start": 41.307,
      "end": 44.089
    },
    {
      "id": "shot07-22",
      "text": "越接近 1 说明直线越贴合数据，",
      "start": 44.089,
      "end": 47.039
    },
    {
      "id": "shot07-23",
      "text": "掉得越低说明拟合越差，",
      "start": 47.039,
      "end": 49.207
    },
    {
      "id": "shot07-24",
      "text": "公式后面评估指标那期再展开。",
      "start": 49.207,
      "end": 51.495
    },
    {
      "id": "shot07-25",
      "text": "接下来 6 个场景，",
      "start": 52.072,
      "end": 53.52
    },
    {
      "id": "shot07-26",
      "text": "本质上只是在换三件事：",
      "start": 53.52,
      "end": 55.732
    },
    {
      "id": "shot07-27",
      "text": "开关变不变、",
      "start": 55.732,
      "end": 57.039
    },
    {
      "id": "shot07-28",
      "text": "数据变不变、",
      "start": 57.039,
      "end": 58.084
    },
    {
      "id": "shot07-29",
      "text": "新样本位置变不变。",
      "start": 58.084,
      "end": 59.411
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "看完 6 个场景，",
      "start": 0.0,
      "end": 1.343
    },
    {
      "id": "shot08-1",
      "text": "先把现象收束成三条。第一，",
      "start": 1.343,
      "end": 3.768
    },
    {
      "id": "shot08-2",
      "text": "默认学截距是正常做法，",
      "start": 3.768,
      "end": 5.813
    },
    {
      "id": "shot08-3",
      "text": "强行让直线穿过原点，",
      "start": 5.813,
      "end": 7.677
    },
    {
      "id": "shot08-4",
      "text": "经常会把拟合搞坏。第二，",
      "start": 7.677,
      "end": 9.802
    },
    {
      "id": "shot08-5",
      "text": "换数据集不需要换 API，",
      "start": 9.802,
      "end": 11.927
    },
    {
      "id": "shot08-6",
      "text": "还是 fit 和 predict，",
      "start": 11.927,
      "end": 13.59
    },
    {
      "id": "shot08-7",
      "text": "变的是 sklearn 学出来的",
      "start": 13.59,
      "end": 15.474
    },
    {
      "id": "shot08-8",
      "text": "coef 和 intercept。第三，",
      "start": 15.474,
      "end": 18.16
    },
    {
      "id": "shot08-9",
      "text": "predict 永远会给数字，",
      "start": 18.16,
      "end": 20.065
    },
    {
      "id": "shot08-10",
      "text": "但训练范围外的数字只是外推，",
      "start": 20.065,
      "end": 22.39
    },
    {
      "id": "shot08-11",
      "text": "不代表可信。",
      "start": 22.39,
      "end": 23.332
    },
    {
      "id": "shot08-12",
      "text": "带着这三条，",
      "start": 23.573,
      "end": 24.677
    },
    {
      "id": "shot08-13",
      "text": "再看下面 5 个新手坑，",
      "start": 24.677,
      "end": 26.565
    },
    {
      "id": "shot08-14",
      "text": "就不是零散注意事项，",
      "start": 26.565,
      "end": 28.292
    },
    {
      "id": "shot08-15",
      "text": "而是刚才 demo 现象背后的工程规则。",
      "start": 28.292,
      "end": 31.164
    }
  ]
}
