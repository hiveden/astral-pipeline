  "shot08": [
    {
      "id": "shot08-0",
      "text": "工具讲完，",
      "start": 0.0,
      "end": 1.08
    },
    {
      "id": "shot08-1",
      "text": "做整章 KNN 的总结。",
      "start": 1.08,
      "end": 2.76
    },
    {
      "id": "shot08-2",
      "text": "从第 1 期到这一期，",
      "start": 2.76,
      "end": 4.1
    },
    {
      "id": "shot08-3",
      "text": "全部内容浓缩成一张图。",
      "start": 4.1,
      "end": 6.34
    },
    {
      "id": "shot08-4",
      "text": "核心算法只有一个：",
      "start": 6.34,
      "end": 8.02
    },
    {
      "id": "shot08-5",
      "text": "找 K 个最近邻。",
      "start": 8.02,
      "end": 9.38
    },
    {
      "id": "shot08-6",
      "text": "变种两个：",
      "start": 9.38,
      "end": 10.58
    },
    {
      "id": "shot08-7",
      "text": "分类投票预测离散类别，",
      "start": 10.58,
      "end": 12.78
    },
    {
      "id": "shot08-8",
      "text": "回归平均预测连续数字。",
      "start": 12.78,
      "end": 15.34
    },
    {
      "id": "shot08-9",
      "text": "围绕这个算法有三大问题。",
      "start": 15.34,
      "end": 17.46
    },
    {
      "id": "shot08-10",
      "text": "第一距离怎么算，",
      "start": 17.46,
      "end": 18.86
    },
    {
      "id": "shot08-11",
      "text": "欧氏距离公式族——一维数字差、二维勾股、",
      "start": 18.86,
      "end": 22.04
    },
    {
      "id": "shot08-12",
      "text": "N 维平方和开方；",
      "start": 22.04,
      "end": 23.46
    },
    {
      "id": "shot08-13",
      "text": "第 6 期展开了曼哈顿、切比雪夫、",
      "start": 23.46,
      "end": 26.02
    },
    {
      "id": "shot08-14",
      "text": "闵可夫斯基整个距离家族。",
      "start": 26.02,
      "end": 27.82
    },
    {
      "id": "shot08-15",
      "text": "第二 K 取多少，",
      "start": 28.19,
      "end": 29.69
    },
    {
      "id": "shot08-16",
      "text": "K 太小独裁过拟合贴噪声、",
      "start": 29.69,
      "end": 31.83
    },
    {
      "id": "shot08-17",
      "text": "K 太大全民投票绑架欠拟合，",
      "start": 31.83,
      "end": 34.21
    },
    {
      "id": "shot08-18",
      "text": "中段平台期任意挑，",
      "start": 34.21,
      "end": 36.71
    },
    {
      "id": "shot08-19",
      "text": "经验值约根号 N。",
      "start": 36.71,
      "end": 38.71
    },
    {
      "id": "shot08-20",
      "text": "第三决策边界长啥样，",
      "start": 38.71,
      "end": 40.99
    },
    {
      "id": "shot08-21",
      "text": "全平面预测地图——K=1 扭成噪声孤岛、",
      "start": 40.99,
      "end": 44.75
    },
    {
      "id": "shot08-22",
      "text": "K 适中平滑分界、",
      "start": 44.75,
      "end": 46.27
    },
    {
      "id": "shot08-23",
      "text": "K=N 整张图退化成多数类。",
      "start": 46.27,
      "end": 48.47
    },
    {
      "id": "shot08-24",
      "text": "sklearn 三大组件：",
      "start": 48.876,
      "end": 50.516
    },
    {
      "id": "shot08-25",
      "text": "KNeighborsClassifier分类、",
      "start": 50.516,
      "end": 52.336
    },
    {
      "id": "shot08-26",
      "text": "KNeighborsRegressor回归、",
      "start": 52.336,
      "end": 54.476
    },
    {
      "id": "shot08-27",
      "text": "GridSearchCV 调超参——这三",
      "start": 54.476,
      "end": 56.676
    },
    {
      "id": "shot08-28",
      "text": "个叫 sklearn 提供的工具，",
      "start": 56.676,
      "end": 58.976
    },
    {
      "id": "shot08-29",
      "text": "区别于 e04 / e05 学的 fit、",
      "start": 58.976,
      "end": 61.756
    },
    {
      "id": "shot08-30",
      "text": "predict、",
      "start": 61.756,
      "end": 62.536
    },
    {
      "id": "shot08-31",
      "text": "score 那三个动作。",
      "start": 62.536,
      "end": 64.216
    },
    {
      "id": "shot08-32",
      "text": "预处理纪律：",
      "start": 64.216,
      "end": 65.416
    },
    {
      "id": "shot08-33",
      "text": "归一化和标准化让量纲悬殊的特征对齐，",
      "start": 65.416,
      "end": 68.956
    },
    {
      "id": "shot08-34",
      "text": "标准化在训练集 fit 测试集",
      "start": 68.956,
      "end": 71.236
    },
    {
      "id": "shot08-35",
      "text": "transform 防数据泄漏。",
      "start": 71.236,
      "end": 72.936
    },
    {
      "id": "shot08-36",
      "text": "超参搜索完整方案：",
      "start": 73.344,
      "end": 75.084
    },
    {
      "id": "shot08-37",
      "text": "CV 给可信评分加网格搜索做完整组合搜索。",
      "start": 75.084,
      "end": 79.524
    },
    {
      "id": "shot08-38",
      "text": "一句话整章：",
      "start": 79.524,
      "end": 80.904
    },
    {
      "id": "shot08-39",
      "text": "KNN 看 K 个最近邻——核心一个找邻居，",
      "start": 80.904,
      "end": 85.324
    },
    {
      "id": "shot08-40",
      "text": "变种两个分类投票回归平均，",
      "start": 85.324,
      "end": 88.104
    },
    {
      "id": "shot08-41",
      "text": "调参靠 CV 加网格搜索。",
      "start": 88.104,
      "end": 90.484
    }
  ],
  "shot09": [
    {
      "id": "shot09-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.34
    },
    {
      "id": "shot09-1",
      "text": "这一期讲清楚的：",
      "start": 1.34,
      "end": 3.0
    },
    {
      "id": "shot09-2",
      "text": "网格搜索本质是穷举加 CV 评分、",
      "start": 3.0,
      "end": 6.16
    },
    {
      "id": "shot09-3",
      "text": "维度爆炸的训练次数公式、",
      "start": 6.16,
      "end": 8.46
    },
    {
      "id": "shot09-4",
      "text": "GridSearchCV 三件套、",
      "start": 8.46,
      "end": 10.28
    },
    {
      "id": "shot09-5",
      "text": "Pipeline 双下划线、",
      "start": 10.28,
      "end": 11.62
    },
    {
      "id": "shot09-6",
      "text": "Pipeline 防数据泄漏，",
      "start": 11.62,
      "end": 13.5
    },
    {
      "id": "shot09-7",
      "text": "加上手写数字综合实战。",
      "start": 13.5,
      "end": 16.14
    },
    {
      "id": "shot09-8",
      "text": "这一期点到没展开的：",
      "start": 16.14,
      "end": 18.4
    },
    {
      "id": "shot09-9",
      "text": "RandomizedSearchCV 和",
      "start": 18.4,
      "end": 20.06
    },
    {
      "id": "shot09-10",
      "text": "贝叶斯优化作为替代方案，",
      "start": 20.06,
      "end": 22.68
    },
    {
      "id": "shot09-11",
      "text": "留给后续模型优化章节；",
      "start": 22.68,
      "end": 24.98
    },
    {
      "id": "shot09-12",
      "text": "嵌套交叉验证 nested CV，",
      "start": 24.98,
      "end": 27.62
    },
    {
      "id": "shot09-13",
      "text": "复杂调参场景用，",
      "start": 27.62,
      "end": 29.16
    },
    {
      "id": "shot09-14",
      "text": "本章不需要。",
      "start": 29.16,
      "end": 30.84
    },
    {
      "id": "shot09-15",
      "text": "KNN 章节到这一期就完整了。",
      "start": 30.84,
      "end": 33.16
    },
    {
      "id": "shot09-16",
      "text": "下一站第 2 章逻辑回归",
      "start": 33.527,
      "end": 35.427
    },
    {
      "id": "shot09-17",
      "text": "logistic regression",
      "start": 35.427,
      "end": 36.747
    },
    {
      "id": "shot09-18",
      "text": "简称 LR。",
      "start": 36.747,
      "end": 38.107
    },
    {
      "id": "shot09-19",
      "text": "从 KNN 到 LR 思路有一个明显变化：",
      "start": 38.107,
      "end": 41.427
    },
    {
      "id": "shot09-20",
      "text": "KNN 没有训练阶段，",
      "start": 41.427,
      "end": 43.327
    },
    {
      "id": "shot09-21",
      "text": "整个数据集就是模型本身，",
      "start": 43.327,
      "end": 45.687
    },
    {
      "id": "shot09-22",
      "text": "预测时算距离遍历找邻居；",
      "start": 45.687,
      "end": 48.667
    },
    {
      "id": "shot09-23",
      "text": "LR 是真正学一个数学模型，",
      "start": 48.667,
      "end": 50.947
    },
    {
      "id": "shot09-24",
      "text": "训练阶段把数据浓缩成几个权重参数，",
      "start": 50.947,
      "end": 54.147
    },
    {
      "id": "shot09-25",
      "text": "预测时只做一次点积。",
      "start": 54.147,
      "end": 56.107
    },
    {
      "id": "shot09-26",
      "text": "KNN 把整个数据集当模型，",
      "start": 56.107,
      "end": 58.627
    },
    {
      "id": "shot09-27",
      "text": "LR 把数据浓缩成几个权重参数——后面学",
      "start": 58.627,
      "end": 62.047
    },
    {
      "id": "shot09-28",
      "text": "的算法基本都是后一种。",
      "start": 62.047,
      "end": 63.647
    },
    {
      "id": "shot09-29",
      "text": "02 章会展开过拟合、欠拟合、",
      "start": 63.904,
      "end": 66.644
    },
    {
      "id": "shot09-30",
      "text": "偏差方差权衡这一组前面提到没展开的几个概念，",
      "start": 66.644,
      "end": 70.924
    },
    {
      "id": "shot09-31",
      "text": "也会引入梯度下降、",
      "start": 70.924,
      "end": 72.484
    },
    {
      "id": "shot09-32",
      "text": "损失函数——KNN 时代的直觉描述会被严",
      "start": 72.484,
      "end": 75.844
    },
    {
      "id": "shot09-33",
      "text": "格定义替换。",
      "start": 75.844,
      "end": 76.964
    },
    {
      "id": "shot09-34",
      "text": "如果讲得有不对的地方，",
      "start": 76.964,
      "end": 78.984
    },
    {
      "id": "shot09-35",
      "text": "欢迎在评论区指正。下期见。",
      "start": 78.984,
      "end": 81.365
    }
  ]
}
