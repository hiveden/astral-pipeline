{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们解决了评分可信问题——交叉验证",
      "start": 0.0,
      "end": 3.48
    },
    {
      "id": "shot01-1",
      "text": "给一组超参打一个稳定分数。",
      "start": 3.48,
      "end": 6.44
    },
    {
      "id": "shot01-2",
      "text": "但选最优 k 还需要再走一步：",
      "start": 6.44,
      "end": 8.72
    },
    {
      "id": "shot01-3",
      "text": "让 k 跑过候选清单，",
      "start": 8.72,
      "end": 10.94
    },
    {
      "id": "shot01-4",
      "text": "每个 k 跑一次 CV，",
      "start": 10.94,
      "end": 13.06
    },
    {
      "id": "shot01-5",
      "text": "挑得分最高的那个。",
      "start": 13.06,
      "end": 15.1
    },
    {
      "id": "shot01-6",
      "text": "这一步如果 sklearn 自动化，",
      "start": 15.1,
      "end": 17.22
    },
    {
      "id": "shot01-7",
      "text": "我们写两行代码就能搞定。",
      "start": 17.22,
      "end": 19.56
    },
    {
      "id": "shot01-8",
      "text": "这一期讲的就是网格搜索",
      "start": 19.56,
      "end": 21.94
    },
    {
      "id": "shot01-9",
      "text": "GridSearchCV，",
      "start": 21.94,
      "end": 23.12
    },
    {
      "id": "shot01-10",
      "text": "CV 嵌套到外层超参循环里，",
      "start": 23.12,
      "end": 26.26
    },
    {
      "id": "shot01-11",
      "text": "一行调用拿最优组合。",
      "start": 26.26,
      "end": 28.04
    },
    {
      "id": "shot01-12",
      "text": "讲完工具就上综合实战：",
      "start": 28.457,
      "end": 30.697
    },
    {
      "id": "shot01-13",
      "text": "手写数字识别——这一期也是 KNN 章节最后一期，",
      "start": 30.697,
      "end": 34.397
    },
    {
      "id": "shot01-14",
      "text": "我们会做整章总结。",
      "start": 34.397,
      "end": 36.337
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先说网格搜索的思想，",
      "start": 0.0,
      "end": 1.88
    },
    {
      "id": "shot02-1",
      "text": "名字唬人本质就是穷举。",
      "start": 1.88,
      "end": 4.46
    },
    {
      "id": "shot02-2",
      "text": "类比试衣服：",
      "start": 4.46,
      "end": 5.74
    },
    {
      "id": "shot02-3",
      "text": "一件件试，",
      "start": 5.74,
      "end": 6.84
    },
    {
      "id": "shot02-4",
      "text": "每件再各角度照镜子定夺。",
      "start": 6.84,
      "end": 9.56
    },
    {
      "id": "shot02-5",
      "text": "每件衣服等于一组超参，",
      "start": 9.56,
      "end": 11.62
    },
    {
      "id": "shot02-6",
      "text": "照镜子等于这组超参的 CV 评分。",
      "start": 11.62,
      "end": 14.5
    },
    {
      "id": "shot02-7",
      "text": "网格这个名字的来历也很直接：",
      "start": 14.5,
      "end": 17.06
    },
    {
      "id": "shot02-8",
      "text": "把多个超参的候选值摆成表格，",
      "start": 17.06,
      "end": 19.94
    },
    {
      "id": "shot02-9",
      "text": "每个格子是一组组合。",
      "start": 19.94,
      "end": 22.22
    },
    {
      "id": "shot02-10",
      "text": "一维网格最简单，",
      "start": 22.22,
      "end": 23.68
    },
    {
      "id": "shot02-11",
      "text": "比如 k 取 1、3、5、7、9、11，",
      "start": 23.68,
      "end": 26.52
    },
    {
      "id": "shot02-12",
      "text": "6 个格子排成一行。",
      "start": 26.52,
      "end": 27.92
    },
    {
      "id": "shot02-13",
      "text": "二维网格再加一维，",
      "start": 28.316,
      "end": 29.936
    },
    {
      "id": "shot02-14",
      "text": "比如距离度量 metric 取",
      "start": 29.936,
      "end": 31.876
    },
    {
      "id": "shot02-15",
      "text": "euclidean 和",
      "start": 31.876,
      "end": 32.836
    },
    {
      "id": "shot02-16",
      "text": "manhattan 两个值，",
      "start": 32.836,
      "end": 34.296
    },
    {
      "id": "shot02-17",
      "text": "6 乘 2 等于 12 个格子排成一张二维表。",
      "start": 34.296,
      "end": 37.596
    },
    {
      "id": "shot02-18",
      "text": "每加一个超参就多一个维度，",
      "start": 37.596,
      "end": 39.956
    },
    {
      "id": "shot02-19",
      "text": "格子数线性维度但乘起来——这就是网格的几何来源。",
      "start": 39.956,
      "end": 44.416
    },
    {
      "id": "shot02-20",
      "text": "每个格子要跑一次完整 CV——所以总训练",
      "start": 44.416,
      "end": 47.616
    },
    {
      "id": "shot02-21",
      "text": "次数等于格子数乘以 CV 折数。",
      "start": 47.616,
      "end": 50.336
    },
    {
      "id": "shot02-22",
      "text": "前面单超参 1 维 6 格 cv=5，",
      "start": 50.336,
      "end": 53.276
    },
    {
      "id": "shot02-23",
      "text": "总训练次数就是 6 乘 5 等于 30次。",
      "start": 53.276,
      "end": 56.563
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "网格搜索看上去很美，",
      "start": 0.0,
      "end": 2.2
    },
    {
      "id": "shot03-1",
      "text": "但有一个工程上必须警惕的代价叫维度爆炸。",
      "start": 2.2,
      "end": 5.94
    },
    {
      "id": "shot03-2",
      "text": "来看几个数字。",
      "start": 5.94,
      "end": 7.16
    },
    {
      "id": "shot03-3",
      "text": "单超参 k 取 6 个值乘以 cv=4，",
      "start": 7.16,
      "end": 10.82
    },
    {
      "id": "shot03-4",
      "text": "总训练 24 次。",
      "start": 10.82,
      "end": 12.58
    },
    {
      "id": "shot03-5",
      "text": "加一维 metric 取 2 个值，",
      "start": 12.58,
      "end": 14.9
    },
    {
      "id": "shot03-6",
      "text": "6 乘 2 乘 4 等于 48 次。",
      "start": 14.9,
      "end": 17.5
    },
    {
      "id": "shot03-7",
      "text": "再加一维 weights 取",
      "start": 17.5,
      "end": 19.04
    },
    {
      "id": "shot03-8",
      "text": "uniform 和 distance，",
      "start": 19.04,
      "end": 20.84
    },
    {
      "id": "shot03-9",
      "text": "6 乘 2 乘 2 乘 4 等于 96次。",
      "start": 20.84,
      "end": 23.36
    },
    {
      "id": "shot03-10",
      "text": "如果你贪心一点，",
      "start": 23.755,
      "end": 25.27
    },
    {
      "id": "shot03-11",
      "text": "3 个超参各取 10 个值再用 cv=",
      "start": 25.27,
      "end": 28.44
    },
    {
      "id": "shot03-12",
      "text": "10——10 乘 10 乘 10 乘",
      "start": 28.44,
      "end": 30.442
    },
    {
      "id": "shot03-13",
      "text": "10 等于 10000 次训练。",
      "start": 30.442,
      "end": 32.163
    },
    {
      "id": "shot03-14",
      "text": "线性加超参带来指数级增长——超参数一多，",
      "start": 32.163,
      "end": 35.967
    },
    {
      "id": "shot03-15",
      "text": "网格搜索就跑不动。",
      "start": 35.967,
      "end": 38.269
    },
    {
      "id": "shot03-16",
      "text": "鸢尾花数据集小训练快，",
      "start": 38.269,
      "end": 40.692
    },
    {
      "id": "shot03-17",
      "text": "每次几毫秒，",
      "start": 40.692,
      "end": 42.153
    },
    {
      "id": "shot03-18",
      "text": "跑 180 次 1 秒搞定；",
      "start": 42.153,
      "end": 44.535
    },
    {
      "id": "shot03-19",
      "text": "换成大数据集像 MNIST 60000",
      "start": 44.535,
      "end": 47.138
    },
    {
      "id": "shot03-20",
      "text": "张图片训练 1 折要数分钟，",
      "start": 47.138,
      "end": 49.72
    },
    {
      "id": "shot03-21",
      "text": "180 次跑半天。",
      "start": 49.72,
      "end": 51.302
    },
    {
      "id": "shot03-22",
      "text": "所以工程上有几个替代方案这里点名不展开：",
      "start": 51.576,
      "end": 55.256
    },
    {
      "id": "shot03-23",
      "text": "粗调加细调两段策略，",
      "start": 55.256,
      "end": 57.596
    },
    {
      "id": "shot03-24",
      "text": "先在大跨度稀疏值上找区域、",
      "start": 57.596,
      "end": 59.976
    },
    {
      "id": "shot03-25",
      "text": "再在该区域密集采样；",
      "start": 59.976,
      "end": 61.876
    },
    {
      "id": "shot03-26",
      "text": "RandomizedSearchCV 随",
      "start": 61.876,
      "end": 63.556
    },
    {
      "id": "shot03-27",
      "text": "机采样而非穷举；",
      "start": 63.556,
      "end": 65.056
    },
    {
      "id": "shot03-28",
      "text": "贝叶斯优化用历史评分指导下一次采哪里。",
      "start": 65.056,
      "end": 68.636
    },
    {
      "id": "shot03-29",
      "text": "这些后续优化章节会展开，",
      "start": 68.636,
      "end": 70.776
    },
    {
      "id": "shot03-30",
      "text": "本期记住名字就行。",
      "start": 70.776,
      "end": 72.416
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "工具上 sklearn 把网格搜索封装成",
      "start": 0.0,
      "end": 3.12
    },
    {
      "id": "shot04-1",
      "text": "GridSearchCV，",
      "start": 3.12,
      "end": 4.647
    },
    {
      "id": "shot04-2",
      "text": "3 个核心参数：",
      "start": 4.647,
      "end": 6.42
    },
    {
      "id": "shot04-3",
      "text": "估计器对象、",
      "start": 6.42,
      "end": 7.56
    },
    {
      "id": "shot04-4",
      "text": "参数搜索字典、",
      "start": 7.56,
      "end": 8.76
    },
    {
      "id": "shot04-5",
      "text": "cv 折数。",
      "start": 8.76,
      "end": 9.94
    },
    {
      "id": "shot04-6",
      "text": "fit 一下就跑完整个网格。",
      "start": 9.94,
      "end": 12.44
    },
    {
      "id": "shot04-7",
      "text": "结果有 3 个属性最常用，",
      "start": 12.44,
      "end": 14.84
    },
    {
      "id": "shot04-8",
      "text": "俗称三件套：",
      "start": 14.84,
      "end": 16.18
    },
    {
      "id": "shot04-9",
      "text": "best_score 是最优 CV 得分，",
      "start": 16.18,
      "end": 18.6
    },
    {
      "id": "shot04-10",
      "text": "best_params 是最优超参组合一个字典，",
      "start": 18.6,
      "end": 21.94
    },
    {
      "id": "shot04-11",
      "text": "best_estimator 是已经用全",
      "start": 21.94,
      "end": 23.78
    },
    {
      "id": "shot04-12",
      "text": "训练集重训过的最优模型，",
      "start": 23.78,
      "end": 26.18
    },
    {
      "id": "shot04-13",
      "text": "可以直接调 predict。",
      "start": 26.18,
      "end": 27.599
    },
    {
      "id": "shot04-14",
      "text": "这里要讲一个 sklearn 的命名机制",
      "start": 27.799,
      "end": 30.319
    },
    {
      "id": "shot04-15",
      "text": "叫 Pipeline 双下划线。",
      "start": 30.319,
      "end": 32.199
    },
    {
      "id": "shot04-16",
      "text": "前面 e10 标准化和训练分两步写，",
      "start": 32.199,
      "end": 34.979
    },
    {
      "id": "shot04-17",
      "text": "到了网格搜索这里推荐用 Pipeline",
      "start": 34.979,
      "end": 37.579
    },
    {
      "id": "shot04-18",
      "text": "把这些步骤串成一个对象。",
      "start": 37.579,
      "end": 39.959
    },
    {
      "id": "shot04-19",
      "text": "比如 Pipeline 里第 1 步起名",
      "start": 39.959,
      "end": 41.759
    },
    {
      "id": "shot04-20",
      "text": "std 装",
      "start": 41.759,
      "end": 42.619
    },
    {
      "id": "shot04-21",
      "text": "StandardScaler、",
      "start": 42.619,
      "end": 43.519
    },
    {
      "id": "shot04-22",
      "text": "第 2 步起名 knn2 装",
      "start": 43.519,
      "end": 45.859
    },
    {
      "id": "shot04-23",
      "text": "KNeighborsClassifier。",
      "start": 45.859,
      "end": 47.099
    },
    {
      "id": "shot04-24",
      "text": "要在网格里调 KNN 的",
      "start": 47.527,
      "end": 49.287
    },
    {
      "id": "shot04-25",
      "text": "n_neighbors，",
      "start": 49.507,
      "end": 50.687
    },
    {
      "id": "shot04-26",
      "text": "参数字典写成 knn2 双下划线",
      "start": 50.687,
      "end": 53.427
    },
    {
      "id": "shot04-27",
      "text": "n_neighbors。",
      "start": 53.647,
      "end": 54.147
    },
    {
      "id": "shot04-28",
      "text": "这个机制告诉 sklearn 我要调的是",
      "start": 54.147,
      "end": 56.927
    },
    {
      "id": "shot04-29",
      "text": "knn2 这一步的",
      "start": 56.927,
      "end": 58.267
    },
    {
      "id": "shot04-30",
      "text": "n_neighbors——一个",
      "start": 58.347,
      "end": 59.447
    },
    {
      "id": "shot04-31",
      "text": "Pipeline 可能多步骤同名，",
      "start": 59.447,
      "end": 61.547
    },
    {
      "id": "shot04-32",
      "text": "双下划线消除歧义。",
      "start": 61.547,
      "end": 63.107
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "为什么标准化必须包进 Pipeline，",
      "start": 0.0,
      "end": 2.68
    },
    {
      "id": "shot05-1",
      "text": "不能在 CV 之前手动",
      "start": 2.68,
      "end": 4.16
    },
    {
      "id": "shot05-2",
      "text": "fit_transform？",
      "start": 4.16,
      "end": 5.52
    },
    {
      "id": "shot05-3",
      "text": "这是一个常见的工程错误，",
      "start": 5.52,
      "end": 7.7
    },
    {
      "id": "shot05-4",
      "text": "叫数据泄漏 data leakage 的一种。",
      "start": 7.7,
      "end": 10.5
    },
    {
      "id": "shot05-5",
      "text": "看错误做法：",
      "start": 10.5,
      "end": 11.9
    },
    {
      "id": "shot05-6",
      "text": "先在整个训练集上",
      "start": 11.9,
      "end": 13.26
    },
    {
      "id": "shot05-7",
      "text": "fit_transform 算出均值和方差，",
      "start": 13.26,
      "end": 15.98
    },
    {
      "id": "shot05-8",
      "text": "然后把标准化后的数据丢给",
      "start": 15.98,
      "end": 18.0
    },
    {
      "id": "shot05-9",
      "text": "cross_val_score。",
      "start": 18.0,
      "end": 19.38
    },
    {
      "id": "shot05-10",
      "text": "表面上没毛病——CV 切出来的训练折和验",
      "start": 19.38,
      "end": 22.52
    },
    {
      "id": "shot05-11",
      "text": "证折数据都已经是标准化的了。",
      "start": 22.52,
      "end": 24.38
    },
    {
      "id": "shot05-12",
      "text": "但仔细想：",
      "start": 24.878,
      "end": 25.598
    },
    {
      "id": "shot05-13",
      "text": "那一组均值方差是用整个训练集算的，",
      "start": 25.598,
      "end": 28.818
    },
    {
      "id": "shot05-14",
      "text": "验证折的数据在算 fit 时也参与了——",
      "start": 28.818,
      "end": 31.858
    },
    {
      "id": "shot05-15",
      "text": "CV 评分会偏乐观，",
      "start": 31.858,
      "end": 33.738
    },
    {
      "id": "shot05-16",
      "text": "因为验证折和训练折共享了一组统计量。",
      "start": 33.738,
      "end": 37.038
    },
    {
      "id": "shot05-17",
      "text": "正确做法是把",
      "start": 37.038,
      "end": 38.418
    },
    {
      "id": "shot05-18",
      "text": "StandardScaler 包进",
      "start": 38.418,
      "end": 39.678
    },
    {
      "id": "shot05-19",
      "text": "Pipeline。",
      "start": 39.678,
      "end": 40.158
    },
    {
      "id": "shot05-20",
      "text": "这样网格搜索每跑一折，",
      "start": 40.158,
      "end": 43.078
    },
    {
      "id": "shot05-21",
      "text": "Pipeline 自动只在该折的训练折",
      "start": 43.078,
      "end": 45.438
    },
    {
      "id": "shot05-22",
      "text": "fit_transform 算均值方差，",
      "start": 45.438,
      "end": 47.718
    },
    {
      "id": "shot05-23",
      "text": "再用同一组参数 transform 验证",
      "start": 47.718,
      "end": 49.918
    },
    {
      "id": "shot05-24",
      "text": "折——干净、",
      "start": 49.918,
      "end": 50.698
    },
    {
      "id": "shot05-25",
      "text": "无泄漏，每折独立。",
      "start": 50.698,
      "end": 52.755
    },
    {
      "id": "shot05-26",
      "text": "这条规则适用于所有有 fit",
      "start": 53.273,
      "end": 55.633
    },
    {
      "id": "shot05-27",
      "text": "transform 区分的预处理步骤，",
      "start": 55.633,
      "end": 57.893
    },
    {
      "id": "shot05-28",
      "text": "不只是标准化。",
      "start": 57.893,
      "end": 59.264
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "回到 demo 切到第 2 个 tab。",
      "start": 0.0,
      "end": 2.68
    },
    {
      "id": "shot06-1",
      "text": "这是 GridSearchCV 在鸢尾花",
      "start": 2.68,
      "end": 4.96
    },
    {
      "id": "shot06-2",
      "text": "上跑完的结果热力图。",
      "start": 4.96,
      "end": 6.693
    },
    {
      "id": "shot06-3",
      "text": "3 个维度：",
      "start": 6.693,
      "end": 7.94
    },
    {
      "id": "shot06-4",
      "text": "n_neighbors 从 1 到 29",
      "start": 7.94,
      "end": 9.56
    },
    {
      "id": "shot06-5",
      "text": "取 9 个值，",
      "start": 9.56,
      "end": 10.9
    },
    {
      "id": "shot06-6",
      "text": "weights 取 uniform 和",
      "start": 10.9,
      "end": 12.34
    },
    {
      "id": "shot06-7",
      "text": "distance，",
      "start": 12.34,
      "end": 13.06
    },
    {
      "id": "shot06-8",
      "text": "p 取 1 和 2——p=1 曼哈顿、",
      "start": 13.06,
      "end": 15.68
    },
    {
      "id": "shot06-9",
      "text": "p=2 欧氏。",
      "start": 15.68,
      "end": 17.2
    },
    {
      "id": "shot06-10",
      "text": "一共 36 组超参。",
      "start": 17.2,
      "end": 19.5
    },
    {
      "id": "shot06-11",
      "text": "CV 折数 5——总训练 180 次。",
      "start": 19.5,
      "end": 22.12
    },
    {
      "id": "shot06-12",
      "text": "图上 4 行 9 列，",
      "start": 22.502,
      "end": 24.262
    },
    {
      "id": "shot06-13",
      "text": "行是 weights 加 p 的 4 种组合，",
      "start": 24.262,
      "end": 27.362
    },
    {
      "id": "shot06-14",
      "text": "列是 k 值，",
      "start": 27.362,
      "end": 28.622
    },
    {
      "id": "shot06-15",
      "text": "每格颜色对应 5 折 CV 准确率，",
      "start": 28.622,
      "end": 31.882
    },
    {
      "id": "shot06-16",
      "text": "色深越深越准。横向看：",
      "start": 31.882,
      "end": 34.462
    },
    {
      "id": "shot06-17",
      "text": "k=1 波动大容易被噪声影响；",
      "start": 34.462,
      "end": 37.402
    },
    {
      "id": "shot06-18",
      "text": "k 适中 5 到 15 是平台期；",
      "start": 37.402,
      "end": 40.242
    },
    {
      "id": "shot06-19",
      "text": "k 太大比如 29 开始下降。纵向看：",
      "start": 40.242,
      "end": 43.882
    },
    {
      "id": "shot06-20",
      "text": "distance 加权一般略好或持平",
      "start": 43.882,
      "end": 46.202
    },
    {
      "id": "shot06-21",
      "text": "uniform；",
      "start": 46.202,
      "end": 47.142
    },
    {
      "id": "shot06-22",
      "text": "p=1 和 p=2 在 iris 上差距很小。",
      "start": 47.142,
      "end": 50.402
    },
    {
      "id": "shot06-23",
      "text": "最优组合在 distance 加权、p=2、k=9，",
      "start": 50.688,
      "end": 54.448
    },
    {
      "id": "shot06-24",
      "text": "CV 准确率 0.967。",
      "start": 54.448,
      "end": 56.548
    },
    {
      "id": "shot06-25",
      "text": "代码读出来就是 best_params",
      "start": 56.548,
      "end": 58.288
    },
    {
      "id": "shot06-26",
      "text": "字典告诉你最优超参，",
      "start": 58.288,
      "end": 60.248
    },
    {
      "id": "shot06-27",
      "text": "best_score 告诉你这组得分，",
      "start": 60.248,
      "end": 62.548
    },
    {
      "id": "shot06-28",
      "text": "best_estimator 给你已经用",
      "start": 62.548,
      "end": 64.268
    },
    {
      "id": "shot06-29",
      "text": "全训练集重训过的模型直接 predict。",
      "start": 64.268,
      "end": 66.788
    }
  ],
