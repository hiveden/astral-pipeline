      "end": 91.285
    },
    {
      "id": "shot07-40",
      "text": "450 张测试，",
      "start": 91.285,
      "end": 92.785
    },
    {
      "id": "shot07-41",
      "text": "最后整个测试集准确率 0.9844——",
