      "end": 42.576
    },
    {
      "id": "shot07-17",
      "text": "标题写真实标签和预测标签。",
      "start": 42.576,
      "end": 45.136
    },
    {
      "id": "shot07-18",
      "text": "右边 predict_proba 概率柱",
