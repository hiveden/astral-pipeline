{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "前两期我们把朴素贝叶斯的数学机器搭好了：",
      "start": 0.0,
      "end": 3.305
    },
    {
      "id": "shot01-1",
      "text": "贝叶斯公式负责翻方向，",
      "start": 3.305,
      "end": 5.468
    },
    {
      "id": "shot01-2",
      "text": "朴素假设负责拆联合概率，",
      "start": 5.468,
      "end": 7.671
    },
    {
      "id": "shot01-3",
      "text": "拉普拉斯平滑负责救零概率。",
      "start": 7.671,
      "end": 9.935
    },
    {
      "id": "shot01-4",
      "text": "这一期把它放进文本分类。",
      "start": 9.935,
      "end": 11.918
    },
    {
      "id": "shot01-5",
      "text": "任务很具体：",
      "start": 11.918,
      "end": 12.979
    },
    {
      "id": "shot01-6",
      "text": "给一条商品评论，",
      "start": 12.979,
      "end": 14.381
    },
    {
      "id": "shot01-7",
      "text": "判断它是好评还是差评。",
      "start": 14.381,
      "end": 16.725
    },
    {
      "id": "shot01-8",
      "text": "我们先用 4 条短评论手算一遍“书 垃圾",
      "start": 16.725,
      "end": 20.09
    },
    {
      "id": "shot01-9",
      "text": "”为什么更像差评，",
      "start": 20.09,
      "end": 21.552
    },
    {
      "id": "shot01-10",
      "text": "再看 sklearn 里怎么用",
      "start": 21.552,
      "end": 23.295
    },
    {
      "id": "shot01-11",
      "text": "CountVectorizer 和",
      "start": 23.295,
      "end": 24.657
    },
    {
      "id": "shot01-12",
      "text": "MultinomialNB 把同一套流程",
      "start": 24.657,
      "end": 27.0
    },
    {
      "id": "shot01-13",
      "text": "跑起来。",
      "start": 27.0,
      "end": 27.381
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先看一个极小的数据集。",
      "start": 0.0,
      "end": 1.988
    },
    {
      "id": "shot02-1",
      "text": "4 条评论，",
      "start": 1.988,
      "end": 2.754
    },
    {
      "id": "shot02-2",
      "text": "2 条好评，",
      "start": 2.754,
      "end": 3.481
    },
    {
      "id": "shot02-3",
      "text": "2 条差评。",
      "start": 3.481,
      "end": 4.281
    },
    {
      "id": "shot02-4",
      "text": "好评是“好 书”和“书 好”。",
      "start": 4.281,
      "end": 6.482
    },
    {
      "id": "shot02-5",
      "text": "差评是“垃圾 书”和“太 垃圾”。",
      "start": 6.482,
      "end": 8.982
    },
    {
      "id": "shot02-6",
      "text": "现在新来一条评论：",
      "start": 8.982,
      "end": 10.543
    },
    {
      "id": "shot02-7",
      "text": "“书 垃圾”。",
      "start": 10.543,
      "end": 11.343
    },
    {
      "id": "shot02-8",
      "text": "我们要比较两个概率：",
      "start": 11.343,
      "end": 12.924
    },
    {
      "id": "shot02-9",
      "text": "它是好评的概率，",
      "start": 12.924,
      "end": 14.264
    },
    {
      "id": "shot02-10",
      "text": "和它是差评的概率。",
      "start": 14.264,
      "end": 16.064
    },
    {
      "id": "shot02-11",
      "text": "因为好评和差评各 2 条，",
      "start": 16.064,
      "end": 18.145
    },
    {
      "id": "shot02-12",
      "text": "所以先验一样，",
      "start": 18.145,
      "end": 19.265
    },
    {
      "id": "shot02-13",
      "text": "都是 0.5。",
      "start": 19.265,
      "end": 20.226
    },
    {
      "id": "shot02-14",
      "text": "真正拉开差距的，",
      "start": 20.226,
      "end": 21.586
    },
    {
      "id": "shot02-15",
      "text": "是“书”和“垃圾”这两个词在两类评论里的",
      "start": 21.586,
      "end": 24.607
    },
    {
      "id": "shot02-16",
      "text": "出现次数。",
      "start": 24.607,
      "end": 25.167
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "词表一共有 4 个词：好、书、垃圾、",
      "start": 0.0,
      "end": 3.902
    },
    {
      "id": "shot03-1",
      "text": "太。好评里，",
      "start": 3.902,
      "end": 5.182
    },
    {
      "id": "shot03-2",
      "text": "“好”出现 2 次，",
      "start": 5.182,
      "end": 6.718
    },
    {
      "id": "shot03-3",
      "text": "“书”出现 2 次，",
      "start": 6.718,
      "end": 8.043
    },
    {
      "id": "shot03-4",
      "text": "“垃圾”和“太”都是 0 次。差评里，",
      "start": 8.043,
      "end": 11.32
    },
    {
      "id": "shot03-5",
      "text": "“书”出现 1 次，",
      "start": 11.32,
      "end": 12.545
    },
    {
      "id": "shot03-6",
      "text": "“垃圾”出现 2 次，",
      "start": 12.545,
      "end": 14.336
    },
    {
      "id": "shot03-7",
      "text": "“太”出现 1 次，",
      "start": 14.336,
      "end": 15.687
    },
    {
      "id": "shot03-8",
      "text": "“好”是 0 次。",
      "start": 15.687,
      "end": 16.927
    },
    {
      "id": "shot03-9",
      "text": "每个类别下总词数都是 4。",
      "start": 16.927,
      "end": 19.588
    },
    {
      "id": "shot03-10",
      "text": "现在加拉普拉斯平滑，",
      "start": 19.588,
      "end": 21.84
    },
    {
      "id": "shot03-11",
      "text": "α 取 1，",
      "start": 21.84,
      "end": 23.054
    },
    {
      "id": "shot03-12",
      "text": "分母就是类别总词数 4，",
      "start": 23.054,
      "end": 25.302
    },
    {
      "id": "shot03-13",
      "text": "加词表大小 4，等于 8。",
      "start": 25.302,
      "end": 27.871
    },
    {
      "id": "shot03-14",
      "text": "所以 P(书|好评) 是 3/8，",
      "start": 27.871,
      "end": 30.56
    },
    {
      "id": "shot03-15",
      "text": "P(垃圾|好评) 是 1/8。",
      "start": 30.56,
      "end": 32.507
    },
    {
      "id": "shot03-16",
      "text": "P(书|差评) 是 2/8，",
      "start": 32.996,
      "end": 34.681
    },
    {
      "id": "shot03-17",
      "text": "P(垃圾|差评) 是 3/8。注意，",
      "start": 34.681,
      "end": 36.668
    },
    {
      "id": "shot03-18",
      "text": "如果不平滑，",
      "start": 36.668,
      "end": 37.785
    },
    {
      "id": "shot03-19",
      "text": "P(垃圾|好评) 会是 0，",
      "start": 37.785,
      "end": 39.377
    },
    {
      "id": "shot03-20",
      "text": "好评这一类会直接被一票否决。",
      "start": 39.377,
      "end": 41.544
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "接下来比较两个类别的分子。",
      "start": 0.0,
      "end": 2.123
    },
    {
      "id": "shot04-1",
      "text": "好评分子等于 P(书|好评) 乘 P(垃",
      "start": 2.123,
      "end": 4.967
    },
    {
      "id": "shot04-2",
      "text": "圾|好评) 再乘 P(好评)。",
      "start": 4.967,
      "end": 6.77
    },
    {
      "id": "shot04-3",
      "text": "也就是 3/8 乘 1/8 乘 0.5，",
      "start": 6.77,
      "end": 9.574
    },
    {
      "id": "shot04-4",
      "text": "等于 3/128，",
      "start": 9.574,
      "end": 11.517
    },
    {
      "id": "shot04-5",
      "text": "约 0.0234。",
      "start": 11.517,
      "end": 13.059
    },
    {
      "id": "shot04-6",
      "text": "差评分子等于 P(书|差评) 乘 P(垃",
      "start": 13.059,
      "end": 15.723
    },
    {
      "id": "shot04-7",
      "text": "圾|差评) 再乘 P(差评)。",
      "start": 15.723,
      "end": 17.606
    },
    {
      "id": "shot04-8",
      "text": "也就是 2/8 乘 3/8 乘 0.5，",
      "start": 17.606,
      "end": 20.31
    },
    {
      "id": "shot04-9",
      "text": "等于 3/64，",
      "start": 20.31,
      "end": 21.872
    },
    {
      "id": "shot04-10",
      "text": "也可以写成 6/128，",
      "start": 21.872,
      "end": 23.595
    },
    {
      "id": "shot04-11",
      "text": "约 0.0469。",
      "start": 23.595,
      "end": 25.478
    },
    {
      "id": "shot04-12",
      "text": "差评分子是好评分子的 2 倍，",
      "start": 25.478,
      "end": 27.901
    },
    {
      "id": "shot04-13",
      "text": "所以“书 垃圾”判为差评。",
      "start": 27.901,
      "end": 29.504
    },
    {
      "id": "shot04-14",
      "text": "如果把两个分子归一化，",
      "start": 29.99,
      "end": 32.116
    },
    {
      "id": "shot04-15",
      "text": "好评是 1/3，",
      "start": 32.116,
      "end": 33.72
    },
    {
      "id": "shot04-16",
      "text": "约 33.3%；",
      "start": 33.72,
      "end": 35.404
    },
    {
      "id": "shot04-17",
      "text": "差评是 2/3，",
      "start": 35.404,
      "end": 36.748
    },
    {
      "id": "shot04-18",
      "text": "约 66.7%。",
      "start": 36.748,
      "end": 37.871
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "sklearn 里朴素贝叶斯不是只有一个",
      "start": 0.0,
      "end": 2.565
    },
    {
      "id": "shot05-1",
      "text": "类，",
      "start": 2.565,
      "end": 2.945
    },
    {
      "id": "shot05-2",
      "text": "而是一组按特征分布选择的模型。",
      "start": 2.945,
      "end": 5.49
    },
    {
      "id": "shot05-3",
      "text": "MultinomialNB，",
      "start": 5.49,
      "end": 6.772
    },
    {
      "id": "shot05-4",
      "text": "multinomial naive",
      "start": 6.772,
      "end": 8.094
    },
    {
      "id": "shot05-5",
      "text": "Bayes，",
      "start": 8.094,
      "end": 8.755
    },
    {
      "id": "shot05-6",
      "text": "适合离散计数，",
      "start": 8.755,
      "end": 9.958
    },
    {
      "id": "shot05-7",
      "text": "最典型就是文本词频或者 TF-IDF。",
      "start": 9.958,
      "end": 12.362
    },
    {
      "id": "shot05-8",
      "text": "BernoulliNB，",
      "start": 12.362,
      "end": 14.445
    },
    {
      "id": "shot05-9",
      "text": "Bernoulli naive",
      "start": 14.445,
      "end": 15.407
    },
    {
      "id": "shot05-10",
      "text": "Bayes，",
      "start": 15.407,
      "end": 16.088
    },
    {
      "id": "shot05-11",
      "text": "适合 0/1 特征，",
      "start": 16.088,
      "end": 17.371
    },
    {
      "id": "shot05-12",
      "text": "比如只关心某个词有没有出现，",
      "start": 17.371,
      "end": 19.715
    },
    {
      "id": "shot05-13",
      "text": "不关心出现几次。",
      "start": 19.715,
      "end": 21.037
    },
    {
      "id": "shot05-14",
      "text": "GaussianNB，",
      "start": 21.281,
      "end": 22.183
    },
    {
      "id": "shot05-15",
      "text": "Gaussian naive Bayes，",
      "start": 22.183,
      "end": 24.167
    },
    {
      "id": "shot05-16",
      "text": "适合连续数值特征，",
      "start": 24.167,
      "end": 26.09
    },
    {
      "id": "shot05-17",
      "text": "并假设每个特征在类别里大致服从高斯分布。",
      "start": 26.09,
      "end": 30.319
    },
    {
      "id": "shot05-18",
      "text": "商品评论里，",
      "start": 30.319,
      "end": 31.3
    },
    {
      "id": "shot05-19",
      "text": "我们拿到的是词频矩阵，",
      "start": 31.3,
      "end": 33.264
    },
    {
      "id": "shot05-20",
      "text": "所以优先选 MultinomialNB。",
      "start": 33.264,
      "end": 35.448
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "真实中文评论不能直接丢给模型。第一步，",
      "start": 0.0,
      "end": 3.283
    },
    {
      "id": "shot06-1",
      "text": "读入 CSV，",
      "start": 3.283,
      "end": 4.344
    },
    {
      "id": "shot06-2",
      "text": "拿到内容列和评价列。第二步，",
      "start": 4.344,
      "end": 6.606
    },
    {
      "id": "shot06-3",
      "text": "把标签转成数字，",
      "start": 6.606,
      "end": 8.127
    },
    {
      "id": "shot06-4",
      "text": "比如好评是 1，",
      "start": 8.127,
      "end": 9.448
    },
    {
      "id": "shot06-5",
      "text": "差评是 0。第三步，",
      "start": 9.448,
      "end": 11.11
    },
    {
      "id": "shot06-6",
      "text": "用 jieba 做中文分词，",
      "start": 11.11,
      "end": 12.871
    },
    {
      "id": "shot06-7",
      "text": "把“很好的入门书”切成“很 好 的 入门",
      "start": 12.871,
      "end": 15.594
    },
    {
      "id": "shot06-8",
      "text": "书”这样的词序列。第四步，",
      "start": 15.594,
      "end": 18.056
    },
    {
      "id": "shot06-9",
      "text": "去掉停用词，",
      "start": 18.056,
      "end": 19.077
    },
    {
      "id": "shot06-10",
      "text": "比如“的”“了”“很”这种高频但区分度弱",
      "start": 19.077,
      "end": 22.26
    },
    {
      "id": "shot06-11",
      "text": "的词。第五步，",
      "start": 22.26,
      "end": 23.421
    },
    {
      "id": "shot06-12",
      "text": "用 CountVectorizer 把分",
      "start": 23.421,
      "end": 25.262
    },
    {
      "id": "shot06-13",
      "text": "词后的文本转成词频矩阵。到这一步，",
      "start": 25.262,
      "end": 28.095
    },
    {
      "id": "shot06-14",
      "text": "句子才变成模型能读的数字表。",
      "start": 28.095,
      "end": 30.507
    },
    {
      "id": "shot06-15",
      "text": "最后再划分训练集和测试集，",
      "start": 30.732,
      "end": 32.99
    },
    {
      "id": "shot06-16",
      "text": "交给 MultinomialNB 训练、",
      "start": 32.99,
      "end": 35.087
    },
    {
      "id": "shot06-17",
      "text": "预测、评估。",
      "start": 35.087,
      "end": 36.055
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "代码里核心是三步。第一，",
      "start": 0.0,
      "end": 2.122
    },
    {
      "id": "shot07-1",
      "text": "分词后用空格拼回字符串，",
      "start": 2.122,
      "end": 4.424
    },
    {
      "id": "shot07-2",
      "text": "因为 CountVectorizer 通",
      "start": 4.424,
      "end": 5.886
    },
    {
      "id": "shot07-3",
      "text": "常按空白切词。第二，",
      "start": 5.886,
      "end": 7.748
    },
    {
      "id": "shot07-4",
      "text": "调用 fit transform，",
      "start": 7.748,
      "end": 9.329
    },
    {
      "id": "shot07-5",
      "text": "把训练评论变成词频矩阵。第三，",
      "start": 9.329,
      "end": 12.332
    },
    {
      "id": "shot07-6",
      "text": "用 MultinomialNB 训练模型，",
      "start": 12.332,
      "end": 14.574
    },
    {
      "id": "shot07-7",
      "text": "并把 α 设成 1.0。",
      "start": 14.574,
      "end": 16.45
    },
    {
      "id": "shot07-8",
      "text": "α 等于 1.0，",
      "start": 16.45,
      "end": 18.138
    },
    {
      "id": "shot07-9",
      "text": "就对应上一期讲的拉普拉斯平滑。",
      "start": 18.138,
      "end": 20.46
    },
    {
      "id": "shot07-10",
      "text": "预测时，",
      "start": 20.736,
      "end": 21.478
    },
    {
      "id": "shot07-11",
      "text": "predict 输出类别，比如差评；",
      "start": 21.478,
      "end": 24.205
    },
    {
      "id": "shot07-12",
      "text": "predict proba 输出每个类别",
      "start": 24.205,
      "end": 26.431
    },
    {
      "id": "shot07-13",
      "text": "的概率估计，",
      "start": 26.431,
      "end": 27.474
    },
    {
      "id": "shot07-14",
      "text": "比如好评约 0.333，",
      "start": 27.474,
      "end": 29.66
    },
    {
      "id": "shot07-15",
      "text": "差评约 0.667。",
      "start": 29.66,
      "end": 31.464
    },
    {
      "id": "shot07-16",
      "text": "这里还要注意一个版本问题：",
      "start": 31.464,
      "end": 33.39
    },
    {
      "id": "shot07-17",
      "text": "旧代码里的 get feature",
      "start": 33.39,
      "end": 34.954
    },
    {
      "id": "shot07-18",
      "text": "names 已经过时，",
      "start": 34.954,
      "end": 36.678
    },
    {
      "id": "shot07-19",
      "text": "现在统一用 get feature",
      "start": 36.678,
      "end": 38.583
    },
    {
      "id": "shot07-20",
      "text": "names out。",
      "start": 38.583,
      "end": 39.125
    }
  ],
  "shot08": [
    {
      "id": "shot08-0",
      "text": "最后收几个常见坑。第一，",
      "start": 0.0,
      "end": 2.343
    },
    {
      "id": "shot08-1",
      "text": "中文原句不要直接丢给",
      "start": 2.343,
      "end": 4.025
    },
    {
      "id": "shot08-2",
      "text": "CountVectorizer，先分词，",
      "start": 4.025,
      "end": 6.007
    },
    {
      "id": "shot08-3",
      "text": "再用空格拼接。第二，",
      "start": 6.007,
      "end": 7.829
    },
    {
      "id": "shot08-4",
      "text": "停用词要自己准备，",
      "start": 7.829,
      "end": 9.651
    },
    {
      "id": "shot08-5",
      "text": "sklearn 自带的英文停用词不适合中",
      "start": 9.651,
      "end": 12.435
    },
    {
      "id": "shot08-6",
      "text": "文。第三，",
      "start": 12.435,
      "end": 13.596
    },
    {
      "id": "shot08-7",
      "text": "predict proba 不要当成绝对",
      "start": 13.596,
      "end": 15.819
    },
    {
      "id": "shot08-8",
      "text": "可靠的置信度，",
      "start": 15.819,
      "end": 17.1
    },
    {
      "id": "shot08-9",
      "text": "朴素假设会影响概率校准，",
      "start": 17.1,
      "end": 19.403
    },
    {
      "id": "shot08-10",
      "text": "它的类别排序通常比概率绝对值更可信。",
      "start": 19.403,
      "end": 22.947
    },
    {
      "id": "shot08-11",
      "text": "第四，",
      "start": 22.947,
      "end": 23.508
    },
    {
      "id": "shot08-12",
      "text": "词频是离散计数，",
      "start": 23.508,
      "end": 24.93
    },
    {
      "id": "shot08-13",
      "text": "优先用 MultinomialNB，",
      "start": 24.93,
      "end": 26.792
    },
    {
      "id": "shot08-14",
      "text": "不要随手套 GaussianNB。",
      "start": 26.792,
      "end": 28.314
    },
    {
      "id": "shot08-15",
      "text": "到这里，",
      "start": 28.864,
      "end": 29.427
    },
    {
      "id": "shot08-16",
      "text": "朴素贝叶斯这一章就闭环了：",
      "start": 29.427,
      "end": 31.577
    },
    {
      "id": "shot08-17",
      "text": "先用贝叶斯翻方向，",
      "start": 31.577,
      "end": 33.165
    },
    {
      "id": "shot08-18",
      "text": "再用朴素假设拆概率，",
      "start": 33.165,
      "end": 34.874
    },
    {
      "id": "shot08-19",
      "text": "最后用平滑和词频矩阵落到文本分类。",
      "start": 34.874,
      "end": 37.628
    }
  ],
  "shot09": [
    {
      "id": "shot09-0",
      "text": "下章见，",
      "start": 0.0,
      "end": 0.747
    },
    {
      "id": "shot09-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.747,
