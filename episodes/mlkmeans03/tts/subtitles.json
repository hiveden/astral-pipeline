{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期我们用一行 fit_predict",
      "start": 0.0,
      "end": 2.222
    },
    {
      "id": "shot01-1",
      "text": "跑完了聚类。",
      "start": 2.222,
      "end": 3.343
    },
    {
      "id": "shot01-2",
      "text": "这一期把这行代码打开，",
      "start": 3.343,
      "end": 5.064
    },
    {
      "id": "shot01-3",
      "text": "看里面到底发生了什么。",
      "start": 5.064,
      "end": 6.966
    },
    {
      "id": "shot01-4",
      "text": "K-Means 的流程其实很朴素：",
      "start": 6.966,
      "end": 9.328
    },
    {
      "id": "shot01-5",
      "text": "先临时放几个质心，",
      "start": 9.328,
      "end": 11.149
    },
    {
      "id": "shot01-6",
      "text": "再让每个样本去找离自己最近的质心，",
      "start": 11.149,
      "end": 14.212
    },
    {
      "id": "shot01-7",
      "text": "然后把质心挪到这一簇样本的平均位置。",
      "start": 14.212,
      "end": 17.775
    },
    {
      "id": "shot01-8",
      "text": "反复做这两件事，",
      "start": 17.775,
      "end": 19.016
    },
    {
      "id": "shot01-9",
      "text": "直到质心不再明显变化。",
      "start": 19.016,
      "end": 21.217
    },
    {
      "id": "shot01-10",
      "text": "它不像神秘黑箱，",
      "start": 21.217,
      "end": 22.799
    },
    {
      "id": "shot01-11",
      "text": "更像操场上分集合点：",
      "start": 22.799,
      "end": 24.78
    },
    {
      "id": "shot01-12",
      "text": "学生先按最近旗子排队，",
      "start": 24.78,
      "end": 27.002
    },
    {
      "id": "shot01-13",
      "text": "老师再把旗子挪到队伍中心。",
      "start": 27.002,
      "end": 28.904
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "正式流程分 4 步。第一，",
      "start": 0.0,
      "end": 1.922
    },
    {
      "id": "shot02-1",
      "text": "先确定常数 K，",
      "start": 1.922,
      "end": 3.503
    },
    {
      "id": "shot02-2",
      "text": "也就是最终要分几个簇。第二，",
      "start": 3.503,
      "end": 5.645
    },
    {
      "id": "shot02-3",
      "text": "随机选择 K 个点作为初始聚类中心。",
      "start": 5.645,
      "end": 8.747
    },
    {
      "id": "shot02-4",
      "text": "第三，",
      "start": 8.747,
      "end": 9.147
    },
    {
      "id": "shot02-5",
      "text": "计算每个样本到 K 个中心的距离，",
      "start": 9.147,
      "end": 11.81
    },
    {
      "id": "shot02-6",
      "text": "把样本分给最近的中心。第四，",
      "start": 11.81,
      "end": 14.712
    },
    {
      "id": "shot02-7",
      "text": "根据每个簇里的样本点，",
      "start": 14.712,
      "end": 16.574
    },
    {
      "id": "shot02-8",
      "text": "重新计算平均位置，",
      "start": 16.574,
      "end": 18.135
    },
    {
      "id": "shot02-9",
      "text": "得到新的质心。",
      "start": 18.135,
      "end": 19.376
    },
    {
      "id": "shot02-10",
      "text": "如果新质心和上一轮一样，",
      "start": 19.376,
      "end": 21.437
    },
    {
      "id": "shot02-11",
      "text": "或者变化已经很小，就停止；",
      "start": 21.437,
      "end": 23.799
    },
    {
      "id": "shot02-12",
      "text": "否则回到第三步继续。",
      "start": 23.799,
      "end": 25.941
    },
    {
      "id": "shot02-13",
      "text": "把话压缩到最短，",
      "start": 25.941,
      "end": 27.522
    },
    {
      "id": "shot02-14",
      "text": "就是两个动作交替做：",
      "start": 27.522,
      "end": 29.464
    },
    {
      "id": "shot02-15",
      "text": "固定质心时分配样本，",
      "start": 29.464,
      "end": 31.447
    },
    {
      "id": "shot02-16",
      "text": "固定分组时更新质心。",
      "start": 31.447,
      "end": 33.105
    },
    {
      "id": "shot02-17",
      "text": "K-Means 的全部动画，",
      "start": 33.532,
      "end": 35.313
    },
    {
      "id": "shot02-18",
      "text": "基本都在演这两个动作。",
      "start": 35.313,
      "end": 37.154
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "那什么叫分得好？",
      "start": 0.0,
      "end": 1.22
    },
    {
      "id": "shot03-1",
      "text": "K-Means 用的是簇内平方误差和，",
      "start": 1.22,
      "end": 3.781
    },
    {
      "id": "shot03-2",
      "text": "也就是 SSE。直觉上，",
      "start": 3.781,
      "end": 5.862
    },
    {
      "id": "shot03-3",
      "text": "每个样本都要向自己所属的质心交一笔距离罚",
      "start": 5.862,
      "end": 9.563
    },
    {
      "id": "shot03-4",
      "text": "款，",
      "start": 9.563,
      "end": 9.883
    },
    {
      "id": "shot03-5",
      "text": "距离越远罚得越重，",
      "start": 9.883,
      "end": 11.743
    },
    {
      "id": "shot03-6",
      "text": "而且罚的是距离平方。",
      "start": 11.743,
      "end": 13.564
    },
    {
      "id": "shot03-7",
      "text": "所有样本的罚款加起来，",
      "start": 13.564,
      "end": 15.384
    },
    {
      "id": "shot03-8",
      "text": "就是目标函数。公式写成：",
      "start": 15.384,
      "end": 17.845
    },
    {
      "id": "shot03-9",
      "text": "对每个簇，",
      "start": 17.845,
      "end": 18.945
    },
    {
      "id": "shot03-10",
      "text": "把簇内样本到本簇质心的距离平方加起来，",
      "start": 18.945,
      "end": 22.786
    },
    {
      "id": "shot03-11",
      "text": "再把所有簇相加。",
      "start": 22.786,
      "end": 24.347
    },
    {
      "id": "shot03-12",
      "text": "K-Means 每一轮分配和更新，",
      "start": 24.347,
      "end": 26.867
    },
    {
      "id": "shot03-13",
      "text": "都会让这笔总罚款不增加。",
      "start": 26.867,
      "end": 29.048
    },
    {
      "id": "shot03-14",
      "text": "质心挪到一簇样本的平均位置，",
      "start": 29.048,
      "end": 31.543
    },
    {
      "id": "shot03-15",
      "text": "就是为了让这簇内部的平方距离总和尽量小。",
      "start": 31.543,
      "end": 35.164
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "手算一轮 K-Means，",
      "start": 0.0,
      "end": 1.642
    },
    {
      "id": "shot04-1",
      "text": "可以固定用一张表。",
      "start": 1.642,
      "end": 3.364
    },
    {
      "id": "shot04-2",
      "text": "假设 K=2，",
      "start": 3.364,
      "end": 4.885
    },
    {
      "id": "shot04-3",
      "text": "有两个初始质心 P1 和 P2。",
      "start": 4.885,
      "end": 7.468
    },
    {
      "id": "shot04-4",
      "text": "对每个样本，",
      "start": 7.468,
      "end": 8.629
    },
    {
      "id": "shot04-5",
      "text": "先算它到 P1 的欧氏距离，",
      "start": 8.629,
      "end": 10.792
    },
    {
      "id": "shot04-6",
      "text": "再算它到 P2 的欧氏距离，",
      "start": 10.792,
      "end": 12.934
    },
    {
      "id": "shot04-7",
      "text": "谁更近就归到谁那一簇。",
      "start": 12.934,
      "end": 15.076
    },
    {
      "id": "shot04-8",
      "text": "所有样本分完以后，",
      "start": 15.076,
      "end": 16.737
    },
    {
      "id": "shot04-9",
      "text": "对每个簇分别求坐标平均值。",
      "start": 16.737,
      "end": 19.74
    },
    {
      "id": "shot04-10",
      "text": "比如一簇里有 3 个二维点，",
      "start": 19.74,
      "end": 21.941
    },
    {
      "id": "shot04-11",
      "text": "就把 3 个 x 坐标相加除以 3，",
      "start": 21.941,
      "end": 24.844
    },
    {
      "id": "shot04-12",
      "text": "把 3 个 y 坐标相加除以 3，",
      "start": 24.844,
      "end": 27.306
    },
    {
      "id": "shot04-13",
      "text": "得到新质心。",
      "start": 27.306,
      "end": 28.526
    },
    {
      "id": "shot04-14",
      "text": "下一轮再拿新质心重新算距离、重新分配、",
      "start": 28.526,
      "end": 32.069
    },
    {
      "id": "shot04-15",
      "text": "重新求平均。",
      "start": 32.069,
      "end": 32.91
    },
    {
      "id": "shot04-16",
      "text": "这个练习要你记住的不是某个具体数字，",
      "start": 33.614,
      "end": 36.849
    },
    {
      "id": "shot04-17",
      "text": "而是固定格式：",
      "start": 36.849,
      "end": 38.335
    },
    {
      "id": "shot04-18",
      "text": "距离决定归属，",
      "start": 38.335,
      "end": 39.883
    },
    {
      "id": "shot04-19",
      "text": "均值决定新质心。",
      "start": 39.883,
      "end": 41.289
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "K-Means 为什么会停？",
      "start": 0.0,
      "end": 1.541
    },
    {
      "id": "shot05-1",
      "text": "因为每次完整的分配样本和更新质心，",
      "start": 1.541,
      "end": 4.484
    },
    {
      "id": "shot05-2",
      "text": "目标函数都不会上升。",
      "start": 4.484,
      "end": 6.405
    },
    {
      "id": "shot05-3",
      "text": "样本数是有限的，",
      "start": 6.405,
      "end": 7.626
    },
    {
      "id": "shot05-4",
      "text": "可能出现的簇划分也是有限的，",
      "start": 7.626,
      "end": 9.968
    },
    {
      "id": "shot05-5",
      "text": "所以它不可能无限下降。",
      "start": 9.968,
      "end": 11.849
    },
    {
      "id": "shot05-6",
      "text": "停下来以后，",
      "start": 11.849,
      "end": 12.65
    },
    {
      "id": "shot05-7",
      "text": "我们说算法收敛了。",
      "start": 12.65,
      "end": 14.151
    },
    {
      "id": "shot05-8",
      "text": "但收敛不等于找到全局最优。",
      "start": 14.151,
      "end": 16.873
    },
    {
      "id": "shot05-9",
      "text": "初始质心如果选得不好，",
      "start": 16.873,
      "end": 18.795
    },
    {
      "id": "shot05-10",
      "text": "算法可能停在一个局部较好的结果上。",
      "start": 18.795,
      "end": 21.757
    },
    {
      "id": "shot05-11",
      "text": "换一组初始点，",
      "start": 21.757,
      "end": 22.861
    },
    {
      "id": "shot05-12",
      "text": "最后结果可能不一样。",
      "start": 22.861,
      "end": 24.485
    },
    {
      "id": "shot05-13",
      "text": "这也是为什么工程实现里会有更聪明的初始化",
      "start": 24.485,
      "end": 27.835
    },
    {
      "id": "shot05-14",
      "text": "策略，",
      "start": 27.835,
      "end": 28.356
    },
    {
      "id": "shot05-15",
      "text": "也会关心随机种子和初始化次数。",
      "start": 28.356,
      "end": 30.823
    },
    {
      "id": "shot05-16",
      "text": "本期不展开 k-means++ 的细节，",
      "start": 31.295,
      "end": 33.665
    },
    {
      "id": "shot05-17",
      "text": "只要先知道：",
      "start": 33.665,
      "end": 34.568
    },
    {
      "id": "shot05-18",
      "text": "初始化会影响结果，",
      "start": 34.568,
      "end": 36.215
    },
    {
      "id": "shot05-19",
      "text": "固定 random_state 是为了让",
      "start": 36.215,
      "end": 37.902
    },
    {
      "id": "shot05-20",
      "text": "实验可复现。",
      "start": 37.902,
      "end": 38.705
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "流程最后还有一个很重要的思考题：",
      "start": 0.0,
      "end": 3.023
    },
    {
      "id": "shot06-1",
      "text": "数据是否需要标准化或归一化？",
      "start": 3.023,
      "end": 6.145
    },
    {
      "id": "shot06-2",
      "text": "答案取决于特征量纲。",
      "start": 6.145,
      "end": 8.147
    },
    {
      "id": "shot06-3",
      "text": "如果两个维度都是同一种平面坐标，",
      "start": 8.147,
      "end": 11.009
    },
    {
      "id": "shot06-4",
      "text": "通常问题不大；",
      "start": 11.009,
      "end": 12.47
    },
    {
      "id": "shot06-5",
      "text": "如果一个维度是年龄，",
      "start": 12.47,
      "end": 14.012
    },
    {
      "id": "shot06-6",
      "text": "另一个维度是年收入，",
      "start": 14.012,
      "end": 15.873
    },
    {
      "id": "shot06-7",
      "text": "收入的数值范围可能远大于年龄，",
      "start": 15.873,
      "end": 18.696
    },
    {
      "id": "shot06-8",
      "text": "K-Means 就会主要按收入分簇。",
      "start": 18.696,
      "end": 21.438
    },
    {
      "id": "shot06-9",
      "text": "因为它的每一步都在算距离，",
      "start": 21.438,
      "end": 23.42
    },
    {
      "id": "shot06-10",
      "text": "距离被哪个特征主导，",
      "start": 23.42,
      "end": 25.261
    },
    {
      "id": "shot06-11",
      "text": "聚类结果就会被哪个特征主导。",
      "start": 25.261,
      "end": 27.704
    },
    {
      "id": "shot06-12",
      "text": "这个点我们在综合案例里还会再提醒。",
      "start": 27.704,
      "end": 30.842
    },
    {
      "id": "shot06-13",
      "text": "下一期先解决另一个更直接的问题：",
      "start": 30.842,
      "end": 33.738
    },
    {
      "id": "shot06-14",
      "text": "K 到底取几？",
      "start": 33.738,
      "end": 34.603
    },
    {
      "id": "shot06-15",
      "text": "我们从 SSE 和肘部法开始。",
      "start": 35.079,
      "end": 37.208
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.771
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.771,
      "end": 2.151
    }
  ]
}
