{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "想象一张 CT 片，",
      "start": 0.0,
      "end": 1.442
    },
    {
      "id": "shot01-1",
      "text": "医生要判断有没有肿瘤。",
      "start": 1.442,
      "end": 3.304
    },
    {
      "id": "shot01-2",
      "text": "单个医生可能疲劳，",
      "start": 3.304,
      "end": 4.825
    },
    {
      "id": "shot01-3",
      "text": "也可能被某个模糊阴影带偏。",
      "start": 4.825,
      "end": 7.048
    },
    {
      "id": "shot01-4",
      "text": "那医院遇到疑难病例时，",
      "start": 7.048,
      "end": 8.83
    },
    {
      "id": "shot01-5",
      "text": "通常不会只让一个人拍板，",
      "start": 8.83,
      "end": 10.832
    },
    {
      "id": "shot01-6",
      "text": "而是让 5 位医生各自独立读片，",
      "start": 10.832,
      "end": 13.395
    },
    {
      "id": "shot01-7",
      "text": "再把意见放到一起看。",
      "start": 13.395,
      "end": 15.517
    },
    {
      "id": "shot01-8",
      "text": "如果 5 个人里 4 个都说有风险，",
      "start": 15.517,
      "end": 18.16
    },
    {
      "id": "shot01-9",
      "text": "这个判断就比一个人说有风险更稳。",
      "start": 18.16,
      "end": 20.983
    },
    {
      "id": "shot01-10",
      "text": "集成学习，",
      "start": 20.983,
      "end": 21.924
    },
    {
      "id": "shot01-11",
      "text": "英文 Ensemble Learning，",
      "start": 21.924,
      "end": 23.465
    },
    {
      "id": "shot01-12",
      "text": "干的就是类似的事：",
      "start": 23.465,
      "end": 24.807
    },
    {
      "id": "shot01-13",
      "text": "不要把全部希望押在一个模型上，",
      "start": 24.807,
      "end": 27.47
    },
    {
      "id": "shot01-14",
      "text": "而是让一群模型一起判断。",
      "start": 27.47,
      "end": 29.312
    },
    {
      "id": "shot01-15",
      "text": "这些模型各自会犯错，",
      "start": 29.842,
      "end": 31.726
    },
    {
      "id": "shot01-16",
      "text": "但只要它们不是同时犯同一种错，",
      "start": 31.726,
      "end": 34.433
    },
    {
      "id": "shot01-17",
      "text": "组合起来就可能变成更强的模型。",
      "start": 34.433,
      "end": 37.38
    },
    {
      "id": "shot01-18",
      "text": "这一期我们先把集成学习的总框架搭起来：",
      "start": 37.38,
      "end": 40.808
    },
    {
      "id": "shot01-19",
      "text": "什么是弱学习器，",
      "start": 40.808,
      "end": 42.071
    },
    {
      "id": "shot01-20",
      "text": "什么是强学习器，",
      "start": 42.071,
      "end": 43.394
    },
    {
      "id": "shot01-21",
      "text": "为什么一群模型能比一个模型更稳，",
      "start": 43.394,
      "end": 45.92
    },
    {
      "id": "shot01-22",
      "text": "以及后面会出现的两条主路线。",
      "start": 45.92,
      "end": 47.965
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先给定义。",
      "start": 0.0,
      "end": 1.042
    },
    {
      "id": "shot02-1",
      "text": "集成学习就是把多个模型组合起来，",
      "start": 1.042,
      "end": 3.585
    },
    {
      "id": "shot02-2",
      "text": "形成一个整体模型。",
      "start": 3.585,
      "end": 5.168
    },
    {
      "id": "shot02-3",
      "text": "参与组合的每个模型，",
      "start": 5.168,
      "end": 6.79
    },
    {
      "id": "shot02-4",
      "text": "叫弱学习器，",
      "start": 6.79,
      "end": 7.912
    },
    {
      "id": "shot02-5",
      "text": "英文 weak learner，",
      "start": 7.912,
      "end": 9.234
    },
    {
      "id": "shot02-6",
      "text": "也叫基学习器 base learner。",
      "start": 9.234,
      "end": 11.597
    },
    {
      "id": "shot02-7",
      "text": "这里的“弱”不是说它完全没用，",
      "start": 11.597,
      "end": 13.761
    },
    {
      "id": "shot02-8",
      "text": "而是说它单独拿出来能力有限，",
      "start": 13.761,
      "end": 16.124
    },
    {
      "id": "shot02-9",
      "text": "可能只比乱猜好一些，",
      "start": 16.124,
      "end": 18.027
    },
    {
      "id": "shot02-10",
      "text": "或者对训练数据很敏感。",
      "start": 18.027,
      "end": 19.89
    },
    {
      "id": "shot02-11",
      "text": "多个弱学习器训练完之后，",
      "start": 19.89,
      "end": 21.833
    },
    {
      "id": "shot02-12",
      "text": "对一个未知样本分别给出预测，",
      "start": 21.833,
      "end": 24.337
    },
    {
      "id": "shot02-13",
      "text": "最后再通过某种规则把这些预测合并。",
      "start": 24.337,
      "end": 27.021
    },
    {
      "id": "shot02-14",
      "text": "合并后的整体，",
      "start": 27.524,
      "end": 28.626
    },
    {
      "id": "shot02-15",
      "text": "就叫强学习器 strong",
      "start": 28.626,
      "end": 30.228
    },
    {
      "id": "shot02-16",
      "text": "learner。",
      "start": 30.228,
      "end": 30.949
    },
    {
      "id": "shot02-17",
      "text": "这个强学习器不一定是一个新的复杂公式，",
      "start": 30.949,
      "end": 34.133
    },
    {
      "id": "shot02-18",
      "text": "它可以很朴素：",
      "start": 34.133,
      "end": 35.45
    },
    {
      "id": "shot02-19",
      "text": "5 棵树各投一票，谁多谁赢；",
      "start": 35.45,
      "end": 37.938
    },
    {
      "id": "shot02-20",
      "text": "也可以稍微复杂一点：",
      "start": 37.938,
      "end": 39.54
    },
    {
      "id": "shot02-21",
      "text": "每棵树的话语权不同，",
      "start": 39.54,
      "end": 41.323
    },
    {
      "id": "shot02-22",
      "text": "准的模型票更重。",
      "start": 41.323,
      "end": 43.185
    },
    {
      "id": "shot02-23",
      "text": "先记住一句话：",
      "start": 43.185,
      "end": 44.427
    },
    {
      "id": "shot02-24",
      "text": "集成学习的核心不是发明一个全新的单体模型，",
      "start": 44.427,
      "end": 48.192
    },
    {
      "id": "shot02-25",
      "text": "而是设计一套组织方式，",
      "start": 48.192,
      "end": 50.335
    },
    {
      "id": "shot02-26",
      "text": "让多个模型联合起来做判断。",
      "start": 50.335,
      "end": 52.558
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "换成机器学习场景。",
      "start": 0.0,
      "end": 1.46
    },
    {
      "id": "shot03-1",
      "text": "我们要判断一封邮件是不是垃圾邮件，",
      "start": 1.46,
      "end": 4.201
    },
    {
      "id": "shot03-2",
      "text": "先训练 5 棵决策树。",
      "start": 4.201,
      "end": 6.262
    },
    {
      "id": "shot03-3",
      "text": "每棵树都看邮件里的特征，",
      "start": 6.262,
      "end": 8.242
    },
    {
      "id": "shot03-4",
      "text": "比如发件人是否陌生，",
      "start": 8.242,
      "end": 9.963
    },
    {
      "id": "shot03-5",
      "text": "标题里有没有中奖，",
      "start": 9.963,
      "end": 11.423
    },
    {
      "id": "shot03-6",
      "text": "正文里有没有链接。",
      "start": 11.423,
      "end": 12.944
    },
    {
      "id": "shot03-7",
      "text": "现在来了一封新邮件，",
      "start": 12.944,
      "end": 14.714
    },
    {
      "id": "shot03-8",
      "text": "5 棵树分别投票。",
      "start": 14.714,
      "end": 16.221
    },
    {
      "id": "shot03-9",
      "text": "树 1 说垃圾，",
      "start": 16.221,
      "end": 17.968
    },
    {
      "id": "shot03-10",
      "text": "树 2 说垃圾，",
      "start": 17.968,
      "end": 18.974
    },
    {
      "id": "shot03-11",
      "text": "树 3 说正常，",
      "start": 18.974,
      "end": 20.093
    },
    {
      "id": "shot03-12",
      "text": "树 4 说垃圾，",
      "start": 20.093,
      "end": 21.095
    },
    {
      "id": "shot03-13",
      "text": "树 5 说正常。",
      "start": 21.095,
      "end": 22.138
    },
    {
      "id": "shot03-14",
      "text": "最后票数是 3 比 2，",
      "start": 22.138,
      "end": 23.842
    },
    {
      "id": "shot03-15",
      "text": "就判为垃圾邮件。",
      "start": 23.842,
      "end": 25.305
    },
    {
      "id": "shot03-16",
      "text": "这种谁多谁赢的合并方式，",
      "start": 25.305,
      "end": 27.491
    },
    {
      "id": "shot03-17",
      "text": "叫多数投票，",
      "start": 27.491,
      "end": 28.774
    },
    {
      "id": "shot03-18",
      "text": "英文 majority vote。",
      "start": 28.774,
      "end": 30.117
    },
    {
      "id": "shot03-19",
      "text": "注意这里有两个层次：",
      "start": 30.463,
      "end": 31.983
    },
    {
      "id": "shot03-20",
      "text": "单棵树只负责给出自己的判断，",
      "start": 31.983,
      "end": 34.364
    },
    {
      "id": "shot03-21",
      "text": "整体系统负责把 5 个判断合起来。",
      "start": 34.364,
      "end": 37.205
    },
    {
      "id": "shot03-22",
      "text": "画面上可以把它想成 5 条支路汇到一个投",
      "start": 37.205,
      "end": 40.266
    },
    {
      "id": "shot03-23",
      "text": "票箱里，",
      "start": 40.266,
      "end": 40.966
    },
    {
      "id": "shot03-24",
      "text": "投票箱输出最终类别。",
      "start": 40.966,
      "end": 43.006
    },
    {
      "id": "shot03-25",
      "text": "这个例子里我们用的是分类任务；",
      "start": 43.006,
      "end": 45.547
    },
    {
      "id": "shot03-26",
      "text": "如果是回归任务，",
      "start": 45.547,
      "end": 46.707
    },
    {
      "id": "shot03-27",
      "text": "比如预测房价，",
      "start": 46.707,
      "end": 48.008
    },
    {
      "id": "shot03-28",
      "text": "也可以让 5 个模型各自预测一个价格，",
      "start": 48.008,
      "end": 50.889
    },
    {
      "id": "shot03-29",
      "text": "最后取平均值。",
      "start": 50.889,
      "end": 52.229
    },
    {
      "id": "shot03-30",
      "text": "分类常用投票，",
      "start": 52.229,
      "end": 53.529
    },
    {
      "id": "shot03-31",
      "text": "回归常用平均，",
      "start": 53.529,
      "end": 54.73
    },
    {
      "id": "shot03-32",
      "text": "都是聚合规则。",
      "start": 54.73,
      "end": 55.63
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "那一群模型为什么会比一个模型更强？",
      "start": 0.0,
      "end": 2.982
    },
    {
      "id": "shot04-1",
      "text": "关键不是数量本身，",
      "start": 2.982,
      "end": 4.524
    },
    {
      "id": "shot04-2",
      "text": "而是错误不完全一致。",
      "start": 4.524,
      "end": 6.445
    },
    {
      "id": "shot04-3",
      "text": "看一个虚构示意。",
      "start": 6.445,
      "end": 7.846
    },
    {
      "id": "shot04-4",
      "text": "单棵决策树在测试集上大约 72% 准确，",
      "start": 7.846,
      "end": 11.894
    },
    {
      "id": "shot04-5",
      "text": "5 棵树单独看也都差不多，",
      "start": 11.894,
      "end": 14.011
    },
    {
      "id": "shot04-6",
      "text": "可能是 70% 到 74%。",
      "start": 14.011,
      "end": 17.114
    },
    {
      "id": "shot04-7",
      "text": "如果这 5 棵树犯错的位置不同，",
      "start": 17.114,
      "end": 19.696
    },
    {
      "id": "shot04-8",
      "text": "多数投票就有机会把单棵树的偶发错误抹平。",
      "start": 19.696,
      "end": 23.519
    },
    {
      "id": "shot04-9",
      "text": "比如某封正常邮件因为标题太夸张，",
      "start": 23.519,
      "end": 26.43
    },
    {
      "id": "shot04-10",
      "text": "被树 1 误判成垃圾，但树 2、树 3、",
      "start": 26.43,
      "end": 29.347
    },
    {
      "id": "shot04-11",
      "text": "树 4 看到了发件人和历史联系人，",
      "start": 29.347,
      "end": 31.909
    },
    {
      "id": "shot04-12",
      "text": "判正常，",
      "start": 31.909,
      "end": 32.732
    },
    {
      "id": "shot04-13",
      "text": "最后整体就能纠正树 1 的错误。",
      "start": 32.732,
      "end": 34.94
    },
    {
      "id": "shot04-14",
      "text": "反过来，",
      "start": 35.406,
      "end": 36.167
    },
    {
      "id": "shot04-15",
      "text": "如果 5 棵树完全一样，",
      "start": 36.167,
      "end": 38.19
    },
    {
      "id": "shot04-16",
      "text": "训练数据一样，参数一样，",
      "start": 38.19,
      "end": 40.413
    },
    {
      "id": "shot04-17",
      "text": "随机种子也一样，",
      "start": 40.413,
      "end": 41.815
    },
    {
      "id": "shot04-18",
      "text": "那它们每次都会给出同一个答案。",
      "start": 41.815,
      "end": 44.138
    },
    {
      "id": "shot04-19",
      "text": "单棵树错，",
      "start": 44.138,
      "end": 45.343
    },
    {
      "id": "shot04-20",
      "text": "5 棵树一起错；单棵树准，",
      "start": 45.343,
      "end": 47.514
    },
    {
      "id": "shot04-21",
      "text": "5 棵树一起准。",
      "start": 47.514,
      "end": 49.004
    },
    {
      "id": "shot04-22",
      "text": "这个时候集成没有任何增益，",
      "start": 49.004,
      "end": 51.467
    },
    {
      "id": "shot04-23",
      "text": "只是把同一个模型复制了 5 份。",
      "start": 51.467,
      "end": 54.471
    },
    {
      "id": "shot04-24",
      "text": "所以集成学习真正依赖的前提叫差异性，",
      "start": 54.471,
      "end": 58.216
    },
    {
      "id": "shot04-25",
      "text": "英文 diversity。",
      "start": 58.216,
      "end": 59.858
    },
    {
      "id": "shot04-26",
      "text": "模型之间要有不同视角，",
      "start": 59.858,
      "end": 62.161
    },
    {
      "id": "shot04-27",
      "text": "组合才有意义。",
      "start": 62.161,
      "end": 63.403
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "理解了差异性，",
      "start": 0.0,
      "end": 1.262
    },
    {
      "id": "shot05-1",
      "text": "下一步自然就是问：",
      "start": 1.262,
      "end": 2.645
    },
    {
      "id": "shot05-2",
      "text": "怎么制造差异？",
      "start": 2.645,
      "end": 3.907
    },
    {
      "id": "shot05-3",
      "text": "集成学习里最主流的两条路线，",
      "start": 3.907,
      "end": 6.492
    },
    {
      "id": "shot05-4",
      "text": "就是 bagging 和",
      "start": 6.492,
      "end": 7.473
    },
    {
      "id": "shot05-5",
      "text": "boosting。",
      "start": 7.473,
      "end": 8.115
    },
    {
      "id": "shot05-6",
      "text": "Bagging，",
      "start": 8.115,
      "end": 8.696
    },
    {
      "id": "shot05-7",
      "text": "全称 Bootstrap",
      "start": 8.696,
      "end": 9.918
    },
    {
      "id": "shot05-8",
      "text": "Aggregating，",
      "start": 9.918,
      "end": 10.859
    },
    {
      "id": "shot05-9",
      "text": "中文常译成装袋法或自助聚合。",
      "start": 10.859,
      "end": 14.085
    },
    {
      "id": "shot05-10",
      "text": "它的思路像多人会诊：",
      "start": 14.085,
      "end": 16.029
    },
    {
      "id": "shot05-11",
      "text": "每个模型看不同的数据子集，",
      "start": 16.029,
      "end": 18.413
    },
    {
      "id": "shot05-12",
      "text": "彼此独立训练，",
      "start": 18.413,
      "end": 19.715
    },
    {
      "id": "shot05-13",
      "text": "最后平等投票。",
      "start": 19.715,
      "end": 21.078
    },
    {
      "id": "shot05-14",
      "text": "随机森林 Random Forest 就",
      "start": 21.078,
      "end": 23.282
    },
    {
      "id": "shot05-15",
      "text": "是这条路线的代表。",
      "start": 23.282,
      "end": 24.404
    },
    {
      "id": "shot05-16",
      "text": "Boosting，",
      "start": 24.816,
      "end": 25.377
    },
    {
      "id": "shot05-17",
      "text": "中文常译成提升法或增强法，",
      "start": 25.377,
      "end": 28.08
    },
    {
      "id": "shot05-18",
      "text": "思路像接力查漏：",
      "start": 28.08,
      "end": 29.562
    },
    {
      "id": "shot05-19",
      "text": "第一个模型先学，",
      "start": 29.562,
      "end": 30.884
    },
    {
      "id": "shot05-20",
      "text": "后面的模型重点补前面没学好的地方，",
      "start": 30.884,
      "end": 33.888
    },
    {
      "id": "shot05-21",
      "text": "最后再按模型表现加权投票。",
      "start": 33.888,
      "end": 36.511
    },
    {
      "id": "shot05-22",
      "text": "AdaBoost、",
      "start": 36.511,
      "end": 37.332
    },
    {
      "id": "shot05-23",
      "text": "GBDT、",
      "start": 37.332,
      "end": 38.413
    },
    {
      "id": "shot05-24",
      "text": "XGBoost、",
      "start": 38.413,
      "end": 39.254
    },
    {
      "id": "shot05-25",
      "text": "LightGBM 都在这条路线里。",
      "start": 39.254,
      "end": 41.958
    },
    {
      "id": "shot05-26",
      "text": "先不用急着记细节，",
      "start": 41.958,
      "end": 43.44
    },
    {
      "id": "shot05-27",
      "text": "本期只记一个方向感：",
      "start": 43.44,
      "end": 45.102
    },
    {
      "id": "shot05-28",
      "text": "bagging 是并行求稳，",
      "start": 45.102,
      "end": 46.724
    },
    {
      "id": "shot05-29",
      "text": "boosting 是串行纠错。",
      "start": 46.724,
      "end": 48.486
    },
    {
      "id": "shot05-30",
      "text": "一个重点降低模型对数据扰动的敏感，",
      "start": 48.486,
      "end": 51.45
    },
    {
      "id": "shot05-31",
      "text": "一个重点把前面没学好的规律继续往下补。",
      "start": 51.45,
      "end": 54.494
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "最后把几个容易误会的点收一下。第一，",
      "start": 0.0,
      "end": 3.104
    },
    {
      "id": "shot06-1",
      "text": "集成学习不是模型越多越好。",
      "start": 3.104,
      "end": 5.667
    },
    {
      "id": "shot06-2",
      "text": "如果 100 个模型都长得一模一样，",
      "start": 5.667,
      "end": 8.15
    },
    {
      "id": "shot06-3",
      "text": "它们还是只相当于 1 个模型。第二，",
      "start": 8.15,
      "end": 10.933
    },
    {
      "id": "shot06-4",
      "text": "弱学习器不是越强越好。",
      "start": 10.933,
      "end": 13.256
    },
    {
      "id": "shot06-5",
      "text": "某些集成方法反而喜欢简单模型，",
      "start": 13.256,
      "end": 16.28
    },
    {
      "id": "shot06-6",
      "text": "因为简单模型容易互补，",
      "start": 16.28,
      "end": 18.322
    },
    {
      "id": "shot06-7",
      "text": "组合之后才有空间变强。第三，",
      "start": 18.322,
      "end": 21.126
    },
    {
      "id": "shot06-8",
      "text": "集成学习不是只能用于分类。",
      "start": 21.126,
      "end": 23.769
    },
    {
      "id": "shot06-9",
      "text": "分类可以投票，",
      "start": 23.769,
      "end": 25.191
    },
    {
      "id": "shot06-10",
      "text": "回归可以平均，",
      "start": 25.191,
      "end": 26.492
    },
    {
      "id": "shot06-11",
      "text": "核心都是把多个预测合成一个预测。",
      "start": 26.492,
      "end": 29.136
    },
    {
      "id": "shot06-12",
      "text": "这一期我们讲清了三件事：",
      "start": 29.6,
      "end": 31.684
    },
    {
      "id": "shot06-13",
      "text": "集成学习就是多个模型加聚合规则；",
      "start": 31.684,
      "end": 34.63
    },
    {
      "id": "shot06-14",
      "text": "弱学习器单独能力有限，",
      "start": 34.63,
      "end": 36.614
    },
    {
      "id": "shot06-15",
      "text": "组合后形成强学习器；",
      "start": 36.614,
      "end": 38.619
    },
    {
      "id": "shot06-16",
      "text": "组合有效的前提是模型之间有差异。",
      "start": 38.619,
      "end": 41.505
    },
    {
      "id": "shot06-17",
      "text": "没有差异，",
      "start": 41.505,
      "end": 42.226
    },
    {
      "id": "shot06-18",
      "text": "就是复制粘贴；有差异，",
      "start": 42.226,
      "end": 44.31
    },
    {
      "id": "shot06-19",
      "text": "投票和平均才可能抹平偶发错误。",
      "start": 44.31,
      "end": 47.657
    },
    {
      "id": "shot06-20",
      "text": "下一期我们正式拆开两条路线：",
      "start": 47.657,
      "end": 50.082
    },
    {
      "id": "shot06-21",
      "text": "bagging 怎么并行求稳，",
      "start": 50.082,
      "end": 51.766
    },
    {
      "id": "shot06-22",
      "text": "boosting 怎么串行纠错。",
      "start": 51.766,
      "end": 53.169
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "下期见，",
      "start": 0.0,
      "end": 0.649
    },
    {
      "id": "shot07-1",
      "text": "欢迎评论区留言讨论。",
      "start": 0.649,
      "end": 2.088
    }
  ]
}
