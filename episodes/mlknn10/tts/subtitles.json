{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "前 9 期我们一块块拼工具：",
      "start": 0.0,
      "end": 2.84
    },
    {
      "id": "shot01-1",
      "text": "距离怎么算、",
      "start": 2.84,
      "end": 3.68
    },
    {
      "id": "shot01-2",
      "text": "K 怎么选、加权投票、工作流、回归、",
      "start": 3.68,
      "end": 7.12
    },
    {
      "id": "shot01-3",
      "text": "sklearn 三件套、",
      "start": 7.12,
      "end": 8.42
    },
    {
      "id": "shot01-4",
      "text": "距离度量、",
      "start": 8.42,
      "end": 9.58
    },
    {
      "id": "shot01-5",
      "text": "缩放（归一化、",
      "start": 9.58,
      "end": 10.82
    },
    {
      "id": "shot01-6",
      "text": "标准化）加高斯分布。零件齐了，",
      "start": 10.82,
      "end": 13.94
    },
    {
      "id": "shot01-7",
      "text": "这一期把它们装起来——跑一个完整的机器学习项目。",
      "start": 13.94,
      "end": 18.22
    },
    {
      "id": "shot01-8",
      "text": "这一期主角是鸢尾花数据集，",
      "start": 18.22,
      "end": 20.7
    },
    {
      "id": "shot01-9",
      "text": "机器学习领域的 hello world。",
      "start": 20.7,
      "end": 22.48
    },
    {
      "id": "shot01-10",
      "text": "我们会完整走一遍 6 步标准流程：加载、拆分、标准化、训练、评估、预测。",
      "start": 22.48,
      "end": 28.86
    },
    {
      "id": "shot01-11",
      "text": "每一步对应一行 sklearn API。",
      "start": 28.86,
      "end": 31.62
    },
    {
      "id": "shot01-12",
      "text": "走完这一期，",
      "start": 31.937,
      "end": 33.117
    },
    {
      "id": "shot01-13",
      "text": "你就会用 KNN 解决一个完整的分类任务了。",
      "start": 33.117,
      "end": 36.347
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先认识数据。",
      "start": 0.0,
      "end": 1.42
    },
    {
      "id": "shot02-1",
      "text": "鸢尾花 Iris Dataset 是",
      "start": 1.42,
      "end": 3.4
    },
    {
      "id": "shot02-2",
      "text": "1936 年统计学家 Fisher 整理",
      "start": 3.4,
      "end": 5.62
    },
    {
      "id": "shot02-3",
      "text": "的经典数据集，",
      "start": 5.62,
      "end": 7.16
    },
    {
      "id": "shot02-4",
      "text": "几乎所有机器学习教材都拿它当入门案例。",
      "start": 7.16,
      "end": 10.86
    },
    {
      "id": "shot02-5",
      "text": "一共 150 条样本，",
      "start": 10.86,
      "end": 12.88
    },
    {
      "id": "shot02-6",
      "text": "每条是一朵花的测量记录。",
      "start": 12.88,
      "end": 15.38
    },
    {
      "id": "shot02-7",
      "text": "每朵花用 4 个数字描述：花萼长度、花萼宽度、花瓣长度、花瓣宽度，",
      "start": 15.38,
      "end": 21.76
    },
    {
      "id": "shot02-8",
      "text": "单位都是厘米。",
      "start": 21.76,
      "end": 23.28
    },
    {
      "id": "shot02-9",
      "text": "这 4 个数字就是这一朵花在 4 维特征",
      "start": 23.28,
      "end": 25.86
    },
    {
      "id": "shot02-10",
      "text": "空间里的坐标。",
      "start": 25.86,
      "end": 26.86
    },
    {
      "id": "shot02-11",
      "text": "每条样本带一个标签，",
      "start": 27.355,
      "end": 28.915
    },
    {
      "id": "shot02-12",
      "text": "告诉你这朵花属于 3 个品种里的哪一种：",
      "start": 28.915,
      "end": 32.255
    },
    {
      "id": "shot02-13",
      "text": "山鸢尾 setosa、",
      "start": 32.255,
      "end": 33.795
    },
    {
      "id": "shot02-14",
      "text": "变色鸢尾 versicolor、",
      "start": 33.795,
      "end": 35.615
    },
    {
      "id": "shot02-15",
      "text": "维吉尼亚鸢尾 virginica。",
      "start": 35.615,
      "end": 37.515
    },
    {
      "id": "shot02-16",
      "text": "每个品种各 50 条，",
      "start": 37.515,
      "end": 39.295
    },
    {
      "id": "shot02-17",
      "text": "类别完全均衡。",
      "start": 39.295,
      "end": 41.055
    },
    {
      "id": "shot02-18",
      "text": "任务很直接：",
      "start": 41.055,
      "end": 41.955
    },
    {
      "id": "shot02-19",
      "text": "给一朵新鸢尾花的 4 个测量值，",
      "start": 41.955,
      "end": 44.915
    },
    {
      "id": "shot02-20",
      "text": "预测它是哪一种。",
      "start": 44.915,
      "end": 46.115
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "再把 6 步流程过一遍，",
      "start": 0.0,
      "end": 2.04
    },
    {
      "id": "shot03-1",
      "text": "每一步对应一行代码。",
      "start": 2.04,
      "end": 3.82
    },
    {
      "id": "shot03-2",
      "text": "第一步加载，",
      "start": 3.82,
      "end": 4.9
    },
    {
      "id": "shot03-3",
      "text": "调用 load_iris 拿到特征矩阵和",
      "start": 4.9,
      "end": 7.8
    },
    {
      "id": "shot03-4",
      "text": "标签数组。",
      "start": 7.8,
      "end": 8.9
    },
    {
      "id": "shot03-5",
      "text": "第二步拆分，",
      "start": 8.9,
      "end": 10.16
    },
    {
      "id": "shot03-6",
      "text": "train_test_split 把",
      "start": 10.16,
      "end": 11.52
    },
    {
      "id": "shot03-7",
      "text": "150 条按 7 比 3 切，",
      "start": 11.52,
      "end": 14.02
    },
    {
      "id": "shot03-8",
      "text": "105 条训练 45 条测试。",
      "start": 14.02,
      "end": 17.14
    },
    {
      "id": "shot03-9",
      "text": "这一步引入一个新参数 stratify，分层抽样：",
      "start": 17.14,
      "end": 21.02
    },
    {
      "id": "shot03-10",
      "text": "3 个品种各 50 条，",
      "start": 21.02,
      "end": 23.06
    },
    {
      "id": "shot03-11",
      "text": "stratify 强制保证训练集和测试集",
      "start": 23.06,
      "end": 25.844
    },
    {
      "id": "shot03-12",
      "text": "里 3 个品种比例都按原比例切，",
      "start": 25.844,
      "end": 28.56
    },
    {
      "id": "shot03-13",
      "text": "不会某类被切偏导致评估失真。",
      "start": 28.56,
      "end": 31.5
    },
    {
      "id": "shot03-14",
      "text": "类别均衡或不均衡的任务都建议开。",
      "start": 31.837,
      "end": 36.157
    },
    {
      "id": "shot03-15",
      "text": "第三步标准化，",
      "start": 36.157,
      "end": 37.757
    },
    {
      "id": "shot03-16",
      "text": "StandardScaler 把每个特征",
      "start": 37.757,
      "end": 39.537
    },
    {
      "id": "shot03-17",
      "text": "减均值除标准差。关键纪律：",
      "start": 39.537,
      "end": 43.077
    },
    {
      "id": "shot03-18",
      "text": "均值和标准差只在训练集上算，",
      "start": 43.077,
      "end": 46.037
    },
    {
      "id": "shot03-19",
      "text": "测试集只 transform 不 fit",
      "start": 46.037,
      "end": 47.93
    },
    {
      "id": "shot03-20",
      "text": "——否则测试集偷看训练分布造成数据泄漏",
      "start": 47.93,
      "end": 51.337
    },
    {
      "id": "shot03-21",
      "text": "data leakage。",
      "start": 51.337,
      "end": 53.157
    },
    {
      "id": "shot03-22",
      "text": "第四步训练，",
      "start": 53.157,
      "end": 54.392
    },
    {
      "id": "shot03-23",
      "text": "KNeighborsClassifier",
      "start": 54.392,
      "end": 55.657
    },
    {
      "id": "shot03-24",
      "text": "设 k=5 调 fit。",
      "start": 55.657,
      "end": 57.277
    },
    {
      "id": "shot03-25",
      "text": "第五步评估，",
      "start": 57.735,
      "end": 59.375
    },
    {
      "id": "shot03-26",
      "text": "accuracy_score 拿测试集准确率，",
      "start": 59.375,
      "end": 61.975
    },
    {
      "id": "shot03-27",
      "text": "再加一个新工具叫混淆矩阵",
      "start": 61.975,
      "end": 64.155
    },
    {
      "id": "shot03-28",
      "text": "confusion matrix——3",
      "start": 64.155,
      "end": 65.915
    },
    {
      "id": "shot03-29",
      "text": "乘 3 的表，",
      "start": 65.915,
      "end": 66.92
    },
    {
      "id": "shot03-30",
      "text": "行是真实、列是预测，对角线对，",
      "start": 66.92,
      "end": 70.055
    },
    {
      "id": "shot03-31",
      "text": "其他格子告诉你错在哪。",
      "start": 70.055,
      "end": 72.295
    },
    {
      "id": "shot03-32",
      "text": "第六步预测，",
      "start": 72.295,
      "end": 73.655
    },
    {
      "id": "shot03-33",
      "text": "predict 输出类别，",
      "start": 73.655,
      "end": 75.415
    },
    {
      "id": "shot03-34",
      "text": "predict_proba 输出每一类概率。",
      "start": 75.415,
      "end": 78.042
    },
    {
      "id": "shot03-35",
      "text": "6 步走完，",
      "start": 78.042,
      "end": 79.035
    },
    {
      "id": "shot03-36",
      "text": "可以拿来预测。",
      "start": 79.035,
      "end": 79.955
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "打开 demo，",
      "start": 0.0,
      "end": 1.2
    },
    {
      "id": "shot04-1",
      "text": "UI 顶部就是这 6 步的卡片说明。",
      "start": 1.2,
      "end": 4.04
    },
    {
      "id": "shot04-2",
      "text": "下面 3 列控件，",
      "start": 4.04,
      "end": 5.6
    },
    {
      "id": "shot04-3",
      "text": "分别管数据拆分、",
      "start": 5.6,
      "end": 7.12
    },
    {
      "id": "shot04-4",
      "text": "KNN 参数、",
      "start": 7.12,
      "end": 8.26
    },
    {
      "id": "shot04-5",
      "text": "2D 投影。",
      "start": 8.26,
      "end": 9.32
    },
    {
      "id": "shot04-6",
      "text": "我们先跑默认配置：",
      "start": 9.32,
      "end": 11.0
    },
    {
      "id": "shot04-7",
      "text": "测试集占 30%、",
      "start": 11.0,
      "end": 12.9
    },
    {
      "id": "shot04-8",
      "text": "随机种子 22、",
      "start": 12.9,
      "end": 14.08
    },
    {
      "id": "shot04-9",
      "text": "k 取 5、",
      "start": 14.08,
      "end": 14.94
    },
    {
      "id": "shot04-10",
      "text": "标准化开着、",
      "start": 14.94,
      "end": 16.14
    },
    {
      "id": "shot04-11",
      "text": "2D 投影选花瓣长和花瓣宽。",
      "start": 16.14,
      "end": 19.24
    },
    {
      "id": "shot04-12",
      "text": "看准确率对比卡：",
      "start": 19.24,
      "end": 20.893
    },
    {
      "id": "shot04-13",
      "text": "4 维全特征训练，",
      "start": 20.893,
      "end": 22.68
    },
    {
      "id": "shot04-14",
      "text": "测试集准确率约 93%——45 条里",
      "start": 22.68,
      "end": 25.98
    },
    {
      "id": "shot04-15",
      "text": "42 条预测对、3 条错。",
      "start": 25.98,
      "end": 27.96
    },
    {
      "id": "shot04-16",
      "text": "再看下面的决策边界图：",
      "start": 28.353,
      "end": 30.418
    },
    {
      "id": "shot04-17",
      "text": "圆点是训练样本带黑色描边，",
      "start": 30.418,
      "end": 33.138
    },
    {
      "id": "shot04-18",
      "text": "十字是测试样本，",
      "start": 33.138,
      "end": 34.793
    },
    {
      "id": "shot04-19",
      "text": "背景三色是 KNN 在整个平面的预测——",
      "start": 34.793,
      "end": 38.193
    },
    {
      "id": "shot04-20",
      "text": "红色山鸢尾、",
      "start": 38.193,
      "end": 39.513
    },
    {
      "id": "shot04-21",
      "text": "绿色变色鸢尾、",
      "start": 39.513,
      "end": 41.093
    },
    {
      "id": "shot04-22",
      "text": "蓝色维吉尼亚鸢尾。注意看，",
      "start": 41.093,
      "end": 43.853
    },
    {
      "id": "shot04-23",
      "text": "红色山鸢尾几乎和另外两类完全分开，",
      "start": 43.853,
      "end": 47.253
    },
    {
      "id": "shot04-24",
      "text": "一条直线就能切——这是鸢尾花数据集著名的特点。",
      "start": 47.253,
      "end": 51.653
    },
    {
      "id": "shot04-25",
      "text": "绿色和蓝色之间会有少量重叠，",
      "start": 51.653,
      "end": 54.053
    },
    {
      "id": "shot04-26",
      "text": "那几个落在错色背景上的十字，",
      "start": 54.053,
      "end": 56.673
    },
    {
      "id": "shot04-27",
      "text": "就是被分错的测试样本，",
      "start": 56.673,
      "end": 58.913
    },
    {
      "id": "shot04-28",
      "text": "肉眼一眼就能找出来。",
      "start": 58.913,
      "end": 60.413
    },
    {
      "id": "shot04-29",
      "text": "再往下看混淆矩阵，",
      "start": 60.822,
      "end": 62.482
    },
    {
      "id": "shot04-30",
      "text": "3 乘 3 的蓝色热力图，",
      "start": 62.482,
      "end": 64.762
    },
    {
      "id": "shot04-31",
      "text": "对角线深色、",
      "start": 64.762,
      "end": 65.722
    },
    {
      "id": "shot04-32",
      "text": "非对角线浅色——大部分预测都落在对角线上，",
      "start": 65.722,
      "end": 69.342
    },
    {
      "id": "shot04-33",
      "text": "少数错分集中在 versicolor 和",
      "start": 69.342,
      "end": 71.722
    },
    {
      "id": "shot04-34",
      "text": "virginica 互判，",
      "start": 71.722,
      "end": 72.822
    },
    {
      "id": "shot04-35",
      "text": "红色山鸢尾一个没错。",
      "start": 72.822,
      "end": 75.242
    },
    {
      "id": "shot04-36",
      "text": "这就是一个跑通的 KNN 分类器在测试集上的样子。",
      "start": 75.242,
      "end": 79.255
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "现在做一个有意思的实验。",
      "start": 0.0,
      "end": 2.0
    },
    {
      "id": "shot05-1",
      "text": "准确率对比卡上还有一个数字叫 2 维投影",
      "start": 2.0,
      "end": 5.68
    },
    {
      "id": "shot05-2",
      "text": "准确率——意思是只用当前选的两维特征训练KNN，",
      "start": 5.68,
      "end": 10.42
    },
    {
      "id": "shot05-3",
      "text": "扔掉另外两维信息。",
      "start": 10.42,
      "end": 12.52
    },
    {
      "id": "shot05-4",
      "text": "默认选的是花瓣长和花瓣宽，",
      "start": 12.52,
      "end": 15.253
    },
    {
      "id": "shot05-5",
      "text": "2 维准确率和 4 维差不多。",
      "start": 15.253,
      "end": 18.3
    },
    {
      "id": "shot05-6",
      "text": "说明这两维信息已经够用了。",
      "start": 18.3,
      "end": 20.52
    },
    {
      "id": "shot05-7",
      "text": "把 2D 投影切换到花萼长和花萼宽——卡",
      "start": 20.52,
      "end": 24.66
    },
    {
      "id": "shot05-8",
      "text": "片立刻警告，",
      "start": 24.66,
      "end": 25.88
    },
    {
      "id": "shot05-9",
      "text": "4 维仍然 93%，",
      "start": 25.88,
      "end": 27.94
    },
    {
      "id": "shot05-10",
      "text": "2 维准确率掉到大约 71%，",
      "start": 27.94,
      "end": 31.02
    },
    {
      "id": "shot05-11",
      "text": "差距 20 多个百分点。",
      "start": 31.02,
      "end": 32.66
    },
    {
      "id": "shot05-12",
      "text": "决策边界图也变了：",
      "start": 33.071,
      "end": 34.851
    },
    {
      "id": "shot05-13",
      "text": "三类之间大量重叠，",
      "start": 34.851,
      "end": 36.591
    },
    {
      "id": "shot05-14",
      "text": "特别是绿色变色鸢尾和蓝色维吉尼亚鸢尾几乎挤在一起，",
      "start": 36.591,
      "end": 41.371
    },
    {
      "id": "shot05-15",
      "text": "连红色山鸢尾都开始和绿色互相侵入。",
      "start": 41.371,
      "end": 45.211
    },
    {
      "id": "shot05-16",
      "text": "结论很直白：",
      "start": 45.211,
      "end": 46.551
    },
    {
      "id": "shot05-17",
      "text": "花萼这两维信息量比花瓣弱很多，",
      "start": 46.551,
      "end": 49.291
    },
    {
      "id": "shot05-18",
      "text": "光看花萼分不清品种。",
      "start": 49.291,
      "end": 51.531
    },
    {
      "id": "shot05-19",
      "text": "这告诉我们一件事——特征工程的核心不是堆维度，",
      "start": 51.531,
      "end": 55.471
    },
    {
      "id": "shot05-20",
      "text": "是挑信息量大的维度。",
      "start": 55.471,
      "end": 57.581
    },
    {
      "id": "shot05-21",
      "text": "这一期不展开，",
      "start": 57.581,
      "end": 58.711
    },
    {
      "id": "shot05-22",
      "text": "本章 04c 末尾我们提到了维度选择和特征重要性，",
      "start": 58.711,
      "end": 63.211
    },
    {
      "id": "shot05-23",
      "text": "后续章节比如决策树会专门讲怎么自动度量每",
      "start": 63.211,
      "end": 67.111
    },
    {
      "id": "shot05-24",
      "text": "个特征的贡献。",
      "start": 67.111,
      "end": 68.031
    }
  ],
  "shot06": [
    {
      "id": "shot06-0",
      "text": "再做两个对照。",
      "start": 0.0,
      "end": 1.44
    },
    {
      "id": "shot06-1",
      "text": "先把 2D 投影切回花瓣长花瓣宽，",
      "start": 1.44,
      "end": 5.7
    },
    {
      "id": "shot06-2",
      "text": "把标准化开关关掉。",
      "start": 5.7,
      "end": 7.62
    },
    {
      "id": "shot06-3",
      "text": "看准确率——切换标准化开关，",
      "start": 7.62,
      "end": 11.02
    },
    {
      "id": "shot06-4",
      "text": "acc 在 93 到 98 个百分点之间",
      "start": 11.02,
      "end": 14.14
    },
    {
      "id": "shot06-5",
      "text": "小幅波动，",
      "start": 14.14,
      "end": 15.38
    },
    {
      "id": "shot06-6",
      "text": "量级保持不变。",
      "start": 15.38,
      "end": 17.14
    },
    {
      "id": "shot06-7",
      "text": "前几期说过标准化对 KNN 很关键，",
      "start": 17.14,
      "end": 20.6
    },
    {
      "id": "shot06-8",
      "text": "这里关掉怎么没影响？",
      "start": 20.6,
      "end": 22.56
    },
    {
      "id": "shot06-9",
      "text": "答案在数据本身：",
      "start": 22.56,
      "end": 24.25
    },
    {
      "id": "shot06-10",
      "text": "鸢尾花 4 个特征量纲都是厘米，",
      "start": 24.25,
      "end": 27.12
    },
    {
      "id": "shot06-11",
      "text": "数值范围都在 0 到 8 厘米之间，",
      "start": 27.12,
      "end": 29.76
    },
    {
      "id": "shot06-12",
      "text": "本来就对齐了，",
      "start": 29.76,
      "end": 31.22
    },
    {
      "id": "shot06-13",
      "text": "标准化几乎不会改变数值。",
      "start": 31.22,
      "end": 33.36
    },
    {
      "id": "shot06-14",
      "text": "在 iris 这个具体数据上甚至会因为",
      "start": 33.82,
      "end": 36.48
    },
    {
      "id": "shot06-15",
      "text": "KNN 距离尺度有偶然性、",
      "start": 36.48,
      "end": 38.58
    },
    {
      "id": "shot06-16",
      "text": "关闭标准化 acc 略高，",
      "start": 38.58,
      "end": 40.42
    },
    {
      "id": "shot06-17",
      "text": "但工程上仍然坚持开。",
      "start": 40.42,
      "end": 42.72
    },
    {
      "id": "shot06-18",
      "text": "前一期 e09 我们专门用量纲悬殊的数据",
      "start": 42.72,
      "end": 46.3
    },
    {
      "id": "shot06-19",
      "text": "演示标准化威力——票房亿级、",
      "start": 46.3,
      "end": 48.64
    },
    {
      "id": "shot06-20",
      "text": "评分十级——那种场景下不标准化 KNN",
      "start": 48.64,
      "end": 51.92
    },
    {
      "id": "shot06-21",
      "text": "几乎只看大量纲那一维。",
      "start": 51.92,
      "end": 54.645
    },
    {
      "id": "shot06-22",
      "text": "鸢尾花是反例：",
      "start": 54.645,
      "end": 56.18
    },
    {
      "id": "shot06-23",
      "text": "量纲天然对齐时，",
      "start": 56.18,
      "end": 57.7
    },
    {
      "id": "shot06-24",
      "text": "标准化加不加都行，",
      "start": 57.7,
      "end": 59.62
    },
    {
      "id": "shot06-25",
      "text": "但写 pipeline 时仍然建议默认开着，",
      "start": 59.62,
      "end": 62.7
    },
    {
      "id": "shot06-26",
      "text": "养成默认开的习惯，",
      "start": 62.7,
      "end": 64.6
    },
    {
      "id": "shot06-27",
      "text": "换数据集时不会忘。",
      "start": 64.6,
      "end": 66.36
    },
    {
      "id": "shot06-28",
      "text": "最后调一下 k。",
      "start": 66.36,
      "end": 67.48
    },
    {
      "id": "shot06-29",
      "text": "把 k 拖到 1，",
      "start": 67.847,
      "end": 69.387
    },
    {
      "id": "shot06-30",
      "text": "决策边界立刻碎裂成贴着每个训练点的小块，",
      "start": 69.387,
      "end": 73.347
    },
    {
      "id": "shot06-31",
      "text": "回到第 2 期讲过的过拟合形态。",
      "start": 73.347,
      "end": 76.667
    },
    {
      "id": "shot06-32",
      "text": "再把 k 拖到 29，",
      "start": 76.667,
      "end": 78.487
    },
    {
      "id": "shot06-33",
      "text": "几乎是训练集 105 条的四分之一，",
      "start": 78.487,
      "end": 81.727
    },
    {
      "id": "shot06-34",
      "text": "决策边界变得过度光滑——iris 数据简",
      "start": 81.727,
      "end": 85.247
    },
    {
      "id": "shot06-35",
      "text": "单 acc 不一定下降，",
      "start": 85.247,
      "end": 87.227
    },
    {
      "id": "shot06-36",
      "text": "但边界形态已经接近欠拟合。",
      "start": 87.227,
      "end": 89.987
    },
    {
      "id": "shot06-37",
      "text": "k=5 这个默认值是不是最优？",
      "start": 89.987,
      "end": 93.487
    },
    {
      "id": "shot06-38",
      "text": "我们手动调感觉差不多，",
      "start": 93.487,
      "end": 95.567
    },
    {
      "id": "shot06-39",
      "text": "但有没有办法让数据自己挑？",
      "start": 95.567,
      "end": 97.847
    },
    {
      "id": "shot06-40",
      "text": "这个问题留给下一期回答。",
      "start": 97.847,
      "end": 99.567
    }
  ],
  "shot07": [
    {
      "id": "shot07-0",
      "text": "这一期到这。",
      "start": 0.0,
      "end": 1.0
    },
    {
      "id": "shot07-1",
      "text": "我们第一次把前 9 期所有零件组装成一个",
      "start": 1.0,
      "end": 4.22
    },
    {
      "id": "shot07-2",
      "text": "完整 pipeline——加载、拆分、标准化、训练、评估、预测，",
      "start": 4.22,
      "end": 9.14
    },
    {
      "id": "shot07-3",
      "text": "6 步走完。",
      "start": 9.14,
      "end": 10.34
    },
    {
      "id": "shot07-4",
      "text": "这一期讲清楚的：",
      "start": 10.34,
      "end": 11.73
    },
    {
      "id": "shot07-5",
      "text": "鸢尾花数据集 150 条 4 特征 3类，",
      "start": 11.73,
      "end": 15.2
    },
    {
      "id": "shot07-6",
      "text": "sklearn 6 步 API 全过一遍，",
      "start": 15.2,
      "end": 18.1
    },
    {
      "id": "shot07-7",
      "text": "引入了两个新概念：",
      "start": 18.1,
      "end": 19.8
    },
    {
      "id": "shot07-8",
      "text": "分层抽样保证类别比例对齐，",
      "start": 19.8,
      "end": 22.7
    },
    {
      "id": "shot07-9",
      "text": "混淆矩阵看错在哪。",
      "start": 22.7,
      "end": 24.82
    },
    {
      "id": "shot07-10",
      "text": "还演示了维度信息量的差异，",
      "start": 24.82,
      "end": 27.28
    },
    {
      "id": "shot07-11",
      "text": "花瓣比花萼信息量大得多。",
      "start": 27.28,
      "end": 29.4
    },
    {
      "id": "shot07-12",
      "text": "这一期点到没展开的：",
      "start": 29.749,
      "end": 31.671
    },
    {
      "id": "shot07-13",
      "text": "分类报告里的精确率和召回率这一组评估指标，",
      "start": 31.671,
      "end": 35.253
    },
    {
      "id": "shot07-14",
      "text": "留给第 2 站逻辑回归专章；",
      "start": 35.253,
      "end": 37.595
    },
    {
      "id": "shot07-15",
      "text": "特征重要性和特征选择，",
      "start": 37.595,
      "end": 39.897
    },
    {
      "id": "shot07-16",
      "text": "留给后续章节决策树展开。",
      "start": 39.897,
      "end": 42.759
    },
    {
      "id": "shot07-17",
      "text": "下一期我们解决一个新问题——刚才 k 我",
      "start": 42.759,
      "end": 45.802
    },
    {
      "id": "shot07-18",
      "text": "们手动设了 5，",
      "start": 45.802,
      "end": 47.083
    },
    {
      "id": "shot07-19",
      "text": "到底是不是最优？",
      "start": 47.083,
      "end": 48.464
    },
    {
      "id": "shot07-20",
      "text": "K 怎么不靠手感、",
      "start": 48.464,
      "end": 50.005
    },
    {
      "id": "shot07-21",
      "text": "靠数据自己挑出最好的那个？",
      "start": 50.005,
      "end": 52.427
    },
    {
      "id": "shot07-22",
      "text": "答案叫交叉验证完整版，",
      "start": 52.427,
      "end": 54.689
    },
    {
      "id": "shot07-23",
      "text": "第 2 期我们提过留一交叉验证只是它的一个特例，",
      "start": 54.689,
      "end": 58.425
    },
    {
      "id": "shot07-24",
      "text": "下一期把通用做法讲透。",
      "start": 58.425,
      "end": 60.534
    },
    {
      "id": "shot07-25",
      "text": "如果讲得有不对的地方，",
      "start": 60.534,
      "end": 62.282
    },
    {
      "id": "shot07-26",
      "text": "欢迎在评论区指正。下期见。",
      "start": 62.282,
      "end": 64.25
    }
  ]
}
