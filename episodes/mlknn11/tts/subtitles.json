{
  "shot01": [
    {
      "id": "shot01-0",
      "text": "上一期跑通了第一个完整 pipeline，",
      "start": 0.0,
      "end": 2.64
    },
    {
      "id": "shot01-1",
      "text": "但 k=5 这个数字是手动设的——为什么不是 3、不是 7、",
      "start": 2.64,
      "end": 7.22
    },
    {
      "id": "shot01-2",
      "text": "不是 11？",
      "start": 7.22,
      "end": 7.96
    },
    {
      "id": "shot01-3",
      "text": "想让数据自己挑出最优 k，",
      "start": 7.96,
      "end": 10.7
    },
    {
      "id": "shot01-4",
      "text": "逻辑很直接：",
      "start": 10.7,
      "end": 11.68
    },
    {
      "id": "shot01-5",
      "text": "每个 k 值给一个评分，",
      "start": 11.68,
      "end": 13.95
    },
    {
      "id": "shot01-6",
      "text": "评分最高的拿走。",
      "start": 13.95,
      "end": 15.78
    },
    {
      "id": "shot01-7",
      "text": "问题是这个评分怎么打才靠谱？",
      "start": 15.78,
      "end": 18.32
    },
    {
      "id": "shot01-8",
      "text": "这一期回答这个问题。",
      "start": 18.32,
      "end": 19.82
    },
    {
      "id": "shot01-9",
      "text": "先看一个现象：",
      "start": 20.181,
      "end": 21.641
    },
    {
      "id": "shot01-10",
      "text": "同一份数据、",
      "start": 21.641,
      "end": 22.741
    },
    {
      "id": "shot01-11",
      "text": "同一个 k=5、",
      "start": 22.741,
      "end": 24.021
    },
    {
      "id": "shot01-12",
      "text": "同一个 sklearn KNN，",
      "start": 24.021,
      "end": 26.121
    },
    {
      "id": "shot01-13",
      "text": "只换 random_state 切训练测试集，",
      "start": 26.121,
      "end": 28.841
    },
    {
      "id": "shot01-14",
      "text": "准确率能从 0.91 跳到 0.98——",
      "start": 28.841,
      "end": 32.141
    },
    {
      "id": "shot01-15",
      "text": "7 个百分点。",
      "start": 32.141,
      "end": 33.381
    },
    {
      "id": "shot01-16",
      "text": "然后我们引出交叉验证，",
      "start": 33.381,
      "end": 35.761
    },
    {
      "id": "shot01-17",
      "text": "是后续选超参数的基础。",
      "start": 35.761,
      "end": 37.801
    }
  ],
  "shot02": [
    {
      "id": "shot02-0",
      "text": "先把现象摆清楚。",
      "start": 0.0,
      "end": 1.98
    },
    {
      "id": "shot02-1",
      "text": "鸢尾花，",
      "start": 1.98,
      "end": 3.16
    },
    {
      "id": "shot02-2",
      "text": "固定 k=5、",
      "start": 3.16,
      "end": 4.5
    },
    {
      "id": "shot02-3",
      "text": "固定标准化、",
      "start": 4.5,
      "end": 5.5
    },
    {
      "id": "shot02-4",
      "text": "固定测试集占 30%、",
      "start": 5.5,
      "end": 7.52
    },
    {
      "id": "shot02-5",
      "text": "并且开 stratify 按类别比例切—",
      "start": 7.52,
      "end": 10.22
    },
    {
      "id": "shot02-6",
      "text": "—唯一变量是 random_state，",
      "start": 10.22,
      "end": 12.66
    },
    {
      "id": "shot02-7",
      "text": "也就是上一期讲过的随机数种子。",
      "start": 12.66,
      "end": 15.32
    },
    {
      "id": "shot02-8",
      "text": "它控制 train_test_split怎么洗牌，",
      "start": 15.32,
      "end": 17.8
    },
    {
      "id": "shot02-9",
      "text": "洗完牌 70 比 30 切。",
      "start": 17.8,
      "end": 19.96
    },
    {
      "id": "shot02-10",
      "text": "我把 6 个常用种子跑一遍",
      "start": 20.372,
      "end": 22.452
    },
    {
      "id": "shot02-11",
      "text": "sklearn：",
      "start": 22.532,
      "end": 23.512
    },
    {
      "id": "shot02-12",
      "text": "种子 0 准确率 0.9333，",
      "start": 23.512,
      "end": 26.012
    },
    {
      "id": "shot02-13",
      "text": "种子 1 是 0.9333，",
      "start": 26.012,
      "end": 28.052
    },
    {
      "id": "shot02-14",
      "text": "种子 7 是 0.9778，",
      "start": 28.052,
      "end": 30.152
    },
    {
      "id": "shot02-15",
      "text": "种子 20 是 0.9111，",
      "start": 30.152,
      "end": 32.352
    },
    {
      "id": "shot02-16",
      "text": "种子 42 是 0.9333，",
      "start": 32.352,
      "end": 34.952
    },
    {
      "id": "shot02-17",
      "text": "种子 100 是 0.9111。",
      "start": 34.952,
      "end": 37.632
    },
    {
      "id": "shot02-18",
      "text": "同一个模型，",
      "start": 37.632,
      "end": 38.592
    },
    {
      "id": "shot02-19",
      "text": "跨度从 0.91 到 0.98，",
      "start": 38.592,
      "end": 41.412
    },
    {
      "id": "shot02-20",
      "text": "差不多 7 个百分点。",
      "start": 41.412,
      "end": 42.852
    },
    {
      "id": "shot02-21",
      "text": "原因很简单：",
      "start": 43.188,
      "end": 44.408
    },
    {
      "id": "shot02-22",
      "text": "测试集才 45 条，",
      "start": 44.408,
      "end": 46.428
    },
    {
      "id": "shot02-23",
      "text": "多答错 1 道题就跳 2.2 个百分点，",
      "start": 46.428,
      "end": 49.248
    },
    {
      "id": "shot02-24",
      "text": "运气最差的那一刀比运气好的多错了几道——",
      "start": 49.248,
      "end": 52.368
    },
    {
      "id": "shot02-25",
      "text": "这是抽样的运气，",
      "start": 52.368,
      "end": 53.728
    },
    {
      "id": "shot02-26",
      "text": "不是模型的本事。",
      "start": 53.728,
      "end": 55.728
    },
    {
      "id": "shot02-27",
      "text": "如果你拿种子 100 那一刀来选 k，",
      "start": 55.728,
      "end": 58.368
    },
    {
      "id": "shot02-28",
      "text": "可能选了一个其实不好的 k，",
      "start": 58.368,
      "end": 60.668
    },
    {
      "id": "shot02-29",
      "text": "因为评分本身就不可信。",
      "start": 60.668,
      "end": 62.748
    },
    {
      "id": "shot02-30",
      "text": "要让数据替我们挑 k，",
      "start": 62.748,
      "end": 64.548
    },
    {
      "id": "shot02-31",
      "text": "得先解决这个抖动。",
      "start": 64.548,
      "end": 67.288
    }
  ],
  "shot03": [
    {
      "id": "shot03-0",
      "text": "解决思路类比月考。",
      "start": 0.0,
      "end": 2.401
    },
    {
      "id": "shot03-1",
      "text": "判一个学生水平，",
      "start": 2.401,
      "end": 3.902
    },
    {
      "id": "shot03-2",
      "text": "看 1 次月考会抖、",
      "start": 3.902,
      "end": 5.543
    },
    {
      "id": "shot03-3",
      "text": "看 4 次月考取均分才稳。",
      "start": 5.543,
      "end": 8.004
    },
    {
      "id": "shot03-4",
      "text": "交叉验证",
      "start": 8.004,
      "end": 9.044
    },
    {
      "id": "shot03-5",
      "text": "cross-validation 简称",
      "start": 9.044,
      "end": 10.825
    },
    {
      "id": "shot03-6",
      "text": "CV 就是数据版的看 4 次月考：",
      "start": 10.825,
      "end": 13.326
    },
    {
      "id": "shot03-7",
      "text": "把训练集切成 n 份，",
      "start": 13.326,
      "end": 15.247
    },
    {
      "id": "shot03-8",
      "text": "每份轮流当一次验证集，",
      "start": 15.247,
      "end": 17.888
    },
    {
      "id": "shot03-9",
      "text": "跑 n 次拿到 n 个评分，",
      "start": 17.888,
      "end": 20.149
    },
    {
      "id": "shot03-10",
      "text": "取平均当这组超参数的最终得分。",
      "start": 20.149,
      "end": 23.331
    },
    {
      "id": "shot03-11",
      "text": "我们走一遍 cv=4 的具体动作。",
      "start": 23.331,
      "end": 26.492
    },
    {
      "id": "shot03-12",
      "text": "假设训练集 100 条，",
      "start": 26.492,
      "end": 29.116
    },
    {
      "id": "shot03-13",
      "text": "cv=4 每折 25 条。",
      "start": 29.116,
      "end": 31.162
    },
    {
      "id": "shot03-14",
      "text": "第 1 轮第 1 份当验证折、",
      "start": 31.82,
      "end": 33.723
    },
    {
      "id": "shot03-15",
      "text": "其他 3 份训练，",
      "start": 33.723,
      "end": 34.805
    },
    {
      "id": "shot03-16",
      "text": "跑出准确率 1。",
      "start": 34.805,
      "end": 36.148
    },
    {
      "id": "shot03-17",
      "text": "第 2 轮第 2 份当验证折、",
      "start": 36.148,
      "end": 38.111
    },
    {
      "id": "shot03-18",
      "text": "其他 3 份训练，",
      "start": 38.111,
      "end": 39.173
    },
    {
      "id": "shot03-19",
      "text": "跑出准确率 2。",
      "start": 39.173,
      "end": 40.455
    },
    {
      "id": "shot03-20",
      "text": "第 3 轮第 3 份当验证折、",
      "start": 40.455,
      "end": 42.559
    },
    {
      "id": "shot03-21",
      "text": "跑出准确率 3。",
      "start": 42.559,
      "end": 43.901
    },
    {
      "id": "shot03-22",
      "text": "第 4 轮第 4 份当验证折、",
      "start": 43.901,
      "end": 45.945
    },
    {
      "id": "shot03-23",
      "text": "跑出准确率 4。",
      "start": 45.945,
      "end": 47.628
    },
    {
      "id": "shot03-24",
      "text": "这里我们提前把术语对一下：",
      "start": 47.628,
      "end": 50.032
    },
    {
      "id": "shot03-25",
      "text": "每一轮里被留出来打分的那一份就叫验证折",
      "start": 50.032,
      "end": 53.638
    },
    {
      "id": "shot03-26",
      "text": "validation fold，",
      "start": 53.638,
      "end": 55.101
    },
    {
      "id": "shot03-27",
      "text": "4 份用来训练，",
      "start": 55.101,
      "end": 56.27
    },
    {
      "id": "shot03-28",
      "text": "1 份用来打分——一会儿后面三集职责的纪",
      "start": 56.27,
      "end": 59.188
    },
    {
      "id": "shot03-29",
      "text": "律就建立在这个区分上。",
      "start": 59.188,
      "end": 60.73
    },
    {
      "id": "shot03-30",
      "text": "4 个准确率取平均，",
      "start": 61.231,
      "end": 63.171
    },
    {
      "id": "shot03-31",
      "text": "就是 k=5 这组超参数的 CV 得分。",
      "start": 63.171,
      "end": 66.511
    },
    {
      "id": "shot03-32",
      "text": "每条样本都当过一次验证集，",
      "start": 66.511,
      "end": 69.071
    },
    {
      "id": "shot03-33",
      "text": "没有运气分。",
      "start": 69.071,
      "end": 70.531
    },
    {
      "id": "shot03-34",
      "text": "要选最优 k 就外层循环：",
      "start": 70.531,
      "end": 72.891
    },
    {
      "id": "shot03-35",
      "text": "让 k 跑过 1、3、5、7、9、",
      "start": 72.891,
      "end": 75.031
    },
    {
      "id": "shot03-36",
      "text": "11 各一遍 4 折流程，",
      "start": 75.031,
      "end": 76.811
    },
    {
      "id": "shot03-37",
      "text": "得到 6 个 CV 得分，",
      "start": 76.811,
      "end": 78.871
    },
    {
      "id": "shot03-38",
      "text": "挑最高的那个 k。",
      "start": 78.871,
      "end": 80.231
    }
  ],
  "shot04": [
    {
      "id": "shot04-0",
      "text": "为什么取均值能稳？",
      "start": 0.0,
      "end": 1.922
    },
    {
      "id": "shot04-1",
      "text": "看一个容易猜错的事实。",
      "start": 1.922,
      "end": 4.064
    },
    {
      "id": "shot04-2",
      "text": "想象一台体重秤单次称有正负 1 公斤的随机噪声。",
      "start": 4.064,
      "end": 8.528
    },
    {
      "id": "shot04-3",
      "text": "多称几次取平均，",
      "start": 8.528,
      "end": 10.31
    },
    {
      "id": "shot04-4",
      "text": "误差怎么缩？",
      "start": 10.31,
      "end": 11.571
    },
    {
      "id": "shot04-5",
      "text": "直觉上称 4 次缩 4 倍，对吗？错。",
      "start": 11.571,
      "end": 14.968
    },
    {
      "id": "shot04-6",
      "text": "称 4 次误差只缩 2 倍，",
      "start": 14.968,
      "end": 17.876
    },
    {
      "id": "shot04-7",
      "text": "是正负 0.5 公斤。",
      "start": 17.876,
      "end": 19.83
    },
    {
      "id": "shot04-8",
      "text": "称 16 次缩 4 倍，",
      "start": 19.83,
      "end": 21.578
    },
    {
      "id": "shot04-9",
      "text": "是正负 0.25 公斤。",
      "start": 21.578,
      "end": 23.886
    },
    {
      "id": "shot04-10",
      "text": "称 100 次缩 10 倍。为什么慢？",
      "start": 23.886,
      "end": 26.701
    },
    {
      "id": "shot04-11",
      "text": "因为单次抖动有正有负，",
      "start": 26.701,
      "end": 29.202
    },
    {
      "id": "shot04-12",
      "text": "平均时正负相消大半但不完全抵消。",
      "start": 29.202,
      "end": 33.144
    },
    {
      "id": "shot04-13",
      "text": "数学公式是平均后误差等于单次误差除以根号n。",
      "start": 33.144,
      "end": 37.126
    },
    {
      "id": "shot04-14",
      "text": "落到 CV：",
      "start": 37.688,
      "end": 38.728
    },
    {
      "id": "shot04-15",
      "text": "把称体重换成评模型，",
      "start": 38.728,
      "end": 40.608
    },
    {
      "id": "shot04-16",
      "text": "把单次正负 1 公斤换成单切分约 4 个",
      "start": 40.608,
      "end": 43.868
    },
    {
      "id": "shot04-17",
      "text": "百分点的抖动。",
      "start": 43.868,
      "end": 44.948
    },
    {
      "id": "shot04-18",
      "text": "cv=4 缩到约 2 个百分点，",
      "start": 44.948,
      "end": 47.528
    },
    {
      "id": "shot04-19",
      "text": "cv=16 缩到约 1 个百分点。",
      "start": 47.528,
      "end": 50.328
    },
    {
      "id": "shot04-20",
      "text": "要把误差减半，",
      "start": 50.328,
      "end": 51.588
    },
    {
      "id": "shot04-21",
      "text": "得把折数翻 4 倍。",
      "start": 51.588,
      "end": 53.748
    },
    {
      "id": "shot04-22",
      "text": "这里兑现一个伏笔：",
      "start": 53.748,
      "end": 55.308
    },
    {
      "id": "shot04-23",
      "text": "第 2 期提过留一交叉验证",
      "start": 55.308,
      "end": 57.768
    },
    {
      "id": "shot04-24",
      "text": "leave-one-out 简称",
      "start": 57.768,
      "end": 59.468
    },
    {
      "id": "shot04-25",
      "text": "LOOCV，",
      "start": 59.468,
      "end": 60.988
    },
    {
      "id": "shot04-26",
      "text": "每次只留 1 条当验证集。",
      "start": 60.988,
      "end": 63.148
    },
    {
      "id": "shot04-27",
      "text": "它就是 CV 的极端特例——cv 等于训",
      "start": 63.148,
      "end": 66.408
    },
    {
      "id": "shot04-28",
      "text": "练集样本数。",
      "start": 66.408,
      "end": 67.448
    },
    {
      "id": "shot04-29",
      "text": "理论上误差最小，",
      "start": 67.891,
      "end": 69.491
    },
    {
      "id": "shot04-30",
      "text": "但要训 N 次模型，",
      "start": 69.491,
      "end": 70.971
    },
    {
      "id": "shot04-31",
      "text": "计算成本爆炸。",
      "start": 70.971,
      "end": 72.251
    },
    {
      "id": "shot04-32",
      "text": "工程上常用 cv=5 或 cv=10，",
      "start": 72.251,
      "end": 75.811
    },
    {
      "id": "shot04-33",
      "text": "性价比最高。",
      "start": 75.811,
      "end": 76.944
    }
  ],
  "shot05": [
    {
      "id": "shot05-0",
      "text": "讲完 CV 怎么算，",
      "start": 0.0,
      "end": 1.58
    },
    {
      "id": "shot05-1",
      "text": "要立刻补一个工程纪律：",
      "start": 1.58,
      "end": 3.58
    },
    {
      "id": "shot05-2",
      "text": "测试集只看一次。",
      "start": 3.58,
      "end": 4.76
    },
    {
      "id": "shot05-3",
      "text": "CV 切的是训练集内部，",
      "start": 4.76,
      "end": 6.88
    },
    {
      "id": "shot05-4",
      "text": "测试集在调参全程不参与，",
      "start": 6.88,
      "end": 9.34
    },
    {
      "id": "shot05-5",
      "text": "最后用它跑一次得到最终评分。",
      "start": 9.34,
      "end": 12.02
    },
    {
      "id": "shot05-6",
      "text": "这一句话是这一期最重要的一条。",
      "start": 12.02,
      "end": 14.56
    },
    {
      "id": "shot05-7",
      "text": "完整流程是这样的：",
      "start": 14.56,
      "end": 16.34
    },
    {
      "id": "shot05-8",
      "text": "原始 150 条数据先切 7 比 3，",
      "start": 16.34,
      "end": 19.32
    },
    {
      "id": "shot05-9",
      "text": "得到 105 条训练集和 45 条测试集。",
      "start": 19.32,
      "end": 22.76
    },
    {
      "id": "shot05-10",
      "text": "CV 在这 105 条训练集内部反复切—",
      "start": 22.76,
      "end": 25.88
    },
    {
      "id": "shot05-11",
      "text": "—比如 cv=5 就把 105 条切 5份，",
      "start": 25.88,
      "end": 29.46
    },
    {
      "id": "shot05-12",
      "text": "每份 21 条。",
      "start": 29.46,
      "end": 30.62
    },
    {
      "id": "shot05-13",
      "text": "每一轮里，",
      "start": 30.999,
      "end": 31.819
    },
    {
      "id": "shot05-14",
      "text": "4 份训练折用来上课，",
      "start": 31.819,
      "end": 34.079
    },
    {
      "id": "shot05-15",
      "text": "1 份验证折用来打小测分，",
      "start": 34.079,
      "end": 36.379
    },
    {
      "id": "shot05-16",
      "text": "5 轮取平均得这组超参的 CV 得分。",
      "start": 36.379,
      "end": 39.579
    },
    {
      "id": "shot05-17",
      "text": "45 条测试集那边一动不动。",
      "start": 39.579,
      "end": 42.739
    },
    {
      "id": "shot05-18",
      "text": "等所有超参都拿过 CV 得分、",
      "start": 42.739,
      "end": 45.099
    },
    {
      "id": "shot05-19",
      "text": "挑出最优 k 之后，",
      "start": 45.099,
      "end": 46.719
    },
    {
      "id": "shot05-20",
      "text": "再做最后一步：",
      "start": 46.719,
      "end": 47.779
    },
    {
      "id": "shot05-21",
      "text": "用最优 k 加上完整 105 条训练集重",
      "start": 47.779,
      "end": 51.299
    },
    {
      "id": "shot05-22",
      "text": "训一次模型，",
      "start": 51.299,
      "end": 52.159
    },
    {
      "id": "shot05-23",
      "text": "最后用从头没动过的 45 条测试集做一次评估。",
      "start": 52.159,
      "end": 56.159
    },
    {
      "id": "shot05-24",
      "text": "为什么测试集要藏到最后？",
      "start": 56.159,
      "end": 58.219
    },
    {
      "id": "shot05-25",
      "text": "如果你拿测试集来挑 k，",
      "start": 58.541,
      "end": 60.741
    },
    {
      "id": "shot05-26",
      "text": "那测试集就被偷看过了，",
      "start": 60.741,
      "end": 62.621
    },
    {
      "id": "shot05-27",
      "text": "它的评分就不再代表模型见到陌生数据的真实表现。",
      "start": 62.621,
      "end": 67.081
    },
    {
      "id": "shot05-28",
      "text": "CV 的存在就是给你一个不动测试集的渠道",
      "start": 67.081,
      "end": 70.101
    },
    {
      "id": "shot05-29",
      "text": "来选超参——这是机器学习工程纪律的底线。",
      "start": 70.101,
      "end": 73.241
    }
  ],
  "shot06": [
    {
